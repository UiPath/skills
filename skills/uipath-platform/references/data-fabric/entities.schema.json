{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "entities.json: an approved Data Fabric entity set for scripts/entities-compile.mjs",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "entities"],
  "properties": {
    "version": { "const": 1 },
    "choiceSets": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z0-9]+$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["values"],
        "properties": {
          "displayName": { "type": "string" },
          "values": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" },
                "displayName": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "entities": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "realizes"],
        "properties": {
          "kind": { "enum": ["native", "federated", "review"] },
          "displayName": { "type": "string" },
          "realizes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["class", "role"],
              "properties": {
                "class": { "type": "string" },
                "role": { "enum": ["owner", "part", "copy", "junction", "view"] },
                "key": { "type": "string" }
              }
            }
          },
          "fields": {
            "type": "object",
            "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_]{0,99}$" },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type"],
              "properties": {
                "type": { "enum": ["STRING", "DECIMAL", "BOOLEAN", "DATE", "DATETIME_WITH_TZ", "CHOICE_SET_SINGLE", "RELATIONSHIP"] },
                "displayName": { "type": "string" },
                "length": { "type": "integer", "minimum": 1 },
                "precision": { "type": "integer", "minimum": 0 },
                "required": { "type": "boolean" },
                "unique": { "type": "boolean" },
                "choiceSet": { "type": "string" },
                "target": { "type": "string" },
                "property": { "type": "string" }
              }
            }
          },
          "primary": { "$ref": "#/$defs/selection" },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "allOf": [{ "$ref": "#/$defs/selection" }],
              "required": ["join"],
              "properties": { "join": { "type": "string" } }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "selection": {
      "type": "object",
      "required": ["entity", "fields"],
      "properties": {
        "entity": { "type": "string" },
        "fields": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } }
      }
    }
  }
}
