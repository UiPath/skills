{
  "id": "base-chat",
  "description": "The basic chat probe every product runs on a chat flavor, unless the product has its own.",
  "source": "BaseChatCompatibilityProbe",
  "apiFlavor": "AwsBedrockConverse",
  "order": 90,
  "path": "/model/{{model}}/converse",
  "body": {
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "text": "Give me the first capital letter of the english alphabet and this letter only"
          }
        ]
      }
    ],
    "inferenceConfig": {
      "maxTokens": 2048
    }
  },
  "checks": [
    {
      "reason": "MALFORMED_RESPONSE",
      "says": "output.message.content is an array",
      "jq": "(.output.message.content | type) == \"array\""
    },
    {
      "reason": "MULTIPLE_RESPONSES",
      "says": "exactly one choice, index 0",
      "jq": "true"
    },
    {
      "reason": "INCORRECT_RESPONSE",
      "says": "the assistant answers with text",
      "jq": ".output.message.role == \"assistant\" and (([.output.message.content[] | .text | select(. != null)] | join(\"\")) | test(\"\\\\S\"))"
    }
  ]
}
