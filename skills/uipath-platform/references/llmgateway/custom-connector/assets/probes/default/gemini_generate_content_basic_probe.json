{
  "id": "gemini_generate_content_basic_probe",
  "description": "A three-turn conversation; the answer must hold exactly one candidate whose first non-thought part carries text.",
  "source": "ProductDefinedProbes/Payloads/gemini_generate_content_basic_probe.json",
  "apiFlavor": "GeminiGenerateContent",
  "optIn": true,
  "order": 10,
  "path": "/models/{{model}}:generateContent",
  "body": {
    "contents": [
      {
        "role": "user",
        "parts": [
          {
            "text": "Does Google Cloud Platform have a Generative AI service?"
          }
        ]
      },
      {
        "role": "model",
        "parts": [
          {
            "text": "Yes, Google Cloud Platform provides a Generative AI service called BigGAN."
          }
        ]
      },
      {
        "role": "user",
        "parts": [
          {
            "text": "Is Vertex AI a Google Cloud Platform service? Yes or no? No other content is required in the response."
          }
        ]
      }
    ],
    "generationConfig": {
      "maxOutputTokens": 2048,
      "temperature": 1.0
    }
  },
  "checks": [
    {
      "reason": "MALFORMED_RESPONSE",
      "says": "candidates is an array of objects whose content.parts is an array",
      "jq": "((.candidates // []) | type) == \"array\" and all((.candidates // [])[]; (.content.parts // []) | type == \"array\")"
    },
    {
      "reason": "MALFORMED_RESPONSE",
      "says": "at least one candidate",
      "jq": "((.candidates // []) | length) > 0"
    },
    {
      "reason": "MULTIPLE_RESPONSES",
      "says": "exactly one candidate, index 0",
      "jq": "(.candidates | length) == 1 and (.candidates[0].index // 0) == 0"
    },
    {
      "reason": "MALFORMED_RESPONSE",
      "says": "the first part that is not a thought carries text",
      "jq": "([.candidates[0].content.parts[] | select(.thought != true)][0].text // null) != null"
    }
  ]
}
