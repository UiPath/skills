{
  "id": "ecs_tool_calling_n_choices_gemini_probe",
  "description": "A forced call to ClaimCitationExtraction with candidateCount 4; the answer must hold more than one candidate and a function call.",
  "source": "ProductDefinedProbes/Payloads/ecs_tool_calling_n_choices_gemini_probe.json",
  "apiFlavor": "GeminiGenerateContent",
  "order": 10,
  "path": "/models/{{model}}:generateContent",
  "body": {
    "systemInstruction": {
      "parts": [
        {
          "text": "You are an expert document summarizer."
        }
      ]
    },
    "contents": [
      {
        "role": "user",
        "parts": [
          {
            "text": "Summarize the following text and extract claim-citation groups.\n\nSample text: The patient presented on 1 January 2024 with elevated blood pressure. [ABC123]"
          }
        ]
      }
    ],
    "tools": [
      {
        "functionDeclarations": [
          {
            "name": "ClaimCitationExtraction",
            "description": "Extract claim-citation groups from a summary.",
            "parameters": {
              "type": "object",
              "properties": {
                "groups": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "claim_text": {
                        "type": "string"
                      },
                      "associated_citation_ids": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "required": [
                      "claim_text",
                      "associated_citation_ids"
                    ]
                  }
                }
              },
              "required": [
                "groups"
              ]
            }
          }
        ]
      }
    ],
    "toolConfig": {
      "functionCallingConfig": {
        "mode": "ANY"
      }
    },
    "generationConfig": {
      "thinkingConfig": {
        "thinkingBudget": 1000
      },
      "candidateCount": 4
    }
  },
  "checks": [
    {
      "reason": "MALFORMED_RESPONSE",
      "says": "candidates is an array of objects whose content.parts is an array",
      "jq": "((.candidates // []) | type) == \"array\" and all((.candidates // [])[]; (.content.parts // []) | type == \"array\")"
    },
    {
      "reason": "MALFORMED_RESPONSE",
      "says": "more than one candidate",
      "jq": "((.candidates // []) | length) > 1"
    },
    {
      "reason": "MISSING_TOOL_CALL",
      "says": "a candidate calls a tool",
      "jq": "any(.candidates[].content.parts[]; (.functionCall // .function_call) != null)"
    }
  ]
}
