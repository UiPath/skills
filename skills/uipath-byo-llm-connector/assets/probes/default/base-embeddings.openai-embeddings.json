{
  "id": "base-embeddings",
  "description": "The basic embeddings probe every product runs on an embeddings flavor.",
  "source": "BaseEmbeddingsCompatibilityProbe",
  "apiFlavor": "OpenAiEmbeddings",
  "order": 90,
  "path": "/v1/embeddings",
  "body": {
    "input": [
      "{\"input\": \"AI is awesome\"}"
    ],
    "model": "{{model}}"
  },
  "checks": [
    {
      "reason": "MALFORMED_RESPONSE",
      "says": "data holds exactly one item",
      "jq": "(.data | type) == \"array\" and (.data | length) == 1"
    },
    {
      "reason": "MALFORMED_RESPONSE",
      "says": "the embedding is a non-empty array of numbers",
      "jq": "(.data[0].embedding | type) == \"array\" and (.data[0].embedding | length) > 0"
    }
  ]
}
