{
  "id": "openai_embeddings_basic_probe",
  "description": "One input string; the answer must hold exactly one non-empty embedding.",
  "source": "ProductDefinedProbes/Payloads/openai_embeddings_basic_probe.json",
  "apiFlavor": "OpenAiEmbeddings",
  "match": [
    {
      "feature": "documentunderstanding-du-generative-features"
    }
  ],
  "order": 10,
  "path": "/v1/embeddings",
  "body": {
    "input": "AI is awesome",
    "model": "{{model}}"
  },
  "checks": [
    {
      "reason": "MALFORMED_RESPONSE",
      "says": "data is an array",
      "jq": "(.data | type) == \"array\""
    },
    {
      "reason": "MALFORMED_RESPONSE",
      "says": "data holds exactly one item",
      "jq": "(.data | length) == 1"
    },
    {
      "reason": "MALFORMED_RESPONSE",
      "says": "the embedding is a non-empty array of numbers",
      "jq": "(.data[0].embedding | type) == \"array\" and (.data[0].embedding | length) > 0 and all(.data[0].embedding[]; type == \"number\")"
    }
  ]
}
