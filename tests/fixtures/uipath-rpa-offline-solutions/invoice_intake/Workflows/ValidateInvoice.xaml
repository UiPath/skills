<Activity mc:Ignorable="sap sap2010" x:Class="ValidateInvoice" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:s="clr-namespace:System;assembly=System.Private.CoreLib" xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation" xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation" xmlns:scg="clr-namespace:System.Collections.Generic;assembly=System.Private.CoreLib" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Members>
    <x:Property Name="in_Vendor" Type="InArgument(x:String)" />
    <x:Property Name="in_InvoiceNumber" Type="InArgument(x:String)" />
    <x:Property Name="in_Total" Type="InArgument(x:Decimal)" />
    <x:Property Name="in_HasTotal" Type="InArgument(x:Boolean)" />
    <x:Property Name="in_VendorsFile" Type="InArgument(x:String)" />
    <x:Property Name="out_Reason" Type="OutArgument(x:String)" />
    <x:Property Name="out_VendorName" Type="OutArgument(x:String)" />
  </x:Members>
  <TextExpression.NamespacesForImplementation>
    <scg:List x:TypeArguments="x:String" Capacity="32">
      <x:String>Microsoft.VisualBasic</x:String>
