      <AssemblyReference>System.Private.CoreLib</AssemblyReference>
      <AssemblyReference>System.Xaml</AssemblyReference>
      <AssemblyReference>System.Xml</AssemblyReference>
      <AssemblyReference>System.Xml.Linq</AssemblyReference>
      <AssemblyReference>UiPath.System.Activities</AssemblyReference>
      <AssemblyReference>mscorlib</AssemblyReference>
    </scg:List>
  </TextExpression.ReferencesForImplementation>
  <Sequence sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="s:String[]" Name="approved" />
    </Sequence.Variables>
    <Assign sap2010:WorkflowViewState.IdRef="find">
      <Assign.To>
        <OutArgument x:TypeArguments="s:String[]">[approved]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="s:String[]">[File.ReadAllLines(in_VendorsFile).Skip(1).Where(Function(l) l.Trim() &lt;&gt; "").Select(Function(l) l.Split(","c)).FirstOrDefault(Function(f) f(0).Trim().ToLowerInvariant() = in_Vendor.Trim().ToLowerInvariant())]</InArgument>
      </Assign.Value>
    </Assign>
    <Assign sap2010:WorkflowViewState.IdRef="name">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[out_VendorName]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[If(approved Is Nothing, in_Vendor, approved(0).Trim())]</InArgument>
      </Assign.Value>
    </Assign>
    <Assign sap2010:WorkflowViewState.IdRef="reason">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[out_Reason]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[If(in_InvoiceNumber = "" OrElse Not in_HasTotal, "Missing invoice number or total", If(approved Is Nothing, "Unknown vendor", If(in_Total &gt; Decimal.Parse(approved(1).Trim(), System.Globalization.CultureInfo.InvariantCulture), "Over credit limit", "")))]</InArgument>
      </Assign.Value>
    </Assign>
  </Sequence>
</Activity>
