<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:uipath="http://uipath.org/schema/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" exporter="UiPath Maestro (https://uipath.com)" exporterVersion="1.200.0">
  <bpmn:process id="Process_1" name="Risk Score Script">
    <bpmn:extensionElements>
      <uipath:variables version="v1">
        <uipath:input id="amount" name="amount" type="number" elementId="Event_start" />
        <uipath:input id="daysOverdue" name="daysOverdue" type="integer" elementId="Event_start" />
        <uipath:inputOutput id="amountIn" name="amountIn" type="number" elementId="Event_start" />
        <uipath:inputOutput id="daysOverdueIn" name="daysOverdueIn" type="integer" elementId="Event_start" />
        <uipath:inputOutput id="riskScoreValue" name="scriptResponse" type="double" elementId="calculateRiskScore" />
        <uipath:inputOutput id="calculateRiskScore_Error" name="Error" type="jsonSchema" elementId="calculateRiskScore">{"type":"object","properties":{"code":{"type":"string"},"message":{"type":"string"},"detail":{"type":"string"},"category":{"type":"string"},"status":{"type":"number"},"element":{"type":"string"}}}</uipath:inputOutput>
        <uipath:output id="riskScore" name="riskScore" type="number" elementId="completed" />
      </uipath:variables>
      <uipath:migrationVersion version="21" />
    </bpmn:extensionElements>
    <bpmn:startEvent id="Event_start" name="core.trigger.manual">
      <bpmn:extensionElements>
        <uipath:entryPointId value="e2e00000-0000-4000-8000-000000000001" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.Variables" version="v1" />
          <uipath:output name="amount" type="number" source="=vars.amount" var="amountIn" />
          <uipath:output name="daysOverdue" type="integer" source="=vars.daysOverdue" var="daysOverdueIn" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_Event_start_calculateRiskScore</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:scriptTask id="calculateRiskScore" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.Variables" version="v1" />
          <uipath:context>
            <uipath:inputSchema type="jsonSchema">{"type":"object","properties":{"vars":{"type":"object"},"metadata":{"type":"object"}}}</uipath:inputSchema>
          </uipath:context>
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"vars":"=vars","metadata":"=metadata"}]]></uipath:input>
          <uipath:output name="scriptResponse" type="double" source="=result.response" var="riskScoreValue" />
          <uipath:output name="Error" type="jsonSchema" source="=Error" var="calculateRiskScore_Error" />
        </uipath:mapping>
        <uipath:scriptVersion value="v3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Event_start_calculateRiskScore</bpmn:incoming>
      <bpmn:outgoing>Flow_calculateRiskScore_completed</bpmn:outgoing>
      <bpmn:script>return Math.max(0, vars.amountIn) * 0.01 + Math.max(0, vars.daysOverdueIn) * 2;</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:endEvent id="completed">
      <bpmn:extensionElements>
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.Variables" version="v1" />
          <uipath:output name="riskScore" type="number" source="=js:vars.riskScoreValue" var="riskScore" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_calculateRiskScore_completed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Event_start_calculateRiskScore" sourceRef="Event_start" targetRef="calculateRiskScore" />
    <bpmn:sequenceFlow id="Flow_calculateRiskScore_completed" sourceRef="calculateRiskScore" targetRef="completed" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="S_Event_start" bpmnElement="Event_start">
        <dc:Bounds x="252" y="192" width="96" height="96" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="252" y="293" width="96" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_calculateRiskScore" bpmnElement="calculateRiskScore">
        <dc:Bounds x="398" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_completed" bpmnElement="completed">
        <dc:Bounds x="548" y="222" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="S_Flow_Event_start_calculateRiskScore" bpmnElement="Flow_Event_start_calculateRiskScore">
        <di:waypoint x="348" y="240" />
        <di:waypoint x="398" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="S_Flow_calculateRiskScore_completed" bpmnElement="Flow_calculateRiskScore_completed">
        <di:waypoint x="498" y="240" />
        <di:waypoint x="548" y="240" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
