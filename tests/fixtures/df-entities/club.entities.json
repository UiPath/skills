{
  "version": 1,
  "choiceSets": {
    "EventType": { "displayName": "Event type", "values": [{ "name": "Meeting", "displayName": "Meeting" }, { "name": "Game", "displayName": "Game" }] }
  },
  "entities": {
    "clubMember": {
      "kind": "native",
      "realizes": [{ "class": "Member", "role": "owner" }],
      "fields": {
        "memberId": { "type": "STRING", "length": 12, "required": true, "unique": true, "property": "Member.memberId" },
        "email": { "type": "STRING", "length": 120, "property": "Member.email" }
      }
    },
    "clubEvent": {
      "kind": "native",
      "realizes": [{ "class": "Event", "role": "owner" }],
      "fields": {
        "eventName": { "type": "STRING", "length": 80, "required": true, "property": "Event.name" },
        "type": { "type": "CHOICE_SET_SINGLE", "choiceSet": "EventType", "required": true, "property": "Event.type" },
        "budget": { "type": "DECIMAL", "precision": 2, "property": "Event.budget" },
        "startsAt": { "type": "DATETIME_WITH_TZ", "property": "Event.startsAt" }
      }
    },
    "clubAttendance": {
      "kind": "native",
      "realizes": [{ "class": "Member", "role": "junction" }],
      "fields": {
        "member": { "type": "RELATIONSHIP", "target": "clubMember", "display": "memberId", "required": true, "property": "Member.attends" },
        "eventRef": { "type": "RELATIONSHIP", "target": "clubEvent", "display": "eventName", "required": true }
      }
    }
  }
}
