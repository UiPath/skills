   "sourcePort": "outcome-technical",
   "targetNodeId": "route",
   "targetPort": "input"
  },
  {
   "sourceNodeId": "pick",
   "sourcePort": "outcome-account",
   "targetNodeId": "route",
   "targetPort": "input"
  }
 ],
 "variables": {
  "variableUpdates": {
   "classify": [
    {
     "variableId": "category",
     "expression": {
      "type": "jsExpression",
      "expression": "$vars.classify.output.category",
      "fieldType": "string"
     }
    },
    {
     "variableId": "confidence",
     "expression": {
      "type": "jsExpression",
      "expression": "$vars.classify.output.confidence",
      "fieldType": "number"
     }
    }
   ],
   "pick": [
    {
     "variableId": "category",
