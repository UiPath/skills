{
 "nodes": [
  {
   "id": "start",
   "type": "core.trigger.manual",
   "inputs": {}
  },
  {
   "id": "classify",
   "type": "uipath.agent.autonomous",
   "inputs": {
    "source": "c482a915-d441-4c49-bfc7-dd212cf80765",
    "agentInputVariables": [
     {
      "id": "start__output__subject",
      "type": "string",
      "binding": "=js:$vars.start.output.subject"
     }
    ],
    "agentOutputVariables": [
     {
      "id": "category",
      "type": "string"
     },
     {
      "id": "confidence",
      "type": "number"
     }
    ]
   }
  },
  {
   "id": "floor",
   "type": "core.logic.decision",
   "inputs": {
    "trueLabel": "True",
    "falseLabel": "False",
    "expression": "($vars.classify.output.confidence ?? 0) < 0.7"
   }
  },
  {
   "id": "route",
   "type": "core.logic.switch",
   "inputs": {
    "cases": [
     {
      "id": "case_1",
      "label": "Case \"Billing\"",
      "expression": "$vars.category === \"Billing\""
     },
     {
      "id": "case_2",
      "label": "Case \"Technical\"",
      "expression": "$vars.category === \"Technical\""
     },
     {
      "id": "case_3",
      "label": "Case \"Account\"",
      "expression": "$vars.category === \"Account\""
     }
    ],
    "hasDefault": true
   }
  },
  {
   "id": "handleBilling",
   "type": "core.logic.mock",
   "inputs": {}
  },
  {
   "id": "end",
   "type": "core.control.end",
   "inputs": {}
  },
  {
   "id": "handleTechnical",
   "type": "core.logic.mock",
   "inputs": {}
  },
  {
   "id": "end2",
   "type": "core.control.end",
   "inputs": {}
  },
  {
   "id": "handleAccount",
   "type": "core.logic.mock",
   "inputs": {}
  },
  {
   "id": "end3",
   "type": "core.control.end",
   "inputs": {}
  },
  {
   "id": "picked",
   "type": "core.logic.decision",
   "inputs": {
    "trueLabel": "True",
    "falseLabel": "False",
    "expression": "!!$vars.pick.output"
   }
  },
  {
   "id": "end4",
   "type": "core.control.end",
   "inputs": {}
  },
  {
   "id": "pick",
   "type": "uipath.human-in-the-loop",
   "inputs": {
    "type": "quick",
    "title": "Pick",
    "priority": "Low",
    "recipient": {
     "channels": [
      "Email",
      "ActionCenter"
     ],
     "connections": {},
     "assignee": {
      "type": "group"
     }
    },
    "schema": {
     "schemaId": "37287370-f011-55cf-9a61-565534c5e104",
     "fields": [
      {
       "id": "subject",
       "label": "subject",
       "type": "string",
       "direction": "input",
       "binding": "vars.start.output.subject"
      }
     ],
     "outcomes": [
      {
       "id": "billing",
       "name": "Billing",
       "type": "string",
       "isPrimary": true,
       "action": "Continue"
      },
      {
       "id": "technical",
       "name": "Technical",
       "type": "string",
       "isPrimary": false,
       "action": "Continue"
      },
      {
       "id": "account",
       "name": "Account",
       "type": "string",
       "isPrimary": false,
       "action": "Continue"
      }
     ]
    }
   }
  }
 ],
 "edges": [
  {
   "sourceNodeId": "start",
   "sourcePort": "output",
