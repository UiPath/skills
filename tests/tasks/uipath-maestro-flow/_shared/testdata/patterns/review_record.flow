{
 "nodes": [
  {
   "id": "start",
   "type": "core.trigger.manual",
   "inputs": {}
  },
  {
   "id": "eachClaim",
   "type": "core.logic.loop",
   "inputs": {
    "collection": {
     "type": "jsExpression",
     "expression": "$vars.start.output.claims",
     "fieldType": "array"
    },
    "parallel": false,
    "breakEnabled": false
   }
  },
  {
   "id": "decide",
   "type": "uipath.agent.autonomous",
   "parentId": "eachClaim",
   "inputs": {
    "source": "0c464e5d-e635-49db-9642-28c53b34dce7",
    "agentInputVariables": [
     {
      "id": "eachClaim__currentItem",
      "type": "string",
      "binding": "=js:$vars.eachClaim.currentItem"
     }
    ],
    "agentOutputVariables": [
     {
      "id": "decision",
      "type": "string"
     },
     {
      "id": "confidence",
      "type": "number"
     }
    ],
    "errorHandlingEnabled": true
   }
  },
  {
   "id": "lowConfidence",
   "type": "core.logic.decision",
   "parentId": "eachClaim",
   "inputs": {
    "trueLabel": "True",
    "falseLabel": "False",
    "expression": "$vars.decide.output.confidence < 0.8"
   }
  },
  {
   "id": "review",
   "type": "uipath.human-in-the-loop",
   "parentId": "eachClaim",
   "inputs": {
    "type": "quick",
    "title": "Review",
    "priority": "Low",
    "recipient": {
     "channels": [
      "Email",
      "ActionCenter"
     ],
     "connections": {},
     "assignee": {
      "type": "group"
     }
    },
    "schema": {
     "schemaId": "560217e6-a6f5-5618-90df-4d5782519431",
     "fields": [
      {
       "id": "decision",
       "label": "decision",
       "type": "string",
       "direction": "input",
       "binding": "vars.decide.output.decision"
      }
     ],
     "outcomes": [
      {
       "id": "approve",
       "name": "Approve",
       "type": "string",
       "isPrimary": true,
       "action": "Continue"
      },
      {
       "id": "reject",
       "name": "Reject",
       "type": "string",
       "isPrimary": false,
       "action": "Continue"
      }
     ]
    }
   }
  },
  {
   "id": "recordSkip",
   "type": "core.action.script",
   "parentId": "eachClaim",
   "inputs": {
    "script": "return { status: \"skipped\" };"
   }
  },
  {
   "id": "applyDecision",
   "type": "core.logic.mock",
   "parentId": "eachClaim",
   "inputs": {}
  },
  {
   "id": "end",
   "type": "core.control.end",
   "inputs": {}
  }
 ],
 "edges": [
  {
   "sourceNodeId": "start",
   "sourcePort": "output",
   "targetNodeId": "eachClaim",
   "targetPort": "input"
  },
  {
   "sourceNodeId": "eachClaim",
   "sourcePort": "start",
   "targetNodeId": "decide",
   "targetPort": "input"
  },
  {
   "sourceNodeId": "decide",
   "sourcePort": "error",
   "targetNodeId": "eachClaim",
   "targetPort": "continue"
  },
  {
   "sourceNodeId": "decide",
   "sourcePort": "success",
   "targetNodeId": "lowConfidence",
   "targetPort": "input"
  },
  {
   "sourceNodeId": "lowConfidence",
   "sourcePort": "true",
   "targetNodeId": "review",
   "targetPort": "input"
  },
  {
   "sourceNodeId": "review",
   "sourcePort": "outcome-reject",
   "targetNodeId": "recordSkip",
   "targetPort": "input"
  },
  {
   "sourceNodeId": "recordSkip",
   "sourcePort": "success",
   "targetNodeId": "eachClaim",
   "targetPort": "continue"
  },
  {
   "sourceNodeId": "lowConfidence",
   "sourcePort": "false",
   "targetNodeId": "applyDecision",
   "targetPort": "input"
  },
  {
   "sourceNodeId": "applyDecision",
   "sourcePort": "output",
   "targetNodeId": "eachClaim",
   "targetPort": "continue"
  },
  {
   "sourceNodeId": "eachClaim",
   "sourcePort": "success",
   "targetNodeId": "end",
   "targetPort": "input"
  },
  {
   "sourceNodeId": "review",
   "sourcePort": "outcome-approve",
   "targetNodeId": "applyDecision",
   "targetPort": "input"
  }
 ]
}
