{
 "nodes": [
  {
   "id": "start",
   "type": "core.trigger.manual",
   "inputs": {}
  },
  {
   "id": "normalizeItem",
   "type": "core.logic.mock",
   "inputs": {}
  },
  {
   "id": "routeByCategory",
   "type": "core.logic.switch",
   "inputs": {
    "cases": [
     {
      "id": "case_1",
      "label": "Case \"billing\"",
      "expression": "$vars.category === \"billing\""
     },
     {
      "id": "case_2",
      "label": "Case \"technical\"",
      "expression": "$vars.category === \"technical\""
     },
     {
      "id": "case_3",
      "label": "Case \"account\"",
      "expression": "$vars.category === \"account\""
     }
    ],
    "hasDefault": true
   }
  },
  {
   "id": "handle_billing",
   "type": "core.logic.mock",
   "inputs": {}
  },
  {
   "id": "end",
   "type": "core.control.end",
   "inputs": {}
  },
  {
   "id": "handle_technical",
   "type": "core.logic.mock",
   "inputs": {}
  },
  {
   "id": "end2",
   "type": "core.control.end",
   "inputs": {}
  },
  {
   "id": "handle_account",
   "type": "core.logic.mock",
   "inputs": {}
  },
  {
   "id": "end3",
   "type": "core.control.end",
   "inputs": {}
  },
  {
   "id": "agentRan",
   "type": "core.logic.decision",
   "inputs": {
    "trueLabel": "True",
    "falseLabel": "False",
    "expression": "!!$vars.classifyItem.output"
   }
  },
  {
   "id": "classifyItem",
   "type": "uipath.agent.autonomous",
   "inputs": {
    "source": "1404ce66-2798-47fe-ba78-6ad26c139a1a",
    "agentInputVariables": [
     {
      "id": "itemSubject",
      "type": "string",
      "binding": "=js:$vars.itemSubject"
     }
    ],
    "agentOutputVariables": [
     {
      "id": "category",
      "type": "string"
     },
     {
      "id": "confidence",
      "type": "number"
     }
    ]
   }
  },
  {
   "id": "confidenceFloor",
   "type": "core.logic.decision",
   "inputs": {
    "trueLabel": "True",
    "falseLabel": "False",
    "expression": "$vars.classifyItem.output.confidence >= 0.7"
   }
  },
  {
   "id": "pickCategory",
   "type": "uipath.human-in-the-loop.quick-form",
   "inputs": {
    "title": "Pick",
    "priority": "Low",
    "recipient": {
     "channels": [
      "Email",
      "ActionCenter"
     ],
     "connections": {},
     "assignee": {
      "type": "group"
     }
    },
    "schema": {
     "schemaId": "62525941-1366-5a67-870b-e5c66704e0d2",
     "fields": [
      {
       "id": "subject",
       "label": "Subject",
       "type": "string",
       "direction": "input",
       "binding": "vars.start.output.subject"
      }
     ],
     "outcomes": [
      {
       "id": "billing",
       "name": "billing",
       "type": "string",
       "isPrimary": true,
       "action": "Continue"
      },
      {
       "id": "technical",
       "name": "technical",
       "type": "string",
       "isPrimary": false,
       "action": "Continue"
      },
      {
       "id": "account",
       "name": "account",
       "type": "string",
       "isPrimary": false,
       "action": "Continue"
      }
     ]
    }
   }
  }
 ],
 "edges": [
  {
   "sourceNodeId": "start",
   "sourcePort": "output",
   "targetNodeId": "normalizeItem",
   "targetPort": "input"
  },
  {
   "sourceNodeId": "normalizeItem",
   "sourcePort": "output",
   "targetNodeId": "routeByCategory",
   "targetPort": "input"
  },
  {
   "sourceNodeId": "routeByCategory",
   "sourcePort": "case-case_1",
   "targetNodeId": "handle_billing",
   "targetPort": "input"
  },
  {
   "sourceNodeId": "handle_billing",
   "sourcePort": "output",
   "targetNodeId": "end",
   "targetPort": "input"
  },
  {
   "sourceNodeId": "routeByCategory",
   "sourcePort": "case-case_2",
   "targetNodeId": "handle_technical",
   "targetPort": "input"
  },
  {
   "sourceNodeId": "handle_technical",
   "sourcePort": "output",
   "targetNodeId": "end2",
   "targetPort": "input"
  },
  {
   "sourceNodeId": "routeByCategory",
   "sourcePort": "case-case_3",
   "targetNodeId": "handle_account",
   "targetPort": "input"
  },
  {
   "sourceNodeId": "handle_account",
   "sourcePort": "output",
   "targetNodeId": "end3",
   "targetPort": "input"
  },
  {
   "sourceNodeId": "routeByCategory",
   "sourcePort": "default",
   "targetNodeId": "agentRan",
   "targetPort": "input"
  },
  {
   "sourceNodeId": "classifyItem",
   "sourcePort": "success",
   "targetNodeId": "confidenceFloor",
   "targetPort": "input"
  },
  {
   "sourceNodeId": "confidenceFloor",
   "sourcePort": "false",
   "targetNodeId": "pickCategory",
   "targetPort": "input"
  },
  {
   "sourceNodeId": "agentRan",
   "sourcePort": "true",
   "targetNodeId": "pickCategory",
   "targetPort": "input"
  },
  {
   "sourceNodeId": "agentRan",
   "sourcePort": "false",
   "targetNodeId": "classifyItem",
   "targetPort": "input"
  },
  {
   "sourceNodeId": "confidenceFloor",
   "sourcePort": "true",
   "targetNodeId": "routeByCategory",
   "targetPort": "input"
  },
  {
   "sourceNodeId": "pickCategory",
   "sourcePort": "outcome-billing",
   "targetNodeId": "routeByCategory",
   "targetPort": "input"
  },
  {
   "sourceNodeId": "pickCategory",
   "sourcePort": "outcome-technical",
   "targetNodeId": "routeByCategory",
   "targetPort": "input"
  },
  {
   "sourceNodeId": "pickCategory",
   "sourcePort": "outcome-account",
   "targetNodeId": "routeByCategory",
   "targetPort": "input"
  }
 ],
 "variables": {
  "variableUpdates": {
   "normalizeItem": [
    {
     "variableId": "category",
     "expression": {
      "type": "jsExpression",
      "expression": "$vars.start.output.type",
      "fieldType": "string"
     }
    },
    {
     "variableId": "itemSubject",
     "expression": {
      "type": "jsExpression",
      "expression": "$vars.start.output.subject",
      "fieldType": "string"
     }
    }
   ],
   "classifyItem": [
    {
     "variableId": "category",
     "expression": {
      "type": "jsExpression",
      "expression": "$vars.classifyItem.output.category",
      "fieldType": "string"
     }
    }
   ],
   "pickCategory": [
    {
     "variableId": "category",
     "expression": {
      "type": "jsExpression",
      "expression": "$vars.pickCategory.output.Action",
      "fieldType": "string"
     }
    }
   ]
  }
 }
}
