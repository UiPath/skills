      "expression": "$vars.triageAgent.output.uipath__voice_session.reason === \"A\""
     },
     {
      "id": "case_2",
      "label": "Case \"B\"",
      "expression": "$vars.triageAgent.output.uipath__voice_session.reason === \"B\""
     }
    ],
    "hasDefault": true
   }
  },
