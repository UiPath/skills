        "iconBackgroundDark": "linear-gradient(225deg, #526069 0%, rgba(50, 60, 66, 0.6) 100%)"
      },
      "handleConfiguration": [
        {
          "position": "right",
          "handles": [
            {
              "id": "output",
              "type": "source",
              "handleType": "output",
              "showButton": true,
              "constraints": {
                "minConnections": 1,
                "severity": "warning",
                "validationMessage": "Trigger must connect to at least one workflow node (not configuration nodes)"
              }
            }
          ],
          "visible": true
        }
      ],
      "model": {
        "type": "bpmn:StartEvent",
        "entryPointId": true
      },
      "outputDefinition": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the workflow.",
          "source": "null",
          "var": "output"
        }
      }
    },
    {
      "nodeType": "uipath.human-in-the-loop",
      "version": "1.1",
      "category": "human-task",
      "description": "Pause the process and wait for human task completion",
      "tags": [
        "human-task",
        "hitl",
        "human-in-the-loop",
        "approval"
      ],
      "sortOrder": 50,
      "display": {
        "label": "Human Task — Quick Form / App",
        "icon": "users",
        "shape": "square"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ],
          "visible": true
        },
        {
          "position": "right",
          "handles": [
            {
              "id": "outcome-{item.id}",
              "label": "{item.name}",
              "type": "source",
              "handleType": "output",
              "showButton": true,
              "constraints": {
                "forbiddenTargetCategories": [
                  "trigger"
                ]
              },
              "repeat": "inputs.schema.outcomes"
            }
          ],
          "visible": true
        }
      ],
      "model": {
        "type": "bpmn:UserTask",
        "serviceType": "Actions.HITL"
      },
      "inputDefaults": {
        "type": "quick",
        "schema": {
          "fields": [],
          "outcomes": [
            {
              "id": "submit",
              "name": "Submit",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            }
          ]
        },
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group"
          }
        }
      },
      "outputDefinition": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output"
        },
        "status": {
          "type": "string",
          "description": "Task completion status (completed, cancelled, timeout)",
          "source": "=result.Action",
          "var": "status"
        }
      },
      "form": {
        "id": "hitl-properties",
        "title": "Human task configuration",
        "sections": [
          {
            "id": "task-type",
            "title": "Task Type",
            "collapsible": false,
            "defaultExpanded": true,
            "fields": [
              {
                "name": "inputs.type",
                "type": "select",
                "label": "Type",
                "options": [
                  {
                    "label": "Quick Form",
                    "value": "quick"
                  },
                  {
                    "label": "Custom App",
                    "value": "custom"
                  }
                ]
              }
            ]
          },
          {
            "id": "delivery",
            "title": "Task delivery",
            "collapsible": true,
            "defaultExpanded": true,
            "fields": [
              {
                "name": "inputs.recipient",
                "type": "custom",
                "component": "hitl-channel-selector",
                "label": "Delivery Channels",
                "description": "Select where the task should be sent"
              }
            ]
          },
          {
            "id": "schema",
            "title": "Schema",
            "collapsible": true,
            "defaultExpanded": false,
            "fields": [
              {
                "name": "inputs.schema",
                "type": "custom",
                "component": "hitl-schema-editor",
                "label": "Task Schema",
                "description": "Define the input and output parameters for this task"
              }
            ]
          },
          {
            "id": "additional-properties",
            "title": "Additional properties",
            "collapsible": true,
            "defaultExpanded": true,
            "fields": [
              {
                "name": "inputs.title",
                "type": "text",
                "label": "Task title"
              },
              {
                "name": "inputs.priority",
                "type": "select",
                "label": "Priority",
                "options": [
                  {
                    "label": "Low",
                    "value": "Low"
                  },
                  {
                    "label": "Medium",
                    "value": "Medium"
                  },
                  {
                    "label": "High",
                    "value": "High"
                  }
                ]
              },
              {
                "name": "inputs.labels",
                "type": "text",
                "label": "Labels",
                "placeholder": "Comma-separated (e.g. finance,approval)"
              }
            ]
          },
          {
            "id": "app",
            "title": "Custom Approval App",
            "collapsible": true,
            "defaultExpanded": true,
            "fields": [
              {
                "name": "inputs.app",
                "type": "custom",
                "component": "hitl-app-picker",
                "label": "Action App",
                "description": "Select the coded action app for this task"
              },
              {
                "name": "inputs.appInputBindings",
                "type": "custom",
                "component": "hitl-app-inputs",
                "label": "Inputs",
                "description": "Map app inputs to expressions/variables"
              }
            ]
          }
        ]
      },
      "runtimeConstraints": {
        "exclude": [
          "api-function"
        ]
      }
    },
