#!/usr/bin/env python3
"""`uip` mock for the Extract document tasks.

Answers `uip maestro flow extraction check` with the status in
mocks/extraction-status, which the task's pre_run writes. The answer has the
shape the CLI prints (UiPath/cli packages/flow-tool/src/commands/extraction.ts).
Every other call runs the real `uip` later on PATH.

Why mock: the CLI that ships the command is not released yet, and the test
tenant's answer is not pinned. Faking only this one call keeps the rest of the
run real.

Every call is logged to mocks/calls.log as one `uip <args>` line, in the order
they ran, so criteria can check what ran and when.
"""

import json
import os
import sys

MOCK_DIR = os.path.dirname(os.path.realpath(__file__))

REASONS = {
    "Available": "Document extraction is available on this tenant.",
    "FeatureDisabled": "Document extraction is turned off for this tenant.",
    "ServiceUnavailable": "This environment does not serve document extraction.",
    "ModelUnavailable": "This tenant offers no model to extract with.",
    "Unknown": "The extraction service answered 403, so availability could not be determined.",
}


def log(args):
    line = " ".join(["uip", *args]).replace("\n", " ")
    with open(os.path.join(MOCK_DIR, "calls.log"), "a", encoding="utf-8") as f:
        f.write(line + "\n")


def extraction_check():
    with open(os.path.join(MOCK_DIR, "extraction-status"), encoding="utf-8") as f:
        status = f.read().strip()
    reason = REASONS[status]
    available = status == "Available"
    if available:
        instructions = "Add an Extract document node with 'uip maestro flow nodes create'."
    else:
        instructions = f"{reason} Tell the user, and do not add an Extract document node to the flow."
    print(json.dumps({
        "Result": "Success",
        "Code": "ExtractionCheckSuccess",
        "Data": {"Available": available, "Status": status, "Reason": reason, "Tenant": "DefaultTenant"},
        "Instructions": instructions,
    }, indent=2))


def find_real_uip():
    me = os.path.realpath(__file__)
    for path_dir in os.environ.get("PATH", "").split(os.pathsep):
        candidate = os.path.join(path_dir or ".", "uip")
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK) and os.path.realpath(candidate) != me:
            return candidate
    return None


def main():
    args = sys.argv[1:]
    log(args)
    if args[:4] == ["maestro", "flow", "extraction", "check"]:
        extraction_check()
        return 0
    real_uip = find_real_uip()
    if real_uip is None:
        sys.stderr.write("uip mock: real uip not found later on PATH\n")
        return 127
    os.execv(real_uip, [real_uip, *args])


if __name__ == "__main__":
    sys.exit(main())
