      "outputDefinition": {
        "output": {
          "name": "output",
          "type": "object",
          "source": "=this",
          "var": "output",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "description": "Processed document emitted by an IDP processor run.",
            "properties": {
              "version": {
                "type": "string",
                "description": "Output contract version, for forward evolution and backwards-compatibility handling."
              },
              "type": {
                "type": "string",
                "enum": [
                  "Extraction",
                  "Classification"
                ],
                "description": "Processor kind that produced the document; fixes the shape of result and taxonomy. Possible values: Extraction, Classification."
              },
              "result": {
                "type": "object",
                "description": "The engine output: the processor values plus their attribution.",
                "properties": {
                  "output": {
                    "type": "object",
                    "description": "Processor output, one property per taxonomy field, typed by the taxonomy."
                  },
                  "attribution": {
                    "type": "object",
                    "description": "Per-value provenance keyed by RFC 6901 JSON Pointer into output (e.g. \"/Net pay\").",
                    "additionalProperties": {
                      "type": "object",
                      "properties": {
                        "confidence": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "sources": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "description": "Where a value was read from; one entry per attachment page.",
                            "properties": {
                              "attachmentId": {
                                "type": "string",
                                "description": "Attachment (document) the value was read from."
                              },
                              "pageNumber": {
                                "type": "integer"
                              },
                              "boundingBoxes": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "xMin": {
                                      "type": "number"
                                    },
                                    "xMax": {
                                      "type": "number"
                                    },
                                    "yMin": {
                                      "type": "number"
                                    },
                                    "yMax": {
                                      "type": "number"
                                    }
                                  },
                                  "required": [
                                    "xMin",
                                    "xMax",
                                    "yMin",
                                    "yMax"
                                  ]
                                }
                              }
                            },
                            "required": [
                              "attachmentId",
                              "pageNumber",
                              "boundingBoxes"
                            ]
                          }
                        }
                      },
                      "required": [
                        "confidence",
                        "sources"
                      ]
                    }
                  },
                  "traceContext": {
                    "type": "object",
                    "description": "Trace context of the producing run, as the engine wrote it; the same ids are lifted into metadata.",
                    "properties": {
                      "traceId": {
                        "type": "string",
                        "minLength": 1,
                        "description": "W3C trace id of the producing run."
                      },
                      "spanId": {
                        "type": "string",
                        "minLength": 1,
                        "description": "The producing span."
                      },
                      "folderKey": {
                        "type": "string",
                        "description": "Folder the producing run executed in."
                      }
                    },
                    "required": [
                      "traceId",
                      "spanId",
                      "folderKey"
                    ]
                  }
                },
                "required": [
                  "output",
                  "attribution",
                  "traceContext"
                ]
              },
              "taxonomy": {
                "type": "object",
                "description": "The extraction schema the result was produced against; one property per taxonomy field."
              },
              "metadata": {
                "type": "object",
                "description": "Identifiers of the run and the document, for calling back into the platform, plus the model configuration the run executed with. New run or document descriptors are added here.",
                "properties": {
                  "pipelineRunId": {
                    "type": "string",
                    "description": "GUID of the IDP pipeline run that produced this output; ties it back to the Processor run for support and debugging."
                  },
                  "folderKey": {
                    "type": "string",
                    "description": "Folder the producing run executed in; the x-uipath-folderkey for Traces, Buckets and Feedback calls."
                  },
                  "traceId": {
                    "type": "string",
                    "minLength": 1,
                    "description": "W3C trace id of the producing run; the key to its spans and artifacts in the Traces service."
                  },
                  "spanId": {
                    "type": "string",
                    "minLength": 1,
                    "description": "The producing span; the Feedback anchor."
                  },
                  "modelConfig": {
                    "type": "object",
                    "description": "The processor configuration this run used. It grows with the processor: read the keys you know and tolerate the rest.",
                    "properties": {
                      "prompt": {
                        "type": "string",
                        "description": "The overall instructions the author wrote for the operation."
                      },
                      "extractionStrategy": {
                        "type": "string",
                        "description": "The configured extraction strategy (e.g. ZeroShot, DynamicExtract)."
                      },
                      "attributionStrategy": {
                        "type": "string",
                        "description": "The configured attribution strategy (e.g. WordId, Visual); it decides what result.attribution can carry."
                      },
                      "languageSupport": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "The configured language support (e.g. auto): the setting, not the language detected in the document."
                      },
                      "layoutParsing": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "The configured layout parsing (e.g. uipath-figure-to-text)."
                      },
                      "overrides": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "Engine-level overrides set on the processor, as a serialized JSON string; parse it before reading."
                      },
                      "modelOverride": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "The model the run was configured with (e.g. gemini-2.5-flash); null when the processor runs on the default."
                      }
                    },
                    "required": [
                      "prompt",
                      "languageSupport",
                      "modelOverride",
                      "extractionStrategy",
                      "attributionStrategy"
                    ]
                  }
                },
                "required": [
                  "pipelineRunId",
                  "folderKey",
                  "traceId",
                  "spanId",
                  "modelConfig"
                ]
              }
            },
            "required": [
              "version",
              "type",
              "result",
              "taxonomy",
              "metadata"
            ]
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  ],
