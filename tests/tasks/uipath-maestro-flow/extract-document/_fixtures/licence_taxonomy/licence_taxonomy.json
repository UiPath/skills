{
  "prompt": "Extract the licence details as printed on the form.",
  "outputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "Licence Details": {
        "type": ["object", "null"],
        "description": "The licence form, which appears once per document.",
        "additionalProperties": false,
        "properties": {
          "Licence Number": { "$ref": "#/$defs/ft-exact-text", "description": "The licence number exactly as printed in the licence number box." },
          "Licence Expiry": { "$ref": "#/$defs/ft-date", "description": "The date the licence expires, not the date it was issued." },
          "Falconer": { "$ref": "#/$defs/ft-text", "description": "The name of the licence holder." },
          "Licence Status": { "$ref": "#/$defs/ft-inferred-text", "description": "The status printed on the licence, such as ACTIVE." }
        }
      },
      "Licence > Bird": {
        "type": ["object", "null"],
        "description": "The bird the licence covers.",
        "additionalProperties": false,
        "properties": {
          "Ring Number": { "$ref": "#/$defs/ft-exact-text", "description": "The ring number fitted to the bird." },
          "Species": { "$ref": "#/$defs/ft-inferred-text", "description": "The species of the bird, as printed." },
          "Year in which the bird hatched, as printed in the year of hatch box": { "$ref": "#/$defs/ft-number", "description": "The year the bird hatched." }
        }
      }
    },
    "$defs": {
      "ft-exact-text": { "title": "Exact Text", "type": ["string", "null"], "format": "verbatim" },
      "ft-inferred-text": { "title": "Inferred Text", "type": ["string", "null"] },
      "ft-date": { "title": "Date", "type": ["string", "null"], "format": "date" },
      "ft-number": { "title": "Number", "type": ["string", "null"], "format": "decimal" },
      "ft-monetary-quantity": { "title": "Monetary Quantity", "type": ["string", "null"], "format": "monetary" },
      "ft-boolean": { "title": "Boolean", "type": ["boolean", "null"] }
    }
  }
}
