        "icon": "square-dashed"
      },
      "model": {
        "type": "bpmn:Task"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Mock output value",
          "source": {
            "type": "literal",
            "expression": "null",
            "fieldType": "string"
          },
          "var": "output"
        }
      },
      "inputs": {}
    },
    {
      "id": "endAccount",
      "type": "core.control.end",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Routed: account",
        "icon": "circle-check"
      },
      "model": {
        "type": "bpmn:EndEvent"
