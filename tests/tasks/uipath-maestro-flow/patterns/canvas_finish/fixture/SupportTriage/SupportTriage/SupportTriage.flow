{
  "id": "5db4b288-4814-4ff3-a119-abebd002e2bf",
  "version": "1.9",
  "name": "SupportTriage",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger",
        "icon": "play"
      },
      "model": {
        "type": "bpmn:StartEvent",
        "entryPointId": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the process.",
          "source": {
            "type": "literal",
            "expression": "null",
            "fieldType": "string"
          },
          "var": "output"
        }
      },
      "inputs": {}
    },
    {
      "id": "classifyItem",
      "type": "uipath.agent.autonomous",
      "typeVersion": "1.4",
      "display": {
        "label": "Classify item",
        "icon": "autonomous-agent"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Agent response",
          "var": "output",
          "properties": {
            "content": {
              "type": "string",
              "description": "The agent response text"
            }
          },
          "source": {
            "type": "literal",
            "expression": "=result.response",
            "fieldType": "string"
          },
          "schema": {
            "type": "object",
            "properties": {
              "category": {
                "type": "string"
              },
              "confidence": {
                "type": "number"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": {
            "type": "literal",
            "expression": "=Error",
            "fieldType": "string"
          },
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "inputs": {
        "source": "87ae7e40-f676-4708-81cd-04f0cb1d59c0",
        "agentInputVariables": [],
        "agentOutputVariables": [
          {
            "id": "category",
            "type": "string"
          },
          {
            "id": "confidence",
            "type": "number"
          },
          {
            "id": "reason",
            "type": "string"
          }
        ]
      }
    },
    {
      "id": "confidenceFloor",
      "type": "core.logic.decision",
      "typeVersion": "1.0.0",
      "display": {
        "label": "confidenceFloor",
        "icon": "trending-up-down"
      },
      "model": {
        "type": "bpmn:InclusiveGateway"
      },
      "inputs": {
        "trueLabel": "Route automatically",
        "falseLabel": "Ask a person",
        "expression": "$vars.classifyItem.output.confidence >= 0.7"
      }
    },
    {
      "id": "routeByCategory",
      "type": "core.logic.switch",
      "typeVersion": "1.0.0",
      "display": {
        "label": "routeByCategory",
        "icon": "between-horizontal-start"
      },
      "model": {
        "type": "bpmn:ExclusiveGateway"
      },
      "inputs": {
        "cases": [
          {
            "id": "case_1",
            "label": "Billing",
            "expression": "$vars.classifyItem.output.category === \"billing\""
          },
          {
            "id": "case_2",
            "label": "Technical",
            "expression": "$vars.classifyItem.output.category === \"technical\""
          },
          {
            "id": "case_3",
            "label": "Account",
            "expression": "$vars.classifyItem.output.category === \"account\""
          }
        ],
        "hasDefault": true
      }
    },
    {
      "id": "handleBilling",
      "type": "core.logic.mock",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Handle billing (replace with your billing downstream)",
        "icon": "square-dashed"
      },
      "model": {
        "type": "bpmn:Task"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Mock output value",
          "source": {
            "type": "literal",
            "expression": "null",
            "fieldType": "string"
          },
          "var": "output"
        }
      },
      "inputs": {}
    },
    {
      "id": "endBilling",
      "type": "core.control.end",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Routed: billing",
        "icon": "circle-check"
      },
      "model": {
        "type": "bpmn:EndEvent"
      },
      "inputs": {},
      "outputs": {
        "routedTo": {
          "type": "string",
          "description": "",
          "source": {
            "type": "jsExpression",
            "expression": "\"billing\"",
            "fieldType": "string"
          },
          "var": "routedTo"
        }
      }
    },
    {
