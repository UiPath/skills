#!/usr/bin/env python3
"""Record each `uip` call, then run the real CLI against the live tenant.

PATH-shadows `uip` in the sandbox (`mock_path_dirs`). Nothing is faked: every
call reaches the real CLI and the real tenant, and its exit code and output reach
the agent unchanged. Alongside, one JSON line per call goes to `.calls.jsonl`
next to this script, so a grader can read what the agent SUBMITTED, which the
tenant's normalized read-back cannot show:

    {"ts": ..., "args": "ah automations create --from-schema ...",
     "exit_code": 0, "result": "Success", "data_id": 4815,
     "captured": {"path": "./ah-answers.json", "sha256": ..., "json": {...}}}

`captured` snapshots the `--file` argument before the call runs, so a file the
agent rewrites afterwards does not change the grade. `result` and `data_id` come
from the CLI's JSON envelope (`Result`, `Data.Id`) when it printed one.

Two switches, both set by the harness, never by the agent:
  AH_EVAL_NO_RECORD=1   run without recording (setup and grading scripts' own calls)
  ../.ah-tenant.json    when present, run the real CLI on another tenant of the same
                        organization (_setup/use_tenant.py), through its env-var auth
"""

from __future__ import annotations

import base64
import hashlib
import json
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
CALL_LOG = SCRIPT_DIR / ".calls.jsonl"
_DECODER = json.JSONDecoder()

# --- tenant switch: keep in sync with _setup/ah_cli.py ----------------------------
TENANT_MARKER_NAME = ".ah-tenant.json"
_ENV_AUTH = {
    "UIPATH_CLI_AUTH_TOKEN": "UIPATH_ACCESS_TOKEN",
    "UIPATH_CLI_ORGANIZATION_NAME": "UIPATH_ORGANIZATION_NAME",
    "UIPATH_CLI_ORGANIZATION_ID": "UIPATH_ORGANIZATION_ID",
}


def _read_login(path: str) -> dict:
    values = {}
    with open(path, encoding="utf-8") as handle:
        for line in handle:
            key, sep, value = line.strip().partition("=")
            if sep:
                values[key] = value
    return values


def _expires_soon(token: str, margin: int = 300) -> bool:
    try:
        payload = token.split(".")[1]
        claims = json.loads(base64.urlsafe_b64decode(payload + "=" * (-len(payload) % 4)))
        return float(claims["exp"]) < time.time() + margin
    except (IndexError, KeyError, ValueError):
        return False


def tenant_env(env: dict, marker: str, real_uip: str) -> dict:
    """`env` switched to the marker's tenant through the CLI's env-var auth.

    The token and organization come from the shared login file on every call, so
    a refresh by any other CLI call is picked up; a token about to expire is
    refreshed first with a plain file-auth `uip login status`.
    """
    with open(marker, encoding="utf-8") as handle:
        target = json.load(handle)
    login = _read_login(target["auth_file"])
    if _expires_soon(login.get("UIPATH_ACCESS_TOKEN", "")):
        subprocess.run([real_uip, "login", "status", "--output", "json"], env=env,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
        login = _read_login(target["auth_file"])
    switched = dict(env)
    for env_key, file_key in _ENV_AUTH.items():
        if not login.get(file_key):
            raise RuntimeError(f"{file_key} missing from {target['auth_file']}")
        switched[env_key] = login[file_key]
    switched["UIPATH_CLI_TENANT_NAME"] = target["tenant_name"]
    switched["UIPATH_CLI_TENANT_ID"] = target["tenant_id"]
    switched["UIPATH_CLI_ENABLE_ENV_AUTH"] = "true"
    return switched
# ----------------------------------------------------------------------------------

TENANT_MARKER = SCRIPT_DIR.parent / TENANT_MARKER_NAME


def real_uip() -> str | None:
    """The real CLI: first `uip` on PATH outside this script's directory."""
    others = []
    for entry in os.environ.get("PATH", "").split(os.pathsep):
        try:
            if entry and Path(entry).resolve() != SCRIPT_DIR:
                others.append(entry)
        except (OSError, ValueError):
            others.append(entry)
    return shutil.which("uip", path=os.pathsep.join(others))


def child_env(target: str) -> dict:
    env = dict(os.environ)
    return tenant_env(env, str(TENANT_MARKER), target) if TENANT_MARKER.is_file() else env


def flag_value(argv: list[str], name: str) -> str | None:
    for i, token in enumerate(argv):
        if token == name and i + 1 < len(argv):
            return argv[i + 1]
        if token.startswith(name + "="):
            return token[len(name) + 1:]
    return None


def capture_file(argv: list[str]) -> dict | None:
    path = flag_value(argv, "--file")
    if path is None:
        return None
    record: dict = {"path": path}
    try:
        data = Path(path).read_bytes()
    except OSError as exc:
        record["error"] = str(exc)
        return record
    record["size"] = len(data)
    record["sha256"] = hashlib.sha256(data).hexdigest()
    if path.lower().endswith(".json"):
        try:
            record["json"] = json.loads(data.decode("utf-8"))
        except (UnicodeDecodeError, json.JSONDecodeError) as exc:
            record["json_error"] = str(exc)
    return record


def envelope(stdout: str) -> dict | None:
    """The CLI's JSON envelope, skipping any update-check chatter around it."""
    start = stdout.find("{")
    while start != -1:
        try:
            value, _ = _DECODER.raw_decode(stdout, start)
        except json.JSONDecodeError:
            value = None
        if isinstance(value, dict):
            return value
        start = stdout.find("{", start + 1)
    return None


def log(record: dict) -> None:
    """Best-effort: a broken log never breaks the agent's command."""
    try:
        with CALL_LOG.open("a", encoding="utf-8") as handle:
            handle.write(json.dumps(record) + "\n")
    except OSError:
        pass


def main(argv: list[str]) -> int:
    target = real_uip()
    if target is None:
        sys.stderr.write("uip recorder: the real uip CLI is not on PATH\n")
        return 127
    try:
        env = child_env(target)
    except (OSError, ValueError, KeyError, RuntimeError) as exc:
        sys.stderr.write(f"uip recorder: cannot switch tenant ({exc}); refusing to run on the default tenant\n")
        return 2
    if os.environ.get("AH_EVAL_NO_RECORD") == "1":
        return subprocess.run([target, *argv], env=env).returncode

    record: dict = {"ts": time.time(), "args": " ".join(argv)}
    captured = capture_file(argv)
    if captured is not None:
        record["captured"] = captured
    # stdin and stderr pass straight through; stdout is buffered only to read the
    # envelope, then written out unchanged.
    proc = subprocess.run([target, *argv], env=env, stdout=subprocess.PIPE)
    sys.stdout.buffer.write(proc.stdout)
    sys.stdout.flush()
    out = proc.stdout.decode("utf-8", errors="replace")
    record["exit_code"] = proc.returncode
    parsed = envelope(out)
    if parsed is not None:
        record["result"] = parsed.get("Result")
        data = parsed.get("Data")
        if isinstance(data, dict) and data.get("Id") is not None:
            record["data_id"] = data["Id"]
    log(record)
    return proc.returncode


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
