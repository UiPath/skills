<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_Target" targetNamespace="https://elara.de/claims/target">
  <bpmn:collaboration id="Collaboration_Target"><bpmn:participant id="Participant_Target" name="Elara Motor Claims STP" processRef="Process_Target" /></bpmn:collaboration>
  <bpmn:process id="Process_Target" name="Future Motor Claims STP {{RUN_TOKEN}}" isExecutable="false">
    <bpmn:startEvent id="Start_Submission" name="Claim submitted"/><bpmn:parallelGateway id="Gateway_Start" name="Start controls"/><bpmn:sendTask id="Task_Acknowledge" name="Send acknowledgment"/><bpmn:boundaryEvent id="Boundary_AckTimer" attachedToRef="Task_Acknowledge" name="30-minute SLA"><bpmn:timerEventDefinition><bpmn:timeDuration>PT30M</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent><bpmn:sendTask id="Task_EscalateAck" name="Escalate acknowledgment breach"/><bpmn:serviceTask id="Task_Validate" name="Validate claim and coverage"/><bpmn:exclusiveGateway id="Gateway_Covered" name="Complete and covered?"/><bpmn:serviceTask id="Task_Fraud" name="Score fraud"/><bpmn:exclusiveGateway id="Gateway_FraudResult" name="Fraud outcome?"/><bpmn:serviceTask id="Task_Assess" name="Assess damage"/><bpmn:exclusiveGateway id="Gateway_Confidence" name="Confidence at least 0.85?"/><bpmn:businessRuleTask id="Task_Eligibility" name="Evaluate STP eligibility"/><bpmn:exclusiveGateway id="Gateway_Eligible" name="Eligible for STP?"/><bpmn:serviceTask id="Task_Approve" name="Auto-approve claim"/><bpmn:serviceTask id="Task_SubmitPayment" name="Submit SEPA payment"/><bpmn:intermediateCatchEvent id="Event_PaymentStatus" name="Payment status callback"><bpmn:messageEventDefinition/></bpmn:intermediateCatchEvent><bpmn:exclusiveGateway id="Gateway_PaymentStatus" name="Payment confirmed?"/><bpmn:sendTask id="Task_SettlementNotice" name="Send settlement notice"/><bpmn:endEvent id="End_Settled" name="Claim settled"/><bpmn:userTask id="Task_Manual" name="Route to manual adjuster"/><bpmn:endEvent id="End_Manual" name="Manual review"/><bpmn:userTask id="Task_SIU" name="Create SIU referral"/><bpmn:endEvent id="End_SIU" name="SIU referral"/><bpmn:userTask id="Task_PayOps" name="Route to Payments Operations"/><bpmn:endEvent id="End_PaymentException" name="Payment exception"/>
    <bpmn:sequenceFlow id="F1" sourceRef="Start_Submission" targetRef="Gateway_Start"/><bpmn:sequenceFlow id="F2" sourceRef="Gateway_Start" targetRef="Task_Acknowledge"/><bpmn:sequenceFlow id="F3" sourceRef="Gateway_Start" targetRef="Task_Validate"/><bpmn:sequenceFlow id="F4" sourceRef="Boundary_AckTimer" targetRef="Task_EscalateAck"/><bpmn:sequenceFlow id="F5" sourceRef="Task_EscalateAck" targetRef="Task_Validate"/><bpmn:sequenceFlow id="F6" sourceRef="Task_Validate" targetRef="Gateway_Covered"/><bpmn:sequenceFlow id="F7" sourceRef="Gateway_Covered" targetRef="Task_Fraud" name="Yes"/><bpmn:sequenceFlow id="F8" sourceRef="Gateway_Covered" targetRef="Task_Manual" name="No"/><bpmn:sequenceFlow id="F9" sourceRef="Task_Fraud" targetRef="Gateway_FraudResult"/><bpmn:sequenceFlow id="F10" sourceRef="Gateway_FraudResult" targetRef="Task_SIU" name="Score above 0.7"/><bpmn:sequenceFlow id="F11" sourceRef="Gateway_FraudResult" targetRef="Task_Manual" name="Unavailable"/><bpmn:sequenceFlow id="F12" sourceRef="Gateway_FraudResult" targetRef="Task_Assess" name="Score at or below 0.7"/><bpmn:sequenceFlow id="F13" sourceRef="Task_Assess" targetRef="Gateway_Confidence"/><bpmn:sequenceFlow id="F14" sourceRef="Gateway_Confidence" targetRef="Task_Eligibility" name="Yes"/><bpmn:sequenceFlow id="F15" sourceRef="Gateway_Confidence" targetRef="Task_Manual" name="No"/><bpmn:sequenceFlow id="F16" sourceRef="Task_Eligibility" targetRef="Gateway_Eligible"/><bpmn:sequenceFlow id="F17" sourceRef="Gateway_Eligible" targetRef="Task_Approve" name="Yes"/><bpmn:sequenceFlow id="F18" sourceRef="Gateway_Eligible" targetRef="Task_Manual" name="No"/><bpmn:sequenceFlow id="F19" sourceRef="Task_Approve" targetRef="Task_SubmitPayment"/><bpmn:sequenceFlow id="F20" sourceRef="Task_SubmitPayment" targetRef="Event_PaymentStatus"/><bpmn:sequenceFlow id="F21" sourceRef="Event_PaymentStatus" targetRef="Gateway_PaymentStatus"/><bpmn:sequenceFlow id="F22" sourceRef="Gateway_PaymentStatus" targetRef="Task_SettlementNotice" name="Confirmed"/><bpmn:sequenceFlow id="F23" sourceRef="Gateway_PaymentStatus" targetRef="Task_PayOps" name="Failed or returned"/><bpmn:sequenceFlow id="F24" sourceRef="Task_SettlementNotice" targetRef="End_Settled"/><bpmn:sequenceFlow id="F25" sourceRef="Task_Manual" targetRef="End_Manual"/><bpmn:sequenceFlow id="F26" sourceRef="Task_SIU" targetRef="End_SIU"/><bpmn:sequenceFlow id="F27" sourceRef="Task_PayOps" targetRef="End_PaymentException"/>
  </bpmn:process>
</bpmn:definitions>
