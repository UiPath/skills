<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_TriStar_Future_PA" targetNamespace="https://uipath.com/business-analysis/tristar-future-pa">
<bpmn:collaboration id="Collaboration_Future"><bpmn:participant id="Participant_PA" name="TriStar Automated Standard Prior Authorization" processRef="Process_Future_PA" /></bpmn:collaboration>
<bpmn:process id="Process_Future_PA" name="Automated Standard Prior Authorization {{RUN_TOKEN}}" isExecutable="false">
<bpmn:startEvent id="Start_278" name="278 request received"/><bpmn:serviceTask id="Task_Ingest" name="Ingest and normalize request"/><bpmn:businessRuleTask id="Task_Classify" name="Classify urgency and request"/><bpmn:exclusiveGateway id="Gateway_Expedited" name="Expedited request?" default="Flow_Exp_No"/><bpmn:endEvent id="End_Exp" name="Hand off expedited request"/><bpmn:serviceTask id="Task_Validate" name="Validate eligibility, benefit, provider"/><bpmn:exclusiveGateway id="Gateway_Complete" name="Valid and complete?" default="Flow_Complete_No"/><bpmn:serviceTask id="Task_RFI" name="Create RFI and pending item"/><bpmn:intermediateCatchEvent id="Event_ProviderInfo" name="Provider information received"><bpmn:messageEventDefinition/></bpmn:intermediateCatchEvent><bpmn:businessRuleTask id="Task_Criteria" name="Apply criteria and routing rules"/><bpmn:exclusiveGateway id="Gateway_BH" name="Behavioral health?" default="Flow_BH_No"/><bpmn:userTask id="Task_BH" name="Qualified BH clinical review"/><bpmn:userTask id="Task_Clinical" name="Clinical review task"/><bpmn:exclusiveGateway id="Gateway_STP" name="Straight-through approval?" default="Flow_STP_No"/><bpmn:serviceTask id="Task_AutoApprove" name="Create approval record"/><bpmn:userTask id="Task_Physician" name="Physician review and rationale"/><bpmn:exclusiveGateway id="Gateway_Adverse" name="Adverse decision proposed?" default="Flow_Adverse_No"/><bpmn:userTask id="Task_P2P" name="Offer and record peer-to-peer"/><bpmn:exclusiveGateway id="Gateway_Merge" name="Decision ready"/><bpmn:serviceTask id="Task_Notice" name="Assemble and validate notice"/><bpmn:sendTask id="Task_Transmit" name="Transmit response and notices"/><bpmn:endEvent id="End_Complete" name="Determination communicated"/>
<bpmn:sequenceFlow id="F1" sourceRef="Start_278" targetRef="Task_Ingest"/><bpmn:sequenceFlow id="F2" sourceRef="Task_Ingest" targetRef="Task_Classify"/><bpmn:sequenceFlow id="F3" sourceRef="Task_Classify" targetRef="Gateway_Expedited"/><bpmn:sequenceFlow id="Flow_Exp_Yes" name="Yes" sourceRef="Gateway_Expedited" targetRef="End_Exp"/><bpmn:sequenceFlow id="Flow_Exp_No" name="No" sourceRef="Gateway_Expedited" targetRef="Task_Validate"/><bpmn:sequenceFlow id="F4" sourceRef="Task_Validate" targetRef="Gateway_Complete"/><bpmn:sequenceFlow id="Flow_Complete_Yes" name="Yes" sourceRef="Gateway_Complete" targetRef="Task_Criteria"/><bpmn:sequenceFlow id="Flow_Complete_No" name="No" sourceRef="Gateway_Complete" targetRef="Task_RFI"/><bpmn:sequenceFlow id="F5" sourceRef="Task_RFI" targetRef="Event_ProviderInfo"/><bpmn:sequenceFlow id="F6" sourceRef="Event_ProviderInfo" targetRef="Task_Validate"/><bpmn:sequenceFlow id="F7" sourceRef="Task_Criteria" targetRef="Gateway_BH"/><bpmn:sequenceFlow id="Flow_BH_Yes" name="Yes" sourceRef="Gateway_BH" targetRef="Task_BH"/><bpmn:sequenceFlow id="Flow_BH_No" name="No" sourceRef="Gateway_BH" targetRef="Task_Clinical"/><bpmn:sequenceFlow id="F8" sourceRef="Task_BH" targetRef="Gateway_STP"/><bpmn:sequenceFlow id="F9" sourceRef="Task_Clinical" targetRef="Gateway_STP"/><bpmn:sequenceFlow id="Flow_STP_Yes" name="Yes" sourceRef="Gateway_STP" targetRef="Task_AutoApprove"/><bpmn:sequenceFlow id="Flow_STP_No" name="No" sourceRef="Gateway_STP" targetRef="Task_Physician"/><bpmn:sequenceFlow id="F10" sourceRef="Task_AutoApprove" targetRef="Gateway_Merge"/><bpmn:sequenceFlow id="F11" sourceRef="Task_Physician" targetRef="Gateway_Adverse"/><bpmn:sequenceFlow id="Flow_Adverse_Yes" name="Yes" sourceRef="Gateway_Adverse" targetRef="Task_P2P"/><bpmn:sequenceFlow id="Flow_Adverse_No" name="No" sourceRef="Gateway_Adverse" targetRef="Gateway_Merge"/><bpmn:sequenceFlow id="F12" sourceRef="Task_P2P" targetRef="Gateway_Merge"/><bpmn:sequenceFlow id="F13" sourceRef="Gateway_Merge" targetRef="Task_Notice"/><bpmn:sequenceFlow id="F14" sourceRef="Task_Notice" targetRef="Task_Transmit"/><bpmn:sequenceFlow id="F15" sourceRef="Task_Transmit" targetRef="End_Complete"/>
</bpmn:process></bpmn:definitions>