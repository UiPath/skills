<?xml version="1.0" encoding="UTF-8" ?>
<definitions xmlns="https://www.omg.org/spec/DMN/20230324/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20230324/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:uipath="http://uipath.com/schema/1.0/dmn/authoring" id="definitions_pricing" name="PricingRules" namespace="http://uipath.com/dmn/ns_pricing_7f21">
  <extensionElements>
    <uipath:authoring surface="decision-graph" />
  </extensionElements>
  <decision id="decision_tier" name="tier" label="Tier percentage">
    <extensionElements>
      <uipath:authoring editor="decision-table" />
    </extensionElements>
    <variable id="variable_tier" name="tier" typeRef="number" />
    <informationRequirement id="informationRequirement_tier_customerTier">
      <requiredInput href="#inputData_customerTier" />
    </informationRequirement>
    <decisionTable id="decisionTable_tier" hitPolicy="FIRST">
      <input id="input_tier_customerTier" label="Customer tier">
        <inputExpression id="inputExpression_tier_customerTier" typeRef="string">
          <text>customerTier</text>
        </inputExpression>
      </input>
      <output id="output_tierPct" label="Tier percentage" name="tierPct" typeRef="number" />
      <annotation name="Annotation" />
      <rule id="rule_tier_1">
        <inputEntry id="inputEntry_tier_1">
          <text>&quot;Gold&quot;</text>
        </inputEntry>
        <outputEntry id="outputEntry_tier_1">
          <text>15</text>
        </outputEntry>
        <annotationEntry>
          <text>Gold</text>
        </annotationEntry>
      </rule>
      <rule id="rule_tier_2">
        <inputEntry id="inputEntry_tier_2">
          <text>&quot;Silver&quot;</text>
        </inputEntry>
        <outputEntry id="outputEntry_tier_2">
          <text>10</text>
        </outputEntry>
        <annotationEntry>
          <text>Silver</text>
        </annotationEntry>
      </rule>
      <rule id="rule_tier_3">
        <inputEntry id="inputEntry_tier_3">
          <text>-</text>
        </inputEntry>
        <outputEntry id="outputEntry_tier_3">
          <text>0</text>
        </outputEntry>
        <annotationEntry>
          <text>Standard and anything else</text>
        </annotationEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="decision_netUnitPrice" name="netUnitPrice" label="Net unit price">
    <extensionElements>
      <uipath:authoring editor="literal-expression" />
    </extensionElements>
    <variable id="variable_netUnitPrice" name="netUnitPrice" typeRef="number" />
    <informationRequirement id="informationRequirement_netUnitPrice_listPrice">
      <requiredInput href="#inputData_listPrice" />
    </informationRequirement>
    <informationRequirement id="informationRequirement_netUnitPrice_tier">
      <requiredDecision href="#decision_tier" />
    </informationRequirement>
    <knowledgeRequirement id="knowledgeRequirement_netUnitPrice">
      <requiredKnowledge href="#bkm_discounted" />
    </knowledgeRequirement>
    <literalExpression id="literalExpression_netUnitPrice" typeRef="number">
      <text>discounted(listPrice, tier)</text>
    </literalExpression>
  </decision>
  <businessKnowledgeModel id="bkm_discounted" name="discounted" label="Discounted amount">
    <description>An amount less a whole-number percentage of itself.</description>
    <variable id="variable_bkm_discounted" name="discounted" />
    <encapsulatedLogic id="encapsulatedLogic_discounted" kind="FEEL">
      <formalParameter id="formalParameter_discounted_amount" name="amount" typeRef="number" />
      <formalParameter id="formalParameter_discounted_pct" name="pct" typeRef="number" />
      <literalExpression id="literalExpression_discounted" typeRef="number">
        <text>amount * (1 - pct / 100)</text>
      </literalExpression>
    </encapsulatedLogic>
  </businessKnowledgeModel>
  <inputData id="inputData_listPrice" name="listPrice">
    <variable id="variable_listPrice" name="listPrice" typeRef="number" />
  </inputData>
  <inputData id="inputData_customerTier" name="customerTier">
    <variable id="variable_customerTier" name="customerTier" typeRef="string" />
  </inputData>
  <textAnnotation id="textAnnotation_wholeNumbers">
    <text>Percentages here are whole numbers, not fractions: Gold is 15, meaning 15%.</text>
  </textAnnotation>
  <association id="association_wholeNumbers">
    <sourceRef href="#bkm_discounted" />
    <targetRef href="#textAnnotation_wholeNumbers" />
  </association>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="DMNDiagram_pricing">
      <dmndi:DMNShape id="DMNShape_netUnitPrice" dmnElementRef="decision_netUnitPrice">
        <dc:Bounds x="336" y="48" width="288" height="96" />
      </dmndi:DMNShape>
      <dmndi:DMNShape id="DMNShape_tier" dmnElementRef="decision_tier">
        <dc:Bounds x="336" y="312" width="288" height="96" />
      </dmndi:DMNShape>
      <dmndi:DMNShape id="DMNShape_discounted" dmnElementRef="bkm_discounted">
        <dc:Bounds x="48" y="48" width="224" height="96" />
      </dmndi:DMNShape>
      <dmndi:DMNShape id="DMNShape_listPrice" dmnElementRef="inputData_listPrice">
        <dc:Bounds x="720" y="48" width="240" height="96" />
      </dmndi:DMNShape>
      <dmndi:DMNShape id="DMNShape_customerTier" dmnElementRef="inputData_customerTier">
        <dc:Bounds x="336" y="576" width="240" height="96" />
      </dmndi:DMNShape>
      <dmndi:DMNShape id="DMNShape_wholeNumbers" dmnElementRef="textAnnotation_wholeNumbers">
        <dc:Bounds x="48" y="192" width="224" height="64" />
      </dmndi:DMNShape>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
