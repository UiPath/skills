<?xml version="1.0" encoding="UTF-8" ?>
<definitions xmlns="https://www.omg.org/spec/DMN/20230324/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20230324/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:uipath="http://uipath.com/schema/1.0/dmn/authoring" id="definitions_SupplierRules" name="SupplierRules" namespace="http://uipath.com/dmn/ns_SupplierRules" xmlns:kie="https://kie.org/dmn/extensions/1.0">
  <extensionElements>
    <uipath:authoring surface="decision-table" />
  </extensionElements>
  <decision id="decision_approval" name="approval" label="approval">
    <extensionElements>
      <uipath:authoring editor="decision-table" />
    </extensionElements>
    <variable id="variable_approval" name="approval" typeRef="boolean" />
    <informationRequirement id="ir_approval_inputData_onboarded">
      <requiredInput href="#inputData_onboarded" />
    </informationRequirement>
    <informationRequirement id="ir_approval_inputData_spend">
      <requiredInput href="#inputData_spend" />
    </informationRequirement>
    <decisionTable id="dt_approval" hitPolicy="UNIQUE">
      <input id="in_approval_0" label="onboarded">
        <inputExpression id="ie_approval_0" typeRef="boolean">
          <text>onboarded</text>
        </inputExpression>
      </input>
      <input id="in_approval_1" label="spend">
        <inputExpression id="ie_approval_1" typeRef="number">
          <text>spend</text>
        </inputExpression>
      </input>
      <output id="out_approval_approved" label="approved" name="approved" typeRef="boolean" />
      <annotation name="Annotation" />
      <rule id="rule_approval_0">
        <inputEntry id="ie_approval_0_0">
          <text>false</text>
        </inputEntry>
        <inputEntry id="ie_approval_0_1">
          <text>-</text>
        </inputEntry>
        <outputEntry id="oe_approval_0_0">
          <text>false</text>
        </outputEntry>
        <annotationEntry>
          <text>Not onboarded</text>
        </annotationEntry>
      </rule>
      <rule id="rule_approval_1">
        <inputEntry id="ie_approval_1_0">
          <text>true</text>
        </inputEntry>
        <inputEntry id="ie_approval_1_1">
          <text>&lt;= 25000</text>
        </inputEntry>
        <outputEntry id="oe_approval_1_0">
          <text>true</text>
        </outputEntry>
        <annotationEntry>
          <text>Within limit</text>
        </annotationEntry>
      </rule>
      <rule id="rule_approval_2">
        <inputEntry id="ie_approval_2_0">
          <text>true</text>
        </inputEntry>
        <inputEntry id="ie_approval_2_1">
          <text>&gt; 25000</text>
        </inputEntry>
        <outputEntry id="oe_approval_2_0">
          <text>false</text>
        </outputEntry>
        <annotationEntry>
          <text>Over limit</text>
        </annotationEntry>
      </rule>
    </decisionTable>
  </decision>
  <inputData id="inputData_onboarded" name="onboarded" label="onboarded">
    <variable id="variable_in_onboarded" name="onboarded" typeRef="boolean" />
  </inputData>
  <inputData id="inputData_spend" name="spend" label="spend">
    <variable id="variable_in_spend" name="spend" typeRef="number" />
  </inputData>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="DMNDiagram_1983862b-816a-46a8-ad0f-8b7dbb617697">
      <dmndi:DMNShape id="DMNShape_6fdadf76-dec7-4d23-a6cf-62a1f6b0cd1d" dmnElementRef="decision_approval">
        <dc:Bounds x="112" y="0" width="288" height="96" />
      </dmndi:DMNShape>
      <dmndi:DMNShape id="DMNShape_d863b680-43d9-4745-9026-f21fb94007fd" dmnElementRef="inputData_onboarded">
        <dc:Bounds x="0" y="208" width="240" height="96" />
      </dmndi:DMNShape>
      <dmndi:DMNShape id="DMNShape_42f4ee2f-0972-4e41-9a00-c309f2943cd5" dmnElementRef="inputData_spend">
        <dc:Bounds x="272" y="208" width="240" height="96" />
      </dmndi:DMNShape>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
