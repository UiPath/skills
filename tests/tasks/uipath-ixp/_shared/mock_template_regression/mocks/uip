#!/bin/sh
# Two-version `uip` mock for uipath-ixp smoke tasks that must decide what to do
# after an improvement iteration. Overlays the base mock_template (list it
# SECOND in template_sources so this file wins).
#
# Fixture — project receipts_qa-7c2e11a4-ixp, ValidatedDocuments 5.
# Version 40 is the PREVIOUS iteration, version 41 is its RESULT.
#
#   field                     kind        Ann   v40   -> v41    drop   thr    call
#   bbbb000000000001 header   EDITED        5   1.000 -> 0.889  0.111  0.200  keep
#   bbbb000000000002 line     EDITED       40   0.800 -> 0.600  0.200  0.100  ROLL BACK
#   bbbb000000000003 line     untouched    40   0.900 -> 0.650  0.250  0.100  COLLATERAL
#   bbbb000000000004 header   untouched     5   1.000 -> 0.889  0.111  0.200  ignore
#
# thr = max(0.1, 2 x 1/(2 x Annotations)) from the guide's Regression noise floor.
#
# Three separations are graded, and each needs a different value:
#
#  * 0001 vs 0002 — both EDITED and both dropped, but 0001's 0.111 is under its
#    own threshold (Annotations 5) while 0002's 0.200 clears its own
#    (Annotations 40). An agent using one flat 0.1 rolls back BOTH.
#  * 0003 — regressed hard and was never edited. Only a diff over EVERY field
#    finds it; checking just the edited fields cannot.
#  * 0004 — untouched AND sub-threshold. The collateral check has to respect
#    noise floors too, or it reports this as damage.
#
# ProjectScore is the unweighted mean of per-field F1: 0.925 -> 0.757. That is a
# large drop caused mostly by fields whose own thresholds say "keep", so an
# agent gating on ProjectScore over-rolls-back. It is served truthfully and
# nothing grades it.
#
# The mock is history-agnostic: WHICH instructions the iteration edited is
# declared by each task's prompt, so the same two versions grade opposite
# branches of the guide's 2f. With per-field edits (metrics_regression_
# noise_floor) 0002 is rolled back and 0003 is reported as collateral; with a
# group edit on Receipt > Line Items (metrics_group_rollback) the group's
# instructions are rolled back and nothing is collateral.
#
# Rows derive from explicit confusion matrices, so Precision/Recall/ErrorRate
# are consistent with F1 rather than hand-picked:
#   Ann 5  1.000 = TP5 FP0 FN0      Ann 5  0.889 = TP4 FP0 FN1
#   Ann 40 0.800 = TP32 FP8 FN8     Ann 40 0.600 = TP24 FP16 FN16
#   Ann 40 0.900 = TP36 FP4 FN4     Ann 40 0.650 = TP26 FP14 FN14
# ErrorRate is max(FP,FN)/Annotations — a wrong value counts once.
#
# Logging matches the base mock exactly — same `uip ` prefix, same newline
# folding — so anchored `^uip\s+ixp …` criteria keep matching.
{
    printf 'uip %s' "$*" | tr '\r\n' '  '
    printf '\n'
} >> "$(dirname "$0")/calls.log" 2>/dev/null || true

METRICS_V40='{"Result":"Success","Code":"IxpProjectsGetMetrics","Data":{"ModelVersion":40,"ValidatedDocuments":5,"ProjectScore":0.925,"ProjectScoreQuality":"excellent","FieldGroups":[{"FieldGroup":"Receipt","F1":1,"Precision":1,"Recall":1,"ErrorRate":0,"Documents":5},{"FieldGroup":"Receipt > Line Items","F1":0.85,"Precision":0.85,"Recall":0.85,"ErrorRate":0.15,"Documents":5}],"Fields":[{"FieldGroup":"Receipt","FieldId":"bbbb000000000001","F1":1,"Precision":1,"Recall":1,"ErrorRate":0,"Documents":5,"Annotations":5,"Quality":"good"},{"FieldGroup":"Receipt > Line Items","FieldId":"bbbb000000000002","F1":0.8,"Precision":0.8,"Recall":0.8,"ErrorRate":0.2,"Documents":5,"Annotations":40,"Quality":"good"},{"FieldGroup":"Receipt > Line Items","FieldId":"bbbb000000000003","F1":0.9,"Precision":0.9,"Recall":0.9,"ErrorRate":0.1,"Documents":5,"Annotations":40,"Quality":"good"},{"FieldGroup":"Receipt","FieldId":"bbbb000000000004","F1":1,"Precision":1,"Recall":1,"ErrorRate":0,"Documents":5,"Annotations":5,"Quality":"good"}]}}'

METRICS_V41='{"Result":"Success","Code":"IxpProjectsGetMetrics","Data":{"ModelVersion":41,"ValidatedDocuments":5,"ProjectScore":0.757,"ProjectScoreQuality":"good","FieldGroups":[{"FieldGroup":"Receipt","F1":0.889,"Precision":1,"Recall":0.8,"ErrorRate":0.2,"Documents":5},{"FieldGroup":"Receipt > Line Items","F1":0.625,"Precision":0.625,"Recall":0.625,"ErrorRate":0.375,"Documents":5}],"Fields":[{"FieldGroup":"Receipt","FieldId":"bbbb000000000001","F1":0.889,"Precision":1,"Recall":0.8,"ErrorRate":0.2,"Documents":5,"Annotations":5,"Quality":"good"},{"FieldGroup":"Receipt > Line Items","FieldId":"bbbb000000000002","F1":0.6,"Precision":0.6,"Recall":0.6,"ErrorRate":0.4,"Documents":5,"Annotations":40,"Quality":"average"},{"FieldGroup":"Receipt > Line Items","FieldId":"bbbb000000000003","F1":0.65,"Precision":0.65,"Recall":0.65,"ErrorRate":0.35,"Documents":5,"Annotations":40,"Quality":"average"},{"FieldGroup":"Receipt","FieldId":"bbbb000000000004","F1":0.889,"Precision":1,"Recall":0.8,"ErrorRate":0.2,"Documents":5,"Annotations":5,"Quality":"good"}]}}'

case "$1 $2 $3" in
"ixp projects list")
cat <<'EOF'
{"Result":"Success","Code":"IxpProjectsList","Data":{"Projects":[{"Id":"7c2e11a4-3f5b-4a81-9c02-1d4e8b6a2f77","Name":"receipts_qa-7c2e11a4-ixp","Title":"Receipts_QA","CreatedAt":"2026-07-02T09:14:00Z"}],"Total":1,"Offset":0,"Limit":50}}
EOF
exit 0
;;
"ixp projects get")
cat <<'EOF'
{"Result":"Success","Code":"IxpProjectsGet","Data":{"Name":"receipts_qa-7c2e11a4-ixp","Title":"Receipts_QA","Description":"Retail receipts","CreatedTime":"2026-07-02T09:14:00Z"}}
EOF
exit 0
;;
"ixp projects list-models")
cat <<'EOF'
{"Result":"Success","Code":"IxpProjectsListModels","Data":{"Models":[{"Version":41,"ModelName":"gemini_ixp","Pinned":false,"TrainedTime":"2026-08-24T11:05:02.114000+00:00","Description":""},{"Version":40,"ModelName":"gemini_ixp","Pinned":false,"TrainedTime":"2026-08-24T09:41:17.882000+00:00","Description":""}],"Tags":[],"MaxPublished":100}}
EOF
exit 0
;;
"ixp projects get-taxonomy")
cat <<'EOF'
{"Result":"Success","Code":"IxpProjectsGetTaxonomy","Data":{"status":"ok","dataset":{"entity_defs":[{"name":"Exact Text"},{"name":"Monetary Quantity"}],"label_groups":[{"name":"Receipt","repeatable":false,"field":[{"field_id":"bbbb000000000001","name":"Merchant Name"},{"field_id":"bbbb000000000004","name":"Receipt Date"}]},{"name":"Receipt > Line Items","repeatable":true,"field":[{"field_id":"bbbb000000000002","name":"Line Item Unit Price"},{"field_id":"bbbb000000000003","name":"Line Item Description"}]}]}}}
EOF
exit 0
;;
"ixp projects get-metrics")
    version=""
    while [ $# -gt 0 ]; do
        case "$1" in
        -m|--model-version)
            version="$2"
            shift
            ;;
        --model-version=*)
            version="${1#--model-version=}"
            ;;
        esac
        shift
    done
    case "$version" in
    40)
        printf '%s\n' "$METRICS_V40"
        ;;
    ""|latest|41)
        # No selector, or an explicit latest — the iteration's result.
        printf '%s\n' "$METRICS_V41"
        ;;
    *)
        printf '%s\n' '{"Result":"Failure","ErrorCode":"not_found","Message":"Model version not found."}'
        exit 1
        ;;
    esac
    exit 0
;;
esac

# Everything else fails like the base mock: offline, no network call.
echo "uip (mock): not connected to a tenant in this sandbox; offline smoke mock." >&2
exit 1
