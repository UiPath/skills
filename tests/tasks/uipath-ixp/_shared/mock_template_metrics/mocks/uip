#!/bin/sh
# Metrics-serving `uip` mock for uipath-ixp smoke tasks that must DIAGNOSE from
# the full get-metrics payload. Overlays the base mock_template (list it SECOND
# in template_sources so this file wins).
#
# The base mock fails every invocation, which makes this scenario unwinnable:
# the correct path reads metrics and carries the numbers into a written
# diagnosis. A failing read leaves nothing to diagnose.
#
# Fixture — project my_invoices-f1afa9ef-ixp, ModelVersion 12. Every row is
# derived from an explicit confusion matrix so the numbers are internally
# consistent, and built so that F1 ALONE cannot produce the right answer:
#
#              TP  FP  FN | F1     P     R     Err   Docs Ann | verdict
#   Invoice No 30  30  10 | 0.600 0.500 0.750 0.750   40  40 | PRECISION (over-extracts)
#   Vendor Add 12   4  12 | 0.600 0.750 0.500 0.500   24  24 | RECALL    (misses it)
#   Bill-To    40   0   0 | 1.000 1.000 1.000 0.000   40  40 | no work needed
#   Freight     4   0   1 | 0.889 1.000 0.800 0.200    5   5 | above target, tiny sample
#
# The first two carry the SAME F1 and need OPPOSITE rewrites. An agent reading
# only F1 cannot tell them apart and must guess; one reading the
# Precision/Recall split gets both right. That is the discriminator.
#
# Two further traps, both faithful to real API behaviour:
#   * ErrorRate is `errors / Annotations`, NOT `1 - Precision`, and a wrong
#     value counts ONCE rather than as a false positive plus a false miss.
#     It differs from 1 - Precision on three of the four rows. Freight Charge is
#     the sharp case: Precision 1.000 (the model emitted nothing wrong) yet
#     ErrorRate 0.200 (it missed one of five) — a miss is invisible to precision
#     but is still an error the user has to fix.
#   * Bill-To Name has F1 1.00 yet Quality "good", while the project scores 0.75
#     with ProjectScoreQuality "good" too. Field Quality and ProjectScoreQuality
#     do not share a scale, so an agent gating on the LABEL rather than the
#     number flags a field that is already perfect.
#
# get-taxonomy is served so field ids can be resolved to names; the graded
# artifact is keyed by field id, which needs no join.
#
# Logging matches the base mock exactly — same `uip ` prefix, same newline
# normalization — so anchored `^uip\s+ixp …` criteria keep matching.
{
    printf 'uip %s' "$*" | tr '\r\n' '  '
    printf '\n'
} >> "$(dirname "$0")/calls.log" 2>/dev/null || true

case "$1 $2 $3" in
"ixp projects list")
cat <<'EOF'
{"Result":"Success","Code":"IxpProjectsList","Data":{"Projects":[{"Id":"f1afa9ef-1c4d-4b70-9e02-6d3b8a5c7e11","Name":"my_invoices-f1afa9ef-ixp","Title":"My_Invoices","CreatedAt":"2026-06-11T08:42:19Z"}],"Total":1,"Offset":0,"Limit":50}}
EOF
exit 0
;;
"ixp projects get")
cat <<'EOF'
{"Result":"Success","Code":"IxpProjectsGet","Data":{"Name":"my_invoices-f1afa9ef-ixp","Title":"My_Invoices","Description":"Supplier invoices","CreatedTime":"2026-06-11T08:42:19Z"}}
EOF
exit 0
;;
"ixp projects list-models")
cat <<'EOF'
{"Result":"Success","Code":"IxpProjectsListModels","Data":{"Models":[{"Version":12,"ModelName":"gemini_ixp","Pinned":true,"TrainedTime":"2026-07-24T09:12:13.533725+00:00","Description":""}],"Tags":[{"Name":"live","Version":12,"UpdatedAt":"2026-07-24T09:14:08.456568+00:00"}],"MaxPublished":100}}
EOF
exit 0
;;
"ixp projects get-metrics")
cat <<'EOF'
{"Result":"Success","Code":"IxpProjectsGetMetrics","Data":{"ModelVersion":12,"ValidatedDocuments":40,"ProjectScore":0.772,"ProjectScoreQuality":"good","FieldGroups":[{"FieldGroup":"Invoice Header","F1":0.751,"Precision":0.717,"Recall":0.789,"ErrorRate":0.394,"Documents":40}],"Fields":[{"FieldGroup":"Invoice Header","FieldId":"aaaa000000000001","F1":0.6,"Precision":0.5,"Recall":0.75,"ErrorRate":0.75,"Documents":40,"Annotations":40,"Quality":"average"},{"FieldGroup":"Invoice Header","FieldId":"aaaa000000000002","F1":0.6,"Precision":0.75,"Recall":0.5,"ErrorRate":0.5,"Documents":24,"Annotations":24,"Quality":"average"},{"FieldGroup":"Invoice Header","FieldId":"aaaa000000000003","F1":1,"Precision":1,"Recall":1,"ErrorRate":0,"Documents":40,"Annotations":40,"Quality":"good"},{"FieldGroup":"Invoice Header","FieldId":"aaaa000000000004","F1":0.889,"Precision":1,"Recall":0.8,"ErrorRate":0.2,"Documents":5,"Annotations":5,"Quality":"good"}]}}
EOF
exit 0
;;
"ixp projects get-taxonomy")
cat <<'EOF'
{"Result":"Success","Code":"IxpProjectsGetTaxonomy","Data":{"status":"ok","dataset":{"entity_defs":[{"id":"b3a63e6483adaaba","name":"Exact Text","title":"","inherits_from":[],"trainable":true,"color":2,"instructions":""},{"id":"e5d7402ba91c6f38","name":"Monetary Quantity","title":"","inherits_from":["0000000000000005"],"trainable":true,"color":4,"instructions":""}],"label_groups":[{"name":"Invoice","label_defs":[{"name":"Invoice Header","instructions":"Header fields printed at the top of the invoice.","moon_form":[{"field_id":"aaaa000000000001","id":"b3a63e6483adaaba","field_type_id":"b3a63e6483adaaba","kind":"Exact Text","name":"Invoice Number","instructions":"The invoice identifier.","rule_set":null},{"field_id":"aaaa000000000002","id":"b3a63e6483adaaba","field_type_id":"b3a63e6483adaaba","kind":"Exact Text","name":"Vendor Address","instructions":"The vendor's postal address.","rule_set":null},{"field_id":"aaaa000000000003","id":"b3a63e6483adaaba","field_type_id":"b3a63e6483adaaba","kind":"Exact Text","name":"Bill-To Name","instructions":"The party being billed.","rule_set":null},{"field_id":"aaaa000000000004","id":"e5d7402ba91c6f38","field_type_id":"e5d7402ba91c6f38","kind":"Monetary Quantity","name":"Freight Charge","instructions":"The freight or shipping charge.","rule_set":null}]}]}]}}}
EOF
exit 0
;;
esac

# Everything else fails like the base mock: offline, no network call.
echo "uip (mock): not connected to a tenant in this sandbox; offline smoke mock." >&2
exit 1
