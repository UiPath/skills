#!/bin/sh
# Metrics-serving `uip` mock for the uipath-ixp metrics smokes. Overlays the
# base mock_template (list it SECOND in template_sources so this file wins).
#
# ONE overlay, THREE fixture projects - the mock dispatches on the project
# name found in the arguments, so every metrics smoke shares this folder
# instead of growing a near-identical overlay per scenario:
#
#   my_invoices-f1afa9ef-ixp   diagnosis payload  (metrics_full_signal_diagnosis)
#   receipts_qa-7c2e11a4-ixp   two versions 40/41 (metrics_regression_noise_floor,
#                                                  metrics_group_rollback)
#   receipts_lite-4a9f30d2-ixp Documents variance (metrics_annotations_shortfall)
#
# Fixture tables, confusion matrices, and what each one discriminates are in
# README.md. Every row derives from an explicit confusion matrix; ErrorRate is
# an integer error count over Annotations; ProjectScore is the unweighted mean
# of per-field F1.
#
# Logging matches the base mock exactly - same `uip ` prefix, same newline
# folding - so anchored `^uip\s+ixp ...` criteria keep matching. Anything not
# handled for a known project, and any unknown project, fails offline like the
# base mock.
{
    printf 'uip %s' "$*" | tr '\r\n' '  '
    printf '\n'
} >> "$(dirname "$0")/calls.log" 2>/dev/null || true

# Dispatch on the project name present in the arguments.
PROJ=""
for a in "$@"; do
    case "$a" in
    *-ixp) PROJ="$a"; break ;;
    esac
done

case "$PROJ" in
"my_invoices-f1afa9ef-ixp")
