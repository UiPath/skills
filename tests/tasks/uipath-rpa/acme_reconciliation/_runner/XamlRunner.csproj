<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The activity packages target net6.0 and pin older transitive versions; none of these is actionable here. -->
    <NoWarn>NU1603;NU1608;NU1701;NU1902;NU1903;NU1904</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- CoreWF, UiPath's port of Windows Workflow Foundation, and the real UiPath.System.Activities
         package the Robot loads. Both come from UiPath's public feed; nothing here needs a token. -->
    <PackageReference Include="UiPath.Workflow" Version="6.0.0-20240401-07" />
    <PackageReference Include="UiPath.System.Activities" Version="26.8.2" />
    <PackageReference Include="UiPath.Activities.Api" Version="24.10.1" />
    <PackageReference Include="UiPath.Activities.Contracts" Version="23.4.1" />
  </ItemGroup>
</Project>
