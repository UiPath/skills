      <bpmn:sequenceFlow id="edge_eventSubprocessStagesEnteredInclusiveGateway-startStageSlaMessageEvent_Stage_xFlNjK" sourceRef="eventSubprocessStagesEnteredInclusiveGateway" targetRef="startStageSlaMessageEvent_Stage_xFlNjK">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=js:(vars.caseManagerDecisions.stagesEntered.some((stage) =&gt; stage.stageName == 'Stage 8 - delay case completion'))</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="edge_eventSubprocessStagesEnteredInclusiveGateway-eventSubprocessNoValidStagesToEnterEndEvent" sourceRef="eventSubprocessStagesEnteredInclusiveGateway" targetRef="eventSubprocessNoValidStagesToEnterEndEvent">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=js:(!vars.caseManagerDecisions.stagesEntered.some((stage) =&gt; stage.stageName == 'Stage 1' || stage.stageName == 'Stage 2' || stage.stageName == 'Stage 3' || stage.stageName == 'Stage 4 - return to origin' || stage.stageName == 'Stage 5 - connector entry' || stage.stageName == 'Stage 6 - to be interrupted' || stage.stageName == 'Stage 7 - user select' || stage.stageName == 'Stage 8 - delay case completion'))</bpmn:conditionExpression>
