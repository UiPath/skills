<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_QuoteFollowUp" targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="UiPath (https://bpmn.uipath.com)" exporterVersion="1.0">
  <bpmn:process id="Process_QuoteFollowUp" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:migrationVersion version="11.5" />
    </bpmn:extensionElements>
    <bpmn:startEvent id="Start_1" name="Quote sent"><bpmn:outgoing>F_Start</bpmn:outgoing></bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="Timer_Wait" name="Wait for customer">
      <bpmn:incoming>F_Start</bpmn:incoming><bpmn:outgoing>F_Wait</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_1"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">2 hours</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:scriptTask id="Task_Remind" name="Send reminder" scriptFormat="JavaScript">
      <bpmn:extensionElements><uipath:scriptVersion value="v3" /></bpmn:extensionElements>
      <bpmn:incoming>F_Wait</bpmn:incoming><bpmn:outgoing>F_End</bpmn:outgoing>
      <bpmn:script><![CDATA[return { reminded: true };]]></bpmn:script>
    </bpmn:scriptTask>
    <bpmn:endEvent id="End_1" name="Reminder sent"><bpmn:incoming>F_End</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="F_Start" sourceRef="Start_1" targetRef="Timer_Wait" />
    <bpmn:sequenceFlow id="F_Wait" sourceRef="Timer_Wait" targetRef="Task_Remind" />
    <bpmn:sequenceFlow id="F_End" sourceRef="Task_Remind" targetRef="End_1" />
  </bpmn:process>
</bpmn:definitions>
