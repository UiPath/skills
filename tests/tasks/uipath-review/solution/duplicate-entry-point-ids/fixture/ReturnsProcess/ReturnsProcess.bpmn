<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_ReturnsProcess" targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="UiPath (https://bpmn.uipath.com)" exporterVersion="1.0">
  <bpmn:process id="Process_ReturnsProcess" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:migrationVersion version="11.5" />
    </bpmn:extensionElements>
    <bpmn:startEvent id="Start_Web" name="Web return"><bpmn:outgoing>F_Web</bpmn:outgoing></bpmn:startEvent>
    <bpmn:startEvent id="Start_Store" name="In-store return"><bpmn:outgoing>F_Store</bpmn:outgoing></bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gw_Join" name="Any channel"><bpmn:incoming>F_Web</bpmn:incoming><bpmn:incoming>F_Store</bpmn:incoming><bpmn:outgoing>F_Join</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_Refund" name="Compute refund" scriptFormat="JavaScript">
      <bpmn:extensionElements><uipath:scriptVersion value="v3" /></bpmn:extensionElements>
      <bpmn:incoming>F_Join</bpmn:incoming><bpmn:outgoing>F_End</bpmn:outgoing>
      <bpmn:script><![CDATA[return { refund: 0 };]]></bpmn:script>
    </bpmn:scriptTask>
    <bpmn:endEvent id="End_1" name="Done"><bpmn:incoming>F_End</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="F_Web" sourceRef="Start_Web" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F_Store" sourceRef="Start_Store" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F_Join" sourceRef="Gw_Join" targetRef="Task_Refund" />
    <bpmn:sequenceFlow id="F_End" sourceRef="Task_Refund" targetRef="End_1" />
  </bpmn:process>
</bpmn:definitions>
