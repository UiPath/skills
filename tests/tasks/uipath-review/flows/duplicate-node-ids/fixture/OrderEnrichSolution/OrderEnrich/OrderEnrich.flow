{
  "id": "b6c451f9-4651-4fa3-aeea-26fd4e087923",
  "version": "1.9",
  "name": "OrderEnrich",
  "nodes": [
    {
      "id": "start",
      "uniqueId": "34c6c87a-a4eb-4e31-947b-5370d54cb2eb",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "e736ce40-da55-4f7b-bb03-605fef3dcfda",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "normalizeOrder1",
      "uniqueId": "76add7b5-91f6-430b-b41f-7ebcfdd4d132",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Normalize order"
      },
      "inputs": {
        "script": "return { sku: String($vars.start.output.sku).trim().toUpperCase() };"
      }
    },
    {
      "id": "normalizeOrder1",
      "uniqueId": "c05d42e9-a4bc-4fbc-a337-a6d7d518870d",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Compute total"
      },
      "inputs": {
        "script": "return { total: $vars.start.output.qty * $vars.start.output.unitPrice };"
      }
    },
    {
      "id": "done1",
      "uniqueId": "05a40603-465f-4508-bb9a-d4e404f2cbc3",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Done"
      },
      "inputs": {}
    }
  ],
  "edges": [
    {
      "id": "start-output-normalizeOrder1-input",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "normalizeOrder1",
      "targetPort": "input"
    },
    {
      "id": "normalizeOrder1-success-computeTotal1-input",
      "sourceNodeId": "normalizeOrder1",
      "sourcePort": "success",
      "targetNodeId": "normalizeOrder1",
      "targetPort": "input"
    },
