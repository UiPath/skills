  "name": "TicketTriage",
  "nodes": [
    {
      "id": "start",
      "uniqueId": "9ef549df-6f69-493a-bc01-18500f925d42",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "527742ad-4e88-42d4-8638-efba485b73e3",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "classifyTicket1",
      "uniqueId": "9ec39e4d-fcfd-4c64-9124-26d5eeeb4404",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Classify ticket"
      },
      "inputs": {
        "script": "return { priority: $vars.start.output.severity > 3 ? \"high\" : \"normal\" };"
      }
    },
    {
      "id": "routeToTeam1",
      "uniqueId": "2bc04676-4391-4811-b1bc-dec65a8a1a23",
      "type": "core.logic.mock",
      "typeVersion": "1.0",
      "display": {
        "label": "Route to team"
      },
      "inputs": {}
    },
    {
      "id": "done1",
      "uniqueId": "2b621e32-14b9-4526-857f-b163a1523bba",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Done"
      },
      "inputs": {}
    }
  ],
  "edges": [
