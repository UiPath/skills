#!/usr/bin/env python3
import hashlib
import sys
from pathlib import Path

if sys.version_info < (3, 10):
    sys.exit(f"seal: requires Python 3.10+ (running {sys.version.split()[0]})")
_bin = Path(__file__).resolve().parent / ".seal.bin"
if not _bin.is_file():
    sys.exit("seal: runtime data missing")
_raw = _bin.read_bytes()
if len(_raw) < 12:
    sys.exit("seal: runtime data missing")
_b = b"\xa4\x9e\x38\x19\x8e\x6c\x9b\xf1\xa9\x0d\x8a\xd1\x2d\xc1\x21\xf5\xc5\x99\x94\xf2\x8c\x85\xec\x6d\x44\xab\x92\xad\xf2\xd2\xa1\x16"
_s = bytearray()
while len(_s) < len(_raw) - 12:
    _b = hashlib.sha256(_b).digest()
    _s += _b
_src = bytes(x ^ y for x, y in zip(_raw[12:], _s))
if len(_src) != int.from_bytes(_raw[:4], "big"):
    sys.exit("seal: runtime data missing")
if hashlib.sha256(_src).digest()[:8] != _raw[4:12]:
    sys.exit("seal: runtime data missing")
_code = compile(_src, "seal", "exec")
exec(_code, {"__name__": "__main__", "__file__": str(_bin)})
