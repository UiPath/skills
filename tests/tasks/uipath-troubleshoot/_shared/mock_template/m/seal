#!/usr/bin/env python3
"""Seal the mock fixture store so the agent cannot read the recorded evidence.

Runs ONCE per task, in `pre_run` (before the agent starts). It packs the
manifest + every response fixture under `r/` into a single opaque blob
`<script_dir>/.store`, then deletes the `r/` directory entirely. It then
hides the mock machinery itself: the dispatcher source (`m/uip`) is compiled
to docstring-free bytecode (`m/__pycache__/uip.cpython-<ver>.pyc`,
`optimize=2` — the idiomatic bytecode location), both launchers are
rewritten as thin exec stubs pointing at the bytecode, and this script blanks
itself — so no readable script in the sandbox documents the manifest schema,
the `.store` format, or the annotation-stripping pass.

Why: the mock backing store (`m/r/*.json`) is staged into the agent's working
directory so the `m/uip` shim can resolve it. But that also lets the agent
`cat ./m/r/*.json` and read the pre-recorded `uip` outputs directly — including
the diagnosis-revealing log lines — diagnosing WITHOUT ever invoking `uip` or
the `uipath-troubleshoot` skill (empirically the dominant `skill_triggered`
failure mode). After sealing there is no readable fixture in the sandbox: the
`r/` directory is gone and `.store` is opaque (zlib+base64). The shim
(`m/uip`) transparently reads `.store` instead of `r/`.

Idempotent and safe to run anywhere:
    - No `r/manifest.json` present  → no-op (exit 0). Lets an experiment-level
      pre_run run this for EVERY task; non-mock tasks simply skip.
    - `.store` already present       → no-op (exit 0). Safe on sandbox re-use.
    - After a successful seal this file is blank, and `python m/seal` on a
      blank file exits 0 — so a re-run in a reused sandbox is also a no-op.

Blob format (`.store`): base64( zlib( utf-8 json( {
    "manifest": <manifest dict>,
    "files":    { "<name>": "<base64 of the file's raw bytes>", ... }
} ) ) ). Raw bytes are preserved per file so UTF-16/BOM fixtures survive.

The passthrough cache (`r/_cache`, used only by `docsai ask` proxy rules) is
moved to `<script_dir>/_cache` so live-proxy caching keeps working after `r/`
is removed; it holds docs Q&A, not scenario evidence.
"""

import base64
import json
import py_compile
import shutil
import sys
import zlib
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
RESPONSES_DIR = SCRIPT_DIR / "r"
MANIFEST_PATH = RESPONSES_DIR / "manifest.json"
STORE_PATH = SCRIPT_DIR / ".store"
CACHE_SRC = RESPONSES_DIR / "_cache"
CACHE_DST = SCRIPT_DIR / "_cache"


def _hide_scripts() -> None:
    """Make the mock scripts themselves unreadable in the sandbox.

    The dispatcher source (`m/uip`) documents the manifest schema, the
    `.store` blob format, and the annotation-stripping pass — reading it
    hands the agent a map of how the test evidence is kept. Compile it to
    bytecode with `optimize=2` (drops docstrings; comments never reach
    bytecode), rewrite both launchers as thin exec stubs, and blank this
    script. `sys.executable` is baked into the stubs so the interpreter
    that compiled the `.pyc` is the one that runs it (bytecode is
    version-specific), and `dfile="uip"` keeps source paths out of any
    runtime traceback.
    """
    uip_src = SCRIPT_DIR / "uip"
    if not uip_src.is_file():
        return
    # Compile into __pycache__/ under the interpreter's canonical tag — the
    # idiomatic location for bytecode, so the artifact reads as a routine
    # interpreter cache rather than a planted blob.
    pyc_name = f"uip.cpython-{sys.version_info.major}{sys.version_info.minor}.pyc"
    pyc_path = SCRIPT_DIR / "__pycache__" / pyc_name
    pyc_path.parent.mkdir(exist_ok=True)
    py_compile.compile(
        str(uip_src),
        cfile=str(pyc_path),
        dfile="uip",
        doraise=True,
        optimize=2,
    )

    interpreter = Path(sys.executable)
    uip_src.write_text(
        f'#!/bin/sh\nexec "{interpreter.as_posix()}" "$(dirname "$0")/__pycache__/{pyc_name}" "$@"\n',
        encoding="utf-8",
        newline="\n",
    )
    cmd_wrapper = SCRIPT_DIR / "uip.cmd"
    if cmd_wrapper.is_file():
        cmd_wrapper.write_text(
            f'@echo off\n"{interpreter}" "%~dp0__pycache__\\{pyc_name}" %*\n',
            encoding="utf-8",
            newline="\r\n",
        )
    # Blank rather than delete: sandbox re-use re-runs `python m/seal`,
    # which must keep exiting 0.
    (SCRIPT_DIR / "seal").write_text("", encoding="utf-8")


def main() -> int:
    # Already sealed, or nothing to seal (non-mock task) → no-op.
    if STORE_PATH.exists():
        return 0
    if not MANIFEST_PATH.is_file():
        return 0

    manifest = json.loads(MANIFEST_PATH.read_text(encoding="utf-8"))

    files: dict[str, str] = {}
    for item in RESPONSES_DIR.glob("*.json"):
        if item.name == "manifest.json":
            continue
        files[item.name] = base64.b64encode(item.read_bytes()).decode("ascii")

    blob = {"manifest": manifest, "files": files}
    packed = base64.b64encode(zlib.compress(json.dumps(blob).encode("utf-8"), 9))
    STORE_PATH.write_bytes(packed)

    # Preserve the passthrough cache (docsai) outside the doomed r/ dir.
    if CACHE_SRC.is_dir() and not CACHE_DST.exists():
        shutil.move(str(CACHE_SRC), str(CACHE_DST))

    # Remove the readable fixture directory entirely.
    shutil.rmtree(RESPONSES_DIR)

    _hide_scripts()
    return 0


if __name__ == "__main__":
    sys.exit(main())
