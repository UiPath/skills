#!/usr/bin/env python3
import importlib.machinery
import importlib.util
import sys
from pathlib import Path

_bin = Path(__file__).resolve().parent / ".uip.bin"
if not _bin.is_file():
    sys.exit("uip: runtime data missing")
try:
    _loader = importlib.machinery.SourcelessFileLoader("__main__", str(_bin))
    _spec = importlib.util.spec_from_loader("__main__", _loader)
    _mod = importlib.util.module_from_spec(_spec)
    _loader.exec_module(_mod)
except (ImportError, EOFError, ValueError):
    sys.exit(f"uip: requires Python 3.13 (running {sys.version.split()[0]})")
