{
  "displayName": "FlowCodeEvalEntity",
  "description": "Shared coder-eval fixture entity used by the Maestro Flow and Maestro BPMN suites — Data Fabric connector CRUD/query/file surface",
  "fields": [
    {"name": "title",        "type": "STRING",         "lengthLimit": 200},
    {"name": "description",  "type": "MULTILINE_TEXT", "lengthLimit": 2000},
    {"name": "score",        "type": "DECIMAL"},
    {"name": "viewCount",    "type": "INTEGER"},
    {"name": "active",       "type": "BOOLEAN"},
    {"name": "releaseDate",  "type": "DATE"},
    {"name": "lastUpdated",  "type": "DATETIME"},
    {"name": "externalId",   "type": "UUID"},
    {"name": "file1",        "type": "FILE"}
  ]
}
