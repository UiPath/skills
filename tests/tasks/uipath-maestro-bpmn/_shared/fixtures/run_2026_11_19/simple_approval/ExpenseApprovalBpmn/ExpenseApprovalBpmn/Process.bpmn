<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:uipath="http://uipath.org/schema/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="UiPath (https://bpmn.uipath.com)" exporterVersion="1.0">
  <bpmn:process id="Process_1" name="Expense Approval" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:variables version="v1">
        <uipath:input id="expenseId" name="expenseId" type="string" elementId="start" />
        <uipath:input id="amount" name="amount" type="number" elementId="start" />
        <uipath:inputOutput id="expenseIdIn" name="expenseIdIn" type="string" elementId="start" />
        <uipath:inputOutput id="amountIn" name="amountIn" type="number" elementId="start" />
        <uipath:inputOutput id="decisionValue" name="decisionValue" type="string" elementId="Process_1" />
        <uipath:inputOutput id="triageExpense_processResponse" name="triageExpense_processResponse" type="json" elementId="triageExpense" />
        <uipath:inputOutput id="createQueueItem_response" name="createQueueItem_response" type="json" elementId="createQueueItem" />
        <uipath:output id="decision" name="decision" type="string" elementId="complete" />
      </uipath:variables>
      <uipath:bindings version="v1">
        <uipath:binding id="triageExpense_name" name="Agent" type="string" default="SyntheticExpenseTriageAgent" resource="process" resourceSubType="Agent" resourceKey="SyntheticExpenseTriageAgent" propertyAttribute="name" />
        <uipath:binding id="triageExpense_folderPath" name="folderPath" type="string" default="SyntheticPlaceholderFolder" resource="process" resourceSubType="Agent" resourceKey="SyntheticPlaceholderFolder" propertyAttribute="folderPath" />
      </uipath:bindings>
      <uipath:migrationVersion version="11" />
    </bpmn:extensionElements>
    <bpmn:startEvent id="start" name="Manual expense approval request">
      <bpmn:extensionElements>
        <uipath:entryPointId value="e2e00000-0000-4000-8000-000000000001" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.Variables" version="v1" />
          <uipath:output name="expenseId" type="string" source="=vars.expenseId" var="expenseIdIn" />
          <uipath:output name="amount" type="number" source="=vars.amount" var="amountIn" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_start_triageExpense</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="triageExpense" name="Triage expense">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.StartAgentJob" version="v2" />
          <uipath:context>
            <uipath:input name="name" type="string" value="=bindings.triageExpense_name" />
            <uipath:input name="folderPath" type="string" value="=bindings.triageExpense_folderPath" />
          </uipath:context>
          <uipath:input name="JobArguments" type="json" target="bodyField">{"expenseId":"=js:vars.expenseIdIn","amount":"=js:vars.amountIn"}</uipath:input>
          <uipath:output name="Process response" type="Orchestrator.RunJob" var="triageExpense_processResponse" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_start_triageExpense</bpmn:incoming>
      <bpmn:outgoing>Flow_triageExpense_amountGate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="amountGate" default="Flow_amountGate_autoApprove">
      <bpmn:incoming>Flow_triageExpense_amountGate</bpmn:incoming>
      <bpmn:outgoing>Flow_amountGate_createQueueItem</bpmn:outgoing>
      <bpmn:outgoing>Flow_amountGate_autoApprove</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="createQueueItem" name="Create high amount review queue item">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.CreateQueueItem" version="v1" />
          <uipath:context>
            <uipath:input name="queueName" type="string" value="SyntheticExpenseReviewQueue" />
            <uipath:input name="folderPath" type="string" value="SyntheticPlaceholderFolder" />
          </uipath:context>
          <uipath:input name="ItemData" type="json" target="body">{"expenseId":"=js:vars.expenseIdIn","amount":"=js:vars.amountIn"}</uipath:input>
          <uipath:output name="response" type="Orchestrator.CreateQueueItem" var="createQueueItem_response" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_amountGate_createQueueItem</bpmn:incoming>
      <bpmn:outgoing>Flow_createQueueItem_markQueued</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:task id="markQueued" name="Set queued decision">
      <bpmn:extensionElements>
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.Variables" version="v1" />
          <uipath:output name="decisionValue" type="string" source="=js:&#34;Queued&#34;" var="decisionValue" custom="true" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_createQueueItem_markQueued</bpmn:incoming>
      <bpmn:outgoing>Flow_markQueued_amountGate_join</bpmn:outgoing>
    </bpmn:task>
    <bpmn:scriptTask id="autoApprove" name="Auto-approve standard expense" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.Variables" version="v1" />
          <uipath:context>
            <uipath:inputSchema type="jsonSchema">{"type":"object","properties":{"vars":{"type":"object"},"metadata":{"type":"object"}}}</uipath:inputSchema>
          </uipath:context>
          <uipath:input name="args" type="json" target="bodyField">{"vars":"=vars","metadata":"=metadata"}</uipath:input>
          <uipath:output name="decisionValue" type="string" source="=result.response" var="decisionValue" />
        </uipath:mapping>
        <uipath:scriptVersion value="v3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_amountGate_autoApprove</bpmn:incoming>
      <bpmn:outgoing>Flow_autoApprove_amountGate_join</bpmn:outgoing>
      <bpmn:script>return "Approved";</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="amountGate_join">
      <bpmn:incoming>Flow_markQueued_amountGate_join</bpmn:incoming>
      <bpmn:incoming>Flow_autoApprove_amountGate_join</bpmn:incoming>
      <bpmn:outgoing>Flow_amountGate_join_complete</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="complete" name="Expense approval completed">
      <bpmn:extensionElements>
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.Variables" version="v1" />
          <uipath:output name="decision" type="string" source="=js:vars.decisionValue" var="decision" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_amountGate_join_complete</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_start_triageExpense" sourceRef="start" targetRef="triageExpense" />
    <bpmn:sequenceFlow id="Flow_triageExpense_amountGate" sourceRef="triageExpense" targetRef="amountGate" />
    <bpmn:sequenceFlow id="Flow_amountGate_createQueueItem" name="High amount" sourceRef="amountGate" targetRef="createQueueItem">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=js:vars.amountIn &gt;= 1000</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_createQueueItem_markQueued" sourceRef="createQueueItem" targetRef="markQueued" />
    <bpmn:sequenceFlow id="Flow_amountGate_autoApprove" name="Standard amount" sourceRef="amountGate" targetRef="autoApprove" />
    <bpmn:sequenceFlow id="Flow_markQueued_amountGate_join" sourceRef="markQueued" targetRef="amountGate_join" />
    <bpmn:sequenceFlow id="Flow_autoApprove_amountGate_join" sourceRef="autoApprove" targetRef="amountGate_join" />
    <bpmn:sequenceFlow id="Flow_amountGate_join_complete" sourceRef="amountGate_join" targetRef="complete" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="S_amountGate" bpmnElement="amountGate">
        <dc:Bounds x="488" y="215.33333333333331" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_amountGate_join" bpmnElement="amountGate_join">
        <dc:Bounds x="1051" y="215.33333333333331" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_autoApprove" bpmnElement="autoApprove">
        <dc:Bounds x="901" y="322" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_complete" bpmnElement="complete">
        <dc:Bounds x="1151" y="222.33333333333331" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_createQueueItem" bpmnElement="createQueueItem">
        <dc:Bounds x="751" y="192" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_markQueued" bpmnElement="markQueued">
        <dc:Bounds x="901" y="192" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_start" bpmnElement="start">
        <dc:Bounds x="252" y="222.33333333333331" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_triageExpense" bpmnElement="triageExpense">
        <dc:Bounds x="338" y="200.33333333333334" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="E_Flow_amountGate_autoApprove" bpmnElement="Flow_amountGate_autoApprove">
        <di:waypoint x="538" y="240.33333333333331" />
        <di:waypoint x="562" y="240.33333333333331" />
        <di:waypoint x="562" y="362" />
        <di:waypoint x="901" y="362" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_amountGate_createQueueItem" bpmnElement="Flow_amountGate_createQueueItem">
        <di:waypoint x="538" y="240.33333333333331" />
        <di:waypoint x="644.5" y="240.33333333333331" />
        <di:waypoint x="644.5" y="232" />
        <di:waypoint x="751" y="232" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_amountGate_join_complete" bpmnElement="Flow_amountGate_join_complete">
        <di:waypoint x="1101" y="240.33333333333331" />
        <di:waypoint x="1151" y="240.33333333333331" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_autoApprove_amountGate_join" bpmnElement="Flow_autoApprove_amountGate_join">
        <di:waypoint x="1001" y="362" />
        <di:waypoint x="1025" y="362" />
        <di:waypoint x="1025" y="240.33333333333331" />
        <di:waypoint x="1051" y="240.33333333333331" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_createQueueItem_markQueued" bpmnElement="Flow_createQueueItem_markQueued">
        <di:waypoint x="851" y="232" />
        <di:waypoint x="901" y="232" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_markQueued_amountGate_join" bpmnElement="Flow_markQueued_amountGate_join">
        <di:waypoint x="1001" y="232" />
        <di:waypoint x="1026" y="232" />
        <di:waypoint x="1026" y="240.33333333333331" />
        <di:waypoint x="1051" y="240.33333333333331" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_start_triageExpense" bpmnElement="Flow_start_triageExpense">
        <di:waypoint x="288" y="240.33333333333331" />
        <di:waypoint x="338" y="240.33333333333334" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_triageExpense_amountGate" bpmnElement="Flow_triageExpense_amountGate">
        <di:waypoint x="438" y="240.33333333333334" />
        <di:waypoint x="488" y="240.33333333333331" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
