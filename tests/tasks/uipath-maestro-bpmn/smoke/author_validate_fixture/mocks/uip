#!/usr/bin/env python3
"""Snapshot the first BPMN validation input, then delegate to the real CLI."""

from __future__ import annotations

import os
import shutil
import subprocess
import sys
from pathlib import Path

SNAPSHOT = Path(__file__).resolve().parent.parent / ".first-validation-input.bpmn"


def find_real_uip() -> str:
    wrapper_dir = Path(__file__).resolve().parent
    search_dirs: list[str] = []
    for entry in os.environ.get("PATH", "").split(os.pathsep):
        if not entry:
            continue
        try:
            if Path(entry).resolve() == wrapper_dir:
                continue
        except OSError:
            pass
        search_dirs.append(entry)
    executable = shutil.which("uip", path=os.pathsep.join(search_dirs))
    if executable is None:
        raise SystemExit("real uip executable not found")
    return executable


def validation_input(args: list[str]) -> Path | None:
    if args[:3] != ["maestro", "bpmn", "validate"]:
        return None
    for token in args[3:]:
        if token.lower().endswith((".bpmn", ".xml")):
            return Path(token)
    return None


def main() -> int:
    args = sys.argv[1:]
    source = validation_input(args)
    if source is not None and not SNAPSHOT.exists():
        if source.is_file():
            shutil.copyfile(source, SNAPSHOT)
        else:
            SNAPSHOT.write_text(
                "validation invoked before the BPMN file existed\n", encoding="utf-8"
            )
    return subprocess.run([find_real_uip(), *args], check=False).returncode


if __name__ == "__main__":
    raise SystemExit(main())
