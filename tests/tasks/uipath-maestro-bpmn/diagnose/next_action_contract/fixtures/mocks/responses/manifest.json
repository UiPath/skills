{
  "version": 2,
  "_doc": "Mocked public-safe BPMN operate/diagnose responses for minimal lifecycle coverage.",
  "_matching": "Rules stop at the identifier so any folder/output flag in any order still matches; the dispatcher matches whole tokens, so a mistyped id falls through to unmocked_default.",
  "rules": [
    {
      "match": "maestro bpmn job status job-triage-001",
      "file": "job-status.json",
      "exit_code": 0
    },
    {
      "match": "maestro bpmn instance incidents inst-triage-001",
      "file": "instance-incidents.json",
      "exit_code": 0
    },
    {
      "match": "maestro bpmn incident get inc-triage-001",
      "file": "incident-get.json",
      "exit_code": 0
    },
    {
      "match": "maestro bpmn instance variables inst-triage-001",
      "file": "instance-variables.json",
      "exit_code": 0
    },
    {
      "match": "maestro bpmn instance asset inst-triage-001",
      "file": "instance-asset.json",
      "exit_code": 0
    },
    {
      "match": "maestro bpmn instance element-executions inst-triage-001",
      "file": "element-executions.json",
      "exit_code": 0
    },
    {
      "match": "maestro bpmn instance cursors inst-triage-001",
      "file": "cursors.json",
      "exit_code": 0
    }
  ],
  "unmocked_default": {
    "response": "{\"error\":\"unmocked public-safe BPMN command\"}\n",
    "exit_code": 1
  }
}
