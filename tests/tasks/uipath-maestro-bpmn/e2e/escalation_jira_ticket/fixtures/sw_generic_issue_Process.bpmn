<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:uipath="http://uipath.org/schema/bpmn" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="UiPath (https://bpmn.uipath.com)" exporterVersion="1.0" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI">
  <bpmn:process id="EscalationJiraTicket" name="EscalationJiraTicket" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:variables version="v1">
        <uipath:input id="senderEmail" name="senderEmail" type="string" elementId="manualStart" />
        <uipath:input id="senderDomain" name="senderDomain" type="string" elementId="manualStart" />
        <uipath:input id="subject" name="subject" type="string" elementId="manualStart" />
        <uipath:input id="body" name="body" type="string" elementId="manualStart" />
        <uipath:input id="customerTier" name="customerTier" type="string" elementId="manualStart" />
        <uipath:input id="productionDown" name="productionDown" type="boolean" elementId="manualStart" />
        <uipath:input id="workaroundAvailable" name="workaroundAvailable" type="boolean" elementId="manualStart" />
        <uipath:input id="hasAttachments" name="hasAttachments" type="boolean" elementId="manualStart" />
        <uipath:input id="customerMatchStatus" name="customerMatchStatus" type="string" elementId="manualStart" />
        <uipath:input id="isDuplicate" name="isDuplicate" type="boolean" elementId="manualStart" />
        <uipath:input id="correlationId" name="correlationId" type="string" elementId="manualStart" />
        <uipath:inputOutput id="severityValue" name="severityValue" type="string" elementId="EscalationJiraTicket" />
        <uipath:inputOutput id="engineeringNeeded" name="engineeringNeeded" type="boolean" elementId="classifySeverity" />
        <uipath:inputOutput id="createJiraIssue_response" name="createJiraIssue_response" type="json" elementId="createJiraIssue" />
        <uipath:inputOutput id="createJiraIssue_Error" name="createJiraIssue_Error" type="json" elementId="createJiraIssue" />
        <uipath:output id="severity" name="severity" type="string" elementId="done" />
        <uipath:output id="caseKey" name="caseKey" type="string" elementId="done" />
        <uipath:output id="jiraIssueKey" name="jiraIssueKey" type="string" elementId="done" />
      </uipath:variables>
      <uipath:bindings version="v1">
        <uipath:binding id="jira" name="Atlassian Jira connection" type="string" default="00000000-0000-0000-0000-00000000a001" resource="Connection" resourceKey="00000000-0000-0000-0000-00000000a001" propertyAttribute="ConnectionId" />
        <uipath:binding id="shared" name="Shared/uipath-maestro-flow folder" type="string" default="5da18ec0-7de1-4e57-aaf1-ddc8a369c199" resource="Connection" resourceKey="00000000-0000-0000-0000-00000000a001" propertyAttribute="folderKey" />
      </uipath:bindings>
    </bpmn:extensionElements>
    <bpmn:startEvent id="manualStart" name="MANUAL">
      <bpmn:extensionElements>
        <uipath:entryPointId value="e2e00000-0000-4000-8000-000000000001" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_manualStart_classifySeverity</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:scriptTask id="classifySeverity" name="Classify escalation severity at runtime" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.Variables" version="v1" />
          <uipath:context>
            <uipath:inputSchema type="jsonSchema">{"type":"object","properties":{"vars":{"type":"object"},"metadata":{"type":"object"}}}</uipath:inputSchema>
          </uipath:context>
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"vars":"=vars","metadata":"=metadata"}]]></uipath:input>
          <uipath:output name="severityValue" type="string" source="=result.response.severity" var="severityValue" />
          <uipath:output name="engineeringNeeded" type="boolean" source="=result.response.engineeringNeeded" var="engineeringNeeded" />
        </uipath:mapping>
        <uipath:scriptVersion value="v3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_manualStart_classifySeverity</bpmn:incoming>
      <bpmn:outgoing>Flow_classifySeverity_createJiraIssue</bpmn:outgoing>
      <bpmn:script>
      const sev1 = vars.customerTier == "Enterprise" &amp;&amp; vars.productionDown == true &amp;&amp; vars.workaroundAvailable != true;
      const sev2 = vars.productionDown == true &amp;&amp; vars.workaroundAvailable == true;
      return {
        severity: sev1 ? "Sev1" : (sev2 ? "Sev2" : "Sev3"),
        engineeringNeeded: vars.productionDown == true
      };
    </bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sendTask id="createJiraIssue" name="Create Issues">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Intsvc.ActivityExecution" version="v1" />
          <uipath:context>
            <uipath:input name="connectorKey" type="string" value="uipath-atlassian-jira" />
            <uipath:input name="connection" type="string" value="=bindings.jira" />
            <uipath:input name="resourceKey" type="string" value="00000000-0000-0000-0000-00000000a001" />
            <uipath:input name="folderKey" type="string" value="=bindings.shared" />
            <uipath:input name="objectName" type="string" value="issue" />
            <uipath:input name="method" type="string" value="POST" />
            <uipath:input name="path" type="string" value="/issue" />
            <uipath:input name="metadata" type="json"><![CDATA[{"activityPropertyConfiguration":{"configuration":"=jsonString:{\"essentialConfiguration\":{\"customFieldsRequestDetails\":null,\"executionType\":null,\"operation\":\"create\",\"packageVersion\":\"1.0.0\",\"connectorVersion\":null,\"unifiedTypesCompatible\":true,\"savedFilterTrees\":null,\"objectName\":\"issue\",\"httpMethod\":\"POST\",\"instanceParameters\":{\"connectorKey\":\"uipath-atlassian-jira\",\"objectName\":\"issue\",\"activityType\":\"Generic\",\"version\":\"1.0.0\",\"operation\":\"create\",\"supportsStreaming\":false},\"path\":\"/issue\"}}","uiPathActivityTypeId":"e466c94e-14d3-3bd9-9534-9518f78200d2","errorState":{"issues":[]}},"activityMetadata":{"activity":{"displayName":"Create Issues","description":"Create Issue","category":"Jira","configuration":"{\"connectorKey\":\"uipath-atlassian-jira\",\"objectName\":\"issue\",\"activityType\":\"Generic\",\"version\":\"1.0.0\",\"operation\":\"create\",\"supportsStreaming\":false}","uiPathActivityTypeId":"e466c94e-14d3-3bd9-9534-9518f78200d2","isEnabled":true}},"inputMetadata":{},"telemetryData":{"connectorKey":"uipath-atlassian-jira","connectorName":"Jira","objectName":"issue","objectDisplayName":"Issues"}}]]></uipath:input>
            <uipath:input name="activityConfigurationVersion" type="string" value="v2" />
          </uipath:context>
          <uipath:input name="pathParameters" type="json" target="pathParameters"><![CDATA[{}]]></uipath:input>
          <uipath:input name="queryParameters" type="json" target="queryParameters"><![CDATA[{}]]></uipath:input>
          <uipath:input name="body" type="json" target="body"><![CDATA[{"fields":{"description":"=vars.body","issuetype":{"id":"11457","name":"Task"},"project":{"key":"CE"},"reporter":{"id":"000000:00000000-0000-0000-0000-000000000000"},"summary":"=js:\"[\" + vars.severityValue + \"] \" + vars.correlationId + \" \" + vars.subject"}}]]></uipath:input>
          <uipath:output name="response" type="jsonSchema" source="=response" var="createJiraIssue_response">{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"fields.aggregateprogress.progress":{"title":"Aggregate progress","type":"number"},"fields.aggregateprogress.total":{"title":"Aggregate progress total","type":"number"},"fields.assignee.accountId":{"title":"Assignee account ID","type":"string"},"fields.assignee.accountType":{"title":"Assignee account type","type":"string"},"fields.assignee.active":{"title":"Assignee active","type":"boolean"},"fields.assignee.avatarUrls.16x16":{"title":"Assignee avatar urls 16 x 16","type":"string"},"fields.assignee.avatarUrls.24x24":{"title":"Assignee avatar urls 24 x 24","type":"string"},"fields.assignee.avatarUrls.32x32":{"title":"Assignee avatar urls 32 x 32","type":"string"},"fields.assignee.avatarUrls.48x48":{"title":"Assignee avatar urls 48 x 48","type":"string"},"fields.assignee.displayName":{"title":"Assignee display name","type":"string"},"fields.assignee.emailAddress":{"title":"Assignee email address","type":"string"},"fields.assignee.id":{"title":"Assignee ID","type":"string"},"fields.assignee.self":{"title":"Assignee self","type":"string"},"fields.assignee.timeZone":{"title":"Assignee time zone","type":"string"},"fields.components[*].id":{"title":"Components ID","type":"string"},"fields.components[*].name":{"title":"Components","type":"string"},"fields.created":{"title":"Created","type":"string"},"fields.creator.accountId":{"title":"Creator account ID","type":"string"},"fields.creator.accountType":{"title":"Creator account type","type":"string"},"fields.creator.active":{"title":"Creator active","type":"boolean"},"fields.creator.avatarUrls.16x16":{"title":"Creator avatar urls 16 x 16","type":"string"},"fields.creator.avatarUrls.24x24":{"title":"Creator avatar urls 24 x 24","type":"string"},"fields.creator.avatarUrls.32x32":{"title":"Creator avatar urls 32 x 32","type":"string"},"fields.creator.avatarUrls.48x48":{"title":"Creator avatar urls 48 x 48","type":"string"},"fields.creator.displayName":{"title":"Creator display name","type":"string"},"fields.creator.emailAddress":{"title":"Creator email address","type":"string"},"fields.creator.self":{"title":"Creator self","type":"string"},"fields.creator.timeZone":{"title":"Creator time zone","type":"string"},"fields.description":{"title":"Description","type":"string"},"fields.duedate":{"title":"Due date","type":"string"},"fields.environment":{"title":"Environment","type":"string"},"fields.fixVersions[*].id":{"title":"Fix versions ID","type":"string"},"fields.fixVersions[*].name":{"title":"Fix versions","type":"string"},"fields.issuetype.avatarId":{"title":"Issue type avatar ID","type":"number"},"fields.issuetype.description":{"title":"Issue type description","type":"string"},"fields.issuetype.entityId":{"title":"Issue type entity ID","type":"string"},"fields.issuetype.hierarchyLevel":{"title":"Issue type hierarchy level","type":"number"},"fields.issuetype.iconUrl":{"title":"Issue type icon url","type":"string"},"fields.issuetype.id":{"title":"Issue type","type":"string"},"fields.issuetype.name":{"title":"Issue type name","type":"string"},"fields.issuetype.self":{"title":"Issue type self","type":"string"},"fields.issuetype.subtask":{"title":"Issue type subtask","type":"boolean"},"fields.labels[*]":{"title":"Labels","type":"string"},"fields.parent.key":{"title":"Parent issue key ","type":"string"},"fields.priority.iconUrl":{"title":"Priority icon url","type":"string"},"fields.priority.id":{"title":"Priority ID","type":"string"},"fields.priority.name":{"title":"Priority","type":"string"},"fields.priority.self":{"title":"Priority self","type":"string"},"fields.progress.progress":{"title":"Progress","type":"number"},"fields.progress.total":{"title":"Progress total","type":"number"},"fields.project.avatarUrls.16x16":{"title":"Project avatar urls 16 x 16","type":"string"},"fields.project.avatarUrls.24x24":{"title":"Project avatar urls 24 x 24","type":"string"},"fields.project.avatarUrls.32x32":{"title":"Project avatar urls 32 x 32","type":"string"},"fields.project.avatarUrls.48x48":{"title":"Project avatar urls 48 x 48","type":"string"},"fields.project.id":{"title":"Project ID","type":"string"},"fields.project.key":{"title":"Project","type":"string"},"fields.project.name":{"title":"Project name","type":"string"},"fields.project.projectTypeKey":{"title":"Project type key","type":"string"},"fields.project.self":{"title":"Project self","type":"string"},"fields.project.simplified":{"title":"Project simplified","type":"boolean"},"fields.reporter.accountId":{"title":"Reporter account ID","type":"string"},"fields.reporter.accountType":{"title":"Reporter account type","type":"string"},"fields.reporter.active":{"title":"Reporter active","type":"boolean"},"fields.reporter.avatarUrls.16x16":{"title":"Reporter avatar urls 16 x 16","type":"string"},"fields.reporter.avatarUrls.24x24":{"title":"Reporter avatar urls 24 x 24","type":"string"},"fields.reporter.avatarUrls.32x32":{"title":"Reporter avatar urls 32 x 32","type":"string"},"fields.reporter.avatarUrls.48x48":{"title":"Reporter avatar urls 48 x 48","type":"string"},"fields.reporter.displayName":{"title":"Reporter display name","type":"string"},"fields.reporter.emailAddress":{"title":"Reporter email address","type":"string"},"fields.reporter.id":{"title":"Reporter ID","type":"string"},"fields.reporter.self":{"title":"Reporter self","type":"string"},"fields.reporter.timeZone":{"title":"Reporter time zone","type":"string"},"fields.security.id":{"title":"Security ID","type":"string"},"fields.status.description":{"title":"Status description","type":"string"},"fields.status.iconUrl":{"title":"Status icon url","type":"string"},"fields.status.id":{"title":"Status ID","type":"string"},"fields.status.name":{"title":"Status","type":"string"},"fields.status.self":{"title":"Status self","type":"string"},"fields.status.statusCategory.colorName":{"title":"Status category color name","type":"string"},"fields.status.statusCategory.id":{"title":"Status category ID","type":"number"},"fields.status.statusCategory.key":{"title":"Status category key","type":"string"},"fields.status.statusCategory.name":{"title":"Status category name","type":"string"},"fields.status.statusCategory.self":{"title":"Status category self","type":"string"},"fields.statuscategorychangedate":{"title":"Status category changed ate","type":"string"},"fields.summary":{"title":"Summary","type":"string"},"fields.timetracking.originalEstimate":{"title":"Timetracking original estimate","type":"string"},"fields.timetracking.remainingEstimate":{"title":"Timetracking remaining estimate","type":"string"},"fields.updated":{"title":"Updated","type":"string"},"fields.versions[*].id":{"title":"Versions","type":"string"},"fields.votes.hasVoted":{"title":"Votes has voted","type":"boolean"},"fields.votes.self":{"title":"Votes self","type":"string"},"fields.votes.votes":{"title":"Votes","type":"number"},"fields.watches.isWatching":{"title":"Watches is watching","type":"boolean"},"fields.watches.self":{"title":"Watches self","type":"string"},"fields.watches.watchCount":{"title":"Watches watch count","type":"number"},"fields.workratio":{"title":"Workratio","type":"number"},"id":{"title":"Issue ID","type":"string"},"key":{"title":"Issue key","type":"string"},"self":{"title":"Self","type":"string"},"transition.errorCollection.errorMessages[*]":{"title":"Transition error collection error messages","type":"string"},"transition.errorCollection.status":{"title":"Transition error collection status","type":"number"},"transition.status":{"title":"Transition status","type":"number"}}}</uipath:output>
          <uipath:output name="Error" type="jsonSchema" source="=Error" var="createJiraIssue_Error">{"type":"object","properties":{"code":{"type":"string"},"message":{"type":"string"},"detail":{"type":"string"},"category":{"type":"string"},"status":{"type":"number"},"element":{"type":"string"}}}</uipath:output>
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_classifySeverity_createJiraIssue</bpmn:incoming>
      <bpmn:outgoing>Flow_createJiraIssue_done</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="done" name="Escalation triage completed">
      <bpmn:extensionElements>
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.Variables" version="v1" />
          <uipath:output name="severity" type="string" source="=vars.severityValue" var="severity" />
          <uipath:output name="caseKey" type="string" source="=vars.correlationId" var="caseKey" />
          <uipath:output name="jiraIssueKey" type="string" source="=vars.createJiraIssue_response.key" var="jiraIssueKey" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_createJiraIssue_done</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_manualStart_classifySeverity" sourceRef="manualStart" targetRef="classifySeverity" />
    <bpmn:sequenceFlow id="Flow_classifySeverity_createJiraIssue" sourceRef="classifySeverity" targetRef="createJiraIssue" />
    <bpmn:sequenceFlow id="Flow_createJiraIssue_done" sourceRef="createJiraIssue" targetRef="done" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="EscalationJiraTicket">
      <bpmndi:BPMNShape id="S_classifySeverity" bpmnElement="classifySeverity"><dc:Bounds x="338" y="192" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_createJiraIssue" bpmnElement="createJiraIssue"><dc:Bounds x="488" y="192" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_done" bpmnElement="done"><dc:Bounds x="638" y="214" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_manualStart" bpmnElement="manualStart"><dc:Bounds x="252" y="214" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="E_Flow_classifySeverity_createJiraIssue" bpmnElement="Flow_classifySeverity_createJiraIssue"><di:waypoint x="438" y="232" /><di:waypoint x="488" y="232" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_createJiraIssue_done" bpmnElement="Flow_createJiraIssue_done"><di:waypoint x="588" y="232" /><di:waypoint x="638" y="232" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_manualStart_classifySeverity" bpmnElement="Flow_manualStart_classifySeverity"><di:waypoint x="288" y="232" /><di:waypoint x="338" y="232" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
