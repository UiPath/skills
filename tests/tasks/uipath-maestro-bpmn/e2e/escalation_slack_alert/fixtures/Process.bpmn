essage root blocks type","type":"string"},"message.root.bot_id":{"title":"Message root bot ID","type":"string"},"message.root.icons.emoji":{"title":"Message root icons emoji","type":"string"},"message.root.is_locked":{"title":"Message root is locked","type":"boolean"},"message.root.latest_reply":{"title":"Message root latest reply","type":"string"},"message.root.metadata.event_type":{"title":"Message root metadata event type","type":"string"},"message.root.reply_count":{"title":"Message root reply count","type":"number"},"message.root.reply_users[*]":{"title":"Message root reply users","type":"string"},"message.root.reply_users_count":{"title":"Message root reply users count","type":"number"},"message.root.subscribed":{"title":"Message root subscribed","type":"boolean"},"message.root.subtype":{"title":"Message root subtype","type":"string"},"message.root.text":{"title":"Message root text","type":"string"},"message.root.thread_ts":{"title":"Message root thread ts","type":"string"},"message.root.ts":{"title":"Message root ts","type":"string"},"message.root.type":{"title":"Message root type","type":"string"},"message.root.username":{"title":"Message root username","type":"string"},"message.subtype":{"title":"Message subtype","type":"string"},"message.team":{"title":"Team","type":"string"},"message.text":{"title":"Message text","type":"string"},"message.thread_ts":{"title":"Message thread ts","type":"string"},"message.ts":{"title":"Message ts","type":"string"},"message.type":{"title":"Message type","type":"string"},"message.user":{"title":"User","type":"string"},"message.username":{"title":"Message username","type":"string"},"metadata.event_payload.id":{"title":"Metadata event payload ID","type":"string"},"metadata.event_payload.title":{"title":"Metadata event payload title","type":"string"},"metadata.event_type":{"title":"Metadata event type","type":"string"},"ok":{"title":"Ok","type":"boolean"},"response_metadata.warnings[*]":{"title":"Response metadata warnings","typ