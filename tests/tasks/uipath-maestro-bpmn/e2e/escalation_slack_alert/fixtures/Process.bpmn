            <uipath:input name="activityConfigurationVersion" type="string" value="v2" />
          </uipath:context>
          <uipath:input name="pathParameters" type="json" target="pathParameters"><![CDATA[{}]]></uipath:input>
          <uipath:input name="queryParameters" type="json" target="queryParameters"><![CDATA[{"send_as":"user"}]]></uipath:input>
          <uipath:input name="body" type="json" target="body"><![CDATA[{"channel":"C0B2FDZD1M3","messageToSend":"=\"Escalation alert | Severity: \" + vars.severityValue + \" | Correlation ID: \" + vars.correlationIdValue + \" | Next steps: \" + vars.nextStepsValue"}]]></uipath:input>
          <uipath:output name="response" type="jsonSchema" source="=response" var="sendSlackAlert_response">{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"app_id":{"title":"App ID","type":"string"},"blocks[*].block_id":{"title":"Blocks block ID","type":"string"},"blocks[*].text.emoji":{"title":"Blocks text emoji","type":"boolean"},"blocks[*].text.text":{"title":"Blocks text text","type":"string"},"blocks[*].text.type":{"title":"Type","type":"string"},"blocks[*].type":{"title":"Blocks type","type":"string"},"channel":{"title":"Channel name/ID","type":"string"},"icons.emoji":{"title":"Icons emoji","type":"string"},"message.app_id":{"title":"Message app ID","type":"string"},"message.attachments[*].actions[*].confirm.dismiss_text":{"title":"Dismiss Text","type":"string"},"message.attachments[*].actions[*].confirm.ok_text":{"title":"Ok Text","type":"string"},"message.attachments[*].actions[*].confirm.text":{"title":"Message attachments actions confirm text","type":"string"},"message.attachments[*].actions[*].confirm.title":{"title":"Title","type":"string"},"message.attachments[*].actions[*].id":{"title":"Message attachments actions ID","type":"string"},"message.attachments[*].actions[*].name":{"title":"Name","type":"string"},"message.attachments[*].actions[*].style":{"title":"Style","type":"string"},"message.attachments[*].actions[*].text":{"title":"Message attachments actions text","type":"string"},"message.attachments[*].actions[*].type":{"title":"Message attachments actions type","type":"string"},"message.attachments[*].actions[*].value":{"title":"Value","type":"string"},"message.attachments[*].callback_id":{"title":"Call Back Id","type":"string"},"message.attachments[*].color":{"title":"Color","type":"string"},"message.attachments[*].fallback":{"title":"Fall Back","type":"string"},"message.attachments[*].id":{"title":"Id","type":"number"},"message.attachments[*].text":{"title":"Message attachments text","type":"string"},"message.b