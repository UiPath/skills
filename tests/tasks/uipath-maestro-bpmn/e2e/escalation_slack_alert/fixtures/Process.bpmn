<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:uipath="http://uipath.org/schema/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" exporter="UiPath Maestro (https://uipath.com)" exporterVersion="1.200.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI">
  <bpmn:process id="EscalationSlackAlert" name="EscalationSlackAlert" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:variables version="v1">
        <uipath:input id="senderEmail" name="senderEmail" type="string" elementId="start" />
        <uipath:input id="subject" name="subject" type="string" elementId="start" />
        <uipath:input id="body" name="body" type="string" elementId="start" />
        <uipath:input id="customerTier" name="customerTier" type="string" elementId="start" />
        <uipath:input id="productionDown" name="productionDown" type="boolean" elementId="start" />
        <uipath:input id="workaroundAvailable" name="workaroundAvailable" type="boolean" elementId="start" />
        <uipath:input id="correlationId" name="correlationId" type="string" elementId="start" />
        <uipath:inputOutput id="severityValue" name="severityValue" type="json" elementId="classify" />
        <uipath:inputOutput id="engineeringNeededValue" name="engineeringNeededValue" type="json" elementId="classify" />
        <uipath:inputOutput id="nextStepsValue" name="nextStepsValue" type="json" elementId="classify" />
        <uipath:inputOutput id="sendSlackAlert_response" name="sendSlackAlert_response" type="json" elementId="sendSlackAlert" />
        <uipath:inputOutput id="sendSlackAlert_Error" name="sendSlackAlert_Error" type="json" elementId="sendSlackAlert" />
        <uipath:inputOutput id="postedSlackMessageId" name="postedSlackMessageId" type="string" elementId="sendSlackAlert" />
        <uipath:inputOutput id="correlationIdValue" name="correlationIdValue" type="string" elementId="classify" />
        <uipath:output id="severity" name="severity" type="string" elementId="done" />
        <uipath:output id="engineeringNeeded" name="engineeringNeeded" type="boolean" elementId="done" />
        <uipath:output id="caseKey" name="caseKey" type="string" elementId="done" />
        <uipath:output id="slackMessageId" name="slackMessageId" type="string" elementId="done" />
      </uipath:variables>
      <uipath:bindings version="v1">
        <uipath:binding id="slack" name="is-sandboxes Slack connection" type="string" default="849e85d8-1aa9-4d52-8bbd-20041c8f05d8" resource="Connection" resourceKey="849e85d8-1aa9-4d52-8bbd-20041c8f05d8" propertyAttribute="ConnectionId" />
        <uipath:binding id="shared" name="is-sandboxes Slack folder" type="string" default="5da18ec0-7de1-4e57-aaf1-ddc8a369c199" resource="Connection" resourceKey="849e85d8-1aa9-4d52-8bbd-20041c8f05d8" propertyAttribute="folderKey" />
      </uipath:bindings>
    </bpmn:extensionElements>
    <bpmn:startEvent id="start" name="Manual escalation intake">
      <bpmn:extensionElements>
        <uipath:entryPointId value="5e5bbaa7-4341-f156-8e96-2f0e184653f1" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_start_classify</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:scriptTask id="classify" name="Classify escalation severity and next steps" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.Variables" version="v1" />
          <uipath:context>
            <uipath:inputSchema type="jsonSchema">{"type":"object","properties":{"vars":{"type":"object"},"metadata":{"type":"object"}}}</uipath:inputSchema>
          </uipath:context>
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"vars":"=vars","metadata":"=metadata"}]]></uipath:input>
          <uipath:output name="severityValue" type="string" source="=result.response.severity" var="severityValue" />
          <uipath:output name="engineeringNeededValue" type="boolean" source="=result.response.engineeringNeeded" var="engineeringNeededValue" />
          <uipath:output name="nextStepsValue" type="string" source="=result.response.nextSteps" var="nextStepsValue" />
          <uipath:output name="correlationIdValue" type="string" source="=result.response.correlationId" var="correlationIdValue" />
        </uipath:mapping>
        <uipath:scriptVersion value="v3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_start_classify</bpmn:incoming>
      <bpmn:outgoing>Flow_classify_sendSlackAlert</bpmn:outgoing>
      <bpmn:script>
const isSev1 = vars.customerTier === 'Enterprise' &amp;&amp; vars.productionDown === true &amp;&amp; vars.workaroundAvailable === false;
const isSev2 = vars.productionDown === true &amp;&amp; vars.workaroundAvailable === true;
const severity = isSev1 ? 'Sev1' : (isSev2 ? 'Sev2' : 'Sev3');
const engineeringNeeded = severity === 'Sev1' || severity === 'Sev2';
const nextSteps = isSev1
  ? 'Page the on-call engineering team immediately, open a major incident, and provide customer updates.'
  : (isSev2
    ? 'Notify engineering to monitor and fix the production issue while the workaround is communicated.'
    : 'Acknowledge the escalation, monitor for impact, and follow up with the customer as needed.');
return { severity, engineeringNeeded, nextSteps, correlationId: vars.correlationId };
</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sendTask id="sendSlackAlert" name="Post escalation alert to Slack">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Intsvc.ActivityExecution" version="v1" />
          <uipath:context>
            <uipath:input name="connectorKey" type="string" value="uipath-salesforce-slack" />
            <uipath:input name="connection" type="string" value="=bindings.slack" />
            <uipath:input name="resourceKey" type="string" value="849e85d8-1aa9-4d52-8bbd-20041c8f05d8" />
            <uipath:input name="folderKey" type="string" value="=bindings.shared" />
            <uipath:input name="objectName" type="string" value="send_message_to_channel_v2" />
            <uipath:input name="method" type="string" value="POST" />
            <uipath:input name="path" type="string" value="/send_message_to_channel_v2" />
