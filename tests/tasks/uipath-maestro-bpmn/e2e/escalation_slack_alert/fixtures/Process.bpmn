          <uipath:output name="Error" type="jsonSchema" source="=Error" var="sendSlackAlert_Error">{"type":"object","properties":{"code":{"type":"string"},"message":{"type":"string"},"detail":{"type":"string"},"category":{"type":"string"},"status":{"type":"number"},"element":{"type":"string"}}}</uipath:output>
          <uipath:output name="postedSlackMessageId" type="string" source="=response.ts" var="postedSlackMessageId" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_classify_sendSlackAlert</bpmn:incoming>
      <bpmn:outgoing>Flow_sendSlackAlert_done</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="done" name="Escalation triaged">
      <bpmn:extensionElements>
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.Variables" version="v1" />
          <uipath:output name="severity" type="string" source="=vars.severityValue" var="severity" />
          <uipath:output name="engineeringNeeded" type="boolean" source="=vars.engineeringNeededValue" var="engineeringNeeded" />
          <uipath:output name="caseKey" type="string" source="=vars.correlationIdValue" var="caseKey" />
          <uipath:output name="slackMessageId" type="string" source="=vars.postedSlackMessageId" var="slackMessageId" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_sendSlackAlert_done</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_start_classify" sourceRef="start" targetRef="classify" />
    <bpmn:sequenceFlow id="Flow_classify_sendSlackAlert" sourceRef="classify" targetRef="sendSlackAlert" />
    <bpmn:sequenceFlow id="Flow_sendSlackAlert_done" sourceRef="sendSlackAlert" targetRef="done" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="EscalationSlackAlert">
      <bpmndi:BPMNShape id="S_classify" bpmnElement="classify"><dc:Bounds x="338" y="192" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_done" bpmnElement="done"><dc:Bounds x="638" y="214" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_sendSlackAlert" bpmnElement="sendSlackAlert"><dc:Bounds x="488" y="192" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_start" bpmnElement="start"><dc:Bounds x="252" y="214" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="E_Flow_classify_sendSlackAlert" bpmnElement="Flow_classify_sendSlackAlert"><di:waypoint x="438" y="232" /><di:waypoint x="488" y="232" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_sendSlackAlert_done" bpmnElement="Flow_sendSlackAlert_done"><di:waypoint x="588" y="232" /><di:waypoint x="638" y="232" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_start_classify" bpmnElement="Flow_start_classify"><di:waypoint x="288" y="232" /><di:waypoint x="338" y="232" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>