<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:uipath="http://uipath.org/schema/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" exporter="UiPath Maestro (https://uipath.com)" exporterVersion="1.203.0-dev.8703">
  <bpmn:process id="Process_1" name="Maestro Process">
    <bpmn:extensionElements>
      <uipath:variables version="v1">
        <uipath:input id="input_Var_Name" name="name" type="string" elementId="Event_start" />
        <uipath:inputOutput id="Var_Name" name="name" type="string" elementId="Process_1" />
        <uipath:inputOutput id="Var_ApiResponse" name="apiResponse" type="json" elementId="Task_InvokeGreeting" />
        <uipath:inputOutput id="Var_Message" name="message" type="string" elementId="Task_InvokeGreeting" />
        <uipath:output id="output_Var_Message" name="message" type="string" elementId="End_1" />
      </uipath:variables>
      <uipath:bindings version="v1">
        <uipath:binding id="Binding_GreetingApiRelease" resource="process" propertyAttribute="Key" default="11111111-1111-4111-8111-111111111111" />
      </uipath:bindings>
    </bpmn:extensionElements>
    <bpmn:startEvent id="Event_start" name="core.trigger.manual">
      <bpmn:extensionElements>
        <uipath:entryPointId value="471a577b-5ce3-42f0-9844-811e9c908c24" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.Variables" version="v1" />
          <uipath:output name="name" type="string" var="Var_Name" source="=vars.input_Var_Name" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_InvokeGreeting" name="Invoke Greeting API">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.ExecuteApiWorkflowAsync" version="v1" />
          <uipath:context>
            <uipath:input name="releaseKey" type="string" value="=bindings.Binding_GreetingApiRelease" />
            <uipath:input name="folderKey" type="string" value="22222222-2222-4222-8222-222222222222" />
          </uipath:context>
          <uipath:input name="JobArguments" type="json" target="bodyField"><![CDATA[{"name": "=vars.Var_Name"}]]></uipath:input>
          <uipath:output name="Process response" type="Orchestrator.RunJob" var="Var_ApiResponse" />
          <uipath:output name="message" type="string" source="=result.message" var="Var_Message" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_1" name="Complete">
      <bpmn:extensionElements>
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.Variables" version="v1" />
          <uipath:output name="message" type="string" var="output_Var_Message" source="=vars.Var_Message" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Event_start" targetRef="Task_InvokeGreeting" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_InvokeGreeting" targetRef="End_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="S_Event_start" bpmnElement="Event_start">
        <dc:Bounds x="156" y="144" width="96" height="96" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="156" y="245" width="96" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_InvokeGreeting" bpmnElement="Task_InvokeGreeting">
        <dc:Bounds x="340" y="130" width="120" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End_1" bpmnElement="End_1">
        <dc:Bounds x="560" y="144" width="96" height="96" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="E_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="252" y="192" />
        <di:waypoint x="340" y="192" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="460" y="192" />
        <di:waypoint x="560" y="192" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
