<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:uipath="http://uipath.org/schema/bpmn">
  <bpmn:process id="Process_1" name="Maestro Process">
    <bpmn:extensionElements>
      <uipath:variables version="v1">
        <uipath:input id="input_Var_Name" name="name" type="string" elementId="Event_start" />
        <uipath:inputOutput id="Var_Name" name="name" type="string" elementId="Process_1" />
        <uipath:inputOutput id="Var_ApiResponse" name="apiResponse" type="json" elementId="Task_InvokeGreeting" />
        <uipath:inputOutput id="Var_Message" name="message" type="string" elementId="Task_InvokeGreeting" />
        <uipath:output id="output_Var_Message" name="message" type="string" elementId="End_1" />
      </uipath:variables>
      <uipath:bindings version="v1">
        <uipath:binding id="Binding_GreetingApiRelease" resource="process" propertyAttribute="Key" default="99999999-9999-9999-9999-999999999999" />
      </uipath:bindings>
    </bpmn:extensionElements>
    <bpmn:startEvent id="Event_start" name="core.trigger.manual">
      <bpmn:extensionElements>
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.Variables" version="v1" />
          <uipath:output name="name" type="string" var="Var_Name" source="=vars.input_Var_Name" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_InvokeGreeting" name="Invoke Greeting API">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.ExecuteApiWorkflowAsync" version="v1" />
          <uipath:context>
            <uipath:input name="releaseKey" type="string" value="=bindings.Binding_GreetingApiRelease" />
            <uipath:input name="folderKey" type="string" value="22222222-2222-4222-8222-222222222222" />
          </uipath:context>
          <uipath:input name="JobArguments" type="json" target="bodyField"><![CDATA[{"name": "=vars.Var_Name"}]]></uipath:input>
          <uipath:output name="Process response" type="Orchestrator.RunJob" var="Var_ApiResponse" />
          <uipath:output name="message" type="string" source="=result.message" var="Var_Message" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_1" name="Complete">
      <bpmn:extensionElements>
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.Variables" version="v1" />
          <uipath:output name="message" type="string" var="output_Var_Message" source="=vars.Var_Message" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Event_start" targetRef="Task_InvokeGreeting" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_InvokeGreeting" targetRef="End_1" />
  </bpmn:process>
</bpmn:definitions>
