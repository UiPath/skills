    <bpmn:boundaryEvent cancelActivity="true" id="sendEscalationAlert_onError" name="Slack escalation alert failed" attachedToRef="sendEscalationAlert">
      <bpmn:outgoing>Flow_sendEscalationAlert_onError_handleEscalationSlackFailure</bpmn:outgoing>
      <bpmn:errorEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:task id="handleEscalationSlackFailure" name="Handle escalation Slack failure gracefully">
      <bpmn:extensionElements>
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.Variables" version="v1" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_sendEscalationAlert_onError_handleEscalationSlackFailure</bpmn:incoming>
      <bpmn:outgoing>Flow_handleEscalationSlackFailure_escalationEnd</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="escalationEnd" name="Escalation complete">
      <bpmn:extensionElements>
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.Variables" version="v1" />
          <uipath:output name="escalationPath" type="string" source="=vars.classifiedEscalationPath" var="escalationPath" />
          <uipath:output name="severity" type="string" source="=vars.classifiedSeverity" var="severity" />
          <uipath:output name="engineeringNeeded" type="boolean" source="=vars.classifiedEngineeringNeeded" var="engineeringNeeded" />
          <uipath:output name="responseMode" type="string" source="=vars.classifiedResponseMode" var="responseMode" />
          <uipath:output name="caseKey" type="string" source="=vars.correlationId" var="caseKey" />
          <uipath:output name="slackMessageId" type="string" source="=vars.escalationSlackMessageId" var="slackMessageId" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_sendEscalationAlert_escalationEnd</bpmn:incoming>
      <bpmn:incoming>Flow_handleEscalationSlackFailure_escalationEnd</bpmn:incoming>
    </bpmn:endEvent>
