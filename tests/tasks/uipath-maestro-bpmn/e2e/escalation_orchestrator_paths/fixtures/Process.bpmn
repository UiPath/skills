<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:uipath="http://uipath.org/schema/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" exporter="UiPath Maestro (https://uipath.com)" exporterVersion="1.200.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:di="http://www.omg.org/spec/DD/20100524/DI">
  <bpmn:process id="CustomerEscalationOrchestrator" name="CustomerEscalationOrchestrator" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:variables version="v1">
        <uipath:input id="senderEmail" name="senderEmail" type="string" elementId="manualStart" />
        <uipath:input id="senderDomain" name="senderDomain" type="string" elementId="manualStart" />
        <uipath:input id="subject" name="subject" type="string" elementId="manualStart" />
        <uipath:input id="body" name="body" type="string" elementId="manualStart" />
        <uipath:input id="customerTier" name="customerTier" type="string" elementId="manualStart" />
        <uipath:input id="productionDown" name="productionDown" type="boolean" elementId="manualStart" />
        <uipath:input id="workaroundAvailable" name="workaroundAvailable" type="boolean" elementId="manualStart" />
        <uipath:input id="hasAttachments" name="hasAttachments" type="boolean" elementId="manualStart" />
        <uipath:input id="customerMatchStatus" name="customerMatchStatus" type="string" elementId="manualStart" />
        <uipath:input id="isDuplicate" name="isDuplicate" type="boolean" elementId="manualStart" />
        <uipath:input id="correlationId" name="correlationId" type="string" elementId="manualStart" />
        <uipath:inputOutput id="correlationIdForSlack" name="correlationIdForSlack" type="string" elementId="CustomerEscalationOrchestrator" />
        <uipath:inputOutput id="classifiedEscalationPath" name="escalationPath" type="string" elementId="classify" />
        <uipath:inputOutput id="classifiedSeverity" name="severity" type="string" elementId="classify" />
        <uipath:inputOutput id="classifiedEngineeringNeeded" name="engineeringNeeded" type="boolean" elementId="classify" />
        <uipath:inputOutput id="classifiedResponseMode" name="responseMode" type="string" elementId="classify" />
        <uipath:inputOutput id="sendEscalationAlert_response" name="sendEscalationAlert_response" type="json" elementId="sendEscalationAlert" />
        <uipath:inputOutput id="sendEscalationAlert_Error" name="sendEscalationAlert_Error" type="json" elementId="sendEscalationAlert" />
        <uipath:inputOutput id="escalationSlackMessageId" name="ts" type="string" elementId="sendEscalationAlert" />
        <uipath:inputOutput id="sendTriageNotice_response" name="sendTriageNotice_response" type="json" elementId="sendTriageNotice" />
        <uipath:inputOutput id="sendTriageNotice_Error" name="sendTriageNotice_Error" type="json" elementId="sendTriageNotice" />
        <uipath:inputOutput id="triageSlackMessageId" name="ts" type="string" elementId="sendTriageNotice" />
        <uipath:output id="escalationPath" name="escalationPath" type="string" elementId="escalationEnd" />
        <uipath:output id="severity" name="severity" type="string" elementId="escalationEnd" />
        <uipath:output id="engineeringNeeded" name="engineeringNeeded" type="boolean" elementId="escalationEnd" />
        <uipath:output id="responseMode" name="responseMode" type="string" elementId="escalationEnd" />
        <uipath:output id="caseKey" name="caseKey" type="string" elementId="escalationEnd" />
        <uipath:output id="slackMessageId" name="slackMessageId" type="string" elementId="escalationEnd" />
      </uipath:variables>
      <uipath:bindings version="v1">
        <uipath:binding id="slack" name="slack" type="string" default="849e85d8-1aa9-4d52-8bbd-20041c8f05d8" resource="Connection" resourceKey="849e85d8-1aa9-4d52-8bbd-20041c8f05d8" propertyAttribute="ConnectionId" />
        <uipath:binding id="shared" name="shared" type="string" default="5da18ec0-7de1-4e57-aaf1-ddc8a369c199" resource="Connection" resourceKey="849e85d8-1aa9-4d52-8bbd-20041c8f05d8" propertyAttribute="folderKey" />
      </uipath:bindings>
    </bpmn:extensionElements>
    <bpmn:startEvent id="manualStart" name="Manual start">
      <bpmn:extensionElements>
        <uipath:entryPointId value="e2e00000-0000-4000-8000-000000000001" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.Variables" version="v1" />
          <uipath:output name="correlationId" type="string" source="=vars.correlationId" var="correlationIdForSlack" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_manualStart_classify</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:scriptTask id="classify" name="classify" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.Variables" version="v1" />
          <uipath:context>
            <uipath:inputSchema type="jsonSchema">{"type":"object","properties":{"vars":{"type":"object"},"metadata":{"type":"object"}}}</uipath:inputSchema>
          </uipath:context>
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"vars":"=vars","metadata":"=metadata"}]]></uipath:input>
          <uipath:output name="escalationPath" type="string" source="=result.response.escalationPath" var="classifiedEscalationPath" />
          <uipath:output name="severity" type="string" source="=result.response.severity" var="classifiedSeverity" />
          <uipath:output name="engineeringNeeded" type="boolean" source="=result.response.engineeringNeeded" var="classifiedEngineeringNeeded" />
          <uipath:output name="responseMode" type="string" source="=result.response.responseMode" var="classifiedResponseMode" />
        </uipath:mapping>
        <uipath:scriptVersion value="v3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_manualStart_classify</bpmn:incoming>
      <bpmn:outgoing>Flow_classify_routeEscalation</bpmn:outgoing>
      <bpmn:script>var path = (!vars.senderDomain || vars.senderDomain === "")
  ? "missing_domain"
  : (vars.customerMatchStatus === "none"
    ? "unknown_customer"
    : (vars.customerMatchStatus === "multiple"
      ? "multiple_matches"
      : (vars.isDuplicate === true ? "duplicate" : "escalation")));
var sev = path === "escalation"
  ? (vars.productionDown === true
    ? (vars.workaroundAvailable === true ? "Sev2" : "Sev1")
    : "Sev3")
  : "informational";
return {
  escalationPath: path,
  severity: sev,
  engineeringNeeded: sev === "Sev1" || sev === "Sev2",
  responseMode: path === "escalation" ? "Draft" : "None"
};</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="routeEscalation" default="Flow_routeEscalation_sendTriageNotice">
      <bpmn:incoming>Flow_classify_routeEscalation</bpmn:incoming>
      <bpmn:outgoing>Flow_routeEscalation_sendEscalationAlert</bpmn:outgoing>
      <bpmn:outgoing>Flow_routeEscalation_sendTriageNotice</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="sendEscalationAlert" name="Send escalation alert to Slack">
