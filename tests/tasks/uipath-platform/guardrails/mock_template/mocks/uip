        "UpdatedAt": None,
        "ConnectorKey": "uipath-azure-contentsafety",
        "ConnectorName": "Azure AI Content Safety",
        "ConnectionName": "Azure AI Content Safety - Prod",
        "ValidConnection": True,
    },
    {
        "Id": "3fa1c8d2-77e4-4b09-9c15-08de7f2201bd",
        "ConnectionId": CONTENT_SAFETY_ID,
        "ValidatorName": "byog-pii-prod",
        "ValidatorType": "pii_detection",
        "FallbackOnUiPath": True,
        "Enabled": True,
        "CreatedAt": "2026-07-02T11:40:00Z",
        "UpdatedAt": None,
