VALIDATORS[CONTENT_SAFETY_DR_ID] = VALIDATORS[CONTENT_SAFETY_ID]

# Two configurations already registered, so `list` is non-empty and the agent
# can see for itself that a requested name is free. The names are also the
# tenant-uniqueness tripwire if the agent reuses one. The update task targets
# byog-pii-prod and the delete task targets byog-legacy-harmful, so neither
# task's mutation can mask the other's assertion.
SEEDED = [
    {
        "Id": "b41d0c77-9e52-4a8f-b3d1-08de7f19aa02",
