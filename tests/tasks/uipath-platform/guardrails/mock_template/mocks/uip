# Mutations persist for the rest of the run. Agents routinely read back with
# `list` after a write; a static list would answer "not there" right after
# create said "Created" (or keep showing a record after delete said "Deleted"),
# which reads as a failed write and sends the agent into retries that have
# nothing to do with the behavior under test.
#
# Shape: {"created": [record, ...], "updated": {id: {field: value}}, "deleted": [id]}
# `updated` holds only changed fields so a seeded record can be edited without
# copying it, and `deleted` is a tombstone list so seeded records can be
# removed too — they are not in `created`, so filtering that alone would leave
# a deleted seed visible in `list`.
STATE_PATH = os.path.join(os.path.dirname(MOCK_DIR), ".byog-state.json")

EMPTY_STATE = {"created": [], "updated": {}, "deleted": []}


def load_state():
    if not os.path.exists(STATE_PATH):
        return json.loads(json.dumps(EMPTY_STATE))
    try:
        with open(STATE_PATH) as fh:
            state = json.load(fh)
    except (OSError, ValueError):
        return json.loads(json.dumps(EMPTY_STATE))
    for key, empty in EMPTY_STATE.items():
        state.setdefault(key, json.loads(json.dumps(empty)))
    return state


def save_state(state):
    try:
        with open(STATE_PATH, "w") as fh:
            json.dump(state, fh)
    except OSError:
        pass  # a read-only sandbox degrades to the seeded list, never crashes


def all_configurations():
    """Seeded + created, with update overrides applied and tombstones removed."""
    state = load_state()
    deleted = set(state["deleted"])
    updated = state["updated"]
    out = []
    for record in SEEDED + state["created"]:
        if record["Id"] in deleted:
            continue
        if record["Id"] in updated:
            record = dict(record, **updated[record["Id"]])
        out.append(record)
    return out


def find_configuration(configuration_id):
    for record in all_configurations():
        if record["Id"] == configuration_id:
            return record
    return None


def connection_meta(connection_id):
    for connection in CONNECTIONS:
        if connection["Id"] == connection_id:
            return {
                "ConnectorKey": connection["ConnectorKey"],
                "ConnectorName": connection["ConnectorName"],
                "ConnectionName": connection["Name"],
            }
    return {}


def emit(payload, exit_code=0):
    print(json.dumps(payload, indent=2))
    return exit_code


def failure(code, message, instructions=None, data=None):
    payload = {"Result": "Failure", "Code": code, "Message": message}
    if instructions is not None:
        payload["Instructions"] = instructions
    if data is not None:
        payload["Data"] = data
    return payload


# Flags that consume the next token as their value. Without this the naive
# "anything not starting with '-' is positional" rule reads the VALUE of
# `--output json` as the connector-key positional, so
# `is connections list --output json` — the exact form the skill tells agents
# to use — answers "no connections found for connector 'json'". An agent then
# reasonably concludes the connection does not exist, which is a lie the mock
# told it. Keep this list in step with any value-taking flag a task's prompt
# could plausibly lead an agent to type.
VALUE_FLAGS = {
    "--output",
    "--output-filter",
    "--connection-id",
    "--validator-name",
    "--validator-type",
    "--login-validity",
    "--folder",
    "--folder-key",
    "--profile",
    "--filter",
    "--limit",
    "--scope",
}


def positionals(args):
    """Positional tokens, skipping flags and the values they consume."""
    out = []
    skip = False
    for arg in args:
        if skip:
            skip = False
            continue
        if arg.startswith("-"):
            if arg in VALUE_FLAGS:
                skip = True
            continue
        out.append(arg)
    return out


def flag(args, name):
    """Value of --name <v> or --name=<v>; None when absent."""
    for i, a in enumerate(args):
        if a == name:
            return args[i + 1] if i + 1 < len(args) else None
        if a.startswith(name + "="):
            return a.split("=", 1)[1]
    return None


def probe_pair(connection_id, validator_type):
    """Mirror the server-side probe: reachability, then validator support."""
    if connection_id not in VALIDATORS:
        return None, (
            "REACHABILITY_FAILED",
            f"Connection {connection_id} is invalid or you do not have access to it",
        )
    served = [v["Validator"] for v in VALIDATORS[connection_id]]
    if validator_type not in served:
        return None, (
            "VALIDATOR_NOT_SUPPORTED",
            f"The connected service does not serve validator '{validator_type}'. "
            f"Available: {', '.join(served) if served else 'none'}",
        )
    return {
        "ConnectionId": connection_id,
        "ValidatorType": validator_type,
        "ConnectorKey": "uipath-azure-contentsafety",
        "IsAvailable": True,
        "Verdict": "PASSED",
        "Details": None,
        "DurationMs": 842,
        "Error": None,
    }, None


def probe_failure(connection_id, validator_type, err):
    code, message = err
    return failure(
        "ByoGuardrailProbeFailed",
        f"Probe failed for validator '{validator_type}' on connection "
        f"'{connection_id}' — {code}: {message}",
        data={
            "ConnectionId": connection_id,
            "ValidatorType": validator_type,
            "IsAvailable": False,
            "Error": {"Code": code, "Message": message},
        },
    )


def handle_byo_configurations(verb, args):
    if verb == "list":
        return emit(
            {
                "Result": "Success",
                "Code": "ByoGuardrailConfigurationsList",
                "Data": all_configurations(),
            }
        )

    if verb == "list-validators":
        connection_id = flag(args, "--connection-id")
        if connection_id not in VALIDATORS:
            return emit(
                probe_failure(connection_id, "*", (
                    "REACHABILITY_FAILED",
                    f"Connection {connection_id} is invalid or you do not "
                    "have access to it",
                )),
                1,
            )
        return emit(
            {
                "Result": "Success",
                "Code": "ByoGuardrailValidatorsList",
                "Data": VALIDATORS[connection_id],
            }
        )

    if verb == "probe":
        connection_id = flag(args, "--connection-id")
        validator_type = flag(args, "--validator-type")
        result, err = probe_pair(connection_id, validator_type)
        if err:
            return emit(probe_failure(connection_id, validator_type, err), 1)
        return emit(
            {
                "Result": "Success",
                "Code": "ByoGuardrailProbeSucceeded",
                "Data": result,
            }
        )

    if verb == "create":
        connection_id = flag(args, "--connection-id")
        validator_name = flag(args, "--validator-name")
        validator_type = flag(args, "--validator-type")
        missing = [
            name
            for name, value in (
                ("--connection-id", connection_id),
                ("--validator-name", validator_name),
                ("--validator-type", validator_type),
            )
            if not value
        ]
        if missing:
            return emit(
                failure(
                    "MissingRequiredOption",
                    f"required option(s) missing: {', '.join(missing)}",
                ),
                1,
            )

        # Probe runs before the save, as the real command does.
        _, err = probe_pair(connection_id, validator_type)
        if err:
            return emit(probe_failure(connection_id, validator_type, err), 1)

        if any(c["ValidatorName"] == validator_name for c in all_configurations()):
            return emit(
                failure(
                    "ByoGuardrailConfigurationCreateFailed",
                    "Failed to create BYO guardrail configuration",
                    instructions=(
                        '409 Conflict: {"detail":"A configuration with '
                        f'validator name \'{validator_name}\' already exists '
                        'in this tenant."}'
                    ),
                ),
                1,
            )

        record = {
            "Id": "c9f4a2e1-6b70-4c3a-8d15-08de9042bb31",
            "ConnectionId": connection_id,
            "ValidatorName": validator_name,
            "ValidatorType": validator_type,
            "FallbackOnUiPath": "--fallback-on-ui-path" in args,
            "Enabled": "--disabled" not in args,
            "CreatedAt": "2026-08-12T00:00:00Z",
            "UpdatedAt": None,
            "ConnectorKey": "uipath-azure-contentsafety",
            "ConnectorName": "Azure AI Content Safety",
            "ConnectionName": "Azure AI Content Safety - Prod",
            "ValidConnection": True,
        }
        state = load_state()
        state["created"].append(record)
        save_state(state)
        return emit(
            {
                "Result": "Success",
                "Code": "ByoGuardrailConfigurationCreated",
                "Data": record,
            }
        )

    if verb == "update":
        positional = positionals(args)
        target = positional[3] if len(positional) > 3 else None

        # ValidatorName/ValidatorType are locked at creation — the real command
        # has no such flags, so Commander rejects them before any API call.
        for locked in ("--validator-name", "--validator-type"):
            if any(a == locked or a.startswith(locked + "=") for a in args):
                return emit(
                    failure(
                        "UnknownOption",
                        f"unknown option '{locked}'",
                        instructions=(
                            "ValidatorName and ValidatorType cannot be changed; "
                            "delete and re-create the configuration instead."
                        ),
                    ),
                    1,
                )

        connection_id = flag(args, "--connection-id")
        fallback = None
        if "--fallback-on-ui-path" in args:
            fallback = True
        if "--no-fallback-on-ui-path" in args:
            fallback = False
        enabled = None
        if "--enabled" in args:
            enabled = True
        if "--disabled" in args:
            enabled = False
        if "--enabled" in args and "--disabled" in args:
            return emit(
                failure(
                    "ConflictingOptions",
                    "option '--enabled' cannot be used with option '--disabled'",
                ),
                1,
            )

        # Refused client-side, before any API call, when nothing would change.
        if connection_id is None and fallback is None and enabled is None:
            return emit(
                failure(
                    "NoUpdatableField",
                    "Provide at least one of --connection-id, "
                    "--fallback-on-ui-path/--no-fallback-on-ui-path, or "
                    "--enabled/--disabled to update.",
                    instructions=(
                        "ValidatorName and ValidatorType cannot be changed; "
                        "delete and re-create the configuration instead."
                    ),
                ),
                1,
            )

        existing = find_configuration(target)
        if existing is None:
            return emit(
                failure(
                    "ByoGuardrailConfigurationNotFound",
                    f"No BYO guardrail configuration found with id '{target}'",
                    instructions=(
                        "Run 'uip guardrails byo-configurations list' to find a "
                        "valid configuration id."
                    ),
                ),
                1,
            )

        # Probe ONLY when the connection binding changes. Re-probing on every
        # edit would make a configuration whose vendor is down impossible to
        # disable — the one moment you most need to.
        changes = {}
        if connection_id is not None:
            _, err = probe_pair(connection_id, existing["ValidatorType"])
            if err:
                return emit(
                    probe_failure(connection_id, existing["ValidatorType"], err), 1
                )
            changes["ConnectionId"] = connection_id
            changes.update(connection_meta(connection_id))
        if fallback is not None:
            changes["FallbackOnUiPath"] = fallback
        if enabled is not None:
            changes["Enabled"] = enabled
        changes["UpdatedAt"] = "2026-08-13T00:00:00Z"

        state = load_state()
        merged = dict(state["updated"].get(target, {}), **changes)
        state["updated"][target] = merged
        save_state(state)
        return emit(
            {
                "Result": "Success",
                "Code": "ByoGuardrailConfigurationUpdated",
                "Data": dict(existing, **changes),
            }
        )

    if verb == "delete":
        positional = positionals(args)
        target = positional[3] if len(positional) > 3 else None
        if "--force" not in args:
            return emit(
                failure(
                    "ByoGuardrailConfigurationDeleteRefused",
                    "Refusing to delete without --force. Deletion is permanent.",
                ),
                1,
            )
        if find_configuration(target) is None:
            return emit(
                failure(
                    "ByoGuardrailConfigurationNotFound",
                    f"No BYO guardrail configuration found with id '{target}'",
                    instructions=(
                        "Run 'uip guardrails byo-configurations list' to find a "
                        "valid configuration id."
                    ),
                ),
                1,
            )
        # Tombstone rather than filter `created`: seeded records are not in
        # `created`, so filtering alone would leave a deleted seed in `list`.
        state = load_state()
        state["deleted"].append(target)
        save_state(state)
        return emit(
            {
                "Result": "Success",
                "Code": "ByoGuardrailConfigurationDeleted",
                "Data": {"Id": target},
            }
        )

    return None


def handle_connections(verb, args):
    if verb == "list":
        positional = positionals(args)
        connector_key = positional[3] if len(positional) > 3 else None
        data = CONNECTIONS
        if connector_key:
            data = [c for c in CONNECTIONS if c["ConnectorKey"] == connector_key]
        if not data:
            return emit(
                {
                    "Result": "Success",
                    "Code": "ConnectionsList",
                    "Message": (
                        f"No connections found for connector '{connector_key}'."
                    ),
                    "Data": [],
                }
            )
        return emit(
            {"Result": "Success", "Code": "ConnectionsList", "Data": data}
        )

    if verb == "ping":
        positional = positionals(args)
        target = positional[3] if len(positional) > 3 else None
        known = {c["Id"] for c in CONNECTIONS}
        if target not in known:
            return emit(
                failure(
                    "ConnectionPingFailed",
                    f"Connection {target} is invalid or you do not have "
                    "access to it",
                ),
                1,
            )
        return emit(
            {
                "Result": "Success",
                "Code": "ConnectionPing",
                "Data": {"ConnectionId": target, "State": "Enabled"},
            }
        )

    return None


def real_uip():
    path = os.environ.get("PATH", "")
    parts = [
        p
        for p in path.split(os.pathsep)
        if p and os.path.abspath(p) != MOCK_DIR
    ]
    return shutil.which("uip", path=os.pathsep.join(parts))


def main():
    args = sys.argv[1:]
    literal = positionals(args)

    # A help request is a question about flags, not about tenant data. Answering
    # it with a canned JSON payload reads as "that flag does not exist", so let
    # the real CLI print its own help.
    wants_help = "--help" in args or "-h" in args

    handled = None
    if wants_help:
        pass
    elif literal[:2] == ["guardrails", "byo-configurations"] and len(literal) > 2:
        handled = handle_byo_configurations(literal[2], args)
    elif literal[:2] in (["is", "connections"], ["integrations", "connections"]):
        if len(literal) > 2:
            handled = handle_connections(literal[2], args)
    if handled is not None:
        return handled

    real = real_uip()
    if not real:
        sys.stderr.write("uip (shim): real uip CLI not found on PATH\n")
        return 127
    os.execv(real, [real] + args)


if __name__ == "__main__":
    sys.exit(main())
