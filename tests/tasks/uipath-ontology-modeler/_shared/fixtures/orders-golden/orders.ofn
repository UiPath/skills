Prefix(:=<https://ontology.uipath.com/orders#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Ontology(<https://ontology.uipath.com/orders>
Declaration(Class(:SalesOrder))
Declaration(Class(:Customer))
Declaration(DataProperty(:SalesOrder.orderNumber))
Declaration(DataProperty(:SalesOrder.status))
Declaration(DataProperty(:Customer.customerName))
Declaration(ObjectProperty(:placedBy))
Declaration(ObjectProperty(:places))
AnnotationAssertion(rdfs:label :SalesOrder "Sales order")
AnnotationAssertion(rdfs:comment :SalesOrder "A customer order; ONE row per order.")
AnnotationAssertion(rdfs:label :Customer "Customer")
AnnotationAssertion(rdfs:comment :Customer "A customer who places orders; ONE row per customer.")
AnnotationAssertion(rdfs:label :SalesOrder.orderNumber "Order number")
AnnotationAssertion(rdfs:comment :SalesOrder.orderNumber "The business order number.")
AnnotationAssertion(rdfs:label :SalesOrder.status "Status")
AnnotationAssertion(rdfs:comment :SalesOrder.status "The order status, a value of the OrderStatus choice set: Open, Shipped or Cancelled.")
AnnotationAssertion(rdfs:label :Customer.customerName "Customer name")
AnnotationAssertion(rdfs:comment :Customer.customerName "The customer's display name.")
AnnotationAssertion(rdfs:label :placedBy "placed by")
AnnotationAssertion(rdfs:comment :placedBy "Each sales order is placed by one customer. Join: SalesOrder.customer = Customer.Id. 'Exactly one' is QL-inexpressible; recorded here.")
AnnotationAssertion(rdfs:label :places "places")
AnnotationAssertion(rdfs:comment :places "The orders a customer places; the inverse of placedBy.")
DataPropertyDomain(:SalesOrder.orderNumber :SalesOrder)
DataPropertyRange(:SalesOrder.orderNumber xsd:string)
DataPropertyDomain(:SalesOrder.status :SalesOrder)
DataPropertyRange(:SalesOrder.status xsd:string)
DataPropertyDomain(:Customer.customerName :Customer)
DataPropertyRange(:Customer.customerName xsd:string)
ObjectPropertyDomain(:placedBy :SalesOrder)
ObjectPropertyRange(:placedBy :Customer)
InverseObjectProperties(:places :placedBy)
)
