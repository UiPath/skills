Prefix(:=<https://ontology.uipath.com/orders#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Ontology(<https://ontology.uipath.com/orders>
Declaration(Class(:Order))
Declaration(Class(:Customer))
Declaration(DataProperty(:Order.orderNumber))
Declaration(DataProperty(:Customer.customerName))
Declaration(ObjectProperty(:placedBy))
AnnotationAssertion(rdfs:label :Order "Order")
AnnotationAssertion(rdfs:comment :Order "A customer order; ONE row per order.")
AnnotationAssertion(rdfs:label :Customer "Customer")
AnnotationAssertion(rdfs:comment :Customer "A customer who places orders; ONE row per customer.")
AnnotationAssertion(rdfs:label :Order.orderNumber "Order number")
AnnotationAssertion(rdfs:comment :Order.orderNumber "The business order number.")
AnnotationAssertion(rdfs:label :Customer.customerName "Customer name")
AnnotationAssertion(rdfs:comment :Customer.customerName "The customer's display name.")
AnnotationAssertion(rdfs:label :placedBy "placed by")
AnnotationAssertion(rdfs:comment :placedBy "Each Order is placed by one Customer. Join: Order.customerId = Customer.Id. 'Exactly one' is QL-inexpressible; recorded here.")
DataPropertyDomain(:Order.orderNumber :Order)
DataPropertyRange(:Order.orderNumber xsd:string)
DataPropertyDomain(:Customer.customerName :Customer)
DataPropertyRange(:Customer.customerName xsd:string)
ObjectPropertyDomain(:placedBy :Order)
ObjectPropertyRange(:placedBy :Customer)
)
