Prefix(:=<https://ontology.uipath.com/demo#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Ontology(<https://ontology.uipath.com/demo>
Declaration(Class(:Order))
Declaration(Class(:Customer))
Declaration(ObjectProperty(:placedBy))
Declaration(DataProperty(:Order.id))
AnnotationAssertion(rdfs:label :Order "Order")
AnnotationAssertion(rdfs:comment :Order "An order.")
AnnotationAssertion(rdfs:label :Order.id "Order identifier")
AnnotationAssertion(rdfs:comment :Order.id "The stable order identifier.")
AnnotationAssertion(rdfs:label :Customer "Customer")
AnnotationAssertion(rdfs:comment :Customer "A customer.")
AnnotationAssertion(rdfs:label :placedBy "placed by")
AnnotationAssertion(rdfs:comment :placedBy "The customer who placed the order.")
Declaration(DataProperty(:Customer.code))
AnnotationAssertion(rdfs:label :Customer.code "Customer code")
AnnotationAssertion(rdfs:comment :Customer.code "The customer code.")
DataPropertyDomain(:Customer.code :Customer)
DataPropertyRange(:Customer.code xsd:string)
ObjectPropertyDomain(:placedBy :Order)
ObjectPropertyRange(:placedBy :Customer)
DataPropertyDomain(:Order.id :Order)
DataPropertyRange(:Order.id xsd:string)
)
