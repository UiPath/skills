Prefix(:=<https://ontology.uipath.com/demo#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Ontology(<https://ontology.uipath.com/demo>
Declaration(Class(:Order))
Declaration(DataProperty(:Order.customerId))
AnnotationAssertion(rdfs:label :Order "Order")
AnnotationAssertion(rdfs:comment :Order "An order.")
AnnotationAssertion(rdfs:label :Order.customerId "Customer identifier")
AnnotationAssertion(rdfs:comment :Order.customerId "The customer business key.")
DataPropertyDomain(:Order.customerId :Order)
DataPropertyRange(:Order.customerId xsd:string)
)
