Prefix(:=<https://ontology.uipath.com/demo#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Ontology(<https://ontology.uipath.com/demo>
Declaration(Class(:Order))
Declaration(Class(:Customer))
Declaration(DataProperty(:Order.id))
Declaration(DataProperty(:Customer.id))
AnnotationAssertion(rdfs:label :Order "Order")
AnnotationAssertion(rdfs:comment :Order "An order.")
AnnotationAssertion(rdfs:label :Customer "Customer")
AnnotationAssertion(rdfs:comment :Customer "A customer.")
DataPropertyDomain(:Order.id :Order)
DataPropertyRange(:Order.id xsd:string)
DataPropertyDomain(:Customer.id :Customer)
DataPropertyRange(:Customer.id xsd:string)
)
