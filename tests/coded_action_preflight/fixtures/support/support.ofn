Prefix(:=<https://ontology.uipath.com/support#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)

Ontology(<https://ontology.uipath.com/support>
    Declaration(Class(:Ticket))
    AnnotationAssertion(rdfs:label :Ticket "Ticket")
    AnnotationAssertion(rdfs:comment :Ticket "A support ticket.")

    Declaration(DataProperty(:Ticket.id))
    AnnotationAssertion(:datatype :Ticket.id "key")
    DataPropertyDomain(:Ticket.id :Ticket)
    DataPropertyRange(:Ticket.id xsd:string)

    Declaration(DataProperty(:Ticket.tags))
    AnnotationAssertion(:datatype :Ticket.tags "text")
    DataPropertyDomain(:Ticket.tags :Ticket)
    DataPropertyRange(:Ticket.tags xsd:string)

    Declaration(DataProperty(:Ticket.dueAt))
    AnnotationAssertion(:datatype :Ticket.dueAt "datetime")
    DataPropertyDomain(:Ticket.dueAt :Ticket)
    DataPropertyRange(:Ticket.dueAt xsd:dateTime)

    Declaration(DataProperty(:Ticket.owner))
    AnnotationAssertion(:datatype :Ticket.owner "text")
    DataPropertyDomain(:Ticket.owner :Ticket)
    DataPropertyRange(:Ticket.owner xsd:string)
)
