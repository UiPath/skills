          <uipath:type value="Orchestrator.StartAgentJob" version="v1" />
          <uipath:context>
            <uipath:input name="name" value="=bindings.Binding_AgentName" />
            <uipath:input name="folderPath" value="=bindings.Binding_AgentFolderPath" />
          </uipath:context>
          <uipath:input name="JobArguments" type="json" target="bodyField"><![CDATA[{"contractId":"CONTRACT-0001"}]]></uipath:input>
          <uipath:output name="Process response" type="Orchestrator.RunJob" var="Var_StartAgentJob" />
