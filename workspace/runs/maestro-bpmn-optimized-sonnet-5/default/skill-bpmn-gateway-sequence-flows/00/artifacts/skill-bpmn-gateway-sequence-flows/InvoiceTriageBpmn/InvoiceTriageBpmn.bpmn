        <di:waypoint x="1055" y="175" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_ArchiveDecisionToJoin" bpmnElement="Flow_ArchiveDecisionToJoin">
        <di:waypoint x="970" y="300" />
        <di:waypoint x="1055" y="300" />
        <di:waypoint x="1055" y="225" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_JoinToEnd" bpmnElement="Flow_JoinToEnd">
        <di:waypoint x="1080" y="200" />
        <di:waypoint x="1130" y="200" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
