        <di:waypoint x="870" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_NotifyRequesterToJoin" bpmnElement="Flow_NotifyRequesterToJoin">
        <di:waypoint x="970" y="100" />
