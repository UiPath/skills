<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:uipath="http://uipath.org/schema/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="UiPath Maestro (https://uipath.com)" exporterVersion="1.201.0-dev.8275">
  <bpmn:process id="Process_1" name="Maestro Process" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:migrationVersion version="11.5" />
      <uipath:variables version="v1">
        <uipath:output id="Var_AgenticProcessResult" name="AgenticProcessResult" type="object" />
      </uipath:variables>
      <uipath:bindings version="v1">
        <uipath:binding id="Binding_AgenticProcessKey" resource="process" propertyAttribute="Key" default="&lt;AGENTIC_PROCESS_RELEASE_KEY&gt;" />
      </uipath:bindings>
    </bpmn:extensionElements>
    <bpmn:startEvent id="Event_start" name="core.trigger.manual">
      <bpmn:extensionElements>
        <uipath:entryPointId value="6de7d14b-86ef-472d-885a-8179f9a85f0c" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_StartToInvoke</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:callActivity id="CallActivity_InvokeAgenticProcess" name="Start Agentic Process">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.StartAgenticProcess" version="v1" />
          <uipath:context>
            <uipath:input name="releaseKey" value="=bindings.Binding_AgenticProcessKey" />
            <uipath:input name="folderId" value="&lt;AGENTIC_PROCESS_FOLDER_ID&gt;" />
            <uipath:input name="folderPath" value="&lt;AGENTIC_PROCESS_FOLDER_PATH&gt;" />
            <uipath:input name="name" value="&lt;AGENTIC_PROCESS_NAME&gt;" />
          </uipath:context>
          <uipath:input name="JobArguments" type="json" target="bodyField"><![CDATA[{}]]></uipath:input>
          <uipath:output name="Process response" type="Orchestrator.RunJob" var="Var_AgenticProcessResult" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_StartToInvoke</bpmn:incoming>
      <bpmn:outgoing>Flow_InvokeToEnd</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="Event_end" name="End">
      <bpmn:incoming>Flow_InvokeToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_StartToInvoke" sourceRef="Event_start" targetRef="CallActivity_InvokeAgenticProcess" />
    <bpmn:sequenceFlow id="Flow_InvokeToEnd" sourceRef="CallActivity_InvokeAgenticProcess" targetRef="Event_end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="S_Event_start" bpmnElement="Event_start">
        <dc:Bounds x="160" y="100" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="138" y="140" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_CallActivity_InvokeAgenticProcess" bpmnElement="CallActivity_InvokeAgenticProcess">
        <dc:Bounds x="260" y="78" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Event_end" bpmnElement="Event_end">
        <dc:Bounds x="420" y="100" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="410" y="140" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_StartToInvoke" bpmnElement="Flow_StartToInvoke">
        <di:waypoint x="196" y="118" />
        <di:waypoint x="260" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_InvokeToEnd" bpmnElement="Flow_InvokeToEnd">
        <di:waypoint x="360" y="118" />
        <di:waypoint x="420" y="118" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
