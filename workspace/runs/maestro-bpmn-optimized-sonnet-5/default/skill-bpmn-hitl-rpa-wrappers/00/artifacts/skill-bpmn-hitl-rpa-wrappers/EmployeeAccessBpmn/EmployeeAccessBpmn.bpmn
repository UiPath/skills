<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:uipath="http://uipath.org/schema/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" exporter="UiPath Maestro (https://uipath.com)" exporterVersion="1.201.0-dev.8275" xmlns:di="http://www.omg.org/spec/DD/20100524/DI">
  <bpmn:process id="EmployeeAccessProcess" name="Maestro Process">
    <bpmn:extensionElements>
      <uipath:variables version="v1">
        <uipath:inputOutput id="Var_ApprovalResult" name="ApprovalResult" type="object" />
        <uipath:inputOutput id="Var_ProvisioningResult" name="ProvisioningResult" type="object" />
      </uipath:variables>
      <uipath:bindings version="v1" />
    </bpmn:extensionElements>
    <bpmn:startEvent id="Event_start" name="core.trigger.manual">
      <bpmn:extensionElements>
        <uipath:entryPointId value="98ea223c-1c53-400d-b06d-7500c8d8b664" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_StartToApproval</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_ApprovalReview" name="Review Employee Access Request">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Actions.HITL" version="v1" />
          <uipath:context>
            <uipath:input name="appId" value="&lt;ACTION_APP_ID&gt;" />
            <uipath:input name="appVersion" value="1" />
            <uipath:input name="actions" value="&lt;ACTION_APP_ACTIONS&gt;" />
            <uipath:input name="key" value="&lt;FOLDER_KEY&gt;" />
            <uipath:input name="taskTitle" value="Review Employee Access Request" />
          </uipath:context>
          <uipath:input name="HitlTaskArguments" type="json" target="bodyField"><![CDATA[{}]]></uipath:input>
          <uipath:output name="Process response" type="Actions.HITL" var="Var_ApprovalResult" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_StartToApproval</bpmn:incoming>
      <bpmn:outgoing>Flow_ApprovalToProvision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_ProvisionAccess" name="Provision Employee Access">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.StartJob" version="v1" />
          <uipath:context>
            <uipath:input name="releaseKey" value="&lt;RPA_PROCESS_RELEASE_KEY&gt;" />
            <uipath:input name="folderId" value="&lt;FOLDER_ID&gt;" />
            <uipath:input name="folderPath" value="&lt;FOLDER_PATH&gt;" />
            <uipath:input name="name" value="&lt;RPA_PROCESS_NAME&gt;" />
          </uipath:context>
          <uipath:input name="JobArguments" type="json" target="bodyField"><![CDATA[{}]]></uipath:input>
          <uipath:output name="Process response" type="Orchestrator.RunJob" var="Var_ProvisioningResult" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ApprovalToProvision</bpmn:incoming>
      <bpmn:outgoing>Flow_ProvisionToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Provisioned" name="Access Provisioned">
      <bpmn:incoming>Flow_ProvisionToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_StartToApproval" sourceRef="Event_start" targetRef="Task_ApprovalReview" />
    <bpmn:sequenceFlow id="Flow_ApprovalToProvision" sourceRef="Task_ApprovalReview" targetRef="Task_ProvisionAccess" />
    <bpmn:sequenceFlow id="Flow_ProvisionToEnd" sourceRef="Task_ProvisionAccess" targetRef="End_Provisioned" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="EmployeeAccessProcess">
      <bpmndi:BPMNShape id="S_End_Provisioned" bpmnElement="End_Provisioned"><dc:Bounds x="576" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Event_start" bpmnElement="Event_start"><dc:Bounds x="160" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_ApprovalReview" bpmnElement="Task_ApprovalReview"><dc:Bounds x="256" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_ProvisionAccess" bpmnElement="Task_ProvisionAccess"><dc:Bounds x="416" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="E_Flow_ApprovalToProvision" bpmnElement="Flow_ApprovalToProvision"><di:waypoint x="306" y="140" /><di:waypoint x="466" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_ProvisionToEnd" bpmnElement="Flow_ProvisionToEnd"><di:waypoint x="466" y="140" /><di:waypoint x="594" y="118" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_StartToApproval" bpmnElement="Flow_StartToApproval"><di:waypoint x="178" y="118" /><di:waypoint x="306" y="140" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
