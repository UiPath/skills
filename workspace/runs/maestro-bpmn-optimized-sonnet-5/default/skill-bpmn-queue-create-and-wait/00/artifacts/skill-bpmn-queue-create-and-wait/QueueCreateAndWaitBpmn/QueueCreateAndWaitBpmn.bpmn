<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:uipath="http://uipath.org/schema/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" exporter="UiPath Maestro (https://uipath.com)" exporterVersion="1.201.0-dev.8275" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_QueueCreateAndWait" name="Maestro Process" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:variables version="v1">
        <uipath:inputOutput id="Var_QueueItemPayload" name="QueueItemPayload" type="object" />
        <uipath:inputOutput id="Var_ItemReference" name="ItemReference" type="string" />
        <uipath:inputOutput id="Var_ProcessedItem" name="ProcessedItem" type="object" />
      </uipath:variables>
      <uipath:bindings version="v1">
        <uipath:binding id="Binding_Queue" resource="queue" propertyAttribute="Key" default="SAMPLE_TRANSACTION_QUEUE" />
      </uipath:bindings>
    </bpmn:extensionElements>
    <bpmn:startEvent id="Event_start" name="core.trigger.manual">
      <bpmn:extensionElements>
        <uipath:entryPointId value="a00d4ba3-2891-4545-9f4f-98c7b1c8d7b8" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_ToCreateAndWait</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_CreateAndWaitQueueItem" name="Create and wait for queue item">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.CreateAndWaitForQueueItem" version="v1" />
          <uipath:context>
            <uipath:input name="queueName" value="SAMPLE_TRANSACTION_QUEUE" />
            <uipath:input name="folderId" value="" />
            <uipath:input name="folderPath" value="" />
          </uipath:context>
          <uipath:input name="ItemData" type="json" target="body"><![CDATA[{"Reference":"=vars.Var_ItemReference","SpecificContent":"=vars.Var_QueueItemPayload"}]]></uipath:input>
          <uipath:output name="response" type="Orchestrator.CreateQueueItem" var="Var_ProcessedItem" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToCreateAndWait</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_end" name="End">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToCreateAndWait" sourceRef="Event_start" targetRef="Task_CreateAndWaitQueueItem" />
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_CreateAndWaitQueueItem" targetRef="Event_end" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_QueueCreateAndWait">
      <bpmndi:BPMNShape id="S_Event_end" bpmnElement="Event_end"><dc:Bounds x="416" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Event_start" bpmnElement="Event_start"><dc:Bounds x="160" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_CreateAndWaitQueueItem" bpmnElement="Task_CreateAndWaitQueueItem"><dc:Bounds x="256" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="E_Flow_ToCreateAndWait" bpmnElement="Flow_ToCreateAndWait"><di:waypoint x="178" y="118" /><di:waypoint x="306" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_ToEnd" bpmnElement="Flow_ToEnd"><di:waypoint x="306" y="140" /><di:waypoint x="434" y="118" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
