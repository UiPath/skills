<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_WikiPageviews" targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="UiPath (https://bpmn.uipath.com)" exporterVersion="1.0">
  <bpmn:process id="Process_WikiPageviews" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:migrationVersion version="11.5" />
      <uipath:variables version="v1">
        <uipath:inputOutput id="Var_Article" name="article" type="string" elementId="Start_Manual" />
        <uipath:inputOutput id="Var_Date1" name="date1" type="string" elementId="Start_Manual" />
        <uipath:inputOutput id="Var_Date2" name="date2" type="string" elementId="Start_Manual" />
        <uipath:inputOutput id="Var_Records" name="records" type="json" />
        <uipath:inputOutput id="Var_Valid" name="valid" type="boolean" />
        <uipath:inputOutput id="Var_FilteredRecords" name="filteredRecords" type="json" />
        <uipath:output id="Var_Total" name="total" type="number" />
        <uipath:output id="Var_Result" name="result" type="string" />
      </uipath:variables>
    </bpmn:extensionElements>

    <bpmn:startEvent id="Start_Manual" name="Start">
      <bpmn:extensionElements>
        <uipath:entryPointId value="a1e2f3b4-5c6d-4e7f-8a9b-0c1d2e3f4a5b" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_StartToFetch</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:scriptTask id="Task_FetchPageviews" name="fetchPageviews" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"article":"=vars.Var_Article","date1":"=vars.Var_Date1","date2":"=vars.Var_Date2"}]]></uipath:input>
          <uipath:output name="records" type="json" var="Var_Records" source="=result.response.records" />
          <uipath:output name="valid" type="boolean" var="Var_Valid" source="=result.response.valid" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_StartToFetch</bpmn:incoming>
      <bpmn:outgoing>Flow_FetchToGateway</bpmn:outgoing>
      <bpmn:script><![CDATA[
if (!article || typeof article !== "string" || article.trim().length === 0) {
  return { response: { records: [], valid: false } };
}

var start = new Date(date1);
var end = new Date(date2);
if (isNaN(start.getTime()) || isNaN(end.getTime()) || start.getTime() > end.getTime()) {
  return { response: { records: [], valid: false } };
}

var seed = 0;
for (var i = 0; i < article.length; i++) {
  seed = (seed * 31 + article.charCodeAt(i)) % 100000;
}

var records = [];
var cursor = new Date(start.getTime());
var dayIndex = 0;
while (cursor.getTime() <= end.getTime()) {
  var pseudo = (seed + dayIndex * 137) % 1000;
  var views = 200 + pseudo;
  var y = cursor.getFullYear();
  var m = ("0" + (cursor.getMonth() + 1)).slice(-2);
  var d = ("0" + cursor.getDate()).slice(-2);
  records.push({ date: y + "-" + m + "-" + d, views: views });
  cursor.setDate(cursor.getDate() + 1);
  dayIndex++;
}

return { response: { records: records, valid: records.length > 0 } };
]]></bpmn:script>
    </bpmn:scriptTask>

    <bpmn:exclusiveGateway id="Gateway_ValidArticle" name="Article valid?" default="Flow_GatewayToFilter">
      <bpmn:incoming>Flow_FetchToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_GatewayToInvalid</bpmn:outgoing>
      <bpmn:outgoing>Flow_GatewayToFilter</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:scriptTask id="Task_FilterHighTraffic" name="filterHighTraffic" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"records":"=vars.Var_Records"}]]></uipath:input>
          <uipath:output name="filteredRecords" type="json" var="Var_FilteredRecords" source="=result.response.filteredRecords" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_GatewayToFilter</bpmn:incoming>
      <bpmn:outgoing>Flow_FilterToAggregate</bpmn:outgoing>
      <bpmn:script><![CDATA[
var filtered = (records || []).filter(function (r) { return r.views > 500; });
return { response: { filteredRecords: filtered } };
]]></bpmn:script>
    </bpmn:scriptTask>

    <bpmn:scriptTask id="Task_AggregateTotal" name="aggregateTotal" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"filteredRecords":"=vars.Var_FilteredRecords"}]]></uipath:input>
          <uipath:output name="total" type="number" var="Var_Total" source="=result.response.total" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_FilterToAggregate</bpmn:incoming>
      <bpmn:outgoing>Flow_AggregateToValidEnd</bpmn:outgoing>
      <bpmn:script><![CDATA[
var total = (filteredRecords || []).reduce(function (sum, r) { return sum + r.views; }, 0);
return { response: { total: total } };
]]></bpmn:script>
    </bpmn:scriptTask>

    <bpmn:endEvent id="End_Invalid" name="Article not found">
      <bpmn:extensionElements>
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.Variables" version="v1" />
          <uipath:output name="result" type="string" var="Var_Result" source="Article not found" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_GatewayToInvalid</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_Valid" name="Total computed">
      <bpmn:incoming>Flow_AggregateToValidEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_StartToFetch" sourceRef="Start_Manual" targetRef="Task_FetchPageviews" />
    <bpmn:sequenceFlow id="Flow_FetchToGateway" sourceRef="Task_FetchPageviews" targetRef="Gateway_ValidArticle" />
    <bpmn:sequenceFlow id="Flow_GatewayToInvalid" sourceRef="Gateway_ValidArticle" targetRef="End_Invalid">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">=vars.Var_Valid == false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_GatewayToFilter" sourceRef="Gateway_ValidArticle" targetRef="Task_FilterHighTraffic" />
    <bpmn:sequenceFlow id="Flow_FilterToAggregate" sourceRef="Task_FilterHighTraffic" targetRef="Task_AggregateTotal" />
    <bpmn:sequenceFlow id="Flow_AggregateToValidEnd" sourceRef="Task_AggregateTotal" targetRef="End_Valid" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_WikiPageviews">
      <bpmndi:BPMNShape id="S_End_Invalid" bpmnElement="End_Invalid"><dc:Bounds x="526" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End_Valid" bpmnElement="End_Valid"><dc:Bounds x="846" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Gateway_ValidArticle" bpmnElement="Gateway_ValidArticle"><dc:Bounds x="416" y="100" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Start_Manual" bpmnElement="Start_Manual"><dc:Bounds x="160" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_AggregateTotal" bpmnElement="Task_AggregateTotal"><dc:Bounds x="686" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_FetchPageviews" bpmnElement="Task_FetchPageviews"><dc:Bounds x="256" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_FilterHighTraffic" bpmnElement="Task_FilterHighTraffic"><dc:Bounds x="526" y="210" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="E_Flow_AggregateToValidEnd" bpmnElement="Flow_AggregateToValidEnd"><di:waypoint x="736" y="140" /><di:waypoint x="864" y="118" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_FetchToGateway" bpmnElement="Flow_FetchToGateway"><di:waypoint x="306" y="140" /><di:waypoint x="441" y="125" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_FilterToAggregate" bpmnElement="Flow_FilterToAggregate"><di:waypoint x="576" y="250" /><di:waypoint x="736" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_GatewayToFilter" bpmnElement="Flow_GatewayToFilter"><di:waypoint x="441" y="125" /><di:waypoint x="576" y="250" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_GatewayToInvalid" bpmnElement="Flow_GatewayToInvalid"><di:waypoint x="441" y="125" /><di:waypoint x="544" y="118" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_StartToFetch" bpmnElement="Flow_StartToFetch"><di:waypoint x="178" y="118" /><di:waypoint x="306" y="140" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
