{
  "id": "6ae6c1d6-5811-4bb0-a548-a4ee55277012",
  "version": "1.9",
  "name": "EscalationJiraTicket",
  "nodes": [
    {
      "id": "classifySeverity",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Classify Severity"
      },
      "inputs": {
        "script": "const tier = $vars.start.output.customerTier;\nconst productionDown = $vars.start.output.productionDown;\nconst workaroundAvailable = $vars.start.output.workaroundAvailable;\n\nlet severity;\nif (tier === \"Enterprise\" && productionDown && !workaroundAvailable) {\n  severity = \"Sev1\";\n} else if (productionDown && workaroundAvailable) {\n  severity = \"Sev2\";\n} else {\n  severity = \"Sev3\";\n}\n\nconst engineeringNeeded = productionDown;\n\nreturn { severity, engineeringNeeded };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {},
      "outputs": {
        "severity": {
          "source": "=js:$vars.classifySeverity.output.severity"
        },
        "caseKey": {
          "source": "=js:$vars.start.output.correlationId"
        },
        "jiraIssueKey": {
          "source": "=js:$vars.createJiraIssue1.output.key"
        }
      }
    },
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "b80153c5-fc3e-4796-a575-3498c3282b7d",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "createJiraIssue1",
      "type": "uipath.connector.uipath-atlassian-jira.create-issue",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Create Jira Issue"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-atlassian-jira",
          "connectionId": "f5273a4d-d492-4bcd-a106-5a20bf89a3ef",
          "connectionResourceId": "f5273a4d-d492-4bcd-a106-5a20bf89a3ef",
          "connectionFolderKey": "5da18ec0-7de1-4e57-aaf1-ddc8a369c199",
          "method": "POST",
          "endpoint": "/curated_create_issue",
          "bodyParameters": {
            "fields.project.key": "CE",
            "fields.issuetype.id": "11457",
            "fields.summary": "=js:`[${$vars.classifySeverity.output.severity}] ${$vars.start.output.correlationId} ${$vars.start.output.subject}`",
            "fields.reporter.id": "712020:b53bf3dc-8817-419e-99e1-5670aeb7ffe6"
          },
          "uiPathActivityTypeId": "f90a75ba-d728-34b6-a84a-fb1f995b784b",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"connectorVersion\":\"1.13.3\",\"customFieldsRequestDetails\":{\"objectActionName\":\"GenerateSchema\",\"parameterValues\":[[\"fields_sub_project_sub_key\",\"CE\"],[\"fields_sub_issuetype_sub_id\",\"11457\"]]},\"instanceParameters\":{\"connectorKey\":\"uipath-atlassian-jira\",\"objectName\":\"curated_create_issue\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"curated_create_issue\",\"operation\":\"create\",\"packageVersion\":\"1.0.0\",\"httpMethod\":\"POST\",\"path\":\"/curated_create_issue\",\"unifiedTypesCompatible\":true,\"savedJitInputFieldId\":\"in_curated_create_issue\"}}"
        }
      }
    }
  ],
