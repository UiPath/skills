      "id": "postInvoiceToSap1",
      "type": "core.action.http.v2",
      "typeVersion": "2.3",
      "display": {
        "label": "Post Invoice Data (HTTP)"
      },
      "inputs": {
        "branches": [],
        "timeout": "PT15M",
        "retryCount": 0,
        "detail": {
          "connector": "uipath-uipath-http",
          "connectionId": "ImplicitConnection",
          "connectionResourceId": null,
          "connectionFolderKey": null,
          "method": "POST",
          "endpoint": "/http-request",
          "bodyParameters": {
            "authentication": "manual",
            "method": "POST",
            "url": "https://sap.example.com/api/invoices",
            "headers": {
              "Content-Type": "application/json"
            },
            "body": "=js:JSON.stringify({ invoiceNumber: ($vars.extractInvoiceFields.output.ExtractionResult.ResultsDocument.Fields.find(f => f.FieldName === \"Invoice Number\")||{}).Values && $vars.extractInvoiceFields.output.ExtractionResult.ResultsDocument.Fields.find(f => f.FieldName === \"Invoice Number\").Values[0], vendor: ($vars.extractInvoiceFields.output.ExtractionResult.ResultsDocument.Fields.find(f => f.FieldName === \"Vendor\")||{}).Values && $vars.extractInvoiceFields.output.ExtractionResult.ResultsDocument.Fields.find(f => f.FieldName === \"Vendor\").Values[0], invoiceDate: ($vars.extractInvoiceFields.output.ExtractionResult.ResultsDocument.Fields.find(f => f.FieldName === \"Invoice Date\")||{}).Values && $vars.extractInvoiceFields.output.ExtractionResult.ResultsDocument.Fields.find(f => f.FieldName === \"Invoice Date\").Values[0], totalAmount: ($vars.extractInvoiceFields.output.ExtractionResult.ResultsDocument.Fields.find(f => f.FieldName === \"Total\")||{}).Values && $vars.extractInvoiceFields.output.ExtractionResult.ResultsDocument.Fields.find(f => f.FieldName === \"Total\").Values[0], lineItems: $vars.extractInvoiceFields.output.ExtractionResult.ResultsDocument.Tables })"
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"connectorVersion\":\"1.4.50\",\"executionType\":null,\"customFieldsRequestDetails\":null,\"instanceParameters\":{\"connectorKey\":\"uipath-uipath-http\",\"objectName\":\"http-request\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\"},\"objectName\":\"http-request\",\"operation\":\"create\",\"packageVersion\":\"1.0.0\",\"httpMethod\":\"POST\",\"path\":\"/http-request\",\"unifiedTypesCompatible\":true,\"savedJitInputFieldId\":\"in_http-request\"}}",
          "uiPathActivityTypeId": "5c4cc855-b42a-37e6-b910-de8588998fce",
          "errorState": {
            "issues": []
          },
          "telemetryData": {
            "connectorKey": "uipath-uipath-http",
            "connectorName": "HTTP",
            "operationType": "create",
            "objectName": "http-request",
            "objectDisplayName": "HTTP Request",
            "primaryKeyName": ""
          }
        }
      }
