    {
      "id": "extractBirthCertificate",
      "type": "uipath.ixp.birth-certificates-oob-6252526a-ixp.a05c7655-1a1c-80a5-94a0-b1609d34dc10-c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Extract Birth Certificate Fields"
      },
      "inputs": {
        "model": {
          "id": "a05c7655-1a1c-80a5-94a0-b1609d34dc10",
          "modelName": "birth_certificates_oob-6252526a-ixp",
          "modelDisplayName": "birth_certificates_oob-6252526a-ixp",
          "folderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "folderName": "Shared",
          "folderPath": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "description": ""
        },
        "modelName": "birth_certificates_oob-6252526a-ixp",
        "description": "",
        "projectName": "birth_certificates_oob-6252526a-ixp",
        "versionTag": "",
        "folderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
        "folderName": "Shared",
        "fileRef": "=js:$vars.start.output.birthCertificateFile",
        "pageRange": ""
      },
      "outputs": {
        "output": {
          "name": "output",
          "type": "object",
          "source": "=this",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "logChildFullName",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Log Child Full Name"
      },
      "inputs": {
        "script": "const doc = $vars.extractBirthCertificate.output.ExtractionResult || {};\nconst fields = (doc.ResultsDocument && doc.ResultsDocument.Fields) || [];\nconst nameCandidates = ['child full name', 'child name', 'full name', 'name of child'];\nconst match = fields.find(f => {\n  const fieldName = (f.FieldName || '').toLowerCase();\n  return nameCandidates.some(c => fieldName.includes(c));\n});\nconst childFullName = (match && match.Values && match.Values[0]) || null;\nreturn { childFullName };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Done"
      },
      "inputs": {}
    }
  ],
  "edges": [
    {
      "id": "e-start-extract",
      "sourceNodeId": "start",
