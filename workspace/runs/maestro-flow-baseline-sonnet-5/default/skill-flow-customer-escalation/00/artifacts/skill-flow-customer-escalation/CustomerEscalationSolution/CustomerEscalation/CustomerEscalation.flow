{
  "id": "b07c6e26-f99e-457d-a635-f6d10e402821",
  "version": "1.9",
  "name": "CustomerEscalation",
  "nodes": [
    {
      "id": "classifyUrgency1",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Classify Urgency"
      },
      "inputs": {
        "script": "const keywords = ['urgent', 'asap', 'critical', 'down', 'escalate', 'immediately', 'emergency', 'outage', 'sev1', 'high priority'];\nconst subject = ($vars.newEmailReceived1.output.subject || '').toLowerCase();\nconst bodyPreview = ($vars.newEmailReceived1.output.bodyPreview || '').toLowerCase();\nconst text = subject + ' ' + bodyPreview;\nconst matchedKeywords = keywords.filter(k => text.includes(k));\nconst importance = $vars.newEmailReceived1.output.importance;\nconst isUrgent = matchedKeywords.length > 0 || importance === 'high';\nreturn { isUrgent, matchedKeywords };"
      }
    },
    {
      "id": "classifyVip1",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Classify VIP Sender"
      },
      "inputs": {
        "script": "const vipDomains = ['acme.com', 'globex.com', 'initech.com'];\nconst vipEmails = ['ceo@keyclient.com', 'cto@keyclient.com'];\nconst senderEmail = ($vars.newEmailReceived1.output.from.emailAddress.address || '').toLowerCase();\nconst senderDomain = senderEmail.split('@')[1] || '';\nconst isVip = vipEmails.includes(senderEmail) || vipDomains.includes(senderDomain);\nconst reason = isVip\n  ? (vipEmails.includes(senderEmail) ? `VIP contact (${senderEmail})` : `VIP domain (${senderDomain})`)\n  : 'Not on VIP list';\nreturn { isVip, reason, senderEmail, senderDomain };"
      }
    },
    {
      "id": "decision1",
      "type": "core.logic.decision",
      "typeVersion": "1.2",
      "display": {
        "label": "Urgent AND VIP?"
      },
      "inputs": {
        "expression": "$vars.classifyUrgency1.output.isUrgent === true && $vars.classifyVip1.output.isVip === true",
        "trueLabel": "High-touch",
        "falseLabel": "Standard"
      }
    },
    {
      "id": "generateTicket1",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Generate Support Ticket"
      },
      "inputs": {
        "script": "const subject = $vars.newEmailReceived1.output.subject || '(no subject)';\nconst senderEmail = $vars.newEmailReceived1.output.from.emailAddress.address || 'unknown';\nconst receivedDateTime = $vars.newEmailReceived1.output.receivedDateTime;\nconst isUrgent = $vars.classifyUrgency1.output.isUrgent;\nconst ticketId = `TCK-${$metadata.instanceId}`;\nconst priority = isUrgent ? 'High' : 'Normal';\nconst category = 'General Support';\nreturn { ticketId, category, priority, createdAt: receivedDateTime, subject, senderEmail };"
      }
    },
    {
      "id": "endHighTouch1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End - High Touch"
      }
    },
    {
      "id": "endStandard1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End - Standard"
      }
    },
    {
      "id": "newEmailReceived1",
