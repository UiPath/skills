{
  "id": "e32cae1c-556b-4e69-974d-87c3f82c2751",
  "version": "1.9",
  "name": "BellevueWeather",
  "nodes": [
    {
      "id": "formatSummary",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Format Weather Summary"
      },
      "inputs": {
        "script": "const body = $vars.getBellevueWeather1.output.body;\nconst temperature = body.current.temperature_2m;\nconst time = body.current.time;\nconst summary = `Bellevue weather as of ${time}: ${temperature}°F`;\nreturn { temperature: temperature, summary: summary, time: time };"
      },
      "outputs": {
        "output": {
          "type": "any",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "decideTemperature",
      "type": "core.logic.decision",
      "typeVersion": "1.2",
      "display": {
        "label": "Is it warmer than 60F?"
      },
      "inputs": {
        "expression": "$vars.formatSummary.output.temperature > 60",
        "trueLabel": "Warm",
        "falseLabel": "Cool"
      }
    },
    {
      "id": "endNiceDay",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Nice Day"
      },
      "inputs": {},
      "outputs": {
        "result": {
          "source": "=js:({ message: 'nice day', summary: $vars.formatSummary.output.summary, temperature: $vars.formatSummary.output.temperature })"
        }
      }
    },
    {
      "id": "endBringJacket",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Bring a Jacket"
      },
      "inputs": {},
      "outputs": {
        "result": {
          "source": "=js:({ message: 'bring a jacket', summary: $vars.formatSummary.output.summary, temperature: $vars.formatSummary.output.temperature })"
        }
      }
    },
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "69a0b2d7-83ba-4b02-ba1f-2a2d30242ac8",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "getBellevueWeather1",
      "type": "core.action.http.v2",
      "typeVersion": "2.3",
      "display": {
        "label": "Get Bellevue Weather"
      },
      "inputs": {
        "branches": [],
        "timeout": "PT15M",
        "retryCount": 0,
        "detail": {
          "connector": "uipath-uipath-http",
          "connectionId": "ImplicitConnection",
          "connectionResourceId": null,
          "connectionFolderKey": null,
          "method": "POST",
          "endpoint": "/http-request",
          "bodyParameters": {
            "authentication": "manual",
            "method": "GET",
            "url": "https://api.open-meteo.com/v1/forecast",
            "query": {
              "latitude": "47.6101",
              "longitude": "-122.2015",
              "current": "temperature_2m",
              "temperature_unit": "fahrenheit",
              "timezone": "America/Los_Angeles"
            }
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"connectorVersion\":\"1.4.50\",\"executionType\":null,\"customFieldsRequestDetails\":null,\"instanceParameters\":{\"connectorKey\":\"uipath-uipath-http\",\"objectName\":\"http-request\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\"},\"objectName\":\"http-request\",\"operation\":\"create\",\"packageVersion\":\"1.0.0\",\"httpMethod\":\"POST\",\"path\":\"/http-request\",\"unifiedTypesCompatible\":true,\"savedJitInputFieldId\":\"in_http-request\"}}",
          "uiPathActivityTypeId": "5c4cc855-b42a-37e6-b910-de8588998fce",
          "errorState": {
            "issues": []
          },
          "telemetryData": {
            "connectorKey": "uipath-uipath-http",
            "connectorName": "HTTP",
            "operationType": "create",
            "objectName": "http-request",
            "objectDisplayName": "HTTP Request",
            "primaryKeyName": ""
          }
        }
      }
    }
  ],
  "edges": [
    {
      "id": "e-start-getBellevueWeather1",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "getBellevueWeather1",
      "targetPort": "input"
    },
