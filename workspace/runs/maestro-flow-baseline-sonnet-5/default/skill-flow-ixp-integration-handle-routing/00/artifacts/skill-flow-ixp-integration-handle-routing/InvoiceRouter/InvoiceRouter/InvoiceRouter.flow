{
  "id": "1bda9ffd-a61a-44ed-b5cf-e5784c69d665",
  "version": "1.9",
  "name": "InvoiceRouter",
  "nodes": [
    {
      "id": "extractInvoiceFields",
      "type": "uipath.ixp.invoiceixp-cef0d447-ixp.ff973488-5d89-8035-86ac-f980b4be6deb-c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Extract Invoice Fields"
      },
      "inputs": {
        "model": {
          "id": "ff973488-5d89-8035-86ac-f980b4be6deb",
          "modelName": "invoiceixp-cef0d447-ixp",
          "modelDisplayName": "InvoiceIXP",
          "folderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "folderName": "Shared",
          "folderPath": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "description": ""
        },
        "modelName": "invoiceixp-cef0d447-ixp",
        "description": "",
        "projectName": "invoiceixp-cef0d447-ixp",
        "versionTag": "",
        "folderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
        "folderName": "Shared",
        "fileRef": "=js:$vars.start.output.vendorInvoice",
        "pageRange": ""
      },
      "outputs": {
        "output": {
          "name": "output",
          "type": "object",
          "source": "=this",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "checkTotalAmount",
      "type": "core.logic.decision",
      "typeVersion": "1.2",
      "display": {
        "label": "Total Amount > 1000?"
      },
      "inputs": {
        "expression": "Number($vars.extractInvoiceFields.output.ExtractionResult.ResultsDocument.Fields.find(f => f.FieldName === 'Total Amount')?.Values?.[0]) > 1000",
        "trueLabel": "High Value",
        "falseLabel": "Auto Approve"
      }
    },
    {
      "id": "highValueReview",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "HighValueReview"
      },
      "inputs": {
        "script": "const vendor = $vars.extractInvoiceFields.output.ExtractionResult.ResultsDocument.Fields.find(f => f.FieldName === 'Vendor Name')?.Values?.[0];\nconst total = $vars.extractInvoiceFields.output.ExtractionResult.ResultsDocument.Fields.find(f => f.FieldName === 'Total Amount')?.Values?.[0];\nreturn { summary: `High-value invoice from ${vendor} for ${total} routed to manual review.` };"
      }
    },
    {
      "id": "autoApprove",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "AutoApprove"
      },
      "inputs": {
        "script": "const vendor = $vars.extractInvoiceFields.output.ExtractionResult.ResultsDocument.Fields.find(f => f.FieldName === 'Vendor Name')?.Values?.[0];\nconst total = $vars.extractInvoiceFields.output.ExtractionResult.ResultsDocument.Fields.find(f => f.FieldName === 'Total Amount')?.Values?.[0];\nreturn { summary: `Invoice from ${vendor} for ${total} auto-approved.` };"
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {}
    },
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "12bd8df8-4ecd-40c2-99d0-0672029682c9",
        "isDefaultEntryPoint": true
      }
    }
  ],
  "edges": [
    {
      "id": "edge_start_output_extractInvoiceFields_input",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "extractInvoiceFields",
      "targetPort": "input"
    },
    {
      "id": "edge_extractInvoiceFields_success_checkTotalAmount_input",
      "sourceNodeId": "extractInvoiceFields",
      "sourcePort": "success",
      "targetNodeId": "checkTotalAmount",
      "targetPort": "input"
    },
    {
      "id": "edge_checkTotalAmount_true_highValueReview_input",
