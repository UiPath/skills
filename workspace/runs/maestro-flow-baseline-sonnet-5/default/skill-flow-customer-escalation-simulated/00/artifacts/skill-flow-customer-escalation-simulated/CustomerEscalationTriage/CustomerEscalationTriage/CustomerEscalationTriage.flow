          "connectionFolderKey": "def71452-bad1-40fa-be08-da175e89bd1a",
          "method": "POST",
          "endpoint": "/ReplyToEmailV2",
          "bodyParameters": {
            "comment": "=js:`Hello,<br><br>Thank you for contacting us. We've opened a support ticket for your request (Ticket ID: ${$vars.createZendeskTicket1.output.ticket.id}). Our team will follow up with you shortly.<br><br>Best regards,<br>Customer Support Team`"
