    {
      "id": "emailReceived1",
      "type": "uipath.connector.trigger.uipath-microsoft-outlook365.email-received",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Email Received"
      },
      "inputs": {
        "entryPointId": "22ead707-5b51-4dcb-b031-a8471c63a646",
        "isDefaultEntryPoint": true,
        "detail": {
          "connector": "uipath-microsoft-outlook365",
          "connectionId": "dd657127-91f5-4568-a3a3-c024bc03fb0f",
          "connectionResourceId": "dd657127-91f5-4568-a3a3-c024bc03fb0f",
          "connectionFolderKey": "def71452-bad1-40fa-be08-da175e89bd1a",
          "eventParameters": {
            "parentFolderId": "AAMkAGNiNDVjZmJmLTczOTEtNDQ2MS04Njc2LTUwM2I3ZDgxOWQwMAAuAAAAAAAJJRkzOJfsTKZfQqhMUHzlAQAJDKUrZhoLQZ5wELpOfJPCAAAAAAEMAAA="
          },
          "objectName": "Message",
          "eventType": "EMAIL_RECEIVED",
          "eventMode": "polling",
          "filterExpression": "",
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"connectorVersion\":\"1.42.6\",\"executionType\":null,\"customFieldsRequestDetails\":null,\"instanceParameters\":{\"connectorKey\":\"uipath-microsoft-outlook365\",\"objectName\":\"Message\",\"activityType\":\"CuratedTrigger\",\"version\":\"1.0.0\",\"eventOperation\":\"EMAIL_RECEIVED\",\"eventMode\":\"polling\",\"supportsStreaming\":false},\"objectName\":\"Message\",\"packageVersion\":\"1.0.0\",\"httpMethod\":null,\"path\":null,\"filter\":null}}",
          "uiPathActivityTypeId": "d76ca053-6e7e-3472-b98c-3094b802d83c",
          "errorState": {
            "issues": []
          }
        }
      }
    },
    {
      "id": "triageEmail1",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Triage Email"
      },
      "inputs": {
        "script": "const email = $vars.emailReceived1.output;\nconst subject = (email.subject || \"\").toLowerCase();\nconst bodyText = (email.body && email.body.content ? email.body.content : \"\").toLowerCase();\nconst senderEmail = (email.from && email.from.emailAddress && email.from.emailAddress.address ? email.from.emailAddress.address : \"\").toLowerCase();\n\nconst urgentKeywords = [\"urgent\", \"asap\", \"critical\", \"down\", \"immediately\", \"emergency\"];\nconst isUrgent = urgentKeywords.some(k => subject.includes(k) || bodyText.includes(k));\n\n// EDIT ME: placeholder VIP allow-list. Add exact VIP email addresses and/or VIP domains here.\nconst vipAddresses = [\"ceo@example.com\"];\nconst vipDomains = [\"acmecorp.com\"];\n\nconst isVip = vipAddresses.includes(senderEmail) || vipDomains.some(d => senderEmail.endsWith(\"@\" + d));\n\nreturn {\n  isUrgent,\n  isVip,\n  isUrgentAndVip: isUrgent && isVip,\n  senderEmail,\n  subject: email.subject || \"\",\n  bodySnippet: (email.bodyPreview || \"\").substring(0, 200)\n};"
      }
    },
    {
      "id": "urgentAndVip1",
      "type": "core.logic.decision",
      "typeVersion": "1.2",
      "display": {
        "label": "Urgent and VIP"
      },
      "inputs": {
        "trueLabel": "True",
        "falseLabel": "False",
        "expression": "$vars.triageEmail1.output.isUrgentAndVip === true"
      }
    },
    {
      "id": "postSlackAlert1",
      "type": "uipath.connector.uipath-salesforce-slack.send-message-to-channel",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Post Slack Alert"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-salesforce-slack",
          "connectionId": "e03f734e-0f80-4e8a-a7c1-0ece309b0ca4",
          "connectionResourceId": "e03f734e-0f80-4e8a-a7c1-0ece309b0ca4",
          "connectionFolderKey": "def71452-bad1-40fa-be08-da175e89bd1a",
          "method": "POST",
          "endpoint": "/send_message_to_channel_v2",
          "bodyParameters": {
            "channel": "C0BKEH221V3",
            "messageToSend": "=js:`:rotating_light: *Urgent VIP Escalation*\\n*From:* ${$vars.triageEmail1.output.senderEmail}\\n*Subject:* ${$vars.triageEmail1.output.subject}\\n*Preview:* ${$vars.triageEmail1.output.bodySnippet}`"
          },
          "queryParameters": {
            "send_as": "bot"
          },
          "uiPathActivityTypeId": "37a305b2-89b1-315d-b73f-1778839a6c47",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"connectorVersion\":\"2.14.8\",\"customFieldsRequestDetails\":null,\"instanceParameters\":{\"connectorKey\":\"uipath-salesforce-slack\",\"objectName\":\"send_message_to_channel_v2\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"send_message_to_channel_v2\",\"operation\":\"create\",\"packageVersion\":\"1.0.0\",\"httpMethod\":\"POST\",\"path\":\"/send_message_to_channel_v2\",\"unifiedTypesCompatible\":true,\"savedJitInputFieldId\":\"in_send_message_to_channel_v2\"}}"
        }
      }
    },
    {
      "id": "sendVipAcknowledgment1",
      "type": "uipath.connector.uipath-microsoft-outlook365.reply-to-email",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Send VIP Acknowledgment"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-microsoft-outlook365",
          "connectionId": "dd657127-91f5-4568-a3a3-c024bc03fb0f",
          "connectionResourceId": "dd657127-91f5-4568-a3a3-c024bc03fb0f",
          "connectionFolderKey": "def71452-bad1-40fa-be08-da175e89bd1a",
          "method": "POST",
          "endpoint": "/ReplyToEmailV2",
          "bodyParameters": {
            "comment": "=js:`Hello,<br><br>Thank you for reaching out. We've received your message and, given its priority, our team has already been notified and is treating this as a top priority. You can expect a follow-up shortly.<br><br>Best regards,<br>Customer Support Team`"
          },
          "queryParameters": {
            "id": "=js:$vars.emailReceived1.output.id",
            "replyToAll": false,
            "saveAsDraft": false
          },
          "uiPathActivityTypeId": "da9976dd-3d71-35b4-bb8c-509419cb46eb",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"connectorVersion\":\"1.42.6\",\"customFieldsRequestDetails\":null,\"instanceParameters\":{\"connectorKey\":\"uipath-microsoft-outlook365\",\"objectName\":\"ReplyToEmailV2\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"ReplyToEmailV2\",\"operation\":\"create\",\"packageVersion\":\"1.0.0\",\"httpMethod\":\"POST\",\"path\":\"/ReplyToEmailV2\",\"unifiedTypesCompatible\":true,\"savedJitInputFieldId\":\"in_ReplyToEmailV2\"}}",
          "multipartParameters": [
            {
              "name": "file",
              "dataType": "file"
            },
            {
              "name": "body",
              "dataType": "string"
            }
          ],
          "inputMetadata": {
            "type": "multipart",
            "multipart": {
              "bodyFieldName": "body"
            }
          }
        }
      }
    },
