{
  "id": "fb05ccec-a8e8-4fe3-bcf1-d0588b7ac4d1",
  "version": "1.9",
  "name": "SeasonLookup",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "215b2e53-61fd-41ab-a071-6095e7027288",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "switchQuarter",
      "type": "core.logic.switch",
      "typeVersion": "1.1",
      "display": {
        "label": "Switch on Quarter"
      },
      "inputs": {
        "cases": [
          {
            "id": "q1",
            "label": "Quarter 1",
            "expression": "$vars.start.output.quarter === 1"
          },
          {
            "id": "q2",
            "label": "Quarter 2",
            "expression": "$vars.start.output.quarter === 2"
          },
          {
            "id": "q3",
            "label": "Quarter 3",
            "expression": "$vars.start.output.quarter === 3"
          },
          {
            "id": "q4",
            "label": "Quarter 4",
            "expression": "$vars.start.output.quarter === 4"
          }
        ]
      }
    },
    {
      "id": "endSpring",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Spring"
      },
      "inputs": {},
      "outputs": {
        "season": {
          "source": "=js:\"Spring\""
        }
      }
    },
    {
      "id": "endSummer",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Summer"
      },
      "inputs": {},
      "outputs": {
        "season": {
          "source": "=js:\"Summer\""
        }
      }
    },
    {
      "id": "endFall",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Fall"
      },
      "inputs": {},
      "outputs": {
        "season": {
          "source": "=js:\"Fall\""
        }
      }
    },
    {
      "id": "endWinter",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Winter"
      },
      "inputs": {},
      "outputs": {
        "season": {
          "source": "=js:\"Winter\""
        }
      }
    },
    {
      "id": "endInvalid",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Invalid Quarter"
      },
      "inputs": {},
      "outputs": {
        "season": {
          "source": "=js:\"Unknown\""
        }
      }
    }
  ],
  "edges": [
    {
      "id": "eStartSwitch",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "switchQuarter",
      "targetPort": "input"
    },
    {
      "id": "eSwitchQ1",
      "sourceNodeId": "switchQuarter",
      "sourcePort": "case-q1",
      "targetNodeId": "endSpring",
      "targetPort": "input"
    },
    {
      "id": "eSwitchQ2",
      "sourceNodeId": "switchQuarter",
      "sourcePort": "case-q2",
      "targetNodeId": "endSummer",
      "targetPort": "input"
    },
    {
      "id": "eSwitchQ3",
      "sourceNodeId": "switchQuarter",
      "sourcePort": "case-q3",
      "targetNodeId": "endFall",
      "targetPort": "input"
    },
    {
      "id": "eSwitchQ4",
      "sourceNodeId": "switchQuarter",
      "sourcePort": "case-q4",
      "targetNodeId": "endWinter",
      "targetPort": "input"
    },
    {
      "id": "eSwitchDefault",
      "sourceNodeId": "switchQuarter",
      "sourcePort": "default",
      "targetNodeId": "endInvalid",
      "targetPort": "input"
    }
  ],
  "definitions": [
    {
      "nodeType": "core.trigger.manual",
      "version": "1.0",
      "category": "trigger",
      "description": "Start the process manually",
      "tags": [
        "trigger",
        "start",
        "manual"
      ],
      "sortOrder": 80,
      "display": {
        "label": "Manual trigger",
        "icon": "play",
        "shape": "circle"
      },
      "handleConfiguration": [
        {
          "position": "right",
          "handles": [
            {
              "id": "output",
              "type": "source",
              "handleType": "output",
              "showButton": true,
              "constraints": {
                "forbiddenTargetCategories": [
                  "trigger"
                ]
              }
            }
          ],
          "visible": true
        }
      ],
      "model": {
        "type": "bpmn:StartEvent",
        "entryPointId": true
      },
      "outputDefinition": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the process.",
          "source": "null",
          "var": "output"
        }
      },
      "toolbarExtensions": {
        "design": {
          "actions": [
            {
              "id": "change-trigger-type",
              "icon": "square-mouse-pointer",
              "label": "Change trigger type"
            }
          ]
        }
      }
    },
    {
      "nodeType": "core.logic.switch",
      "version": "1.1",
      "category": "control-flow",
      "description": "Route to one of many branches by condition",
      "tags": [
        "control-flow",
        "switch",
        "case",
        "when"
      ],
      "sortOrder": 62,
      "display": {
        "label": "Switch",
        "icon": "between-horizontal-start"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ],
          "visible": true
        },
        {
          "position": "right",
          "handles": [
            {
              "id": "case-{item.id}",
              "type": "source",
              "handleType": "output",
              "label": "{item.label || 'Case ' + (index + 1)}",
              "repeat": "inputs.cases"
            },
            {
              "id": "default",
              "type": "source",
              "handleType": "output",
              "label": "Default"
            }
          ],
          "visible": true
        }
      ],
      "debug": {
        "runtime": "clientScript"
      },
      "model": {
        "type": "bpmn:ExclusiveGateway"
      },
      "inputDefinition": {
        "type": "object",
        "properties": {
          "cases": {
            "type": "array",
            "minItems": 1,
            "errorMessage": "At least one case is required",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "expression": {
                  "type": "string",
                  "minLength": 1,
                  "errorMessage": "Add a condition"
                }
              },
              "required": [
                "expression"
              ]
            }
          }
        },
        "required": [
          "cases"
        ]
      },
      "outputDefinition": {
        "matchedCase": {
          "type": "string",
          "description": "The label of the matched case",
          "var": "matchedCase"
        },
        "matchedCaseId": {
          "type": "string",
          "description": "The ID of the matched case (\"default\" for the default branch)",
          "var": "matchedCaseId"
        }
      },
      "inputDefaults": {
        "cases": [
          {
            "id": "default-1",
            "label": "Case 1",
            "expression": ""
          },
          {
            "id": "default-2",
            "label": "Case 2",
            "expression": ""
          }
        ]
      },
      "form": {
        "id": "switch-properties",
        "title": "Switch configuration",
        "sections": [
          {
            "id": "cases",
            "title": "Cases",
            "description": "Each case is evaluated in order. The first condition that returns true is taken.",
            "collapsible": true,
            "defaultExpanded": true,
            "fields": [
              {
                "name": "inputs.cases",
                "type": "custom",
                "label": "Switch cases",
                "component": "case-list-editor",
                "componentProps": {
                  "minCases": 1,
                  "maxCases": 10,
                  "expressionPlaceholder": "$vars.httpRequest1.output.statusCode >= 200 && $vars.httpRequest1.output.statusCode < 300",
                  "expressionValidationFields": [
                    {
                      "subPath": "expression",
                      "validationMode": "expression",
                      "expectedType": "boolean"
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "runtimeConstraints": {
        "exclude": [
          "api-function"
        ]
      }
    },
    {
      "nodeType": "core.control.end",
      "version": "1.0",
      "category": "control-flow",
      "description": "Mark the end of a process path",
      "tags": [
        "control-flow",
        "end",
        "finish",
        "complete"
      ],
      "sortOrder": 65,
      "display": {
        "label": "End",
        "icon": "circle-check",
        "shape": "circle"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ]
        }
      ],
      "model": {
        "type": "bpmn:EndEvent"
      },
      "runtimeConstraints": {
        "exclude": [
          "api-function"
        ]
      }
    }
  ],
  "bindings": [],
  "variables": {
    "globals": [
      {
        "id": "quarter",
        "direction": "in",
        "type": "number",
        "triggerNodeId": "start",
        "description": "Quarter number (1, 2, 3, or 4)"
      },
      {
        "id": "season",
        "direction": "out",
        "type": "string",
        "description": "Season name corresponding to the given quarter"
      }
    ],
    "nodes": [
      {
        "id": "start.output",
        "type": "object",
        "description": "Data passed when manually triggering the process.",
        "binding": {
          "nodeId": "start",
          "outputId": "output"
        }
      },
      {
        "id": "switchQuarter.matchedCase",
        "type": "string",
        "description": "The label of the matched case",
        "binding": {
          "nodeId": "switchQuarter",
          "outputId": "matchedCase"
        }
      },
      {
        "id": "switchQuarter.matchedCaseId",
        "type": "string",
        "description": "The ID of the matched case (\"default\" for the default branch)",
        "binding": {
          "nodeId": "switchQuarter",
          "outputId": "matchedCaseId"
        }
      },
      {
        "id": "endSpring.season",
        "type": "string",
        "binding": {
          "nodeId": "endSpring",
          "outputId": "season"
        }
      },
      {
        "id": "endSummer.season",
        "type": "string",
        "binding": {
          "nodeId": "endSummer",
          "outputId": "season"
        }
      },
      {
        "id": "endFall.season",
        "type": "string",
        "binding": {
          "nodeId": "endFall",
          "outputId": "season"
        }
      },
      {
        "id": "endWinter.season",
        "type": "string",
        "binding": {
          "nodeId": "endWinter",
          "outputId": "season"
        }
      },
      {
        "id": "endInvalid.season",
        "type": "string",
        "binding": {
          "nodeId": "endInvalid",
          "outputId": "season"
        }
      }
    ],
    "variableUpdates": {}
  },
  "runtime": "maestro",
