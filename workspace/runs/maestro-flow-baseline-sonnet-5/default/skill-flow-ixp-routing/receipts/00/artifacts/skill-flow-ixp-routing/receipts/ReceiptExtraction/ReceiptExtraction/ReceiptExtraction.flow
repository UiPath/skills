{
  "id": "e24bed4a-ae50-43cd-afb1-f38c82e8e124",
  "version": "1.9",
  "name": "ReceiptExtraction",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "86d5527b-c868-48ad-8b0f-7c8d7ed17135",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "readReceiptImagesMock",
      "type": "core.logic.mock",
      "typeVersion": "1.0",
      "display": {
        "label": "Read Receipt Images From Folder (mock — folder/file connector not configured)"
      }
    },
    {
      "id": "receiptLoop",
      "type": "core.logic.loop",
      "typeVersion": "2.4",
      "display": {
        "label": "For Each Receipt Image"
      },
      "inputs": {
        "collection": "=js:$vars.readReceiptImagesMock.output",
        "parallel": false,
        "completionCondition": "",
        "breakEnabled": false
      },
      "outputs": {
        "output": {
          "type": "array",
          "description": "Aggregated results from all loop iterations",
          "source": "=loopContext.output",
          "var": "output"
        }
      }
    },
    {
      "id": "extractReceiptFields",
      "type": "uipath.ixp.idp-benchmark-receipts-43af6412-ixp.9e77f71d-773c-80a0-9411-ec40d252d00d-c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Extract Merchant, Date, Total From Receipt"
      },
      "inputs": {
        "model": {
          "id": "9e77f71d-773c-80a0-9411-ec40d252d00d",
          "modelName": "idp-benchmark---receipts-43af6412-ixp",
          "modelDisplayName": "idp-benchmark---receipts-43af6412-ixp",
          "folderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "folderName": "Shared",
          "folderPath": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "description": ""
        },
        "modelName": "idp-benchmark---receipts-43af6412-ixp",
        "description": "",
        "projectName": "idp-benchmark---receipts-43af6412-ixp",
        "versionTag": "",
        "folderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
        "folderName": "Shared",
        "fileRef": "=js:$vars.receiptLoop.currentItem",
        "pageRange": ""
      },
      "outputs": {
        "output": {
          "name": "output",
          "type": "object",
          "source": "=this",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "parseReceiptFields",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Pull Merchant, Date, Total From Extraction Result"
      },
      "inputs": {
        "script": "const fields = ($vars.extractReceiptFields.output && $vars.extractReceiptFields.output.ExtractionResult && $vars.extractReceiptFields.output.ExtractionResult.ResultsDocument && $vars.extractReceiptFields.output.ExtractionResult.ResultsDocument.Fields) || [];\nconst merchant = fields.find(f => f.FieldName === 'Merchant')?.Values?.[0]?.Value;\nconst date = fields.find(f => f.FieldName === 'Date')?.Values?.[0]?.Value;\nconst total = fields.find(f => f.FieldName === 'Total')?.Values?.[0]?.Value;\nreturn { merchant, date, total };"
      },
      "outputs": {
        "output": {
          "type": "any",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      }
    }
  ],
  "edges": [
