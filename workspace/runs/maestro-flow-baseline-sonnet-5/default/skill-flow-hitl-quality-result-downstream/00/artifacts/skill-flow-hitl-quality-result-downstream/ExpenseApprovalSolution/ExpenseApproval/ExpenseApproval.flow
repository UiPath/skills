      "sourceNodeId": "expenseReview1",
      "sourcePort": "completed",
      "targetNodeId": "logDecision1",
      "targetPort": "input"
    },
    {
      "id": "edge_logDecision1_success_end1_input",
      "sourceNodeId": "logDecision1",
      "sourcePort": "success",
      "targetNodeId": "end1",
      "targetPort": "input"
    }
  ],
  "definitions": [
