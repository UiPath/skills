{
  "id": "a7b9b7b1-8979-46c6-a9b6-f24766c6c34c",
  "version": "1.9",
  "name": "ExpenseApproval",
  "variables": {
    "globals": [
      {
        "id": "expenseAmount",
        "direction": "in",
        "type": "number",
        "triggerNodeId": "start",
        "description": "Expense amount to review"
      },
      {
        "id": "requesterName",
        "direction": "in",
        "type": "string",
        "triggerNodeId": "start",
        "description": "Name of the person who submitted the expense"
      },
      {
        "id": "category",
        "direction": "in",
        "type": "string",
        "triggerNodeId": "start",
        "description": "Expense category"
      }
    ],
    "nodes": [
      {
        "id": "start.output",
        "type": "object",
        "description": "Data passed when manually triggering the process.",
        "binding": {
          "nodeId": "start",
          "outputId": "output"
        }
      },
      {
        "id": "expenseReview1.output",
        "type": "object",
        "description": "Task result data",
        "binding": {
          "nodeId": "expenseReview1",
          "outputId": "output"
        }
      },
      {
        "id": "expenseReview1.status",
        "type": "string",
        "description": "Task completion status",
        "binding": {
          "nodeId": "expenseReview1",
          "outputId": "status"
        }
      },
      {
        "id": "logDecision1.output",
        "type": "any",
        "description": "The return value of the script",
        "binding": {
          "nodeId": "logDecision1",
          "outputId": "output"
        }
      },
      {
        "id": "logDecision1.error",
        "type": "object",
        "description": "Error information if the node fails",
        "binding": {
          "nodeId": "logDecision1",
          "outputId": "error"
        }
      }
    ],
    "variableUpdates": {}
  },
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "1bc95010-604a-4f5a-94fa-d3f9dd123f14",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "expenseReview1",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "Expense Review"
      },
      "inputs": {
        "title": "Expense Review",
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group"
          }
        },
        "priority": "Low",
        "schema": {
          "schemaId": "2e2a0d64-b6ca-4daa-96ca-d40d90f33060",
          "fields": [
            {
              "id": "expenseamount",
              "label": "Expense Amount",
              "type": "number",
              "direction": "input",
              "binding": "vars.start.output.expenseAmount"
            },
            {
              "id": "requestername",
              "label": "Requester Name",
              "type": "string",
              "direction": "input",
              "binding": "vars.start.output.requesterName"
            },
            {
              "id": "category",
              "label": "Category",
              "type": "string",
              "direction": "input",
              "binding": "vars.start.output.category"
            },
            {
              "id": "approved",
              "label": "Approved",
              "type": "boolean",
              "direction": "output",
              "variable": "vars.approved",
              "required": true
            },
            {
              "id": "comments",
              "label": "Comments",
              "type": "string",
              "direction": "output",
              "variable": "vars.comments",
              "required": false
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "Continue"
            }
          ]
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "approved": {
              "type": "boolean"
            },
            "comments": {
              "type": "string"
            },
            "Action": {
              "type": "string",
              "enum": [
                "Approve",
                "Reject"
              ],
              "default": "Approve"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": [
            "Approve",
            "Reject"
          ],
          "default": "Approve"
        }
      }
    },
    {
      "id": "logDecision1",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Log Decision"
      },
      "inputs": {
        "script": "const approved = $vars.expenseReview1.output.approved;\nconst comments = $vars.expenseReview1.output.comments;\nreturn { log: `Decision: ${approved}, Comments: ${comments}` };"
      },
      "outputs": {
        "output": {
          "type": "any",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "end1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {},
      "outputs": {}
    }
  ],
  "edges": [
    {
      "id": "edge_start_output_expenseReview1_input",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "expenseReview1",
      "targetPort": "input"
    },
    {
