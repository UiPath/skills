{
  "id": "0115286e-7cbd-484a-8c1e-8ad1abc1b21c",
  "version": "1.9",
  "name": "ExpenseApproval",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "77c54026-b3b4-451a-b776-99f34beb9a1c",
        "isDefaultEntryPoint": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the process.",
          "source": "null",
          "var": "output"
        }
      }
    },
    {
      "id": "getExpenseDetails1",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Get Expense Details"
      },
      "inputs": {
        "script": "const categories = [\"Travel\", \"Equipment\", \"Meals\", \"Software\", \"Office Supplies\"];\nconst category = categories[Math.floor(Math.random() * categories.length)];\nconst amount = Math.round((Math.random() * 2000 + 50) * 100) / 100;\nconst expenseId = \"EXP-\" + Math.floor(100000 + Math.random() * 900000);\nconst submitterName = \"Jordan Lee\";\nreturn { expenseId, amount, submitterName, category };"
      },
      "outputs": {
        "output": {
          "type": "any",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "managerReview1",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "Manager Review"
      },
      "inputs": {
        "title": "Expense Approval - Manager Review",
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group",
            "value": "expense-approvers"
          }
        },
        "priority": "Medium",
        "schema": {
          "schemaId": "b95ef44e-ea38-4448-a9fc-e8b4f06ab486",
          "fields": [
            {
              "id": "expenseid",
              "label": "Expense ID",
              "type": "string",
              "direction": "input",
              "binding": "vars.getExpenseDetails1.output.expenseId"
            },
            {
              "id": "submittername",
              "label": "Submitter",
              "type": "string",
              "direction": "input",
              "binding": "vars.getExpenseDetails1.output.submitterName"
            },
            {
              "id": "amount",
              "label": "Amount",
              "type": "number",
              "direction": "input",
              "binding": "vars.getExpenseDetails1.output.amount"
            },
            {
              "id": "category",
              "label": "Category",
              "type": "string",
              "direction": "input",
              "binding": "vars.getExpenseDetails1.output.category"
            },
            {
              "id": "rejectionreason",
              "label": "Rejection Reason",
              "type": "string",
              "direction": "output",
              "variable": "vars.rejectionReason",
              "required": false
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "End"
            }
          ]
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "rejectionreason": {
              "type": "string"
            },
            "Action": {
              "type": "string",
              "enum": [
                "Approve",
                "Reject"
              ],
              "default": "Approve"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": [
            "Approve",
            "Reject"
          ],
          "default": "Approve"
        }
      }
    },
    {
      "id": "logOutcome1",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Log Outcome"
      },
      "inputs": {
        "script": "const decision = $vars.managerReview1.status;\nconst approved = decision === \"Approve\";\nconst rejectionReason = approved ? null : ($vars.managerReview1.output.rejectionreason || null);\nconst expenseId = $vars.getExpenseDetails1.output.expenseId;\nconst submitterName = $vars.getExpenseDetails1.output.submitterName;\nconst amount = $vars.getExpenseDetails1.output.amount;\nconst category = $vars.getExpenseDetails1.output.category;\nconst logMessage = approved\n  ? `Expense ${expenseId} for ${submitterName} ($${amount}, ${category}) was APPROVED.`\n  : `Expense ${expenseId} for ${submitterName} ($${amount}, ${category}) was REJECTED. Reason: ${rejectionReason}`;\nreturn { expenseId, submitterName, amount, category, approved, decision, rejectionReason, logMessage };"
      },
      "outputs": {
        "output": {
          "type": "any",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "end1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {}
    }
  ],
  "edges": [
    {
      "id": "e-start-getExpenseDetails1",
      "sourceNodeId": "start",
      "sourcePort": "output",
