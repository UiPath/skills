  "id": "39c2a53b-e45d-42b5-8705-da3bf43158f6",
  "version": "1.9",
  "name": "SearchableJoinsTest",
  "nodes": [
    {
      "id": "hasOpportunities",
      "type": "core.logic.decision",
      "typeVersion": "1.2",
      "display": {
        "label": "Has Opportunities?"
      },
      "inputs": {
        "expression": "Array.isArray($vars.getAccountsWithOpportunities1.output) && $vars.getAccountsWithOpportunities1.output.some(a => a.Opportunities && a.Opportunities.totalSize > 0)",
        "trueLabel": "Has Opportunities",
        "falseLabel": "No Opportunities"
      }
    },
    {
      "id": "endWithOpportunities",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End - Has Opportunities"
      },
      "inputs": {}
    },
    {
      "id": "endNoOpportunities",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End - No Opportunities"
      },
      "inputs": {}
    },
    {
