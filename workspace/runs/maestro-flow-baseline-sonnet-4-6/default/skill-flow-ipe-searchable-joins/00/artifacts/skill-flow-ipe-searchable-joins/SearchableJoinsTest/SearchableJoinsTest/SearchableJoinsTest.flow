        "entryPointId": "d0555c1e-8c82-477e-9535-261d23f1279b",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "getAccountsWithOpportunities1",
      "type": "uipath.connector.uipath-salesforce-sfdc.search-using-soql",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Get Accounts with Opportunities"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-salesforce-sfdc",
          "connectionId": "0fddf20e-f229-4ee9-acb3-c5be50034839",
          "connectionResourceId": "0fddf20e-f229-4ee9-acb3-c5be50034839",
          "connectionFolderKey": "5da18ec0-7de1-4e57-aaf1-ddc8a369c199",
          "method": "POST",
          "endpoint": "/curated_soqlQuery",
          "bodyParameters": {
            "query": "SELECT Id, Name, (SELECT Id, Name, StageName, Amount FROM Opportunities) FROM Account"
          },
          "uiPathActivityTypeId": "7aee02cf-218d-322e-9e67-7b78b6d6ebec",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"connectorVersion\":\"1.16.2\",\"customFieldsRequestDetails\":null,\"instanceParameters\":{\"connectorKey\":\"uipath-salesforce-sfdc\",\"objectName\":\"curated_soqlQuery\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"curated_soqlQuery\",\"operation\":\"list\",\"packageVersion\":\"1.0.0\",\"httpMethod\":\"POST\",\"path\":\"/curated_soqlQuery\",\"unifiedTypesCompatible\":true}}",
          "inputMetadata": {
            "operation": "list",
            "pagination": {
              "maxPageSize": 1000
            }
          }
        }
      }
    }
  ],
