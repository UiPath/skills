{
  "id": "e2fe6d2d-1130-4579-a5d9-3d36b2383f1b",
  "version": "1.9",
  "name": "CustomerEscalation",
  "nodes": [
    {
      "id": "classifyUrgency1",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Classify Urgency"
      },
      "inputs": {
        "script": "const subject = ($vars.emailReceived1.output.subject || '').toLowerCase();\nconst body = ($vars.emailReceived1.output.body || '').toLowerCase();\nconst urgentKeywords = ['urgent', 'asap', 'critical', 'emergency', 'high priority', 'immediate', 'time sensitive', 'escalate', 'overdue'];\nconst isUrgent = urgentKeywords.some(function(kw) { return subject.includes(kw) || body.includes(kw); });\nreturn { isUrgent: isUrgent };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Urgency classification result",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "classifyVip1",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Classify VIP"
      },
      "inputs": {
        "script": "const from = ($vars.emailReceived1.output.from || '').toLowerCase();\nconst vipDomains = ['enterprise.com', 'platinum.com', 'vip.com', 'executive.com', 'partner.com', 'strategic.com'];\nconst vipPrefixes = ['ceo@', 'cto@', 'coo@', 'vp@', 'director@', 'president@', 'svp@', 'evp@'];\nconst isVip = vipDomains.some(function(d) { return from.includes(d); }) || vipPrefixes.some(function(p) { return from.includes(p); });\nreturn { isVip: isVip };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "VIP classification result",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "routeDecision1",
      "type": "core.logic.decision",
      "typeVersion": "1.2",
      "display": {
        "label": "Urgent AND VIP?"
      },
      "inputs": {
        "expression": "$vars.classifyUrgency1.output.isUrgent === true && $vars.classifyVip1.output.isVip === true",
        "trueLabel": "High-Touch",
        "falseLabel": "Standard"
      }
    },
    {
      "id": "generateTicket1",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Generate Support Ticket"
      },
      "inputs": {
        "script": "const ticketId = 'TKT-' + String(Math.floor(Math.random() * 90000 + 10000));\nconst from = $vars.emailReceived1.output.from || 'unknown';\nconst subject = $vars.emailReceived1.output.subject || 'No subject';\nconst replyBody = 'Thank you for contacting support. A ticket has been created for your request.' + ' Ticket ID: ' + ticketId + '. Subject: ' + subject + '. Our team will respond within 24 hours.';\nreturn { ticketId: ticketId, summary: subject, requester: from, replyBody: replyBody };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Generated ticket details",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "endHighTouch1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End High-Touch"
      },
      "inputs": {}
    },
    {
      "id": "endStandard1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End Standard"
      },
      "inputs": {}
    },
