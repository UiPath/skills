            }
          ]
        },
        {
          "position": "right",
          "handles": [
            {
              "id": "success",
              "type": "source",
              "handleType": "output"
            },
            {
              "id": "error",
              "label": "Error",
              "type": "source",
              "handleType": "output",
              "visible": "{inputs.errorHandlingEnabled}",
              "constraints": {
                "maxConnections": 1
              }
            }
          ]
        }
      ],
      "debug": {
        "runtime": "clientScript"
      },
      "model": {
        "type": "bpmn:ScriptTask"
      },
      "inputDefinition": {
        "type": "object",
        "properties": {
          "script": {
            "type": "string",
            "minLength": 1,
            "errorMessage": "Add a script function",
            "validationSeverity": "warning"
          }
        },
        "required": [
