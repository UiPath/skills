{
  "id": "105ed2ca-22c2-4aea-af00-89fabf5992a7",
  "version": "1.9",
  "name": "ExpenseApproval",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "f02ad70c-235b-4154-a458-2dceb1a15a0e",
        "isDefaultEntryPoint": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the process.",
          "source": "null",
          "var": "output"
        }
      }
    },
    {
      "id": "expenseReview1",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "Expense Review"
      },
      "inputs": {
        "title": "Expense Review",
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group"
          }
        },
        "priority": "Low",
        "schema": {
          "schemaId": "b4e7a1c3-9f2d-4e8b-a5c6-7d9e2f4a8b1c",
          "fields": [
            {
              "id": "amount",
              "label": "Amount",
              "type": "number",
              "direction": "input",
              "binding": "vars.amount"
            },
            {
              "id": "requestername",
              "label": "Requester Name",
              "type": "string",
              "direction": "input",
              "binding": "vars.requesterName"
            },
            {
              "id": "category",
              "label": "Category",
              "type": "string",
              "direction": "input",
              "binding": "vars.category"
            },
            {
              "id": "approved",
              "label": "Approved",
              "type": "boolean",
              "direction": "output",
              "variable": "vars.approved"
            },
            {
              "id": "comments",
              "label": "Comments",
              "type": "string",
              "direction": "output",
              "variable": "vars.comments"
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "End"
            }
          ]
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "approved": {
              "type": "boolean"
            },
            "comments": {
              "type": "string"
            },
            "Action": {
              "type": "string",
              "enum": [
                "Approve",
                "Reject"
              ],
              "default": "Approve"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": [
            "Approve",
            "Reject"
          ],
          "default": "Approve"
        }
      }
    },
    {
      "id": "logDecision1",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Log Decision"
      },
      "inputs": {
        "script": "const approved = $vars.expenseReview1.output.approved;\nconst comments = $vars.expenseReview1.output.comments;\nreturn { message: \"Decision: \" + approved + \", Comments: \" + comments };"
      },
      "outputs": {
        "output": {
          "type": "any",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "end1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {}
    }
  ],
  "edges": [
    {
      "id": "edge-start-expenseReview1",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "expenseReview1",
      "targetPort": "input"
    },
    {
      "id": "edge-expenseReview1-logDecision1",
      "sourceNodeId": "expenseReview1",
      "sourcePort": "completed",
      "targetNodeId": "logDecision1",
      "targetPort": "input"
    },
    {
      "id": "edge-logDecision1-end1",
      "sourceNodeId": "logDecision1",
      "sourcePort": "success",
      "targetNodeId": "end1",
      "targetPort": "input"
    }
  ],
