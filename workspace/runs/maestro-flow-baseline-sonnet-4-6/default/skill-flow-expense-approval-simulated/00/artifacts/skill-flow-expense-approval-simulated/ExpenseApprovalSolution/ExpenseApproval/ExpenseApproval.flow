{
  "id": "ffbaf0d2-8266-4643-9e92-ec8046e0178c",
  "version": "1.9",
  "name": "ExpenseApproval",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "9d707665-db5e-4d70-a7a1-5c3ea3fa7631",
        "isDefaultEntryPoint": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the process.",
          "source": "null",
          "var": "output"
        }
      }
    },
    {
      "id": "managerReview1",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "Manager Review"
      },
      "inputs": {
        "title": "Expense Report Review",
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group"
          }
        },
        "priority": "Low",
        "schema": {
          "schemaId": "a4f9c3e2-7b1d-4e8f-b5c6-9d2a1f4b8e7c",
          "fields": [
            {
              "id": "expenseid",
              "label": "Expense ID",
              "type": "string",
              "direction": "input",
              "binding": "vars.expenseId"
            },
            {
              "id": "submittedby",
              "label": "Submitted By",
              "type": "string",
              "direction": "input",
              "binding": "vars.submittedBy"
            },
            {
              "id": "amount",
              "label": "Amount",
              "type": "number",
              "direction": "input",
              "binding": "vars.amount"
            },
            {
              "id": "category",
              "label": "Category",
              "type": "string",
              "direction": "input",
              "binding": "vars.category"
            },
            {
              "id": "rejectionreason",
              "label": "Rejection Reason",
              "type": "string",
              "direction": "output",
              "variable": "vars.rejectionReason",
              "required": false
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "End"
            }
          ]
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "rejectionreason": {
              "type": "string"
            },
            "Action": {
              "type": "string",
              "enum": [
                "Approve",
                "Reject"
              ],
              "default": "Approve"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": [
            "Approve",
            "Reject"
          ],
          "default": "Approve"
        }
      }
    },
    {
      "id": "logDecision1",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Log Decision"
      },
      "inputs": {
        "script": "const decision = $vars.managerReview1.status;\nconst rejectionReason = $vars.managerReview1.output.rejectionreason || \"\";\nreturn {\n  expenseId: $vars.expenseId,\n  submittedBy: $vars.submittedBy,\n  amount: $vars.amount,\n  category: $vars.category,\n  decision: decision,\n  rejectionReason: rejectionReason\n};"
      },
      "outputs": {
        "output": {
          "type": "any",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "end1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Done"
      },
      "inputs": {}
    }
  ],
  "edges": [
    {
      "id": "e-start-managerReview1",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "managerReview1",
      "targetPort": "input"
    },
    {
      "id": "e-managerReview1-logDecision1",
      "sourceNodeId": "managerReview1",
      "sourcePort": "completed",
      "targetNodeId": "logDecision1",
      "targetPort": "input"
    },
    {
      "id": "e-logDecision1-end1",
      "sourceNodeId": "logDecision1",
      "sourcePort": "success",
      "targetNodeId": "end1",
      "targetPort": "input"
    }
  ],
  "definitions": [
