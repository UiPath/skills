{
  "id": "74a4b90b-6ead-49ab-a4cd-2d1261b14e07",
  "version": "1.9",
  "name": "CustomerEscalationFlow",
  "nodes": [
    {
      "id": "classifyEmail1",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Classify Email"
      },
      "inputs": {
        "script": "const subject = ($vars.emailReceived1.output.subject || '').toLowerCase();\nconst body = ($vars.emailReceived1.output['body.content'] || '').toLowerCase();\nconst sender = ($vars.emailReceived1.output['from.emailAddress.address'] || '').toLowerCase();\nconst urgentKeywords = ['urgent', 'critical', 'asap', 'emergency', 'high priority'];\nconst vipList = ['ceo@example.com', 'vip@example.com', 'director@example.com', 'exec@example.com'];\nconst isUrgent = urgentKeywords.some(k => subject.includes(k) || body.includes(k));\nconst isVip = vipList.some(v => sender.includes(v));\nreturn { isUrgent, isVip, sender, subject };"
      }
    },
    {
      "id": "isUrgentAndVip1",
      "type": "core.logic.decision",
      "typeVersion": "1.2",
      "display": {
        "label": "Urgent AND VIP?"
      },
      "inputs": {
        "expression": "$vars.classifyEmail1.output.isUrgent && $vars.classifyEmail1.output.isVip",
        "trueLabel": "Urgent + VIP",
        "falseLabel": "Standard"
      }
    },
    {
      "id": "createTicket1",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Create Support Ticket"
      },
      "inputs": {
        "script": "const ticketId = 'TKT-' + Math.floor(Math.random() * 90000 + 10000);\nconst sender = $vars.classifyEmail1.output.sender;\nconst subject = $vars.classifyEmail1.output.subject;\nreturn { ticketId, replyBody: 'Thank you for contacting support. Your ticket has been created with ID: ' + ticketId + '. We will respond within 24 hours.', slackSummary: 'Support ticket ' + ticketId + ' created for ' + sender + ' | Subject: ' + subject };"
      }
    },
    {
      "id": "endVip1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Done - VIP Escalation"
      },
      "inputs": {}
    },
    {
      "id": "endOther1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Done - Ticket Created"
      },
      "inputs": {}
    },
