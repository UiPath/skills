    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "3d82a0f4-fb5d-4644-aacf-dd18aa2d9929",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "extractInvoice",
      "type": "uipath.ixp.invoiceixp-cef0d447-ixp.ff973488-5d89-8035-86ac-f980b4be6deb-c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Extract Invoice Fields"
      },
      "inputs": {
        "model": {
          "id": "ff973488-5d89-8035-86ac-f980b4be6deb",
          "modelName": "InvoiceIXP",
          "modelDisplayName": "InvoiceIXP",
          "folderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "folderName": "Shared",
          "folderPath": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "description": ""
        },
        "modelName": "InvoiceIXP",
        "description": "",
        "projectName": "invoiceixp-cef0d447-ixp",
        "versionTag": "",
        "folderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
        "folderName": "Shared",
        "fileRef": "=js:$vars.start.output.invoiceFile",
        "pageRange": ""
      },
      "outputs": {
        "output": {
          "name": "output",
          "type": "object",
          "source": "=this",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "checkAmount",
      "type": "core.logic.decision",
      "typeVersion": "1.2",
      "display": {
        "label": "Amount > 1000?"
      },
      "inputs": {
        "expression": "$vars.extractInvoice.output.ExtractionResult.ResultsDocument.Fields.find(f => f.FieldName === 'Total Amount')?.Values?.[0] > 1000",
        "trueLabel": "High Value",
        "falseLabel": "Auto Approve"
      }
    },
    {
      "id": "highValueReview",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "HighValueReview"
      },
      "inputs": {
        "script": "const fields = $vars.extractInvoice.output.ExtractionResult.ResultsDocument.Fields || [];\nconst vendorName = fields.find(f => f.FieldName === 'Vendor Name')?.Values?.[0] || 'Unknown';\nconst totalAmount = fields.find(f => f.FieldName === 'Total Amount')?.Values?.[0] || '0';\nreturn { summary: 'HIGH VALUE REVIEW: Invoice from ' + vendorName + ' for ' + totalAmount + ' requires manual review.' };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "autoApprove",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "AutoApprove"
      },
      "inputs": {
        "script": "const fields = $vars.extractInvoice.output.ExtractionResult.ResultsDocument.Fields || [];\nconst vendorName = fields.find(f => f.FieldName === 'Vendor Name')?.Values?.[0] || 'Unknown';\nconst totalAmount = fields.find(f => f.FieldName === 'Total Amount')?.Values?.[0] || '0';\nreturn { summary: 'AUTO APPROVED: Invoice from ' + vendorName + ' for ' + totalAmount + ' automatically approved.' };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "endHighValue",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End (High Value)"
      }
    },
    {
      "id": "endAutoApprove",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End (Auto Approve)"
      }
    }
  ],
