  "version": "1.9",
  "name": "HttpWebhookFlow",
  "nodes": [
    {
      "id": "validatePayload",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Validate Payload"
      },
      "inputs": {
        "script": "const payload = $vars.httpWebhookTrigger1.output;\nconst body = (payload && payload.body !== undefined) ? payload.body : payload;\nconst isValid = body !== null && body !== undefined && typeof body === 'object';\nconst statusCode = isValid ? 200 : 400;\nconst message = isValid ? 'Payload is valid' : 'Invalid or missing payload';\nreturn { statusCode: statusCode, message: message, isValid: isValid };"
      },
      "outputs": {
        "output": {
          "type": "any",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "end1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {},
      "outputs": {}
    },
