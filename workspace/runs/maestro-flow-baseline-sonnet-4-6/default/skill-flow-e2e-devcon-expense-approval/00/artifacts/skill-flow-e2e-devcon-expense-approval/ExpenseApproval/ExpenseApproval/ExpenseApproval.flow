{
  "id": "3ab24fd5-5f61-4b0e-bba9-2bbe61713c10",
  "version": "1.9",
  "name": "ExpenseApproval",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "9b7bb48e-9b0c-4028-8e80-feec7d5649bc",
        "isDefaultEntryPoint": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the process.",
          "source": "null",
          "var": "output"
        }
      }
    },
    {
      "id": "fetchExpense",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Fetch Expense Details"
      },
      "inputs": {
        "script": "return {\n  expenseId: \"EXP-2024-001\",\n  amount: 1250.00,\n  submitter: \"Alice Johnson\",\n  category: \"Travel\"\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "managerReview",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "Manager Review"
      },
      "inputs": {
        "title": "Expense Approval Request",
        "schema": {
          "schemaId": "425c1eb6-1a7b-49f9-a50c-d04243e66c59",
          "fields": [
            {
              "id": "expenseId",
              "label": "Expense ID",
              "type": "text",
              "direction": "input",
              "binding": "vars.fetchExpense.output.expenseId"
            },
            {
              "id": "amount",
              "label": "Amount",
              "type": "number",
              "direction": "input",
              "binding": "vars.fetchExpense.output.amount"
            },
            {
              "id": "submitter",
              "label": "Submitted By",
              "type": "text",
              "direction": "input",
              "binding": "vars.fetchExpense.output.submitter"
            },
            {
              "id": "category",
              "label": "Category",
              "type": "text",
              "direction": "input",
              "binding": "vars.fetchExpense.output.category"
            },
            {
              "id": "rejectionReason",
              "label": "Rejection Reason",
              "type": "text",
              "direction": "output",
              "variable": "vars.rejectionReason"
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "Continue"
            }
          ]
        },
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group",
            "group": "expense-approvers"
          }
        },
        "priority": "Medium"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "rejectionReason": {
              "type": "string"
            },
            "Action": {
              "type": "string",
              "enum": [
                "Approve",
                "Reject"
              ],
              "default": "Approve"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": [
            "Approve",
            "Reject"
          ],
          "default": "Approve"
        }
      }
    },
    {
      "id": "logOutcome",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Log Outcome"
      },
      "inputs": {
        "script": "var decision = $vars.managerReview.output.Action;\nvar reason = $vars.managerReview.output.rejectionReason;\nvar expenseId = $vars.fetchExpense.output.expenseId;\nvar logEntry = {\n  expenseId: expenseId,\n  decision: decision,\n  logged: true\n};\nif (decision === \"Reject\") {\n  logEntry.rejectionReason = reason;\n}\nreturn logEntry;"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "endNode",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {},
      "outputs": {
        "rejectionReason": {
          "source": "=js:$vars.managerReview.output.rejectionReason"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "e-start-fetchExpense",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "fetchExpense",
      "targetPort": "input"
    },
    {
      "id": "e-fetchExpense-managerReview",
      "sourceNodeId": "fetchExpense",
      "sourcePort": "success",
      "targetNodeId": "managerReview",
      "targetPort": "input"
    },
    {
      "id": "e-managerReview-logOutcome",
      "sourceNodeId": "managerReview",
      "sourcePort": "completed",
      "targetNodeId": "logOutcome",
      "targetPort": "input"
    },
    {
      "id": "e-logOutcome-endNode",
      "sourceNodeId": "logOutcome",
      "sourcePort": "success",
      "targetNodeId": "endNode",
      "targetPort": "input"
    }
  ],
  "definitions": [
    {
      "nodeType": "core.trigger.manual",
      "version": "1.0",
      "category": "trigger",
