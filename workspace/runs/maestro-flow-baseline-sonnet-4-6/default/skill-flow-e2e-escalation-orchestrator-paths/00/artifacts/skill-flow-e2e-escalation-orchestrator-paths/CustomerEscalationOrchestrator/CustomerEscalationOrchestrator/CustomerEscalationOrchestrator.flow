{
  "id": "df19d3bf-840e-43cc-bb70-8a31de1cdffd",
  "version": "1.9",
  "name": "CustomerEscalationOrchestrator",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "11908e22-ed7f-4eb0-991c-0d235e1a3fb9",
        "isDefaultEntryPoint": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the process.",
          "source": "null",
          "var": "output"
        }
      }
    },
    {
      "id": "classify",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "classify"
      },
      "inputs": {
        "script": "const senderDomain = $vars.start.output.senderDomain;\nconst customerMatchStatus = $vars.start.output.customerMatchStatus;\nconst isDuplicate = $vars.start.output.isDuplicate;\nconst productionDown = $vars.start.output.productionDown;\nconst workaroundAvailable = $vars.start.output.workaroundAvailable;\n\nlet escalationPath;\nlet severity = \"informational\";\nlet engineeringNeeded = false;\nlet responseMode = \"None\";\n\nif (!senderDomain || senderDomain === \"\") {\n  escalationPath = \"missing_domain\";\n} else if (customerMatchStatus === \"none\") {\n  escalationPath = \"unknown_customer\";\n} else if (customerMatchStatus === \"multiple\") {\n  escalationPath = \"multiple_matches\";\n} else if (isDuplicate === true) {\n  escalationPath = \"duplicate\";\n} else {\n  escalationPath = \"escalation\";\n  responseMode = \"Draft\";\n  if (productionDown && !workaroundAvailable) {\n    severity = \"Sev1\";\n    engineeringNeeded = true;\n  } else if (productionDown && workaroundAvailable) {\n    severity = \"Sev2\";\n    engineeringNeeded = true;\n  } else {\n    severity = \"Sev3\";\n    engineeringNeeded = false;\n  }\n}\n\nreturn {\n  escalationPath: escalationPath,\n  severity: severity,\n  engineeringNeeded: engineeringNeeded,\n  responseMode: responseMode\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "routeDecision",
      "type": "core.logic.decision",
      "typeVersion": "1.2",
      "display": {
        "label": "Is Escalation?"
      },
      "inputs": {
        "expression": "$vars.classify.output.escalationPath === \"escalation\"",
        "trueLabel": "Escalation",
        "falseLabel": "Triage"
      }
    },
    {
      "id": "postEscalationAlert1",
      "type": "uipath.connector.uipath-salesforce-slack.send-message-to-channel",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Post Escalation Alert"
      },
      "inputs": {
        "errorHandlingEnabled": true,
        "detail": {
          "connector": "uipath-salesforce-slack",
          "connectionId": "e03f734e-0f80-4e8a-a7c1-0ece309b0ca4",
          "connectionResourceId": "e03f734e-0f80-4e8a-a7c1-0ece309b0ca4",
          "connectionFolderKey": "def71452-bad1-40fa-be08-da175e89bd1a",
          "method": "POST",
          "endpoint": "/send_message_to_channel_v2",
          "bodyParameters": {
            "channel": "coding-agent-testing",
            "messageToSend": "=js:\"ESCALATION ALERT | Path: \" + $vars.classify.output.escalationPath + \" | CorrelationId: \" + $vars.start.output.correlationId"
          },
          "queryParameters": {
            "send_as": "user"
          },
          "uiPathActivityTypeId": "37a305b2-89b1-315d-b73f-1778839a6c47",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"connectorVersion\":\"2.14.8\",\"customFieldsRequestDetails\":null,\"instanceParameters\":{\"connectorKey\":\"uipath-salesforce-slack\",\"objectName\":\"send_message_to_channel_v2\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"send_message_to_channel_v2\",\"operation\":\"create\",\"packageVersion\":\"1.0.0\",\"httpMethod\":\"POST\",\"path\":\"/send_message_to_channel_v2\",\"unifiedTypesCompatible\":true,\"savedJitInputFieldId\":\"in_send_message_to_channel_v2\"}}"
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the connector.",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
