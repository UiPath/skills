      "typeVersion": "1.1",
      "display": {
        "label": "Log OK"
      },
      "inputs": {
        "script": "const result = $vars.extractInvoice.output;\nreturn { ok: true, extractionResult: result };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
