      "id": "extractReceiptFields",
      "type": "uipath.ixp.idp-benchmark-receipts-43af6412-ixp.9e77f71d-773c-80a0-9411-ec40d252d00d-c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Extract Receipt Fields"
      },
      "inputs": {
        "model": {
          "id": "9e77f71d-773c-80a0-9411-ec40d252d00d",
          "modelName": "idp-benchmark---receipts-43af6412-ixp",
          "modelDisplayName": "idp-benchmark---receipts-43af6412-ixp",
          "folderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "folderName": "Shared",
          "folderPath": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "description": ""
        },
        "modelName": "idp-benchmark---receipts-43af6412-ixp",
        "description": "",
        "projectName": "idp-benchmark---receipts-43af6412-ixp",
        "versionTag": "",
        "folderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
        "folderName": "Shared",
        "fileRef": "=js:$vars.start.output.receiptImage",
        "pageRange": ""
      },
      "outputs": {
        "output": {
          "name": "output",
          "type": "object",
          "source": "=this",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "parseReceiptFields",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Parse Merchant, Date, Total"
      },
      "inputs": {
        "script": "const fields = ($vars.extractReceiptFields.output.ExtractionResult && $vars.extractReceiptFields.output.ExtractionResult.ResultsDocument && $vars.extractReceiptFields.output.ExtractionResult.ResultsDocument.Fields) || [];\nconst find = (name) => fields.find(f => f.FieldName === name)?.Values?.[0] ?? null;\nreturn {\n  merchant: find('merchant') || find('Merchant') || find('vendor') || find('Vendor'),\n  date: find('date') || find('Date') || find('transaction_date') || find('TransactionDate'),\n  total: find('total') || find('Total') || find('amount') || find('Amount')\n};"
      },
      "outputs": {
        "output": {
          "name": "output",
          "type": "object",
          "source": "=this",
          "var": "output"
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {},
      "outputs": {
        "merchant": {
          "name": "merchant",
          "source": "=js:$vars.parseReceiptFields.output.merchant"
        },
        "date": {
          "name": "date",
          "source": "=js:$vars.parseReceiptFields.output.date"
        },
        "total": {
          "name": "total",
          "source": "=js:$vars.parseReceiptFields.output.total"
        }
      }
    }
  ],
