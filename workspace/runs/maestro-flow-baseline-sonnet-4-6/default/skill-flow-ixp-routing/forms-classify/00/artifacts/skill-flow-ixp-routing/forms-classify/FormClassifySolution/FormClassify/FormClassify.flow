  },
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "c2e341cc-5451-4759-8b7a-c0f209de1e24",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "classifyAndExtract",
      "type": "uipath.ixp.ixp-uniform-residential-loan-application-fannie-mae-form-1003-ec9bb5b0-ixp.589568b1-5ea1-80ed-9db4-ada0d51cdc8d-c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Classify & Extract Form Fields"
      },
      "inputs": {
        "model": {
          "id": "589568b1-5ea1-80ed-9db4-ada0d51cdc8d",
          "modelName": "ixp-uniform-residential-loan-application-fannie-mae-form-1003-ec9bb5b0-ixp",
          "modelDisplayName": "ixp-uniform-residential-loan-application-fannie-mae-form-1003-ec9bb5b0-ixp",
          "folderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "folderName": "Shared",
          "folderPath": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "description": ""
        },
        "modelName": "ixp-uniform-residential-loan-application-fannie-mae-form-1003-ec9bb5b0-ixp",
        "description": "",
        "projectName": "ixp-uniform-residential-loan-application-fannie-mae-form-1003-ec9bb5b0-ixp",
        "versionTag": "",
        "folderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
        "folderName": "Shared",
        "fileRef": "=js:$vars.start.output.incomingPdf",
        "pageRange": ""
      },
      "outputs": {
        "output": {
          "name": "output",
          "type": "object",
          "source": "=this",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "processFields",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Process Extracted Fields"
      },
      "inputs": {
        "script": "const fields = ($vars.classifyAndExtract.output.ExtractionResult || {}).ResultsDocument?.Fields || [];\nconst mapped = {};\nfor (const f of fields) {\n  mapped[f.FieldName] = f.Values && f.Values.length > 0 ? f.Values[0] : null;\n}\nreturn { fields: mapped, fieldCount: fields.length };"
      },
      "outputs": {
        "output": {
          "name": "output",
          "type": "object",
          "source": "=this",
          "var": "output"
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {},
      "outputs": {
        "extractedFields": {
          "source": "=js:$vars.processFields.output.fields"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "edge_start_output_classifyAndExtract_input",
