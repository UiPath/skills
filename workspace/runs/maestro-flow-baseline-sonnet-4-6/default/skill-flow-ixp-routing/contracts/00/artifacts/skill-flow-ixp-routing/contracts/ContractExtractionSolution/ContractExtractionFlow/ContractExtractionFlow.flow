{
  "id": "68071ea8-5963-4fb8-9e7c-94a32e4c1218",
  "version": "1.9",
  "name": "ContractExtractionFlow",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "4be3ef8f-f1c1-4709-a675-6f1ac1034a36",
        "isDefaultEntryPoint": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the process.",
          "source": "null",
          "var": "output"
        }
      }
    },
    {
      "id": "extractContractFields",
      "type": "uipath.ixp.employment-agreements-d4ee40a0-ixp.97f6f1c4-2b0d-8044-8892-c8809e742924-c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Extract Contract Fields"
      },
      "inputs": {
        "model": {
          "id": "97f6f1c4-2b0d-8044-8892-c8809e742924",
          "modelName": "employment-agreements-d4ee40a0-ixp",
          "modelDisplayName": "employment-agreements-d4ee40a0-ixp",
          "folderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "folderName": "Shared",
          "folderPath": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "description": ""
        },
        "modelName": "employment-agreements-d4ee40a0-ixp",
        "projectName": "employment-agreements-d4ee40a0-ixp",
        "folderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
        "folderName": "Shared",
        "versionTag": "",
        "pageRange": "",
        "fileRef": "=js:$vars.start.output.contractFile"
      },
      "outputs": {
        "output": {
          "name": "output",
          "type": "object",
          "source": "=this",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "parseContractFields",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Parse Contract Fields"
      },
      "inputs": {
        "script": "const fields = $vars.extractContractFields.output.ExtractionResult.ResultsDocument.Fields || [];\nconst get = (name) => (fields.find(f => f.FieldName === name) || {}).Values?.[0] || null;\nreturn {\n  partyNames: [get('EmployerName'), get('EmployeeName')].filter(Boolean),\n  effectiveDate: get('EffectiveDate') || get('StartDate'),\n  terminationClause: get('TerminationClause') || get('Termination')\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "approvalStep",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "Contract Approval"
      },
      "inputs": {
        "schema": {
          "schemaId": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
          "fields": [
            {
              "id": "partyNames",
              "label": "Party Names",
              "type": "text",
              "direction": "input",
              "binding": "vars.parseContractFields.output.partyNames"
            },
            {
              "id": "effectiveDate",
              "label": "Effective Date",
              "type": "text",
              "direction": "input",
              "binding": "vars.parseContractFields.output.effectiveDate"
            },
            {
              "id": "terminationClause",
              "label": "Termination Clause",
              "type": "text",
              "direction": "input",
              "binding": "vars.parseContractFields.output.terminationClause"
            },
            {
              "id": "reviewerNotes",
              "label": "Reviewer Notes",
              "type": "text",
              "direction": "output",
              "variable": "vars.reviewerNotes"
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "Continue"
            }
          ]
        },
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group"
          }
        },
        "priority": "Medium",
        "title": "Contract Review Required"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "reviewerNotes": {
              "type": "string"
            },
            "Action": {
              "type": "string",
              "enum": [
                "Approve",
                "Reject"
              ],
              "default": "Approve"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": [
            "Approve",
            "Reject"
          ],
          "default": "Approve"
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {}
    }
  ],
  "edges": [
    {
      "id": "edge-start-extract",
      "sourceNodeId": "start",
