  "id": "c2c63b83-a191-4a6d-adb7-f549efae2c8b",
  "version": "1.9",
  "name": "InvoiceExtraction",
  "nodes": [
    {
      "id": "loopInvoiceFiles",
      "type": "core.logic.loop",
      "typeVersion": "2.4",
      "display": {
        "label": "Loop Over Invoice Files"
      },
      "inputs": {
        "collection": "=js:$vars.listSharepointInvoiceFiles1.output.value",
        "parallel": false,
        "completionCondition": "",
        "breakEnabled": false
      },
      "nodes": [
        {
          "id": "getInvoicePdf1",
          "type": "uipath.connector.uipath-microsoft-onedrive.get-file-or-folder",
          "typeVersion": "1.0.0",
          "display": {
            "label": "Get Invoice PDF"
          },
          "inputs": {}
        },
        {
          "id": "extractInvoiceFields",
          "type": "uipath.ixp.invoiceixp-cef0d447-ixp.ff973488-5d89-8035-86ac-f980b4be6deb-c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "typeVersion": "1.0.0",
          "display": {
            "label": "Extract Invoice Fields"
          },
          "inputs": {
            "model": {
              "id": "ff973488-5d89-8035-86ac-f980b4be6deb",
              "modelName": "invoiceixp-cef0d447-ixp",
              "modelDisplayName": "InvoiceIXP",
              "folderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
              "folderName": "Shared",
              "folderPath": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
              "description": ""
            },
            "modelName": "invoiceixp-cef0d447-ixp",
            "description": "",
            "projectName": "invoiceixp-cef0d447-ixp",
            "versionTag": "",
            "folderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
            "folderName": "Shared",
            "fileRef": "=js:$vars.getInvoicePdf1.output",
            "pageRange": ""
          },
          "outputs": {
            "output": {
              "name": "output",
              "type": "object",
              "source": "=this",
              "var": "output"
            },
            "error": {
              "type": "object",
              "description": "Error information if the node fails",
              "source": "=Error",
              "var": "error"
            }
          }
        },
        {
          "id": "buildInvoicePayload",
          "type": "core.action.script",
          "typeVersion": "1.1",
          "display": {
            "label": "Build Invoice Payload"
          },
          "inputs": {
            "script": "const fields = ($vars.extractInvoiceFields.output.ExtractionResult?.ResultsDocument?.Fields) || [];\nconst get = (name) => fields.find(f => f.FieldName === name)?.Values?.[0] || null;\nconst lineItems = ($vars.extractInvoiceFields.output.ExtractionResult?.ResultsDocument?.Tables || []).map(t => t);\nreturn {\n  vendorName: get('VendorName'),\n  invoiceNumber: get('InvoiceId'),\n  invoiceDate: get('InvoiceDate'),\n  totalAmount: get('InvoiceTotal'),\n  lineItems: lineItems\n};"
          },
          "outputs": {
            "output": {
              "type": "object",
              "source": "=result.response",
              "var": "output"
            }
          }
        }
      ],
      "edges": [
        {
          "id": "edge_loopStart_getInvoicePdf1_input",
