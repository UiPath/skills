      "id": "extractReportFields",
      "type": "uipath.ixp.aviation-investigation-final-report-demo-a42b1d4d-ixp.937c414b-7879-8059-8b29-e8401d2dd3ba-c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Extract NTSB Report Fields"
      },
      "inputs": {
        "model": {
          "id": "937c414b-7879-8059-8b29-e8401d2dd3ba",
          "modelName": "aviation-investigation-final-report-demo-a42b1d4d-ixp",
          "modelDisplayName": "aviation-investigation-final-report-demo-a42b1d4d-ixp",
          "folderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "folderName": "Shared",
          "folderPath": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "description": ""
        },
        "modelName": "aviation-investigation-final-report-demo-a42b1d4d-ixp",
        "projectName": "aviation-investigation-final-report-demo-a42b1d4d-ixp",
        "versionTag": "",
        "folderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
        "folderName": "Shared",
        "fileRef": "=js:$vars.start.output.reportPdf",
        "pageRange": ""
      },
      "outputs": {
        "output": {
          "name": "output",
          "type": "object",
          "source": "=this",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "logNtsbNumber",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Log NTSB Number"
      },
      "inputs": {
        "script": "const fields = ($vars.extractReportFields.output && $vars.extractReportFields.output.ExtractionResult && $vars.extractReportFields.output.ExtractionResult.ResultsDocument && $vars.extractReportFields.output.ExtractionResult.ResultsDocument.Fields) ? $vars.extractReportFields.output.ExtractionResult.ResultsDocument.Fields : [];\nconst getField = (name) => { const f = fields.find(function(x) { return x.FieldName === name; }); return f && f.Values && f.Values.length > 0 ? (f.Values[0].Value !== undefined ? f.Values[0].Value : f.Values[0]) : null; };\nconst ntsbNumber = getField('NTSB Number') || getField('ntsbNumber') || getField('Ntsb Number') || getField('NTSB_Number') || getField('Accident Number') || getField('accidentNumber');\nconst eventDate = getField('Event Date') || getField('eventDate') || getField('Accident Date') || getField('Date') || getField('date');\nconst city = getField('City') || getField('city') || getField('Location City') || getField('Accident City');\nconst state = getField('State') || getField('state') || getField('Location State') || getField('Accident State');\nconst aircraftMake = getField('Aircraft Make') || getField('aircraftMake') || getField('Make') || getField('make');\nconst aircraftModel = getField('Aircraft Model') || getField('aircraftModel') || getField('Model') || getField('model');\nconst aircraftDamage = getField('Aircraft Damage') || getField('aircraftDamage') || getField('Damage') || getField('damage');\nreturn { ntsbNumber: ntsbNumber, eventDate: eventDate, city: city, state: state, aircraftMake: aircraftMake, aircraftModel: aircraftModel, aircraftDamage: aircraftDamage };"
      },
      "outputs": {
        "output": {
          "name": "output",
          "type": "object",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {},
      "outputs": {}
    }
  ],
