    {
      "id": "extractBirthCertificate",
      "type": "uipath.ixp.birth-certificates-oob-6252526a-ixp.a05c7655-1a1c-80a5-94a0-b1609d34dc10-c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Extract Birth Certificate Fields"
      },
      "inputs": {
        "model": {
          "id": "a05c7655-1a1c-80a5-94a0-b1609d34dc10",
          "modelName": "birth_certificates_oob-6252526a-ixp",
          "modelDisplayName": "birth_certificates_oob-6252526a-ixp",
          "folderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "folderName": "Shared",
          "folderPath": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "description": ""
        },
        "modelName": "birth_certificates_oob-6252526a-ixp",
        "projectName": "birth_certificates_oob-6252526a-ixp",
        "versionTag": "",
        "folderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
        "folderName": "Shared",
        "fileRef": "=js:$vars.start.output.certificateFile",
        "pageRange": ""
      },
      "outputs": {
        "output": {
          "name": "output",
          "type": "object",
          "source": "=this",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "logChildName",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Log Child Full Name"
      },
      "inputs": {
        "script": "const fields = ($vars.extractBirthCertificate.output && $vars.extractBirthCertificate.output.ExtractionResult && $vars.extractBirthCertificate.output.ExtractionResult.ResultsDocument && $vars.extractBirthCertificate.output.ExtractionResult.ResultsDocument.Fields) ? $vars.extractBirthCertificate.output.ExtractionResult.ResultsDocument.Fields : [];\nconst getField = (name) => { const f = fields.find(function(x){ return x.FieldName === name; }); return (f && f.Values && f.Values.length > 0) ? (f.Values[0].Value || '') : ''; };\nconst childFullName = getField('Child Full Name') || getField('ChildFullName') || getField('child_full_name') || getField('FullName') || getField('Name') || '';\nconst dateOfBirth = getField('Date of Birth') || getField('DateOfBirth') || getField('date_of_birth') || getField('BirthDate') || '';\nconst placeOfBirth = getField('Place of Birth') || getField('PlaceOfBirth') || getField('place_of_birth') || getField('BirthPlace') || '';\nconst fatherName = getField(\"Father's Name\") || getField('FatherName') || getField('father_name') || getField('Father') || '';\nconst motherName = getField(\"Mother's Name\") || getField('MotherName') || getField('mother_name') || getField('Mother') || '';\nreturn { childFullName: childFullName, dateOfBirth: dateOfBirth, placeOfBirth: placeOfBirth, fatherName: fatherName, motherName: motherName };"
      },
      "outputs": {
        "output": {
          "name": "output",
          "type": "object",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {}
    }
  ],
