{
  "id": "e9683965-9c81-442e-89cc-c59ca110f194",
  "version": "1.9",
  "name": "LeaveRequest",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "f8c76796-baac-4e9b-80a1-d98afe7ffd21",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "managerReview1",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "Manager Review"
      },
      "inputs": {
        "title": "Manager Review",
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group"
          }
        },
        "priority": "Low",
        "schema": {
          "schemaId": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
          "fields": [
            {
              "id": "employeename",
              "label": "Employee Name",
              "type": "string",
              "direction": "input",
              "binding": "vars.start.output.employeeName"
            },
            {
              "id": "numdays",
              "label": "Number of Days",
              "type": "number",
              "direction": "input",
              "binding": "vars.start.output.numDays"
            },
            {
              "id": "approved",
              "label": "Approved",
              "type": "boolean",
              "direction": "output",
              "variable": "vars.approved"
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "End"
            }
          ]
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "approved": {
              "type": "boolean"
            },
            "Action": {
              "type": "string",
              "enum": [
                "Approve",
                "Reject"
              ],
              "default": "Approve"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": [
            "Approve",
            "Reject"
          ],
          "default": "Approve"
        }
      }
    },
    {
      "id": "approvalDecision1",
      "type": "core.logic.decision",
      "typeVersion": "1.2",
      "display": {
        "label": "Approved?"
      },
      "inputs": {
        "expression": "$vars.managerReview1.output.approved",
        "trueLabel": "Approved",
        "falseLabel": "Rejected"
      }
    },
    {
      "id": "logApproved1",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Log Approved"
      },
      "inputs": {
        "script": "return { message: \"Leave approved\" };"
      }
    },
    {
      "id": "logRejected1",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Log Rejected"
      },
      "inputs": {
        "script": "return { message: \"Leave rejected\" };"
      }
    },
    {
      "id": "endApproved1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {}
    },
    {
      "id": "endRejected1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {}
    }
  ],
