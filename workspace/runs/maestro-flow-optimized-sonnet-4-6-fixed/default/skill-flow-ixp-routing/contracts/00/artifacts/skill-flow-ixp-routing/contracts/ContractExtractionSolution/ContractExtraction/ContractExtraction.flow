    {
      "id": "extractContractFields",
      "type": "uipath.ixp.employment-agreements-d4ee40a0-ixp.97f6f1c4-2b0d-8044-8892-c8809e742924-c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Extract Contract Fields"
      },
      "inputs": {
        "model": {
          "id": "97f6f1c4-2b0d-8044-8892-c8809e742924",
          "modelName": "employment-agreements-d4ee40a0-ixp",
          "modelDisplayName": "employment-agreements-d4ee40a0-ixp",
          "folderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "folderName": "Shared",
          "folderPath": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "description": ""
        },
        "modelName": "employment-agreements-d4ee40a0-ixp",
        "description": "",
        "projectName": "employment-agreements-d4ee40a0-ixp",
        "versionTag": "",
        "folderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
        "folderName": "Shared",
        "fileRef": "=js:$vars.start.output.contractFile",
        "pageRange": ""
      },
      "outputs": {
        "output": {
          "name": "output",
          "type": "object",
          "source": "=this",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "parseExtractedData",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Parse Contract Fields"
      },
      "inputs": {
        "script": "const fields = ($vars.extractContractFields.output.ExtractionResult || {}).ResultsDocument?.Fields || [];\nconst partyNames = fields.find(f => f.FieldName === 'Party Names')?.Values?.[0] || null;\nconst effectiveDate = fields.find(f => f.FieldName === 'Effective Date')?.Values?.[0] || null;\nconst terminationClause = fields.find(f => f.FieldName === 'Termination Clause')?.Values?.[0] || null;\nreturn { partyNames, effectiveDate, terminationClause };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails.",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "contractApproval",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "Contract Approval"
      },
      "inputs": {
        "schema": {
          "schemaId": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
          "fields": [
            {
              "id": "partyNamesField",
              "label": "Party Names",
              "type": "text",
              "direction": "input",
              "binding": "vars.parseExtractedData.output.partyNames"
            },
            {
              "id": "effectiveDateField",
              "label": "Effective Date",
              "type": "text",
              "direction": "input",
              "binding": "vars.parseExtractedData.output.effectiveDate"
            },
            {
              "id": "terminationClauseField",
              "label": "Termination Clause",
              "type": "text",
              "direction": "input",
              "binding": "vars.parseExtractedData.output.terminationClause"
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "End"
            }
          ]
        },
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group"
          }
        },
        "priority": "Low"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "Action": {
              "type": "string",
              "enum": [
                "Approve",
                "Reject"
              ],
              "default": "Approve"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": [
            "Approve",
            "Reject"
          ],
          "default": "Approve"
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "end"
      },
      "inputs": {},
      "outputs": {
        "partyNames": {
          "source": "=js:$vars.parseExtractedData.output.partyNames"
        },
        "effectiveDate": {
          "source": "=js:$vars.parseExtractedData.output.effectiveDate"
        },
        "terminationClause": {
