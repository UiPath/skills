{
  "id": "9a20d5f1-3a43-4f49-bb49-03898ccba4a6",
  "version": "1.9",
  "name": "LeaveRequest",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "ee9e422c-739d-4c2e-8607-227016fdc9e6",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "managerReview",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "Manager Review"
      },
      "inputs": {
        "schema": {
          "schemaId": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
          "fields": [
            {
              "id": "employeeName",
              "label": "Employee Name",
              "type": "text",
              "direction": "input",
              "binding": "vars.start.output.employeeName"
            },
            {
              "id": "numberOfDays",
              "label": "Number of Days",
              "type": "number",
              "direction": "input",
              "binding": "vars.start.output.numberOfDays"
            },
            {
              "id": "approved",
              "label": "Approved",
              "type": "boolean",
              "direction": "output",
              "variable": "vars.approved"
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "Continue"
            }
          ]
        },
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group"
          }
        },
        "priority": "Low"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "approved": {
              "type": "boolean"
            },
            "Action": {
              "type": "string",
              "enum": [
                "Approve",
                "Reject"
              ],
              "default": "Approve"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": [
            "Approve",
            "Reject"
          ],
          "default": "Approve"
        }
      }
    },
    {
      "id": "checkApproval",
      "type": "core.logic.decision",
      "typeVersion": "1.2",
      "display": {
        "label": "Approved?"
      },
      "inputs": {
        "expression": "$vars.managerReview.output.approved === true",
        "trueLabel": "Approved",
        "falseLabel": "Rejected"
      },
      "outputs": {
        "matchedCase": {
          "type": "string",
          "description": "The label of the matched branch (true/false label)",
          "source": "=result.matchedCase",
          "var": "matchedCase"
        },
        "matchedCaseId": {
          "type": "string",
          "description": "The branch that was taken (true or false)",
          "source": "=result.matchedCaseId",
          "var": "matchedCaseId"
        }
      }
    },
    {
      "id": "logApproved",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Log Approved"
      },
      "inputs": {
        "script": "return { message: 'Leave approved' };"
      },
      "outputs": {
        "output": {
          "type": "any",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "logRejected",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Log Rejected"
      },
      "inputs": {
        "script": "return { message: 'Leave rejected' };"
      },
      "outputs": {
        "output": {
          "type": "any",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "endApproved",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {}
    },
    {
      "id": "endRejected",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {}
    }
  ],
  "edges": [
    {
      "id": "edge_start_output_managerReview_input",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "managerReview",
      "targetPort": "input"
    },
    {
      "id": "edge_managerReview_completed_checkApproval_input",
      "sourceNodeId": "managerReview",
      "sourcePort": "completed",
      "targetNodeId": "checkApproval",
      "targetPort": "input"
    },
    {
      "id": "edge_checkApproval_true_logApproved_input",
      "sourceNodeId": "checkApproval",
      "sourcePort": "true",
      "targetNodeId": "logApproved",
      "targetPort": "input"
    },
    {
      "id": "edge_checkApproval_false_logRejected_input",
      "sourceNodeId": "checkApproval",
      "sourcePort": "false",
      "targetNodeId": "logRejected",
      "targetPort": "input"
    },
    {
      "id": "edge_logApproved_success_endApproved_input",
      "sourceNodeId": "logApproved",
      "sourcePort": "success",
      "targetNodeId": "endApproved",
      "targetPort": "input"
    },
    {
      "id": "edge_logRejected_success_endRejected_input",
      "sourceNodeId": "logRejected",
      "sourcePort": "success",
      "targetNodeId": "endRejected",
      "targetPort": "input"
    }
  ],
  "definitions": [
    {
