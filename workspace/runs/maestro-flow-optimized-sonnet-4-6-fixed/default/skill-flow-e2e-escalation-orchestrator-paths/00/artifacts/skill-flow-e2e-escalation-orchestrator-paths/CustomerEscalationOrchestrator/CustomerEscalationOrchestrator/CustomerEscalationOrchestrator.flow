        },
        "engineeringNeeded": {
          "source": "=js:$vars.classify.output.engineeringNeeded"
        },
        "responseMode": {
          "source": "=js:$vars.classify.output.responseMode"
        },
        "caseKey": {
          "source": "=js:$vars.start.output.correlationId"
        },
        "slackMessageId": {
          "source": "=js:$vars.slackEscalationAlert1.output.ts"
        }
      }
    },
    {
      "id": "endTriage",
