        }
      }
    },
    {
      "id": "classify",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "classify"
      },
      "inputs": {
        "script": "var sd = $vars.start.output.senderDomain;\nvar cms = $vars.start.output.customerMatchStatus;\nvar dup = $vars.start.output.isDuplicate;\nvar pd = $vars.start.output.productionDown;\nvar wa = $vars.start.output.workaroundAvailable;\n\nvar ep;\nif (!sd || sd === '') {\n  ep = 'missing_domain';\n} else if (cms === 'none') {\n  ep = 'unknown_customer';\n} else if (cms === 'multiple') {\n  ep = 'multiple_matches';\n} else if (dup === true) {\n  ep = 'duplicate';\n} else {\n  ep = 'escalation';\n}\n\nvar sev;\nif (ep === 'escalation') {\n  if (pd === true && wa !== true) {\n    sev = 'Sev1';\n  } else if (pd === true && wa === true) {\n    sev = 'Sev2';\n  } else {\n    sev = 'Sev3';\n  }\n} else {\n  sev = 'informational';\n}\n\nvar eng = (sev === 'Sev1' || sev === 'Sev2');\nvar rm = (ep === 'escalation') ? 'Draft' : 'None';\n\nreturn { escalationPath: ep, severity: sev, engineeringNeeded: eng, responseMode: rm };"
      },
      "outputs": {
        "error": {
          "type": "object",
          "description": "Error information if the node fails.",
          "source": "=Error",
          "var": "error"
        },
        "output": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "routeDecision",
      "type": "core.logic.decision",
      "typeVersion": "1.2",
      "display": {
        "label": "Is Escalation?"
      },
      "inputs": {
        "expression": "$vars.classify.output.escalationPath === 'escalation'"
      },
      "outputs": {
        "matchedCase": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "matchedCase"
        },
        "matchedCaseId": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "matchedCaseId"
        }
      }
    },
    {
      "id": "endEscalation",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End Escalation"
      },
      "inputs": {},
      "outputs": {
        "escalationPath": {
          "source": "=js:$vars.classify.output.escalationPath"
        },
        "severity": {
