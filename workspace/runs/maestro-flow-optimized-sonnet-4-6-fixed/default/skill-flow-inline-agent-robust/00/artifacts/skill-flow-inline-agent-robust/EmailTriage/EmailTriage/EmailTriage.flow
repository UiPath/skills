{
  "id": "71b57c9d-74d3-4812-b0e9-9387d0439f0d",
  "version": "1.9",
  "name": "EmailTriage",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "8b5426ca-7f4b-4229-9acb-c18b9cdb0e74",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "emailClassifier",
      "type": "uipath.agent.autonomous",
      "typeVersion": "1.3",
      "display": {
        "label": "Classify Support Email"
      },
      "inputs": {
        "systemPrompt": "You are an email classification assistant.",
        "userPrompt": "Classify the inbound support email.",
        "model": "gpt-5.4",
        "temperature": 0,
        "maxIterations": 5,
        "agentInputVariables": [
          {
            "id": "start__output__emailSubject",
            "type": "string",
            "binding": "=$vars.start.output.emailSubject",
            "description": "Bound from $vars.start.output.emailSubject"
          },
          {
            "id": "start__output__emailBody",
            "type": "string",
            "binding": "=$vars.start.output.emailBody",
            "description": "Bound from $vars.start.output.emailBody"
          }
        ],
        "agentOutputVariables": [
          {
            "id": "category",
            "type": "string"
          },
          {
            "id": "priority",
            "type": "string"
          }
        ],
        "source": "cac4af44-9739-4e4a-b68e-099528cdec36"
      },
      "outputs": {
        "error": {
          "type": "object",
          "description": "Error information if the node fails.",
          "source": "=Error",
          "var": "error"
        },
        "output": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {},
      "outputs": {
        "category": {
          "source": "=js:$vars.emailClassifier.output.category"
        },
        "priority": {
          "source": "=js:$vars.emailClassifier.output.priority"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "edge_start_output_emailClassifier_input",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "emailClassifier",
      "targetPort": "input"
    },
    {
      "id": "edge_emailClassifier_success_end_input",
      "sourceNodeId": "emailClassifier",
      "sourcePort": "success",
      "targetNodeId": "end",
      "targetPort": "input"
    }
  ],
  "definitions": [
    {
