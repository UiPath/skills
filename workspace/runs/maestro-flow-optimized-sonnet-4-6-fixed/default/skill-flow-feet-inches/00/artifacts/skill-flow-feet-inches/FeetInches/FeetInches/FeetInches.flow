{
  "id": "8e3f3dd3-1f5c-4eb6-91cd-74cb42719d39",
  "version": "1.9",
  "name": "FeetInches",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "1b57fb07-3f63-4948-b137-6bfcbee3bb59",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "switchDirection",
      "type": "core.logic.switch",
      "typeVersion": "1.1",
      "display": {
        "label": "Switch on direction"
      },
      "inputs": {
        "cases": [
          {
            "id": "f2i",
            "label": "Feet to Inches",
            "expression": "$vars.start.output.direction === 'f2i'"
          },
          {
            "id": "i2f",
            "label": "Inches to Feet",
            "expression": "$vars.start.output.direction === 'i2f'"
          },
          {
            "id": "y2f",
            "label": "Yards to Feet",
            "expression": "$vars.start.output.direction === 'y2f'"
          }
        ]
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails.",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "convertF2I",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Feet to Inches (× 12)"
      },
      "inputs": {
        "script": "return { converted: $vars.start.output.value * 12 };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails.",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "convertI2F",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Inches to Feet (÷ 12)"
      },
      "inputs": {
        "script": "return { converted: $vars.start.output.value / 12 };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails.",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "convertY2F",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Yards to Feet (× 3)"
      },
      "inputs": {
        "script": "return { converted: $vars.start.output.value * 3 };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails.",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {},
      "outputs": {
        "result": {
          "source": "=js:$vars.convertF2I.output.converted ?? $vars.convertI2F.output.converted ?? $vars.convertY2F.output.converted"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "edge_start_output_switchDirection_input",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "switchDirection",
      "targetPort": "input"
    },
    {
      "id": "edge_switchDirection_case-f2i_convertF2I_input",
      "sourceNodeId": "switchDirection",
      "sourcePort": "case-f2i",
      "targetNodeId": "convertF2I",
      "targetPort": "input"
    },
    {
      "id": "edge_switchDirection_case-i2f_convertI2F_input",
      "sourceNodeId": "switchDirection",
      "sourcePort": "case-i2f",
      "targetNodeId": "convertI2F",
      "targetPort": "input"
    },
    {
      "id": "edge_switchDirection_case-y2f_convertY2F_input",
      "sourceNodeId": "switchDirection",
      "sourcePort": "case-y2f",
      "targetNodeId": "convertY2F",
      "targetPort": "input"
    },
    {
      "id": "edge_convertF2I_success_end_input",
      "sourceNodeId": "convertF2I",
      "sourcePort": "success",
      "targetNodeId": "end",
      "targetPort": "input"
    },
    {
      "id": "edge_convertI2F_success_end_input",
      "sourceNodeId": "convertI2F",
      "sourcePort": "success",
      "targetNodeId": "end",
      "targetPort": "input"
    },
    {
      "id": "edge_convertY2F_success_end_input",
      "sourceNodeId": "convertY2F",
      "sourcePort": "success",
      "targetNodeId": "end",
      "targetPort": "input"
    }
  ],
  "definitions": [
    {
