{
  "id": "67ff7386-8560-4c01-955d-c131d687189c",
  "version": "1.9",
  "name": "BillingDiscrepancyDetector",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "ac2c0220-d7ab-4ee1-818a-be227aabd8a9",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "queryErpInvoiceLines1",
      "type": "uipath.connector.uipath-uipath-dataservice.query-entity-records",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Query ERP Invoice Lines"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-uipath-dataservice",
          "connectionId": "d61e5d0e-04af-4f93-95cc-151d81fa08dc",
          "connectionResourceId": "d61e5d0e-04af-4f93-95cc-151d81fa08dc",
          "connectionFolderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "method": "POST",
          "endpoint": "/v2/BillingDisputeERP/qer",
          "queryParameters": {
            "tenantEntityName": "\"BillingDisputeERP\"",
            "queryExpression": "=js:\"invoiceNumber = '\" + String($vars.start.output.invoiceNumber) + \"'\""
          },
          "pathParameters": {
            "entityName": "BillingDisputeERP"
          },
          "uiPathActivityTypeId": "703065b9-a310-33b8-9d4d-12df0a6f520b",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"connectorVersion\":\"1.73.0-dev.2\",\"customFieldsRequestDetails\":{\"objectActionName\":\"GenerateSchema\",\"parameterValues\":[[\"entityName\",\"BillingDisputeERP\"]]},\"instanceParameters\":{\"connectorKey\":\"uipath-uipath-dataservice\",\"objectName\":\"QueryEntityRecordsCurated\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"QueryEntityRecordsCurated\",\"operation\":\"list\",\"packageVersion\":\"1.0.0\",\"httpMethod\":\"POST\",\"path\":\"/v2/{entityName}/qer\",\"unifiedTypesCompatible\":true}}",
          "inputMetadata": {
            "operation": "list",
            "pagination": {
              "maxPageSize": 1000
            }
          }
        }
      }
    },
    {
      "id": "queryCrmAccount1",
      "type": "uipath.connector.uipath-uipath-dataservice.query-entity-records",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Query CRM Account"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-uipath-dataservice",
          "connectionId": "d61e5d0e-04af-4f93-95cc-151d81fa08dc",
          "connectionResourceId": "d61e5d0e-04af-4f93-95cc-151d81fa08dc",
          "connectionFolderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "method": "POST",
          "endpoint": "/v2/BillingDisputeCRM/qer",
          "queryParameters": {
            "tenantEntityName": "\"BillingDisputeCRM\"",
            "queryExpression": "=js:\"accountNumber = '\" + String($vars.start.output.accountNumber) + \"'\""
          },
          "pathParameters": {
            "entityName": "BillingDisputeCRM"
          },
          "uiPathActivityTypeId": "703065b9-a310-33b8-9d4d-12df0a6f520b",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"connectorVersion\":\"1.73.0-dev.2\",\"customFieldsRequestDetails\":{\"objectActionName\":\"GenerateSchema\",\"parameterValues\":[[\"entityName\",\"BillingDisputeCRM\"]]},\"instanceParameters\":{\"connectorKey\":\"uipath-uipath-dataservice\",\"objectName\":\"QueryEntityRecordsCurated\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"QueryEntityRecordsCurated\",\"operation\":\"list\",\"packageVersion\":\"1.0.0\",\"httpMethod\":\"POST\",\"path\":\"/v2/{entityName}/qer\",\"unifiedTypesCompatible\":true}}",
          "inputMetadata": {
            "operation": "list",
            "pagination": {
              "maxPageSize": 1000
            }
          }
        }
      }
    },
    {
      "id": "mergeBranches",
      "type": "core.logic.merge",
      "typeVersion": "1.0",
      "display": {
        "label": "Merge Branches"
      },
      "inputs": {},
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails.",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "computeResult",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Compute Result"
      },
      "inputs": {
        "script": "var erpRows = $vars.queryErpInvoiceLines1.output;\nvar crmRows = $vars.queryCrmAccount1.output;\nvar disputedLineNumber = $vars.start.output.disputedLineNumber;\nvar disputedUnitPrice = $vars.start.output.disputedUnitPrice;\nvar disputedQuantity = $vars.start.output.disputedQuantity;\nvar invoiced = disputedUnitPrice * disputedQuantity;\nvar matchedRow = null;\nif (Array.isArray(erpRows)) {\n  for (var i = 0; i < erpRows.length; i++) {\n    if (Number(erpRows[i].lineNumber) === Number(disputedLineNumber)) {\n      matchedRow = erpRows[i];\n      break;\n    }\n  }\n}\nvar contracted = matchedRow ? Number(matchedRow.amount) : 0;\nvar diff = invoiced - contracted;\nvar totalOvercharge = diff > 0 ? diff : 0;\nvar discrepancyCount = totalOvercharge > 0 ? 1 : 0;\nvar matchedInvoiceNumber = Array.isArray(erpRows) && erpRows.length > 0 ? String(erpRows[0].invoiceNumber) : '';\nvar accountTier = (Array.isArray(crmRows) && crmRows.length > 0 && crmRows[0].accountTier) ? String(crmRows[0].accountTier) : '';\nreturn { totalOvercharge: totalOvercharge, discrepancyCount: discrepancyCount, matchedInvoiceNumber: matchedInvoiceNumber, accountTier: accountTier };"
      },
      "outputs": {
        "error": {
          "type": "object",
          "description": "Error information if the node fails.",
          "source": "=Error",
          "var": "error"
        },
        "output": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "endNode",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {},
      "outputs": {
        "totalOvercharge": {
          "source": "=js:$vars.computeResult.output.totalOvercharge"
        },
        "discrepancyCount": {
          "source": "=js:$vars.computeResult.output.discrepancyCount"
        },
        "matchedInvoiceNumber": {
          "source": "=js:$vars.computeResult.output.matchedInvoiceNumber"
        },
        "accountTier": {
          "source": "=js:$vars.computeResult.output.accountTier"
        }
      }
    }
  ],
