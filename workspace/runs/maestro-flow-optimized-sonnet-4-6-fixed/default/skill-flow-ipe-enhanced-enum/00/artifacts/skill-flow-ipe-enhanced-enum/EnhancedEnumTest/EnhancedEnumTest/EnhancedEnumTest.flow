    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "621259f8-cbd7-43da-a69b-61135e4e85a7",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "getProductReviews1",
      "type": "uipath.connector.uipath-automattic-woocommerce.get-product-reviews",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Get Product Reviews"
      },
      "inputs": {
        "queryParameters": {
          "order": "=js:$vars.resolveOrder.output.order"
        }
      }
    },
    {
      "id": "resolveOrder",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Resolve sort order"
      },
      "inputs": {
        "script": "const label = $vars.sortOrderLabel;\nconst map = { \"Oldest first\": \"asc\", \"Newest first\": \"desc\" };\nreturn { order: map[label] || \"asc\" };"
      },
      "outputs": {
        "error": {
          "type": "object",
          "description": "Error information if the node fails.",
          "source": "=Error",
          "var": "error"
        },
        "output": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "end"
      },
      "inputs": {},
      "outputs": {
        "reviews": {
          "source": "=js:$vars.getProductReviews1.output"
        }
      }
    }
  ],
