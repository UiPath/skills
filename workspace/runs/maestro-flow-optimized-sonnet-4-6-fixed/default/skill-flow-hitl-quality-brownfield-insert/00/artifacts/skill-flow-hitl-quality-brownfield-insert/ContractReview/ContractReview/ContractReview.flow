      "typeVersion": "1.0",
      "display": {
        "label": "Legal Review"
      },
      "inputs": {
        "schema": {
          "schemaId": "b944bb95-64a4-437c-88fc-9dfd44769aca",
          "fields": [
            {
              "id": "contract_id",
              "label": "Contract ID",
              "type": "text",
              "direction": "input",
              "binding": "vars.start.output.contract_id"
            },
            {
              "id": "contract_value",
              "label": "Contract Value",
              "type": "number",
              "direction": "input",
              "binding": "vars.start.output.contract_value"
            },
            {
              "id": "approved",
              "label": "Approved",
              "type": "boolean",
              "direction": "output",
              "variable": "vars.approved",
              "required": true
            },
            {
              "id": "legal_notes",
              "label": "Legal Notes",
              "type": "text",
              "direction": "output",
              "variable": "vars.legalNotes"
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "End"
            }
          ]
        },
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group"
          }
        },
        "priority": "Low"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "output"
        },
        "status": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "status"
        }
      }
    }
  ],
