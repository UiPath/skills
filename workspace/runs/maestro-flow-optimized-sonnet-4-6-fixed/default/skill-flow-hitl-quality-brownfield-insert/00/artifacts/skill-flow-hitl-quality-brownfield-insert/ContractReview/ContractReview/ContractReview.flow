      "display": {
        "label": "extractMeta"
      },
      "inputs": {
        "script": "return { message: 'Extracting contract metadata' };"
      },
      "outputs": {
        "error": {
          "type": "object",
          "description": "Error information if the node fails.",
          "source": "=Error",
          "var": "error"
        },
        "output": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "output"
