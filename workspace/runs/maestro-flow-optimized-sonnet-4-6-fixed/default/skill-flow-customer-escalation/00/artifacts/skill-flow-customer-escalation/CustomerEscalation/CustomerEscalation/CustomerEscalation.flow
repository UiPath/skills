    {
      "id": "classifyUrgency1",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Classify Urgency"
      },
      "inputs": {
        "script": "const subj = ($vars.emailReceived1.output.subject || \"\").toLowerCase();\nconst preview = ($vars.emailReceived1.output.bodyPreview || \"\").toLowerCase();\nconst urgentKeywords = [\"urgent\",\"asap\",\"critical\",\"emergency\",\"immediate\",\"p0\",\"outage\",\"down\",\"blocked\",\"sev1\",\"high priority\",\"time sensitive\",\"escalate\",\"breached\",\"failure\",\"production issue\"];\nconst text = subj + \" \" + preview;\nconst isUrgent = urgentKeywords.some(function(kw){return text.indexOf(kw) !== -1;});\nreturn {isUrgent: isUrgent};"
      },
      "outputs": {
        "error": {
          "type": "object",
          "description": "Error information if the node fails.",
          "source": "=Error",
          "var": "error"
        },
        "output": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "classifyVip1",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Classify VIP"
      },
      "inputs": {
        "script": "const email = $vars.emailReceived1.output;\nconst fromObj = email.from || \"\";\nconst fromStr = typeof fromObj === \"object\" && fromObj && fromObj.emailAddress ? (fromObj.emailAddress.address || \"\") : String(fromObj || \"\");\nconst addr = fromStr.toLowerCase();\nconst vipDomains = [\"enterprise.com\",\"premier.com\",\"platinum.com\",\"vip.com\",\"strategic.com\",\"globalcorp.com\",\"fortune500.com\"];\nconst vipPrefixes = [\"ceo@\",\"cto@\",\"cfo@\",\"president@\",\"vp@\",\"svp@\",\"evp@\",\"director@\",\"partner@\",\"head@\"];\nconst isVipDomain = vipDomains.some(function(d){return addr.indexOf(d) !== -1;});\nconst isVipTitle = vipPrefixes.some(function(p){return addr.indexOf(p) !== -1;});\nreturn {isVip: isVipDomain || isVipTitle, senderAddress: addr};"
      },
      "outputs": {
        "error": {
          "type": "object",
          "description": "Error information if the node fails.",
          "source": "=Error",
          "var": "error"
        },
        "output": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "routeDecision1",
      "type": "core.logic.decision",
      "typeVersion": "1.2",
      "display": {
        "label": "Route: Urgent AND VIP"
      },
      "inputs": {
        "expression": "$vars.classifyUrgency1.output.isUrgent && $vars.classifyVip1.output.isVip",
        "trueLabel": "High-Touch",
        "falseLabel": "Standard"
      },
      "outputs": {
        "matchedCase": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "matchedCase"
        },
        "matchedCaseId": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "matchedCaseId"
        }
      }
    },
    {
      "id": "generateTicket1",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Generate Support Ticket"
      },
      "inputs": {
        "script": "const email = $vars.emailReceived1.output;\nconst subj = email.subject || \"No Subject\";\nconst fromObj = email.from || \"\";\nconst fromAddr = typeof fromObj === \"object\" && fromObj && fromObj.emailAddress ? (fromObj.emailAddress.address || \"\") : String(fromObj || \"\");\nconst ts = String(Date.now ? Date.now() : 0).slice(-6);\nconst ticketId = \"TKT-\" + ts;\nconst replyBody = \"Thank you for contacting support.\\n\\nWe have created ticket \" + ticketId + \" for your request.\\nSubject: \" + subj + \"\\n\\nOur support team will respond within 24 business hours. Please reference ticket ID \" + ticketId + \" in any future correspondence.\\n\\nBest regards,\\nSupport Team\";\nreturn {ticketId: ticketId, replyBody: replyBody, subject: subj, senderAddress: fromAddr};"
      },
      "outputs": {
        "error": {
          "type": "object",
          "description": "Error information if the node fails.",
          "source": "=Error",
          "var": "error"
        },
        "output": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "endHighTouch",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End High-Touch"
      },
      "inputs": {}
    },
    {
      "id": "endStandard",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End Standard"
      },
      "inputs": {}
    }
  ],
