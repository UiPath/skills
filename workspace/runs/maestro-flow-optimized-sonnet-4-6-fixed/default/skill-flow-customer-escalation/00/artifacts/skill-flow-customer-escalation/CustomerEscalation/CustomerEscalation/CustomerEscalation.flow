    {
      "id": "replyVipAck1",
      "type": "uipath.connector.uipath-microsoft-outlook365.reply-to-email",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Reply VIP Ack"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-microsoft-outlook365",
          "connectionId": "75dfafb4-3717-470c-a5f6-bdc144757a67",
          "connectionResourceId": "75dfafb4-3717-470c-a5f6-bdc144757a67",
          "connectionFolderKey": "5da18ec0-7de1-4e57-aaf1-ddc8a369c199",
          "method": "POST",
          "endpoint": "/ReplyToEmailV2",
          "bodyParameters": {
            "body": "=js:\"Thank you for reaching out. Your request has been flagged as high-priority and our senior support team is on it. You will hear back from us within 2 hours. We appreciate your patience.\""
          },
          "queryParameters": {
            "saveAsDraft": false
          },
          "pathParameters": {
            "id": "=js:$vars.emailReceived1.output.id"
          },
