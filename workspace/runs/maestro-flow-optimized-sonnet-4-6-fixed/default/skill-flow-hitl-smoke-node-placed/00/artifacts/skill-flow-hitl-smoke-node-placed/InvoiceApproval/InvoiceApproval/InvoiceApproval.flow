  ],
  "variables": {
    "globals": [
      {
        "id": "invoiceId",
        "direction": "in",
        "type": "string",
        "description": "Invoice identifier passed to the flow"
      },
      {
        "id": "invoiceAmount",
        "direction": "in",
        "type": "number",
        "description": "Invoice amount in currency units"
      },
      {
        "id": "reviewDecision",
        "direction": "out",
        "type": "string",
        "description": "Outcome selected by the finance manager: Approve or Reject"
      }
    ],
    "nodes": [
      {
        "id": "start.output",
        "type": "object",
        "description": "Data passed when manually triggering the process.",
        "binding": {
          "nodeId": "start",
          "outputId": "output"
        }
      },
      {
        "id": "invoiceReview.output",
        "type": "object",
        "description": "The return value of the node.",
        "binding": {
          "nodeId": "invoiceReview",
          "outputId": "output"
        }
      },
      {
        "id": "invoiceReview.status",
        "type": "object",
        "description": "The return value of the node.",
        "binding": {
          "nodeId": "invoiceReview",
          "outputId": "status"
        }
      },
      {
        "id": "endNode.reviewDecision",
        "type": "string",
        "binding": {
          "nodeId": "endNode",
          "outputId": "reviewDecision"
        }
      }
    ]
  },
