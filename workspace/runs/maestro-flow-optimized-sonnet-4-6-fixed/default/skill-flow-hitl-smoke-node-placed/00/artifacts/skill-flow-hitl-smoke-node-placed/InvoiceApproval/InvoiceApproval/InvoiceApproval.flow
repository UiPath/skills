{
  "id": "d811e979-f8a7-46a5-a2b0-f39039203402",
  "version": "1.9",
  "name": "InvoiceApproval",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "fac0b9b2-f1ea-4037-b4bb-20c7d1e6bac3",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "invoiceReview",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "Finance Manager Review"
      },
      "inputs": {
        "title": "Invoice Approval Request",
        "priority": "Medium",
        "schema": {
          "schemaId": "1aadacc3-52d2-47c3-9fd1-46979db7711e",
          "fields": [
            {
              "id": "invoiceId",
              "label": "Invoice ID",
              "type": "text",
              "direction": "input",
              "binding": "vars.start.output.invoiceId"
            },
            {
              "id": "amount",
              "label": "Amount",
              "type": "number",
              "direction": "input",
              "binding": "vars.start.output.invoiceAmount"
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "End"
            }
          ]
        },
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group"
          }
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "output"
        },
        "status": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "status"
        }
      }
    },
    {
      "id": "endNode",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {},
      "outputs": {
        "reviewDecision": {
          "source": "=js:$vars.invoiceReview.status"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "edge_start_output_invoiceReview_input",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "invoiceReview",
      "targetPort": "input"
    },
    {
      "id": "edge_invoiceReview_completed_endNode_input",
      "sourceNodeId": "invoiceReview",
      "sourcePort": "completed",
      "targetNodeId": "endNode",
      "targetPort": "input"
    }
  ],
  "definitions": [
    {
      "nodeType": "core.trigger.manual",
      "version": "1.0",
      "category": "trigger",
      "description": "Start the process manually",
      "tags": [
        "trigger",
        "start",
        "manual"
      ],
      "sortOrder": 80,
      "display": {
        "label": "Manual trigger",
        "icon": "play",
        "shape": "circle"
      },
      "handleConfiguration": [
        {
          "position": "right",
          "handles": [
            {
              "id": "output",
              "type": "source",
              "handleType": "output",
              "showButton": true,
              "constraints": {
                "forbiddenTargetCategories": [
                  "trigger"
                ]
              }
            }
          ],
          "visible": true
        }
      ],
      "model": {
        "type": "bpmn:StartEvent",
        "entryPointId": true
      },
      "outputDefinition": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the process.",
          "source": "null",
          "var": "output"
        }
      },
      "toolbarExtensions": {
