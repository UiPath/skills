{
  "id": "db32dbee-5b9d-47a4-aeb1-7c219b96877f",
  "version": "1.9",
  "name": "ExpenseApproval",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "11c2ab51-6279-4e0c-8b8f-570de68c07f5",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "loadExpense",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Load Expense Data"
      },
      "inputs": {
        "script": "return {\n  expenseId: \"EXP-2024-0847\",\n  submitter: \"Jane Smith\",\n  amount: 1250.00,\n  category: \"Travel\"\n};"
      },
      "outputs": {
        "error": {
          "type": "object",
          "description": "Error information if the node fails.",
          "source": "=Error",
          "var": "error"
        },
        "output": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "managerReview",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "Manager Review"
      },
      "inputs": {
        "title": "Expense Report Approval Required",
        "priority": "Medium",
        "schema": {
          "schemaId": "2496a74d-dc8d-40e6-8d37-a0cb89042d52",
          "fields": [
            {
              "id": "expenseId",
              "label": "Expense ID",
              "type": "text",
              "direction": "input",
              "binding": "vars.loadExpense.output.expenseId"
            },
            {
              "id": "submitter",
              "label": "Submitted By",
              "type": "text",
              "direction": "input",
              "binding": "vars.loadExpense.output.submitter"
            },
            {
              "id": "amount",
              "label": "Amount ($)",
              "type": "number",
              "direction": "input",
              "binding": "vars.loadExpense.output.amount"
            },
            {
              "id": "category",
              "label": "Category",
              "type": "text",
              "direction": "input",
              "binding": "vars.loadExpense.output.category"
            },
            {
              "id": "reason",
              "label": "Rejection Reason (optional)",
              "type": "text",
              "direction": "output",
              "variable": "vars.rejectionReason"
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "Continue"
            }
          ]
        },
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group",
            "name": "expense-approvers"
          }
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "output"
        },
        "status": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "status"
        }
      }
    },
    {
      "id": "buildSummary",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Build Approval Summary"
      },
      "inputs": {
        "script": "const decision = $vars.managerReview.status;\nconst reason = $vars.managerReview.output.reason;\nconst expenseId = $vars.loadExpense.output.expenseId;\nconst submitter = $vars.loadExpense.output.submitter;\nconst amount = $vars.loadExpense.output.amount;\nconst category = $vars.loadExpense.output.category;\nlet summary = \"Expense \" + expenseId + \" | Submitter: \" + submitter + \" | Amount: $\" + amount + \" | Category: \" + category + \" | Decision: \" + decision;\nif (reason) {\n  summary += \" | Reason: \" + reason;\n}\nreturn { approvalSummary: summary };"
      },
      "outputs": {
        "error": {
          "type": "object",
          "description": "Error information if the node fails.",
          "source": "=Error",
          "var": "error"
        },
        "output": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {},
      "outputs": {
        "approvalSummary": {
          "source": "=js:$vars.buildSummary.output.approvalSummary"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "edge_start_output_loadExpense_input",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "loadExpense",
      "targetPort": "input"
    },
    {
      "id": "edge_loadExpense_success_managerReview_input",
      "sourceNodeId": "loadExpense",
      "sourcePort": "success",
      "targetNodeId": "managerReview",
      "targetPort": "input"
    },
    {
      "id": "edge_managerReview_completed_buildSummary_input",
      "sourceNodeId": "managerReview",
      "sourcePort": "completed",
      "targetNodeId": "buildSummary",
      "targetPort": "input"
    },
    {
      "id": "edge_buildSummary_success_end_input",
      "sourceNodeId": "buildSummary",
      "sourcePort": "success",
      "targetNodeId": "end",
      "targetPort": "input"
    }
  ],
  "definitions": [
    {
