{
  "id": "d4e481df-efc2-4bce-b8a2-2b7d0c569bc6",
  "version": "1.9",
  "name": "CustomerEscalationTriage",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "7262c110-7e7a-43b3-836f-d3f2cee96f78",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "checkSev1",
      "type": "core.logic.decision",
      "typeVersion": "1.2",
      "display": {
        "label": "Is Sev1?"
      },
      "inputs": {
        "expression": "$vars.start.output.customerTier === \"Enterprise\" && $vars.start.output.productionDown === true && $vars.start.output.workaroundAvailable === false",
        "trueLabel": "Sev1",
        "falseLabel": "Not Sev1"
      },
      "outputs": {
        "matchedCase": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "matchedCase"
        },
        "matchedCaseId": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "matchedCaseId"
        }
      }
    },
    {
      "id": "checkSev2",
      "type": "core.logic.decision",
      "typeVersion": "1.2",
      "display": {
        "label": "Is Sev2?"
      },
      "inputs": {
        "expression": "$vars.start.output.productionDown === true && $vars.start.output.workaroundAvailable === true",
        "trueLabel": "Sev2",
        "falseLabel": "Sev3"
      },
      "outputs": {
        "matchedCase": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "matchedCase"
        },
        "matchedCaseId": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "matchedCaseId"
        }
      }
    },
    {
      "id": "setSev1",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Set Sev1 Outputs"
      },
      "inputs": {
        "script": "return { severity: \"Sev1\", engineeringNeeded: true, responseMode: \"Draft\", caseKey: $vars.start.output.correlationId };"
      },
      "outputs": {
        "error": {
          "type": "object",
          "description": "Error information if the node fails.",
          "source": "=Error",
          "var": "error"
        },
        "output": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "setSev2",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Set Sev2 Outputs"
      },
      "inputs": {
        "script": "return { severity: \"Sev2\", engineeringNeeded: true, responseMode: \"Draft\", caseKey: $vars.start.output.correlationId };"
      },
      "outputs": {
