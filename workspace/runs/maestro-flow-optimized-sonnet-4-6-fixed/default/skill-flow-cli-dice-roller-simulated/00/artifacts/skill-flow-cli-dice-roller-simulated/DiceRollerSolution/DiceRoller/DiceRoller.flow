{
  "id": "5abc093a-f643-4eec-9d13-576f2f614f5b",
  "version": "1.9",
  "name": "DiceRoller",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "06692047-f699-4208-8da0-0e92a33ba1d6",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "rollDice",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Roll Dice"
      },
      "inputs": {
        "script": "return { roll: Math.floor(Math.random() * 6) + 1 };"
      },
      "outputs": {
        "error": {
          "type": "object",
          "description": "Error information if the node fails.",
          "source": "=Error",
          "var": "error"
        },
        "output": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "diceEnd",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {},
      "outputs": {
        "roll": {
          "source": "=js:$vars.rollDice.output.roll"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "edge_start_output_rollDice_input",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "rollDice",
      "targetPort": "input"
    },
    {
      "id": "edge_rollDice_success_diceEnd_input",
      "sourceNodeId": "rollDice",
      "sourcePort": "success",
      "targetNodeId": "diceEnd",
      "targetPort": "input"
    }
  ],
