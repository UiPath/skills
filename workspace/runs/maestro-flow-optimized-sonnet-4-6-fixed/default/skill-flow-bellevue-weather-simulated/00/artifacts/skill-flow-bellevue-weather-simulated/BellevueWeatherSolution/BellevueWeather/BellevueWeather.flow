{
  "id": "66ed3e21-325f-4603-add8-0d7420458072",
  "version": "1.9",
  "name": "BellevueWeather",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "1860a835-6901-49be-8d26-f5adc9c22380",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "getCurrentWeather1",
      "type": "uipath.connector.custom-codereval-openmeteoapis.getcurrentweather",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Get Current Weather"
      },
      "inputs": {
        "detail": {
          "connector": "custom-codereval-openmeteoapis",
          "connectionId": "21ca654f-b67b-4f97-9eb3-1f93bd3bb5cc",
          "connectionResourceId": "21ca654f-b67b-4f97-9eb3-1f93bd3bb5cc",
          "connectionFolderKey": "5da18ec0-7de1-4e57-aaf1-ddc8a369c199",
          "method": "GET",
          "endpoint": "/forecast",
          "queryParameters": {
            "latitude": 47.6101,
            "longitude": -122.2015,
            "current_weather": true,
            "temperature_unit": "celsius",
            "timezone": "America/Los_Angeles"
          },
          "uiPathActivityTypeId": "e39eee57-b09f-36fb-b131-4f4feb46b707",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"connectorVersion\":\"1.5.0\",\"customFieldsRequestDetails\":null,\"instanceParameters\":{\"connectorKey\":\"custom-codereval-openmeteoapis\",\"objectName\":\"V1Forecast\",\"httpMethod\":\"GETBYID\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"V1Forecast\",\"operation\":\"retrieve\",\"packageVersion\":\"1.0.0\",\"httpMethod\":\"GET\",\"path\":\"/forecast\",\"unifiedTypesCompatible\":true}}"
        }
      }
    },
    {
      "id": "evaluateWeather",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Evaluate Weather"
      },
      "inputs": {
        "script": "const weather = $vars.getCurrentWeather1.output;\nconst tempC = weather && weather.current_weather && weather.current_weather.temperature;\nconst tempF = tempC != null ? (tempC * 9/5) + 32 : null;\nconst isNiceDay = tempF != null && tempF > 60;\nconst verdict = isNiceDay ? 'Nice day!' : 'Bring a jacket.';\nlet summary;\nif (tempF == null) {\n  summary = 'Weather data could not be retrieved for Bellevue, WA.';\n} else {\n  const condition = weather.current_weather.weathercode;\n  const wind = weather.current_weather.windspeed;\n  summary = `Current temperature in Bellevue, WA is ${tempF.toFixed(1)}\\u00b0F (${tempC.toFixed(1)}\\u00b0C) with wind speed ${wind} km/h. ${verdict}`;\n}\nreturn { temperatureF: tempF, isNiceDay: isNiceDay, verdict: verdict, summary: summary };"
      },
      "outputs": {
        "error": {
          "type": "object",
          "description": "Error information if the node fails.",
          "source": "=Error",
          "var": "error"
        },
        "output": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "endNode",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {},
      "outputs": {
        "verdict": {
          "source": "=js:$vars.evaluateWeather.output.verdict"
        },
        "summary": {
          "source": "=js:$vars.evaluateWeather.output.summary"
        },
        "isNiceDay": {
          "source": "=js:$vars.evaluateWeather.output.isNiceDay"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "edge_start_output_getCurrentWeather1_input",
      "sourceNodeId": "start",
      "sourcePort": "output",
