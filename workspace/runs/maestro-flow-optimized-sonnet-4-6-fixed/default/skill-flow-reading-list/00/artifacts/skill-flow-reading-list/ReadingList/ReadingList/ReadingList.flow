{
  "id": "25c30b73-6058-4499-a5c2-6db578180249",
  "version": "1.9",
  "name": "ReadingList",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "6034bbd4-c8df-4db4-bc12-0e02623148a5",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "loadCatalog",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Load Catalog"
      },
      "inputs": {
        "script": "return { catalog: [{\"title\":\"Linear Algebra Done Right\",\"author\":\"Axler\",\"field\":\"math\",\"difficulty\":6,\"pages\":340},{\"title\":\"Deep Learning\",\"author\":\"Goodfellow\",\"field\":\"ml\",\"difficulty\":9,\"pages\":800},{\"title\":\"Statistical Learning\",\"author\":\"James\",\"field\":\"data science\",\"difficulty\":4,\"pages\":440},{\"title\":\"Elements of Statistical Learning\",\"author\":\"Hastie\",\"field\":\"stats\",\"difficulty\":9,\"pages\":745},{\"title\":\"Bayesian Data Analysis\",\"author\":\"Gelman\",\"field\":\"stats\",\"difficulty\":8,\"pages\":580},{\"title\":\"Python for Data Analysis\",\"author\":\"McKinney\",\"field\":\"data science\",\"difficulty\":3,\"pages\":550},{\"title\":\"Probability Theory\",\"author\":\"Jaynes\",\"field\":\"math\",\"difficulty\":10,\"pages\":753},{\"title\":\"Information Theory\",\"author\":\"MacKay\",\"field\":\"ml\",\"difficulty\":7,\"pages\":540}] };"
      },
      "outputs": {
        "error": {
          "type": "object",
          "description": "Error information if the node fails.",
          "source": "=Error",
          "var": "error"
        },
        "output": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "curateReadingList",
      "type": "core.action.transform",
      "typeVersion": "1.1",
      "display": {
        "label": "Curate Reading List"
      },
      "inputs": {
        "collection": "$vars.loadCatalog.output.catalog",
        "operations": [
          {
            "id": "op1",
            "type": "filter",
            "config": {
              "operation": "and",
              "filters": [
                {
                  "id": "f1",
                  "field": "difficulty",
                  "condition": "greater_than",
                  "value": 5
                },
                {
                  "id": "f2",
                  "field": "pages",
                  "condition": "less_than",
                  "value": 600
                }
              ]
            }
          },
          {
            "id": "op2",
            "type": "map",
            "config": {
              "keepOriginalFields": false,
              "mappings": [
                {
                  "id": "m1",
                  "field": "title",
                  "transformation": "uppercase",
                  "renameTo": ""
                },
                {
                  "id": "m2",
                  "field": "author",
                  "transformation": "copy",
                  "renameTo": ""
                }
              ]
            }
          }
        ]
      },
      "outputs": {
        "error": {
          "type": "object",
          "description": "Error information if the node fails.",
          "source": "=Error",
          "var": "error"
        },
        "output": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {},
      "outputs": {
        "readingList": {
          "source": "=js:$vars.curateReadingList.output"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "edge_start_output_loadCatalog_input",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "loadCatalog",
      "targetPort": "input"
    },
    {
      "id": "edge_loadCatalog_success_curateReadingList_input",
      "sourceNodeId": "loadCatalog",
      "sourcePort": "success",
      "targetNodeId": "curateReadingList",
      "targetPort": "input"
    },
    {
      "id": "edge_curateReadingList_output_end_input",
      "sourceNodeId": "curateReadingList",
      "sourcePort": "output",
      "targetNodeId": "end",
      "targetPort": "input"
    }
  ],
  "definitions": [
    {
      "nodeType": "core.trigger.manual",
