      "id": "slackAlertToChannel1",
      "type": "uipath.connector.uipath-salesforce-slack.send-message-to-channel",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Slack Alert to Channel"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-salesforce-slack",
          "connectionId": "849e85d8-1aa9-4d52-8bbd-20041c8f05d8",
          "connectionResourceId": "849e85d8-1aa9-4d52-8bbd-20041c8f05d8",
          "connectionFolderKey": "5da18ec0-7de1-4e57-aaf1-ddc8a369c199",
          "method": "POST",
          "endpoint": "/send_message_to_channel_v2",
          "bodyParameters": {
            "channel": "C01G1P7CU58",
            "messageToSend": "=js:'\\ud83d\\udea8 VIP Escalation \\u2014 ' + ($vars.emailReceived1.output.subject || '(no subject)') + ' \\u2014 From: ' + ($vars.emailReceived1.output.from || 'unknown')"
          },
          "uiPathActivityTypeId": "37a305b2-89b1-315d-b73f-1778839a6c47",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"connectorVersion\":\"2.14.8\",\"customFieldsRequestDetails\":null,\"instanceParameters\":{\"connectorKey\":\"uipath-salesforce-slack\",\"objectName\":\"send_message_to_channel_v2\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"send_message_to_channel_v2\",\"operation\":\"create\",\"packageVersion\":\"1.0.0\",\"httpMethod\":\"POST\",\"path\":\"/send_message_to_channel_v2\",\"unifiedTypesCompatible\":true,\"savedJitInputFieldId\":\"in_send_message_to_channel_v2\"}}"
        }
      }
    },
    {
      "id": "replyAcknowledgmentToSender1",
      "type": "uipath.connector.uipath-mock-outlook.reply-to-email",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Reply Acknowledgment to Sender"
      },
      "inputs": {}
    },
    {
      "id": "createFreshdeskTicket1",
      "type": "uipath.connector.uipath-freshworks-freshdesk.create-ticket",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Create Freshdesk Ticket"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-freshworks-freshdesk",
          "connectionId": "29aae689-111d-459f-9a4a-d1ad1d9d2761",
          "connectionResourceId": "29aae689-111d-459f-9a4a-d1ad1d9d2761",
          "connectionFolderKey": "b262689d-e2a9-4c1a-8e68-04382a7fff76",
          "method": "POST",
          "endpoint": "/tickets",
          "bodyParameters": {
            "subject": "=js:$vars.emailReceived1.output.subject || 'Support Request'",
            "description": "=js:$vars.emailReceived1.output.body || 'No message body'",
            "email": "=js:$vars.emailReceived1.output.from",
            "priority": 2,
            "status": 2
          },
          "uiPathActivityTypeId": "489bd332-d516-3ad9-b23f-b21bb4fd1a2b",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"connectorVersion\":\"1.2.16\",\"customFieldsRequestDetails\":null,\"instanceParameters\":{\"connectorKey\":\"uipath-freshworks-freshdesk\",\"objectName\":\"tickets\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"tickets\",\"operation\":\"create\",\"packageVersion\":\"1.0.0\",\"httpMethod\":\"POST\",\"path\":\"/tickets\",\"unifiedTypesCompatible\":true,\"savedJitInputFieldId\":\"in_tickets\"}}"
        }
      }
    },
    {
      "id": "replyWithTicketDetails1",
      "type": "uipath.connector.uipath-mock-outlook.reply-to-email",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Reply with Ticket Details"
      },
      "inputs": {}
    },
    {
      "id": "checkUrgencyAndVip",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Check Urgency and VIP"
      },
      "inputs": {
        "script": "var subject = $vars.emailReceived1.output.subject || '';\nvar body = $vars.emailReceived1.output.body || '';\nvar fromEmail = $vars.emailReceived1.output.from || '';\n\nvar urgentKeywords = ['urgent', 'critical', 'asap', 'emergency', 'immediate'];\nvar combined = (subject + ' ' + body).toLowerCase();\nvar isUrgent = urgentKeywords.some(function(k) { return combined.indexOf(k) !== -1; });\n\nvar vipDomains = ['bigclient.com', 'enterprise.com', 'premiercorp.com', 'platinum.com'];\nvar vipEmails = ['ceo@anycompany.com', 'vip@keyaccount.com'];\nvar emailLower = fromEmail.toLowerCase();\nvar isVip = vipDomains.some(function(d) { return emailLower.indexOf('@' + d) !== -1; }) ||\n             vipEmails.some(function(e) { return emailLower === e; });\n\nreturn {\n  isUrgent: isUrgent,\n  isVip: isVip,\n  fromEmail: fromEmail,\n  subject: subject\n};"
      },
      "outputs": {
        "error": {
          "type": "object",
          "description": "Error information if the node fails.",
          "source": "=Error",
          "var": "error"
        },
        "output": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "routeDecision",
      "type": "core.logic.decision",
      "typeVersion": "1.2",
      "display": {
        "label": "Urgent and VIP"
      },
      "inputs": {
        "expression": "$vars.checkUrgencyAndVip.output.isUrgent && $vars.checkUrgencyAndVip.output.isVip",
        "trueLabel": "Urgent and VIP",
        "falseLabel": "Standard"
      },
      "outputs": {
        "matchedCase": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "matchedCase"
        },
        "matchedCaseId": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "matchedCaseId"
        }
      }
    },
    {
      "id": "doneVip",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Done VIP Escalation"
      },
      "inputs": {}
    },
    {
      "id": "doneStandard",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Done Standard Ticket"
      },
      "inputs": {}
    }
  ],
