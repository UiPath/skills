          },
          {
            "id": "discrepancyDetection__output__discrepancies",
            "type": "array",
            "binding": "=$vars.discrepancyDetection.output.discrepancies",
            "description": "Detected discrepancies"
          },
          {
            "id": "discrepancyDetection__output__totalOvercharge",
            "type": "number",
            "binding": "=$vars.discrepancyDetection.output.totalOvercharge",
            "description": "Total overcharge"
          },
          {
            "id": "discrepancyDetection__output__totalUndercharge",
            "type": "number",
            "binding": "=$vars.discrepancyDetection.output.totalUndercharge",
            "description": "Total undercharge"
          },
          {
            "id": "crmLookup1__output",
            "type": "object",
            "binding": "=$vars.crmLookup1.output",
            "description": "CRM account data"
          },
          {
            "id": "start__output__webhookPayload",
            "type": "object",
            "binding": "=$vars.start.output.webhookPayload",
            "description": "Original webhook payload"
          }
        ],
        "agentOutputVariables": [
          {
            "id": "determination",
            "type": "string"
          },
          {
            "id": "recommendedAction",
            "type": "string"
          },
          {
            "id": "autoResolutionEligible",
            "type": "boolean"
          },
          {
            "id": "creditAmount",
            "type": "number"
          },
          {
            "id": "confidence",
            "type": "string"
          },
          {
            "id": "rationale",
            "type": "string"
          }
        ]
      },
      "outputs": {
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "routeByAction",
      "type": "core.logic.switch",
      "typeVersion": "1.1",
      "display": {
        "label": "Route By Action"
      },
      "inputs": {
        "cases": [
          {
            "id": "escalate_to_manager",
            "label": "Escalate to Manager",
            "expression": "$vars.disputeAnalyst.output.recommendedAction === 'escalate_to_manager'"
          },
          {
            "id": "auto_resolve",
            "label": "Auto Resolve",
            "expression": "$vars.disputeAnalyst.output.recommendedAction === 'auto_resolve'"
          },
          {
            "id": "reject",
            "label": "Reject",
            "expression": "$vars.disputeAnalyst.output.recommendedAction === 'reject'"
          }
        ]
      }
    },
    {
      "id": "managerApproval",
      "type": "core.logic.decision",
      "typeVersion": "1.2",
      "display": {
        "label": "Manager Approval"
      },
      "inputs": {
        "expression": "false",
        "trueLabel": "Rejected",
        "falseLabel": "Approved"
      }
    },
    {
      "id": "logCreditAmount",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Log Credit Amount"
      },
      "inputs": {
        "script": "const creditAmount = $vars.disputeAnalyst.output.creditAmount ?? 0;\nreturn { creditAmount, logMessage: `Credit approved: ${creditAmount}` };"
      }
    },
