    {
      "id": "normalizeData",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Normalize Invoice Fields"
      },
      "inputs": {
        "script": "const fields = $vars.invoiceExtraction.output.ExtractionResult?.ResultsDocument?.Fields ?? [];\nconst normalized = fields.map(f => ({ Id: f.FieldId, Name: f.FieldName, Value: f.Values?.[0]?.Value ?? null, Type: f.DataType }));\nreturn { normalizedFields: normalized };"
      }
    },
    {
      "id": "crmLookup1",
      "type": "uipath.connector.uipath-uipath-dataservice.query-entity-records",
      "typeVersion": "1.0.0",
      "display": {
        "label": "CRM Lookup"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-uipath-dataservice",
          "connectionId": "d61e5d0e-04af-4f93-95cc-151d81fa08dc",
          "connectionResourceId": "d61e5d0e-04af-4f93-95cc-151d81fa08dc",
          "connectionFolderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "method": "POST",
          "endpoint": "/v2/{entityName}/qer",
          "bodyParameters": {},
          "queryParameters": {
            "queryExpression": "=js:`accountNumber = ${JSON.stringify($vars.start.output.webhookPayload.customer.accountNumber)}`",
            "limit": 100
          },
          "pathParameters": {
            "entityName": "BillingDisputeCRM"
          },
          "uiPathActivityTypeId": "703065b9-a310-33b8-9d4d-12df0a6f520b",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"connectorVersion\":\"1.73.0-dev.2\",\"customFieldsRequestDetails\":{\"objectActionName\":\"GenerateSchema\",\"parameterValues\":[[\"entityName\",\"BillingDisputeCRM\"]]},\"instanceParameters\":{\"connectorKey\":\"uipath-uipath-dataservice\",\"objectName\":\"QueryEntityRecordsCurated\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"QueryEntityRecordsCurated\",\"operation\":\"list\",\"packageVersion\":\"1.0.0\",\"httpMethod\":\"POST\",\"path\":\"/v2/{entityName}/qer\",\"unifiedTypesCompatible\":true}}",
          "inputMetadata": {
            "operation": "list",
            "pagination": {
