            }
          }
        }
      }
    },
    {
      "id": "erpLookup1",
      "type": "uipath.connector.uipath-uipath-dataservice.query-entity-records",
      "typeVersion": "1.0.0",
      "display": {
        "label": "ERP Lookup"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-uipath-dataservice",
          "connectionId": "d61e5d0e-04af-4f93-95cc-151d81fa08dc",
          "connectionResourceId": "d61e5d0e-04af-4f93-95cc-151d81fa08dc",
          "connectionFolderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "method": "POST",
          "endpoint": "/v2/{entityName}/qer",
          "bodyParameters": {},
          "queryParameters": {
            "queryExpression": "=js:`invoiceNumber = ${JSON.stringify(($vars.start.output.webhookPayload.invoice.invoiceNumber ?? \"\").replace(/^MCS-/, \"\"))}`",
            "limit": 100
          },
          "pathParameters": {
            "entityName": "BillingDisputeERP"
          },
          "uiPathActivityTypeId": "703065b9-a310-33b8-9d4d-12df0a6f520b",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"connectorVersion\":\"1.73.0-dev.2\",\"customFieldsRequestDetails\":{\"objectActionName\":\"GenerateSchema\",\"parameterValues\":[[\"entityName\",\"BillingDisputeERP\"]]},\"instanceParameters\":{\"connectorKey\":\"uipath-uipath-dataservice\",\"objectName\":\"QueryEntityRecordsCurated\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"QueryEntityRecordsCurated\",\"operation\":\"list\",\"packageVersion\":\"1.0.0\",\"httpMethod\":\"POST\",\"path\":\"/v2/{entityName}/qer\",\"unifiedTypesCompatible\":true}}",
          "inputMetadata": {
            "operation": "list",
            "pagination": {
              "maxPageSize": 1000
            }
          }
        }
      }
    },
    {
      "id": "mergeLookups",
      "type": "core.logic.merge",
      "typeVersion": "1.0",
      "display": {
        "label": "Merge Lookups"
      }
    },
    {
      "id": "discrepancyDetection",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Detect Discrepancies"
      },
      "inputs": {
        "script": "const disputedItems = $vars.start.output.webhookPayload?.invoice?.lineItems ?? [];\nconst erpRecords = $vars.erpLookup1.output?.value ?? [];\nconst discrepancies = [];\nlet totalOvercharge = 0;\nlet totalUndercharge = 0;\nfor (const item of disputedItems) {\n  const invoiceNum = item.invoiceNumber ?? '';\n  const normalized = invoiceNum.startsWith('MCS-') ? invoiceNum.replace(/^MCS-/, '') : invoiceNum;\n  const erpRow = erpRecords.find(r => r.InvoiceNumber === normalized || r.InvoiceNumber === invoiceNum);\n  if (!erpRow) { discrepancies.push({ invoiceNumber: invoiceNum, issue: 'not_found_in_erp', disputedAmount: item.amount, erpAmount: null, delta: null }); continue; }\n  const delta = (item.amount ?? 0) - (erpRow.Amount ?? 0);\n  if (Math.abs(delta) > 0.01) {\n    discrepancies.push({ invoiceNumber: invoiceNum, issue: delta > 0 ? 'overcharge' : 'undercharge', disputedAmount: item.amount, erpAmount: erpRow.Amount, delta });\n    if (delta > 0) totalOvercharge += delta; else totalUndercharge += Math.abs(delta);\n  }\n}\nreturn { discrepancies, totalOvercharge, totalUndercharge, hasDiscrepancies: discrepancies.length > 0 };"
      }
    },
    {
      "id": "sopContextNode",
      "type": "uipath.agent.resource.context.index.billing-dispute-sop-index.cc45b9b4-dbf6-47b3-40ac-08debc0cec5b",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Billing Dispute SOP Index"
      },
      "inputs": {
        "source": "1fc0c973-136f-4c08-a95e-4980fc930d38"
      }
    },
    {
      "id": "disputeAnalyst",
      "type": "uipath.agent.autonomous",
      "typeVersion": "1.3",
      "display": {
        "label": "Dispute Analyst"
      },
      "inputs": {
        "source": "774a31b9-a777-4905-8f27-3d936f54ac45",
        "agentInputVariables": [
