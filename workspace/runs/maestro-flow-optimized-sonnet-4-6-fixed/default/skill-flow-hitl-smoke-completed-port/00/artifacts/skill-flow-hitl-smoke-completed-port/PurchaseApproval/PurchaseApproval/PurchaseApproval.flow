      "id": "hitlApproval",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "Manager Approves Purchase"
      },
      "inputs": {
        "schema": {
          "schemaId": "c7e3a9f1-2b4d-4e6f-8a0c-1d2e3f4a5b6c",
          "fields": [
            {
              "id": "purchaseAmount",
              "label": "Purchase Amount",
              "type": "number",
              "direction": "input",
              "binding": "vars.start.output.purchaseAmount"
            },
            {
              "id": "vendorName",
              "label": "Vendor Name",
              "type": "text",
              "direction": "input",
              "binding": "vars.start.output.vendorName"
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "End"
            }
          ]
        },
        "recipient": {
          "channels": [
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group"
          }
        },
        "priority": "Medium",
        "title": "Purchase Approval Required"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "output"
        },
        "status": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "status"
        }
      }
    },
    {
      "id": "logApproval",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Log Approval"
      },
      "inputs": {
        "script": "return { message: \"Approval recorded.\" };"
      },
      "outputs": {
        "error": {
          "type": "object",
          "description": "Error information if the node fails.",
          "source": "=Error",
          "var": "error"
        },
        "output": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "endNode",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {}
