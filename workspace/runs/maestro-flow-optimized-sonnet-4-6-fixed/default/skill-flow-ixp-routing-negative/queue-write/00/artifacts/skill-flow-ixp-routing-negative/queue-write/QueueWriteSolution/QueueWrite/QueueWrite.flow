{
  "id": "43d8fd3b-2f00-4e73-9384-269c41f28ee0",
  "version": "1.9",
  "name": "QueueWrite",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "dd475283-45c2-4ef1-af1d-954e125ecd07",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "enqueueItem",
      "type": "core.action.queue.create",
      "typeVersion": "1.2",
      "display": {
        "label": "Write to Orchestrator Queue"
      },
      "inputs": {
        "queue": "MyQueue",
        "itemData": "=js:JSON.stringify({ payload: $vars.start.output })",
        "priority": "Normal"
      },
      "outputs": {
        "error": {
          "type": "object",
          "description": "Error information if the queue operation fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      }
    }
  ],
  "edges": [
    {
      "id": "edge_start_output_enqueueItem_input",
      "source": "start",
      "sourcePort": "output",
      "target": "enqueueItem",
      "targetPort": "input"
    },
    {
      "id": "edge_enqueueItem_success_end_input",
      "source": "enqueueItem",
      "sourcePort": "success",
      "target": "end",
      "targetPort": "input"
    }
  ],
  "definitions": [
