  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "25606575-1566-4457-acb1-1d7d755e32f3",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "httpWebhookTrigger1",
      "type": "uipath.connector.trigger.uipath-http-webhook.http-webhook",
      "typeVersion": "1.0.0",
      "display": {
        "label": "HTTP Webhook Trigger"
      },
      "inputs": {
        "entryPointId": "e4c3ab72-fb06-4042-b01b-c29275c3a0fd"
      }
    },
    {
      "id": "validatePayload",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Validate JSON Payload"
      },
      "inputs": {
        "script": "const body = $vars.httpWebhookTrigger1.output;\nif (!body || typeof body !== 'object') {\n  return { valid: false, statusCode: 400, message: 'Invalid or missing JSON body' };\n}\nconst requiredFields = ['id', 'type'];\nconst missing = requiredFields.filter(f => !(f in body));\nif (missing.length > 0) {\n  return { valid: false, statusCode: 422, message: 'Missing required fields: ' + missing.join(', ') };\n}\nreturn { valid: true, statusCode: 200, message: 'Payload is valid', payload: body };"
      },
      "outputs": {
        "error": {
          "type": "object",
          "description": "Error information if the node fails.",
          "source": "=Error",
          "var": "error"
        },
        "output": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "endSuccess",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {},
      "outputs": {
        "statusCode": {
          "source": "=js:$vars.validatePayload.output.statusCode"
        },
        "responseMessage": {
          "source": "=js:$vars.validatePayload.output.message"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "edge_httpWebhookTrigger1_output_validatePayload_input",
      "sourceNodeId": "httpWebhookTrigger1",
      "sourcePort": "output",
      "targetNodeId": "validatePayload",
      "targetPort": "input"
    },
