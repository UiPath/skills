{
  "id": "b6719606-6c89-4e95-b981-424ff90a7b40",
  "version": "1.9",
  "name": "TransformGroupByDemo",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "4f5edd8c-2bb2-4a19-9ffd-4169befb26dc",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "emitEmployees",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Emit Employees"
      },
      "inputs": {
        "script": "return { items: [{ name: 'Alice', department: 'Engineering', salary: 95000 }, { name: 'Bob', department: 'Marketing', salary: 72000 }, { name: 'Carol', department: 'Engineering', salary: 110000 }, { name: 'Dave', department: 'Marketing', salary: 68000 }, { name: 'Eve', department: 'Engineering', salary: 88000 }] };"
      },
      "outputs": {
        "error": {
          "type": "object",
          "description": "Error information if the node fails.",
          "source": "=Error",
          "var": "error"
        },
        "output": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "groupByDept",
      "type": "core.action.transform.group-by",
      "typeVersion": "1.1",
      "display": {
        "label": "Group by Department"
      },
      "inputs": {
        "collection": "$vars.emitEmployees.output.items",
        "operations": [
          {
            "id": "op1",
            "type": "groupBy",
            "config": {
              "groupByField": "department",
              "aggregations": [
                {
                  "id": "a1",
                  "field": "",
                  "operation": "count",
                  "alias": "headcount"
                },
                {
                  "id": "a2",
                  "field": "salary",
                  "operation": "sum",
                  "alias": "totalSalary"
                },
                {
                  "id": "a3",
                  "field": "salary",
                  "operation": "average",
                  "alias": "avgSalary"
                }
              ]
            }
          }
        ]
      },
      "outputs": {
        "{'output': {'type': 'object'": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "{'output': {'type': 'object'"
        },
        "'description': 'The return value of the transform'": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "'description': 'The return value of the transform'"
        },
        "'source': '=result.response'": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "'source': '=result.response'"
        },
        "'var': 'output'}": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "'var': 'output'}"
        },
        "'error': {'type': 'object'": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "'error': {'type': 'object'"
        },
        "'description': 'Error information if the transform fails'": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "'description': 'Error information if the transform fails'"
        },
        "'source': '=Error'": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "'source': '=Error'"
        },
        "'var': 'error'}}": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "'var': 'error'}}"
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {},
      "outputs": {
        "groupedResult": {
          "source": "=js:$vars.groupByDept.output"
        }
      }
    }
  ],
  "edges": [
