      "typeVersion": "2.4",
      "display": {
        "label": "For Each Opportunity"
      },
      "inputs": {
        "collection": "=js:$vars.fetchOpenOpportunities1.output.body.records"
      },
      "outputs": {
        "json": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "json"
