                    "value": "Low"
                  },
                  {
                    "label": "Medium",
                    "value": "Medium"
                  },
                  {
                    "label": "High",
                    "value": "High"
                  }
                ]
              },
              {
                "name": "inputs.labels",
                "type": "text",
                "label": "Labels",
                "placeholder": "Comma-separated (e.g. finance,approval)"
              }
            ]
          }
        ]
