{
  "id": "b4aa5b45-ac11-4dec-95c3-94f5b3430771",
  "version": "1.9",
  "name": "ExpenseApproval",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "0398cb43-22a2-4a85-b3fb-857f31e4482a",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "expenseReview",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "Expense Review"
      },
      "inputs": {
        "schema": {
          "schemaId": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
          "fields": [
            {
              "id": "expenseAmount",
              "label": "Expense Amount",
              "type": "number",
              "direction": "input",
              "binding": "vars.start.output.expenseAmount"
            },
            {
              "id": "requesterName",
              "label": "Requester Name",
              "type": "text",
              "direction": "input",
              "binding": "vars.start.output.requesterName"
            },
            {
              "id": "category",
              "label": "Category",
              "type": "text",
              "direction": "input",
              "binding": "vars.start.output.category"
            },
            {
              "id": "approved",
              "label": "Approved",
              "type": "boolean",
              "direction": "output",
              "variable": "vars.approved"
            },
            {
              "id": "comments",
              "label": "Comments",
              "type": "text",
              "direction": "output",
              "variable": "vars.comments"
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "End"
            }
          ]
        },
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group"
          }
        },
        "priority": "Low"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "approved": {
              "type": "boolean"
            },
            "comments": {
              "type": "string"
            },
            "Action": {
              "type": "string",
              "enum": [
                "Approve",
                "Reject"
              ],
              "default": "Approve"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": [
            "Approve",
            "Reject"
          ],
          "default": "Approve"
        }
      }
    },
    {
      "id": "logDecision",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Log Decision"
      },
      "inputs": {
        "script": "const approved = $vars.expenseReview.output.approved;\nconst comments = $vars.expenseReview.output.comments;\nreturn { message: \"Decision: \" + approved + \", Comments: \" + comments };"
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      }
    }
  ],
  "edges": [
    {
      "id": "edge_start_output_expenseReview_input",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "expenseReview",
      "targetPort": "input"
    },
    {
      "id": "edge_expenseReview_completed_logDecision_input",
      "sourceNodeId": "expenseReview",
      "sourcePort": "completed",
      "targetNodeId": "logDecision",
      "targetPort": "input"
    },
    {
      "id": "edge_logDecision_success_end_input",
      "sourceNodeId": "logDecision",
      "sourcePort": "success",
      "targetNodeId": "end",
      "targetPort": "input"
    }
  ],
  "definitions": [
    {
      "nodeType": "core.trigger.manual",
