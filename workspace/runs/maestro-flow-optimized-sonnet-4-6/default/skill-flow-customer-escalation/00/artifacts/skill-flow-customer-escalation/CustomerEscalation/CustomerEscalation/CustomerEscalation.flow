      "type": "uipath.connector.uipath-salesforce-slack.send-message-to-channel",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Notify Slack (VIP)"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-salesforce-slack",
          "connectionId": "849e85d8-1aa9-4d52-8bbd-20041c8f05d8",
          "connectionResourceId": "849e85d8-1aa9-4d52-8bbd-20041c8f05d8",
          "connectionFolderKey": "5da18ec0-7de1-4e57-aaf1-ddc8a369c199",
          "method": "POST",
          "endpoint": "/send_message_to_channel_v2",
          "bodyParameters": {
            "channel": "C041274J3N2",
            "messageToSend": "=js:\"[VIP ESCALATION] Urgent email from \" + ($vars.classifyVip.output.senderEmail || \"unknown\") + \" | Subject: \" + ($vars.newInboxEmail1.output.subject || \"(no subject)\")"
          },
          "uiPathActivityTypeId": "37a305b2-89b1-315d-b73f-1778839a6c47",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"connectorVersion\":\"2.14.8\",\"customFieldsRequestDetails\":null,\"instanceParameters\":{\"connectorKey\":\"uipath-salesforce-slack\",\"objectName\":\"send_message_to_channel_v2\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"send_message_to_channel_v2\",\"operation\":\"create\",\"packageVersion\":\"1.0.0\",\"httpMethod\":\"POST\",\"path\":\"/send_message_to_channel_v2\",\"unifiedTypesCompatible\":true,\"savedJitInputFieldId\":\"in_send_message_to_channel_v2\"}}"
        }
      }
    },
    {
      "id": "replyVipFastAck1",
      "type": "uipath.connector.uipath-microsoft-outlook365.reply-to-email",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Reply VIP Fast Ack"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-microsoft-outlook365",
          "connectionId": "75dfafb4-3717-470c-a5f6-bdc144757a67",
          "connectionResourceId": "75dfafb4-3717-470c-a5f6-bdc144757a67",
          "connectionFolderKey": "5da18ec0-7de1-4e57-aaf1-ddc8a369c199",
          "method": "POST",
          "endpoint": "/ReplyToEmailV2",
          "bodyParameters": {
            "comment": "=js:\"Thank you for your message. We have identified this as a high-priority request and a dedicated specialist will contact you shortly. Our team is on it right now.\\n\\nBest regards,\\nSupport Team\"",
            "message.toRecipients": "=js:$vars.classifyVip.output.senderEmail",
            "message.subject": "=js:\"Re: \" + ($vars.newInboxEmail1.output.subject || \"(no subject)\")"
          },
          "pathParameters": {
            "id": "=js:$vars.newInboxEmail1.output.id"
          },
          "uiPathActivityTypeId": "da9976dd-3d71-35b4-bb8c-509419cb46eb",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"connectorVersion\":\"1.42.6\",\"customFieldsRequestDetails\":null,\"instanceParameters\":{\"connectorKey\":\"uipath-microsoft-outlook365\",\"objectName\":\"ReplyToEmailV2\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"ReplyToEmailV2\",\"operation\":\"create\",\"packageVersion\":\"1.0.0\",\"httpMethod\":\"POST\",\"path\":\"/ReplyToEmailV2\",\"unifiedTypesCompatible\":true,\"savedJitInputFieldId\":\"in_ReplyToEmailV2\"}}",
          "multipartParameters": [
            {
              "name": "file",
              "dataType": "file"
            },
            {
              "name": "body",
              "dataType": "string"
            }
          ],
          "inputMetadata": {
            "type": "multipart",
            "multipart": {
              "bodyFieldName": "body"
            }
          }
        }
      }
    },
    {
      "id": "replyStandardTicket1",
      "type": "uipath.connector.uipath-microsoft-outlook365.reply-to-email",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Reply Standard Ticket"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-microsoft-outlook365",
          "connectionId": "75dfafb4-3717-470c-a5f6-bdc144757a67",
          "connectionResourceId": "75dfafb4-3717-470c-a5f6-bdc144757a67",
          "connectionFolderKey": "5da18ec0-7de1-4e57-aaf1-ddc8a369c199",
          "method": "POST",
          "endpoint": "/ReplyToEmailV2",
          "bodyParameters": {
            "comment": "=js:\"Thank you for reaching out. We have created a support ticket for your request.\\n\\nTicket ID: \" + $vars.generateTicket.output.ticketId + \"\\nStatus: Open\\n\\nOur support team will review your request and get back to you within 24-48 hours.\\n\\nBest regards,\\nSupport Team\"",
            "message.toRecipients": "=js:$vars.classifyVip.output.senderEmail",
            "message.subject": "=js:\"[\" + $vars.generateTicket.output.ticketId + \"] Re: \" + ($vars.newInboxEmail1.output.subject || \"(no subject)\")"
          },
          "pathParameters": {
            "id": "=js:$vars.newInboxEmail1.output.id"
          },
          "uiPathActivityTypeId": "da9976dd-3d71-35b4-bb8c-509419cb46eb",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"connectorVersion\":\"1.42.6\",\"customFieldsRequestDetails\":null,\"instanceParameters\":{\"connectorKey\":\"uipath-microsoft-outlook365\",\"objectName\":\"ReplyToEmailV2\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"ReplyToEmailV2\",\"operation\":\"create\",\"packageVersion\":\"1.0.0\",\"httpMethod\":\"POST\",\"path\":\"/ReplyToEmailV2\",\"unifiedTypesCompatible\":true,\"savedJitInputFieldId\":\"in_ReplyToEmailV2\"}}",
          "multipartParameters": [
            {
              "name": "file",
              "dataType": "file"
            },
            {
              "name": "body",
              "dataType": "string"
            }
          ],
          "inputMetadata": {
            "type": "multipart",
            "multipart": {
              "bodyFieldName": "body"
            }
          }
        }
      }
    },
    {
      "id": "classifyUrgency",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Classify Urgency"
      },
      "inputs": {
        "script": "const urgentKeywords = [\"urgent\", \"critical\", \"asap\", \"emergency\", \"escalate\", \"blocker\", \"down\", \"outage\", \"sev1\", \"severity 1\"];\nconst email = $vars.newInboxEmail1.output;\nconst subject = (email.subject || \"\").toLowerCase();\nconst body = (email.bodyPreview || \"\").toLowerCase();\nconst text = subject + \" \" + body;\nconst isUrgent = urgentKeywords.some(function(kw) { return text.indexOf(kw) !== -1; });\nreturn { isUrgent: isUrgent };"
      },
      "outputs": {
        "error": {
          "type": "object",
          "description": "Error information if the node fails.",
          "source": "=Error",
          "var": "error"
        },
        "output": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "classifyVip",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Classify VIP"
      },
      "inputs": {
        "script": "const vipDomains = [\"enterprise.com\", \"bigcorp.com\", \"goldclient.io\", \"premiumpartner.net\", \"vipaccount.org\"];\nconst email = $vars.newInboxEmail1.output;\nconst fromAddress = (email[\"from.emailAddress.address\"] || email.from && email.from.emailAddress && email.from.emailAddress.address || \"\").toLowerCase();\nconst senderDomain = fromAddress.split(\"@\")[1] || \"\";\nconst isVip = vipDomains.indexOf(senderDomain) !== -1;\nreturn { isVip: isVip, senderEmail: fromAddress };"
      },
      "outputs": {
        "error": {
          "type": "object",
          "description": "Error information if the node fails.",
          "source": "=Error",
          "var": "error"
        },
        "output": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "routeDecision",
      "type": "core.logic.decision",
      "typeVersion": "1.2",
      "display": {
        "label": "Urgent AND VIP?"
      },
      "inputs": {
        "expression": "$vars.classifyUrgency.output.isUrgent === true && $vars.classifyVip.output.isVip === true"
      },
      "outputs": {
        "matchedCase": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "matchedCase"
        },
        "matchedCaseId": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "matchedCaseId"
        }
      }
    },
    {
      "id": "generateTicket",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Generate Support Ticket"
      },
      "inputs": {
        "script": "const email = $vars.newInboxEmail1.output;\nconst sender = $vars.classifyVip.output.senderEmail || \"\";\nconst seed = sender.length * 31 + (email.subject || \"\").length * 17 + (email.id || \"\").length * 7;\nconst ticketId = \"TKT-\" + Math.floor(Math.abs(Math.sin(seed + 1) * 1e9)).toString(36).toUpperCase().slice(0, 8);\nconst ticket = {\n  ticketId: ticketId,\n  status: \"Open\",\n  subject: email.subject || \"(no subject)\",\n  sender: sender,\n  body: email.bodyPreview || \"\"\n};\nreturn { ticket: ticket, ticketId: ticketId };"
      },
      "outputs": {
        "error": {
          "type": "object",
          "description": "Error information if the node fails.",
          "source": "=Error",
          "var": "error"
        },
        "output": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "endHighTouch",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End High-Touch"
      },
      "inputs": {}
    },
    {
      "id": "endStandard",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End Standard"
      },
      "inputs": {}
    }
  ],
