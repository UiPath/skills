          "outputId": "output"
        }
      },
      {
        "id": "classifyEmail.error",
        "type": "object",
        "description": "Error information if the node fails",
        "binding": {
          "nodeId": "classifyEmail",
          "outputId": "error"
        }
      },
      {
        "id": "end.category",
        "type": "string",
        "binding": {
          "nodeId": "end",
          "outputId": "category"
        }
      },
      {
        "id": "end.priority",
        "type": "string",
        "binding": {
          "nodeId": "end",
          "outputId": "priority"
        }
      }
    ]
