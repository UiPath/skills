            "connectorName": "HTTP",
            "operationType": "create",
            "objectName": "http-request",
            "objectDisplayName": "HTTP Request",
            "primaryKeyName": ""
          }
        }
      }
    },
    {
      "id": "newInvoiceInSharepoint1",
      "type": "uipath.connector.trigger.uipath-microsoft-onedrive.file-created",
      "typeVersion": "1.0.0",
      "display": {
        "label": "New Invoice in SharePoint"
      },
      "inputs": {
        "entryPointId": "7ba8daaf-c3bc-44f8-9f82-d8432e8c4a1a"
      }
    },
    {
      "id": "downloadInvoicePdf1",
      "type": "uipath.connector.uipath-microsoft-onedrive.download-file",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Download Invoice PDF"
      },
      "inputs": {}
    },
    {
      "id": "extractInvoiceFields",
      "type": "uipath.ixp.invoiceixp-cef0d447-ixp.ff973488-5d89-8035-86ac-f980b4be6deb-c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Extract Invoice Fields"
      },
      "inputs": {
        "model": {
          "id": "ff973488-5d89-8035-86ac-f980b4be6deb",
          "modelName": "invoiceixp-cef0d447-ixp",
          "modelDisplayName": "InvoiceIXP",
          "folderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "folderName": "Shared",
          "folderPath": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "description": ""
        },
        "modelName": "invoiceixp-cef0d447-ixp",
        "description": "",
        "projectName": "invoiceixp-cef0d447-ixp",
        "versionTag": "",
        "folderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
        "folderName": "Shared",
        "fileRef": "=js:$vars.downloadInvoicePdf1.output",
        "pageRange": ""
      },
      "outputs": {
        "output": {
          "name": "output",
          "type": "object",
          "source": "=this",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "buildSapPayload",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Build SAP Payload"
      },
      "inputs": {
        "script": "const fields = ($vars.extractInvoiceFields.output.ExtractionResult?.ResultsDocument?.Fields) || [];\nconst get = (name) => fields.find(f => f.FieldName === name)?.Values?.[0] || null;\nreturn {\n  invoiceNumber: get('InvoiceId') || get('InvoiceNumber') || get('Invoice Number'),\n  vendorName: get('VendorName') || get('Vendor Name') || get('Vendor'),\n  invoiceDate: get('InvoiceDate') || get('Invoice Date'),\n  totalAmount: get('InvoiceTotal') || get('Total Amount') || get('Amount Due'),\n  lineItems: ($vars.extractInvoiceFields.output.ExtractionResult?.ResultsDocument?.Tables || []).map(t => t)\n};"
      },
      "outputs": {
        "output": {
          "name": "output",
          "type": "object",
          "source": "=this",
          "var": "output"
        }
      }
    },
    {
      "id": "done",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Done"
      },
      "inputs": {}
    }
  ],
