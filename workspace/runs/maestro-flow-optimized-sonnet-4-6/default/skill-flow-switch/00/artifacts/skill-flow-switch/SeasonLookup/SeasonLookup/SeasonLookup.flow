        "type": "object",
        "description": "The error that occurred",
        "binding": {
          "nodeId": "summerScript",
          "outputId": "error"
        }
      },
      {
        "id": "fallScript.output",
        "type": "any",
        "description": "The return value of the script",
        "binding": {
          "nodeId": "fallScript",
          "outputId": "output"
        }
      },
      {
        "id": "fallScript.error",
        "type": "object",
        "description": "The error that occurred",
        "binding": {
          "nodeId": "fallScript",
          "outputId": "error"
        }
      },
      {
        "id": "winterScript.output",
        "type": "any",
        "description": "The return value of the script",
        "binding": {
          "nodeId": "winterScript",
          "outputId": "output"
        }
      },
      {
        "id": "winterScript.error",
        "type": "object",
        "description": "The error that occurred",
        "binding": {
          "nodeId": "winterScript",
          "outputId": "error"
        }
      },
      {
        "id": "endSpring.seasonName",
        "type": "string",
        "binding": {
          "nodeId": "endSpring",
          "outputId": "seasonName"
        }
      },
      {
        "id": "endSummer.seasonName",
        "type": "string",
        "binding": {
          "nodeId": "endSummer",
          "outputId": "seasonName"
        }
      },
      {
        "id": "endFall.seasonName",
        "type": "string",
        "binding": {
          "nodeId": "endFall",
          "outputId": "seasonName"
        }
      },
      {
        "id": "endWinter.seasonName",
        "type": "string",
        "binding": {
