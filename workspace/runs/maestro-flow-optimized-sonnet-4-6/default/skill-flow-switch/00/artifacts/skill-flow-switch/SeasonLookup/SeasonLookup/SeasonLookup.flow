{
  "id": "4bd2edeb-c99c-400f-af11-3733646c49b7",
  "version": "1.9",
  "name": "SeasonLookup",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "36dd38e2-6ba7-4db7-95e4-bed36fe2bf6d",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "switchQuarter",
      "type": "core.logic.switch",
      "typeVersion": "1.1",
      "display": {
        "label": "Switch on Quarter"
      },
      "inputs": {
        "cases": [
          {
            "id": "q1",
            "label": "Quarter 1",
            "expression": "$vars.start.output.quarter === 1"
          },
          {
            "id": "q2",
            "label": "Quarter 2",
            "expression": "$vars.start.output.quarter === 2"
          },
          {
            "id": "q3",
            "label": "Quarter 3",
            "expression": "$vars.start.output.quarter === 3"
          },
          {
            "id": "q4",
            "label": "Quarter 4",
            "expression": "$vars.start.output.quarter === 4"
          }
        ]
      }
    },
    {
      "id": "springScript",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Return Spring"
      },
      "inputs": {
        "script": "return { seasonName: 'Spring' };"
      }
    },
    {
      "id": "summerScript",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Return Summer"
      },
      "inputs": {
        "script": "return { seasonName: 'Summer' };"
      }
    },
    {
      "id": "fallScript",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Return Fall"
      },
      "inputs": {
        "script": "return { seasonName: 'Fall' };"
      }
    },
    {
      "id": "winterScript",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Return Winter"
      },
      "inputs": {
        "script": "return { seasonName: 'Winter' };"
      }
    },
    {
      "id": "endSpring",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End Spring"
      },
      "inputs": {},
      "outputs": {
        "seasonName": {
          "source": "=js:$vars.springScript.output.seasonName"
        }
      }
    },
    {
      "id": "endSummer",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End Summer"
      },
      "inputs": {},
      "outputs": {
        "seasonName": {
          "source": "=js:$vars.summerScript.output.seasonName"
        }
      }
    },
    {
      "id": "endFall",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End Fall"
      },
      "inputs": {},
      "outputs": {
        "seasonName": {
          "source": "=js:$vars.fallScript.output.seasonName"
        }
      }
    },
    {
      "id": "endWinter",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End Winter"
      },
      "inputs": {},
      "outputs": {
        "seasonName": {
          "source": "=js:$vars.winterScript.output.seasonName"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "edge_start_output_switchQuarter_input",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "switchQuarter",
      "targetPort": "input"
    },
    {
      "id": "edge_switchQuarter_caseq1_springScript_input",
      "sourceNodeId": "switchQuarter",
      "sourcePort": "case-q1",
      "targetNodeId": "springScript",
      "targetPort": "input"
    },
    {
      "id": "edge_switchQuarter_caseq2_summerScript_input",
      "sourceNodeId": "switchQuarter",
      "sourcePort": "case-q2",
      "targetNodeId": "summerScript",
      "targetPort": "input"
    },
    {
      "id": "edge_switchQuarter_caseq3_fallScript_input",
      "sourceNodeId": "switchQuarter",
      "sourcePort": "case-q3",
      "targetNodeId": "fallScript",
      "targetPort": "input"
    },
    {
      "id": "edge_switchQuarter_caseq4_winterScript_input",
      "sourceNodeId": "switchQuarter",
      "sourcePort": "case-q4",
      "targetNodeId": "winterScript",
      "targetPort": "input"
    },
    {
      "id": "edge_springScript_success_endSpring_input",
      "sourceNodeId": "springScript",
      "sourcePort": "success",
      "targetNodeId": "endSpring",
