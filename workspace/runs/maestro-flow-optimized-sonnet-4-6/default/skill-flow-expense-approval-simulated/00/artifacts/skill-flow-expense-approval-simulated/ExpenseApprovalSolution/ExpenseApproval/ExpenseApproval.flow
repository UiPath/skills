{
  "id": "eb72bf8a-5321-431f-86f5-64b609bdc9c0",
  "version": "1.9",
  "name": "ExpenseApproval",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "ebfe0de7-95f3-4a56-a34f-fec8c4c9802c",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "managerReview",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "Manager Review"
      },
      "inputs": {
        "title": "Expense Approval Request",
        "priority": "Medium",
        "schema": {
          "schemaId": "a3f7c2d1-8b4e-4f9a-b2c5-1e6d3a7f0b8c",
          "fields": [
            {
              "id": "expenseAmount",
              "label": "Expense Amount",
              "type": "number",
              "direction": "input",
              "binding": "vars.start.output.expenseAmount"
            },
            {
              "id": "submittedBy",
              "label": "Submitted By",
              "type": "text",
              "direction": "input",
              "binding": "vars.start.output.submittedBy"
            },
            {
              "id": "expenseCategory",
              "label": "Category",
              "type": "text",
              "direction": "input",
              "binding": "vars.start.output.expenseCategory"
            },
            {
              "id": "expenseId",
              "label": "Expense ID",
              "type": "text",
              "direction": "input",
              "binding": "vars.start.output.expenseId"
            },
            {
              "id": "rejectionReason",
              "label": "Rejection Reason (optional)",
              "type": "text",
              "direction": "output"
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "Continue"
            }
          ]
        },
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group"
          }
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "rejectionReason": {
              "type": "string"
            },
            "Action": {
              "type": "string",
              "enum": [
                "Approve",
                "Reject"
              ],
              "default": "Approve"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": [
            "Approve",
            "Reject"
          ],
          "default": "Approve"
        }
      }
    },
    {
      "id": "logDecision",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Log Decision"
      },
      "inputs": {
        "script": "var decision = $vars.managerReview.status;\nvar reason = $vars.managerReview.output.rejectionReason || '';\nvar expenseId = $vars.start.output.expenseId;\nvar submittedBy = $vars.start.output.submittedBy;\nvar amount = $vars.start.output.expenseAmount;\nvar category = $vars.start.output.expenseCategory;\nreturn {\n  expenseId: expenseId,\n  submittedBy: submittedBy,\n  amount: amount,\n  category: category,\n  decision: decision,\n  rejectionReason: reason,\n  logMessage: 'Expense ' + expenseId + ' submitted by ' + submittedBy + ' for ' + category + ' ($' + amount + ') was ' + decision + (reason ? '. Reason: ' + reason : '.')\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the action fails.",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "outputs": {}
    }
  ],
  "edges": [
    {
      "id": "edge_start_output_managerReview_input",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "managerReview",
      "targetPort": "input"
    },
    {
      "id": "edge_managerReview_completed_logDecision_input",
      "sourceNodeId": "managerReview",
      "sourcePort": "completed",
      "targetNodeId": "logDecision",
      "targetPort": "input"
    },
    {
      "id": "edge_logDecision_success_end_input",
      "sourceNodeId": "logDecision",
      "sourcePort": "success",
      "targetNodeId": "end",
      "targetPort": "input"
    }
  ],
  "definitions": [
