{
  "id": "03021de7-3995-4ee4-98e5-1eac37f89e86",
  "version": "1.9",
  "name": "CustomerEscalationFlow",
  "nodes": [
    {
      "id": "classifyEmail1",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Classify Email"
      },
      "inputs": {
        "script": "var subject = ($vars.emailReceived1.output.subject || '').toLowerCase();\nvar body = ($vars.emailReceived1.output.bodyPreview || '').toLowerCase();\nvar urgentKeywords = ['urgent', 'critical', 'asap', 'emergency', 'immediately', 'important'];\nvar isUrgent = urgentKeywords.some(function(kw) { return subject.indexOf(kw) !== -1 || body.indexOf(kw) !== -1; });\nvar vipDomains = ['vip-client.com', 'bigaccount.com', 'enterprise.com'];\nvar vipAddresses = ['ceo@example.com', 'vip@example.com'];\nvar senderEmail = (($vars.emailReceived1.output['from.emailAddress.address'] || $vars.emailReceived1.output.from) || '').toLowerCase();\nvar isVip = vipAddresses.some(function(a) { return senderEmail === a; }) || vipDomains.some(function(d) { return senderEmail.indexOf('@' + d) !== -1; });\nreturn { isUrgent: isUrgent, isVip: isVip, senderEmail: senderEmail, subject: $vars.emailReceived1.output.subject || '', emailId: $vars.emailReceived1.output.id || '' };"
      }
    },
    {
      "id": "checkUrgent1",
      "type": "core.logic.decision",
      "typeVersion": "1.2",
      "display": {
        "label": "Is Urgent?"
      },
      "inputs": {
        "expression": "$vars.classifyEmail1.output.isUrgent === true"
      }
    },
    {
      "id": "checkVip1",
      "type": "core.logic.decision",
      "typeVersion": "1.2",
      "display": {
        "label": "Is VIP?"
      },
      "inputs": {
        "expression": "$vars.classifyEmail1.output.isVip === true"
      }
    },
    {
      "id": "doneVipEscalation",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Done VIP Escalation"
      },
      "inputs": {}
    },
    {
      "id": "doneTicketCreated",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Done Ticket Created"
      },
      "inputs": {}
    },
    {
      "id": "notifySlackVipEscalation1",
      "type": "uipath.connector.uipath-salesforce-slack.send-message-to-channel",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Notify Slack VIP Escalation"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-salesforce-slack",
          "connectionId": "849e85d8-1aa9-4d52-8bbd-20041c8f05d8",
          "connectionResourceId": "849e85d8-1aa9-4d52-8bbd-20041c8f05d8",
          "connectionFolderKey": "5da18ec0-7de1-4e57-aaf1-ddc8a369c199",
          "method": "POST",
          "endpoint": "/send_message_to_channel_v2",
          "bodyParameters": {
            "channel": "#vip-escalations",
            "messageToSend": "=js:'[VIP ESCALATION] Urgent email from ' + $vars.classifyEmail1.output.senderEmail + ': ' + $vars.classifyEmail1.output.subject"
          },
          "uiPathActivityTypeId": "37a305b2-89b1-315d-b73f-1778839a6c47",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"connectorVersion\":\"2.14.8\",\"customFieldsRequestDetails\":null,\"instanceParameters\":{\"connectorKey\":\"uipath-salesforce-slack\",\"objectName\":\"send_message_to_channel_v2\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"send_message_to_channel_v2\",\"operation\":\"create\",\"packageVersion\":\"1.0.0\",\"httpMethod\":\"POST\",\"path\":\"/send_message_to_channel_v2\",\"unifiedTypesCompatible\":true,\"savedJitInputFieldId\":\"in_send_message_to_channel_v2\"}}"
        }
      }
    },
    {
      "id": "createSupportTicket1",
      "type": "uipath.connector.uipath-freshworks-freshdesk.create-ticket",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Create Support Ticket"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-freshworks-freshdesk",
          "connectionId": "29aae689-111d-459f-9a4a-d1ad1d9d2761",
          "connectionResourceId": "29aae689-111d-459f-9a4a-d1ad1d9d2761",
          "connectionFolderKey": "b262689d-e2a9-4c1a-8e68-04382a7fff76",
          "method": "POST",
          "endpoint": "/tickets",
          "bodyParameters": {
            "subject": "=js:$vars.classifyEmail1.output.subject",
            "description": "=js:'Email received from ' + $vars.classifyEmail1.output.senderEmail + '. Preview: ' + ($vars.emailReceived1.output.bodyPreview || '')",
            "email": "=js:$vars.classifyEmail1.output.senderEmail",
            "priority": "=js:$vars.classifyEmail1.output.isUrgent ? 3 : 1",
            "source": 1
          },
          "uiPathActivityTypeId": "489bd332-d516-3ad9-b23f-b21bb4fd1a2b",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"connectorVersion\":\"1.2.16\",\"customFieldsRequestDetails\":null,\"instanceParameters\":{\"connectorKey\":\"uipath-freshworks-freshdesk\",\"objectName\":\"tickets\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"tickets\",\"operation\":\"create\",\"packageVersion\":\"1.0.0\",\"httpMethod\":\"POST\",\"path\":\"/tickets\",\"unifiedTypesCompatible\":true,\"savedJitInputFieldId\":\"in_tickets\"}}"
        }
      }
    },
