    {
      "id": "queryEmployeesByDepartment1",
      "type": "uipath.connector.uipath-uipath-jdbc.execute-query-synchronously",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Query Employees by Department"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-uipath-jdbc",
          "connectionId": "4e5d613a-96be-4ba7-b86b-ebe225d192f1",
          "connectionResourceId": "4e5d613a-96be-4ba7-b86b-ebe225d192f1",
          "connectionFolderKey": "5da18ec0-7de1-4e57-aaf1-ddc8a369c199",
          "method": "POST",
          "endpoint": "/hubs/datawarehouse/query",
          "bodyParameters": {
            "script": "SELECT department, COUNT(*) AS employee_count, AVG(salary) AS avg_salary FROM employees GROUP BY department HAVING COUNT(*) >= 2 ORDER BY avg_salary"
          },
          "uiPathActivityTypeId": "30ba82aa-29d8-35ad-bf2c-1d2abc2aed3b",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"connectorVersion\":\"1.20.1\",\"customFieldsRequestDetails\":null,\"instanceParameters\":{\"connectorKey\":\"uipath-uipath-jdbc\",\"objectName\":\"query\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"method\"},\"objectName\":\"query\",\"operation\":\"list\",\"packageVersion\":\"1.0.0\",\"httpMethod\":\"POST\",\"path\":\"/hubs/datawarehouse/query\",\"unifiedTypesCompatible\":true}}",
          "inputMetadata": {
            "operation": "list",
            "pagination": {
              "maxPageSize": 1000
            }
          }
        }
      }
    }
  ],
