    },
    {
      "id": "listInvoiceFiles1",
      "type": "uipath.connector.uipath-microsoft-onedrive.get-file-or-folder-list",
      "typeVersion": "1.0.0",
      "display": {
        "label": "List Invoice Files"
      },
      "inputs": {}
    },
    {
      "id": "downloadInvoiceFile1",
      "type": "uipath.connector.uipath-microsoft-onedrive.download-file",
      "typeVersion": "1.0.0",
