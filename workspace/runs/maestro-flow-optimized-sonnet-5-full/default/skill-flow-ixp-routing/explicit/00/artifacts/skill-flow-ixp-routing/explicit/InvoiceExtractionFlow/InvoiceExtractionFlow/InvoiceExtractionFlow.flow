                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "form": {
        "id": "loop-properties",
        "title": "Loop configuration",
        "sections": [
          {
            "id": "iteration",
            "title": "Iteration",
            "fields": [
              {
                "name": "inputs.collection",
                "type": "custom",
                "component": "code-editor",
                "label": "Collection",
                "description": "The loop runs once for each item in this array or collection.",
                "componentProps": {
                  "singleLine": true,
                  "mode": "expression",
                  "toggleable": false,
                  "placeholder": "$vars.scriptTask1.output",
                  "showVariableButton": true,
                  "language": "javascript",
                  "expectedType": "array",
                  "validationMode": "expression"
                }
              },
              {
                "name": "inputs.parallel",
                "type": "switch",
                "label": "Parallel",
                "description": "The loop runs iterations at the same time."
              },
              {
                "name": "inputs.completionCondition",
                "type": "custom",
                "component": "code-editor",
                "label": "Break on condition",
                "description": "The loop exits early when this condition becomes true after an iteration completes.",
                "componentProps": {
                  "singleLine": true,
                  "mode": "expression",
                  "toggleable": false,
                  "placeholder": "$vars.processedCount >= 5",
                  "showVariableButton": true,
                  "alwaysIncludeSelf": true,
                  "returnType": "boolean",
                  "validationMode": "expression",
                  "language": "javascript"
                }
              },
              {
                "name": "inputs.breakEnabled",
                "type": "switch",
                "label": "Show break handle",
                "description": "Nodes inside the loop can exit through a break handle."
              }
            ]
          }
        ]
      }
    },
    {
      "nodeType": "core.control.end",
      "version": "1.0",
      "category": "control-flow",
      "description": "Mark the end of a process path",
      "tags": [
        "control-flow",
        "end",
        "finish",
        "complete"
      ],
      "sortOrder": 65,
      "display": {
        "label": "End",
        "icon": "circle-check",
        "shape": "circle"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ]
        }
      ],
      "model": {
        "type": "bpmn:EndEvent"
      },
      "runtimeConstraints": {
        "exclude": [
          "api-function"
        ]
      }
    }
