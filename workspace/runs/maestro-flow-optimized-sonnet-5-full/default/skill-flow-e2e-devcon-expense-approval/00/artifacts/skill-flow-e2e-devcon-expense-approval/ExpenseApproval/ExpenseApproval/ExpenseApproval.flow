{
  "id": "d18c7ed4-7424-4b0c-a2d9-f68fb2594210",
  "version": "1.9",
  "name": "ExpenseApproval",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "0a64c4cb-faca-415c-bc46-505a6e2147bb",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "getExpenseDetails1",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Get Expense Details"
      },
      "inputs": {
        "script": "const mockExpenses = [\n  { expenseId: \"EXP-1001\", amount: 245.50, submitter: \"Jordan Lee\", category: \"Travel\" },\n  { expenseId: \"EXP-1002\", amount: 89.99, submitter: \"Priya Nair\", category: \"Equipment\" },\n  { expenseId: \"EXP-1003\", amount: 1350.00, submitter: \"Sam Osei\", category: \"Travel\" }\n];\nconst expense = mockExpenses[Math.floor(Math.random() * mockExpenses.length)];\nreturn {\n  expenseId: expense.expenseId,\n  amount: expense.amount,\n  submitter: expense.submitter,\n  category: expense.category\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "managerApproval1",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "Manager Approval"
      },
      "inputs": {
        "title": "Expense Approval",
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group",
            "value": "expense-approvers"
          }
        },
        "priority": "Medium",
        "schema": {
          "schemaId": "a9e73763-5ae1-4b0b-af2a-334d5ef81315",
          "fields": [
            {
              "id": "expenseid",
              "label": "Expense ID",
              "type": "string",
              "direction": "input",
              "binding": "vars.getExpenseDetails1.output.expenseId"
            },
            {
              "id": "amount",
              "label": "Amount",
              "type": "number",
              "direction": "input",
              "binding": "vars.getExpenseDetails1.output.amount"
            },
            {
              "id": "submitter",
              "label": "Submitter",
              "type": "string",
              "direction": "input",
              "binding": "vars.getExpenseDetails1.output.submitter"
            },
            {
              "id": "category",
              "label": "Category",
              "type": "string",
              "direction": "input",
              "binding": "vars.getExpenseDetails1.output.category"
            },
            {
              "id": "approved",
              "label": "Approved",
              "type": "boolean",
              "direction": "output",
              "variable": "vars.approved",
              "required": true
            },
            {
              "id": "reason",
              "label": "Rejection Reason",
              "type": "string",
              "direction": "output",
              "variable": "vars.reason",
              "required": false
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "End"
            }
          ]
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "approved": {
              "type": "boolean"
            },
            "reason": {
              "type": "string"
            },
            "Action": {
              "type": "string",
              "enum": [
                "Approve",
                "Reject"
              ],
              "default": "Approve"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": [
            "Approve",
            "Reject"
          ],
          "default": "Approve"
        }
      }
    },
    {
      "id": "logOutcome1",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Log Outcome"
      },
      "inputs": {
        "script": "const approved = $vars.managerApproval1.output.approved;\nconst reason = $vars.managerApproval1.output.reason;\nconst expenseId = $vars.getExpenseDetails1.output.expenseId;\nconst submitter = $vars.getExpenseDetails1.output.submitter;\nconst amount = $vars.getExpenseDetails1.output.amount;\nconst category = $vars.getExpenseDetails1.output.category;\nconst outcome = approved ? \"APPROVED\" : \"REJECTED\";\nconst logEntry = {\n  expenseId: expenseId,\n  submitter: submitter,\n  amount: amount,\n  category: category,\n  outcome: outcome,\n  rejectionReason: approved ? null : (reason || \"No reason provided\")\n};\nreturn { logEntry: logEntry, message: \"Logged outcome for \" + expenseId + \": \" + outcome };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Done"
      },
      "inputs": {}
    }
  ],
  "edges": [
