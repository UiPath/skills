            "type": "multipart",
            "multipart": {
              "bodyFieldName": "body"
            }
          }
        }
      }
    },
    {
      "id": "classifyEmail1",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Classify Email"
      },
      "inputs": {
        "script": "const email = $vars.emailReceived1.output;\nconst subject = (email.subject || \"\").toLowerCase();\nconst importance = email.importance;\nconst urgentKeywords = [\"urgent\", \"asap\", \"critical\", \"emergency\"];\nconst isUrgent = importance === \"high\" || urgentKeywords.some(k => subject.includes(k));\nconst senderEmail = (email.from && email.from.emailAddress && email.from.emailAddress.address) || \"\";\nconst senderDomain = senderEmail.includes(\"@\") ? senderEmail.split(\"@\")[1].toLowerCase() : \"\";\nconst vipDomains = [\"vip-customer.example.com\"];\nconst isVip = vipDomains.includes(senderDomain);\nreturn { isUrgent, isVip, senderEmail, senderDomain, subject: email.subject };"
      },
      "outputs": {
        "error": {
          "type": "object",
          "description": "Error information if the node fails.",
          "source": "=Error",
          "var": "error"
        },
        "output": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "decision1",
      "type": "core.logic.decision",
      "typeVersion": "1.2",
      "display": {
        "label": "Urgent + VIP?"
      },
      "inputs": {
        "expression": "$vars.classifyEmail1.output.isUrgent && $vars.classifyEmail1.output.isVip",
        "trueLabel": "Urgent VIP",
        "falseLabel": "Standard"
      },
      "outputs": {
        "matchedCase": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "matchedCase"
        },
        "matchedCaseId": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "matchedCaseId"
        }
      }
    },
    {
      "id": "end1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {}
    }
  ],
