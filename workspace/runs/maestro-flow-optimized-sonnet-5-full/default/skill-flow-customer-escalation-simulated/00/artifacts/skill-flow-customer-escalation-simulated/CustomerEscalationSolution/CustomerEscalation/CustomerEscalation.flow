        }
      }
    },
    {
      "id": "sendVipAckReply1",
      "type": "uipath.connector.uipath-microsoft-outlook365.reply-to-email",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Send VIP Ack Reply"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-microsoft-outlook365",
          "connectionId": "dd657127-91f5-4568-a3a3-c024bc03fb0f",
          "connectionResourceId": "dd657127-91f5-4568-a3a3-c024bc03fb0f",
          "connectionFolderKey": "def71452-bad1-40fa-be08-da175e89bd1a",
          "method": "POST",
          "endpoint": "/ReplyToEmailV2",
          "bodyParameters": {
            "comment": "We've received your message and a senior team member will be in touch shortly."
          },
          "queryParameters": {
            "id": "=js:$vars.emailReceived1.output.id",
            "saveAsDraft": false
          },
          "uiPathActivityTypeId": "da9976dd-3d71-35b4-bb8c-509419cb46eb",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"connectorVersion\":\"1.42.6\",\"customFieldsRequestDetails\":null,\"instanceParameters\":{\"connectorKey\":\"uipath-microsoft-outlook365\",\"objectName\":\"ReplyToEmailV2\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"ReplyToEmailV2\",\"operation\":\"create\",\"packageVersion\":\"1.0.0\",\"httpMethod\":\"POST\",\"path\":\"/ReplyToEmailV2\",\"unifiedTypesCompatible\":true,\"savedJitInputFieldId\":\"in_ReplyToEmailV2\"}}",
          "multipartParameters": [
            {
              "name": "file",
              "dataType": "file"
            },
            {
              "name": "body",
              "dataType": "string"
            }
          ],
          "inputMetadata": {
            "type": "multipart",
            "multipart": {
              "bodyFieldName": "body"
            }
          }
        }
      }
    },
    {
      "id": "createSupportTicket1",
      "type": "uipath.connector.uipath-freshworks-freshdesk.create-ticket",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Create Support Ticket"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-freshworks-freshdesk",
          "connectionId": "29aae689-111d-459f-9a4a-d1ad1d9d2761",
          "connectionResourceId": "29aae689-111d-459f-9a4a-d1ad1d9d2761",
          "connectionFolderKey": "b262689d-e2a9-4c1a-8e68-04382a7fff76",
          "method": "POST",
          "endpoint": "/tickets",
          "bodyParameters": {
            "subject": "=js:$vars.emailReceived1.output.subject",
            "description": "=js:$vars.emailReceived1.output.body.content",
            "email": "=js:$vars.classifyEmail1.output.senderEmail"
          },
          "uiPathActivityTypeId": "489bd332-d516-3ad9-b23f-b21bb4fd1a2b",
          "errorState": {
            "issues": []
          },
