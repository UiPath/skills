    },
    {
      "id": "replyTicketDetails1",
      "type": "uipath.connector.uipath-microsoft-outlook365.reply-to-email",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Reply - Ticket Details"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-microsoft-outlook365",
          "connectionId": "dd657127-91f5-4568-a3a3-c024bc03fb0f",
          "connectionResourceId": "dd657127-91f5-4568-a3a3-c024bc03fb0f",
          "connectionFolderKey": "def71452-bad1-40fa-be08-da175e89bd1a",
          "method": "POST",
          "endpoint": "/ReplyToEmailV2",
          "bodyParameters": {
            "comment": "=js:\"Hi, thank you for contacting support. We have created ticket \" + $vars.generateTicket.output.ticketId + \" (priority: \" + $vars.generateTicket.output.priority + \") to track your request. Summary: \" + $vars.generateTicket.output.summary + \". Our team will follow up with you shortly.\""
          },
          "queryParameters": {
            "id": "=js:$vars.newEmailInInbox1.output.id"
          },
          "uiPathActivityTypeId": "da9976dd-3d71-35b4-bb8c-509419cb46eb",
