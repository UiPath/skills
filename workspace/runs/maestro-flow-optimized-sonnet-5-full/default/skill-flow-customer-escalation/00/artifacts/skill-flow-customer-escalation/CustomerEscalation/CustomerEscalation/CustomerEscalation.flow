    {
      "id": "notifySlackHighTouch1",
      "type": "uipath.connector.uipath-salesforce-slack.send-message-to-channel",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Notify Slack - High Touch"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-salesforce-slack",
          "connectionId": "e03f734e-0f80-4e8a-a7c1-0ece309b0ca4",
          "connectionResourceId": "e03f734e-0f80-4e8a-a7c1-0ece309b0ca4",
          "connectionFolderKey": "def71452-bad1-40fa-be08-da175e89bd1a",
          "method": "POST",
          "endpoint": "/send_message_to_channel_v2",
          "bodyParameters": {
            "channel": "C041274J3N2",
            "messageToSend": "=js:\":rotating_light: High-touch escalation: urgent email from VIP sender \" + $vars.newEmailInInbox1.output.from.emailAddress.address + \" \\u2014 subject: \\\"\" + $vars.newEmailInInbox1.output.subject + \"\\\". Matched keywords: \" + ($vars.classifyUrgency.output.matchedKeywords || []).join(\", \") + \". Please respond ASAP.\""
          },
          "queryParameters": {
            "send_as": "bot"
          },
          "uiPathActivityTypeId": "37a305b2-89b1-315d-b73f-1778839a6c47",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"connectorVersion\":\"2.14.8\",\"customFieldsRequestDetails\":null,\"instanceParameters\":{\"connectorKey\":\"uipath-salesforce-slack\",\"objectName\":\"send_message_to_channel_v2\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"send_message_to_channel_v2\",\"operation\":\"create\",\"packageVersion\":\"1.0.0\",\"httpMethod\":\"POST\",\"path\":\"/send_message_to_channel_v2\",\"unifiedTypesCompatible\":true,\"savedJitInputFieldId\":\"in_send_message_to_channel_v2\"}}"
        }
      }
    },
    {
      "id": "classifyUrgency",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Classify Urgency"
      },
      "inputs": {
        "script": "const subject = ($vars.newEmailInInbox1.output.subject || '').toLowerCase();\nconst bodyContent = (($vars.newEmailInInbox1.output.body || {}).content || '').toLowerCase();\nconst text = subject + ' ' + bodyContent;\nconst keywords = ['urgent', 'asap', 'immediately', 'critical', 'down', 'emergency', 'escalate', 'outage', 'sev1', 'sev-1'];\nconst matched = keywords.filter(k => text.includes(k));\nreturn { isUrgent: matched.length > 0, matchedKeywords: matched };"
      },
      "outputs": {
        "error": {
          "type": "object",
          "description": "Error information if the node fails.",
          "source": "=Error",
          "var": "error"
        },
        "output": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "classifyVip",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Classify VIP Sender"
      },
      "inputs": {
        "script": "const from = $vars.newEmailInInbox1.output.from || {};\nconst email = ((from.emailAddress || {}).address || '').toLowerCase();\nconst domain = email.includes('@') ? email.split('@')[1] : '';\nconst vipDomains = ['acme.com', 'globex.com', 'initech.com', 'umbrella.com'];\nconst vipEmails = ['ceo@partnerco.com', 'cto@keyclient.io'];\nconst isVip = vipDomains.includes(domain) || vipEmails.includes(email);\nreturn { isVip: isVip, senderEmail: email, senderDomain: domain };"
      },
      "outputs": {
        "error": {
          "type": "object",
          "description": "Error information if the node fails.",
          "source": "=Error",
          "var": "error"
        },
        "output": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "routeDecision",
      "type": "core.logic.decision",
      "typeVersion": "1.2",
      "display": {
        "label": "Urgent + VIP?"
      },
      "inputs": {
        "expression": "$vars.classifyUrgency.output.isUrgent && $vars.classifyVip.output.isVip",
        "trueLabel": "Urgent + VIP",
        "falseLabel": "Standard"
      },
      "outputs": {
        "matchedCase": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "matchedCase"
        },
        "matchedCaseId": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "matchedCaseId"
        }
      }
    },
    {
      "id": "generateTicket",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Generate Support Ticket"
      },
      "inputs": {
        "script": "const msg = $vars.newEmailInInbox1.output;\nconst urgency = $vars.classifyUrgency.output;\nconst senderAddress = ((msg.from || {}).emailAddress || {}).address || 'unknown sender';\nconst shortId = (msg.id || '').slice(-8).toUpperCase() || Math.floor(Math.random() * 1e8).toString(16).toUpperCase();\nconst ticketId = 'TCK-' + shortId;\nconst priority = urgency.isUrgent ? 'High' : 'Normal';\nconst summary = 'Support request from ' + senderAddress + ': ' + msg.subject;\nreturn { ticketId: ticketId, priority: priority, summary: summary };"
      },
      "outputs": {
        "error": {
          "type": "object",
          "description": "Error information if the node fails.",
          "source": "=Error",
          "var": "error"
        },
        "output": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "endHighTouch",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End - High Touch"
      },
      "inputs": {}
    },
    {
      "id": "endStandard",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End - Standard"
      },
      "inputs": {}
    }
  ],
