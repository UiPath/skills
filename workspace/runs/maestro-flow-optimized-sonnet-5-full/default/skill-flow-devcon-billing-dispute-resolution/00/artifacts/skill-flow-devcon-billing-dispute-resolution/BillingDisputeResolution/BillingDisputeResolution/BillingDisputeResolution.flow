          "type": "object",
          "description": "Error information if the node fails.",
          "source": "=Error",
          "var": "error"
        },
        "output": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "approvalDecision",
      "type": "core.logic.decision",
      "typeVersion": "1.2",
      "display": {
        "label": "Manager Approval Decision"
      },
      "inputs": {
        "expression": "false",
        "trueLabel": "Rejected",
        "falseLabel": "Approved"
      }
    },
    {
      "id": "financialPosting",
      "type": "uipath.core.api-workflow.07d45a91-9413-4dad-82ff-28306c2d85ea",
      "typeVersion": "1.0.0",
      "display": {
        "label": "FinancialPostingFunction"
      },
      "inputs": {
