          "type": "object",
          "description": "Error information if the node fails.",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "resolutionWriterAgent",
      "type": "uipath.agent.autonomous",
      "typeVersion": "1.3",
      "display": {
        "label": "Resolution Writer Agent"
      },
      "inputs": {
        "source": "08dcc59a-5117-4035-aa7f-43d5a7431036",
        "agentInputVariables": [
          {
            "id": "normalizeInvoiceNumber__output__normalizedInvoiceNumber",
            "type": "string",
            "binding": "=$vars.normalizeInvoiceNumber.output.normalizedInvoiceNumber",
