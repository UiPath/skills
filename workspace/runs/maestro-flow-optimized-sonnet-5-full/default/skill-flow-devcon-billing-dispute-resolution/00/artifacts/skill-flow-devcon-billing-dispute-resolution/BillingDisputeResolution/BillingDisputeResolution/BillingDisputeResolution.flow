    {
      "id": "extractInvoice",
      "type": "uipath.ixp.invoices-billing-f0c606f9-ixp.99f5bbfa-5f29-8033-8662-25001b6bb18e-79a7d12e-da84-4bf4-ab60-7f34b44dd178",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Extract Invoice Fields"
      },
      "inputs": {
        "model": {
          "id": "99f5bbfa-5f29-8033-8662-25001b6bb18e",
          "modelName": "invoices-billing-f0c606f9-ixp",
          "modelDisplayName": "invoices-billing",
          "folderKey": "79a7d12e-da84-4bf4-ab60-7f34b44dd178",
          "folderName": "Shared/uipath-maestro-flow/BillingDispute",
          "folderPath": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c.5da18ec0-7de1-4e57-aaf1-ddc8a369c199.79a7d12e-da84-4bf4-ab60-7f34b44dd178",
          "description": ""
        },
        "modelName": "invoices-billing-f0c606f9-ixp",
        "description": "",
        "projectName": "invoices-billing-f0c606f9-ixp",
        "versionTag": "",
        "folderKey": "79a7d12e-da84-4bf4-ab60-7f34b44dd178",
        "folderName": "Shared/uipath-maestro-flow/BillingDispute",
        "fileRef": "=js:$vars.start.output.disputedInvoice",
        "pageRange": ""
      },
      "outputs": {
        "output": {
          "name": "output",
          "type": "object",
          "source": "=this",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "normalizeData",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Normalize Data"
      },
      "inputs": {
        "script": "const fields = ($vars.extractInvoice.output.ExtractionResult && $vars.extractInvoice.output.ExtractionResult.ResultsDocument && $vars.extractInvoice.output.ExtractionResult.ResultsDocument.Fields) || [];\nconst normalized = fields.map(function (f) {\n  const firstValue = (f.Values && f.Values.length > 0) ? f.Values[0] : null;\n  return {\n    Id: f.FieldId,\n    Name: f.FieldName,\n    Value: firstValue,\n    Type: f.FieldType,\n    IsMissing: f.IsMissing,\n    Confidence: f.Confidence\n  };\n});\nreturn { fields: normalized, count: normalized.length };"
      },
      "outputs": {
        "error": {
          "type": "object",
          "description": "Error information if the node fails.",
          "source": "=Error",
          "var": "error"
        },
        "output": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "normalizeInvoiceNumber",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Normalize Invoice Number"
      },
      "inputs": {
        "script": "const raw = ($vars.start.output.webhookPayload.invoice && $vars.start.output.webhookPayload.invoice.invoiceNumber) || '';\nlet normalized = String(raw).trim().toUpperCase();\nif (normalized.indexOf('MCS-') !== 0) {\n  normalized = 'MCS-' + normalized;\n}\nreturn { normalizedInvoiceNumber: normalized };"
      },
      "outputs": {
        "error": {
          "type": "object",
          "description": "Error information if the node fails.",
          "source": "=Error",
          "var": "error"
        },
        "output": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "mergeLookups",
      "type": "core.logic.merge",
      "typeVersion": "1.0",
      "display": {
        "label": "Merge Lookups"
      },
      "inputs": {},
      "outputs": {
        "output": {
          "type": "object",
          "description": "Merged upstream branch outputs.",
          "source": "=this",
          "var": "output"
        }
      }
    },
    {
      "id": "discrepancyDetection",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Discrepancy Detection"
      },
      "inputs": {
        "script": "const disputedLines = ($vars.start.output.webhookPayload.dispute && $vars.start.output.webhookPayload.dispute.disputedLineItems) || [];\nconst erpRows = $vars.erpLookup1.output || [];\n\nlet totalOvercharge = 0;\nlet totalUndercharge = 0;\nconst lineResults = [];\n\ndisputedLines.forEach(function (disputed) {\n  const erpRow = erpRows.find(function (row) { return Number(row.lineNumber) === Number(disputed.lineNumber); });\n  if (!erpRow) {\n    lineResults.push({\n      lineNumber: disputed.lineNumber,\n      description: disputed.description,\n      disputedAmount: disputed.amount,\n      contractedAmount: null,\n      difference: null,\n      matched: false\n    });\n    return;\n  }\n  const disputedAmount = Number(disputed.amount) || 0;\n  const contractedAmount = Number(erpRow.amount) || 0;\n  const difference = disputedAmount - contractedAmount;\n  if (difference > 0) {\n    totalOvercharge += difference;\n  } else if (difference < 0) {\n    totalUndercharge += Math.abs(difference);\n  }\n  lineResults.push({\n    lineNumber: disputed.lineNumber,\n    description: disputed.description,\n    disputedQuantity: disputed.quantity,\n    disputedUnitPrice: disputed.unitPrice,\n    disputedAmount: disputedAmount,\n    contractedQuantity: erpRow.quantity,\n    contractedUnitPrice: erpRow.unitPrice,\n    contractedAmount: contractedAmount,\n    difference: difference,\n    matched: true\n  });\n});\n\nreturn {\n  lineResults: lineResults,\n  totalOvercharge: totalOvercharge,\n  totalUndercharge: totalUndercharge,\n  hasDiscrepancies: (totalOvercharge > 0 || totalUndercharge > 0)\n};"
      },
      "outputs": {
        "error": {
          "type": "object",
          "description": "Error information if the node fails.",
          "source": "=Error",
          "var": "error"
        },
        "output": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "disputeAnalystAgent",
      "type": "uipath.agent.autonomous",
      "typeVersion": "1.3",
      "display": {
        "label": "Dispute Analyst Agent"
      },
      "inputs": {
        "source": "708b01a4-4261-4fdb-80bf-a698f3edae40",
        "agentInputVariables": [
          {
            "id": "normalizeData__output__fields",
            "type": "array",
