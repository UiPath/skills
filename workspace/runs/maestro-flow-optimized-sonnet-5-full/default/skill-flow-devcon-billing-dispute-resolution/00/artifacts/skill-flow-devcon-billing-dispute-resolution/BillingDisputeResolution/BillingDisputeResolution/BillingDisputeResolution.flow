          "indexName": {
            "type": "string"
          },
          "folderKey": {
            "type": "string"
          },
          "folderPath": {
            "type": "string"
          },
          "retrievalMode": {
            "type": "string"
          },
          "query": {
            "type": "object"
          },
          "threshold": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
