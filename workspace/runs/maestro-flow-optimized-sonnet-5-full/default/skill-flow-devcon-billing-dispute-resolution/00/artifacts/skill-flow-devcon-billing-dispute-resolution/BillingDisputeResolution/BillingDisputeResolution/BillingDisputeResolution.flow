            "type": "object",
            "properties": {
              "value": {
                "type": "string"
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "retrievalMode": {
                  "not": {
                    "enum": [
                      "deeprag",
                      "batchtransform"
                    ]
                  }
                }
              }
            },
            "then": {
              "properties": {
                "query": {
                  "oneOf": [
                    {
                      "properties": {
                        "mode": {
                          "const": "prompt"
                        },
                        "promptValue": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
