            "type": "object",
            "binding": "=$vars.discrepancyDetection.output",
            "description": "Computed pricing discrepancy summary"
          },
          {
            "id": "normalizeInvoiceNumber__output__normalizedInvoiceNumber",
            "type": "string",
            "binding": "=$vars.normalizeInvoiceNumber.output.normalizedInvoiceNumber",
            "description": "Normalized invoice number"
          }
        ],
        "agentOutputVariables": [
          {
            "id": "determination",
            "type": "string"
          },
          {
            "id": "recommendedAction",
            "type": "string"
          },
          {
            "id": "autoResolutionEligible",
            "type": "boolean"
          },
          {
            "id": "creditAmount",
            "type": "number"
          },
          {
            "id": "confidence",
            "type": "number"
          },
          {
            "id": "rationale",
            "type": "string"
          }
        ]
      },
      "outputs": {
        "error": {
          "type": "object",
          "description": "Error information if the node fails.",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "contextIndexNode",
      "type": "uipath.agent.resource.context.index.billing-dispute-sop-index.cc45b9b4-dbf6-47b3-40ac-08debc0cec5b",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Billing Dispute SOP Index"
      },
      "inputs": {
        "source": "da9282cc-1c12-4f2b-b4a9-7304a9a64f84"
      }
    },
    {
      "id": "switchRecommendedAction",
      "type": "core.logic.switch",
      "typeVersion": "1.1",
      "display": {
        "label": "Route by Recommended Action"
      },
      "inputs": {
        "cases": [
          {
            "id": "escalate_to_manager",
            "label": "Escalate to Manager",
            "expression": "$vars.disputeAnalystAgent.output.recommendedAction === \"escalate_to_manager\""
          },
          {
            "id": "auto_resolve",
            "label": "Auto Resolve",
            "expression": "$vars.disputeAnalystAgent.output.recommendedAction === \"auto_resolve\""
          },
          {
            "id": "reject",
            "label": "Reject",
            "expression": "$vars.disputeAnalystAgent.output.recommendedAction === \"reject\""
          }
        ]
      }
    },
    {
      "id": "logCreditAmount",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Log Credit Amount"
      },
      "inputs": {
        "script": "const creditAmount = $vars.disputeAnalystAgent.output.creditAmount;\nreturn { creditAmount: creditAmount };"
      },
      "outputs": {
