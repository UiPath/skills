          "configuration": "=jsonString:{\"essentialConfiguration\":{\"connectorVersion\":\"1.73.0-dev.2\",\"customFieldsRequestDetails\":{\"objectActionName\":\"GenerateSchema\",\"parameterValues\":[[\"entityName\",\"BillingDisputeCRM\"]]},\"instanceParameters\":{\"connectorKey\":\"uipath-uipath-dataservice\",\"objectName\":\"QueryEntityRecordsCurated\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"QueryEntityRecordsCurated\",\"operation\":\"list\",\"packageVersion\":\"1.0.0\",\"httpMethod\":\"POST\",\"path\":\"/v2/{entityName}/qer\",\"unifiedTypesCompatible\":true,\"savedFilterTrees\":{\"queryExpression\":{\"groupOperator\":0,\"index\":0,\"filters\":[{\"id\":\"accountNumber\",\"operator\":\"Equals\",\"value\":{\"value\":\"=js:$vars.start.output.webhookPayload.customer.accountNumber\",\"rawString\":\"accountNumber\",\"isLiteral\":false}}],\"groups\":[]}}}}",
