  "name": "HttpWebhookFlow",
  "nodes": [
    {
      "id": "httpWebhook1",
      "type": "uipath.connector.trigger.uipath-http-webhook.http-webhook",
      "typeVersion": "1.0.0",
      "display": {
        "label": "HTTP Webhook"
      },
      "inputs": {
        "entryPointId": "a602a374-86e2-406e-b26b-af395b56344b"
      }
    },
    {
      "id": "validateJsonPayload1",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Validate JSON Payload"
      },
      "inputs": {
        "script": "const rawBody = $vars.httpWebhook1.output.request_body;\nlet payload;\nlet isValid = true;\nlet errorMessage = null;\ntry {\n  payload = typeof rawBody === 'string' ? JSON.parse(rawBody) : rawBody;\n} catch (e) {\n  isValid = false;\n  errorMessage = 'Invalid JSON payload';\n}\nif (isValid && (payload === null || typeof payload !== 'object' || Array.isArray(payload))) {\n  isValid = false;\n  errorMessage = 'Payload must be a JSON object';\n}\nreturn {\n  isValid: isValid,\n  statusCode: isValid ? 200 : 400,\n  message: isValid ? 'Payload is valid' : errorMessage,\n  payload: isValid ? payload : null\n};"
      }
    },
    {
      "id": "end1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {},
      "outputs": {
        "statusCode": {
          "source": "=js:$vars.validateJsonPayload1.output.statusCode"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "httpWebhook1-output-validateJsonPayload1-input",
      "sourceNodeId": "httpWebhook1",
      "sourcePort": "output",
