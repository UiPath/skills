        "id": "start.output",
        "type": "object",
        "description": "Data passed when manually triggering the process.",
        "binding": {
          "nodeId": "start",
          "outputId": "output"
        }
      },
      {
        "id": "filterAmounts.output",
        "type": "array",
        "description": "The transformed data result",
        "binding": {
          "nodeId": "filterAmounts",
          "outputId": "output"
        }
      },
      {
