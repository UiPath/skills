    {
      "id": "extractNtsbReport",
      "type": "uipath.ixp.aviation-investigation-final-report-demo-a42b1d4d-ixp.937c414b-7879-8059-8b29-e8401d2dd3ba-c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Extract NTSB Report Fields"
      },
      "inputs": {
        "model": {
          "id": "937c414b-7879-8059-8b29-e8401d2dd3ba",
          "modelName": "aviation-investigation-final-report-demo-a42b1d4d-ixp",
          "modelDisplayName": "aviation-investigation-final-report-demo-a42b1d4d-ixp",
          "folderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "folderName": "Shared",
          "folderPath": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "description": ""
        },
        "modelName": "aviation-investigation-final-report-demo-a42b1d4d-ixp",
        "description": "",
        "projectName": "aviation-investigation-final-report-demo-a42b1d4d-ixp",
        "versionTag": "",
        "folderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
        "folderName": "Shared",
        "fileRef": "=js:$vars.start.output.ntsbReportFile",
        "pageRange": ""
      },
      "outputs": {
        "output": {
          "name": "output",
          "type": "object",
          "source": "=this",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "logNtsbNumber",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Log NTSB Number"
      },
      "inputs": {
        "script": "const fields = ($vars.extractNtsbReport.output.ExtractionResult && $vars.extractNtsbReport.output.ExtractionResult.ResultsDocument && $vars.extractNtsbReport.output.ExtractionResult.ResultsDocument.Fields) || [];\nconst fieldValue = (name) => {\n  const f = fields.find(f => f.FieldName === name);\n  return (f && f.Values && f.Values[0]) || null;\n};\nconst ntsbNumber = fieldValue('NTSB Number');\nconst eventDate = fieldValue('Event Date');\nconst locationCity = fieldValue('Location City');\nconst locationState = fieldValue('Location State');\nconst aircraftMake = fieldValue('Aircraft Make');\nconst aircraftModel = fieldValue('Aircraft Model');\nconst aircraftDamage = fieldValue('Aircraft Damage');\nreturn {\n  ntsbNumber,\n  log: 'NTSB Number: ' + ntsbNumber,\n  eventDate,\n  locationCity,\n  locationState,\n  aircraftMake,\n  aircraftModel,\n  aircraftDamage\n};"
      },
      "outputs": {
        "output": {
          "type": "any",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {},
      "outputs": {
        "ntsbNumber": {
          "source": "=js:$vars.logNtsbNumber.output.ntsbNumber"
        },
        "eventDate": {
          "source": "=js:$vars.logNtsbNumber.output.eventDate"
        },
        "locationCity": {
          "source": "=js:$vars.logNtsbNumber.output.locationCity"
        },
        "locationState": {
          "source": "=js:$vars.logNtsbNumber.output.locationState"
        },
        "aircraftMake": {
          "source": "=js:$vars.logNtsbNumber.output.aircraftMake"
        },
        "aircraftModel": {
          "source": "=js:$vars.logNtsbNumber.output.aircraftModel"
        },
        "aircraftDamage": {
          "source": "=js:$vars.logNtsbNumber.output.aircraftDamage"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "edge_start_output_extractNtsbReport_input",
