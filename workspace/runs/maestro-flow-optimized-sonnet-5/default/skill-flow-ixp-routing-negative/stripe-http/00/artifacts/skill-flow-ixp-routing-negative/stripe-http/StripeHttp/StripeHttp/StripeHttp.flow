      ],
      "debug": {
        "runtime": "bpmnEngine"
      },
      "model": {
        "type": "bpmn:ServiceTask",
        "serviceType": "Intsvc.UnifiedHttpRequest",
        "context": [
          {
            "name": "connectorKey",
            "type": "string",
            "value": "uipath-uipath-http"
          },
          {
            "name": "objectName",
            "type": "string",
            "value": "http-request"
          },
          {
            "name": "connection",
            "type": "string",
            "value": "<bindings.uipath-uipath-http connection>"
          },
          {
            "name": "folderKey",
