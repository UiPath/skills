              "telemetryData": {
                "connectorKey": "uipath-uipath-http",
                "connectorName": "HTTP Request"
              },
              "inputMetadata": {},
              "errorState": {
                "hasError": true
              }
            },
            "type": "json"
          }
        ],
        "expansion": {
