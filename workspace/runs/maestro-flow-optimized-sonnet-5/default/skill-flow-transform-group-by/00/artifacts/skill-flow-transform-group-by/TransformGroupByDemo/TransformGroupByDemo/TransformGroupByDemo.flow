  ],
  "bindings": [],
  "variables": {
    "globals": [
      {
        "id": "employees",
        "direction": "in",
        "type": "array",
        "subType": "object",
        "description": "Static list of employee records to group by department",
        "defaultValue": [
          {
            "name": "Alice",
            "department": "Engineering",
            "salary": 95000
          },
          {
            "name": "Bob",
            "department": "Engineering",
            "salary": 105000
          },
          {
            "name": "Carol",
            "department": "Sales",
            "salary": 70000
          },
          {
            "name": "Dave",
            "department": "Sales",
            "salary": 72000
          },
          {
            "name": "Eve",
            "department": "Marketing",
            "salary": 68000
          }
        ]
      },
      {
        "id": "groupedResult",
        "direction": "out",
        "type": "array",
        "description": "Employees grouped by department with headcount and salary aggregations"
      }
    ],
    "nodes": [
      {
        "id": "start.output",
        "type": "object",
        "description": "Data passed when manually triggering the process.",
        "binding": {
          "nodeId": "start",
          "outputId": "output"
        }
      },
      {
        "id": "groupByDept.output",
        "type": "array",
        "description": "The transformed data result",
        "binding": {
