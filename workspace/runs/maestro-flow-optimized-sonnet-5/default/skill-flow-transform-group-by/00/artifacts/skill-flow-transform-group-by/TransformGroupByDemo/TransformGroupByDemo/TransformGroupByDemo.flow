{
  "id": "0db1c816-c4a8-4e4a-9139-5432615f4dde",
  "version": "1.9",
  "name": "TransformGroupByDemo",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "fe8d675b-6053-408e-805e-67eac6ed396e",
        "isDefaultEntryPoint": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the process.",
          "source": "null",
          "var": "output"
        }
      }
    },
    {
      "id": "groupByDept",
      "type": "core.action.transform.group-by",
      "typeVersion": "1.1",
      "display": {
        "label": "Group by Department"
      },
      "inputs": {
        "collection": "$vars.employees",
        "operations": [
          {
            "id": "op1",
            "type": "groupBy",
            "config": {
              "groupByField": "department",
              "aggregations": [
                {
                  "id": "a1",
                  "field": "",
                  "operation": "count",
                  "alias": "headcount"
                },
                {
                  "id": "a2",
                  "field": "salary",
                  "operation": "sum",
                  "alias": "totalSalary"
                },
                {
                  "id": "a3",
                  "field": "salary",
                  "operation": "average",
                  "alias": "avgSalary"
                }
              ]
            }
          }
        ]
      },
      "outputs": {
        "output": {
          "type": "array",
          "description": "The transformed data result",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "end1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {},
      "outputs": {
        "groupedResult": {
          "source": "=js:$vars.groupByDept.output"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "e-start-groupByDept",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "groupByDept",
      "targetPort": "input"
    },
    {
      "id": "e-groupByDept-end1",
      "sourceNodeId": "groupByDept",
      "sourcePort": "output",
      "targetNodeId": "end1",
      "targetPort": "input"
    }
  ],
  "definitions": [
    {
      "nodeType": "core.trigger.manual",
      "version": "1.0",
      "category": "trigger",
      "description": "Start the process manually",
      "tags": [
        "trigger",
        "start",
        "manual"
      ],
      "sortOrder": 80,
      "display": {
        "label": "Manual trigger",
        "icon": "play",
        "shape": "circle"
      },
      "handleConfiguration": [
        {
          "position": "right",
          "handles": [
            {
              "id": "output",
              "type": "source",
              "handleType": "output",
              "showButton": true,
              "constraints": {
