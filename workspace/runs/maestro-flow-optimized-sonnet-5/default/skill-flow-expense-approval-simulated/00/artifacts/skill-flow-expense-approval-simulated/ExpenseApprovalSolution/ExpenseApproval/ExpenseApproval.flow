{
  "id": "51732d18-8acc-436c-b592-1eba1fa02b2d",
  "version": "1.9",
  "name": "ExpenseApproval",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "3fd756c2-3e95-42bd-907b-ad7eccb7fc2c",
        "isDefaultEntryPoint": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the process.",
          "source": "null",
          "var": "output"
        }
      }
    },
    {
      "id": "hitlReview1",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "Manager Approval"
      },
      "inputs": {
        "title": "Expense Approval Request",
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group"
          }
        },
        "priority": "Medium",
        "schema": {
          "schemaId": "38a82053-b2f0-4d86-b4fb-0c0f8442bb0e",
          "fields": [
            {
              "id": "expenseid",
              "label": "Expense ID",
              "type": "string",
              "direction": "input",
              "binding": "vars.start.output.expenseId"
            },
            {
              "id": "submitter",
              "label": "Submitter",
              "type": "string",
              "direction": "input",
              "binding": "vars.start.output.submitter"
            },
            {
              "id": "amount",
              "label": "Amount",
              "type": "number",
              "direction": "input",
              "binding": "vars.start.output.amount"
            },
            {
              "id": "category",
              "label": "Category",
              "type": "string",
              "direction": "input",
              "binding": "vars.start.output.category"
            },
            {
              "id": "reason",
              "label": "Reason (required if rejecting)",
              "type": "string",
              "direction": "output",
              "variable": "vars.reason",
              "required": false
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "End"
            }
          ]
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "reason": {
              "type": "string"
            },
            "Action": {
              "type": "string",
              "enum": [
                "Approve",
                "Reject"
              ],
              "default": "Approve"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": [
            "Approve",
            "Reject"
          ],
          "default": "Approve"
        }
      }
    },
    {
      "id": "logDecision",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Log Decision"
      },
      "inputs": {
        "script": "const decision = $vars.hitlReview1.status;\nconst reason = $vars.hitlReview1.output.reason || null;\nconst expenseId = $vars.start.output.expenseId;\nconst submitter = $vars.start.output.submitter;\nconst amount = $vars.start.output.amount;\nconst category = $vars.start.output.category;\nreturn { expenseId, submitter, amount, category, decision, reason };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Done"
      },
      "inputs": {}
    }
  ],
  "edges": [
    {
      "id": "e-start-hitlReview1",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "hitlReview1",
      "targetPort": "input"
    },
    {
      "id": "e-hitlReview1-logDecision",
      "sourceNodeId": "hitlReview1",
      "sourcePort": "completed",
      "targetNodeId": "logDecision",
      "targetPort": "input"
    },
    {
      "id": "e-logDecision-end",
      "sourceNodeId": "logDecision",
      "sourcePort": "success",
      "targetNodeId": "end",
      "targetPort": "input"
    }
  ],
