    {
      "id": "notifyVipEscalationsChannel1",
      "type": "uipath.connector.uipath-salesforce-slack.send-message-to-channel",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Notify VIP Escalations Channel"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-salesforce-slack",
          "connectionId": "849e85d8-1aa9-4d52-8bbd-20041c8f05d8",
          "connectionResourceId": "849e85d8-1aa9-4d52-8bbd-20041c8f05d8",
          "connectionFolderKey": "5da18ec0-7de1-4e57-aaf1-ddc8a369c199",
          "method": "POST",
          "endpoint": "/send_message_to_channel_v2",
          "bodyParameters": {
            "channel": "C0BLBJNH70U",
            "messageToSend": "=js:\":rotating_light: *VIP escalation* from *\" + $vars.classifyEscalation1.output.fromName + \"* (\" + $vars.classifyEscalation1.output.fromAddress + \")\\n*Subject:* \" + $vars.classifyEscalation1.output.subject + \"\\nThis email was flagged urgent and the sender is a VIP customer — please respond promptly.\""
          },
          "queryParameters": {
            "send_as": "bot"
          },
          "uiPathActivityTypeId": "37a305b2-89b1-315d-b73f-1778839a6c47",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"connectorVersion\":\"2.14.8\",\"customFieldsRequestDetails\":null,\"instanceParameters\":{\"connectorKey\":\"uipath-salesforce-slack\",\"objectName\":\"send_message_to_channel_v2\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"send_message_to_channel_v2\",\"operation\":\"create\",\"packageVersion\":\"1.0.0\",\"httpMethod\":\"POST\",\"path\":\"/send_message_to_channel_v2\",\"unifiedTypesCompatible\":true,\"savedJitInputFieldId\":\"in_send_message_to_channel_v2\"}}"
        }
      }
    },
    {
      "id": "sendAcknowledgmentReply1",
      "type": "uipath.connector.uipath-microsoft-outlook365.reply-to-email",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Send Acknowledgment Reply"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-microsoft-outlook365",
          "connectionId": "75dfafb4-3717-470c-a5f6-bdc144757a67",
          "connectionResourceId": "75dfafb4-3717-470c-a5f6-bdc144757a67",
          "connectionFolderKey": "5da18ec0-7de1-4e57-aaf1-ddc8a369c199",
          "method": "POST",
          "endpoint": "/ReplyToEmailV2",
          "bodyParameters": {
            "message.subject": "=js:\"Re: \" + $vars.classifyEscalation1.output.subject",
            "message.body.content": "=js:\"Hi \" + $vars.classifyEscalation1.output.fromName + \",\\n\\nThank you for reaching out. We have received your message and, given its urgency, it has been escalated directly to our team for immediate attention. Someone will be in touch with you shortly.\\n\\nBest regards,\\nCustomer Support\"",
            "message.body.contentType": "text",
            "message.importance": "high"
          },
          "queryParameters": {
            "id": "=js:$vars.classifyEscalation1.output.emailId",
            "replyToAll": false,
            "saveAsDraft": false
          },
          "uiPathActivityTypeId": "da9976dd-3d71-35b4-bb8c-509419cb46eb",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"connectorVersion\":\"1.42.6\",\"customFieldsRequestDetails\":null,\"instanceParameters\":{\"connectorKey\":\"uipath-microsoft-outlook365\",\"objectName\":\"ReplyToEmailV2\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"ReplyToEmailV2\",\"operation\":\"create\",\"packageVersion\":\"1.0.0\",\"httpMethod\":\"POST\",\"path\":\"/ReplyToEmailV2\",\"unifiedTypesCompatible\":true,\"savedJitInputFieldId\":\"in_ReplyToEmailV2\"}}",
          "multipartParameters": [
            {
              "name": "file",
              "dataType": "file"
            },
            {
              "name": "body",
              "dataType": "string"
            }
          ],
          "inputMetadata": {
            "type": "multipart",
            "multipart": {
              "bodyFieldName": "body"
            }
          }
        }
      }
    },
    {
      "id": "createSupportTicket1",
      "type": "uipath.connector.uipath-servicenow-servicenow.create-incident",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Create Support Ticket"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-servicenow-servicenow",
          "connectionId": "4c517348-3c4e-4f05-8d8e-2dfc666410c2",
          "connectionResourceId": "4c517348-3c4e-4f05-8d8e-2dfc666410c2",
          "connectionFolderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "method": "POST",
          "endpoint": "/incident",
          "bodyParameters": {
            "short_description": "=js:$vars.classifyEscalation1.output.subject",
            "description": "=js:\"Support request received from \" + $vars.classifyEscalation1.output.fromName + \" (\" + $vars.classifyEscalation1.output.fromAddress + \").\\n\\nOriginal subject: \" + $vars.classifyEscalation1.output.subject",
            "urgency": 3,
            "caller_id": "=js:$vars.classifyEscalation1.output.fromAddress"
          },
          "uiPathActivityTypeId": "06ca824f-f978-3008-a925-dee245fc6614",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"connectorVersion\":\"1.5.0\",\"customFieldsRequestDetails\":null,\"instanceParameters\":{\"connectorKey\":\"uipath-servicenow-servicenow\",\"objectName\":\"curated_incident\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"curated_incident\",\"operation\":\"create\",\"packageVersion\":\"1.0.0\",\"httpMethod\":\"POST\",\"path\":\"/incident\",\"unifiedTypesCompatible\":true,\"savedJitInputFieldId\":\"in_curated_incident\"}}"
        }
      }
    },
    {
      "id": "sendTicketConfirmationReply1",
      "type": "uipath.connector.uipath-microsoft-outlook365.reply-to-email",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Send Ticket Confirmation Reply"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-microsoft-outlook365",
          "connectionId": "75dfafb4-3717-470c-a5f6-bdc144757a67",
          "connectionResourceId": "75dfafb4-3717-470c-a5f6-bdc144757a67",
          "connectionFolderKey": "5da18ec0-7de1-4e57-aaf1-ddc8a369c199",
          "method": "POST",
          "endpoint": "/ReplyToEmailV2",
          "bodyParameters": {
            "message.subject": "=js:\"Re: \" + $vars.classifyEscalation1.output.subject",
            "message.body.content": "=js:\"Hi \" + $vars.classifyEscalation1.output.fromName + \",\\n\\nThank you for contacting us. A support ticket has been opened on your behalf — reference number \" + $vars.createSupportTicket1.output.number + \". Our team will follow up with you soon.\\n\\nBest regards,\\nCustomer Support\"",
            "message.body.contentType": "text",
            "message.importance": "normal"
          },
          "queryParameters": {
            "id": "=js:$vars.classifyEscalation1.output.emailId",
            "replyToAll": false,
            "saveAsDraft": false
          },
          "uiPathActivityTypeId": "da9976dd-3d71-35b4-bb8c-509419cb46eb",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"connectorVersion\":\"1.42.6\",\"customFieldsRequestDetails\":null,\"instanceParameters\":{\"connectorKey\":\"uipath-microsoft-outlook365\",\"objectName\":\"ReplyToEmailV2\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"ReplyToEmailV2\",\"operation\":\"create\",\"packageVersion\":\"1.0.0\",\"httpMethod\":\"POST\",\"path\":\"/ReplyToEmailV2\",\"unifiedTypesCompatible\":true,\"savedJitInputFieldId\":\"in_ReplyToEmailV2\"}}",
          "multipartParameters": [
            {
              "name": "file",
              "dataType": "file"
            },
            {
              "name": "body",
              "dataType": "string"
            }
          ],
          "inputMetadata": {
            "type": "multipart",
            "multipart": {
              "bodyFieldName": "body"
            }
          }
        }
      }
    },
    {
      "id": "classifyEscalation1",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Classify Escalation"
      },
      "inputs": {
        "script": "const email = $vars.newEmailReceived1.output;\nconst importance = (email.importance || '').toLowerCase();\nconst subject = (email.subject || '').toLowerCase();\nconst bodyContent = ((email.body || {}).content || '').toLowerCase();\nconst urgentKeywords = ['urgent', 'asap', 'immediately', 'critical', 'emergency', 'down'];\nconst isUrgent = importance === 'high' || urgentKeywords.some(k => subject.includes(k) || bodyContent.includes(k));\n\n// Placeholder VIP list — replace with a lookup against your CRM/Data Table before production use.\nconst vipEmails = ['ceo@acme-corp.com', 'cto@acme-corp.com'];\nconst vipDomains = ['acme-corp.com', 'globex-holdings.com'];\nconst fromAddress = (((email.from || {}).emailAddress || {}).address || '').toLowerCase();\nconst fromName = (((email.from || {}).emailAddress || {}).name || fromAddress);\nconst fromDomain = fromAddress.split('@')[1] || '';\nconst isVip = vipEmails.includes(fromAddress) || vipDomains.includes(fromDomain);\n\nreturn {\n  isUrgent,\n  isVip,\n  isUrgentAndVip: isUrgent && isVip,\n  emailId: email.id,\n  fromAddress,\n  fromName,\n  subject: email.subject || ''\n};"
      }
    },
    {
      "id": "urgentAndVip1",
      "type": "core.logic.decision",
      "typeVersion": "1.2",
      "display": {
        "label": "Urgent AND VIP?"
      },
      "inputs": {
        "expression": "$vars.classifyEscalation1.output.isUrgentAndVip === true",
        "trueLabel": "Urgent + VIP",
        "falseLabel": "Standard"
      }
    },
    {
      "id": "escalationHandled1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Escalation Handled"
      },
      "inputs": {}
    },
    {
      "id": "ticketCreated1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Ticket Created"
      },
      "inputs": {}
    }
  ],
