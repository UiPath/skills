    {
      "id": "notifySlackEscalation1",
      "type": "uipath.connector.uipath-salesforce-slack.send-message-to-channel",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Notify Slack: Escalation"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-salesforce-slack",
          "connectionId": "849e85d8-1aa9-4d52-8bbd-20041c8f05d8",
          "connectionResourceId": "849e85d8-1aa9-4d52-8bbd-20041c8f05d8",
          "connectionFolderKey": "5da18ec0-7de1-4e57-aaf1-ddc8a369c199",
          "method": "POST",
          "endpoint": "/send_message_to_channel_v2",
          "bodyParameters": {
            "channel": "C041274J3N2",
            "messageToSend": "=js:':rotating_light: Priority escalation — urgent email from a VIP customer.\\nFrom: ' + $vars.newInboxEmail1.output.from.emailAddress.address + '\\nSubject: ' + $vars.newInboxEmail1.output.subject + '\\nMatched keywords: ' + ($vars.classifyUrgency1.output.matchedKeywords || []).join(', ')"
          },
          "queryParameters": {
            "send_as": "bot"
          },
          "uiPathActivityTypeId": "37a305b2-89b1-315d-b73f-1778839a6c47",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"connectorVersion\":\"2.14.8\",\"customFieldsRequestDetails\":null,\"instanceParameters\":{\"connectorKey\":\"uipath-salesforce-slack\",\"objectName\":\"send_message_to_channel_v2\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"send_message_to_channel_v2\",\"operation\":\"create\",\"packageVersion\":\"1.0.0\",\"httpMethod\":\"POST\",\"path\":\"/send_message_to_channel_v2\",\"unifiedTypesCompatible\":true,\"savedJitInputFieldId\":\"in_send_message_to_channel_v2\"}}"
        }
      }
    },
    {
      "id": "replyFastResponseAck1",
      "type": "uipath.connector.uipath-microsoft-outlook365.reply-to-email",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Reply: Fast-Response Ack"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-microsoft-outlook365",
          "connectionId": "75dfafb4-3717-470c-a5f6-bdc144757a67",
          "connectionResourceId": "75dfafb4-3717-470c-a5f6-bdc144757a67",
          "connectionFolderKey": "5da18ec0-7de1-4e57-aaf1-ddc8a369c199",
          "method": "POST",
          "endpoint": "/ReplyToEmailV2",
          "bodyParameters": {
            "message.subject": "=js:'Re: ' + $vars.newInboxEmail1.output.subject + ' — We are on it'",
            "comment": "=js:'Hello,\\n\\nThank you for reaching out. We recognize this as a high-priority request and our team has been immediately notified. A member of our support staff will follow up with you shortly.\\n\\nThis is an automated acknowledgment confirming we received your message.\\n\\nBest regards,\\nCustomer Support'"
          },
          "queryParameters": {
            "id": "=js:$vars.newInboxEmail1.output.id",
            "saveAsDraft": false,
            "replyToAll": false
          },
          "uiPathActivityTypeId": "da9976dd-3d71-35b4-bb8c-509419cb46eb",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"connectorVersion\":\"1.42.6\",\"customFieldsRequestDetails\":null,\"instanceParameters\":{\"connectorKey\":\"uipath-microsoft-outlook365\",\"objectName\":\"ReplyToEmailV2\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"ReplyToEmailV2\",\"operation\":\"create\",\"packageVersion\":\"1.0.0\",\"httpMethod\":\"POST\",\"path\":\"/ReplyToEmailV2\",\"unifiedTypesCompatible\":true,\"savedJitInputFieldId\":\"in_ReplyToEmailV2\"}}",
          "multipartParameters": [
            {
              "name": "file",
              "dataType": "file"
            },
            {
              "name": "body",
              "dataType": "string"
            }
          ],
          "inputMetadata": {
            "type": "multipart",
            "multipart": {
              "bodyFieldName": "body"
            }
          }
        }
      }
    },
    {
      "id": "replyTicketDetails1",
      "type": "uipath.connector.uipath-microsoft-outlook365.reply-to-email",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Reply: Ticket Details"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-microsoft-outlook365",
          "connectionId": "75dfafb4-3717-470c-a5f6-bdc144757a67",
          "connectionResourceId": "75dfafb4-3717-470c-a5f6-bdc144757a67",
          "connectionFolderKey": "5da18ec0-7de1-4e57-aaf1-ddc8a369c199",
          "method": "POST",
          "endpoint": "/ReplyToEmailV2",
          "bodyParameters": {
            "message.subject": "=js:'Re: ' + $vars.newInboxEmail1.output.subject + ' — Support ticket ' + $vars.generateTicket1.output.ticketId + ' created'",
            "comment": "=js:'Hello,\\n\\nThank you for contacting support. We have created the following ticket for your request:\\n\\nTicket ID: ' + $vars.generateTicket1.output.ticketId + '\\nPriority: ' + $vars.generateTicket1.output.priority + '\\nSummary: ' + $vars.generateTicket1.output.summary + '\\nCreated at: ' + $vars.generateTicket1.output.createdAt + '\\n\\nOur team will follow up as soon as possible.\\n\\nBest regards,\\nCustomer Support'"
          },
          "queryParameters": {
            "id": "=js:$vars.newInboxEmail1.output.id",
            "saveAsDraft": false,
            "replyToAll": false
          },
          "uiPathActivityTypeId": "da9976dd-3d71-35b4-bb8c-509419cb46eb",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"connectorVersion\":\"1.42.6\",\"customFieldsRequestDetails\":null,\"instanceParameters\":{\"connectorKey\":\"uipath-microsoft-outlook365\",\"objectName\":\"ReplyToEmailV2\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"ReplyToEmailV2\",\"operation\":\"create\",\"packageVersion\":\"1.0.0\",\"httpMethod\":\"POST\",\"path\":\"/ReplyToEmailV2\",\"unifiedTypesCompatible\":true,\"savedJitInputFieldId\":\"in_ReplyToEmailV2\"}}",
          "multipartParameters": [
            {
              "name": "file",
              "dataType": "file"
            },
            {
              "name": "body",
              "dataType": "string"
            }
          ],
          "inputMetadata": {
            "type": "multipart",
            "multipart": {
              "bodyFieldName": "body"
            }
          }
        }
      }
    },
    {
      "id": "classifyUrgency1",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Classify Urgency"
      },
      "inputs": {
        "script": "const keywords = [\"urgent\", \"asap\", \"immediately\", \"critical\", \"emergency\", \"down\", \"escalate\"];\nconst subject = ($vars.newInboxEmail1.output.subject || \"\").toLowerCase();\nconst bodyContent = (($vars.newInboxEmail1.output.body || {}).content || \"\").toLowerCase();\nconst haystack = subject + \" \" + bodyContent;\nconst matchedKeywords = keywords.filter(k => haystack.includes(k));\nreturn { isUrgent: matchedKeywords.length > 0, matchedKeywords: matchedKeywords };"
      },
      "outputs": {
        "error": {
          "type": "object",
          "description": "Error information if the node fails.",
          "source": "=Error",
          "var": "error"
        },
        "output": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "classifyVip1",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Classify VIP Sender"
      },
      "inputs": {
        "script": "const vipDomains = [\"acme.com\", \"globex-corp.com\", \"initech.com\", \"umbrella-corp.com\"];\nconst fromAddress = (($vars.newInboxEmail1.output.from || {}).emailAddress || {}).address || \"\";\nconst email = fromAddress.toLowerCase();\nconst atIndex = email.indexOf(\"@\");\nconst domain = atIndex >= 0 ? email.slice(atIndex + 1) : \"\";\nreturn { isVip: vipDomains.includes(domain), domain: domain };"
      },
      "outputs": {
        "error": {
          "type": "object",
          "description": "Error information if the node fails.",
          "source": "=Error",
          "var": "error"
        },
        "output": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "routeDecision1",
      "type": "core.logic.decision",
      "typeVersion": "1.2",
      "display": {
        "label": "Urgent AND VIP?"
      },
      "inputs": {
        "expression": "$vars.classifyUrgency1.output.isUrgent && $vars.classifyVip1.output.isVip"
      },
      "outputs": {
        "matchedCase": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "matchedCase"
        },
        "matchedCaseId": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "matchedCaseId"
        }
      }
    },
    {
      "id": "generateTicket1",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Generate Support Ticket"
      },
      "inputs": {
        "script": "const instanceId = ($metadata.instanceId || \"\").replace(/-/g, \"\");\nconst ticketId = \"TCK-\" + instanceId.slice(0, 8).toUpperCase();\nconst subject = $vars.newInboxEmail1.output.subject || \"(no subject)\";\nconst fromAddress = (($vars.newInboxEmail1.output.from || {}).emailAddress || {}).address || \"unknown sender\";\nconst isUrgent = $vars.classifyUrgency1.output.isUrgent;\nconst priority = isUrgent ? \"High\" : \"Normal\";\nconst summary = \"Support request from \" + fromAddress + \": \" + subject;\nconst createdAt = $vars.newInboxEmail1.output.receivedDateTime || \"\";\nreturn { ticketId: ticketId, summary: summary, priority: priority, createdAt: createdAt };"
      },
      "outputs": {
        "error": {
          "type": "object",
          "description": "Error information if the node fails.",
          "source": "=Error",
          "var": "error"
        },
        "output": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "endHighTouch1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End: High-Touch"
      },
      "inputs": {}
    },
    {
      "id": "endStandard1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End: Standard"
      },
      "inputs": {}
    }
  ],
