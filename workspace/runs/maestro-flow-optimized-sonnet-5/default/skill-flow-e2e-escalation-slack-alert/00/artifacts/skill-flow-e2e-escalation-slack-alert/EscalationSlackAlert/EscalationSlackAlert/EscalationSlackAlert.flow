{
  "id": "12433a25-f13d-472a-872a-f04911e1557d",
  "version": "1.9",
  "name": "EscalationSlackAlert",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "287a0f8b-a102-483f-9c82-68ecdf6b45bc",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "postSlackAlert1",
      "type": "uipath.connector.uipath-salesforce-slack.send-message-to-channel",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Post Slack Alert"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-salesforce-slack",
          "connectionId": "e03f734e-0f80-4e8a-a7c1-0ece309b0ca4",
          "connectionResourceId": "e03f734e-0f80-4e8a-a7c1-0ece309b0ca4",
          "connectionFolderKey": "def71452-bad1-40fa-be08-da175e89bd1a",
          "method": "POST",
          "endpoint": "/send_message_to_channel_v2",
          "bodyParameters": {
            "channel": "C0B2FDZD1M3",
            "messageToSend": "=js:':rotating_light: *' + $vars.classifySeverity.output.severity + '* escalation - correlationId: ' + $vars.start.output.correlationId + '. Next steps: ' + $vars.classifySeverity.output.nextSteps"
          },
          "queryParameters": {
            "send_as": "user"
          },
          "uiPathActivityTypeId": "37a305b2-89b1-315d-b73f-1778839a6c47",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"connectorVersion\":\"2.14.8\",\"customFieldsRequestDetails\":null,\"instanceParameters\":{\"connectorKey\":\"uipath-salesforce-slack\",\"objectName\":\"send_message_to_channel_v2\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"send_message_to_channel_v2\",\"operation\":\"create\",\"packageVersion\":\"1.0.0\",\"httpMethod\":\"POST\",\"path\":\"/send_message_to_channel_v2\",\"unifiedTypesCompatible\":true,\"savedJitInputFieldId\":\"in_send_message_to_channel_v2\"}}"
        }
      }
    },
    {
      "id": "classifySeverity",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Classify Severity"
      },
      "inputs": {
        "script": "const tier = $vars.start.output.customerTier;\nconst prodDown = $vars.start.output.productionDown;\nconst workaround = $vars.start.output.workaroundAvailable;\n\nlet severity;\nlet engineeringNeeded;\nif (tier === \"Enterprise\" && prodDown === true && workaround === false) {\n  severity = \"Sev1\";\n  engineeringNeeded = true;\n} else if (prodDown === true && workaround === true) {\n  severity = \"Sev2\";\n  engineeringNeeded = true;\n} else {\n  severity = \"Sev3\";\n  engineeringNeeded = false;\n}\n\nlet nextSteps;\nif (severity === \"Sev1\") {\n  nextSteps = \"Page on-call engineering immediately - no workaround exists for this production outage.\";\n} else if (severity === \"Sev2\") {\n  nextSteps = \"Notify engineering to investigate - a workaround is in place so no immediate page is required.\";\n} else {\n  nextSteps = \"No production impact - route to support queue for standard follow-up.\";\n}\n\nreturn { severity: severity, engineeringNeeded: engineeringNeeded, nextSteps: nextSteps };"
      },
      "outputs": {
        "error": {
          "type": "object",
          "description": "Error information if the node fails.",
          "source": "=Error",
          "var": "error"
        },
        "output": {
          "type": "object",
          "description": "The return value of the node.",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "endSuccess",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Done"
      },
      "inputs": {},
      "outputs": {
        "severity": {
          "source": "=js:$vars.classifySeverity.output.severity"
        },
        "engineeringNeeded": {
          "source": "=js:$vars.classifySeverity.output.engineeringNeeded"
        },
        "caseKey": {
          "source": "=js:$vars.start.output.correlationId"
        },
        "slackMessageId": {
          "source": "=js:$vars.postSlackAlert1.output.ts"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "edge_start_output_classifySeverity_input",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "classifySeverity",
      "targetPort": "input"
    },
    {
      "id": "edge_classifySeverity_success_postSlackAlert1_input",
