<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="UiPath (https://bpmn.uipath.com)" exporterVersion="1.0">

  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:migrationVersion version="11.5" />
      <uipath:variables version="v1">
        <uipath:inputOutput id="Var_EmployeeName"  name="EmployeeName"  type="string" />
        <uipath:inputOutput id="Var_NumberOfDays"  name="NumberOfDays"  type="number" />
        <uipath:inputOutput id="Var_ManagerDecision" name="ManagerDecision" type="string" />
      </uipath:variables>
    </bpmn:extensionElements>

    <!-- Manual start event -->
    <bpmn:startEvent id="Start_Manual" name="Leave Request Received">
      <bpmn:outgoing>Flow_StartToHITL</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- HITL user task: manager reviews leave request -->
    <bpmn:userTask id="Task_ReviewLeave" name="Manager Reviews Leave Request">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Actions.HITL" version="v1" />
          <uipath:context>
            <uipath:input name="appId"       value="placeholder-leave-review-app" />
            <uipath:input name="appVersion"  value="1" />
            <uipath:input name="actions"     value="approve,reject,escalate" />
            <uipath:input name="key"         value="placeholder-folder-key" />
            <uipath:input name="taskTitle"   value="Review Leave Request" />
          </uipath:context>
          <uipath:input name="HitlTaskArguments" type="json" target="bodyField"><![CDATA[{
  "employeeName": "=vars.Var_EmployeeName",
  "numberOfDays": "=vars.Var_NumberOfDays"
}]]></uipath:input>
          <uipath:output name="Process response" type="Actions.HITL" var="Var_ManagerDecision" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_StartToHITL</bpmn:incoming>
      <bpmn:outgoing>Flow_HITLToGateway</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Exclusive gateway routing on manager decision -->
    <bpmn:exclusiveGateway id="Gw_Decision" name="Manager Decision?" default="Flow_Escalate">
      <bpmn:incoming>Flow_HITLToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Approve</bpmn:outgoing>
      <bpmn:outgoing>Flow_Reject</bpmn:outgoing>
      <bpmn:outgoing>Flow_Escalate</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Approve path -->
    <bpmn:scriptTask id="Task_Approve" name="Send Approval Notification" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"employeeName":"=vars.Var_EmployeeName","numberOfDays":"=vars.Var_NumberOfDays"}]]></uipath:input>
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Approve</bpmn:incoming>
      <bpmn:outgoing>Flow_ApproveToEnd</bpmn:outgoing>
      <bpmn:script><![CDATA[
return { response: "Approval notification sent for " + employeeName + " (" + numberOfDays + " days)" };
]]></bpmn:script>
    </bpmn:scriptTask>
    <bpmn:endEvent id="End_Approved" name="Leave Approved">
      <bpmn:incoming>Flow_ApproveToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Reject path -->
    <bpmn:scriptTask id="Task_Reject" name="Send Rejection Notification" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"employeeName":"=vars.Var_EmployeeName","numberOfDays":"=vars.Var_NumberOfDays"}]]></uipath:input>
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Reject</bpmn:incoming>
      <bpmn:outgoing>Flow_RejectToEnd</bpmn:outgoing>
      <bpmn:script><![CDATA[
return { response: "Rejection notification sent for " + employeeName + " (" + numberOfDays + " days)" };
]]></bpmn:script>
    </bpmn:scriptTask>
    <bpmn:endEvent id="End_Rejected" name="Leave Rejected">
      <bpmn:incoming>Flow_RejectToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Escalate path (default) -->
    <bpmn:scriptTask id="Task_Escalate" name="Escalate to HR" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"employeeName":"=vars.Var_EmployeeName","numberOfDays":"=vars.Var_NumberOfDays"}]]></uipath:input>
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Escalate</bpmn:incoming>
      <bpmn:outgoing>Flow_EscalateToEnd</bpmn:outgoing>
      <bpmn:script><![CDATA[
return { response: "Escalation to HR initiated for " + employeeName + " (" + numberOfDays + " days)" };
]]></bpmn:script>
    </bpmn:scriptTask>
    <bpmn:endEvent id="End_Escalated" name="Leave Escalated">
      <bpmn:incoming>Flow_EscalateToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="Flow_StartToHITL"    sourceRef="Start_Manual"   targetRef="Task_ReviewLeave" />
    <bpmn:sequenceFlow id="Flow_HITLToGateway"  sourceRef="Task_ReviewLeave" targetRef="Gw_Decision" />

    <bpmn:sequenceFlow id="Flow_Approve" sourceRef="Gw_Decision" targetRef="Task_Approve">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=vars.Var_ManagerDecision == "approve"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Reject" sourceRef="Gw_Decision" targetRef="Task_Reject">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=vars.Var_ManagerDecision == "reject"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <!-- Flow_Escalate is the gateway default (no condition) -->
    <bpmn:sequenceFlow id="Flow_Escalate"       sourceRef="Gw_Decision"    targetRef="Task_Escalate" />

    <bpmn:sequenceFlow id="Flow_ApproveToEnd"   sourceRef="Task_Approve"   targetRef="End_Approved" />
    <bpmn:sequenceFlow id="Flow_RejectToEnd"    sourceRef="Task_Reject"    targetRef="End_Rejected" />
    <bpmn:sequenceFlow id="Flow_EscalateToEnd"  sourceRef="Task_Escalate"  targetRef="End_Escalated" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_1">

      <!-- Start -->
      <bpmndi:BPMNShape id="S_Start_Manual" bpmnElement="Start_Manual">
        <dc:Bounds x="152" y="222" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- HITL task -->
      <bpmndi:BPMNShape id="S_Task_ReviewLeave" bpmnElement="Task_ReviewLeave">
        <dc:Bounds x="240" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Exclusive gateway -->
      <bpmndi:BPMNShape id="S_Gw_Decision" bpmnElement="Gw_Decision">
        <dc:Bounds x="395" y="215" width="50" height="50" />
      </bpmndi:BPMNShape>

      <!-- Approve branch -->
      <bpmndi:BPMNShape id="S_Task_Approve" bpmnElement="Task_Approve">
        <dc:Bounds x="510" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End_Approved" bpmnElement="End_Approved">
        <dc:Bounds x="672" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Reject branch -->
      <bpmndi:BPMNShape id="S_Task_Reject" bpmnElement="Task_Reject">
        <dc:Bounds x="510" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End_Rejected" bpmnElement="End_Rejected">
        <dc:Bounds x="672" y="222" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Escalate branch -->
      <bpmndi:BPMNShape id="S_Task_Escalate" bpmnElement="Task_Escalate">
        <dc:Bounds x="510" y="320" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End_Escalated" bpmnElement="End_Escalated">
        <dc:Bounds x="672" y="342" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Edges -->
      <bpmndi:BPMNEdge id="E_StartToHITL" bpmnElement="Flow_StartToHITL">
        <di:waypoint x="188" y="240" />
        <di:waypoint x="240" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_HITLToGateway" bpmnElement="Flow_HITLToGateway">
        <di:waypoint x="340" y="240" />
        <di:waypoint x="395" y="240" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="E_Approve" bpmnElement="Flow_Approve">
        <di:waypoint x="420" y="215" />
        <di:waypoint x="420" y="120" />
        <di:waypoint x="510" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Reject" bpmnElement="Flow_Reject">
        <di:waypoint x="445" y="240" />
        <di:waypoint x="510" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Escalate" bpmnElement="Flow_Escalate">
        <di:waypoint x="420" y="265" />
        <di:waypoint x="420" y="360" />
        <di:waypoint x="510" y="360" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="E_ApproveToEnd" bpmnElement="Flow_ApproveToEnd">
        <di:waypoint x="610" y="120" />
        <di:waypoint x="672" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_RejectToEnd" bpmnElement="Flow_RejectToEnd">
        <di:waypoint x="610" y="240" />
        <di:waypoint x="672" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_EscalateToEnd" bpmnElement="Flow_EscalateToEnd">
        <di:waypoint x="610" y="360" />
        <di:waypoint x="672" y="360" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
