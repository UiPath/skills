<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="UiPath (https://bpmn.uipath.com)" exporterVersion="1.0">

  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:migrationVersion version="11.5" />
      <uipath:variables version="v1">
        <uipath:inputOutput id="Var_Catalog"     name="catalog"     type="object" />
        <uipath:inputOutput id="Var_Filtered"    name="filtered"    type="object" />
        <uipath:inputOutput id="Var_ReadingList" name="readingList" type="object" />
      </uipath:variables>
    </bpmn:extensionElements>

    <!-- Manual start: no runtime input required -->
    <bpmn:startEvent id="Start_1" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!--
      Filter task: catalog is hardcoded in the args body (JSON literal, no
      expression prefix). Returns both the original catalog and the filtered
      subset so both Var_Catalog and Var_Filtered are populated.
    -->
    <bpmn:scriptTask id="Task_Filter" name="Filter Books" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{
  "catalog": [
    {"title": "Deep Learning",          "author": "Goodfellow", "difficulty": 9, "pages": 800},
    {"title": "Statistical Learning",   "author": "James",      "difficulty": 4, "pages": 440},
    {"title": "Bayesian Data Analysis", "author": "Gelman",     "difficulty": 8, "pages": 580},
    {"title": "Information Theory",     "author": "MacKay",     "difficulty": 7, "pages": 540}
  ]
}]]></uipath:input>
          <uipath:output name="catalog"  type="object" var="Var_Catalog"  source="=result.catalog"   />
          <uipath:output name="filtered" type="object" var="Var_Filtered" source="=result.response"  />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:script><![CDATA[
var filtered = catalog.filter(function(book) {
  return book.difficulty > 5 && book.pages < 600;
});
return { response: filtered, catalog: catalog };
]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- Map task: maps surviving books to {title (uppercased), author} -->
    <bpmn:scriptTask id="Task_Map" name="Build Reading List" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"filtered": "=vars.Var_Filtered"}]]></uipath:input>
          <uipath:output name="readingList" type="object" var="Var_ReadingList" source="=result.response" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:script><![CDATA[
var readingList = filtered.map(function(book) {
  return { title: book.title.toUpperCase(), author: book.author };
});
return { response: readingList };
]]></bpmn:script>
    </bpmn:scriptTask>

    <bpmn:endEvent id="End_1" name="End">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1"    targetRef="Task_Filter" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Filter" targetRef="Task_Map"   />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Map"    targetRef="End_1"      />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="S_End_1" bpmnElement="End_1"><dc:Bounds x="576" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Start_1" bpmnElement="Start_1"><dc:Bounds x="160" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_Filter" bpmnElement="Task_Filter"><dc:Bounds x="256" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_Map" bpmnElement="Task_Map"><dc:Bounds x="416" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="E_Flow_1" bpmnElement="Flow_1"><di:waypoint x="178" y="118" /><di:waypoint x="306" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_2" bpmnElement="Flow_2"><di:waypoint x="306" y="140" /><di:waypoint x="466" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_3" bpmnElement="Flow_3"><di:waypoint x="466" y="140" /><di:waypoint x="594" y="118" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
