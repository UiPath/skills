<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_InvoiceTriage"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="UiPath (https://bpmn.uipath.com)" exporterVersion="1.0">

  <bpmn:process id="Process_InvoiceTriage" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:migrationVersion version="11.5" />
      <uipath:variables version="v1">
        <!-- Input variables scoped to the start event -->
        <uipath:input id="Var_InvoiceId" name="invoiceId" type="string" elementId="Start_ManualTrigger" />
        <uipath:input id="Var_Amount" name="amount" type="number" elementId="Start_ManualTrigger" />
      </uipath:variables>
    </bpmn:extensionElements>

    <!-- Start Event: Manual trigger -->
    <bpmn:startEvent id="Start_ManualTrigger" name="Invoice Received">
      <bpmn:extensionElements>
        <uipath:entryPointId value="ep_InvoiceTriage" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_Start_to_Intake</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Record Invoice Intake -->
    <bpmn:scriptTask id="Task_RecordIntake" name="Record Invoice Intake" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"invoiceId":"=vars.Var_InvoiceId","amount":"=vars.Var_Amount"}]]></uipath:input>
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_to_Intake</bpmn:incoming>
      <bpmn:outgoing>Flow_Intake_to_XorGw</bpmn:outgoing>
      <bpmn:script><![CDATA[return { response: "intake recorded for invoice " + invoiceId };]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- Exclusive Gateway: Route by invoice amount -->
    <bpmn:exclusiveGateway id="Gw_AmountCheck" name="High-Value?" default="Flow_AutoApprovalRoute">
      <bpmn:incoming>Flow_Intake_to_XorGw</bpmn:incoming>
      <bpmn:outgoing>Flow_HighValueRoute</bpmn:outgoing>
      <bpmn:outgoing>Flow_AutoApprovalRoute</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 2a: Manager Review (high-value path) -->
    <bpmn:scriptTask id="Task_ManagerReview" name="Manager Review" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"invoiceId":"=vars.Var_InvoiceId","amount":"=vars.Var_Amount"}]]></uipath:input>
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_HighValueRoute</bpmn:incoming>
      <bpmn:outgoing>Flow_ManagerReview_to_ParFork</bpmn:outgoing>
      <bpmn:script><![CDATA[return { response: "manager reviewed invoice " + invoiceId };]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- Task 2b: Auto Approval (default path) -->
    <bpmn:scriptTask id="Task_AutoApproval" name="Auto Approval" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"invoiceId":"=vars.Var_InvoiceId","amount":"=vars.Var_Amount"}]]></uipath:input>
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AutoApprovalRoute</bpmn:incoming>
      <bpmn:outgoing>Flow_AutoApproval_to_ParFork</bpmn:outgoing>
      <bpmn:script><![CDATA[return { response: "auto-approved invoice " + invoiceId };]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- Parallel Gateway Fork: Start follow-up tasks -->
    <bpmn:parallelGateway id="Gw_ParFork" name="Start Follow-ups">
      <bpmn:incoming>Flow_ManagerReview_to_ParFork</bpmn:incoming>
      <bpmn:incoming>Flow_AutoApproval_to_ParFork</bpmn:incoming>
      <bpmn:outgoing>Flow_Fork_to_Notify</bpmn:outgoing>
      <bpmn:outgoing>Flow_Fork_to_Archive</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 3a: Notify Requester -->
    <bpmn:scriptTask id="Task_NotifyRequester" name="Notify Requester" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"invoiceId":"=vars.Var_InvoiceId"}]]></uipath:input>
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Fork_to_Notify</bpmn:incoming>
      <bpmn:outgoing>Flow_Notify_to_ParJoin</bpmn:outgoing>
      <bpmn:script><![CDATA[return { response: "requester notified for invoice " + invoiceId };]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- Task 3b: Archive Decision -->
    <bpmn:scriptTask id="Task_ArchiveDecision" name="Archive Decision" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"invoiceId":"=vars.Var_InvoiceId"}]]></uipath:input>
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Fork_to_Archive</bpmn:incoming>
      <bpmn:outgoing>Flow_Archive_to_ParJoin</bpmn:outgoing>
      <bpmn:script><![CDATA[return { response: "decision archived for invoice " + invoiceId };]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- Parallel Gateway Join: Synchronize follow-ups -->
    <bpmn:parallelGateway id="Gw_ParJoin" name="Follow-ups Done">
      <bpmn:incoming>Flow_Notify_to_ParJoin</bpmn:incoming>
      <bpmn:incoming>Flow_Archive_to_ParJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_ParJoin_to_End</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- End Event -->
    <bpmn:endEvent id="End_ProcessComplete" name="Process Complete">
      <bpmn:incoming>Flow_ParJoin_to_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_Start_to_Intake"
        sourceRef="Start_ManualTrigger" targetRef="Task_RecordIntake" />

    <bpmn:sequenceFlow id="Flow_Intake_to_XorGw"
        sourceRef="Task_RecordIntake" targetRef="Gw_AmountCheck" />

    <!-- Conditional: high-value (amount >= 1000) -->
    <bpmn:sequenceFlow id="Flow_HighValueRoute"
        sourceRef="Gw_AmountCheck" targetRef="Task_ManagerReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=vars.Var_Amount >= 1000</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Default: auto-approval for all other invoices -->
    <bpmn:sequenceFlow id="Flow_AutoApprovalRoute"
        sourceRef="Gw_AmountCheck" targetRef="Task_AutoApproval" />

    <bpmn:sequenceFlow id="Flow_ManagerReview_to_ParFork"
        sourceRef="Task_ManagerReview" targetRef="Gw_ParFork" />

    <bpmn:sequenceFlow id="Flow_AutoApproval_to_ParFork"
        sourceRef="Task_AutoApproval" targetRef="Gw_ParFork" />

    <bpmn:sequenceFlow id="Flow_Fork_to_Notify"
        sourceRef="Gw_ParFork" targetRef="Task_NotifyRequester" />

    <bpmn:sequenceFlow id="Flow_Fork_to_Archive"
        sourceRef="Gw_ParFork" targetRef="Task_ArchiveDecision" />

    <bpmn:sequenceFlow id="Flow_Notify_to_ParJoin"
        sourceRef="Task_NotifyRequester" targetRef="Gw_ParJoin" />

    <bpmn:sequenceFlow id="Flow_Archive_to_ParJoin"
        sourceRef="Task_ArchiveDecision" targetRef="Gw_ParJoin" />

    <bpmn:sequenceFlow id="Flow_ParJoin_to_End"
        sourceRef="Gw_ParJoin" targetRef="End_ProcessComplete" />

  </bpmn:process>

  <!-- BPMN Diagram Interchange -->
  <!--
    Layout (left to right, y=center for main lane):
      Start(160,232)  Intake(246,210)  XorGw(396,225)
        HighValue up  -> ManagerReview(496,130) -> ParFork(via 636,155)
        AutoApproval down -> AutoApproval(496,310) -> ParFork(via 636,295)
      ParFork(686,225)
        Notify up    -> NotifyRequester(786,130) -> ParJoin(via 936,155)
        Archive down -> ArchiveDecision(786,310) -> ParJoin(via 936,295)
      ParJoin(986,225)  End(1086,232)
  -->
  <bpmndi:BPMNDiagram id="Diagram_InvoiceTriage">
    <bpmndi:BPMNPlane id="Plane_InvoiceTriage" bpmnElement="Process_InvoiceTriage">

      <!-- Start Event -->
      <bpmndi:BPMNShape id="S_Start_ManualTrigger" bpmnElement="Start_ManualTrigger">
        <dc:Bounds x="160" y="232" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Task: Record Invoice Intake -->
      <bpmndi:BPMNShape id="S_Task_RecordIntake" bpmnElement="Task_RecordIntake">
        <dc:Bounds x="246" y="210" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Exclusive Gateway: High-Value? -->
      <bpmndi:BPMNShape id="S_Gw_AmountCheck" bpmnElement="Gw_AmountCheck" isMarkerVisible="true">
        <dc:Bounds x="396" y="225" width="50" height="50" />
      </bpmndi:BPMNShape>

      <!-- Task: Manager Review (upper branch) -->
      <bpmndi:BPMNShape id="S_Task_ManagerReview" bpmnElement="Task_ManagerReview">
        <dc:Bounds x="496" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Task: Auto Approval (lower branch) -->
      <bpmndi:BPMNShape id="S_Task_AutoApproval" bpmnElement="Task_AutoApproval">
        <dc:Bounds x="496" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Parallel Gateway Fork -->
      <bpmndi:BPMNShape id="S_Gw_ParFork" bpmnElement="Gw_ParFork">
        <dc:Bounds x="686" y="225" width="50" height="50" />
      </bpmndi:BPMNShape>

      <!-- Task: Notify Requester (upper branch) -->
      <bpmndi:BPMNShape id="S_Task_NotifyRequester" bpmnElement="Task_NotifyRequester">
        <dc:Bounds x="786" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Task: Archive Decision (lower branch) -->
      <bpmndi:BPMNShape id="S_Task_ArchiveDecision" bpmnElement="Task_ArchiveDecision">
        <dc:Bounds x="786" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Parallel Gateway Join -->
      <bpmndi:BPMNShape id="S_Gw_ParJoin" bpmnElement="Gw_ParJoin">
        <dc:Bounds x="986" y="225" width="50" height="50" />
      </bpmndi:BPMNShape>

      <!-- End Event -->
      <bpmndi:BPMNShape id="S_End_ProcessComplete" bpmnElement="End_ProcessComplete">
        <dc:Bounds x="1088" y="232" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Edges -->

      <!-- Start -> Record Intake -->
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_Start_to_Intake" bpmnElement="Flow_Start_to_Intake">
        <di:waypoint x="196" y="250" />
        <di:waypoint x="246" y="250" />
      </bpmndi:BPMNEdge>

      <!-- Record Intake -> XOR Gateway -->
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_Intake_to_XorGw" bpmnElement="Flow_Intake_to_XorGw">
        <di:waypoint x="346" y="250" />
        <di:waypoint x="396" y="250" />
      </bpmndi:BPMNEdge>

      <!-- XOR Gateway -> Manager Review (high-value, upward) -->
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_HighValueRoute" bpmnElement="Flow_HighValueRoute">
        <di:waypoint x="421" y="225" />
        <di:waypoint x="421" y="160" />
        <di:waypoint x="496" y="160" />
      </bpmndi:BPMNEdge>

      <!-- XOR Gateway -> Auto Approval (default, downward) -->
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_AutoApprovalRoute" bpmnElement="Flow_AutoApprovalRoute">
        <di:waypoint x="421" y="275" />
        <di:waypoint x="421" y="340" />
        <di:waypoint x="496" y="340" />
      </bpmndi:BPMNEdge>

      <!-- Manager Review -> Parallel Fork (converge upward branch) -->
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_ManagerReview_to_ParFork" bpmnElement="Flow_ManagerReview_to_ParFork">
        <di:waypoint x="596" y="160" />
        <di:waypoint x="711" y="160" />
        <di:waypoint x="711" y="225" />
      </bpmndi:BPMNEdge>

      <!-- Auto Approval -> Parallel Fork (converge lower branch) -->
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_AutoApproval_to_ParFork" bpmnElement="Flow_AutoApproval_to_ParFork">
        <di:waypoint x="596" y="340" />
        <di:waypoint x="711" y="340" />
        <di:waypoint x="711" y="275" />
      </bpmndi:BPMNEdge>

      <!-- Parallel Fork -> Notify Requester (upward) -->
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_Fork_to_Notify" bpmnElement="Flow_Fork_to_Notify">
        <di:waypoint x="711" y="225" />
        <di:waypoint x="711" y="160" />
        <di:waypoint x="786" y="160" />
      </bpmndi:BPMNEdge>

      <!-- Parallel Fork -> Archive Decision (downward) -->
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_Fork_to_Archive" bpmnElement="Flow_Fork_to_Archive">
        <di:waypoint x="711" y="275" />
        <di:waypoint x="711" y="340" />
        <di:waypoint x="786" y="340" />
      </bpmndi:BPMNEdge>

      <!-- Notify Requester -> Parallel Join -->
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_Notify_to_ParJoin" bpmnElement="Flow_Notify_to_ParJoin">
        <di:waypoint x="886" y="160" />
        <di:waypoint x="1011" y="160" />
        <di:waypoint x="1011" y="225" />
      </bpmndi:BPMNEdge>

      <!-- Archive Decision -> Parallel Join -->
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_Archive_to_ParJoin" bpmnElement="Flow_Archive_to_ParJoin">
        <di:waypoint x="886" y="340" />
        <di:waypoint x="1011" y="340" />
        <di:waypoint x="1011" y="275" />
      </bpmndi:BPMNEdge>

      <!-- Parallel Join -> End -->
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_ParJoin_to_End" bpmnElement="Flow_ParJoin_to_End">
        <di:waypoint x="1036" y="250" />
        <di:waypoint x="1088" y="250" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
