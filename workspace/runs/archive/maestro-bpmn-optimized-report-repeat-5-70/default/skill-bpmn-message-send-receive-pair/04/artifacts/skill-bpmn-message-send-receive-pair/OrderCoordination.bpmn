<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="UiPath (https://bpmn.uipath.com)" exporterVersion="1.0">

  <!-- Message declaration shared by send and receive -->
  <bpmn:message id="Message_OrderReady" name="OrderReady" />

  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:migrationVersion version="11.5" />
      <uipath:variables version="v1">
        <uipath:inputOutput id="Var_OrderPacket" name="OrderPacket" type="string" />
        <uipath:inputOutput id="Var_SendResponse" name="SendResponse" type="object" />
        <uipath:inputOutput id="Var_ReceiveResponse" name="ReceiveResponse" type="object" />
      </uipath:variables>
    </bpmn:extensionElements>

    <!-- Manual start event -->
    <bpmn:startEvent id="Start_1" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Prepare order packet (registry: BPMN.ScriptTask) -->
    <bpmn:scriptTask id="Task_PrepareOrder" name="Prepare Order Packet" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{}]]></uipath:input>
          <uipath:output name="packet" type="string" var="Var_OrderPacket" source="=result.response" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:script><![CDATA[return { response: "order-packet-" + Date.now() };]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- Send internal message (registry: Maestro.SendMessageEvent on bpmn:IntermediateThrowEvent) -->
    <bpmn:intermediateThrowEvent id="ThrowEvent_SendOrder" name="Send: Order Ready">
      <bpmn:extensionElements>
        <uipath:event version="v1">
          <uipath:type value="Maestro.SendMessageEvent" version="v1" />
          <uipath:context>
            <uipath:input name="name" value="OrderReady" />
            <uipath:input name="_label" value="Order is ready" />
            <uipath:input name="inputSchema" value="{}" />
          </uipath:context>
          <uipath:input name="Reference" value="OrderReady" />
          <uipath:input name="ItemData" type="json" target="body"><![CDATA[{"Reference":"OrderReady","SpecificContent":{},"Error":"","TimeToLive":""}]]></uipath:input>
          <uipath:output name="response" type="Maestro.SendMessageEvent" var="Var_SendResponse" />
        </uipath:event>
      </bpmn:extensionElements>
      <bpmn:messageEventDefinition messageRef="Message_OrderReady" />
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- Receive internal message (registry: Maestro.ReceiveMessageEvent on bpmn:IntermediateCatchEvent) -->
    <bpmn:intermediateCatchEvent id="CatchEvent_ReceiveOrder" name="Receive: Order Ready">
      <bpmn:extensionElements>
        <uipath:event version="v1">
          <uipath:type value="Maestro.ReceiveMessageEvent" version="v1" />
          <uipath:context>
            <uipath:input name="name" value="OrderReady" />
            <uipath:input name="_label" value="Order is ready" />
          </uipath:context>
          <uipath:input name="Reference" value="OrderReady" />
          <uipath:input name="ItemData" type="json" target="body"><![CDATA[{}]]></uipath:input>
          <uipath:output name="response" type="Maestro.ReceiveMessageEvent" var="Var_ReceiveResponse" />
        </uipath:event>
      </bpmn:extensionElements>
      <bpmn:messageEventDefinition messageRef="Message_OrderReady" />
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- End event -->
    <bpmn:endEvent id="End_1" name="End">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Task_PrepareOrder" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_PrepareOrder" targetRef="ThrowEvent_SendOrder" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="ThrowEvent_SendOrder" targetRef="CatchEvent_ReceiveOrder" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="CatchEvent_ReceiveOrder" targetRef="End_1" />
  </bpmn:process>

  <!-- Diagram: one BPMNShape per node, one BPMNEdge per flow -->
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_1">

      <!-- Shapes -->
      <bpmndi:BPMNShape id="S_Start_1" bpmnElement="Start_1">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_Task_PrepareOrder" bpmnElement="Task_PrepareOrder">
        <dc:Bounds x="250" y="78" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_ThrowEvent_SendOrder" bpmnElement="ThrowEvent_SendOrder">
        <dc:Bounds x="412" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_CatchEvent_ReceiveOrder" bpmnElement="CatchEvent_ReceiveOrder">
        <dc:Bounds x="512" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_End_1" bpmnElement="End_1">
        <dc:Bounds x="612" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Edges -->
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="196" y="118" />
        <di:waypoint x="250" y="118" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="350" y="118" />
        <di:waypoint x="412" y="118" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_3" bpmnElement="Flow_3">
        <di:waypoint x="448" y="118" />
        <di:waypoint x="512" y="118" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_4" bpmnElement="Flow_4">
        <di:waypoint x="548" y="118" />
        <di:waypoint x="612" y="118" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
