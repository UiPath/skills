<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="UiPath (https://bpmn.uipath.com)" exporterVersion="1.0">

  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:migrationVersion version="11.5" />

      <uipath:variables version="v1">
        <!-- expenseId: string identifier for the expense record being evaluated -->
        <uipath:inputOutput id="Var_ExpenseId" name="expenseId" type="string" />
        <!-- amount: numeric monetary value of the expense -->
        <uipath:inputOutput id="Var_Amount" name="amount" type="number" />
        <!-- decision: string outcome written by the auto-approve branch -->
        <uipath:inputOutput id="Var_Decision" name="decision" type="string" />
        <!-- agentResult: RunJob response returned by the triage agent service task -->
        <uipath:inputOutput id="Var_AgentResult" name="agentResult" type="object" />
        <!-- queueResult: CreateQueueItem response for the high-amount branch -->
        <uipath:inputOutput id="Var_QueueResult" name="queueResult" type="object" />
      </uipath:variables>

      <uipath:bindings version="v1">
        <uipath:binding id="Binding_AgentName" resource="process" propertyAttribute="name" default="placeholder-triage-agent" />
        <uipath:binding id="Binding_AgentFolder" resource="process" propertyAttribute="folderPath" default="placeholder-folder" />
      </uipath:bindings>
    </bpmn:extensionElements>

    <!-- Manual start: receives expenseId and amount as inputs -->
    <bpmn:startEvent id="StartEvent_1" name="Start Expense Approval">
      <bpmn:outgoing>Flow_Start</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Service task: invokes a synthetic triage agent via Orchestrator.StartAgentJob -->
    <bpmn:serviceTask id="Task_TriageAgent" name="Triage Expense">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.StartAgentJob" version="v1" />
          <uipath:context>
            <uipath:input name="name" value="=bindings.Binding_AgentName" />
            <uipath:input name="folderPath" value="=bindings.Binding_AgentFolder" />
          </uipath:context>
          <uipath:input name="JobArguments" type="json" target="bodyField"><![CDATA[{"expenseId":"=vars.Var_ExpenseId","amount":"=vars.Var_Amount"}]]></uipath:input>
          <uipath:output name="Process response" type="Orchestrator.RunJob" var="Var_AgentResult" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start</bpmn:incoming>
      <bpmn:outgoing>Flow_ToGateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Exclusive gateway: routes on amount threshold -->
    <bpmn:exclusiveGateway id="Gateway_AmountCheck" name="Amount >= 1000?" default="Flow_Default">
      <bpmn:incoming>Flow_ToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_High</bpmn:outgoing>
      <bpmn:outgoing>Flow_Default</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- High-amount branch: creates a queue item for manual review -->
    <bpmn:sendTask id="Task_CreateQueue" name="Queue for Manual Review">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.CreateQueueItem" version="v1" />
          <uipath:context>
            <uipath:input name="queueName" value="placeholder-expense-queue" />
            <uipath:input name="folderId" value="" />
            <uipath:input name="folderPath" value="placeholder-folder" />
          </uipath:context>
          <uipath:input name="ItemData" type="json" target="body"><![CDATA[{"expenseId":"=vars.Var_ExpenseId","amount":"=vars.Var_Amount"}]]></uipath:input>
          <uipath:output name="response" type="Orchestrator.CreateQueueItem" var="Var_QueueResult" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_High</bpmn:incoming>
      <bpmn:outgoing>Flow_QueueToJoin</bpmn:outgoing>
    </bpmn:sendTask>

    <!-- Default branch: auto-approves low-amount expenses and writes decision output -->
    <bpmn:scriptTask id="Task_AutoApprove" name="Auto-Approve Expense" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"amount":"=vars.Var_Amount","expenseId":"=vars.Var_ExpenseId"}]]></uipath:input>
          <uipath:output name="decision" type="string" var="Var_Decision" source="=result.response" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Default</bpmn:incoming>
      <bpmn:outgoing>Flow_AutoToJoin</bpmn:outgoing>
      <bpmn:script><![CDATA[
var outcome = "auto-approved";
return { response: outcome };
]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- Join gateway: merges high-amount and default branches -->
    <bpmn:exclusiveGateway id="Gateway_Join" name="" default="Flow_ToEnd">
      <bpmn:incoming>Flow_QueueToJoin</bpmn:incoming>
      <bpmn:incoming>Flow_AutoToJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="EndEvent_1" name="Approval Routed">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Start" sourceRef="StartEvent_1" targetRef="Task_TriageAgent" />
    <bpmn:sequenceFlow id="Flow_ToGateway" sourceRef="Task_TriageAgent" targetRef="Gateway_AmountCheck" />
    <bpmn:sequenceFlow id="Flow_High" sourceRef="Gateway_AmountCheck" targetRef="Task_CreateQueue">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=vars.Var_Amount >= 1000</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Default" sourceRef="Gateway_AmountCheck" targetRef="Task_AutoApprove" />
    <bpmn:sequenceFlow id="Flow_QueueToJoin" sourceRef="Task_CreateQueue" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_AutoToJoin" sourceRef="Task_AutoApprove" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Gateway_Join" targetRef="EndEvent_1" />
  </bpmn:process>


  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="S_EndEvent_1" bpmnElement="EndEvent_1"><dc:Bounds x="796" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Gateway_AmountCheck" bpmnElement="Gateway_AmountCheck"><dc:Bounds x="416" y="100" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Gateway_Join" bpmnElement="Gateway_Join"><dc:Bounds x="686" y="100" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_StartEvent_1" bpmnElement="StartEvent_1"><dc:Bounds x="160" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_AutoApprove" bpmnElement="Task_AutoApprove"><dc:Bounds x="526" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_CreateQueue" bpmnElement="Task_CreateQueue"><dc:Bounds x="526" y="210" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_TriageAgent" bpmnElement="Task_TriageAgent"><dc:Bounds x="256" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="E_Flow_AutoToJoin" bpmnElement="Flow_AutoToJoin"><di:waypoint x="576" y="140" /><di:waypoint x="711" y="125" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_Default" bpmnElement="Flow_Default"><di:waypoint x="441" y="125" /><di:waypoint x="576" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_High" bpmnElement="Flow_High"><di:waypoint x="441" y="125" /><di:waypoint x="576" y="250" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_QueueToJoin" bpmnElement="Flow_QueueToJoin"><di:waypoint x="576" y="250" /><di:waypoint x="711" y="125" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_Start" bpmnElement="Flow_Start"><di:waypoint x="178" y="118" /><di:waypoint x="306" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_ToEnd" bpmnElement="Flow_ToEnd"><di:waypoint x="711" y="125" /><di:waypoint x="814" y="118" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_ToGateway" bpmnElement="Flow_ToGateway"><di:waypoint x="306" y="140" /><di:waypoint x="441" y="125" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
