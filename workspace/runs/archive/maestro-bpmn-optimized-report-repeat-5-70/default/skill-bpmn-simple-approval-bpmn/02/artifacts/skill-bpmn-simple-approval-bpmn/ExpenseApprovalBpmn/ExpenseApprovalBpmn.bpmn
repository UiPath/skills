<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="UiPath (https://bpmn.uipath.com)" exporterVersion="1.0">

  <bpmn:process id="Process_ExpenseApproval" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:migrationVersion version="11" />
      <uipath:variables version="v1">
        <!-- expenseId: input, string, identifies the expense record being triaged -->
        <uipath:input id="Var_expenseId" name="expenseId" type="string" elementId="Start_ManualExpense" />
        <!-- amount: input, number, monetary value of the expense request -->
        <uipath:input id="Var_amount" name="amount" type="number" elementId="Start_ManualExpense" />
        <!-- decision: output, string, final approval verdict written by the auto-approve branch -->
        <uipath:output id="Var_decision" name="decision" type="string" />
      </uipath:variables>
      <uipath:bindings version="v1">
        <!-- Synthetic placeholder binding for the agent name (not a real deployed resource) -->
        <uipath:binding id="Binding_agentName" resource="process" propertyAttribute="name" default="PlaceholderTriageAgent" />
        <!-- Synthetic placeholder binding for the agent folder path -->
        <uipath:binding id="Binding_agentFolder" resource="process" propertyAttribute="folderPath" default="Shared/PlaceholderFolder" />
      </uipath:bindings>
    </bpmn:extensionElements>

    <!-- START EVENT: manual trigger, receives expenseId and amount -->
    <bpmn:startEvent id="Start_ManualExpense" name="Expense Submitted">
      <bpmn:extensionElements>
        <uipath:entryPointId value="ep_ExpenseApproval" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_StartToTriage</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- SERVICE TASK: calls Orchestrator.StartAgentJob to triage the expense -->
    <bpmn:serviceTask id="Task_TriageAgent" name="Triage Expense">
      <bpmn:extensionElements>
        <uipath:activity type="Orchestrator.StartAgentJob" version="v1">
          <uipath:context>
            <uipath:input name="name" value="=bindings.Binding_agentName" />
            <uipath:input name="folderPath" value="=bindings.Binding_agentFolder" />
          </uipath:context>
          <uipath:input name="JobArguments" type="json" target="bodyField"><![CDATA[{"expenseId":"=vars.Var_expenseId","amount":"=vars.Var_amount"}]]></uipath:input>
          <uipath:output name="Process response" type="Orchestrator.RunJob" var="Var_decision" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_StartToTriage</bpmn:incoming>
      <bpmn:outgoing>Flow_TriageToGw</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- EXCLUSIVE GATEWAY: routes by amount threshold -->
    <bpmn:exclusiveGateway id="Gw_AmountCheck" name="Amount >= 1000?" default="Flow_LowAmount">
      <bpmn:incoming>Flow_TriageToGw</bpmn:incoming>
      <bpmn:outgoing>Flow_HighAmount</bpmn:outgoing>
      <bpmn:outgoing>Flow_LowAmount</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- SEND TASK: high-amount branch, creates a queue item for manual review -->
    <bpmn:sendTask id="Task_CreateQueueItem" name="Queue for Manual Review">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.CreateQueueItem" version="v1" />
          <uipath:context>
            <uipath:input name="queueName" value="PlaceholderApprovalQueue" />
            <uipath:input name="folderId" value="" />
            <uipath:input name="folderPath" value="Shared/PlaceholderFolder" />
          </uipath:context>
          <uipath:input name="ItemData" type="json" target="body"><![CDATA[{"expenseId":"=vars.Var_expenseId","amount":"=vars.Var_amount"}]]></uipath:input>
          <uipath:output name="response" type="Orchestrator.CreateQueueItem" var="Var_decision" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_HighAmount</bpmn:incoming>
      <bpmn:outgoing>Flow_HighToEnd</bpmn:outgoing>
    </bpmn:sendTask>

    <!-- SCRIPT TASK: low-amount branch, auto-approves and writes decision variable -->
    <bpmn:scriptTask id="Task_AutoApprove" name="Auto Approve" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"amount":"=vars.Var_amount","expenseId":"=vars.Var_expenseId"}]]></uipath:input>
          <uipath:output name="decision" type="string" var="Var_decision" source="=result.response" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_LowAmount</bpmn:incoming>
      <bpmn:outgoing>Flow_LowToEnd</bpmn:outgoing>
      <bpmn:script><![CDATA[
var verdict = "approved";
return { response: verdict };
]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- END EVENT: single convergence point for both branches -->
    <bpmn:endEvent id="End_Done" name="Done">
      <bpmn:incoming>Flow_HighToEnd</bpmn:incoming>
      <bpmn:incoming>Flow_LowToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- SEQUENCE FLOWS -->
    <bpmn:sequenceFlow id="Flow_StartToTriage"   sourceRef="Start_ManualExpense" targetRef="Task_TriageAgent" />
    <bpmn:sequenceFlow id="Flow_TriageToGw"      sourceRef="Task_TriageAgent"   targetRef="Gw_AmountCheck" />
    <bpmn:sequenceFlow id="Flow_HighAmount"       sourceRef="Gw_AmountCheck"     targetRef="Task_CreateQueueItem">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=vars.Var_amount >= 1000</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_LowAmount"        sourceRef="Gw_AmountCheck"     targetRef="Task_AutoApprove" />
    <bpmn:sequenceFlow id="Flow_HighToEnd"        sourceRef="Task_CreateQueueItem" targetRef="End_Done" />
    <bpmn:sequenceFlow id="Flow_LowToEnd"         sourceRef="Task_AutoApprove"   targetRef="End_Done" />

  </bpmn:process>

  <!-- DIAGRAM INTERCHANGE: shapes and edges generated left-to-right -->
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_ExpenseApproval">

      <!-- Shapes -->
      <bpmndi:BPMNShape id="S_Start_ManualExpense" bpmnElement="Start_ManualExpense">
        <dc:Bounds x="160" y="202" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_Task_TriageAgent" bpmnElement="Task_TriageAgent">
        <dc:Bounds x="260" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_Gw_AmountCheck" bpmnElement="Gw_AmountCheck">
        <dc:Bounds x="430" y="195" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_Task_CreateQueueItem" bpmnElement="Task_CreateQueueItem">
        <dc:Bounds x="560" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_Task_AutoApprove" bpmnElement="Task_AutoApprove">
        <dc:Bounds x="560" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_End_Done" bpmnElement="End_Done">
        <dc:Bounds x="740" y="202" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Edges -->
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_StartToTriage" bpmnElement="Flow_StartToTriage">
        <di:waypoint x="196" y="220" />
        <di:waypoint x="260" y="220" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_TriageToGw" bpmnElement="Flow_TriageToGw">
        <di:waypoint x="360" y="220" />
        <di:waypoint x="430" y="220" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_HighAmount" bpmnElement="Flow_HighAmount">
        <di:waypoint x="455" y="195" />
        <di:waypoint x="455" y="140" />
        <di:waypoint x="560" y="140" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_LowAmount" bpmnElement="Flow_LowAmount">
        <di:waypoint x="455" y="245" />
        <di:waypoint x="455" y="300" />
        <di:waypoint x="560" y="300" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_HighToEnd" bpmnElement="Flow_HighToEnd">
        <di:waypoint x="660" y="140" />
        <di:waypoint x="758" y="140" />
        <di:waypoint x="758" y="202" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_LowToEnd" bpmnElement="Flow_LowToEnd">
        <di:waypoint x="660" y="300" />
        <di:waypoint x="758" y="300" />
        <di:waypoint x="758" y="238" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
