<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="UiPath (https://bpmn.uipath.com)" exporterVersion="1.0">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:migrationVersion version="11.5" />
      <uipath:variables version="v1">
        <uipath:inputOutput id="Var_ApprovalResult" name="ApprovalResult" type="object" />
      </uipath:variables>
    </bpmn:extensionElements>

    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_Start_Review</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="UserTask_Review" name="Review and Approve Request">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Actions.HITL" version="v1" />
          <uipath:context>
            <uipath:input name="appId" value="" />
            <uipath:input name="appVersion" value="" />
            <uipath:input name="actions" value="" />
            <uipath:input name="key" value="" />
            <uipath:input name="taskTitle" value="Review and Approve Request" />
          </uipath:context>
          <uipath:input name="HitlTaskArguments" type="json" target="bodyField"><![CDATA[{}]]></uipath:input>
          <uipath:output name="Process response" type="Actions.HITL" var="Var_ApprovalResult" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_Review</bpmn:incoming>
      <bpmn:outgoing>Flow_Review_End</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:boundaryEvent id="BoundaryEvent_Timer" name="1 Hour Reminder"
                        attachedToRef="UserTask_Review" cancelActivity="false">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT1H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
      <bpmn:outgoing>Flow_Timer_Reminder</bpmn:outgoing>
    </bpmn:boundaryEvent>

    <bpmn:endEvent id="EndEvent_Main" name="Request Completed">
      <bpmn:incoming>Flow_Review_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:scriptTask id="Task_Reminder" name="Send Reminder" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{}]]></uipath:input>
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Timer_Reminder</bpmn:incoming>
      <bpmn:outgoing>Flow_Reminder_End</bpmn:outgoing>
      <bpmn:script><![CDATA[return { response: "Reminder sent" };]]></bpmn:script>
    </bpmn:scriptTask>

    <bpmn:endEvent id="EndEvent_Reminder" name="Reminder Sent">
      <bpmn:incoming>Flow_Reminder_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Start_Review" sourceRef="StartEvent_1" targetRef="UserTask_Review" />
    <bpmn:sequenceFlow id="Flow_Review_End" sourceRef="UserTask_Review" targetRef="EndEvent_Main" />
    <bpmn:sequenceFlow id="Flow_Timer_Reminder" sourceRef="BoundaryEvent_Timer" targetRef="Task_Reminder" />
    <bpmn:sequenceFlow id="Flow_Reminder_End" sourceRef="Task_Reminder" targetRef="EndEvent_Reminder" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="S_StartEvent_1" bpmnElement="StartEvent_1">
        <dc:Bounds x="162" y="202" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_UserTask_Review" bpmnElement="UserTask_Review">
        <dc:Bounds x="260" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_BoundaryEvent_Timer" bpmnElement="BoundaryEvent_Timer">
        <dc:Bounds x="292" y="242" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_EndEvent_Main" bpmnElement="EndEvent_Main">
        <dc:Bounds x="432" y="202" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_Reminder" bpmnElement="Task_Reminder">
        <dc:Bounds x="260" y="360" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_EndEvent_Reminder" bpmnElement="EndEvent_Reminder">
        <dc:Bounds x="432" y="382" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="E_Flow_Start_Review" bpmnElement="Flow_Start_Review">
        <di:waypoint x="198" y="220" />
        <di:waypoint x="260" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_Review_End" bpmnElement="Flow_Review_End">
        <di:waypoint x="360" y="220" />
        <di:waypoint x="432" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_Timer_Reminder" bpmnElement="Flow_Timer_Reminder">
        <di:waypoint x="310" y="278" />
        <di:waypoint x="310" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_Reminder_End" bpmnElement="Flow_Reminder_End">
        <di:waypoint x="360" y="400" />
        <di:waypoint x="432" y="400" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
