<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="UiPath (https://bpmn.uipath.com)" exporterVersion="1.0">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:migrationVersion version="11.5" />
      <uipath:variables version="v1">
        <uipath:inputOutput id="Var_Cities" name="cities" type="array">
          <uipath:defaultValue><![CDATA[["Seattle","Phoenix","New York"]]]></uipath:defaultValue>
        </uipath:inputOutput>
        <uipath:inputOutput id="Var_Results" name="results" type="array">
          <uipath:defaultValue><![CDATA[[]]]></uipath:defaultValue>
        </uipath:inputOutput>
      </uipath:variables>
    </bpmn:extensionElements>

    <bpmn:startEvent id="Start_1" name="Start">
      <bpmn:extensionElements>
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.Variables" version="v1" />
          <uipath:input name="cities" type="json" var="Var_Cities"><![CDATA[["Seattle","Phoenix","New York"]]]></uipath:input>
          <uipath:input name="results" type="json" var="Var_Results"><![CDATA[[]]]></uipath:input>
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_StartToTask</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:scriptTask id="Task_WeatherClassify" name="Classify City Weather" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"city":"=iterator.item","currentResults":"=vars.Var_Results"}]]></uipath:input>
          <uipath:output name="updatedResults" type="array" var="Var_Results" source="=result.response" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:multiInstanceLoopCharacteristics isSequential="false">
        <bpmn:extensionElements>
          <uipath:loopCharacteristics
              inputCollection="=vars.Var_Cities"
              inputElement="item" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:incoming>Flow_StartToTask</bpmn:incoming>
      <bpmn:outgoing>Flow_TaskToEnd</bpmn:outgoing>
      <bpmn:script><![CDATA[
var temperatures = {
  "Seattle": 55,
  "Phoenix": 95,
  "New York": 65
};
var temp = temperatures[city] !== undefined ? temperatures[city] : 70;
var verdict = temp > 60 ? "warm" : "cold";
var entry = { city: city, temperature: temp, verdict: verdict };
var updated = (currentResults || []).concat([entry]);
return { response: updated };
]]></bpmn:script>
    </bpmn:scriptTask>

    <bpmn:endEvent id="End_1" name="End">
      <bpmn:incoming>Flow_TaskToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_StartToTask" sourceRef="Start_1" targetRef="Task_WeatherClassify" />
    <bpmn:sequenceFlow id="Flow_TaskToEnd" sourceRef="Task_WeatherClassify" targetRef="End_1" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="S_End_1" bpmnElement="End_1"><dc:Bounds x="416" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Start_1" bpmnElement="Start_1"><dc:Bounds x="160" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_WeatherClassify" bpmnElement="Task_WeatherClassify"><dc:Bounds x="256" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="E_Flow_StartToTask" bpmnElement="Flow_StartToTask"><di:waypoint x="178" y="118" /><di:waypoint x="306" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_TaskToEnd" bpmnElement="Flow_TaskToEnd"><di:waypoint x="306" y="140" /><di:waypoint x="434" y="118" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
