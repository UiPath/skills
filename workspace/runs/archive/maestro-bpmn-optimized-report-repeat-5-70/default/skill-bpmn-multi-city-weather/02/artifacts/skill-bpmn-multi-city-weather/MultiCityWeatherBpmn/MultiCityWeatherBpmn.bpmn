<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="UiPath (https://bpmn.uipath.com)" exporterVersion="1.0">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:migrationVersion version="11.5" />
      <uipath:variables version="v1">
        <!-- cities: initial collection for the multi-instance loop -->
        <uipath:inputOutput id="Var_Cities" name="cities" type="json"><![CDATA[["Seattle","Phoenix","New York"]]]></uipath:inputOutput>
        <!-- results: collection variable accumulating per-city output -->
        <uipath:inputOutput id="Var_Results" name="results" type="json"><![CDATA[[]]]></uipath:inputOutput>
      </uipath:variables>
    </bpmn:extensionElements>

    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:extensionElements>
        <uipath:entryPointId value="EntryPoint_1" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!--
      Parallel multi-instance script task: one instance per city in Var_Cities.
      Each instance classifies its city as warm (>60F) or cold and appends
      {city, temperature, verdict} to Var_Results.
    -->
    <bpmn:scriptTask id="Task_WeatherClassify" name="Classify City Weather" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"city":"=iterator.item","currentResults":"=vars.Var_Results"}]]></uipath:input>
          <uipath:output name="updatedResults" type="json" var="Var_Results" source="=result.response" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:multiInstanceLoopCharacteristics isSequential="false">
        <bpmn:extensionElements>
          <uipath:loopCharacteristics
              inputCollection="=vars.Var_Cities"
              inputElement="city" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:script><![CDATA[
var cityName = city;
var hash = 0;
for (var i = 0; i < cityName.length; i++) {
  hash = (hash * 31 + cityName.charCodeAt(i)) & 0xFFFF;
}
var temperature = 45 + (hash % 50);
var verdict = temperature > 60 ? "warm" : "cold";
var entry = { city: cityName, temperature: temperature, verdict: verdict };
var prev = Array.isArray(currentResults) ? currentResults : [];
var next = prev.concat([entry]);
return { response: next };
]]></bpmn:script>
    </bpmn:scriptTask>

    <bpmn:endEvent id="EndEvent_1" name="End">
      <bpmn:incoming>Flow_2</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_WeatherClassify" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_WeatherClassify" targetRef="EndEvent_1" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="S_StartEvent_1" bpmnElement="StartEvent_1">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_WeatherClassify" bpmnElement="Task_WeatherClassify">
        <dc:Bounds x="260" y="78" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_EndEvent_1" bpmnElement="EndEvent_1">
        <dc:Bounds x="430" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="196" y="118" />
        <di:waypoint x="260" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="360" y="118" />
        <di:waypoint x="430" y="118" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
