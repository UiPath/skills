<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="UiPath (https://bpmn.uipath.com)" exporterVersion="1.0">

  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:migrationVersion version="11.5" />
      <uipath:variables version="v1">
        <uipath:inputOutput id="Var_Subject"      name="subject"      type="string" />
        <uipath:inputOutput id="Var_SenderDomain" name="senderDomain" type="string" />
        <uipath:inputOutput id="Var_Urgent"       name="urgent"       type="boolean" />
        <uipath:inputOutput id="Var_Vip"          name="vip"          type="boolean" />
        <uipath:inputOutput id="Var_TicketId"     name="ticketId"     type="string" />
      </uipath:variables>
    </bpmn:extensionElements>

    <!-- Manual start: entry point with request variables -->
    <bpmn:startEvent id="Start_Manual" name="Receive Escalation Request">
      <bpmn:extensionElements>
        <uipath:entryPointId value="EP_Start_Manual" />
        <uipath:variables version="v1">
          <uipath:inputOutput id="EP_Var_Subject"      name="subject"      type="string"  elementId="Start_Manual" direction="input" />
          <uipath:inputOutput id="EP_Var_SenderDomain" name="senderDomain" type="string"  elementId="Start_Manual" direction="input" />
        </uipath:variables>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_StartToClassifyUrgency</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Script task: classifyUrgency — sets urgent boolean -->
    <bpmn:scriptTask id="Task_ClassifyUrgency" name="classifyUrgency" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"subject":"=vars.Var_Subject","senderDomain":"=vars.Var_SenderDomain"}]]></uipath:input>
          <uipath:output name="urgent" type="boolean" var="Var_Urgent" source="=result.response" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_StartToClassifyUrgency</bpmn:incoming>
      <bpmn:outgoing>Flow_ClassifyUrgencyToClassifyVip</bpmn:outgoing>
      <bpmn:script><![CDATA[
var keywords = ["critical", "urgent", "outage", "down", "blocked"];
var subjectLower = (subject || "").toLowerCase();
var isUrgent = keywords.some(function(k) { return subjectLower.indexOf(k) >= 0; });
return { response: isUrgent };
]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- Script task: classifyVip — sets vip boolean -->
    <bpmn:scriptTask id="Task_ClassifyVip" name="classifyVip" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"senderDomain":"=vars.Var_SenderDomain"}]]></uipath:input>
          <uipath:output name="vip" type="boolean" var="Var_Vip" source="=result.response" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ClassifyUrgencyToClassifyVip</bpmn:incoming>
      <bpmn:outgoing>Flow_ClassifyVipToGateway</bpmn:outgoing>
      <bpmn:script><![CDATA[
var vipDomains = ["platinum.example.com", "premier.example.com", "enterprise.example.com"];
var isVip = vipDomains.some(function(d) { return (senderDomain || "").toLowerCase() === d; });
return { response: isVip };
]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- Exclusive gateway: routeEscalation -->
    <bpmn:exclusiveGateway id="Gw_RouteEscalation" name="routeEscalation" default="Flow_Default">
      <bpmn:incoming>Flow_ClassifyVipToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_HighTouch</bpmn:outgoing>
      <bpmn:outgoing>Flow_Default</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- High-touch path: urgent AND vip -->
    <bpmn:sequenceFlow id="Flow_HighTouch" sourceRef="Gw_RouteEscalation" targetRef="Task_EscalateSpecialist">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=vars.Var_Urgent == true &amp;&amp; vars.Var_Vip == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- User task: Escalate to specialist -->
    <bpmn:userTask id="Task_EscalateSpecialist" name="Escalate to specialist">
      <bpmn:incoming>Flow_HighTouch</bpmn:incoming>
      <bpmn:outgoing>Flow_EscalateToEnd</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End event: escalation path -->
    <bpmn:endEvent id="End_Escalated" name="Specialist Notified">
      <bpmn:incoming>Flow_EscalateToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Default path: create ticket -->
    <bpmn:sequenceFlow id="Flow_Default" sourceRef="Gw_RouteEscalation" targetRef="Task_CreateTicket" />

    <!-- Script task: createTicket — produces a ticket id -->
    <bpmn:scriptTask id="Task_CreateTicket" name="createTicket" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"subject":"=vars.Var_Subject","senderDomain":"=vars.Var_SenderDomain"}]]></uipath:input>
          <uipath:output name="ticketId" type="string" var="Var_TicketId" source="=result.response" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Default</bpmn:incoming>
      <bpmn:outgoing>Flow_TicketToEnd</bpmn:outgoing>
      <bpmn:script><![CDATA[
var ts = (new Date()).getTime();
var domainSlug = (senderDomain || "unknown").replace(/\./g, "-");
var ticketId = "TKT-" + domainSlug.toUpperCase() + "-" + ts;
return { response: ticketId };
]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- End event: ticketing path -->
    <bpmn:endEvent id="End_Ticketed" name="Ticket Created">
      <bpmn:incoming>Flow_TicketToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="Flow_StartToClassifyUrgency"        sourceRef="Start_Manual"          targetRef="Task_ClassifyUrgency" />
    <bpmn:sequenceFlow id="Flow_ClassifyUrgencyToClassifyVip"  sourceRef="Task_ClassifyUrgency"  targetRef="Task_ClassifyVip" />
    <bpmn:sequenceFlow id="Flow_ClassifyVipToGateway"          sourceRef="Task_ClassifyVip"      targetRef="Gw_RouteEscalation" />
    <bpmn:sequenceFlow id="Flow_EscalateToEnd"                 sourceRef="Task_EscalateSpecialist" targetRef="End_Escalated" />
    <bpmn:sequenceFlow id="Flow_TicketToEnd"                   sourceRef="Task_CreateTicket"     targetRef="End_Ticketed" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_1">

      <!-- Start event -->
      <bpmndi:BPMNShape id="S_Start_Manual" bpmnElement="Start_Manual">
        <dc:Bounds x="160" y="200" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- classifyUrgency -->
      <bpmndi:BPMNShape id="S_Task_ClassifyUrgency" bpmnElement="Task_ClassifyUrgency">
        <dc:Bounds x="260" y="178" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- classifyVip -->
      <bpmndi:BPMNShape id="S_Task_ClassifyVip" bpmnElement="Task_ClassifyVip">
        <dc:Bounds x="420" y="178" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- routeEscalation gateway -->
      <bpmndi:BPMNShape id="S_Gw_RouteEscalation" bpmnElement="Gw_RouteEscalation">
        <dc:Bounds x="585" y="193" width="50" height="50" />
      </bpmndi:BPMNShape>

      <!-- Escalate to specialist (user task) -->
      <bpmndi:BPMNShape id="S_Task_EscalateSpecialist" bpmnElement="Task_EscalateSpecialist">
        <dc:Bounds x="700" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- End: Specialist Notified -->
      <bpmndi:BPMNShape id="S_End_Escalated" bpmnElement="End_Escalated">
        <dc:Bounds x="864" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- createTicket (script task) -->
      <bpmndi:BPMNShape id="S_Task_CreateTicket" bpmnElement="Task_CreateTicket">
        <dc:Bounds x="700" y="298" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- End: Ticket Created -->
      <bpmndi:BPMNShape id="S_End_Ticketed" bpmnElement="End_Ticketed">
        <dc:Bounds x="864" y="320" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Edges -->
      <bpmndi:BPMNEdge id="E_StartToClassifyUrgency" bpmnElement="Flow_StartToClassifyUrgency">
        <di:waypoint x="196" y="218" />
        <di:waypoint x="260" y="218" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="E_ClassifyUrgencyToClassifyVip" bpmnElement="Flow_ClassifyUrgencyToClassifyVip">
        <di:waypoint x="360" y="218" />
        <di:waypoint x="420" y="218" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="E_ClassifyVipToGateway" bpmnElement="Flow_ClassifyVipToGateway">
        <di:waypoint x="520" y="218" />
        <di:waypoint x="585" y="218" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="E_HighTouch" bpmnElement="Flow_HighTouch">
        <di:waypoint x="610" y="193" />
        <di:waypoint x="610" y="120" />
        <di:waypoint x="700" y="120" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="E_EscalateToEnd" bpmnElement="Flow_EscalateToEnd">
        <di:waypoint x="800" y="120" />
        <di:waypoint x="864" y="120" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="E_Default" bpmnElement="Flow_Default">
        <di:waypoint x="610" y="243" />
        <di:waypoint x="610" y="338" />
        <di:waypoint x="700" y="338" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="E_TicketToEnd" bpmnElement="Flow_TicketToEnd">
        <di:waypoint x="800" y="338" />
        <di:waypoint x="864" y="338" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
