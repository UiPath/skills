<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="UiPath (https://bpmn.uipath.com)" exporterVersion="1.0">

  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:migrationVersion version="11.5" />
      <uipath:variables version="v1">
        <!-- Entry-point inputs (scoped to Start_Manual) -->
        <uipath:inputOutput id="Var_Subject"      name="subject"      type="string"  direction="input"  elementId="Start_Manual" />
        <uipath:inputOutput id="Var_SenderDomain" name="senderDomain" type="string"  direction="input"  elementId="Start_Manual" />
        <!-- Working variables -->
        <uipath:inputOutput id="Var_Urgent"       name="urgent"       type="boolean" />
        <uipath:inputOutput id="Var_Vip"          name="vip"          type="boolean" />
        <!-- Outputs -->
        <uipath:inputOutput id="Var_TicketId"     name="ticketId"     type="string"  direction="output" />
        <uipath:inputOutput id="Var_EscalationId" name="escalationId" type="string"  direction="output" />
      </uipath:variables>
    </bpmn:extensionElements>

    <!-- START: manual trigger -->
    <bpmn:startEvent id="Start_Manual" name="Customer Request Received">
      <bpmn:extensionElements>
        <uipath:entryPointId value="Entry_ManualStart" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_Start_ClassifyUrgency</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- TASK 1: classifyUrgency -->
    <bpmn:scriptTask id="Task_ClassifyUrgency" name="classifyUrgency" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"subject":"=vars.Var_Subject"}]]></uipath:input>
          <uipath:output name="urgent" type="boolean" var="Var_Urgent" source="=result.response" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_ClassifyUrgency</bpmn:incoming>
      <bpmn:outgoing>Flow_ClassifyUrgency_ClassifyVip</bpmn:outgoing>
      <bpmn:script><![CDATA[
var keywords = ["urgent", "critical", "asap", "emergency"];
var isUrgent = false;
for (var i = 0; i < keywords.length; i++) {
  if (subject && subject.toLowerCase().indexOf(keywords[i]) >= 0) {
    isUrgent = true;
    break;
  }
}
return { response: isUrgent };
]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- TASK 2: classifyVip -->
    <bpmn:scriptTask id="Task_ClassifyVip" name="classifyVip" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"senderDomain":"=vars.Var_SenderDomain"}]]></uipath:input>
          <uipath:output name="vip" type="boolean" var="Var_Vip" source="=result.response" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ClassifyUrgency_ClassifyVip</bpmn:incoming>
      <bpmn:outgoing>Flow_ClassifyVip_Route</bpmn:outgoing>
      <bpmn:script><![CDATA[
var vipDomains = ["platinum.example.com", "enterprise.example.com", "premier.example.com"];
var isVip = false;
for (var i = 0; i < vipDomains.length; i++) {
  if (senderDomain && senderDomain.toLowerCase() === vipDomains[i]) {
    isVip = true;
    break;
  }
}
return { response: isVip };
]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- GATEWAY: routeEscalation -->
    <bpmn:exclusiveGateway id="Gw_RouteEscalation" name="routeEscalation" default="Flow_Default_CreateTicket">
      <bpmn:incoming>Flow_ClassifyVip_Route</bpmn:incoming>
      <bpmn:outgoing>Flow_HighTouch_Escalate</bpmn:outgoing>
      <bpmn:outgoing>Flow_Default_CreateTicket</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- TASK 3: Escalate to specialist (user task - high-touch path) -->
    <bpmn:userTask id="Task_EscalateToSpecialist" name="Escalate to specialist">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Actions.HITL" version="v1" />
          <uipath:context>
            <uipath:input name="appId" value="" />
            <uipath:input name="appVersion" value="" />
            <uipath:input name="actions" value="[]" />
            <uipath:input name="key" value="escalate-specialist" />
            <uipath:input name="taskTitle" value="Escalate to specialist" />
          </uipath:context>
          <uipath:input name="HitlTaskArguments" type="json" target="bodyField"><![CDATA[{"subject":"=vars.Var_Subject","senderDomain":"=vars.Var_SenderDomain"}]]></uipath:input>
          <uipath:output name="Process response" type="Actions.HITL" var="Var_EscalationId" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_HighTouch_Escalate</bpmn:incoming>
      <bpmn:outgoing>Flow_Escalate_End</bpmn:outgoing>
    </bpmn:userTask>

    <!-- TASK 4: createTicket (script task - default path) -->
    <bpmn:scriptTask id="Task_CreateTicket" name="createTicket" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"subject":"=vars.Var_Subject","senderDomain":"=vars.Var_SenderDomain"}]]></uipath:input>
          <uipath:output name="ticketId" type="string" var="Var_TicketId" source="=result.response" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Default_CreateTicket</bpmn:incoming>
      <bpmn:outgoing>Flow_Ticket_End</bpmn:outgoing>
      <bpmn:script><![CDATA[
var ts = new Date().getTime();
var domainSlug = (senderDomain || "unknown").replace(/\./g, "-");
var subjectSlug = (subject || "request").substring(0, 20).replace(/\s+/g, "-").toLowerCase();
return { response: "TKT-" + domainSlug + "-" + subjectSlug + "-" + ts };
]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- END events -->
    <bpmn:endEvent id="End_Escalated" name="Escalation Completed">
      <bpmn:incoming>Flow_Escalate_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_Ticketed" name="Ticket Created">
      <bpmn:incoming>Flow_Ticket_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- SEQUENCE FLOWS -->
    <bpmn:sequenceFlow id="Flow_Start_ClassifyUrgency"      sourceRef="Start_Manual"          targetRef="Task_ClassifyUrgency" />
    <bpmn:sequenceFlow id="Flow_ClassifyUrgency_ClassifyVip" sourceRef="Task_ClassifyUrgency"  targetRef="Task_ClassifyVip" />
    <bpmn:sequenceFlow id="Flow_ClassifyVip_Route"          sourceRef="Task_ClassifyVip"       targetRef="Gw_RouteEscalation" />
    <bpmn:sequenceFlow id="Flow_HighTouch_Escalate"         sourceRef="Gw_RouteEscalation"    targetRef="Task_EscalateToSpecialist">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=vars.Var_Urgent == true &amp;&amp; vars.Var_Vip == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Default_CreateTicket"       sourceRef="Gw_RouteEscalation"    targetRef="Task_CreateTicket" />
    <bpmn:sequenceFlow id="Flow_Escalate_End"               sourceRef="Task_EscalateToSpecialist" targetRef="End_Escalated" />
    <bpmn:sequenceFlow id="Flow_Ticket_End"                 sourceRef="Task_CreateTicket"      targetRef="End_Ticketed" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="S_End_Escalated" bpmnElement="End_Escalated"><dc:Bounds x="846" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End_Ticketed" bpmnElement="End_Ticketed"><dc:Bounds x="846" y="166" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Gw_RouteEscalation" bpmnElement="Gw_RouteEscalation"><dc:Bounds x="576" y="100" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Start_Manual" bpmnElement="Start_Manual"><dc:Bounds x="160" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_ClassifyUrgency" bpmnElement="Task_ClassifyUrgency"><dc:Bounds x="256" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_ClassifyVip" bpmnElement="Task_ClassifyVip"><dc:Bounds x="416" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_CreateTicket" bpmnElement="Task_CreateTicket"><dc:Bounds x="686" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_EscalateToSpecialist" bpmnElement="Task_EscalateToSpecialist"><dc:Bounds x="686" y="210" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="E_Flow_ClassifyUrgency_ClassifyVip" bpmnElement="Flow_ClassifyUrgency_ClassifyVip"><di:waypoint x="306" y="140" /><di:waypoint x="466" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_ClassifyVip_Route" bpmnElement="Flow_ClassifyVip_Route"><di:waypoint x="466" y="140" /><di:waypoint x="601" y="125" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_Default_CreateTicket" bpmnElement="Flow_Default_CreateTicket"><di:waypoint x="601" y="125" /><di:waypoint x="736" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_Escalate_End" bpmnElement="Flow_Escalate_End"><di:waypoint x="736" y="250" /><di:waypoint x="864" y="118" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_HighTouch_Escalate" bpmnElement="Flow_HighTouch_Escalate"><di:waypoint x="601" y="125" /><di:waypoint x="736" y="250" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_Start_ClassifyUrgency" bpmnElement="Flow_Start_ClassifyUrgency"><di:waypoint x="178" y="118" /><di:waypoint x="306" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_Ticket_End" bpmnElement="Flow_Ticket_End"><di:waypoint x="736" y="140" /><di:waypoint x="864" y="184" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
