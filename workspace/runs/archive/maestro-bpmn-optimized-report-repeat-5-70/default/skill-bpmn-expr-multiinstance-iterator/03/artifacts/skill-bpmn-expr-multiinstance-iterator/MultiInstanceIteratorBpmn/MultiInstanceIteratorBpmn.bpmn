<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="UiPath (https://bpmn.uipath.com)" exporterVersion="1.0">

  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:migrationVersion version="11.5" />
      <uipath:variables version="v1">
        <!-- Items: entry-point input collection, scoped to start event -->
        <uipath:inputOutput id="Var_Items" name="Items" type="object" elementId="Start_1" />
        <!-- CurrentLine: root-scoped output (readable at runtime) -->
        <uipath:inputOutput id="Var_CurrentLine" name="CurrentLine" type="object" />
        <!-- CurrentIndex: root-scoped output (readable at runtime) -->
        <uipath:inputOutput id="Var_CurrentIndex" name="CurrentIndex" type="number" />
      </uipath:variables>
    </bpmn:extensionElements>

    <!-- Manual start event -->
    <bpmn:startEvent id="Start_1" name="Start">
      <bpmn:extensionElements>
        <uipath:entryPointId value="EntryPoint_1" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Multi-instance subprocess: iterates Var_Items collection -->
    <bpmn:subProcess id="Sub_MI" name="Iterate Items">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>

      <!-- Multi-instance marker: sequential, collection bound via uipath extension -->
      <bpmn:multiInstanceLoopCharacteristics isSequential="true">
        <bpmn:extensionElements>
          <uipath:loopCharacteristics
              inputCollection="=vars.Var_Items"
              inputElement="iterator[0]" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>

      <!-- Subprocess body -->
      <bpmn:startEvent id="Start_Sub" name="Start">
        <bpmn:outgoing>Flow_Sub1</bpmn:outgoing>
      </bpmn:startEvent>

      <!--
        Script task: maps iterator[0].item to Var_CurrentLine
        and iterator[0].loopCounter to Var_CurrentIndex.
        At subprocess depth the iterator alias is iterator[0],
        NOT the task-level iterator.item / iterator.loopCounter forms.
      -->
      <bpmn:scriptTask id="Task_MapVars" name="Map Line and Index" scriptFormat="JavaScript">
        <bpmn:extensionElements>
          <uipath:scriptVersion value="v3" />
          <uipath:mapping version="v1">
            <uipath:type value="BPMN.ScriptTask" version="v1" />
            <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"currentLine":"=iterator[0].item","currentIndex":"=iterator[0].loopCounter"}]]></uipath:input>
            <uipath:output name="currentLine" type="object" var="Var_CurrentLine" source="=result.response.currentLine" />
            <uipath:output name="currentIndex" type="number" var="Var_CurrentIndex" source="=result.response.currentIndex" />
          </uipath:mapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_Sub1</bpmn:incoming>
        <bpmn:outgoing>Flow_Sub2</bpmn:outgoing>
        <bpmn:script><![CDATA[return { response: { currentLine: currentLine, currentIndex: currentIndex } };]]></bpmn:script>
      </bpmn:scriptTask>

      <bpmn:endEvent id="End_Sub" name="End">
        <bpmn:incoming>Flow_Sub2</bpmn:incoming>
      </bpmn:endEvent>

      <bpmn:sequenceFlow id="Flow_Sub1" sourceRef="Start_Sub" targetRef="Task_MapVars" />
      <bpmn:sequenceFlow id="Flow_Sub2" sourceRef="Task_MapVars" targetRef="End_Sub" />
    </bpmn:subProcess>

    <!-- Single root end event -->
    <bpmn:endEvent id="End_1" name="End">
      <bpmn:incoming>Flow_2</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Sub_MI" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Sub_MI" targetRef="End_1" />
  </bpmn:process>

  <!--
    BPMNDiagram: one shape per node (root + subprocess interior),
    one edge per sequence flow (root + subprocess interior).
    Subprocess shape carries isExpanded="true".
    Interior shapes are positioned within the subprocess bounds.
  -->
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_1">

      <!-- Root-level shapes -->
      <bpmndi:BPMNShape id="S_Start_1" bpmnElement="Start_1">
        <dc:Bounds x="160" y="212" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_Sub_MI" bpmnElement="Sub_MI" isExpanded="true">
        <dc:Bounds x="258" y="100" width="520" height="260" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_End_1" bpmnElement="End_1">
        <dc:Bounds x="840" y="212" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Root-level edges -->
      <bpmndi:BPMNEdge id="E_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="196" y="230" />
        <di:waypoint x="258" y="230" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="E_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="778" y="230" />
        <di:waypoint x="840" y="230" />
      </bpmndi:BPMNEdge>

      <!-- Subprocess interior shapes (absolute coords, within Sub_MI bounds 258-778, 100-360) -->
      <bpmndi:BPMNShape id="S_Start_Sub" bpmnElement="Start_Sub">
        <dc:Bounds x="310" y="212" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_Task_MapVars" bpmnElement="Task_MapVars">
        <dc:Bounds x="410" y="190" width="160" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_End_Sub" bpmnElement="End_Sub">
        <dc:Bounds x="640" y="212" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Subprocess interior edges -->
      <bpmndi:BPMNEdge id="E_Flow_Sub1" bpmnElement="Flow_Sub1">
        <di:waypoint x="346" y="230" />
        <di:waypoint x="410" y="230" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="E_Flow_Sub2" bpmnElement="Flow_Sub2">
        <di:waypoint x="570" y="230" />
        <di:waypoint x="640" y="230" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
