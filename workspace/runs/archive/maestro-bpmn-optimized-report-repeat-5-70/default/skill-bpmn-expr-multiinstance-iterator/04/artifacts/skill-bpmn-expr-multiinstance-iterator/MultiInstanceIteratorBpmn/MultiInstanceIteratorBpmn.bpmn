<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="UiPath (https://bpmn.uipath.com)" exporterVersion="1.0">

  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:migrationVersion version="11.5" />
      <uipath:variables version="v1">
        <!-- Root input: the collection to iterate -->
        <uipath:input id="Var_Items" name="Items" type="object" elementId="Start_1" />
        <!-- Root outputs: written by the subprocess body on each iteration -->
        <uipath:inputOutput id="Var_CurrentLine" name="CurrentLine" type="object" />
        <uipath:inputOutput id="Var_CurrentIndex" name="CurrentIndex" type="number" />
      </uipath:variables>
    </bpmn:extensionElements>

    <!-- Manual (blank) start event carrying the Items input -->
    <bpmn:startEvent id="Start_1" name="Start">
      <bpmn:extensionElements>
        <uipath:entryPointId>EntryPoint_1</uipath:entryPointId>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_StartToSubProc</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Multi-instance subprocess: iterates over Var_Items -->
    <bpmn:subProcess id="SubProc_Iterate" name="Iterate Items" isExpanded="true">
      <bpmn:extensionElements>
        <uipath:variables version="v1">
          <!-- Subprocess-scoped scratch variables (not required to be root-scoped) -->
          <uipath:inputOutput id="SubVar_CurrentLine" name="SubVar_CurrentLine" type="object" />
          <uipath:inputOutput id="SubVar_CurrentIndex" name="SubVar_CurrentIndex" type="number" />
        </uipath:variables>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_StartToSubProc</bpmn:incoming>
      <bpmn:outgoing>Flow_SubProcToEnd</bpmn:outgoing>

      <!-- Multi-instance loop: sequential, bound to Var_Items via uipath:loopCharacteristics -->
      <bpmn:multiInstanceLoopCharacteristics isSequential="true">
        <bpmn:extensionElements>
          <uipath:loopCharacteristics
              inputCollection="=vars.Var_Items"
              inputElement="iterator[0]" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>

      <!-- Inner flow: sub-start -> MapItem script -> sub-end -->
      <bpmn:startEvent id="SubStart_1" name="Sub Start">
        <bpmn:outgoing>Flow_SubStartToMap</bpmn:outgoing>
      </bpmn:startEvent>

      <!--
        Script task: reads current item and loop counter from iterator[0],
        writes them into the root-scoped output variables.
        iterator[0].item  = current collection element (subprocess depth)
        iterator[0].loopCounter = 0-based index         (subprocess depth)
      -->
      <bpmn:scriptTask id="Task_MapItem" name="Map Current Item" scriptFormat="JavaScript">
        <bpmn:extensionElements>
          <uipath:scriptVersion value="v3" />
          <uipath:mapping version="v1">
            <uipath:type value="BPMN.ScriptTask" version="v1" />
            <uipath:input name="args" type="json" target="bodyField"><![CDATA[{
  "currentItem": "=iterator[0].item",
  "currentIndex": "=iterator[0].loopCounter"
}]]></uipath:input>
            <uipath:output name="mappedLine" type="object" var="Var_CurrentLine" source="=result.response.mappedLine" />
            <uipath:output name="mappedIndex" type="number" var="Var_CurrentIndex" source="=result.response.mappedIndex" />
          </uipath:mapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_SubStartToMap</bpmn:incoming>
        <bpmn:outgoing>Flow_MapToSubEnd</bpmn:outgoing>
        <bpmn:script><![CDATA[return { response: { mappedLine: currentItem, mappedIndex: currentIndex } };]]></bpmn:script>
      </bpmn:scriptTask>

      <bpmn:endEvent id="SubEnd_1" name="Sub End">
        <bpmn:incoming>Flow_MapToSubEnd</bpmn:incoming>
      </bpmn:endEvent>

      <bpmn:sequenceFlow id="Flow_SubStartToMap" sourceRef="SubStart_1" targetRef="Task_MapItem" />
      <bpmn:sequenceFlow id="Flow_MapToSubEnd"   sourceRef="Task_MapItem" targetRef="SubEnd_1" />
    </bpmn:subProcess>

    <!-- Root end event -->
    <bpmn:endEvent id="End_1" name="End">
      <bpmn:incoming>Flow_SubProcToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_StartToSubProc" sourceRef="Start_1"     targetRef="SubProc_Iterate" />
    <bpmn:sequenceFlow id="Flow_SubProcToEnd"   sourceRef="SubProc_Iterate" targetRef="End_1" />
  </bpmn:process>

  <!-- Diagram placeholder: regenerated by generate_diagram.py below -->

  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="S_End_1" bpmnElement="End_1"><dc:Bounds x="816" y="122" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Start_1" bpmnElement="Start_1"><dc:Bounds x="160" y="122" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_SubProc_Iterate" bpmnElement="SubProc_Iterate" isExpanded="true"><dc:Bounds x="256" y="56" width="500" height="168" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="E_Flow_StartToSubProc" bpmnElement="Flow_StartToSubProc"><di:waypoint x="196" y="140" /><di:waypoint x="256" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_SubProcToEnd" bpmnElement="Flow_SubProcToEnd"><di:waypoint x="756" y="140" /><di:waypoint x="816" y="140" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
    <!-- Second plane for the expanded subprocess interior -->
    <bpmndi:BPMNPlane id="Plane_SubProc_Iterate" bpmnElement="SubProc_Iterate">
      <bpmndi:BPMNShape id="S_SubStart_1" bpmnElement="SubStart_1"><dc:Bounds x="160" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_MapItem" bpmnElement="Task_MapItem"><dc:Bounds x="250" y="78" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_SubEnd_1" bpmnElement="SubEnd_1"><dc:Bounds x="410" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="E_Flow_SubStartToMap" bpmnElement="Flow_SubStartToMap"><di:waypoint x="196" y="118" /><di:waypoint x="250" y="118" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_MapToSubEnd" bpmnElement="Flow_MapToSubEnd"><di:waypoint x="350" y="118" /><di:waypoint x="410" y="118" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
