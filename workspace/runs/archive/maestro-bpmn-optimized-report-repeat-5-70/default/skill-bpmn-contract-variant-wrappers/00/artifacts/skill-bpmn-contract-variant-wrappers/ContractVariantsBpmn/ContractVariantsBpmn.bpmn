<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_ContractVariants"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="UiPath (https://bpmn.uipath.com)" exporterVersion="1.0">

  <!-- Synthetic message reference for Maestro.SendMessageEvent -->
  <bpmn:message id="Message_SyntheticEvent" name="SyntheticContractEvent" />

  <bpmn:process id="Process_ContractVariants" isExecutable="true">
    <bpmn:extensionElements>
      <!-- Three migrationVersion values preserved as required -->
      <uipath:migrationVersion version="5" />
      <uipath:migrationVersion version="11" />
      <uipath:migrationVersion version="11.5" />
      <uipath:variables version="v1">
        <uipath:inputOutput id="Var_AgentJobResult"      name="AgentJobResult"      type="object" />
        <uipath:inputOutput id="Var_A2AResult"           name="A2AResult"           type="object" />
        <uipath:inputOutput id="Var_ApiWorkflowResult"   name="ApiWorkflowResult"   type="object" />
        <uipath:inputOutput id="Var_BizRuleResult"       name="BizRuleResult"       type="object" />
        <uipath:inputOutput id="Var_QueueItemResult"     name="QueueItemResult"     type="object" />
        <uipath:inputOutput id="Var_QueueWaitResult"     name="QueueWaitResult"     type="object" />
        <uipath:inputOutput id="Var_AgenticResult"       name="AgenticResult"       type="object" />
        <uipath:inputOutput id="Var_AgenticAsyncResult"  name="AgenticAsyncResult"  type="object" />
        <uipath:inputOutput id="Var_CaseMgmtResult"      name="CaseMgmtResult"      type="object" />
        <uipath:inputOutput id="Var_CaseMgmtAsyncResult" name="CaseMgmtAsyncResult" type="object" />
        <uipath:inputOutput id="Var_WaitEventResult"     name="WaitEventResult"     type="object" />
        <uipath:inputOutput id="Var_SendMsgResult"       name="SendMsgResult"       type="object" />
        <uipath:inputOutput id="Var_SchedulerResult"     name="SchedulerResult"     type="object" />
        <uipath:inputOutput id="Var_GuardrailsResult"    name="GuardrailsResult"    type="object" />
        <uipath:inputOutput id="Var_RulesEvalResult"     name="RulesEvalResult"     type="object" />
        <uipath:inputOutput id="Var_ScriptResult"        name="ScriptResult"        type="string" />
        <uipath:inputOutput id="Var_ContractRef"         name="ContractRef"         type="string" />
      </uipath:variables>
    </bpmn:extensionElements>

    <!-- START -->
    <bpmn:startEvent id="Start_Manual" name="Manual Start">
      <bpmn:extensionElements>
        <uipath:entryPointId>ep-contract-variants-main</uipath:entryPointId>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- NODE 01: Orchestrator.StartAgentJob (bpmn:serviceTask) -->
    <bpmn:serviceTask id="Task_StartAgentJob" name="Start Agent Job">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.StartAgentJob" version="v1" />
          <uipath:context>
            <uipath:input name="name"           value="placeholder-agent-process-name" />
            <uipath:input name="folderPath"     value="placeholder-folder-path" />
          </uipath:context>
          <uipath:input name="JobArguments" type="json" target="bodyField"><![CDATA[{"contractRef":"=vars.Var_ContractRef"}]]></uipath:input>
          <uipath:output name="Process response" type="Orchestrator.RunJob" var="Var_AgentJobResult" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- NODE 02: A2A.AgentExecution (bpmn:serviceTask) -->
    <bpmn:serviceTask id="Task_A2AExecution" name="A2A Agent Execution">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="A2A.AgentExecution" version="v1" />
          <uipath:input name="agentUrl"   value="https://placeholder-a2a-agent.example" />
          <uipath:input name="skillId"    value="placeholder-skill-id" />
          <uipath:input name="input"      value="=vars.Var_ContractRef" />
          <uipath:input name="authToken"  value="placeholder-auth-token" />
          <uipath:input name="agentName"  value="placeholder-agent-name" />
          <uipath:input name="body" type="json" target="body"><![CDATA[{"message":"=vars.Var_ContractRef","sessionId":""}]]></uipath:input>
          <uipath:output name="a2aResponse" type="A2A.AgentExecution" var="Var_A2AResult" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- NODE 03: Orchestrator.ExecuteApiWorkflowAsync (bpmn:serviceTask) -->
    <bpmn:serviceTask id="Task_ApiWorkflowAsync" name="Execute API Workflow Async">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.ExecuteApiWorkflowAsync" version="v1" />
          <uipath:context>
            <uipath:input name="releaseKey"  value="placeholder-release-key" />
            <uipath:input name="folderId"    value="placeholder-folder-id" />
            <uipath:input name="folderPath"  value="placeholder-folder-path" />
            <uipath:input name="name"        value="placeholder-workflow-name" />
          </uipath:context>
          <uipath:input name="JobArguments" type="json" target="bodyField"><![CDATA[{"contractRef":"=vars.Var_ContractRef"}]]></uipath:input>
          <uipath:output name="Process response" type="Orchestrator.RunJob" var="Var_ApiWorkflowResult" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- NODE 04: Orchestrator.BusinessRules (bpmn:businessRuleTask) -->
    <bpmn:businessRuleTask id="Task_BusinessRules" name="Evaluate Business Rules">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.BusinessRules" version="v1" />
          <uipath:context>
            <uipath:input name="releaseKey"  value="placeholder-biz-rule-key" />
            <uipath:input name="folderId"    value="placeholder-folder-id" />
            <uipath:input name="folderPath"  value="placeholder-folder-path" />
            <uipath:input name="name"        value="placeholder-rule-set-name" />
          </uipath:context>
          <uipath:input name="JobArguments" type="json" target="bodyField"><![CDATA[{"contractRef":"=vars.Var_ContractRef"}]]></uipath:input>
          <uipath:output name="Execute business rule [Preview]" type="Orchestrator.BusinessRules" var="Var_BizRuleResult" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <!-- NODE 05: Orchestrator.CreateQueueItem (bpmn:sendTask) -->
    <bpmn:sendTask id="Task_CreateQueueItem" name="Create Queue Item">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.CreateQueueItem" version="v1" />
          <uipath:context>
            <uipath:input name="queueName"   value="placeholder-queue-name" />
            <uipath:input name="folderId"    value="placeholder-folder-id" />
            <uipath:input name="folderPath"  value="placeholder-folder-path" />
          </uipath:context>
          <uipath:input name="ItemData" type="json" target="body"><![CDATA[{"Reference":"=vars.Var_ContractRef","SpecificContent":{"contractRef":"=vars.Var_ContractRef"},"Priority":"Normal"}]]></uipath:input>
          <uipath:output name="response" type="Orchestrator.CreateQueueItem" var="Var_QueueItemResult" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:sendTask>

    <!-- NODE 06: Orchestrator.CreateAndWaitForQueueItem (bpmn:serviceTask) -->
    <bpmn:serviceTask id="Task_CreateAndWait" name="Create and Wait Queue Item">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.CreateAndWaitForQueueItem" version="v1" />
          <uipath:context>
            <uipath:input name="queueName"   value="placeholder-queue-name" />
            <uipath:input name="folderId"    value="placeholder-folder-id" />
            <uipath:input name="folderPath"  value="placeholder-folder-path" />
          </uipath:context>
          <uipath:input name="ItemData" type="json" target="body"><![CDATA[{"Reference":"=vars.Var_ContractRef","SpecificContent":{"contractRef":"=vars.Var_ContractRef"},"Priority":"Normal"}]]></uipath:input>
          <uipath:output name="response" type="Orchestrator.CreateQueueItem" var="Var_QueueWaitResult" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- NODE 07: Orchestrator.StartAgenticProcess (bpmn:callActivity) -->
    <bpmn:callActivity id="Task_AgenticProcess" name="Start Agentic Process">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.StartAgenticProcess" version="v1" />
          <uipath:context>
            <uipath:input name="releaseKey"  value="placeholder-agentic-release-key" />
            <uipath:input name="folderId"    value="placeholder-folder-id" />
            <uipath:input name="folderPath"  value="placeholder-folder-path" />
            <uipath:input name="name"        value="placeholder-agentic-process-name" />
          </uipath:context>
          <uipath:input name="JobArguments" type="json" target="bodyField"><![CDATA[{"contractRef":"=vars.Var_ContractRef"}]]></uipath:input>
          <uipath:output name="Process response" type="Orchestrator.RunJob" var="Var_AgenticResult" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:callActivity>

    <!-- NODE 08: Orchestrator.StartAgenticProcessAsync (bpmn:callActivity) -->
    <bpmn:callActivity id="Task_AgenticProcessAsync" name="Start Agentic Process Async">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.StartAgenticProcessAsync" version="v1" />
          <uipath:context>
            <uipath:input name="releaseKey"  value="placeholder-agentic-async-release-key" />
            <uipath:input name="folderId"    value="placeholder-folder-id" />
            <uipath:input name="folderPath"  value="placeholder-folder-path" />
            <uipath:input name="name"        value="placeholder-agentic-async-process-name" />
          </uipath:context>
          <uipath:input name="JobArguments" type="json" target="bodyField"><![CDATA[{"contractRef":"=vars.Var_ContractRef"}]]></uipath:input>
          <uipath:output name="Process response" type="Orchestrator.RunJob" var="Var_AgenticAsyncResult" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:callActivity>

    <!-- NODE 09: Orchestrator.StartCaseMgmtProcess (bpmn:callActivity)
         Preserve-only case-management payload; all values synthetic. -->
    <bpmn:callActivity id="Task_CaseMgmtProcess" name="Start Case Management Process">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.StartCaseMgmtProcess" version="v1" />
          <uipath:context>
            <uipath:input name="releaseKey"  value="placeholder-case-mgmt-release-key" />
            <uipath:input name="folderId"    value="placeholder-folder-id" />
            <uipath:input name="folderPath"  value="placeholder-folder-path" />
            <uipath:input name="name"        value="placeholder-case-mgmt-process-name" />
          </uipath:context>
          <uipath:input name="JobArguments" type="json" target="bodyField"><![CDATA[{"contractRef":"=vars.Var_ContractRef","caseType":"SyntheticContractCase"}]]></uipath:input>
          <uipath:output name="Process response" type="Orchestrator.RunJob" var="Var_CaseMgmtResult" />
        </uipath:activity>
        <!-- preserve-only: synthetic case-management payload body -->
        <uipath:caseManagement version="v1">{"caseType":"SyntheticContractCase","syntheticField":"placeholder-value"}</uipath:caseManagement>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:callActivity>

    <!-- NODE 10: Orchestrator.StartCaseMgmtProcessAsync (bpmn:callActivity)
         Synthetic only; no deployment identifiers invented. -->
    <bpmn:callActivity id="Task_CaseMgmtProcessAsync" name="Start Case Management Process Async">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.StartCaseMgmtProcessAsync" version="v1" />
          <uipath:context>
            <uipath:input name="releaseKey"  value="placeholder-case-mgmt-async-release-key" />
            <uipath:input name="folderId"    value="placeholder-folder-id" />
            <uipath:input name="folderPath"  value="placeholder-folder-path" />
            <uipath:input name="name"        value="placeholder-case-mgmt-async-process-name" />
          </uipath:context>
          <uipath:input name="JobArguments" type="json" target="bodyField"><![CDATA[{"contractRef":"=vars.Var_ContractRef","caseType":"SyntheticContractCase"}]]></uipath:input>
          <uipath:output name="Process response" type="Orchestrator.RunJob" var="Var_CaseMgmtAsyncResult" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:callActivity>

    <!-- NODE 11: Intsvc.WaitForEvent (bpmn:receiveTask)
         Connector details placeholder-safe; not enriched with private connection metadata.
         This node is draft-until-enriched: connection binding must be supplied via CLI enrichment. -->
    <bpmn:receiveTask id="Task_WaitForEvent" name="Wait For Integration Event">
      <bpmn:extensionElements>
        <uipath:event version="v1">
          <uipath:type value="Intsvc.WaitForEvent" version="v1" />
          <uipath:input name="connectionId"  value="placeholder-connection-id" />
          <uipath:input name="connectorKey"  value="placeholder-connector-key" />
          <uipath:input name="folderId"      value="placeholder-folder-id" />
          <uipath:input name="folderPath"    value="placeholder-folder-path" />
          <uipath:input name="folderKey"     value="placeholder-folder-key" />
          <uipath:input name="operation"     value="placeholder-operation" />
          <uipath:input name="objectName"    value="placeholder-object-name" />
          <uipath:output name="result" type="custom" source="." var="Var_WaitEventResult" />
        </uipath:event>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:receiveTask>

    <!-- NODE 12: Maestro.SendMessageEvent (bpmn:intermediateThrowEvent)
         Message name and payload are synthetic. -->
    <bpmn:intermediateThrowEvent id="Event_SendMessage" name="Send Contract Message">
      <bpmn:extensionElements>
        <uipath:event version="v1">
          <uipath:type value="Maestro.SendMessageEvent" version="v1" />
          <uipath:context>
            <uipath:input name="name"        value="SyntheticContractEvent" />
            <uipath:input name="_label"      value="Send Contract Message" />
            <uipath:input name="inputSchema" value="{}" />
          </uipath:context>
          <uipath:input name="Reference"       value="SyntheticContractRef" />
          <uipath:input name="ItemData" type="json" target="body"><![CDATA[{"Reference":"SyntheticContractRef","SpecificContent":{"syntheticPayload":"placeholder"},"Error":"","TimeToLive":""}]]></uipath:input>
          <uipath:output name="response" type="Maestro.SendMessageEvent" var="Var_SendMsgResult" />
        </uipath:event>
      </bpmn:extensionElements>
      <bpmn:messageEventDefinition />
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- NODE 13: Maestro.CasePlanScheduler (bpmn:serviceTask)
         Not in live registry — preserve-only typed shell; marked draft-only.
         All payloads synthetic. -->
    <bpmn:serviceTask id="Task_CasePlanScheduler" name="Case Plan Scheduler">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Maestro.CasePlanScheduler" version="v1" />
          <uipath:context>
            <uipath:input name="schedulerConfig" value="placeholder-scheduler-config" />
            <uipath:input name="_label"          value="Case Plan Scheduler" />
          </uipath:context>
          <uipath:input name="body" type="json" target="body"><![CDATA[{"syntheticCaseRef":"=vars.Var_ContractRef","scheduleHint":"placeholder"}]]></uipath:input>
          <uipath:output name="schedulerOutput" type="Maestro.CasePlanScheduler" var="Var_SchedulerResult" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- NODE 14: Maestro.CaseManagerGuardrails (bpmn:serviceTask)
         Preserve-only; all payloads synthetic. -->
    <bpmn:serviceTask id="Task_CaseManagerGuardrails" name="Case Manager Guardrails">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Maestro.CaseManagerGuardrails" version="v1" />
          <uipath:context>
            <uipath:input name="decisions" value="placeholder-decisions-config" />
            <uipath:input name="_label"    value="Case Manager Guardrails" />
          </uipath:context>
          <uipath:input name="body" type="json" target="body"><![CDATA[{"syntheticCaseRef":"=vars.Var_ContractRef"}]]></uipath:input>
          <uipath:output name="guardrailsOutput" type="Maestro.CaseManagerGuardrails" var="Var_GuardrailsResult" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- NODE 15: Maestro.CaseRulesEvaluator (bpmn:serviceTask)
         Preserve-only; all payloads synthetic. -->
    <bpmn:serviceTask id="Task_CaseRulesEvaluator" name="Case Rules Evaluator">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Maestro.CaseRulesEvaluator" version="v1" />
          <uipath:context>
            <uipath:input name="caseDeterministicRules"    value="placeholder-rules-config" />
            <uipath:input name="caseCurrentExecutionState" value="placeholder-execution-state" />
            <uipath:input name="_label"                    value="Case Rules Evaluator" />
          </uipath:context>
          <uipath:input name="caseManagerInput" type="json" target="body"><![CDATA[{"syntheticCaseRef":"=vars.Var_ContractRef"}]]></uipath:input>
          <uipath:output name="schedulerOutput" type="Maestro.CaseRulesEvaluator" var="Var_RulesEvalResult" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- NODE 16: Legacy script task — scriptVersion v2 preserved per requirement.
         New scripts should use v3; this v2 is kept for legacy round-trip fidelity. -->
    <bpmn:scriptTask id="Task_LegacyScript" name="Legacy Script (v2)" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v2" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"contractRef":"=vars.Var_ContractRef"}]]></uipath:input>
          <uipath:output name="scriptResult" type="string" var="Var_ScriptResult" source="=result.response" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:script><![CDATA[return { response: contractRef + "-legacy-processed" };]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- NODE 17: Generic unsupported uipath:Activity preserve-only payload.
         Kept verbatim; not rewritten or deleted. -->
    <bpmn:serviceTask id="Task_UnsupportedActivity" name="Unsupported Activity (Preserved)">
      <bpmn:extensionElements>
        <uipath:Activity version="v1" type="Unsupported.GenericPreservedActivity">
          <uipath:context>
            <uipath:input name="syntheticParam" value="placeholder-param" />
          </uipath:context>
          <uipath:input name="body" type="json" target="body"><![CDATA[{"syntheticKey":"placeholder-value"}]]></uipath:input>
          <uipath:output name="result" type="any" var="Var_ScriptResult" />
        </uipath:Activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- END -->
    <bpmn:endEvent id="End_Complete" name="Complete">
      <bpmn:incoming>Flow_18</bpmn:incoming>
    </bpmn:endEvent>

    <!-- SEQUENCE FLOWS -->
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_Manual"              targetRef="Task_StartAgentJob" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_StartAgentJob"        targetRef="Task_A2AExecution" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_A2AExecution"         targetRef="Task_ApiWorkflowAsync" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_ApiWorkflowAsync"     targetRef="Task_BusinessRules" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_BusinessRules"        targetRef="Task_CreateQueueItem" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_CreateQueueItem"      targetRef="Task_CreateAndWait" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_CreateAndWait"        targetRef="Task_AgenticProcess" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_AgenticProcess"       targetRef="Task_AgenticProcessAsync" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_AgenticProcessAsync"  targetRef="Task_CaseMgmtProcess" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_CaseMgmtProcess"      targetRef="Task_CaseMgmtProcessAsync" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_CaseMgmtProcessAsync" targetRef="Task_WaitForEvent" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_WaitForEvent"         targetRef="Event_SendMessage" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Event_SendMessage"         targetRef="Task_CasePlanScheduler" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_CasePlanScheduler"    targetRef="Task_CaseManagerGuardrails" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_CaseManagerGuardrails" targetRef="Task_CaseRulesEvaluator" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_CaseRulesEvaluator"   targetRef="Task_LegacyScript" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_LegacyScript"         targetRef="Task_UnsupportedActivity" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_UnsupportedActivity"  targetRef="End_Complete" />

  </bpmn:process>

