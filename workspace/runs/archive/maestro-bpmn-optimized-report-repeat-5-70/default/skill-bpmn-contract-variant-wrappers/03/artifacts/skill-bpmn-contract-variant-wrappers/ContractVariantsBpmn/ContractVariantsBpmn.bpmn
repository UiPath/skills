<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="UiPath (https://bpmn.uipath.com)" exporterVersion="1.0">

  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:extensionElements>
      <!-- Three migration-version stamps preserved as-is -->
      <uipath:migrationVersion version="5" />
      <uipath:migrationVersion version="11" />
      <uipath:migrationVersion version="11.5" />
      <uipath:variables version="v1">
        <uipath:inputOutput id="Var_ScriptResult"       name="ScriptResult"       type="string" />
        <uipath:inputOutput id="Var_AgentJobResult"     name="AgentJobResult"     type="string" />
        <uipath:inputOutput id="Var_A2AResponse"        name="A2AResponse"        type="string" />
        <uipath:inputOutput id="Var_ApiJobResult"       name="ApiJobResult"       type="string" />
        <uipath:inputOutput id="Var_BizRulesResult"     name="BizRulesResult"     type="string" />
        <uipath:inputOutput id="Var_QueueItem"          name="QueueItem"          type="string" />
        <uipath:inputOutput id="Var_QueueItemWait"      name="QueueItemWait"      type="string" />
        <uipath:inputOutput id="Var_AgenticResult"      name="AgenticResult"      type="string" />
        <uipath:inputOutput id="Var_AgenticAsyncResult" name="AgenticAsyncResult" type="string" />
        <uipath:inputOutput id="Var_CaseResult"         name="CaseResult"         type="string" />
        <uipath:inputOutput id="Var_CaseAsyncResult"    name="CaseAsyncResult"    type="string" />
        <uipath:inputOutput id="Var_WaitEventResult"    name="WaitEventResult"    type="string" />
        <uipath:inputOutput id="Var_SendMsgResult"      name="SendMsgResult"      type="string" />
        <uipath:inputOutput id="Var_CaseSchedResult"    name="CaseSchedResult"    type="string" />
        <uipath:inputOutput id="Var_CaseGuardResult"    name="CaseGuardResult"    type="string" />
        <uipath:inputOutput id="Var_CaseRulesResult"    name="CaseRulesResult"    type="string" />
      </uipath:variables>
    </bpmn:extensionElements>

    <!-- 1. Manual start -->
    <bpmn:startEvent id="Start_1" name="Start">
      <bpmn:extensionElements>
        <uipath:entryPointId value="EP_Main" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- 2. Script task — legacy v2 scriptVersion preserved intentionally;
         new authoring would use v3 per skill guidance. -->
    <bpmn:scriptTask id="Task_Script" name="Classify Request" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v2" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:output name="scriptOut" type="string" var="Var_ScriptResult" source="=result.response" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
      <bpmn:script><![CDATA[return { response: "classified" };]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- 3. bpmn:serviceTask / Orchestrator.StartAgentJob
         Template uses attribute-style type; normalized here to child-element
         form per canvas serializer contract (Rule 6). Synthetic context values
         stand in for discovery-required binding IDs. -->
    <bpmn:serviceTask id="Task_AgentJob" name="Start Agent Job">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.StartAgentJob" version="v1" />
          <uipath:context>
            <uipath:input name="name"       value="SyntheticAgentProcess" />
            <uipath:input name="folderPath" value="SyntheticSharedFolder" />
          </uipath:context>
          <uipath:input name="JobArguments" type="json" target="bodyField"><![CDATA[{}]]></uipath:input>
          <uipath:output name="Process response" type="Orchestrator.RunJob" var="Var_AgentJobResult" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- 4. bpmn:serviceTask / A2A.AgentExecution -->
    <bpmn:serviceTask id="Task_A2A" name="Agent Execution">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="A2A.AgentExecution" version="v1" />
          <uipath:input name="body" type="json" target="body"><![CDATA[{}]]></uipath:input>
          <uipath:input name="agentUrl"   value="https://synthetic-agent.example/api" />
          <uipath:input name="skillId"    value="synthetic-skill-id" />
          <uipath:input name="input"      value="{}" />
          <uipath:input name="authToken"  value="synthetic-auth-token" />
          <uipath:input name="agentName"  value="SyntheticAgent" />
          <uipath:output name="a2aResponse" type="A2A.AgentExecution" var="Var_A2AResponse" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- 5. bpmn:serviceTask / Orchestrator.ExecuteApiWorkflowAsync -->
    <bpmn:serviceTask id="Task_ApiWorkflow" name="Execute API Workflow">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.ExecuteApiWorkflowAsync" version="v1" />
          <uipath:context>
            <uipath:input name="releaseKey" value="SYNTHETIC_RELEASE_KEY" />
            <uipath:input name="folderId"   value="SYNTHETIC_FOLDER_ID" />
            <uipath:input name="folderPath" value="SyntheticFolder" />
            <uipath:input name="name"       value="SyntheticApiWorkflow" />
          </uipath:context>
          <uipath:input name="JobArguments" type="json" target="bodyField"><![CDATA[{}]]></uipath:input>
          <uipath:output name="Process response" type="Orchestrator.RunJob" var="Var_ApiJobResult" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- 6. bpmn:businessRuleTask / Orchestrator.BusinessRules -->
    <bpmn:businessRuleTask id="Task_BizRules" name="Evaluate Business Rules">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.BusinessRules" version="v1" />
          <uipath:context>
            <uipath:input name="releaseKey" value="SYNTHETIC_RULE_KEY" />
            <uipath:input name="folderId"   value="SYNTHETIC_FOLDER_ID" />
            <uipath:input name="folderPath" value="SyntheticFolder" />
            <uipath:input name="name"       value="SyntheticBusinessRule" />
          </uipath:context>
          <uipath:input name="JobArguments" type="json" target="bodyField"><![CDATA[{}]]></uipath:input>
          <uipath:output name="Execute business rule [Preview]" type="Orchestrator.BusinessRules" var="Var_BizRulesResult" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <!-- 7. bpmn:sendTask / Orchestrator.CreateQueueItem -->
    <bpmn:sendTask id="Task_CreateQueue" name="Create Queue Item">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.CreateQueueItem" version="v1" />
          <uipath:context>
            <uipath:input name="queueName"  value="SyntheticQueue" />
            <uipath:input name="folderId"   value="SYNTHETIC_FOLDER_ID" />
            <uipath:input name="folderPath" value="SyntheticFolder" />
          </uipath:context>
          <uipath:input name="ItemData" type="json" target="body"><![CDATA[{}]]></uipath:input>
          <uipath:output name="response" type="Orchestrator.CreateQueueItem" var="Var_QueueItem" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:sendTask>

    <!-- 8. bpmn:serviceTask / Orchestrator.CreateAndWaitForQueueItem -->
    <bpmn:serviceTask id="Task_CreateWait" name="Create and Wait for Queue Item">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.CreateAndWaitForQueueItem" version="v1" />
          <uipath:context>
            <uipath:input name="queueName"  value="SyntheticQueue" />
            <uipath:input name="folderId"   value="SYNTHETIC_FOLDER_ID" />
            <uipath:input name="folderPath" value="SyntheticFolder" />
          </uipath:context>
          <uipath:input name="ItemData" type="json" target="body"><![CDATA[{}]]></uipath:input>
          <uipath:output name="response" type="Orchestrator.CreateQueueItem" var="Var_QueueItemWait" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- 9. bpmn:callActivity / Orchestrator.StartAgenticProcess -->
    <bpmn:callActivity id="CA_Agentic" name="Start Agentic Process">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.StartAgenticProcess" version="v1" />
          <uipath:context>
            <uipath:input name="releaseKey" value="SYNTHETIC_AGENTIC_KEY" />
            <uipath:input name="folderId"   value="SYNTHETIC_FOLDER_ID" />
            <uipath:input name="folderPath" value="SyntheticFolder" />
            <uipath:input name="name"       value="SyntheticAgenticProcess" />
          </uipath:context>
          <uipath:input name="JobArguments" type="json" target="bodyField"><![CDATA[{}]]></uipath:input>
          <uipath:output name="Process response" type="Orchestrator.RunJob" var="Var_AgenticResult" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:callActivity>

    <!-- 10. bpmn:callActivity / Orchestrator.StartAgenticProcessAsync -->
    <bpmn:callActivity id="CA_AgenticAsync" name="Start Agentic Process Async">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.StartAgenticProcessAsync" version="v1" />
          <uipath:context>
            <uipath:input name="releaseKey" value="SYNTHETIC_AGENTIC_ASYNC_KEY" />
            <uipath:input name="folderId"   value="SYNTHETIC_FOLDER_ID" />
            <uipath:input name="folderPath" value="SyntheticFolder" />
            <uipath:input name="name"       value="SyntheticAgenticProcessAsync" />
          </uipath:context>
          <uipath:input name="JobArguments" type="json" target="bodyField"><![CDATA[{}]]></uipath:input>
          <uipath:output name="Process response" type="Orchestrator.RunJob" var="Var_AgenticAsyncResult" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:callActivity>

    <!-- 11. bpmn:callActivity / Orchestrator.StartCaseMgmtProcess
         A synthetic uipath:caseManagement payload is included as a
         preserve-only body; no real deployment identifiers used. -->
    <bpmn:callActivity id="CA_Case" name="Start Case Management Process">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.StartCaseMgmtProcess" version="v1" />
          <uipath:context>
            <uipath:input name="releaseKey" value="SYNTHETIC_CASE_KEY" />
            <uipath:input name="folderId"   value="SYNTHETIC_FOLDER_ID" />
            <uipath:input name="folderPath" value="SyntheticFolder" />
            <uipath:input name="name"       value="SyntheticCaseProcess" />
          </uipath:context>
          <uipath:input name="JobArguments" type="json" target="bodyField"><![CDATA[{}]]></uipath:input>
          <uipath:output name="Process response" type="Orchestrator.RunJob" var="Var_CaseResult" />
        </uipath:activity>
        <uipath:caseManagement version="v1">{"caseType":"SyntheticCaseType","payload":"preserve-only"}</uipath:caseManagement>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:callActivity>

    <!-- 12. bpmn:callActivity / Orchestrator.StartCaseMgmtProcessAsync
         Kept fully synthetic; no deployment identifiers invented. -->
    <bpmn:callActivity id="CA_CaseAsync" name="Start Case Management Process Async">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.StartCaseMgmtProcessAsync" version="v1" />
          <uipath:context>
            <uipath:input name="releaseKey" value="SYNTHETIC_CASE_ASYNC_KEY" />
            <uipath:input name="folderId"   value="SYNTHETIC_FOLDER_ID" />
            <uipath:input name="folderPath" value="SyntheticFolder" />
            <uipath:input name="name"       value="SyntheticCaseProcessAsync" />
          </uipath:context>
          <uipath:input name="JobArguments" type="json" target="bodyField"><![CDATA[{}]]></uipath:input>
          <uipath:output name="Process response" type="Orchestrator.RunJob" var="Var_CaseAsyncResult" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:callActivity>

    <!-- 13. bpmn:receiveTask / Intsvc.WaitForEvent
         All connector fields are synthetic placeholders; no private connection
         metadata hand-authored. -->
    <bpmn:receiveTask id="Task_WaitEvent" name="Wait for Event">
      <bpmn:extensionElements>
        <uipath:event version="v1">
          <uipath:type value="Intsvc.WaitForEvent" version="v1" />
          <uipath:input name="connectionId"  value="SYNTHETIC_CONNECTION_ID" />
          <uipath:input name="connectorKey"  value="synthetic-connector-key" />
          <uipath:input name="folderId"      value="SYNTHETIC_FOLDER_ID" />
          <uipath:input name="folderPath"    value="SyntheticFolder" />
          <uipath:input name="folderKey"     value="synthetic-folder-key" />
          <uipath:input name="operation"     value="synthetic.event.trigger" />
          <uipath:input name="objectName"    value="SyntheticEventObject" />
          <uipath:output name="result" type="custom" source="." var="Var_WaitEventResult" />
        </uipath:event>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:receiveTask>

    <!-- 14. bpmn:intermediateThrowEvent / Maestro.SendMessageEvent
         Message name and payload are fully synthetic. -->
    <bpmn:intermediateThrowEvent id="Throw_SendMsg" name="Send Message Event">
      <bpmn:extensionElements>
        <uipath:event version="v1">
          <uipath:type value="Maestro.SendMessageEvent" version="v1" />
          <uipath:context>
            <uipath:input name="name"        value="SyntheticMessageChannel" />
            <uipath:input name="_label"      value="Synthetic Message" />
            <uipath:input name="inputSchema" value="{}" />
          </uipath:context>
          <uipath:input name="ItemData" type="json" target="body"><![CDATA[{"Reference":"synthetic-ref","SpecificContent":{},"Error":"","TimeToLive":""}]]></uipath:input>
          <uipath:input name="Reference" value="synthetic-ref" />
          <uipath:output name="response" type="Maestro.SendMessageEvent" var="Var_SendMsgResult" />
        </uipath:event>
      </bpmn:extensionElements>
      <bpmn:messageEventDefinition />
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- 15. bpmn:serviceTask / Maestro.CasePlanScheduler
         Preserve-only / draft-only type not served by the live registry.
         Shell authored from the typed-activity contract; payload is synthetic. -->
    <bpmn:serviceTask id="Task_CaseSched" name="Case Plan Scheduler">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Maestro.CasePlanScheduler" version="v1" />
          <uipath:context>
            <uipath:input name="scheduleConfig" value="{}" />
            <uipath:input name="_label"          value="SyntheticScheduler" />
          </uipath:context>
          <uipath:input name="body" type="json" target="body"><![CDATA[{}]]></uipath:input>
          <uipath:output name="schedulerResult" type="Maestro.CasePlanScheduler" var="Var_CaseSchedResult" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- 16. bpmn:serviceTask / Maestro.CaseManagerGuardrails
         Preserve-only; payload is synthetic. -->
    <bpmn:serviceTask id="Task_CaseGuard" name="Case Manager Guardrails">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Maestro.CaseManagerGuardrails" version="v1" />
          <uipath:context>
            <uipath:input name="decisions" value="{}" />
            <uipath:input name="_label"    value="SyntheticGuardrails" />
          </uipath:context>
          <uipath:input name="body" type="json" target="body"><![CDATA[{}]]></uipath:input>
          <uipath:output name="guardrailsOutput" type="Maestro.CaseManagerGuardrails" var="Var_CaseGuardResult" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- 17. bpmn:serviceTask / Maestro.CaseRulesEvaluator
         Preserve-only; payload is synthetic. -->
    <bpmn:serviceTask id="Task_CaseRules" name="Case Rules Evaluator">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Maestro.CaseRulesEvaluator" version="v1" />
          <uipath:context>
            <uipath:input name="caseDeterministicRules"    value="{}" />
            <uipath:input name="caseCurrentExecutionState" value="{}" />
            <uipath:input name="_label"                    value="SyntheticRulesEvaluator" />
          </uipath:context>
          <uipath:input name="caseManagerInput" type="json" target="body"><![CDATA[{}]]></uipath:input>
          <uipath:output name="schedulerOutput" type="Maestro.CaseRulesEvaluator" var="Var_CaseRulesResult" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- 18. bpmn:serviceTask — generic preserve-only uipath:Activity payload.
         This is the capital-A element (separate from typed lowercase shells);
         preserved as-is when encountered, never rewritten or deleted. -->
    <bpmn:serviceTask id="Task_GenActivity" name="Generic Activity">
      <bpmn:extensionElements>
        <uipath:Activity version="v1" activityType="SyntheticUnsupportedActivity">
          <uipath:property name="syntheticProp" value="placeholder" />
        </uipath:Activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- End event -->
    <bpmn:endEvent id="End_1" name="End">
      <bpmn:incoming>Flow_18</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence flows — linear path through all 18 nodes -->
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_1"         targetRef="Task_Script" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_Script"     targetRef="Task_AgentJob" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_AgentJob"   targetRef="Task_A2A" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_A2A"        targetRef="Task_ApiWorkflow" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_ApiWorkflow" targetRef="Task_BizRules" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_BizRules"   targetRef="Task_CreateQueue" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_CreateQueue" targetRef="Task_CreateWait" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_CreateWait" targetRef="CA_Agentic" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="CA_Agentic"      targetRef="CA_AgenticAsync" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="CA_AgenticAsync" targetRef="CA_Case" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="CA_Case"         targetRef="CA_CaseAsync" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="CA_CaseAsync"    targetRef="Task_WaitEvent" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_WaitEvent"  targetRef="Throw_SendMsg" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Throw_SendMsg"   targetRef="Task_CaseSched" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_CaseSched"  targetRef="Task_CaseGuard" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_CaseGuard"  targetRef="Task_CaseRules" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_CaseRules"  targetRef="Task_GenActivity" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_GenActivity" targetRef="End_1" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="S_CA_Agentic" bpmnElement="CA_Agentic"><dc:Bounds x="1376" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_CA_AgenticAsync" bpmnElement="CA_AgenticAsync"><dc:Bounds x="1536" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_CA_Case" bpmnElement="CA_Case"><dc:Bounds x="1696" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_CA_CaseAsync" bpmnElement="CA_CaseAsync"><dc:Bounds x="1856" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End_1" bpmnElement="End_1"><dc:Bounds x="2912" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Start_1" bpmnElement="Start_1"><dc:Bounds x="160" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_A2A" bpmnElement="Task_A2A"><dc:Bounds x="576" y="100" width="100" height="80" /></bpmndi:BPMNShape>
