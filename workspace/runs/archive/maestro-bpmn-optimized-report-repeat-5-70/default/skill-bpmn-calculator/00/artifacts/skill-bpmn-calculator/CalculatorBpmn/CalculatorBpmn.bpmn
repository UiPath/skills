<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="UiPath (https://bpmn.uipath.com)" exporterVersion="1.0">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:migrationVersion version="11.5" />
      <uipath:variables version="v1">
        <uipath:inputOutput id="Var_OperandA" name="operandA" type="number" elementId="Start_1" />
        <uipath:inputOutput id="Var_OperandB" name="operandB" type="number" elementId="Start_1" />
        <uipath:inputOutput id="Var_Operator" name="operator" type="string" elementId="Start_1" />
        <uipath:inputOutput id="Var_Result" name="result" type="number" />
      </uipath:variables>
    </bpmn:extensionElements>

    <bpmn:startEvent id="Start_1" name="Start">
      <bpmn:extensionElements>
        <uipath:entryPointId value="a1b2c3d4-e5f6-7890-abcd-ef1234567890" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_Start_Gw</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:exclusiveGateway id="Gw_Route" name="operator?" default="Flow_Gw_Divide">
      <bpmn:incoming>Flow_Start_Gw</bpmn:incoming>
      <bpmn:outgoing>Flow_Gw_Add</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gw_Subtract</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gw_Multiply</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gw_Divide</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:scriptTask id="Task_Add" name="Add" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"a":"=vars.Var_OperandA","b":"=vars.Var_OperandB"}]]></uipath:input>
          <uipath:output name="result" type="number" var="Var_Result" source="=result.response" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Gw_Add</bpmn:incoming>
      <bpmn:outgoing>Flow_Add_End</bpmn:outgoing>
      <bpmn:script><![CDATA[return { response: a + b };]]></bpmn:script>
    </bpmn:scriptTask>

    <bpmn:scriptTask id="Task_Subtract" name="Subtract" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"a":"=vars.Var_OperandA","b":"=vars.Var_OperandB"}]]></uipath:input>
          <uipath:output name="result" type="number" var="Var_Result" source="=result.response" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Gw_Subtract</bpmn:incoming>
      <bpmn:outgoing>Flow_Subtract_End</bpmn:outgoing>
      <bpmn:script><![CDATA[return { response: a - b };]]></bpmn:script>
    </bpmn:scriptTask>

    <bpmn:scriptTask id="Task_Multiply" name="Multiply" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"a":"=vars.Var_OperandA","b":"=vars.Var_OperandB"}]]></uipath:input>
          <uipath:output name="result" type="number" var="Var_Result" source="=result.response" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Gw_Multiply</bpmn:incoming>
      <bpmn:outgoing>Flow_Multiply_End</bpmn:outgoing>
      <bpmn:script><![CDATA[return { response: a * b };]]></bpmn:script>
    </bpmn:scriptTask>

    <bpmn:scriptTask id="Task_Divide" name="Divide" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"a":"=vars.Var_OperandA","b":"=vars.Var_OperandB"}]]></uipath:input>
          <uipath:output name="result" type="number" var="Var_Result" source="=result.response" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Gw_Divide</bpmn:incoming>
      <bpmn:outgoing>Flow_Divide_End</bpmn:outgoing>
      <bpmn:script><![CDATA[return { response: a / b };]]></bpmn:script>
    </bpmn:scriptTask>

    <bpmn:endEvent id="End_Add" name="End Add">
      <bpmn:incoming>Flow_Add_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_Subtract" name="End Subtract">
      <bpmn:incoming>Flow_Subtract_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_Multiply" name="End Multiply">
      <bpmn:incoming>Flow_Multiply_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_Divide" name="End Divide">
      <bpmn:incoming>Flow_Divide_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Start_Gw" sourceRef="Start_1" targetRef="Gw_Route" />

    <bpmn:sequenceFlow id="Flow_Gw_Add" sourceRef="Gw_Route" targetRef="Task_Add">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=vars.Var_Operator == "add"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_Gw_Subtract" sourceRef="Gw_Route" targetRef="Task_Subtract">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=vars.Var_Operator == "subtract"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_Gw_Multiply" sourceRef="Gw_Route" targetRef="Task_Multiply">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=vars.Var_Operator == "multiply"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_Gw_Divide" sourceRef="Gw_Route" targetRef="Task_Divide" />

    <bpmn:sequenceFlow id="Flow_Add_End" sourceRef="Task_Add" targetRef="End_Add" />
    <bpmn:sequenceFlow id="Flow_Subtract_End" sourceRef="Task_Subtract" targetRef="End_Subtract" />
    <bpmn:sequenceFlow id="Flow_Multiply_End" sourceRef="Task_Multiply" targetRef="End_Multiply" />
    <bpmn:sequenceFlow id="Flow_Divide_End" sourceRef="Task_Divide" targetRef="End_Divide" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_1">

      <!-- Start event: center (118, 260) -->
      <bpmndi:BPMNShape id="S_Start_1" bpmnElement="Start_1">
        <dc:Bounds x="100" y="242" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Exclusive gateway: center (225, 260) -->
      <bpmndi:BPMNShape id="S_Gw_Route" bpmnElement="Gw_Route">
        <dc:Bounds x="200" y="235" width="50" height="50" />
      </bpmndi:BPMNShape>

      <!-- Add branch: task center (410, 80), end center (558, 80) -->
      <bpmndi:BPMNShape id="S_Task_Add" bpmnElement="Task_Add">
        <dc:Bounds x="360" y="40" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End_Add" bpmnElement="End_Add">
        <dc:Bounds x="540" y="62" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Subtract branch: task center (410, 200), end center (558, 200) -->
      <bpmndi:BPMNShape id="S_Task_Subtract" bpmnElement="Task_Subtract">
        <dc:Bounds x="360" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End_Subtract" bpmnElement="End_Subtract">
        <dc:Bounds x="540" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Multiply branch: task center (410, 320), end center (558, 320) -->
      <bpmndi:BPMNShape id="S_Task_Multiply" bpmnElement="Task_Multiply">
        <dc:Bounds x="360" y="280" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End_Multiply" bpmnElement="End_Multiply">
        <dc:Bounds x="540" y="302" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Divide branch: task center (410, 440), end center (558, 440) -->
      <bpmndi:BPMNShape id="S_Task_Divide" bpmnElement="Task_Divide">
        <dc:Bounds x="360" y="400" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End_Divide" bpmnElement="End_Divide">
        <dc:Bounds x="540" y="422" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Edges -->
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_Start_Gw" bpmnElement="Flow_Start_Gw">
        <di:waypoint x="136" y="260" />
        <di:waypoint x="200" y="260" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_Gw_Add" bpmnElement="Flow_Gw_Add">
        <di:waypoint x="250" y="260" />
        <di:waypoint x="305" y="260" />
        <di:waypoint x="305" y="80" />
        <di:waypoint x="360" y="80" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_Gw_Subtract" bpmnElement="Flow_Gw_Subtract">
        <di:waypoint x="250" y="260" />
        <di:waypoint x="305" y="260" />
        <di:waypoint x="305" y="200" />
        <di:waypoint x="360" y="200" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_Gw_Multiply" bpmnElement="Flow_Gw_Multiply">
        <di:waypoint x="250" y="260" />
        <di:waypoint x="305" y="260" />
        <di:waypoint x="305" y="320" />
        <di:waypoint x="360" y="320" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_Gw_Divide" bpmnElement="Flow_Gw_Divide">
        <di:waypoint x="250" y="260" />
        <di:waypoint x="305" y="260" />
        <di:waypoint x="305" y="440" />
        <di:waypoint x="360" y="440" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_Add_End" bpmnElement="Flow_Add_End">
        <di:waypoint x="460" y="80" />
        <di:waypoint x="540" y="80" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_Subtract_End" bpmnElement="Flow_Subtract_End">
        <di:waypoint x="460" y="200" />
        <di:waypoint x="540" y="200" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_Multiply_End" bpmnElement="Flow_Multiply_End">
        <di:waypoint x="460" y="320" />
        <di:waypoint x="540" y="320" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_Divide_End" bpmnElement="Flow_Divide_End">
        <di:waypoint x="460" y="440" />
        <di:waypoint x="540" y="440" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
