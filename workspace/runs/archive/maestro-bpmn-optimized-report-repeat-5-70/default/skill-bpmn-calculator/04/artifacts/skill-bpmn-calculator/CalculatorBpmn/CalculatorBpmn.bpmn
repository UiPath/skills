<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="UiPath (https://bpmn.uipath.com)" exporterVersion="1.0">

  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:migrationVersion version="11.5" />
      <uipath:variables version="v1">
        <uipath:inputOutput id="Var_OperandA"  name="operandA"  type="number" />
        <uipath:inputOutput id="Var_OperandB"  name="operandB"  type="number" />
        <uipath:inputOutput id="Var_Operator"  name="operator"  type="string" />
        <uipath:inputOutput id="Var_Result"    name="result"    type="number" />
      </uipath:variables>
    </bpmn:extensionElements>

    <!-- Start event (manual start with entry point) -->
    <bpmn:startEvent id="Start_1" name="Start">
      <bpmn:extensionElements>
        <uipath:entryPointId value="a1b2c3d4-e5f6-7890-abcd-ef1234567890" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_StartToGw</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Exclusive gateway: route on operator -->
    <bpmn:exclusiveGateway id="Gw_Route" name="operator?" default="Flow_Divide">
      <bpmn:incoming>Flow_StartToGw</bpmn:incoming>
      <bpmn:outgoing>Flow_Add</bpmn:outgoing>
      <bpmn:outgoing>Flow_Subtract</bpmn:outgoing>
      <bpmn:outgoing>Flow_Multiply</bpmn:outgoing>
      <bpmn:outgoing>Flow_Divide</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Branch: add -->
    <bpmn:scriptTask id="Task_Add" name="Add" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"a":"=vars.Var_OperandA","b":"=vars.Var_OperandB"}]]></uipath:input>
          <uipath:output name="result" type="number" var="Var_Result" source="=result.response" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Add</bpmn:incoming>
      <bpmn:outgoing>Flow_AddToEnd</bpmn:outgoing>
      <bpmn:script><![CDATA[return { response: a + b };]]></bpmn:script>
    </bpmn:scriptTask>
    <bpmn:endEvent id="End_Add" name="End Add">
      <bpmn:incoming>Flow_AddToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Branch: subtract -->
    <bpmn:scriptTask id="Task_Subtract" name="Subtract" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"a":"=vars.Var_OperandA","b":"=vars.Var_OperandB"}]]></uipath:input>
          <uipath:output name="result" type="number" var="Var_Result" source="=result.response" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Subtract</bpmn:incoming>
      <bpmn:outgoing>Flow_SubtractToEnd</bpmn:outgoing>
      <bpmn:script><![CDATA[return { response: a - b };]]></bpmn:script>
    </bpmn:scriptTask>
    <bpmn:endEvent id="End_Subtract" name="End Subtract">
      <bpmn:incoming>Flow_SubtractToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Branch: multiply -->
    <bpmn:scriptTask id="Task_Multiply" name="Multiply" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"a":"=vars.Var_OperandA","b":"=vars.Var_OperandB"}]]></uipath:input>
          <uipath:output name="result" type="number" var="Var_Result" source="=result.response" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Multiply</bpmn:incoming>
      <bpmn:outgoing>Flow_MultiplyToEnd</bpmn:outgoing>
      <bpmn:script><![CDATA[return { response: a * b };]]></bpmn:script>
    </bpmn:scriptTask>
    <bpmn:endEvent id="End_Multiply" name="End Multiply">
      <bpmn:incoming>Flow_MultiplyToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Branch: divide (default) -->
    <bpmn:scriptTask id="Task_Divide" name="Divide" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"a":"=vars.Var_OperandA","b":"=vars.Var_OperandB"}]]></uipath:input>
          <uipath:output name="result" type="number" var="Var_Result" source="=result.response" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Divide</bpmn:incoming>
      <bpmn:outgoing>Flow_DivideToEnd</bpmn:outgoing>
      <bpmn:script><![CDATA[return { response: b !== 0 ? a / b : 0 };]]></bpmn:script>
    </bpmn:scriptTask>
    <bpmn:endEvent id="End_Divide" name="End Divide">
      <bpmn:incoming>Flow_DivideToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="Flow_StartToGw" sourceRef="Start_1" targetRef="Gw_Route" />

    <bpmn:sequenceFlow id="Flow_Add" sourceRef="Gw_Route" targetRef="Task_Add">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=vars.Var_Operator == "add"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_AddToEnd" sourceRef="Task_Add" targetRef="End_Add" />

    <bpmn:sequenceFlow id="Flow_Subtract" sourceRef="Gw_Route" targetRef="Task_Subtract">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=vars.Var_Operator == "subtract"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_SubtractToEnd" sourceRef="Task_Subtract" targetRef="End_Subtract" />

    <bpmn:sequenceFlow id="Flow_Multiply" sourceRef="Gw_Route" targetRef="Task_Multiply">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=vars.Var_Operator == "multiply"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_MultiplyToEnd" sourceRef="Task_Multiply" targetRef="End_Multiply" />

    <!-- Flow_Divide is the default (no conditionExpression) -->
    <bpmn:sequenceFlow id="Flow_Divide" sourceRef="Gw_Route" targetRef="Task_Divide" />
    <bpmn:sequenceFlow id="Flow_DivideToEnd" sourceRef="Task_Divide" targetRef="End_Divide" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_1">

      <!-- Start -->
      <bpmndi:BPMNShape id="S_Start_1" bpmnElement="Start_1">
        <dc:Bounds x="160" y="272" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Gateway -->
      <bpmndi:BPMNShape id="S_Gw_Route" bpmnElement="Gw_Route">
        <dc:Bounds x="260" y="265" width="50" height="50" />
      </bpmndi:BPMNShape>

      <!-- Add branch (top) -->
      <bpmndi:BPMNShape id="S_Task_Add" bpmnElement="Task_Add">
        <dc:Bounds x="380" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End_Add" bpmnElement="End_Add">
        <dc:Bounds x="540" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Subtract branch -->
      <bpmndi:BPMNShape id="S_Task_Subtract" bpmnElement="Task_Subtract">
        <dc:Bounds x="380" y="210" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End_Subtract" bpmnElement="End_Subtract">
        <dc:Bounds x="540" y="232" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Multiply branch -->
      <bpmndi:BPMNShape id="S_Task_Multiply" bpmnElement="Task_Multiply">
        <dc:Bounds x="380" y="340" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End_Multiply" bpmnElement="End_Multiply">
        <dc:Bounds x="540" y="362" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Divide branch (bottom / default) -->
      <bpmndi:BPMNShape id="S_Task_Divide" bpmnElement="Task_Divide">
        <dc:Bounds x="380" y="470" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End_Divide" bpmnElement="End_Divide">
        <dc:Bounds x="540" y="492" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Edges -->
      <bpmndi:BPMNEdge id="E_StartToGw" bpmnElement="Flow_StartToGw">
        <di:waypoint x="196" y="290" />
        <di:waypoint x="260" y="290" />
      </bpmndi:BPMNEdge>

      <!-- Gw to Add -->
      <bpmndi:BPMNEdge id="E_Add" bpmnElement="Flow_Add">
        <di:waypoint x="285" y="265" />
        <di:waypoint x="285" y="120" />
        <di:waypoint x="380" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_AddToEnd" bpmnElement="Flow_AddToEnd">
        <di:waypoint x="480" y="120" />
        <di:waypoint x="540" y="120" />
      </bpmndi:BPMNEdge>

      <!-- Gw to Subtract -->
      <bpmndi:BPMNEdge id="E_Subtract" bpmnElement="Flow_Subtract">
        <di:waypoint x="285" y="265" />
        <di:waypoint x="285" y="250" />
        <di:waypoint x="380" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_SubtractToEnd" bpmnElement="Flow_SubtractToEnd">
        <di:waypoint x="480" y="250" />
        <di:waypoint x="540" y="250" />
      </bpmndi:BPMNEdge>

      <!-- Gw to Multiply -->
      <bpmndi:BPMNEdge id="E_Multiply" bpmnElement="Flow_Multiply">
        <di:waypoint x="285" y="315" />
        <di:waypoint x="285" y="380" />
        <di:waypoint x="380" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_MultiplyToEnd" bpmnElement="Flow_MultiplyToEnd">
        <di:waypoint x="480" y="380" />
        <di:waypoint x="540" y="380" />
      </bpmndi:BPMNEdge>

      <!-- Gw to Divide (default) -->
      <bpmndi:BPMNEdge id="E_Divide" bpmnElement="Flow_Divide">
        <di:waypoint x="285" y="315" />
        <di:waypoint x="285" y="510" />
        <di:waypoint x="380" y="510" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_DivideToEnd" bpmnElement="Flow_DivideToEnd">
        <di:waypoint x="480" y="510" />
        <di:waypoint x="540" y="510" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
