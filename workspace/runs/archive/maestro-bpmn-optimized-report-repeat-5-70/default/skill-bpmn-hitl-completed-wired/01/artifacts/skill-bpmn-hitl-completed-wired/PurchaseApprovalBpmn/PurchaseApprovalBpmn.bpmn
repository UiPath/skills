<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="UiPath (https://bpmn.uipath.com)" exporterVersion="1.0">

  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:migrationVersion version="11.5" />
      <uipath:variables version="v1">
        <uipath:inputOutput id="Var_PurchaseAmount" name="PurchaseAmount" type="number" />
        <uipath:inputOutput id="Var_VendorName"     name="VendorName"     type="string" />
        <uipath:inputOutput id="Var_ApprovalResult" name="ApprovalResult" type="json"   />
        <uipath:inputOutput id="Var_RecordStatus"   name="RecordStatus"   type="string" />
      </uipath:variables>
    </bpmn:extensionElements>

    <!-- Manual start event (none-typed, no event definition) -->
    <bpmn:startEvent id="StartEvent_1" name="Start Purchase Approval">
      <bpmn:outgoing>Flow_Start_to_HITL</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- HITL approval user task (Actions.HITL from registry) -->
    <bpmn:userTask id="UserTask_HITLApproval" name="Review Purchase Request">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Actions.HITL" version="v1" />
          <uipath:context>
            <uipath:input name="appId"       value="placeholder-app-id-001" />
            <uipath:input name="appVersion"  value="1" />
            <uipath:input name="actions"     value="Approve,Reject" />
            <uipath:input name="key"         value="placeholder-folder-key-001" />
            <uipath:input name="taskTitle"   value="Purchase Approval Required" />
          </uipath:context>
          <uipath:input name="HitlTaskArguments" type="json" target="bodyField"><![CDATA[{
  "purchaseAmount": "=vars.Var_PurchaseAmount",
  "vendorName":     "=vars.Var_VendorName"
}]]></uipath:input>
          <uipath:output name="Process response" type="Actions.HITL" var="Var_ApprovalResult" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_to_HITL</bpmn:incoming>
      <bpmn:outgoing>Flow_HITL_to_Record</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Script task that records the approval outcome (BPMN.ScriptTask from registry) -->
    <bpmn:scriptTask id="ScriptTask_RecordApproval" name="Record Approval Decision" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{
  "approvalResult": "=vars.Var_ApprovalResult",
  "vendorName":     "=vars.Var_VendorName",
  "purchaseAmount": "=vars.Var_PurchaseAmount"
}]]></uipath:input>
          <uipath:output name="recordStatus" type="string" var="Var_RecordStatus" source="=result.response" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:script><![CDATA[
var decision = approvalResult && approvalResult.action ? approvalResult.action : "Unknown";
var msg = "Decision '" + decision + "' for vendor '" + vendorName + "' (amount: " + purchaseAmount + ") recorded.";
return { response: msg };
]]></bpmn:script>
      <bpmn:incoming>Flow_HITL_to_Record</bpmn:incoming>
      <bpmn:outgoing>Flow_Record_to_End</bpmn:outgoing>
    </bpmn:scriptTask>

    <!-- End event -->
    <bpmn:endEvent id="EndEvent_1" name="Approval Process Complete">
      <bpmn:incoming>Flow_Record_to_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="Flow_Start_to_HITL"   sourceRef="StartEvent_1"        targetRef="UserTask_HITLApproval" />
    <bpmn:sequenceFlow id="Flow_HITL_to_Record"  sourceRef="UserTask_HITLApproval" targetRef="ScriptTask_RecordApproval" />
    <bpmn:sequenceFlow id="Flow_Record_to_End"   sourceRef="ScriptTask_RecordApproval" targetRef="EndEvent_1" />
  </bpmn:process>

  <!-- BPMN DI: left-to-right linear layout -->
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_1">

      <!-- Shapes -->
      <bpmndi:BPMNShape id="S_StartEvent_1" bpmnElement="StartEvent_1">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_UserTask_HITLApproval" bpmnElement="UserTask_HITLApproval">
        <dc:Bounds x="260" y="78" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_ScriptTask_RecordApproval" bpmnElement="ScriptTask_RecordApproval">
        <dc:Bounds x="430" y="78" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_EndEvent_1" bpmnElement="EndEvent_1">
        <dc:Bounds x="602" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Edges -->
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_Start_to_HITL" bpmnElement="Flow_Start_to_HITL">
        <di:waypoint x="196" y="118" />
        <di:waypoint x="260" y="118" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_HITL_to_Record" bpmnElement="Flow_HITL_to_Record">
        <di:waypoint x="360" y="118" />
        <di:waypoint x="430" y="118" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_Record_to_End" bpmnElement="Flow_Record_to_End">
        <di:waypoint x="530" y="118" />
        <di:waypoint x="602" y="118" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
