<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="UiPath (https://bpmn.uipath.com)" exporterVersion="1.0">

  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:migrationVersion version="11.5" />
      <uipath:variables version="v1">
        <uipath:inputOutput id="Var_PurchaseAmount" name="PurchaseAmount" type="number" />
        <uipath:inputOutput id="Var_Vendor" name="Vendor" type="string" />
        <uipath:inputOutput id="Var_ApprovalOutcome" name="ApprovalOutcome" type="Actions.HITL" />
        <uipath:inputOutput id="Var_RecordStatus" name="RecordStatus" type="string" />
      </uipath:variables>
    </bpmn:extensionElements>

    <!-- Manual start event -->
    <bpmn:startEvent id="StartEvent_1" name="Purchase Request Received">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- HITL approval task -->
    <bpmn:userTask id="Task_ApprovalHITL" name="Approve Purchase">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Actions.HITL" version="v1" />
          <uipath:context>
            <uipath:input name="appId" value="placeholder-app-id" />
            <uipath:input name="appVersion" value="1" />
            <uipath:input name="actions" value="Approve,Reject" />
            <uipath:input name="key" value="placeholder-folder-key" />
            <uipath:input name="taskTitle" value="Purchase Approval Required" />
          </uipath:context>
          <uipath:input name="HitlTaskArguments" type="json" target="bodyField"><![CDATA[{"purchaseAmount":"=vars.Var_PurchaseAmount","vendor":"=vars.Var_Vendor"}]]></uipath:input>
          <uipath:output name="Process response" type="Actions.HITL" var="Var_ApprovalOutcome" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Record approval script task -->
    <bpmn:scriptTask id="Task_RecordApproval" name="Record Approval Decision" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"outcome":"=vars.Var_ApprovalOutcome","vendor":"=vars.Var_Vendor","amount":"=vars.Var_PurchaseAmount"}]]></uipath:input>
          <uipath:output name="recordStatus" type="string" var="Var_RecordStatus" source="=result.response" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:script><![CDATA[
var entry = "Vendor: " + vendor + " | Amount: " + amount + " | Decision: " + JSON.stringify(outcome);
return { response: entry };
]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- End event -->
    <bpmn:endEvent id="EndEvent_1" name="Process Complete">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_ApprovalHITL" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_ApprovalHITL" targetRef="Task_RecordApproval" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_RecordApproval" targetRef="EndEvent_1" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_1">
      <!-- Start event -->
      <bpmndi:BPMNShape id="S_StartEvent_1" bpmnElement="StartEvent_1">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <!-- HITL approval task -->
      <bpmndi:BPMNShape id="S_Task_ApprovalHITL" bpmnElement="Task_ApprovalHITL">
        <dc:Bounds x="260" y="78" width="100" height="80" />
      </bpmndi:BPMNShape>
      <!-- Record approval script task -->
      <bpmndi:BPMNShape id="S_Task_RecordApproval" bpmnElement="Task_RecordApproval">
        <dc:Bounds x="430" y="78" width="100" height="80" />
      </bpmndi:BPMNShape>
      <!-- End event -->
      <bpmndi:BPMNShape id="S_EndEvent_1" bpmnElement="EndEvent_1">
        <dc:Bounds x="602" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <!-- Edges -->
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="196" y="118" />
        <di:waypoint x="260" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="360" y="118" />
        <di:waypoint x="430" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_3" bpmnElement="Flow_3">
        <di:waypoint x="530" y="118" />
        <di:waypoint x="602" y="118" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
