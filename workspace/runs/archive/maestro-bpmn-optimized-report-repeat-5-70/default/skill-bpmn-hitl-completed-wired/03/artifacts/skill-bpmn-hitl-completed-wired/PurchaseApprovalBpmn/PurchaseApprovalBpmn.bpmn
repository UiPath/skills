<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="UiPath (https://bpmn.uipath.com)" exporterVersion="1.0">

  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:migrationVersion version="11.5" />
      <uipath:variables version="v1">
        <uipath:inputOutput id="Var_PurchaseAmount" name="PurchaseAmount" type="number" elementId="Start_1" />
        <uipath:inputOutput id="Var_VendorName" name="VendorName" type="string" elementId="Start_1" />
        <uipath:inputOutput id="Var_HITLResponse" name="HITLResponse" type="object" />
        <uipath:inputOutput id="Var_ApprovalStatus" name="ApprovalStatus" type="string" />
        <uipath:inputOutput id="Var_RecordResult" name="RecordResult" type="string" />
      </uipath:variables>
    </bpmn:extensionElements>

    <!-- Manual start event -->
    <bpmn:startEvent id="Start_1" name="Purchase Request Received">
      <bpmn:outgoing>Flow_StartToHITL</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- HITL approval user task (Actions.HITL template) -->
    <bpmn:userTask id="Task_HITLApproval" name="Approve Purchase">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Actions.HITL" version="v1" />
          <uipath:context>
            <uipath:input name="appId" value="placeholder-app-id" />
            <uipath:input name="appVersion" value="1" />
            <uipath:input name="actions" value="Approve,Reject" />
            <uipath:input name="key" value="placeholder-folder-key" />
            <uipath:input name="taskTitle" value="Purchase Approval Required" />
          </uipath:context>
          <uipath:input name="HitlTaskArguments" type="json" target="bodyField"><![CDATA[{"purchaseAmount":"=vars.Var_PurchaseAmount","vendorName":"=vars.Var_VendorName"}]]></uipath:input>
          <uipath:output name="Process response" type="Actions.HITL" var="Var_HITLResponse" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_StartToHITL</bpmn:incoming>
      <bpmn:outgoing>Flow_HITLToRecord</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Script task: record the approval result -->
    <bpmn:scriptTask id="Task_RecordApproval" name="Record Approval" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"hitlResponse":"=vars.Var_HITLResponse","vendor":"=vars.Var_VendorName","amount":"=vars.Var_PurchaseAmount"}]]></uipath:input>
          <uipath:output name="recordResult" type="string" var="Var_RecordResult" source="=result.response" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_HITLToRecord</bpmn:incoming>
      <bpmn:outgoing>Flow_RecordToEnd</bpmn:outgoing>
      <bpmn:script><![CDATA[
var status = (hitlResponse && hitlResponse.action) ? hitlResponse.action : "Unknown";
var entry = "Vendor=" + vendor + " Amount=" + amount + " Decision=" + status;
return { response: entry };
]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- End event -->
    <bpmn:endEvent id="End_1" name="Process Complete">
      <bpmn:incoming>Flow_RecordToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="Flow_StartToHITL" sourceRef="Start_1" targetRef="Task_HITLApproval" />
    <bpmn:sequenceFlow id="Flow_HITLToRecord" sourceRef="Task_HITLApproval" targetRef="Task_RecordApproval" />
    <bpmn:sequenceFlow id="Flow_RecordToEnd" sourceRef="Task_RecordApproval" targetRef="End_1" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_1">
      <!-- Shapes -->
      <bpmndi:BPMNShape id="S_Start_1" bpmnElement="Start_1">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_HITLApproval" bpmnElement="Task_HITLApproval">
        <dc:Bounds x="260" y="78" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_RecordApproval" bpmnElement="Task_RecordApproval">
        <dc:Bounds x="430" y="78" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End_1" bpmnElement="End_1">
        <dc:Bounds x="600" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <!-- Edges -->
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_StartToHITL" bpmnElement="Flow_StartToHITL">
        <di:waypoint x="196" y="118" />
        <di:waypoint x="260" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_HITLToRecord" bpmnElement="Flow_HITLToRecord">
        <di:waypoint x="360" y="118" />
        <di:waypoint x="430" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_RecordToEnd" bpmnElement="Flow_RecordToEnd">
        <di:waypoint x="530" y="118" />
        <di:waypoint x="600" y="118" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
