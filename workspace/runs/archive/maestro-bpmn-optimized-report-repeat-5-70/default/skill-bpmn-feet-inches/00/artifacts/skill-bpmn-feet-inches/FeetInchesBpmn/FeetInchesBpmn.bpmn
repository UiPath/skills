<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="UiPath (https://bpmn.uipath.com)" exporterVersion="1.0">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:migrationVersion version="11.5" />
      <uipath:variables version="v1">
        <!-- Process inputs -->
        <uipath:inputOutput id="Var_value" name="value" type="number" />
        <uipath:inputOutput id="Var_direction" name="direction" type="string" />
        <!-- Intermediate variables -->
        <uipath:inputOutput id="Var_normalizedValue" name="normalizedValue" type="number" />
        <uipath:inputOutput id="Var_normalizedDirection" name="normalizedDirection" type="string" />
        <uipath:inputOutput id="Var_convertedValue" name="convertedValue" type="number" />
        <!-- Output variable -->
        <uipath:inputOutput id="Var_result" name="result" type="string" />
      </uipath:variables>
    </bpmn:extensionElements>

    <bpmn:startEvent id="Start_1" name="Start">
      <bpmn:extensionElements>
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.Variables" version="v1" />
          <uipath:input name="value" type="number" var="Var_value"><![CDATA[=vars.Var_value]]></uipath:input>
          <uipath:input name="direction" type="string" var="Var_direction"><![CDATA[=vars.Var_direction]]></uipath:input>
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Normalize / parse inputs -->
    <bpmn:scriptTask id="Task_Normalize" name="Normalize Inputs" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"rawValue":"=vars.Var_value","rawDirection":"=vars.Var_direction"}]]></uipath:input>
          <uipath:output name="normalizedValue" type="number" var="Var_normalizedValue" source="=result.response.normalizedValue" />
          <uipath:output name="normalizedDirection" type="string" var="Var_normalizedDirection" source="=result.response.normalizedDirection" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:script><![CDATA[
var v = typeof rawValue === "number" ? rawValue : parseFloat(String(rawValue));
if (isNaN(v)) { v = 0; }
var d = typeof rawDirection === "string" ? rawDirection.trim().toLowerCase() : "f2i";
if (d !== "f2i" && d !== "i2f" && d !== "y2f") { d = "f2i"; }
return { response: { normalizedValue: v, normalizedDirection: d } };
]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- Task 2: Apply conversion -->
    <bpmn:scriptTask id="Task_Convert" name="Apply Conversion" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"inputValue":"=vars.Var_normalizedValue","inputDirection":"=vars.Var_normalizedDirection"}]]></uipath:input>
          <uipath:output name="convertedValue" type="number" var="Var_convertedValue" source="=result.response" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:script><![CDATA[
var converted;
if (inputDirection === "f2i") {
  converted = inputValue * 12;
} else if (inputDirection === "i2f") {
  converted = inputValue / 12;
} else {
  converted = inputValue * 3;
}
return { response: converted };
]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- Task 3: Format result -->
    <bpmn:scriptTask id="Task_Format" name="Format Result" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"convertedVal":"=vars.Var_convertedValue","dir":"=vars.Var_normalizedDirection"}]]></uipath:input>
          <uipath:output name="result" type="string" var="Var_result" source="=result.response" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:script><![CDATA[
var rounded = Math.round(convertedVal * 1000) / 1000;
var label;
if (dir === "f2i") {
  label = String(rounded) + " inches";
} else if (dir === "i2f") {
  label = String(rounded) + " feet";
} else {
  label = String(rounded) + " feet";
}
return { response: label };
]]></bpmn:script>
    </bpmn:scriptTask>

    <bpmn:endEvent id="End_1" name="End">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Task_Normalize" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Normalize" targetRef="Task_Convert" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Convert" targetRef="Task_Format" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Format" targetRef="End_1" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="S_End_1" bpmnElement="End_1"><dc:Bounds x="736" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Start_1" bpmnElement="Start_1"><dc:Bounds x="160" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_Convert" bpmnElement="Task_Convert"><dc:Bounds x="416" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_Format" bpmnElement="Task_Format"><dc:Bounds x="576" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_Normalize" bpmnElement="Task_Normalize"><dc:Bounds x="256" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="E_Flow_1" bpmnElement="Flow_1"><di:waypoint x="178" y="118" /><di:waypoint x="306" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_2" bpmnElement="Flow_2"><di:waypoint x="306" y="140" /><di:waypoint x="466" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_3" bpmnElement="Flow_3"><di:waypoint x="466" y="140" /><di:waypoint x="626" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_4" bpmnElement="Flow_4"><di:waypoint x="626" y="140" /><di:waypoint x="754" y="118" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
