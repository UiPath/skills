<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="UiPath (https://bpmn.uipath.com)" exporterVersion="1.0">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:migrationVersion version="11.5" />
      <uipath:variables version="v1">
        <!-- Inputs declared on the process; entry-point start reads them -->
        <uipath:inputOutput id="Var_Value" name="value" type="number" />
        <uipath:inputOutput id="Var_Direction" name="direction" type="string" />
        <!-- Intermediate variables passed through the pipeline -->
        <uipath:inputOutput id="Var_NormValue" name="normValue" type="number" />
        <uipath:inputOutput id="Var_NormDirection" name="normDirection" type="string" />
        <uipath:inputOutput id="Var_ConvertedValue" name="convertedValue" type="number" />
        <!-- Final output -->
        <uipath:inputOutput id="Var_Result" name="result" type="string" />
      </uipath:variables>
    </bpmn:extensionElements>

    <!-- Start event: manual trigger; declares entry-point and exposes inputs -->
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:extensionElements>
        <uipath:entryPointId value="ep_FeetInches" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.Variables" version="v1" />
          <uipath:input name="value" type="number" var="Var_Value" />
          <uipath:input name="direction" type="string" var="Var_Direction" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Normalize - parse and clamp the inputs into normValue / normDirection -->
    <bpmn:scriptTask id="Task_Normalize" name="Normalize Inputs" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"rawValue":"=vars.Var_Value","rawDirection":"=vars.Var_Direction"}]]></uipath:input>
          <uipath:output name="normValue" type="number" var="Var_NormValue" source="=result.response.normValue" />
          <uipath:output name="normDirection" type="string" var="Var_NormDirection" source="=result.response.normDirection" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:script><![CDATA[
var v = typeof rawValue === "number" ? rawValue : parseFloat(rawValue) || 0;
var d = typeof rawDirection === "string" ? rawDirection.trim().toLowerCase() : "f2i";
var validDirs = ["f2i", "i2f", "y2f"];
if (validDirs.indexOf(d) < 0) { d = "f2i"; }
return { response: { normValue: v, normDirection: d } };
]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- Task 2: Convert - apply the conversion using normValue and normDirection -->
    <bpmn:scriptTask id="Task_Convert" name="Apply Conversion" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"normValue":"=vars.Var_NormValue","normDirection":"=vars.Var_NormDirection"}]]></uipath:input>
          <uipath:output name="convertedValue" type="number" var="Var_ConvertedValue" source="=result.response" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:script><![CDATA[
var converted;
if (normDirection === "f2i") {
  converted = normValue * 12;
} else if (normDirection === "i2f") {
  converted = normValue / 12;
} else {
  converted = normValue * 3;
}
return { response: converted };
]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- Task 3: Format - build the human-readable result string -->
    <bpmn:scriptTask id="Task_Format" name="Format Result" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"convertedValue":"=vars.Var_ConvertedValue","normDirection":"=vars.Var_NormDirection","normValue":"=vars.Var_NormValue"}]]></uipath:input>
          <uipath:output name="result" type="string" var="Var_Result" source="=result.response" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:script><![CDATA[
var fromUnit, toUnit;
if (normDirection === "f2i") {
  fromUnit = "ft"; toUnit = "in";
} else if (normDirection === "i2f") {
  fromUnit = "in"; toUnit = "ft";
} else {
  fromUnit = "yd"; toUnit = "ft";
}
var rounded = Math.round(convertedValue * 1000) / 1000;
return { response: normValue + " " + fromUnit + " = " + rounded + " " + toUnit };
]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- End event -->
    <bpmn:endEvent id="EndEvent_1" name="End">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_Normalize" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Normalize" targetRef="Task_Convert" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Convert" targetRef="Task_Format" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Format" targetRef="EndEvent_1" />
  </bpmn:process>

  <!-- Diagram placeholder - will be replaced by generate_diagram.py -->

  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="S_EndEvent_1" bpmnElement="EndEvent_1"><dc:Bounds x="736" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_StartEvent_1" bpmnElement="StartEvent_1"><dc:Bounds x="160" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_Convert" bpmnElement="Task_Convert"><dc:Bounds x="416" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_Format" bpmnElement="Task_Format"><dc:Bounds x="576" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_Normalize" bpmnElement="Task_Normalize"><dc:Bounds x="256" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="E_Flow_1" bpmnElement="Flow_1"><di:waypoint x="178" y="118" /><di:waypoint x="306" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_2" bpmnElement="Flow_2"><di:waypoint x="306" y="140" /><di:waypoint x="466" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_3" bpmnElement="Flow_3"><di:waypoint x="466" y="140" /><di:waypoint x="626" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_4" bpmnElement="Flow_4"><di:waypoint x="626" y="140" /><di:waypoint x="754" y="118" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
