<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="UiPath (https://bpmn.uipath.com)" exporterVersion="1.0">

  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:migrationVersion version="11.5" />
      <uipath:variables version="v1">
        <uipath:inputOutput id="Var_ExpenseAmount"   name="expenseAmount"   type="number" />
        <uipath:inputOutput id="Var_RequesterName"   name="requesterName"   type="string" />
        <uipath:inputOutput id="Var_Category"        name="category"        type="string" />
        <uipath:inputOutput id="Var_Decision"        name="approvalDecision" type="string" />
        <uipath:inputOutput id="Var_Comments"        name="reviewerComments" type="string" />
      </uipath:variables>
    </bpmn:extensionElements>

    <!-- 1. Manual start -->
    <bpmn:startEvent id="StartEvent_1" name="Expense Submitted">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- 2. HITL user task - expense review (Actions.HITL from registry template) -->
    <bpmn:userTask id="UserTask_ExpenseReview" name="Review Expense">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Actions.HITL" version="v1" />
          <uipath:context>
            <uipath:input name="appId" value="placeholder-expense-app-id" />
            <uipath:input name="appVersion" value="1" />
            <uipath:input name="actions" value="approve,reject" />
            <uipath:input name="key" value="placeholder-folder-key" />
            <uipath:input name="taskTitle" value="Expense Review Task" />
          </uipath:context>
          <uipath:input name="HitlTaskArguments" type="json" target="bodyField"><![CDATA[{
  "expenseAmount": "=vars.Var_ExpenseAmount",
  "requesterName": "=vars.Var_RequesterName",
  "category":      "=vars.Var_Category"
}]]></uipath:input>
          <uipath:output name="Process response" type="Actions.HITL" var="Var_Decision" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- 3. Exclusive gateway: branch on reviewer decision -->
    <bpmn:exclusiveGateway id="Gateway_Decision" name="Approved?" default="Flow_Rejected">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Approved branch: record approval -->
    <bpmn:scriptTask id="ScriptTask_RecordApproval" name="Record Approval" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"decision":"=vars.Var_Decision","comments":"=vars.Var_Comments"}]]></uipath:input>
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:script><![CDATA[
return { response: "Expense approved. Decision: " + decision + ". Comments: " + comments };
]]></bpmn:script>
    </bpmn:scriptTask>

    <bpmn:endEvent id="EndEvent_Approved" name="Approved">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Rejected / default branch: end process -->
    <bpmn:endEvent id="EndEvent_Rejected" name="Rejected">
      <bpmn:incoming>Flow_Rejected</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1"     targetRef="UserTask_ExpenseReview" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="UserTask_ExpenseReview" targetRef="Gateway_Decision" />
    <bpmn:sequenceFlow id="Flow_Approved" sourceRef="Gateway_Decision" targetRef="ScriptTask_RecordApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=vars.Var_Decision == "approve"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="ScriptTask_RecordApproval" targetRef="EndEvent_Approved" />
    <bpmn:sequenceFlow id="Flow_Rejected" sourceRef="Gateway_Decision" targetRef="EndEvent_Rejected" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="S_StartEvent_1" bpmnElement="StartEvent_1">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_UserTask_ExpenseReview" bpmnElement="UserTask_ExpenseReview">
        <dc:Bounds x="250" y="78" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Gateway_Decision" bpmnElement="Gateway_Decision">
        <dc:Bounds x="415" y="93" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_ScriptTask_RecordApproval" bpmnElement="ScriptTask_RecordApproval">
        <dc:Bounds x="530" y="40" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_EndEvent_Approved" bpmnElement="EndEvent_Approved">
        <dc:Bounds x="695" y="62" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_EndEvent_Rejected" bpmnElement="EndEvent_Rejected">
        <dc:Bounds x="530" y="170" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="196" y="118" />
        <di:waypoint x="250" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="350" y="118" />
        <di:waypoint x="415" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_Approved" bpmnElement="Flow_Approved">
        <di:waypoint x="440" y="93" />
        <di:waypoint x="440" y="80" />
        <di:waypoint x="530" y="80" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_3" bpmnElement="Flow_3">
        <di:waypoint x="630" y="80" />
        <di:waypoint x="695" y="80" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_Rejected" bpmnElement="Flow_Rejected">
        <di:waypoint x="440" y="143" />
        <di:waypoint x="440" y="188" />
        <di:waypoint x="530" y="188" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
