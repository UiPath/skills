<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="UiPath (https://bpmn.uipath.com)" exporterVersion="1.0">

  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:migrationVersion version="11.5" />
      <uipath:variables version="v1">
        <uipath:inputOutput id="Var_ExpenseAmount"   name="ExpenseAmount"   type="number" elementId="StartEvent_1" />
        <uipath:inputOutput id="Var_RequesterName"   name="RequesterName"   type="string" elementId="StartEvent_1" />
        <uipath:inputOutput id="Var_Category"        name="Category"        type="string" elementId="StartEvent_1" />
        <uipath:inputOutput id="Var_ApprovalDecision" name="ApprovalDecision" type="string" />
        <uipath:inputOutput id="Var_ReviewComments"  name="ReviewComments"  type="string" />
        <uipath:inputOutput id="Var_HitlResult"      name="HitlResult"      type="object" />
      </uipath:variables>
    </bpmn:extensionElements>

    <!-- Manual start -->
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:extensionElements>
        <uipath:entryPointId value="EntryPoint_Main" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_Start_to_HITL</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- HITL user task: expense review (Actions.HITL from registry template) -->
    <bpmn:userTask id="Task_ExpenseReview" name="Expense Review">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Actions.HITL" version="v1" />
          <uipath:context>
            <uipath:input name="appId" value="placeholder-app-id" />
            <uipath:input name="appVersion" value="1" />
            <uipath:input name="actions" value="" />
            <uipath:input name="key" value="" />
            <uipath:input name="taskTitle" value="Expense Review" />
          </uipath:context>
          <uipath:input name="HitlTaskArguments" type="json" target="bodyField"><![CDATA[{
  "expenseAmount": "=vars.Var_ExpenseAmount",
  "requesterName": "=vars.Var_RequesterName",
  "category": "=vars.Var_Category"
}]]></uipath:input>
          <uipath:output name="Process response" type="Actions.HITL" var="Var_HitlResult" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_to_HITL</bpmn:incoming>
      <bpmn:outgoing>Flow_HITL_to_Gw</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Exclusive gateway: branch on HITL output decision field -->
    <bpmn:exclusiveGateway id="Gw_Decision" name="Approved?" default="Flow_Gw_to_Rejected">
      <bpmn:incoming>Flow_HITL_to_Gw</bpmn:incoming>
      <bpmn:outgoing>Flow_Gw_to_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gw_to_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Approval branch: record the approval -->
    <bpmn:endEvent id="End_Approved" name="Approved">
      <bpmn:incoming>Flow_Gw_to_Approved</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Rejection / default branch: end process -->
    <bpmn:endEvent id="End_Rejected" name="Rejected">
      <bpmn:incoming>Flow_Gw_to_Rejected</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="Flow_Start_to_HITL"  sourceRef="StartEvent_1"     targetRef="Task_ExpenseReview" />
    <bpmn:sequenceFlow id="Flow_HITL_to_Gw"     sourceRef="Task_ExpenseReview" targetRef="Gw_Decision" />
    <bpmn:sequenceFlow id="Flow_Gw_to_Approved" sourceRef="Gw_Decision"      targetRef="End_Approved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=vars.Var_HitlResult.decision == "approved"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Gw_to_Rejected" sourceRef="Gw_Decision"      targetRef="End_Rejected" />

  </bpmn:process>

  <!-- Diagram placeholder — will be replaced by generate_diagram.py -->


  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="S_End_Approved" bpmnElement="End_Approved"><dc:Bounds x="526" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End_Rejected" bpmnElement="End_Rejected"><dc:Bounds x="526" y="166" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Gw_Decision" bpmnElement="Gw_Decision"><dc:Bounds x="416" y="100" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_StartEvent_1" bpmnElement="StartEvent_1"><dc:Bounds x="160" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_ExpenseReview" bpmnElement="Task_ExpenseReview"><dc:Bounds x="256" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="E_Flow_Gw_to_Approved" bpmnElement="Flow_Gw_to_Approved"><di:waypoint x="441" y="125" /><di:waypoint x="544" y="118" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_Gw_to_Rejected" bpmnElement="Flow_Gw_to_Rejected"><di:waypoint x="441" y="125" /><di:waypoint x="544" y="184" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_HITL_to_Gw" bpmnElement="Flow_HITL_to_Gw"><di:waypoint x="306" y="140" /><di:waypoint x="441" y="125" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_Start_to_HITL" bpmnElement="Flow_Start_to_HITL"><di:waypoint x="178" y="118" /><di:waypoint x="306" y="140" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
