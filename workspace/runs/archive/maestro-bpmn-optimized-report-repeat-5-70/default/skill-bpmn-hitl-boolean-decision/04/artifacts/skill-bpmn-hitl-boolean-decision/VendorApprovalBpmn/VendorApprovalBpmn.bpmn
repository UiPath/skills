<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="UiPath (https://bpmn.uipath.com)" exporterVersion="1.0">

  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:migrationVersion version="11.5" />
      <uipath:variables version="v1">
        <uipath:inputOutput id="Var_VendorName"   name="VendorName"   type="string"  />
        <uipath:inputOutput id="Var_CreditScore"  name="CreditScore"  type="number"  />
        <uipath:inputOutput id="Var_Approved"     name="Approved"     type="boolean" />
        <uipath:inputOutput id="Var_RiskNotes"    name="RiskNotes"    type="string"  />
      </uipath:variables>
    </bpmn:extensionElements>

    <!-- 1. Manual start -->
    <bpmn:startEvent id="Start_1" name="Start">
      <bpmn:outgoing>Flow_Start_SetCtx</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- 2. Script task: set vendor context (mock data) -->
    <bpmn:scriptTask id="Task_SetContext" name="Set Vendor Context" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{}]]></uipath:input>
          <uipath:output name="vendorName"  type="string" var="Var_VendorName"  source="=result.response.vendorName"  />
          <uipath:output name="creditScore" type="number" var="Var_CreditScore" source="=result.response.creditScore" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_SetCtx</bpmn:incoming>
      <bpmn:outgoing>Flow_SetCtx_Review</bpmn:outgoing>
      <bpmn:script><![CDATA[
return {
  response: {
    vendorName: "Acme Supplies Inc.",
    creditScore: 720
  }
};
]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- 3. HITL user task: compliance officer review -->
    <bpmn:userTask id="Task_ReviewVendor" name="Compliance Officer Review">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Actions.HITL" version="v1" />
          <uipath:context>
            <uipath:input name="appId"       value="vendor-review-app-placeholder" />
            <uipath:input name="appVersion"  value="1" />
            <uipath:input name="actions"     value="approve,reject" />
            <uipath:input name="key"         value="vendor-review-folder-placeholder" />
            <uipath:input name="taskTitle"   value="Review Vendor Onboarding Request" />
          </uipath:context>
          <uipath:input name="HitlTaskArguments" type="json" target="bodyField"><![CDATA[{
  "vendorName": "=vars.Var_VendorName",
  "creditScore": "=vars.Var_CreditScore"
}]]></uipath:input>
          <uipath:output name="Approved"  type="boolean" var="Var_Approved"  source="=result.Approved"  />
          <uipath:output name="RiskNotes" type="string"  var="Var_RiskNotes" source="=result.RiskNotes" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_SetCtx_Review</bpmn:incoming>
      <bpmn:outgoing>Flow_Review_Gw</bpmn:outgoing>
    </bpmn:userTask>

    <!-- 4. Exclusive gateway: branch on boolean Approved -->
    <bpmn:exclusiveGateway id="Gw_ApprovalDecision" name="Approved?" default="Flow_Gw_Reject">
      <bpmn:incoming>Flow_Review_Gw</bpmn:incoming>
      <bpmn:outgoing>Flow_Gw_Onboard</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gw_Reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- 4a. Onboard vendor (approved path) -->
    <bpmn:task id="Task_OnboardVendor" name="Onboard Vendor">
      <bpmn:extensionElements>
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.Variables" version="v1" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Gw_Onboard</bpmn:incoming>
      <bpmn:outgoing>Flow_Onboard_End</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="End_Approved" name="Vendor Onboarded">
      <bpmn:incoming>Flow_Onboard_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- 4b. Reject vendor (rejected path) -->
    <bpmn:task id="Task_RejectVendor" name="Reject Vendor">
      <bpmn:extensionElements>
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.Variables" version="v1" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Gw_Reject</bpmn:incoming>
      <bpmn:outgoing>Flow_Reject_End</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="End_Rejected" name="Vendor Rejected">
      <bpmn:incoming>Flow_Reject_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="Flow_Start_SetCtx"  sourceRef="Start_1"            targetRef="Task_SetContext"    />
    <bpmn:sequenceFlow id="Flow_SetCtx_Review" sourceRef="Task_SetContext"     targetRef="Task_ReviewVendor"  />
    <bpmn:sequenceFlow id="Flow_Review_Gw"     sourceRef="Task_ReviewVendor"   targetRef="Gw_ApprovalDecision"/>
    <bpmn:sequenceFlow id="Flow_Gw_Onboard"    sourceRef="Gw_ApprovalDecision" targetRef="Task_OnboardVendor">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=vars.Var_Approved == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Gw_Reject"     sourceRef="Gw_ApprovalDecision" targetRef="Task_RejectVendor"  />
    <bpmn:sequenceFlow id="Flow_Onboard_End"   sourceRef="Task_OnboardVendor"  targetRef="End_Approved"       />
    <bpmn:sequenceFlow id="Flow_Reject_End"    sourceRef="Task_RejectVendor"   targetRef="End_Rejected"       />

  </bpmn:process>

  <!-- BPMNDiagram placeholder — will be replaced by generate_diagram.py -->


  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="S_End_Approved" bpmnElement="End_Approved"><dc:Bounds x="846" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End_Rejected" bpmnElement="End_Rejected"><dc:Bounds x="846" y="166" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Gw_ApprovalDecision" bpmnElement="Gw_ApprovalDecision"><dc:Bounds x="576" y="100" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Start_1" bpmnElement="Start_1"><dc:Bounds x="160" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_OnboardVendor" bpmnElement="Task_OnboardVendor"><dc:Bounds x="686" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_RejectVendor" bpmnElement="Task_RejectVendor"><dc:Bounds x="686" y="210" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_ReviewVendor" bpmnElement="Task_ReviewVendor"><dc:Bounds x="416" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_SetContext" bpmnElement="Task_SetContext"><dc:Bounds x="256" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="E_Flow_Gw_Onboard" bpmnElement="Flow_Gw_Onboard"><di:waypoint x="601" y="125" /><di:waypoint x="736" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_Gw_Reject" bpmnElement="Flow_Gw_Reject"><di:waypoint x="601" y="125" /><di:waypoint x="736" y="250" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_Onboard_End" bpmnElement="Flow_Onboard_End"><di:waypoint x="736" y="140" /><di:waypoint x="864" y="118" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_Reject_End" bpmnElement="Flow_Reject_End"><di:waypoint x="736" y="250" /><di:waypoint x="864" y="184" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_Review_Gw" bpmnElement="Flow_Review_Gw"><di:waypoint x="466" y="140" /><di:waypoint x="601" y="125" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_SetCtx_Review" bpmnElement="Flow_SetCtx_Review"><di:waypoint x="306" y="140" /><di:waypoint x="466" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_Start_SetCtx" bpmnElement="Flow_Start_SetCtx"><di:waypoint x="178" y="118" /><di:waypoint x="306" y="140" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
