<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="UiPath (https://bpmn.uipath.com)" exporterVersion="1.0">

  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:migrationVersion version="11.5" />
      <!-- Process variables declared via BPMN.Variables registry template -->
      <uipath:variables version="v1">
        <uipath:inputOutput id="Var_VendorName"   name="VendorName"   type="string"  />
        <uipath:inputOutput id="Var_CreditScore"  name="CreditScore"  type="number"  />
        <uipath:inputOutput id="Var_Approved"     name="Approved"     type="boolean" />
        <uipath:inputOutput id="Var_RiskNotes"    name="RiskNotes"    type="string"  />
      </uipath:variables>
    </bpmn:extensionElements>

    <!-- 1. Manual start -->
    <bpmn:startEvent id="Start_1" name="Start">
      <bpmn:outgoing>Flow_StartToScript</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- 2. Script task: set vendor context (mock data) -->
    <!-- BPMN.ScriptTask registry template, script sets VendorName and CreditScore -->
    <bpmn:scriptTask id="Task_SetVendorContext" name="Set Vendor Context" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{}]]></uipath:input>
          <uipath:output name="vendorName"  type="string" var="Var_VendorName"  source="=result.response.vendorName" />
          <uipath:output name="creditScore" type="number" var="Var_CreditScore" source="=result.response.creditScore" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_StartToScript</bpmn:incoming>
      <bpmn:outgoing>Flow_ScriptToHITL</bpmn:outgoing>
      <bpmn:script><![CDATA[
return {
  response: {
    vendorName:  "Acme Supplies Co.",
    creditScore: 720
  }
};
]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- 3. HITL user task: compliance officer reviews and approves -->
    <!-- Actions.HITL registry template (bpmn:UserTask) -->
    <!-- Output boolean field isApproved bound to boolean variable Var_Approved -->
    <bpmn:userTask id="Task_ReviewVendor" name="Compliance Review">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Actions.HITL" version="v1" />
          <uipath:context>
            <uipath:input name="appId"       value="vendor-approval-app-placeholder" />
            <uipath:input name="appVersion"  value="1" />
            <uipath:input name="actions"     value="" />
            <uipath:input name="key"         value="" />
            <uipath:input name="taskTitle"   value="Vendor Compliance Review" />
          </uipath:context>
          <uipath:input name="HitlTaskArguments" type="json" target="bodyField"><![CDATA[{
  "vendorName":  "=vars.Var_VendorName",
  "creditScore": "=vars.Var_CreditScore"
}]]></uipath:input>
          <!-- Boolean output: approval decision captured as boolean, bound to Var_Approved -->
          <uipath:output name="isApproved" type="boolean" var="Var_Approved"  source="=result.response.isApproved" />
          <!-- String output: optional risk notes -->
          <uipath:output name="riskNotes"  type="string"  var="Var_RiskNotes" source="=result.response.riskNotes" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ScriptToHITL</bpmn:incoming>
      <bpmn:outgoing>Flow_HITLToGateway</bpmn:outgoing>
    </bpmn:userTask>

    <!-- 4. Exclusive gateway: branch on boolean Var_Approved -->
    <bpmn:exclusiveGateway id="Gw_ApprovalDecision" name="Approved?" default="Flow_Reject">
      <bpmn:incoming>Flow_HITLToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Approve</bpmn:outgoing>
      <bpmn:outgoing>Flow_Reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Onboard path -->
    <bpmn:task id="Task_OnboardVendor" name="Onboard Vendor">
      <bpmn:extensionElements>
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.Variables" version="v1" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Approve</bpmn:incoming>
      <bpmn:outgoing>Flow_OnboardToEnd</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="End_Approved" name="Vendor Onboarded">
      <bpmn:incoming>Flow_OnboardToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Reject path -->
    <bpmn:task id="Task_RejectVendor" name="Reject Vendor">
      <bpmn:extensionElements>
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.Variables" version="v1" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Reject</bpmn:incoming>
      <bpmn:outgoing>Flow_RejectToEnd</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="End_Rejected" name="Vendor Rejected">
      <bpmn:incoming>Flow_RejectToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="Flow_StartToScript"  sourceRef="Start_1"            targetRef="Task_SetVendorContext" />
    <bpmn:sequenceFlow id="Flow_ScriptToHITL"   sourceRef="Task_SetVendorContext" targetRef="Task_ReviewVendor" />
    <bpmn:sequenceFlow id="Flow_HITLToGateway"  sourceRef="Task_ReviewVendor"   targetRef="Gw_ApprovalDecision" />

    <!-- Approve: condition treats Var_Approved as boolean -->
    <bpmn:sequenceFlow id="Flow_Approve" sourceRef="Gw_ApprovalDecision" targetRef="Task_OnboardVendor">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=vars.Var_Approved == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Reject: default flow (no condition) -->
    <bpmn:sequenceFlow id="Flow_Reject"        sourceRef="Gw_ApprovalDecision" targetRef="Task_RejectVendor" />

    <bpmn:sequenceFlow id="Flow_OnboardToEnd"  sourceRef="Task_OnboardVendor"  targetRef="End_Approved" />
    <bpmn:sequenceFlow id="Flow_RejectToEnd"   sourceRef="Task_RejectVendor"   targetRef="End_Rejected" />
  </bpmn:process>

  <!--
    BPMN DI: layout left-to-right
    Start(160,100) -> SetContext(250,78) -> ReviewVendor(410,78) -> Gateway(570,93)
      -> OnboardVendor(680,38) -> End_Approved(840,56)
      -> RejectVendor(680,148) -> End_Rejected(840,166)
  -->


  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="S_End_Approved" bpmnElement="End_Approved"><dc:Bounds x="846" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End_Rejected" bpmnElement="End_Rejected"><dc:Bounds x="846" y="166" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Gw_ApprovalDecision" bpmnElement="Gw_ApprovalDecision"><dc:Bounds x="576" y="100" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Start_1" bpmnElement="Start_1"><dc:Bounds x="160" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_OnboardVendor" bpmnElement="Task_OnboardVendor"><dc:Bounds x="686" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_RejectVendor" bpmnElement="Task_RejectVendor"><dc:Bounds x="686" y="210" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_ReviewVendor" bpmnElement="Task_ReviewVendor"><dc:Bounds x="416" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_SetVendorContext" bpmnElement="Task_SetVendorContext"><dc:Bounds x="256" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="E_Flow_Approve" bpmnElement="Flow_Approve"><di:waypoint x="601" y="125" /><di:waypoint x="736" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_HITLToGateway" bpmnElement="Flow_HITLToGateway"><di:waypoint x="466" y="140" /><di:waypoint x="601" y="125" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_OnboardToEnd" bpmnElement="Flow_OnboardToEnd"><di:waypoint x="736" y="140" /><di:waypoint x="864" y="118" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_Reject" bpmnElement="Flow_Reject"><di:waypoint x="601" y="125" /><di:waypoint x="736" y="250" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_RejectToEnd" bpmnElement="Flow_RejectToEnd"><di:waypoint x="736" y="250" /><di:waypoint x="864" y="184" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_ScriptToHITL" bpmnElement="Flow_ScriptToHITL"><di:waypoint x="306" y="140" /><di:waypoint x="466" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_StartToScript" bpmnElement="Flow_StartToScript"><di:waypoint x="178" y="118" /><di:waypoint x="306" y="140" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
