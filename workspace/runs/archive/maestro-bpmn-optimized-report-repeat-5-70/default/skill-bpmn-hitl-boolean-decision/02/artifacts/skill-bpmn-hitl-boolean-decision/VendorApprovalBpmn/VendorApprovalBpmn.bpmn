<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="UiPath (https://bpmn.uipath.com)" exporterVersion="1.0">

  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:migrationVersion version="11.5" />
      <uipath:variables version="v1">
        <uipath:inputOutput id="Var_VendorName"       name="VendorName"       type="string" />
        <uipath:inputOutput id="Var_CreditScore"      name="CreditScore"      type="number" />
        <uipath:inputOutput id="Var_ApprovalDecision" name="ApprovalDecision" type="boolean" />
        <uipath:inputOutput id="Var_RiskNotes"        name="RiskNotes"        type="string" />
      </uipath:variables>
    </bpmn:extensionElements>

    <!-- Manual start event (none-typed, no trigger) -->
    <bpmn:startEvent id="Start_1" name="Start Vendor Onboarding">
      <bpmn:outgoing>Flow_Start_to_SetContext</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Script task: set vendor context (mock vendor name + credit score) -->
    <bpmn:scriptTask id="Task_SetVendorContext" name="Set Vendor Context" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{}]]></uipath:input>
          <uipath:output name="vendorName"   type="string"  var="Var_VendorName"  source="=result.response.vendorName" />
          <uipath:output name="creditScore"  type="number"  var="Var_CreditScore" source="=result.response.creditScore" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_to_SetContext</bpmn:incoming>
      <bpmn:outgoing>Flow_SetContext_to_Review</bpmn:outgoing>
      <bpmn:script><![CDATA[
return {
  response: {
    vendorName: "Acme Supplies Ltd",
    creditScore: 720
  }
};
]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- HITL user task: compliance officer reviews vendor and records boolean approval -->
    <bpmn:userTask id="Task_ComplianceReview" name="Compliance Officer Review">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Actions.HITL" version="v1" />
          <uipath:context>
            <uipath:input name="appId"       value="vendor-approval-action-app" />
            <uipath:input name="appVersion"  value="1" />
            <uipath:input name="actions"     value="" />
            <uipath:input name="key"         value="" />
            <uipath:input name="taskTitle"   value="Review Vendor for Compliance Approval" />
          </uipath:context>
          <uipath:input name="HitlTaskArguments" type="json" target="bodyField"><![CDATA[{
  "vendorName": "=vars.Var_VendorName",
  "creditScore": "=vars.Var_CreditScore"
}]]></uipath:input>
          <uipath:output name="approvalDecision" type="boolean" var="Var_ApprovalDecision" source="=result.response.approvalDecision" />
          <uipath:output name="riskNotes"         type="string"  var="Var_RiskNotes"        source="=result.response.riskNotes" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_SetContext_to_Review</bpmn:incoming>
      <bpmn:outgoing>Flow_Review_to_Gateway</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Exclusive gateway: branch on boolean approval decision -->
    <bpmn:exclusiveGateway id="Gw_ApprovalDecision" name="Approved?" default="Flow_Reject">
      <bpmn:incoming>Flow_Review_to_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Approve</bpmn:outgoing>
      <bpmn:outgoing>Flow_Reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Onboard vendor step -->
    <bpmn:scriptTask id="Task_OnboardVendor" name="Onboard Vendor" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"vendorName":"=vars.Var_VendorName"}]]></uipath:input>
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Approve</bpmn:incoming>
      <bpmn:outgoing>Flow_Onboard_to_End</bpmn:outgoing>
      <bpmn:script><![CDATA[
return { response: "Vendor " + vendorName + " onboarded successfully." };
]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- Reject vendor step -->
    <bpmn:scriptTask id="Task_RejectVendor" name="Reject Vendor" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"vendorName":"=vars.Var_VendorName"}]]></uipath:input>
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Reject</bpmn:incoming>
      <bpmn:outgoing>Flow_Reject_to_End</bpmn:outgoing>
      <bpmn:script><![CDATA[
return { response: "Vendor " + vendorName + " rejected by compliance officer." };
]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- End events -->
    <bpmn:endEvent id="End_Onboarded" name="Vendor Onboarded">
      <bpmn:incoming>Flow_Onboard_to_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_Rejected" name="Vendor Rejected">
      <bpmn:incoming>Flow_Reject_to_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="Flow_Start_to_SetContext"   sourceRef="Start_1"              targetRef="Task_SetVendorContext" />
    <bpmn:sequenceFlow id="Flow_SetContext_to_Review"  sourceRef="Task_SetVendorContext" targetRef="Task_ComplianceReview" />
    <bpmn:sequenceFlow id="Flow_Review_to_Gateway"     sourceRef="Task_ComplianceReview" targetRef="Gw_ApprovalDecision" />
    <bpmn:sequenceFlow id="Flow_Approve" sourceRef="Gw_ApprovalDecision" targetRef="Task_OnboardVendor">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=vars.Var_ApprovalDecision == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Reject"          sourceRef="Gw_ApprovalDecision" targetRef="Task_RejectVendor" />
    <bpmn:sequenceFlow id="Flow_Onboard_to_End"  sourceRef="Task_OnboardVendor"  targetRef="End_Onboarded" />
    <bpmn:sequenceFlow id="Flow_Reject_to_End"   sourceRef="Task_RejectVendor"   targetRef="End_Rejected" />

  </bpmn:process>

  <!-- Diagram placeholder - will be replaced by generate_diagram.py -->


  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="S_End_Onboarded" bpmnElement="End_Onboarded"><dc:Bounds x="846" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End_Rejected" bpmnElement="End_Rejected"><dc:Bounds x="846" y="166" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Gw_ApprovalDecision" bpmnElement="Gw_ApprovalDecision"><dc:Bounds x="576" y="100" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Start_1" bpmnElement="Start_1"><dc:Bounds x="160" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_ComplianceReview" bpmnElement="Task_ComplianceReview"><dc:Bounds x="416" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_OnboardVendor" bpmnElement="Task_OnboardVendor"><dc:Bounds x="686" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_RejectVendor" bpmnElement="Task_RejectVendor"><dc:Bounds x="686" y="210" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_SetVendorContext" bpmnElement="Task_SetVendorContext"><dc:Bounds x="256" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="E_Flow_Approve" bpmnElement="Flow_Approve"><di:waypoint x="601" y="125" /><di:waypoint x="736" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_Onboard_to_End" bpmnElement="Flow_Onboard_to_End"><di:waypoint x="736" y="140" /><di:waypoint x="864" y="118" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_Reject" bpmnElement="Flow_Reject"><di:waypoint x="601" y="125" /><di:waypoint x="736" y="250" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_Reject_to_End" bpmnElement="Flow_Reject_to_End"><di:waypoint x="736" y="250" /><di:waypoint x="864" y="184" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_Review_to_Gateway" bpmnElement="Flow_Review_to_Gateway"><di:waypoint x="466" y="140" /><di:waypoint x="601" y="125" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_SetContext_to_Review" bpmnElement="Flow_SetContext_to_Review"><di:waypoint x="306" y="140" /><di:waypoint x="466" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_Start_to_SetContext" bpmnElement="Flow_Start_to_SetContext"><di:waypoint x="178" y="118" /><di:waypoint x="306" y="140" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
