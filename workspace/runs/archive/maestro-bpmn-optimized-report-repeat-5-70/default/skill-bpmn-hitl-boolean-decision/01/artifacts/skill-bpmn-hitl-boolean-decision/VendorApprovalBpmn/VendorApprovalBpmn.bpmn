<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_VendorApproval"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="UiPath (https://bpmn.uipath.com)" exporterVersion="1.0">

  <bpmn:process id="Process_VendorApproval" isExecutable="true">

    <!-- Process-level variables (BPMN.Variables pattern) -->
    <bpmn:extensionElements>
      <uipath:migrationVersion version="11.5" />
      <uipath:variables version="v1">
        <uipath:inputOutput id="Var_VendorName"         name="VendorName"         type="string"  />
        <uipath:inputOutput id="Var_CreditScore"        name="CreditScore"        type="number"  />
        <uipath:inputOutput id="Var_ApprovalDecision"   name="ApprovalDecision"   type="boolean" />
        <uipath:inputOutput id="Var_RiskNotes"          name="RiskNotes"          type="string"  />
      </uipath:variables>
    </bpmn:extensionElements>

    <!-- 1. Manual start -->
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- 2. Script task: set vendor context (mock data) -->
    <bpmn:scriptTask id="Task_SetVendorContext" name="Set Vendor Context" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{}]]></uipath:input>
          <uipath:output name="vendorName"   type="string" var="Var_VendorName"   source="=result.response.vendorName"   />
          <uipath:output name="creditScore"  type="number" var="Var_CreditScore"  source="=result.response.creditScore"  />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:script><![CDATA[return { response: { vendorName: "Acme Supplies Ltd", creditScore: 720 } };]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- 3. HITL user task: compliance officer reviews vendor and records approval decision -->
    <bpmn:userTask id="Task_ReviewVendor" name="Review Vendor">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Actions.HITL" version="v1" />
          <uipath:context>
            <uipath:input name="appId"       value="vendor-review-action-app-placeholder" />
            <uipath:input name="appVersion"  value="1" />
            <uipath:input name="actions"     value="Submit" />
            <uipath:input name="key"         value="compliance-dept-folder-placeholder" />
            <uipath:input name="taskTitle"   value="Vendor Compliance Review" />
          </uipath:context>
          <uipath:input name="HitlTaskArguments" type="json" target="bodyField"><![CDATA[{
  "vendorName":  "=vars.Var_VendorName",
  "creditScore": "=vars.Var_CreditScore"
}]]></uipath:input>
          <uipath:output name="approved"   type="boolean" var="Var_ApprovalDecision" source="=result.approved"   />
          <uipath:output name="riskNotes"  type="string"  var="Var_RiskNotes"        source="=result.riskNotes"  />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>

    <!-- 4. Exclusive gateway: branch on boolean approval decision -->
    <bpmn:exclusiveGateway id="Gw_ApprovalDecision" name="Approved?" default="Flow_Rejected">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- 5a. Onboard vendor (approved path) -->
    <bpmn:scriptTask id="Task_OnboardVendor" name="Onboard Vendor" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"vendorName":"=vars.Var_VendorName"}]]></uipath:input>
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:script><![CDATA[return { response: "Vendor " + vendorName + " onboarded successfully." };]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- 5b. Reject vendor (rejected path) -->
    <bpmn:scriptTask id="Task_RejectVendor" name="Reject Vendor" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"vendorName":"=vars.Var_VendorName"}]]></uipath:input>
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Rejected</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:script><![CDATA[return { response: "Vendor " + vendorName + " rejected." };]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- End events -->
    <bpmn:endEvent id="End_Onboarded" name="Vendor Onboarded">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_Rejected" name="Vendor Rejected">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1"       targetRef="Task_SetVendorContext" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_SetVendorContext" targetRef="Task_ReviewVendor" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_ReviewVendor"  targetRef="Gw_ApprovalDecision" />
    <bpmn:sequenceFlow id="Flow_Approved" sourceRef="Gw_ApprovalDecision" targetRef="Task_OnboardVendor">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=vars.Var_ApprovalDecision == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Rejected" sourceRef="Gw_ApprovalDecision" targetRef="Task_RejectVendor" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_OnboardVendor" targetRef="End_Onboarded" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_RejectVendor"  targetRef="End_Rejected" />

  </bpmn:process>


  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_VendorApproval">
      <bpmndi:BPMNShape id="S_End_Onboarded" bpmnElement="End_Onboarded"><dc:Bounds x="846" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End_Rejected" bpmnElement="End_Rejected"><dc:Bounds x="846" y="166" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Gw_ApprovalDecision" bpmnElement="Gw_ApprovalDecision"><dc:Bounds x="576" y="100" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_StartEvent_1" bpmnElement="StartEvent_1"><dc:Bounds x="160" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_OnboardVendor" bpmnElement="Task_OnboardVendor"><dc:Bounds x="686" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_RejectVendor" bpmnElement="Task_RejectVendor"><dc:Bounds x="686" y="210" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_ReviewVendor" bpmnElement="Task_ReviewVendor"><dc:Bounds x="416" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_SetVendorContext" bpmnElement="Task_SetVendorContext"><dc:Bounds x="256" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="E_Flow_1" bpmnElement="Flow_1"><di:waypoint x="178" y="118" /><di:waypoint x="306" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_2" bpmnElement="Flow_2"><di:waypoint x="306" y="140" /><di:waypoint x="466" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_3" bpmnElement="Flow_3"><di:waypoint x="466" y="140" /><di:waypoint x="601" y="125" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_5" bpmnElement="Flow_5"><di:waypoint x="736" y="140" /><di:waypoint x="864" y="118" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_6" bpmnElement="Flow_6"><di:waypoint x="736" y="250" /><di:waypoint x="864" y="184" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_Approved" bpmnElement="Flow_Approved"><di:waypoint x="601" y="125" /><di:waypoint x="736" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_Rejected" bpmnElement="Flow_Rejected"><di:waypoint x="601" y="125" /><di:waypoint x="736" y="250" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
