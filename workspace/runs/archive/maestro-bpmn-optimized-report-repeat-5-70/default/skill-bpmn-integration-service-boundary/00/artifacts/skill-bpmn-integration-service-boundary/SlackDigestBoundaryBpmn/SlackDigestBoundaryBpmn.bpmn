<?xml version="1.0" encoding="UTF-8"?>
<!--
  SlackDigestBoundaryBpmn
  Status: LOCAL DRAFT - NOT ready for upload or run.

  ENRICHMENT BLOCKERS (CLI-owned - must be resolved before packaging or upload):
    1. Slack connector resource key: run "uip maestro bpmn registry get Intsvc.ActivityExecution"
       after login to identify the correct Slack connector key from the IS catalog.
    2. Connection ID: run "uip is connections list" to find the live Slack connection id.
    3. Connection binding: the bindings block below uses PLACEHOLDER_BINDING_ID and
       PLACEHOLDER_CONNECTION_ID - replace via CLI enrichment, never by hand.
    4. Connector operation metadata: activity, method, path, and body schema for the
       Slack "Send Message" operation come from the IS catalog enrichment response
       (registry get with connection-id and object-name flags).
    5. Dynamic output schema: the uipath:output type and var mapping for the Slack
       response are dynamic and must be generated by CLI enrichment.
    6. bindings_v2.json: must be generated by "scripts/scaffold_metadata.py" then
       enriched by the CLI pack toolchain before packaging.
    7. Package metadata: project.uiproj, operate.json, entry-points.json, and
       package-descriptor.json are generated by scaffold_metadata.py; do not
       hand-author them.

  See DRAFT_NOTES.md for the full blocker checklist.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_SlackDigest"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="UiPath (https://bpmn.uipath.com)" exporterVersion="1.0">

  <bpmn:process id="Process_SlackDigest" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:migrationVersion version="11.5" />

      <!--
        Process-level variables.
        DigestContent   : string  - the formatted digest text assembled by Task_PrepareDigest.
        SlackChannel    : string  - target Slack channel id or name (set at runtime or by caller).
        SlackResult     : object  - placeholder for the IS connector response; populated only
                                    after CLI enrichment resolves the dynamic output schema.
      -->
      <uipath:variables version="v1">
        <uipath:inputOutput id="Var_DigestContent" name="DigestContent" type="string" />
        <uipath:inputOutput id="Var_SlackChannel"  name="SlackChannel"  type="string" />
        <uipath:inputOutput id="Var_SlackResult"   name="SlackResult"   type="object" />
      </uipath:variables>

      <!--
        Connection binding block.
        PLACEHOLDER_BINDING_ID and PLACEHOLDER_CONNECTION_ID must be replaced by
        CLI enrichment ("uip is connections list" + "uip maestro bpmn registry get
        Intsvc.ActivityExecution" with the resolved connection id and object name).
        Do not invent or guess these values.
      -->
      <uipath:bindings version="v1">
        <uipath:binding
            id="PLACEHOLDER_BINDING_ID"
            resource="Connection"
            propertyAttribute="ConnectionId"
            default="PLACEHOLDER_CONNECTION_ID" />
      </uipath:bindings>
    </bpmn:extensionElements>

    <!-- ═══════════════════════════════════════════════════
         START - Manual (none-type start event = manual trigger)
         Entry point: entryPointId lets scaffold_metadata.py
         generate the entry-points.json entry for this process.
    ════════════════════════════════════════════════════ -->
    <bpmn:startEvent id="Start_Manual" name="Manual Start">
      <bpmn:extensionElements>
        <uipath:entryPointId value="ep_SlackDigest" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.Variables" version="v1" />
          <!--
            Input variables available at manual start.
            SlackChannel may be supplied by the caller at trigger time.
          -->
          <uipath:input name="SlackChannel" type="string" var="Var_SlackChannel" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_StartToPrep</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- ═══════════════════════════════════════════════════
         TASK 1 - Prepare Digest (ScriptTask / Jint)
         Assembles the digest text and writes it to DigestContent.
         Runs fully under the Jint runtime; no external calls.
    ════════════════════════════════════════════════════ -->
    <bpmn:scriptTask id="Task_PrepareDigest" name="Prepare Digest" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <!--
            args input: reads SlackChannel so the script can embed it in the digest header.
            Extend this JSON to pass additional data sources once connected.
          -->
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"slackChannel":"=vars.Var_SlackChannel"}]]></uipath:input>
          <!--
            Output: writes the assembled digest string back to Var_DigestContent.
            source="=result.response" reads the value returned by the script below.
          -->
          <uipath:output name="digestContent" type="string" var="Var_DigestContent" source="=result.response" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_StartToPrep</bpmn:incoming>
      <bpmn:outgoing>Flow_PrepToSlack</bpmn:outgoing>
      <bpmn:script><![CDATA[
// Build a simple digest payload.
// Replace this stub with real aggregation logic before production use.
var header = "Daily Digest";
if (slackChannel) { header = header + " for " + slackChannel; }
var body = header + "\n- Item 1: placeholder\n- Item 2: placeholder";
return { response: body };
]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- ═══════════════════════════════════════════════════
         TASK 2 - Send Slack Digest (Integration Service boundary)

         HOST ELEMENT:  bpmn:SendTask  (Intsvc.ActivityExecution canonical element)
         TEMPLATE:      Intsvc.ActivityExecution (from registry get)
         STATUS:        DRAFT - all context fields below are PLACEHOLDERS.

         CLI-owned enrichment required before this node is executable:
           a) connectorKey   - Slack connector resource key from IS catalog
                               (registry get after login, never guessed from brand name)
           b) bindingId      - matches the uipath:binding id in the bindings block above
                               (populated by CLI enrichment)
           c) connection     - resolved to =bindings.<bindingId> after enrichment
           d) folderKey      - resolved from "uip is connections list" folder path
           e) activity       - Slack operation name (e.g. "PostMessage") from IS catalog
           f) method/path    - HTTP method and path from connector catalog operation spec
           g) body CDATA     - request schema fields (channel, text, etc.) from IS enrichment
           h) output var/type- dynamic; generated by CLI enrichment from connector response schema

         Do NOT hand-fill connectorKey, folderKey, activity, method, path, body,
         or output schema. These are emitted by the CLI enrichment step.
    ════════════════════════════════════════════════════ -->
    <bpmn:sendTask id="Task_SendSlack" name="Send Slack Digest">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Intsvc.ActivityExecution" version="v1" />
          <uipath:context>
            <!--
              All values below are PLACEHOLDER strings.
              Replace via CLI: uip maestro bpmn registry get Intsvc.ActivityExecution
                               then with connection-id and object-name flags after discovery.
              Rule: never invent connector resource keys, folder keys, or operation names.
            -->
            <uipath:input name="activity"     value="PLACEHOLDER_SLACK_OPERATION" />
            <uipath:input name="connectorKey" value="PLACEHOLDER_CONNECTOR_KEY" />
            <uipath:input name="connection"   value="=bindings.PLACEHOLDER_BINDING_ID" />
            <uipath:input name="folderKey"    value="PLACEHOLDER_FOLDER_KEY" />
            <uipath:input name="method"       value="PLACEHOLDER_HTTP_METHOD" />
            <uipath:input name="path"         value="PLACEHOLDER_API_PATH" />
          </uipath:context>
          <!--
            body: the request payload schema is dynamic and IS-catalog-owned.
            The CDATA below is the minimal stub the registry template emits.
            CLI enrichment populates the real field map (channel, text, blocks, etc.)
            after resolving the connector operation with object-name and connection-id.
            DigestContent is pre-mapped here so the intent is traceable, but the
            field name ("text") is also a placeholder - validate against IS catalog.
          -->
          <uipath:input name="body" type="json" target="body"><![CDATA[{"channel":"=vars.Var_SlackChannel","text":"=vars.Var_DigestContent"}]]></uipath:input>
          <!--
            output: type="custom" and source="." are the IS-execution defaults from the
            registry template. The actual response schema (fields, types) is dynamic and
            generated by CLI enrichment. Var_SlackResult is declared above as object;
            its real shape becomes known only after enrichment.
          -->
          <uipath:output name="result" type="custom" source="." var="Var_SlackResult" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PrepToSlack</bpmn:incoming>
      <bpmn:outgoing>Flow_SlackToEnd</bpmn:outgoing>
    </bpmn:sendTask>

    <!-- ═══════════════════════════════════════════════════
         END EVENT
    ════════════════════════════════════════════════════ -->
    <bpmn:endEvent id="End_Done" name="Done">
      <bpmn:incoming>Flow_SlackToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="Flow_StartToPrep" sourceRef="Start_Manual"      targetRef="Task_PrepareDigest" />
    <bpmn:sequenceFlow id="Flow_PrepToSlack" sourceRef="Task_PrepareDigest" targetRef="Task_SendSlack"    />
    <bpmn:sequenceFlow id="Flow_SlackToEnd"  sourceRef="Task_SendSlack"     targetRef="End_Done"          />

  </bpmn:process>

  <!-- ═══════════════════════════════════════════════════
       BPMN Diagram Interchange
       Left-to-right linear layout.
       Sizes: events 36x36, tasks 120x80, end event 36x36.
       Horizontal spacing: 50px between nodes.
  ════════════════════════════════════════════════════ -->
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_SlackDigest">

      <!-- Start: Manual Start (160, 92) -->
      <bpmndi:BPMNShape id="S_Start_Manual" bpmnElement="Start_Manual">
        <dc:Bounds x="160" y="92" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Task: Prepare Digest (246, 70) -->
      <bpmndi:BPMNShape id="S_Task_PrepareDigest" bpmnElement="Task_PrepareDigest">
        <dc:Bounds x="246" y="70" width="120" height="80" />
      </bpmndi:BPMNShape>

      <!-- Task: Send Slack Digest (416, 70) -->
      <bpmndi:BPMNShape id="S_Task_SendSlack" bpmnElement="Task_SendSlack">
        <dc:Bounds x="416" y="70" width="120" height="80" />
      </bpmndi:BPMNShape>

      <!-- End: Done (586, 92) -->
      <bpmndi:BPMNShape id="S_End_Done" bpmnElement="End_Done">
        <dc:Bounds x="586" y="92" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Flow_StartToPrep: Start_Manual -> Task_PrepareDigest -->
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_StartToPrep" bpmnElement="Flow_StartToPrep">
        <di:waypoint x="196" y="110" />
        <di:waypoint x="246" y="110" />
      </bpmndi:BPMNEdge>

      <!-- Flow_PrepToSlack: Task_PrepareDigest -> Task_SendSlack -->
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_PrepToSlack" bpmnElement="Flow_PrepToSlack">
        <di:waypoint x="366" y="110" />
        <di:waypoint x="416" y="110" />
      </bpmndi:BPMNEdge>

      <!-- Flow_SlackToEnd: Task_SendSlack -> End_Done -->
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_SlackToEnd" bpmnElement="Flow_SlackToEnd">
        <di:waypoint x="536" y="110" />
        <di:waypoint x="586" y="110" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
