<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_SlackDigest"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="UiPath (https://bpmn.uipath.com)"
    exporterVersion="1.0">

  <bpmn:process id="Process_SlackDigest" isExecutable="true">

    <bpmn:extensionElements>
      <uipath:migrationVersion version="11.5" />

      <!-- Process variables.
           DigestText: plain-text digest body assembled by PrepareDigest.
           SlackResult: IS connector response placeholder (output schema is CLI-generated). -->
      <uipath:variables version="v1">
        <uipath:inputOutput id="Var_DigestText"  name="DigestText"  type="string" />
        <uipath:inputOutput id="Var_SlackResult" name="SlackResult" type="object" />
      </uipath:variables>

      <!-- Connection binding shell (DRAFT).
           The ConnectionId default is intentionally empty.
           It must be populated by CLI enrichment: run
           "uip is connections list" with the all-folders flag,
           then "uip maestro bpmn registry get Intsvc.ActivityExecution"
           with the chosen connection-id and object-name flags.
           Do NOT hand-author a connection ID. -->
      <uipath:bindings version="v1">
        <uipath:binding
            id="Binding_SlackConn"
            resource="Connection"
            propertyAttribute="ConnectionId"
            default="" />
      </uipath:bindings>

    </bpmn:extensionElements>

    <!-- START EVENT: manual none-trigger (canvas blank start).
         The entryPointId element is read by scaffold_metadata.py
         to generate entry-points.json. -->
    <bpmn:startEvent id="Start_Manual" name="Start">
      <bpmn:extensionElements>
        <uipath:entryPointId value="EP_SlackDigest" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_StartToPrep</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- TASK 1: PrepareDigest (BPMN.ScriptTask).
         Template source: registry get BPMN.ScriptTask.
         Assembles digest text; writes result to Var_DigestText
         for use by the downstream IS connector task. -->
    <bpmn:scriptTask id="Task_PrepareDigest" name="Prepare Digest" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{}]]></uipath:input>
          <uipath:output name="digestText" type="string" var="Var_DigestText" source="=result.response" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_StartToPrep</bpmn:incoming>
      <bpmn:outgoing>Flow_PrepToSlack</bpmn:outgoing>
      <bpmn:script><![CDATA[
var lines = [
  "Daily Digest",
  "Date: " + new Date().toISOString().slice(0, 10),
  "Items processed: 0  (populate via input variables)"
];
return { response: lines.join("\n") };
]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- TASK 2: SendSlackDigest (Intsvc.ActivityExecution) - STATUS: DRAFT.
         Template source: registry get Intsvc.ActivityExecution.
         BpmnElement: bpmn:SendTask (per registry, RequiresDiscovery=true, IsDynamic=true).

         This node is a draft executable boundary.
         The correct structural shape from the registry template is present.
         The following context fields and artifacts are CLI-owned enrichment
         and MUST NOT be hand-authored:
           activity     : connector operation name (from object-name enrichment)
           connectorKey : Slack connector resource key (from registry discovery)
           folderKey    : Orchestrator folder key (from connection discovery)
           method/path  : HTTP operation metadata (from object-name enrichment)
           body CDATA   : dynamic input schema (generated by CLI enrichment)
           SlackResult schema: generated output schema (from CLI enrichment)
           bindings_v2.json resources array: populated by CLI pack step
         All placeholder values are empty strings to make the boundary explicit. -->
    <bpmn:sendTask id="Task_SendSlack" name="Send Slack Digest">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Intsvc.ActivityExecution" version="v1" />
          <uipath:context>
            <!-- activity: connector operation name; CLI-owned.
                 Sentinel value marks this field as requiring CLI enrichment.
                 Replace via: registry get Intsvc.ActivityExecution
                 with the connection-id and object-name arguments. -->
            <uipath:input name="activity"     value="DRAFT_PENDING_CLI_ENRICHMENT" />
            <!-- connectorKey: Slack connector resource key; CLI-owned, empty in draft -->
            <uipath:input name="connectorKey" value="" />
            <!-- connection: references the binding shell declared above -->
            <uipath:input name="connection"   value="=bindings.Binding_SlackConn" />
            <!-- folderKey: Orchestrator folder key; CLI-owned, empty in draft -->
            <uipath:input name="folderKey"    value="" />
            <!-- method: HTTP method; CLI-owned, empty in draft -->
            <uipath:input name="method"       value="" />
            <!-- path: HTTP path; CLI-owned, empty in draft -->
            <uipath:input name="path"         value="" />
          </uipath:context>
          <!-- body: dynamic input schema generated by CLI enrichment.
               Empty object placeholder; real fields (channel, text, etc.)
               are generated when registry get is run with connection-id
               and object-name arguments. -->
          <uipath:input name="body" type="json" target="body"><![CDATA[{}]]></uipath:input>
          <!-- output: var points to Var_SlackResult.
               source "." and type "custom" match the registry template.
               Concrete output schema is CLI-generated. -->
          <uipath:output name="result" type="custom" source="." var="Var_SlackResult" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PrepToSlack</bpmn:incoming>
      <bpmn:outgoing>Flow_SlackToEnd</bpmn:outgoing>
    </bpmn:sendTask>

    <!-- END EVENT -->
    <bpmn:endEvent id="End_1" name="End">
      <bpmn:incoming>Flow_SlackToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- SEQUENCE FLOWS -->
    <bpmn:sequenceFlow id="Flow_StartToPrep" sourceRef="Start_Manual"      targetRef="Task_PrepareDigest" />
    <bpmn:sequenceFlow id="Flow_PrepToSlack" sourceRef="Task_PrepareDigest" targetRef="Task_SendSlack"    />
    <bpmn:sequenceFlow id="Flow_SlackToEnd"  sourceRef="Task_SendSlack"     targetRef="End_1"             />

  </bpmn:process>

  <!-- DIAGRAM: left-to-right layout.
       Tasks 100x80, events 36x36.  Generated by generate_diagram.py. -->


  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_SlackDigest">
      <bpmndi:BPMNShape id="S_End_1" bpmnElement="End_1"><dc:Bounds x="576" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Start_Manual" bpmnElement="Start_Manual"><dc:Bounds x="160" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_PrepareDigest" bpmnElement="Task_PrepareDigest"><dc:Bounds x="256" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_SendSlack" bpmnElement="Task_SendSlack"><dc:Bounds x="416" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="E_Flow_PrepToSlack" bpmnElement="Flow_PrepToSlack"><di:waypoint x="306" y="140" /><di:waypoint x="466" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_SlackToEnd" bpmnElement="Flow_SlackToEnd"><di:waypoint x="466" y="140" /><di:waypoint x="594" y="118" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_StartToPrep" bpmnElement="Flow_StartToPrep"><di:waypoint x="178" y="118" /><di:waypoint x="306" y="140" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
