<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="UiPath (https://bpmn.uipath.com)" exporterVersion="1.0">

  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:migrationVersion version="11.5" />
      <uipath:variables version="v1">
        <!--
          ApprovalOutcome  - populated by the HITL task (Actions.HITL output).
          ProvisioningResult - populated by the RPA job (Orchestrator.StartJob output).
        -->
        <uipath:inputOutput id="Var_ApprovalOutcome"    name="ApprovalOutcome"    type="object" />
        <uipath:inputOutput id="Var_ProvisioningResult" name="ProvisioningResult" type="object" />
      </uipath:variables>
    </bpmn:extensionElements>

    <!-- ═══════════════════════════════════════════════════════════
         Entry point: manual (none) start event
         uipath:entryPointId enables this process to appear as a
         launchable entry point in the Maestro portal.
         ═══════════════════════════════════════════════════════════ -->
    <bpmn:startEvent id="StartEvent_1" name="Employee Access Request">
      <bpmn:extensionElements>
        <uipath:entryPointId value="ep_EmployeeAccessRequest" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- ═══════════════════════════════════════════════════════════
         HITL Approval — bpmn:userTask
         Registry type : Actions.HITL  (uipath:activity shell)
         Label         : "Create action app task"
         Context inputs use synthetic placeholder values only.
         appId / key are left empty — no real app IDs or folder keys.
         taskTitle is the only visible field set here.
         ═══════════════════════════════════════════════════════════ -->
    <bpmn:userTask id="Task_ApprovalHITL" name="Approve Employee Access">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Actions.HITL" version="v1" />
          <uipath:context>
            <!-- appId: synthetic placeholder — replace with real Action App ID before deploy -->
            <uipath:input name="appId"       value="placeholder-app-id" />
            <!-- appVersion: synthetic placeholder -->
            <uipath:input name="appVersion"  value="1" />
            <!-- actions: comma-separated action names exposed by the app task -->
            <uipath:input name="actions"     value="Approve,Reject" />
            <!-- key (folderKey): synthetic placeholder — no real folder key -->
            <uipath:input name="key"         value="placeholder-folder-key" />
            <!-- taskTitle: human-readable title shown in the action centre -->
            <uipath:input name="taskTitle"   value="Review employee access request" />
          </uipath:context>
          <!-- Input body: JSON payload forwarded to the action app form (empty shell) -->
          <uipath:input name="HitlTaskArguments" type="json" target="bodyField"><![CDATA[{}]]></uipath:input>
          <!-- Output: the completed task result stored in Var_ApprovalOutcome -->
          <uipath:output name="Process response" type="Actions.HITL" var="Var_ApprovalOutcome" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- ═══════════════════════════════════════════════════════════
         RPA Provisioning — bpmn:serviceTask
         Registry type : Orchestrator.StartJob  (uipath:activity shell)
         Label         : "Start and wait for RPA workflow"
         Context inputs use synthetic placeholder values only.
         releaseKey / folderId / folderPath are placeholders.
         name is the friendly display name of the job trigger.
         ═══════════════════════════════════════════════════════════ -->
    <bpmn:serviceTask id="Task_ProvisioningRPA" name="Provision System Access">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.StartJob" version="v1" />
          <uipath:context>
            <!-- releaseKey: synthetic placeholder — replace with real process release key -->
            <uipath:input name="releaseKey"  value="placeholder-release-key" />
            <!-- folderId: synthetic placeholder — no real folder ID -->
            <uipath:input name="folderId"    value="" />
            <!-- folderPath: synthetic placeholder — no real folder path -->
            <uipath:input name="folderPath"  value="placeholder-orchestrator-folder" />
            <!-- name: friendly name used in Orchestrator job list -->
            <uipath:input name="name"        value="ProvisionEmployeeAccess" />
          </uipath:context>
          <!-- Input body: JSON arguments forwarded to the RPA process (empty shell) -->
          <uipath:input name="JobArguments" type="json" target="bodyField"><![CDATA[{}]]></uipath:input>
          <!-- Output: job execution result stored in Var_ProvisioningResult -->
          <uipath:output name="Process response" type="Orchestrator.RunJob" var="Var_ProvisioningResult" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- ═══════════════════════════════════════════════════════════
         End event (none)
         ═══════════════════════════════════════════════════════════ -->
    <bpmn:endEvent id="EndEvent_1" name="Access Provisioned">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1"     targetRef="Task_ApprovalHITL"   />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_ApprovalHITL"  targetRef="Task_ProvisioningRPA" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_ProvisioningRPA" targetRef="EndEvent_1"         />

  </bpmn:process>

  <!-- ═══════════════════════════════════════════════════════════════
       BPMN Diagram Interchange
       Left-to-right linear layout.
         StartEvent  x=160  y=100  (36x36)  centre=(178,118)
         UserTask    x=260  y=78   (100x80) centre=(310,118)
         ServiceTask x=420  y=78   (100x80) centre=(470,118)
         EndEvent    x=580  y=100  (36x36)  centre=(598,118)
       ═══════════════════════════════════════════════════════════════ -->
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_1">

      <bpmndi:BPMNShape id="S_StartEvent_1" bpmnElement="StartEvent_1">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_Task_ApprovalHITL" bpmnElement="Task_ApprovalHITL">
        <dc:Bounds x="260" y="78" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_Task_ProvisioningRPA" bpmnElement="Task_ProvisioningRPA">
        <dc:Bounds x="420" y="78" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_EndEvent_1" bpmnElement="EndEvent_1">
        <dc:Bounds x="580" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Flow_1: StartEvent_1 -> Task_ApprovalHITL -->
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="196" y="118" />
        <di:waypoint x="260" y="118" />
      </bpmndi:BPMNEdge>

      <!-- Flow_2: Task_ApprovalHITL -> Task_ProvisioningRPA -->
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="360" y="118" />
        <di:waypoint x="420" y="118" />
      </bpmndi:BPMNEdge>

      <!-- Flow_3: Task_ProvisioningRPA -> EndEvent_1 -->
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_3" bpmnElement="Flow_3">
        <di:waypoint x="520" y="118" />
        <di:waypoint x="580" y="118" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
