<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="UiPath (https://bpmn.uipath.com)" exporterVersion="1.0">

  <bpmn:error id="Error_SyncFailure" name="SyncFailure" errorCode="SYNC_FAILURE" />

  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:migrationVersion version="11.5" />
      <uipath:variables version="v1">
        <!-- Start-event scoped inputs -->
        <uipath:input id="Var_CustomerId" name="customerId" type="string" elementId="Start_ManualTrigger" />
        <uipath:input id="Var_RequestedBy" name="requestedBy" type="string" elementId="Start_ManualTrigger" />
        <!-- Process-level working variables -->
        <uipath:inputOutput id="Var_Request" name="request" type="object" />
        <uipath:inputOutput id="Var_InvocationId" name="invocationId" type="string" />
        <uipath:inputOutput id="Var_SyncStatus" name="syncStatus" type="string" />
        <uipath:inputOutput id="Var_SyncResult" name="syncResult" type="object" />
      </uipath:variables>
    </bpmn:extensionElements>

    <!-- Start event -->
    <bpmn:startEvent id="Start_ManualTrigger" name="Customer Sync Request">
      <bpmn:extensionElements>
        <uipath:entryPointId value="ep_customer_sync" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_StartToTask</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Service task: Run Customer Sync API Workflow -->
    <bpmn:serviceTask id="Task_RunCustomerSyncApiWorkflow" name="Run Customer Sync API Workflow">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.ExecuteApiWorkflowAsync" version="v1" />
          <uipath:context>
            <uipath:input name="releaseKey" value="" />
            <uipath:input name="folderId" value="" />
            <uipath:input name="folderPath" value="" />
            <uipath:input name="name" value="" />
          </uipath:context>
          <uipath:input name="JobArguments" type="json" target="bodyField"><![CDATA[{"customerId":"=vars.Var_CustomerId","requestedBy":"=vars.Var_RequestedBy","request":"=vars.Var_Request"}]]></uipath:input>
          <uipath:output name="Process response" type="Orchestrator.RunJob" var="Var_SyncResult" />
          <uipath:output name="invocationId" type="string" var="Var_InvocationId" source="=result.invocationId" />
          <uipath:output name="syncStatus" type="string" var="Var_SyncStatus" source="=result.status" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_StartToTask</bpmn:incoming>
      <bpmn:outgoing>Flow_TaskToSuccess</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Boundary error event on the service task -->
    <bpmn:boundaryEvent id="Boundary_SyncError" attachedToRef="Task_RunCustomerSyncApiWorkflow" cancelActivity="true">
      <bpmn:errorEventDefinition errorRef="Error_SyncFailure" />
      <bpmn:outgoing>Flow_ErrorToFailEnd</bpmn:outgoing>
    </bpmn:boundaryEvent>

    <!-- Success end event -->
    <bpmn:endEvent id="End_Success" name="Sync Completed">
      <bpmn:incoming>Flow_TaskToSuccess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Failure end event -->
    <bpmn:endEvent id="End_Failure" name="Sync Failed">
      <bpmn:errorEventDefinition errorRef="Error_SyncFailure" />
      <bpmn:incoming>Flow_ErrorToFailEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="Flow_StartToTask" sourceRef="Start_ManualTrigger" targetRef="Task_RunCustomerSyncApiWorkflow" />
    <bpmn:sequenceFlow id="Flow_TaskToSuccess" sourceRef="Task_RunCustomerSyncApiWorkflow" targetRef="End_Success" />
    <bpmn:sequenceFlow id="Flow_ErrorToFailEnd" sourceRef="Boundary_SyncError" targetRef="End_Failure" />
  </bpmn:process>


  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="S_Boundary_SyncError" bpmnElement="Boundary_SyncError"><dc:Bounds x="512" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End_Failure" bpmnElement="End_Failure"><dc:Bounds x="608" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End_Success" bpmnElement="End_Success"><dc:Bounds x="416" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Start_ManualTrigger" bpmnElement="Start_ManualTrigger"><dc:Bounds x="160" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_RunCustomerSyncApiWorkflow" bpmnElement="Task_RunCustomerSyncApiWorkflow"><dc:Bounds x="256" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="E_Flow_ErrorToFailEnd" bpmnElement="Flow_ErrorToFailEnd"><di:waypoint x="530" y="118" /><di:waypoint x="626" y="118" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_StartToTask" bpmnElement="Flow_StartToTask"><di:waypoint x="178" y="118" /><di:waypoint x="306" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_TaskToSuccess" bpmnElement="Flow_TaskToSuccess"><di:waypoint x="306" y="140" /><di:waypoint x="434" y="118" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
