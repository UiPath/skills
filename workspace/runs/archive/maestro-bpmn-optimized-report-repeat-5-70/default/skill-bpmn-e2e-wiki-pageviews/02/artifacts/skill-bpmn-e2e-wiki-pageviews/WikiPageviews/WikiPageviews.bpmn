<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="UiPath (https://bpmn.uipath.com)" exporterVersion="1.0">

  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:migrationVersion version="11.5" />
      <uipath:variables version="v1">
        <!-- Input variables scoped to the start event -->
        <uipath:input id="Var_article" name="article" type="string" elementId="Start_Manual" />
        <uipath:input id="Var_date1" name="date1" type="string" elementId="Start_Manual" />
        <uipath:input id="Var_date2" name="date2" type="string" elementId="Start_Manual" />
        <!-- Process-wide working variables -->
        <uipath:inputOutput id="Var_valid" name="valid" type="boolean" />
        <uipath:inputOutput id="Var_dailyRecords" name="dailyRecords" type="array" />
        <uipath:inputOutput id="Var_filteredRecords" name="filteredRecords" type="array" />
        <uipath:inputOutput id="Var_notFoundMsg" name="notFoundMsg" type="string" />
        <!-- Output variable -->
        <uipath:output id="Var_total" name="total" type="number" />
      </uipath:variables>
    </bpmn:extensionElements>

    <!-- Start event -->
    <bpmn:startEvent id="Start_Manual" name="Start">
      <bpmn:extensionElements>
        <uipath:entryPointId value="EP_WikiPageviews" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.Variables" version="v1" />
          <uipath:input name="article" type="string" var="Var_article" source="=vars.Var_article" />
          <uipath:input name="date1" type="string" var="Var_date1" source="=vars.Var_date1" />
          <uipath:input name="date2" type="string" var="Var_date2" source="=vars.Var_date2" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_StartToFetch</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Script task: fetchPageviews -->
    <bpmn:scriptTask id="Task_fetchPageviews" name="fetchPageviews" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"article":"=vars.Var_article","date1":"=vars.Var_date1","date2":"=vars.Var_date2"}]]></uipath:input>
          <uipath:output name="valid" type="boolean" var="Var_valid" source="=result.response.valid" />
          <uipath:output name="dailyRecords" type="array" var="Var_dailyRecords" source="=result.response.dailyRecords" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_StartToFetch</bpmn:incoming>
      <bpmn:outgoing>Flow_FetchToGw</bpmn:outgoing>
      <bpmn:script><![CDATA[
var knownArticles = ["Earth", "Mars", "Jupiter", "Saturn", "Sun", "Moon"];
var isValid = knownArticles.indexOf(article) >= 0;
if (!isValid) {
  return { response: { valid: false, dailyRecords: [] } };
}
var records = [];
var d1 = new Date(date1);
var d2 = new Date(date2);
var seed = 0;
for (var n = 0; n < article.length; n++) { seed += article.charCodeAt(n); }
var cur = new Date(d1.getTime());
while (cur <= d2) {
  var mm = cur.getMonth() + 1;
  var dd = cur.getDate();
  var dateStr = cur.getFullYear() + "-" + (mm < 10 ? "0" : "") + mm + "-" + (dd < 10 ? "0" : "") + dd;
  seed = (seed * 1664525 + 1013904223) & 0x7fffffff;
  var views = (seed % 1500) + 100;
  records.push({ date: dateStr, views: views });
  cur.setDate(cur.getDate() + 1);
}
return { response: { valid: true, dailyRecords: records } };
]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- Exclusive gateway: route on valid -->
    <bpmn:exclusiveGateway id="Gw_ValidCheck" name="valid?" default="Flow_GwToFilter">
      <bpmn:incoming>Flow_FetchToGw</bpmn:incoming>
      <bpmn:outgoing>Flow_GwToNotFound</bpmn:outgoing>
      <bpmn:outgoing>Flow_GwToFilter</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Invalid path: end event returning "Article not found" -->
    <bpmn:endEvent id="End_NotFound" name="Article not found">
      <bpmn:extensionElements>
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.Variables" version="v1" />
          <uipath:output name="notFoundMsg" type="string" var="Var_notFoundMsg" source="Article not found" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_GwToNotFound</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Script task: filterHighTraffic -->
    <bpmn:scriptTask id="Task_filterHighTraffic" name="filterHighTraffic" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"dailyRecords":"=vars.Var_dailyRecords"}]]></uipath:input>
          <uipath:output name="filteredRecords" type="array" var="Var_filteredRecords" source="=result.response" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_GwToFilter</bpmn:incoming>
      <bpmn:outgoing>Flow_FilterToAggregate</bpmn:outgoing>
      <bpmn:script><![CDATA[
var filtered = [];
for (var i = 0; i < dailyRecords.length; i++) {
  if (dailyRecords[i].views > 500) {
    filtered.push(dailyRecords[i]);
  }
}
return { response: filtered };
]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- Script task: aggregateTotal -->
    <bpmn:scriptTask id="Task_aggregateTotal" name="aggregateTotal" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"filteredRecords":"=vars.Var_filteredRecords"}]]></uipath:input>
          <uipath:output name="total" type="number" var="Var_total" source="=result.response" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_FilterToAggregate</bpmn:incoming>
      <bpmn:outgoing>Flow_AggregateToEnd</bpmn:outgoing>
      <bpmn:script><![CDATA[
var sum = 0;
for (var i = 0; i < filteredRecords.length; i++) {
  sum += filteredRecords[i].views;
}
return { response: sum };
]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- Valid path end event -->
    <bpmn:endEvent id="End_Success" name="Done">
      <bpmn:extensionElements>
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.Variables" version="v1" />
          <uipath:output name="total" type="number" var="Var_total" source="=vars.Var_total" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AggregateToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="Flow_StartToFetch" sourceRef="Start_Manual" targetRef="Task_fetchPageviews" />
    <bpmn:sequenceFlow id="Flow_FetchToGw" sourceRef="Task_fetchPageviews" targetRef="Gw_ValidCheck" />
    <bpmn:sequenceFlow id="Flow_GwToNotFound" sourceRef="Gw_ValidCheck" targetRef="End_NotFound">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=vars.Var_valid == false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_GwToFilter" sourceRef="Gw_ValidCheck" targetRef="Task_filterHighTraffic" />
    <bpmn:sequenceFlow id="Flow_FilterToAggregate" sourceRef="Task_filterHighTraffic" targetRef="Task_aggregateTotal" />
    <bpmn:sequenceFlow id="Flow_AggregateToEnd" sourceRef="Task_aggregateTotal" targetRef="End_Success" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_1">
      <!-- Start -->
      <bpmndi:BPMNShape id="S_Start_Manual" bpmnElement="Start_Manual">
        <dc:Bounds x="160" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <!-- fetchPageviews -->
      <bpmndi:BPMNShape id="S_Task_fetchPageviews" bpmnElement="Task_fetchPageviews">
        <dc:Bounds x="250" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <!-- Gateway -->
      <bpmndi:BPMNShape id="S_Gw_ValidCheck" bpmnElement="Gw_ValidCheck" isMarkerVisible="true">
        <dc:Bounds x="410" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <!-- Not-found end event (upper branch) -->
      <bpmndi:BPMNShape id="S_End_NotFound" bpmnElement="End_NotFound">
        <dc:Bounds x="530" y="82" width="36" height="36" />
      </bpmndi:BPMNShape>
      <!-- filterHighTraffic -->
      <bpmndi:BPMNShape id="S_Task_filterHighTraffic" bpmnElement="Task_filterHighTraffic">
        <dc:Bounds x="520" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>
      <!-- aggregateTotal -->
      <bpmndi:BPMNShape id="S_Task_aggregateTotal" bpmnElement="Task_aggregateTotal">
        <dc:Bounds x="680" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>
      <!-- Success end event -->
      <bpmndi:BPMNShape id="S_End_Success" bpmnElement="End_Success">
        <dc:Bounds x="842" y="282" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Edges -->
      <bpmndi:BPMNEdge id="E_StartToFetch" bpmnElement="Flow_StartToFetch">
        <di:waypoint x="196" y="200" />
        <di:waypoint x="250" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_FetchToGw" bpmnElement="Flow_FetchToGw">
        <di:waypoint x="350" y="200" />
        <di:waypoint x="410" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_GwToNotFound" bpmnElement="Flow_GwToNotFound">
        <di:waypoint x="435" y="175" />
        <di:waypoint x="435" y="100" />
        <di:waypoint x="530" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_GwToFilter" bpmnElement="Flow_GwToFilter">
        <di:waypoint x="435" y="225" />
        <di:waypoint x="435" y="300" />
        <di:waypoint x="520" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_FilterToAggregate" bpmnElement="Flow_FilterToAggregate">
        <di:waypoint x="620" y="300" />
        <di:waypoint x="680" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_AggregateToEnd" bpmnElement="Flow_AggregateToEnd">
        <di:waypoint x="780" y="300" />
        <di:waypoint x="842" y="300" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
