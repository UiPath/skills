<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="UiPath (https://bpmn.uipath.com)" exporterVersion="1.0">

  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:migrationVersion version="11.5" />
      <uipath:variables version="v1">
        <uipath:inputOutput id="Var_article"   name="article"   type="string"  elementId="Start_1" />
        <uipath:inputOutput id="Var_date1"     name="date1"     type="string"  elementId="Start_1" />
        <uipath:inputOutput id="Var_date2"     name="date2"     type="string"  elementId="Start_1" />
        <uipath:inputOutput id="Var_total"     name="total"     type="number" />
        <uipath:inputOutput id="Var_valid"     name="valid"     type="boolean" />
        <uipath:inputOutput id="Var_records"   name="records"   type="object" />
        <uipath:inputOutput id="Var_filtered"  name="filtered"  type="object" />
        <uipath:inputOutput id="Var_notFound"  name="notFound"  type="string" />
      </uipath:variables>
    </bpmn:extensionElements>

    <!-- Start event: manual trigger with input variables -->
    <bpmn:startEvent id="Start_1" name="Start">
      <bpmn:extensionElements>
        <uipath:entryPointId value="ep_WikiPageviews" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_StartToFetch</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Script task: fetchPageviews -->
    <bpmn:scriptTask id="Task_fetchPageviews" name="fetchPageviews" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"article":"=vars.Var_article","date1":"=vars.Var_date1","date2":"=vars.Var_date2"}]]></uipath:input>
          <uipath:output name="records" type="object"  var="Var_records" source="=result.response.records" />
          <uipath:output name="valid"   type="boolean" var="Var_valid"   source="=result.response.valid" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_StartToFetch</bpmn:incoming>
      <bpmn:outgoing>Flow_FetchToGw</bpmn:outgoing>
      <bpmn:script><![CDATA[
var knownArticles = ["Paris", "London", "Berlin", "Tokyo", "Sydney"];
var isKnown = knownArticles.indexOf(article) !== -1;
if (!isKnown) {
  return { response: { valid: false, records: [] } };
}
var start = new Date(date1);
var end   = new Date(date2);
var records = [];
var cursor  = new Date(start);
while (cursor <= end) {
  var day = cursor.toISOString().slice(0, 10);
  var seed = 0;
  for (var i = 0; i < day.length; i++) { seed = (seed * 31 + day.charCodeAt(i)) & 0xffff; }
  var views = (seed % 1800) + 10;
  records.push({ date: day, views: views });
  cursor.setDate(cursor.getDate() + 1);
}
return { response: { valid: true, records: records } };
]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- Exclusive gateway: route on valid flag -->
    <bpmn:exclusiveGateway id="Gw_Valid" name="valid?" default="Flow_GwToFilter">
      <bpmn:incoming>Flow_FetchToGw</bpmn:incoming>
      <bpmn:outgoing>Flow_GwToNotFound</bpmn:outgoing>
      <bpmn:outgoing>Flow_GwToFilter</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Script task: filterHighTraffic -->
    <bpmn:scriptTask id="Task_filterHighTraffic" name="filterHighTraffic" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"records":"=vars.Var_records"}]]></uipath:input>
          <uipath:output name="filtered" type="object" var="Var_filtered" source="=result.response" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_GwToFilter</bpmn:incoming>
      <bpmn:outgoing>Flow_FilterToAggregate</bpmn:outgoing>
      <bpmn:script><![CDATA[
var kept = [];
for (var i = 0; i < records.length; i++) {
  if (records[i].views > 500) {
    kept.push(records[i]);
  }
}
return { response: kept };
]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- Script task: aggregateTotal -->
    <bpmn:scriptTask id="Task_aggregateTotal" name="aggregateTotal" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"filtered":"=vars.Var_filtered"}]]></uipath:input>
          <uipath:output name="total" type="number" var="Var_total" source="=result.response" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_FilterToAggregate</bpmn:incoming>
      <bpmn:outgoing>Flow_AggregateToEnd</bpmn:outgoing>
      <bpmn:script><![CDATA[
var sum = 0;
for (var i = 0; i < filtered.length; i++) {
  sum += filtered[i].views;
}
return { response: sum };
]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- Script task: setNotFound (sets literal result before invalid end) -->
    <bpmn:scriptTask id="Task_setNotFound" name="setNotFound" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{}]]></uipath:input>
          <uipath:output name="notFound" type="string" var="Var_notFound" source="=result.response" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_GwToNotFound</bpmn:incoming>
      <bpmn:outgoing>Flow_NotFoundToEnd</bpmn:outgoing>
      <bpmn:script><![CDATA[
return { response: "Article not found" };
]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- End event: article not found path -->
    <bpmn:endEvent id="End_NotFound" name="Article not found">
      <bpmn:incoming>Flow_NotFoundToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End event: valid path -->
    <bpmn:endEvent id="End_Valid" name="End">
      <bpmn:incoming>Flow_AggregateToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="Flow_StartToFetch"      sourceRef="Start_1"            targetRef="Task_fetchPageviews" />
    <bpmn:sequenceFlow id="Flow_FetchToGw"         sourceRef="Task_fetchPageviews" targetRef="Gw_Valid" />
    <bpmn:sequenceFlow id="Flow_GwToNotFound"      sourceRef="Gw_Valid"            targetRef="Task_setNotFound">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=vars.Var_valid == false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_GwToFilter"        sourceRef="Gw_Valid"            targetRef="Task_filterHighTraffic" />
    <bpmn:sequenceFlow id="Flow_FilterToAggregate" sourceRef="Task_filterHighTraffic" targetRef="Task_aggregateTotal" />
    <bpmn:sequenceFlow id="Flow_AggregateToEnd"    sourceRef="Task_aggregateTotal" targetRef="End_Valid" />
    <bpmn:sequenceFlow id="Flow_NotFoundToEnd"     sourceRef="Task_setNotFound"    targetRef="End_NotFound" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_1">

      <!-- Start event at x=160 y=200 (center y=218) -->
      <bpmndi:BPMNShape id="S_Start_1" bpmnElement="Start_1">
        <dc:Bounds x="160" y="200" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- fetchPageviews task -->
      <bpmndi:BPMNShape id="S_Task_fetchPageviews" bpmnElement="Task_fetchPageviews">
        <dc:Bounds x="260" y="178" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Exclusive gateway -->
      <bpmndi:BPMNShape id="S_Gw_Valid" bpmnElement="Gw_Valid">
        <dc:Bounds x="430" y="193" width="50" height="50" />
      </bpmndi:BPMNShape>

      <!-- filterHighTraffic task (valid path, center y=218) -->
      <bpmndi:BPMNShape id="S_Task_filterHighTraffic" bpmnElement="Task_filterHighTraffic">
        <dc:Bounds x="560" y="178" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- aggregateTotal task -->
      <bpmndi:BPMNShape id="S_Task_aggregateTotal" bpmnElement="Task_aggregateTotal">
        <dc:Bounds x="730" y="178" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- End_Valid -->
      <bpmndi:BPMNShape id="S_End_Valid" bpmnElement="End_Valid">
        <dc:Bounds x="900" y="200" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- setNotFound task (invalid path, upper lane y=80) -->
      <bpmndi:BPMNShape id="S_Task_setNotFound" bpmnElement="Task_setNotFound">
        <dc:Bounds x="560" y="58" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- End_NotFound -->
      <bpmndi:BPMNShape id="S_End_NotFound" bpmnElement="End_NotFound">
        <dc:Bounds x="730" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Edges -->
      <bpmndi:BPMNEdge id="E_StartToFetch" bpmnElement="Flow_StartToFetch">
        <di:waypoint x="196" y="218" />
        <di:waypoint x="260" y="218" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="E_FetchToGw" bpmnElement="Flow_FetchToGw">
        <di:waypoint x="360" y="218" />
        <di:waypoint x="430" y="218" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="E_GwToNotFound" bpmnElement="Flow_GwToNotFound">
        <di:waypoint x="455" y="193" />
        <di:waypoint x="455" y="98" />
        <di:waypoint x="560" y="98" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="E_GwToFilter" bpmnElement="Flow_GwToFilter">
        <di:waypoint x="480" y="218" />
        <di:waypoint x="560" y="218" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="E_FilterToAggregate" bpmnElement="Flow_FilterToAggregate">
        <di:waypoint x="660" y="218" />
        <di:waypoint x="730" y="218" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="E_AggregateToEnd" bpmnElement="Flow_AggregateToEnd">
        <di:waypoint x="830" y="218" />
        <di:waypoint x="900" y="218" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="E_NotFoundToEnd" bpmnElement="Flow_NotFoundToEnd">
        <di:waypoint x="660" y="98" />
        <di:waypoint x="730" y="98" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
