{
  "id": "bd91f1c8-ed4b-4071-80bb-c2e1947f4aae",
  "version": "1.8",
  "name": "InvoiceRouter",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "4c5f753f-b8ce-43a1-bcc3-291fafea2140",
        "isDefaultEntryPoint": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the workflow.",
          "source": "null",
          "var": "output"
        }
      }
    },
    {
      "id": "extractInvoice",
      "type": "uipath.ixp.invoiceixp-cef0d447-ixp.ff973488-5d89-8035-86ac-f980b4be6deb-c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Extract Invoice Fields (Invoice Model)"
      },
      "inputs": {
        "model": {
          "id": "ff973488-5d89-8035-86ac-f980b4be6deb",
          "modelName": "invoiceixp-cef0d447-ixp",
          "modelDisplayName": "InvoiceIXP",
          "folderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "folderName": "Shared",
          "folderPath": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "description": ""
        },
        "modelName": "invoiceixp-cef0d447-ixp",
        "projectName": "invoiceixp-cef0d447-ixp",
        "versionTag": "",
        "folderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
        "folderName": "Shared",
        "fileRef": "=js:$vars.start.output.invoice",
        "pageRange": ""
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Extraction result containing ExtractionResult.ResultsDocument.Fields[]",
          "source": "=this.result",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the extraction fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "checkAmount",
      "type": "core.logic.decision",
      "typeVersion": "1.1",
      "display": {
        "label": "Amount > 1000?"
      },
      "inputs": {
        "expression": "parseFloat($vars.extractInvoice.output.ExtractionResult.ResultsDocument.Fields.find(f => f.FieldName === 'TotalAmount')?.Values?.[0]) > 1000",
        "trueLabel": "High Value (> 1000)",
        "falseLabel": "Auto Approve (<= 1000)"
      }
    },
    {
      "id": "highValueReview",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "HighValueReview"
      },
      "inputs": {
        "script": "var vendor = $vars.extractInvoice.output.ExtractionResult.ResultsDocument.Fields.find(function(f) { return f.FieldName === 'VendorName'; });\nvar vendorName = vendor ? vendor.Values[0] : 'Unknown Vendor';\nvar total = $vars.extractInvoice.output.ExtractionResult.ResultsDocument.Fields.find(function(f) { return f.FieldName === 'TotalAmount'; });\nvar totalAmount = total ? total.Values[0] : '0';\nvar summary = 'HIGH VALUE REVIEW: Invoice from ' + vendorName + ' for amount ' + totalAmount + ' requires manual review';\nreturn { summary: summary, vendor: vendorName, amount: totalAmount, action: 'HighValueReview' };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "autoApprove",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "AutoApprove"
      },
      "inputs": {
        "script": "var vendor = $vars.extractInvoice.output.ExtractionResult.ResultsDocument.Fields.find(function(f) { return f.FieldName === 'VendorName'; });\nvar vendorName = vendor ? vendor.Values[0] : 'Unknown Vendor';\nvar total = $vars.extractInvoice.output.ExtractionResult.ResultsDocument.Fields.find(function(f) { return f.FieldName === 'TotalAmount'; });\nvar totalAmount = total ? total.Values[0] : '0';\nvar summary = 'AUTO APPROVED: Invoice from ' + vendorName + ' for amount ' + totalAmount + ' has been automatically approved';\nreturn { summary: summary, vendor: vendorName, amount: totalAmount, action: 'AutoApprove' };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {}
    }
  ],
  "edges": [
    {
      "id": "edge-start-extractInvoice",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "extractInvoice",
      "targetPort": "input"
    },
    {
      "id": "edge-extractInvoice-checkAmount",
      "sourceNodeId": "extractInvoice",
      "sourcePort": "success",
      "targetNodeId": "checkAmount",
      "targetPort": "input"
    },
    {
      "id": "edge-checkAmount-highValueReview",
      "sourceNodeId": "checkAmount",
      "sourcePort": "true",
      "targetNodeId": "highValueReview",
      "targetPort": "input"
    },
    {
      "id": "edge-checkAmount-autoApprove",
      "sourceNodeId": "checkAmount",
      "sourcePort": "false",
      "targetNodeId": "autoApprove",
      "targetPort": "input"
    },
    {
      "id": "edge-highValueReview-end",
      "sourceNodeId": "highValueReview",
      "sourcePort": "success",
      "targetNodeId": "end",
      "targetPort": "input"
    },
    {
      "id": "edge-autoApprove-end",
      "sourceNodeId": "autoApprove",
      "sourcePort": "success",
      "targetNodeId": "end",
      "targetPort": "input"
    }
  ],
