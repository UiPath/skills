    {
      "id": "normalizeData",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Normalize Data"
      },
      "inputs": {
        "script": "const result = $vars.extractInvoice.output;\nconst fields = (result && result.ExtractionResult && result.ExtractionResult.ResultsDocument && result.ExtractionResult.ResultsDocument.Fields) || [];\nconst normalized = fields.map(function(f) {\n  return {\n    Id: f.FieldId,\n    Name: f.FieldName,\n    Value: (f.Values && f.Values.length > 0) ? f.Values[0] : null,\n    Type: f.FieldType,\n    IsMissing: f.IsMissing,\n    Confidence: f.Confidence\n  };\n});\nreturn { fields: normalized };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Normalized IxP fields",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
