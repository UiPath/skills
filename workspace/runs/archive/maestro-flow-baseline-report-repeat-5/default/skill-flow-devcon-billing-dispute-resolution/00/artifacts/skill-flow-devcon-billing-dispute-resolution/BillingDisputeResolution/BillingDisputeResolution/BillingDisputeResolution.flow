    {
      "id": "mergeResults",
      "type": "core.logic.merge",
      "typeVersion": "1.0",
      "display": {
        "label": "Merge CRM + ERP"
      },
      "inputs": {}
    },
    {
      "id": "detectDiscrepancies",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Discrepancy Detection"
      },
      "inputs": {
        "script": "const disputedItems = ($vars.start.output.webhookPayload && $vars.start.output.webhookPayload.dispute && $vars.start.output.webhookPayload.dispute.disputedLineItems) || [];\nconst erpRecords = ($vars.erpLookup1.output && $vars.erpLookup1.output.value) || ($vars.erpLookup1.output && $vars.erpLookup1.output.Value) || [];\nvar totalOvercharge = 0;\nvar totalUndercharge = 0;\nvar mismatches = [];\nfor (var i = 0; i < disputedItems.length; i++) {\n  var item = disputedItems[i];\n  var contractRow = null;\n  for (var j = 0; j < erpRecords.length; j++) {\n    var r = erpRecords[j];\n    if (r && (r.lineNumber === item.lineNumber || r.LineNumber === item.lineNumber)) {\n      contractRow = r;\n      break;\n    }\n  }\n  if (contractRow) {\n    var contractPrice = contractRow.unitPrice || contractRow.UnitPrice || 0;\n    var disputedPrice = item.unitPrice || 0;\n    var qty = item.quantity || 1;\n    var diff = (disputedPrice - contractPrice) * qty;\n    if (diff > 0) {\n      totalOvercharge += diff;\n      mismatches.push({ lineNumber: item.lineNumber, type: 'overcharge', contractPrice: contractPrice, disputedPrice: disputedPrice, quantity: qty, diff: diff });\n    } else if (diff < 0) {\n      totalUndercharge += Math.abs(diff);\n      mismatches.push({ lineNumber: item.lineNumber, type: 'undercharge', contractPrice: contractPrice, disputedPrice: disputedPrice, quantity: qty, diff: diff });\n    }\n  }\n}\nreturn { mismatches: mismatches, totalOvercharge: totalOvercharge, totalUndercharge: totalUndercharge };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Discrepancy analysis",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "disputeAnalyst",
      "type": "uipath.agent.autonomous",
      "typeVersion": "1.2",
      "display": {
        "label": "Dispute Analyst Agent"
      },
      "inputs": {
        "systemPrompt": "You are a billing dispute analyst. Analyze invoice discrepancies and make a determination.",
        "userPrompt": "Analyze this billing dispute and return a structured determination.",
        "source": "35c19488-5b8b-43fc-92dc-904c140b14a2",
        "agentInputVariables": [
          {
            "id": "start__output__webhookPayload",
            "type": "object",
            "binding": "=$vars.start.output.webhookPayload",
            "description": "Webhook payload with dispute info"
          },
          {
            "id": "normalizeData__output__fields",
            "type": "array",
            "binding": "=$vars.normalizeData.output.fields",
            "description": "Normalized invoice fields"
          },
          {
            "id": "crmLookup1__output__output",
            "type": "object",
            "binding": "=$vars.crmLookup1.output",
            "description": "CRM account data"
          },
          {
            "id": "erpLookup1__output__output",
            "type": "object",
            "binding": "=$vars.erpLookup1.output",
            "description": "ERP contract data"
          },
          {
            "id": "detectDiscrepancies__output__mismatches",
            "type": "array",
            "binding": "=$vars.detectDiscrepancies.output.mismatches",
            "description": "Discrepancy analysis"
          },
          {
            "id": "detectDiscrepancies__output__totalOvercharge",
            "type": "number",
            "binding": "=$vars.detectDiscrepancies.output.totalOvercharge",
            "description": "Total overcharge amount"
          },
          {
            "id": "detectDiscrepancies__output__totalUndercharge",
            "type": "number",
            "binding": "=$vars.detectDiscrepancies.output.totalUndercharge",
            "description": "Total undercharge amount"
          }
        ],
        "agentOutputVariables": [
          {
            "id": "determination",
            "type": "string"
          },
          {
            "id": "recommendedAction",
            "type": "string"
          },
          {
            "id": "autoResolutionEligible",
            "type": "boolean"
          },
          {
            "id": "creditAmount",
            "type": "number"
          },
          {
            "id": "confidence",
            "type": "number"
          },
          {
            "id": "rationale",
            "type": "string"
          }
        ]
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Agent response",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "contextBillingSOPIndex",
      "type": "uipath.agent.resource.context.index.billing-dispute-sop-index.cc45b9b4-dbf6-47b3-40ac-08debc0cec5b",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Billing Dispute SOP Index"
      },
      "inputs": {
        "source": "cc45b9b4-dbf6-47b3-40ac-08debc0cec5b"
      }
    },
    {
      "id": "switchAction",
      "type": "core.logic.switch",
      "typeVersion": "1.1",
      "display": {
        "label": "Switch on Recommended Action"
      },
      "inputs": {
        "cases": [
          {
            "id": "escalate",
            "label": "Escalate to Manager",
            "expression": "$vars.disputeAnalyst.output.recommendedAction === 'escalate_to_manager'"
          },
          {
            "id": "autoResolve",
            "label": "Auto Resolve",
            "expression": "$vars.disputeAnalyst.output.recommendedAction === 'auto_resolve'"
          },
          {
            "id": "reject",
            "label": "Reject",
            "expression": "$vars.disputeAnalyst.output.recommendedAction === 'reject'"
          }
        ]
      }
    },
    {
      "id": "logCreditAmount",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log Credit Amount"
      },
      "inputs": {
        "script": "return { creditAmount: $vars.disputeAnalyst.output.creditAmount };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Credit amount",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "managerApproval",
      "type": "core.logic.decision",
      "typeVersion": "1.1",
      "display": {
        "label": "Manager Approval"
      },
      "inputs": {
        "expression": "false",
        "trueLabel": "Rejected",
        "falseLabel": "Approved"
      }
    },
    {
      "id": "financialPosting",
      "type": "uipath.core.api-workflow.07d45a91-9413-4dad-82ff-28306c2d85ea",
      "typeVersion": "1.0.0",
      "display": {
        "label": "FinancialPostingFunction"
      },
      "inputs": {
        "invoiceNumber": "=js:$vars.start.output.webhookPayload && $vars.start.output.webhookPayload.invoice ? $vars.start.output.webhookPayload.invoice.invoiceNumber : ''"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the API workflow",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "resolutionWriter",
      "type": "uipath.agent.autonomous",
      "typeVersion": "1.2",
      "display": {
        "label": "Resolution Writer Agent"
      },
      "inputs": {
        "systemPrompt": "You are a customer communications specialist. Draft resolution emails for billing disputes.",
        "userPrompt": "Draft a resolution email for this billing dispute.",
        "source": "5b0fa1a7-fd44-48f3-a1ad-8d082634f033",
        "agentInputVariables": [
          {
            "id": "start__output__webhookPayload",
            "type": "object",
            "binding": "=$vars.start.output.webhookPayload",
            "description": "Webhook payload with invoice info"
          },
          {
            "id": "disputeAnalyst__output__determination",
            "type": "string",
            "binding": "=$vars.disputeAnalyst.output.determination",
            "description": "Analyst determination"
          },
          {
            "id": "disputeAnalyst__output__creditAmount",
            "type": "number",
            "binding": "=$vars.disputeAnalyst.output.creditAmount",
            "description": "Approved credit amount"
          },
          {
            "id": "disputeAnalyst__output__rationale",
            "type": "string",
            "binding": "=$vars.disputeAnalyst.output.rationale",
            "description": "Analyst rationale"
          }
        ],
        "agentOutputVariables": [
          {
            "id": "subject",
            "type": "string"
          },
          {
            "id": "body",
            "type": "string"
          }
        ]
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Agent response",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "endResolution",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Return Resolution"
      },
      "inputs": {},
      "outputs": {
        "determination": {
          "source": "=js:$vars.disputeAnalyst.output.determination"
        },
        "recommendedAction": {
          "source": "=js:$vars.disputeAnalyst.output.recommendedAction"
        },
        "creditAmount": {
          "source": "=js:$vars.disputeAnalyst.output.creditAmount"
        },
        "rationale": {
          "source": "=js:$vars.disputeAnalyst.output.rationale"
        },
        "resolutionEmailBody": {
          "source": "=js:$vars.resolutionWriter.output.body"
        }
      }
    },
    {
      "id": "endRejection",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Return Rejection"
      },
      "inputs": {},
      "outputs": {
        "determination": {
          "source": "=js:$vars.disputeAnalyst.output.determination"
        },
        "recommendedAction": {
          "source": "=js:$vars.disputeAnalyst.output.recommendedAction"
        },
        "creditAmount": {
          "source": "=js:$vars.disputeAnalyst.output.creditAmount"
        },
        "rationale": {
          "source": "=js:$vars.disputeAnalyst.output.rationale"
        },
        "resolutionEmailBody": {
          "source": "'No resolution email was drafted — dispute was rejected.'"
        }
      }
    },
    {
      "id": "endManagerRejection",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Return Manager Rejection"
      },
      "inputs": {},
      "outputs": {
        "determination": {
          "source": "=js:$vars.disputeAnalyst.output.determination"
        },
        "recommendedAction": {
          "source": "=js:$vars.disputeAnalyst.output.recommendedAction"
        },
        "creditAmount": {
          "source": "=js:$vars.disputeAnalyst.output.creditAmount"
        },
        "rationale": {
          "source": "=js:$vars.disputeAnalyst.output.rationale"
        },
        "resolutionEmailBody": {
          "source": "'No resolution email was drafted — manager rejected the escalation.'"
        }
      }
    }
  ],
