    {
      "id": "disputeAnalyst1",
      "type": "uipath.agent.autonomous",
      "typeVersion": "1.2",
      "display": {
        "label": "Dispute Analyst Agent"
      },
      "inputs": {
        "systemPrompt": "You are a Billing Dispute Analyst. Analyze disputes per SOP and return a structured determination.",
        "userPrompt": "Analyze the billing dispute and return your determination as JSON.",
        "source": "d64fdd45-39d8-4f45-aa99-4c2d8ff6aea0",
        "agentInputVariables": [
          {
            "id": "normalizeData1__output__fields",
            "type": "array",
            "binding": "=$vars.normalizeData1.output.fields",
            "description": "Normalized invoice fields from IxP extraction"
          },
          {
            "id": "normalizeData1__output__invoiceNumber",
            "type": "string",
            "binding": "=$vars.normalizeData1.output.invoiceNumber",
            "description": "Normalized invoice number"
          },
          {
            "id": "crmLookup1__output__value",
            "type": "object",
            "binding": "=$vars.crmLookup1.output",
            "description": "CRM records for the account"
          },
          {
            "id": "erpLookup1__output__value",
            "type": "object",
            "binding": "=$vars.erpLookup1.output",
            "description": "ERP records for the invoice"
          },
          {
            "id": "discrepancyDetection1__output__mismatches",
            "type": "array",
            "binding": "=$vars.discrepancyDetection1.output.mismatches",
            "description": "List of detected line item discrepancies"
          },
          {
            "id": "discrepancyDetection1__output__totalOvercharge",
            "type": "number",
            "binding": "=$vars.discrepancyDetection1.output.totalOvercharge",
            "description": "Total overcharge amount"
          },
          {
            "id": "discrepancyDetection1__output__totalUndercharge",
            "type": "number",
            "binding": "=$vars.discrepancyDetection1.output.totalUndercharge",
            "description": "Total undercharge amount"
          },
          {
            "id": "start__output__webhookPayload",
            "type": "object",
            "binding": "=$vars.start.output.webhookPayload",
            "description": "Original webhook payload with customer and dispute details"
          }
        ],
        "agentOutputVariables": [
          {
            "id": "determination",
            "type": "string"
          },
          {
            "id": "recommendedAction",
            "type": "string"
          },
          {
            "id": "autoResolutionEligible",
            "type": "boolean"
          },
          {
            "id": "creditAmount",
            "type": "number"
          },
          {
            "id": "confidence",
            "type": "number"
          },
          {
            "id": "rationale",
            "type": "string"
          }
        ]
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Agent response",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "routeByAction1",
      "type": "core.logic.switch",
      "typeVersion": "1.1",
      "display": {
        "label": "Route by Action"
      },
      "inputs": {
        "cases": [
          {
            "id": "escalate_to_manager",
            "label": "Escalate to Manager",
            "expression": "$vars.disputeAnalyst1.output.recommendedAction === 'escalate_to_manager'"
          },
          {
            "id": "auto_resolve",
            "label": "Auto Resolve",
            "expression": "$vars.disputeAnalyst1.output.recommendedAction === 'auto_resolve'"
          },
          {
            "id": "reject",
            "label": "Reject",
            "expression": "$vars.disputeAnalyst1.output.recommendedAction === 'reject'"
          }
        ]
      }
    },
    {
      "id": "managerApproval1",
      "type": "core.logic.decision",
      "typeVersion": "1.1",
      "display": {
        "label": "Manager Approval"
      },
      "inputs": {
        "expression": "false",
        "trueLabel": "Rejected",
        "falseLabel": "Approved"
      }
    },
    {
      "id": "logCreditAmount1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log Credit Amount"
      },
      "inputs": {
        "script": "const creditAmount = $vars.disputeAnalyst1.output.creditAmount || 0;\nconst invoiceNumber = $vars.normalizeData1.output.invoiceNumber;\nconsole.log('Auto-resolving dispute for invoice ' + invoiceNumber + ' with credit amount: ' + creditAmount);\nreturn { logged: true, creditAmount: creditAmount, invoiceNumber: invoiceNumber };"
      }
    },
    {
      "id": "financialPosting1",
      "type": "uipath.core.api-workflow.07d45a91-9413-4dad-82ff-28306c2d85ea",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Financial Posting"
      },
      "inputs": {
        "invoiceNumber": "=js:$vars.normalizeData1.output.invoiceNumber"
      }
    },
    {
      "id": "resolutionWriter1",
      "type": "uipath.agent.autonomous",
      "typeVersion": "1.2",
      "display": {
        "label": "Resolution Writer Agent"
      },
      "inputs": {
        "systemPrompt": "You are a customer communication specialist. Draft professional resolution emails for billing disputes.",
        "userPrompt": "Draft a resolution email for this billing dispute.",
        "source": "02d61f33-50dc-4cd3-9666-b6fdf5c375a1",
        "agentInputVariables": [
          {
            "id": "normalizeData1__output__invoiceNumber",
            "type": "string",
            "binding": "=$vars.normalizeData1.output.invoiceNumber",
            "description": "Invoice number for the dispute"
          },
          {
            "id": "disputeAnalyst1__output__creditAmount",
            "type": "number",
            "binding": "=$vars.disputeAnalyst1.output.creditAmount",
            "description": "Credit amount approved for the dispute"
          },
          {
            "id": "disputeAnalyst1__output__determination",
            "type": "string",
            "binding": "=$vars.disputeAnalyst1.output.determination",
            "description": "Analyst determination summary"
          },
          {
            "id": "disputeAnalyst1__output__rationale",
            "type": "string",
            "binding": "=$vars.disputeAnalyst1.output.rationale",
            "description": "Rationale for the determination"
          },
          {
            "id": "start__output__webhookPayload",
            "type": "object",
            "binding": "=$vars.start.output.webhookPayload",
            "description": "Customer and invoice details from webhook"
          }
        ],
        "agentOutputVariables": [
          {
            "id": "subject",
            "type": "string"
          },
          {
            "id": "body",
            "type": "string"
          }
        ]
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Agent response",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "endResolution",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Return Resolution"
      },
      "inputs": {},
      "outputs": {
        "determination": {
          "source": "=js:$vars.disputeAnalyst1.output.determination"
        },
        "recommendedAction": {
          "source": "=js:$vars.disputeAnalyst1.output.recommendedAction"
        },
        "creditAmount": {
          "source": "=js:$vars.disputeAnalyst1.output.creditAmount"
        },
        "rationale": {
          "source": "=js:$vars.disputeAnalyst1.output.rationale"
        },
        "resolutionEmailBody": {
          "source": "=js:$vars.resolutionWriter1.output.body"
        }
      }
    },
    {
      "id": "endRejection",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Return Rejection"
      },
      "inputs": {},
      "outputs": {
        "determination": {
          "source": "=js:$vars.disputeAnalyst1.output.determination"
        },
        "recommendedAction": {
          "source": "=js:$vars.disputeAnalyst1.output.recommendedAction"
        },
        "creditAmount": {
          "source": "=js:$vars.disputeAnalyst1.output.creditAmount"
        },
        "rationale": {
          "source": "=js:$vars.disputeAnalyst1.output.rationale"
        },
        "resolutionEmailBody": {
          "source": "No resolution email was drafted."
        }
      }
    },
    {
      "id": "endManagerRejection",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Return Manager Rejection"
      },
      "inputs": {},
      "outputs": {
        "determination": {
          "source": "=js:$vars.disputeAnalyst1.output.determination"
        },
        "recommendedAction": {
          "source": "=js:$vars.disputeAnalyst1.output.recommendedAction"
        },
        "creditAmount": {
          "source": "=js:$vars.disputeAnalyst1.output.creditAmount"
        },
        "rationale": {
          "source": "=js:$vars.disputeAnalyst1.output.rationale"
        },
        "resolutionEmailBody": {
          "source": "No resolution email was drafted."
        }
      }
    }
  ],
