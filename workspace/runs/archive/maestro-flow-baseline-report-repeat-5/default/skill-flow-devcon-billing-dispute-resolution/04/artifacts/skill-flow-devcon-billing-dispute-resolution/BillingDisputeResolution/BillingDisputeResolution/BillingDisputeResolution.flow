    {
      "id": "normalizeData1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Normalize Data"
      },
      "inputs": {
        "script": "const fields = $vars.extractInvoice1.output.ExtractionResult.ResultsDocument.Fields || [];\nconst normalized = fields.map(f => ({\n  Id: f.FieldId,\n  Name: f.FieldName,\n  Value: (f.Values && f.Values[0]) || null,\n  Type: f.FieldType,\n  IsMissing: f.IsMissing || false,\n  Confidence: f.Confidence || 0\n}));\nconst invoiceNumberField = normalized.find(f => f.Name && f.Name.toLowerCase().includes('invoice') && f.Name.toLowerCase().includes('number'));\nlet rawInvoiceNumber = invoiceNumberField ? (invoiceNumberField.Value || '') : '';\nconst trimmed = rawInvoiceNumber.trim().toUpperCase();\nconst invoiceNumber = trimmed.startsWith('MCS-') ? trimmed : 'MCS-' + trimmed;\nreturn { fields: normalized, invoiceNumber: invoiceNumber };"
      }
    },
