    {
      "id": "merge1",
      "type": "core.logic.merge",
      "typeVersion": "1.0",
      "display": {
        "label": "Merge CRM + ERP"
      },
      "inputs": {}
    },
    {
      "id": "discrepancyDetection1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Discrepancy Detection"
      },
      "inputs": {
        "script": "const disputedItems = ($vars.start.output.webhookPayload && $vars.start.output.webhookPayload.dispute && $vars.start.output.webhookPayload.dispute.disputedLineItems) || [];\nconst erpData = $vars.erpLookup1.output;\nconst erpRows = (erpData && erpData.value) ? erpData.value : (Array.isArray(erpData) ? erpData : []);\nconst mismatches = [];\nlet totalOvercharge = 0;\nlet totalUndercharge = 0;\nfor (const disputed of disputedItems) {\n  const erpRow = erpRows.find(r => String(r.lineNumber) === String(disputed.lineNumber));\n  if (!erpRow) {\n    mismatches.push({ lineNumber: disputed.lineNumber, issue: 'LINE_NOT_IN_ERP', disputedAmount: disputed.amount, erpAmount: null, delta: disputed.amount });\n    totalOvercharge += disputed.amount || 0;\n    continue;\n  }\n  const delta = (disputed.amount || 0) - (erpRow.amount || 0);\n  if (Math.abs(delta) > 0.001) {\n    mismatches.push({ lineNumber: disputed.lineNumber, issue: delta > 0 ? 'OVERCHARGE' : 'UNDERCHARGE', disputedAmount: disputed.amount, erpAmount: erpRow.amount, delta: delta, description: disputed.description });\n    if (delta > 0) totalOvercharge += delta;\n    else totalUndercharge += Math.abs(delta);\n  }\n}\nreturn { mismatches: mismatches, totalOvercharge: totalOvercharge, totalUndercharge: totalUndercharge, hasMismatches: mismatches.length > 0 };"
      }
    },
    {
      "id": "sopContext1",
      "type": "uipath.agent.resource.context.index.billing-dispute-sop-index.cc45b9b4-dbf6-47b3-40ac-08debc0cec5b",
      "typeVersion": "1.0.0",
      "display": {
