    {
      "id": "normalizeData",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Normalize Data"
      },
      "inputs": {
        "script": "var fields = ($vars.extractInvoice.output && $vars.extractInvoice.output.ExtractionResult && $vars.extractInvoice.output.ExtractionResult.ResultsDocument && $vars.extractInvoice.output.ExtractionResult.ResultsDocument.Fields) ? $vars.extractInvoice.output.ExtractionResult.ResultsDocument.Fields : [];\nvar normalized = fields.map(function(f) {\n  return { Id: f.FieldId, Name: f.FieldName, Value: (f.Values && f.Values.length > 0) ? f.Values[0] : null, Type: f.FieldType, IsMissing: f.IsMissing, Confidence: f.Confidence };\n});\nvar invField = null;\nfor (var i = 0; i < normalized.length; i++) {\n  var fn = (normalized[i].Name || '').toLowerCase().replace(/[^a-z0-9]/g, '');\n  if (fn === 'invoicenumber' || fn === 'invoiceno' || fn === 'invoice') { invField = normalized[i]; break; }\n}\nvar rawNum = invField && invField.Value ? (invField.Value.Value !== undefined ? String(invField.Value.Value) : String(invField.Value)) : '';\nvar invoiceNumber = rawNum.trim().toUpperCase();\nif (invoiceNumber && invoiceNumber.indexOf('MCS-') !== 0) { invoiceNumber = 'MCS-' + invoiceNumber; }\nreturn { fields: normalized, invoiceNumber: invoiceNumber };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "crmLookup1",
      "type": "uipath.connector.uipath-uipath-dataservice.query-entity-records",
      "typeVersion": "1.0.0",
      "display": {
        "label": "CRM Lookup"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-uipath-dataservice",
          "connectionId": "d61e5d0e-04af-4f93-95cc-151d81fa08dc",
          "connectionResourceId": "d61e5d0e-04af-4f93-95cc-151d81fa08dc",
          "connectionFolderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "method": "POST",
          "endpoint": "/v2/BillingDisputeCRM/qer",
          "uiPathActivityTypeId": "703065b9-a310-33b8-9d4d-12df0a6f520b",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\": {\"instanceParameters\": {\"connectorKey\": \"uipath-uipath-dataservice\", \"objectName\": \"QueryEntityRecordsCurated\", \"httpMethod\": \"POST\", \"activityType\": \"Curated\", \"version\": \"1.0.0\", \"supportsStreaming\": false, \"subType\": \"standard\"}, \"objectName\": \"QueryEntityRecordsCurated\", \"operation\": \"list\", \"httpMethod\": \"POST\", \"path\": \"/v2/{entityName}/qer\", \"packageVersion\": \"1.0.0\", \"connectorVersion\": null, \"executionType\": null, \"customFieldsRequestDetails\": null, \"unifiedTypesCompatible\": true, \"pathParameters\": {\"entityName\": \"BillingDisputeCRM\"}, \"queryParameters\": {\"queryExpression\": \"=js:\\\"accountNumber = '\\\" + $vars.start.output.webhookPayload.customer.accountNumber + \\\"'\\\"\"}, \"savedFilterTrees\": {\"queryExpression\": {\"groupOperator\": 0, \"index\": 0, \"filters\": [], \"groups\": []}}}}",
          "inputMetadata": {
            "operation": "list",
            "pagination": {
              "maxPageSize": 1000
            }
          }
        }
      }
    },
    {
      "id": "erpLookup1",
      "type": "uipath.connector.uipath-uipath-dataservice.query-entity-records",
      "typeVersion": "1.0.0",
      "display": {
        "label": "ERP Lookup"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-uipath-dataservice",
          "connectionId": "d61e5d0e-04af-4f93-95cc-151d81fa08dc",
          "connectionResourceId": "d61e5d0e-04af-4f93-95cc-151d81fa08dc",
          "connectionFolderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "method": "POST",
          "endpoint": "/v2/BillingDisputeERP/qer",
          "uiPathActivityTypeId": "703065b9-a310-33b8-9d4d-12df0a6f520b",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\": {\"instanceParameters\": {\"connectorKey\": \"uipath-uipath-dataservice\", \"objectName\": \"QueryEntityRecordsCurated\", \"httpMethod\": \"POST\", \"activityType\": \"Curated\", \"version\": \"1.0.0\", \"supportsStreaming\": false, \"subType\": \"standard\"}, \"objectName\": \"QueryEntityRecordsCurated\", \"operation\": \"list\", \"httpMethod\": \"POST\", \"path\": \"/v2/{entityName}/qer\", \"packageVersion\": \"1.0.0\", \"connectorVersion\": null, \"executionType\": null, \"customFieldsRequestDetails\": null, \"unifiedTypesCompatible\": true, \"pathParameters\": {\"entityName\": \"BillingDisputeERP\"}, \"queryParameters\": {\"queryExpression\": \"=js:\\\"invoiceNumber = '\\\" + $vars.normalizeData.output.invoiceNumber + \\\"'\\\"\"}, \"savedFilterTrees\": {\"queryExpression\": {\"groupOperator\": 0, \"index\": 0, \"filters\": [], \"groups\": []}}}}",
          "inputMetadata": {
            "operation": "list",
            "pagination": {
              "maxPageSize": 1000
            }
          }
        }
      }
    },
    {
      "id": "mergeBranches",
      "type": "core.logic.merge",
      "typeVersion": "1.0",
      "display": {
        "label": "Merge CRM + ERP"
      },
      "inputs": {}
    },
    {
      "id": "discrepancyDetection",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Discrepancy Detection"
      },
      "inputs": {
        "script": "var disputedItems = ($vars.start.output.webhookPayload && $vars.start.output.webhookPayload.dispute && $vars.start.output.webhookPayload.dispute.disputedLineItems) ? $vars.start.output.webhookPayload.dispute.disputedLineItems : [];\nvar erpRecords = ($vars.erpLookup1.output && $vars.erpLookup1.output.value) ? $vars.erpLookup1.output.value : [];\nvar mismatches = [];\nvar totalOvercharge = 0;\nvar totalUndercharge = 0;\nfor (var i = 0; i < disputedItems.length; i++) {\n  var di = disputedItems[i];\n  var erp = null;\n  for (var j = 0; j < erpRecords.length; j++) {\n    if (String(erpRecords[j].lineNumber) === String(di.lineNumber)) { erp = erpRecords[j]; break; }\n  }\n  if (erp) {\n    var contractPrice = Number(erp.unitPrice || 0);\n    var invoicedPrice = Number(di.unitPrice || 0);\n    var qty = Number(di.quantity || 0);\n    var diff = (invoicedPrice - contractPrice) * qty;\n    if (Math.abs(diff) > 0.001) {\n      mismatches.push({ lineNumber: di.lineNumber, description: di.description, invoicedUnitPrice: invoicedPrice, contractUnitPrice: contractPrice, quantity: qty, discrepancy: diff });\n      if (diff > 0) { totalOvercharge += diff; } else { totalUndercharge += Math.abs(diff); }\n    }\n  }\n}\nreturn { mismatches: mismatches, totalOvercharge: totalOvercharge, totalUndercharge: totalUndercharge, hasMismatch: mismatches.length > 0 };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "disputeAnalyst",
      "type": "uipath.agent.autonomous",
      "typeVersion": "1.2",
      "display": {
        "label": "Dispute Analyst Agent"
      },
      "inputs": {
        "systemPrompt": "You are a billing dispute analyst. Analyze the provided invoice data, CRM records, ERP data, and discrepancy summary to determine the resolution.",
        "userPrompt": "Analyze the billing dispute and return a structured determination.",
        "source": "31b1a295-326a-475b-a0af-bfb65afdf446",
        "agentInputVariables": [
          {
            "id": "start__output__webhookPayload",
            "type": "object",
            "binding": "=$vars.start.output.webhookPayload",
            "description": "Webhook payload with customer and dispute info"
          },
          {
            "id": "normalizeData__output__fields",
            "type": "array",
            "binding": "=$vars.normalizeData.output.fields",
            "description": "Normalized IxP extraction fields"
          },
          {
            "id": "crmLookup1__output__value",
            "type": "object",
            "binding": "=$vars.crmLookup1.output",
            "description": "CRM records for the customer account"
          },
          {
            "id": "erpLookup1__output__value",
            "type": "object",
            "binding": "=$vars.erpLookup1.output",
            "description": "ERP contract records for the invoice"
          },
          {
            "id": "discrepancyDetection__output__mismatches",
            "type": "array",
            "binding": "=$vars.discrepancyDetection.output.mismatches",
            "description": "Detected line-item pricing mismatches"
          },
          {
            "id": "discrepancyDetection__output__totalOvercharge",
            "type": "number",
            "binding": "=$vars.discrepancyDetection.output.totalOvercharge",
            "description": "Total overcharge amount"
          },
          {
            "id": "discrepancyDetection__output__totalUndercharge",
            "type": "number",
            "binding": "=$vars.discrepancyDetection.output.totalUndercharge",
            "description": "Total undercharge amount"
          }
        ],
        "agentOutputVariables": [
          {
            "id": "determination",
            "type": "string"
          },
          {
            "id": "recommendedAction",
            "type": "string"
          },
          {
            "id": "autoResolutionEligible",
            "type": "boolean"
          },
          {
            "id": "creditAmount",
            "type": "number"
          },
          {
            "id": "confidence",
            "type": "number"
          },
          {
            "id": "rationale",
            "type": "string"
          }
        ]
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Agent response",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "sopContext",
      "type": "uipath.agent.resource.context.index.billing-dispute-sop-index.cc45b9b4-dbf6-47b3-40ac-08debc0cec5b",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Billing Dispute SOP Index"
      },
      "inputs": {
        "source": "8c134ae1-dbd2-44e2-8a32-ad62a00eca07"
      }
    },
    {
      "id": "routeAction",
      "type": "core.logic.switch",
      "typeVersion": "1.1",
      "display": {
        "label": "Switch on Recommended Action"
      },
      "inputs": {
        "cases": [
          {
            "id": "escalate",
            "label": "Escalate to Manager",
            "expression": "$vars.disputeAnalyst.output.recommendedAction === 'escalate_to_manager'"
          },
          {
            "id": "auto_resolve",
            "label": "Auto Resolve",
            "expression": "$vars.disputeAnalyst.output.recommendedAction === 'auto_resolve'"
          },
          {
            "id": "reject",
            "label": "Reject",
            "expression": "$vars.disputeAnalyst.output.recommendedAction === 'reject'"
          }
        ]
      }
    },
    {
      "id": "approvalDecision",
      "type": "core.logic.decision",
      "typeVersion": "1.1",
      "display": {
        "label": "Manager Approval Decision"
      },
      "inputs": {
        "expression": "false",
        "trueLabel": "Rejected",
        "falseLabel": "Approved"
      }
    },
    {
      "id": "logCreditAmount",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log Credit Amount"
      },
      "inputs": {
        "script": "return { creditAmount: $vars.disputeAnalyst.output.creditAmount };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "financialPosting",
      "type": "uipath.core.api-workflow.07d45a91-9413-4dad-82ff-28306c2d85ea",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Financial Posting"
      },
      "inputs": {
        "invoiceNumber": "=js:$vars.start.output.webhookPayload.invoice.invoiceNumber"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the API workflow",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the API workflow fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "resolutionWriter",
      "type": "uipath.agent.autonomous",
      "typeVersion": "1.2",
      "display": {
        "label": "Resolution Writer Agent"
      },
      "inputs": {
        "systemPrompt": "You are a customer communication specialist. Draft a professional resolution email for a billing dispute.",
        "userPrompt": "Draft the customer-facing resolution email citing the invoice number and approved credit amount.",
        "source": "5ae22d5f-3815-4297-b173-bee321a76478",
        "agentInputVariables": [
          {
            "id": "start__output__webhookPayload",
            "type": "object",
            "binding": "=$vars.start.output.webhookPayload",
            "description": "Webhook payload with invoice and customer info"
          },
          {
            "id": "disputeAnalyst__output__determination",
            "type": "string",
            "binding": "=$vars.disputeAnalyst.output.determination",
            "description": "Analyst determination"
          },
          {
            "id": "disputeAnalyst__output__creditAmount",
            "type": "number",
            "binding": "=$vars.disputeAnalyst.output.creditAmount",
            "description": "Approved credit amount"
          },
          {
            "id": "disputeAnalyst__output__rationale",
            "type": "string",
            "binding": "=$vars.disputeAnalyst.output.rationale",
            "description": "Rationale for the decision"
          }
        ],
        "agentOutputVariables": [
          {
            "id": "subject",
            "type": "string"
          },
          {
            "id": "body",
            "type": "string"
          }
        ]
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Agent response",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "endResolution",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Return Resolution"
      },
      "inputs": {},
      "outputs": {
        "determination": {
          "source": "=js:$vars.disputeAnalyst.output.determination"
        },
        "recommendedAction": {
          "source": "=js:$vars.disputeAnalyst.output.recommendedAction"
        },
        "creditAmount": {
          "source": "=js:$vars.disputeAnalyst.output.creditAmount"
        },
        "rationale": {
          "source": "=js:$vars.disputeAnalyst.output.rationale"
        },
        "resolutionEmailBody": {
          "source": "=js:$vars.resolutionWriter.output.body"
        }
      }
    },
    {
      "id": "endManagerRejection",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Return Manager Rejection"
      },
      "inputs": {},
      "outputs": {
        "determination": {
          "source": "=js:$vars.disputeAnalyst.output.determination"
        },
        "recommendedAction": {
          "source": "=js:$vars.disputeAnalyst.output.recommendedAction"
        },
        "creditAmount": {
          "source": "=js:$vars.disputeAnalyst.output.creditAmount"
        },
        "rationale": {
          "source": "=js:$vars.disputeAnalyst.output.rationale"
        },
        "resolutionEmailBody": {
          "source": "'No resolution email was drafted — dispute rejected by manager.'"
        }
      }
    },
    {
      "id": "endRejection",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Return Rejection"
      },
      "inputs": {},
      "outputs": {
        "determination": {
          "source": "=js:$vars.disputeAnalyst.output.determination"
        },
        "recommendedAction": {
          "source": "=js:$vars.disputeAnalyst.output.recommendedAction"
        },
        "creditAmount": {
          "source": "=js:$vars.disputeAnalyst.output.creditAmount"
        },
        "rationale": {
          "source": "=js:$vars.disputeAnalyst.output.rationale"
        },
        "resolutionEmailBody": {
          "source": "'No resolution email was drafted — dispute rejected.'"
        }
      }
    }
