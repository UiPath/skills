    {
      "id": "extractInvoice",
      "type": "uipath.ixp.invoices-billing-f0c606f9-ixp.99f5bbfa-5f29-8033-8662-25001b6bb18e-79a7d12e-da84-4bf4-ab60-7f34b44dd178",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Invoice Extraction"
      },
      "inputs": {
        "model": {
          "id": "99f5bbfa-5f29-8033-8662-25001b6bb18e",
          "modelName": "invoices-billing-f0c606f9-ixp",
          "modelDisplayName": "invoices-billing",
          "folderKey": "79a7d12e-da84-4bf4-ab60-7f34b44dd178",
          "folderName": "Shared/uipath-maestro-flow/BillingDispute",
          "folderPath": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c.5da18ec0-7de1-4e57-aaf1-ddc8a369c199.79a7d12e-da84-4bf4-ab60-7f34b44dd178",
          "description": ""
        },
        "modelName": "invoices-billing-f0c606f9-ixp",
        "description": "",
        "projectName": "invoices-billing-f0c606f9-ixp",
        "versionTag": "",
        "folderKey": "79a7d12e-da84-4bf4-ab60-7f34b44dd178",
        "folderName": "Shared/uipath-maestro-flow/BillingDispute",
        "fileRef": "=js:$vars.start.output.disputedInvoice",
        "pageRange": ""
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The extraction result from the IxP model",
          "source": "=this.result",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the extraction fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "normalizeData",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Normalize Data"
      },
      "inputs": {
        "script": "const fields = ($vars.extractInvoice.output && $vars.extractInvoice.output.ExtractionResult && $vars.extractInvoice.output.ExtractionResult.ResultsDocument && $vars.extractInvoice.output.ExtractionResult.ResultsDocument.Fields) ? $vars.extractInvoice.output.ExtractionResult.ResultsDocument.Fields : [];\nconst normalized = fields.map(function(f) {\n  return {\n    Id: f.FieldId,\n    Name: f.FieldName,\n    Value: f.Values && f.Values.length > 0 ? f.Values[0] : null,\n    Type: f.FieldType,\n    IsMissing: f.IsMissing,\n    Confidence: f.Confidence\n  };\n});\nreturn { fields: normalized };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Normalized IxP extraction fields",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "crmLookup1",
      "type": "uipath.connector.uipath-uipath-dataservice.query-entity-records",
      "typeVersion": "1.0.0",
      "display": {
        "label": "CRM Lookup"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-uipath-dataservice",
          "connectionId": "d61e5d0e-04af-4f93-95cc-151d81fa08dc",
          "connectionResourceId": "d61e5d0e-04af-4f93-95cc-151d81fa08dc",
          "connectionFolderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "method": "POST",
          "endpoint": "/v2/BillingDisputeCRM/qer",
          "bodyParameters": {
            "$filter": "accountNumber eq =js:$vars.start.output.webhookPayload.customer.accountNumber"
          },
          "uiPathActivityTypeId": "703065b9-a310-33b8-9d4d-12df0a6f520b",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"instanceParameters\":{\"connectorKey\":\"uipath-uipath-dataservice\",\"objectName\":\"QueryEntityRecordsCurated\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"QueryEntityRecordsCurated\",\"operation\":\"list\",\"httpMethod\":\"POST\",\"path\":\"/v2/{entityName}/qer\",\"packageVersion\":\"1.0.0\",\"connectorVersion\":null,\"executionType\":null,\"customFieldsRequestDetails\":null,\"unifiedTypesCompatible\":true}}",
          "inputMetadata": {
            "operation": "list",
            "pagination": {
              "maxPageSize": 1000
            }
          }
        }
      }
    },
    {
      "id": "erpLookup1",
      "type": "uipath.connector.uipath-uipath-dataservice.query-entity-records",
      "typeVersion": "1.0.0",
      "display": {
        "label": "ERP Lookup"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-uipath-dataservice",
          "connectionId": "d61e5d0e-04af-4f93-95cc-151d81fa08dc",
          "connectionResourceId": "d61e5d0e-04af-4f93-95cc-151d81fa08dc",
          "connectionFolderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "method": "POST",
          "endpoint": "/v2/BillingDisputeERP/qer",
          "bodyParameters": {
            "$filter": "=js:\"invoiceNumber eq \" + String($vars.start.output.webhookPayload.invoice.invoiceNumber).trim().toUpperCase().replace(/^(?!MCS-)/, \"MCS-\")"
          },
          "uiPathActivityTypeId": "703065b9-a310-33b8-9d4d-12df0a6f520b",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"instanceParameters\":{\"connectorKey\":\"uipath-uipath-dataservice\",\"objectName\":\"QueryEntityRecordsCurated\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"QueryEntityRecordsCurated\",\"operation\":\"list\",\"httpMethod\":\"POST\",\"path\":\"/v2/{entityName}/qer\",\"packageVersion\":\"1.0.0\",\"connectorVersion\":null,\"executionType\":null,\"customFieldsRequestDetails\":null,\"unifiedTypesCompatible\":true}}",
          "inputMetadata": {
            "operation": "list",
            "pagination": {
              "maxPageSize": 1000
            }
          }
        }
      }
    },
    {
      "id": "mergeLookups",
      "type": "core.logic.merge",
      "typeVersion": "1.0",
      "display": {
        "label": "Merge"
      },
      "inputs": {}
    },
    {
      "id": "detectDiscrepancies",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Discrepancy Detection"
      },
      "inputs": {
        "script": "const disputedItems = ($vars.start.output.webhookPayload && $vars.start.output.webhookPayload.dispute && $vars.start.output.webhookPayload.dispute.disputedLineItems) ? $vars.start.output.webhookPayload.dispute.disputedLineItems : [];\nconst erpRecords = ($vars.erpLookup1.output && Array.isArray($vars.erpLookup1.output)) ? $vars.erpLookup1.output : (($vars.erpLookup1.output && $vars.erpLookup1.output.value) ? $vars.erpLookup1.output.value : []);\nvar totalOvercharge = 0;\nvar totalUndercharge = 0;\nvar mismatches = [];\nfor (var i = 0; i < disputedItems.length; i++) {\n  var item = disputedItems[i];\n  var contractRow = null;\n  for (var j = 0; j < erpRecords.length; j++) {\n    if (erpRecords[j].lineNumber === item.lineNumber) {\n      contractRow = erpRecords[j];\n      break;\n    }\n  }\n  if (contractRow) {\n    var contractAmount = contractRow.amount || (contractRow.quantity * contractRow.unitPrice) || 0;\n    var disputedAmount = item.amount || (item.quantity * item.unitPrice) || 0;\n    var diff = disputedAmount - contractAmount;\n    if (diff > 0) totalOvercharge += diff;\n    if (diff < 0) totalUndercharge += Math.abs(diff);\n    if (diff !== 0) {\n      mismatches.push({\n        lineNumber: item.lineNumber,\n        description: item.description,\n        disputedAmount: disputedAmount,\n        contractAmount: contractAmount,\n        difference: diff\n      });\n    }\n  }\n}\nreturn { mismatches: mismatches, totalOvercharge: totalOvercharge, totalUndercharge: totalUndercharge };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Discrepancy analysis result",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "disputeAnalyst",
      "type": "uipath.agent.autonomous",
      "typeVersion": "1.2",
      "display": {
        "label": "Dispute Analyst Agent"
      },
      "inputs": {
        "systemPrompt": "You are a billing dispute analyst agent.",
        "userPrompt": "Analyze the billing dispute and return your determination.",
        "source": "45c67604-fb88-4cd7-834f-3175fb4345eb",
        "agentInputVariables": [
          {
            "id": "start__output__webhookPayload",
            "type": "object",
            "binding": "=$vars.start.output.webhookPayload",
            "description": "Webhook payload with dispute details"
          },
          {
            "id": "normalizeData__output__fields",
            "type": "array",
            "binding": "=$vars.normalizeData.output.fields",
            "description": "Normalized IxP extraction fields"
          },
          {
            "id": "crmLookup1__output",
            "type": "object",
            "binding": "=$vars.crmLookup1.output",
            "description": "CRM customer data"
          },
          {
            "id": "erpLookup1__output",
            "type": "object",
            "binding": "=$vars.erpLookup1.output",
            "description": "ERP contract/invoice data"
          },
          {
            "id": "detectDiscrepancies__output__mismatches",
            "type": "array",
            "binding": "=$vars.detectDiscrepancies.output.mismatches",
            "description": "List of line-item pricing mismatches"
          },
          {
            "id": "detectDiscrepancies__output__totalOvercharge",
            "type": "number",
            "binding": "=$vars.detectDiscrepancies.output.totalOvercharge",
            "description": "Total amount overcharged"
          },
          {
            "id": "detectDiscrepancies__output__totalUndercharge",
            "type": "number",
            "binding": "=$vars.detectDiscrepancies.output.totalUndercharge",
            "description": "Total amount undercharged"
          }
        ],
        "agentOutputVariables": [
          {
            "id": "determination",
            "type": "string"
          },
          {
            "id": "recommendedAction",
            "type": "string"
          },
          {
            "id": "autoResolutionEligible",
            "type": "boolean"
          },
          {
            "id": "creditAmount",
            "type": "number"
          },
          {
            "id": "confidence",
            "type": "number"
          },
          {
            "id": "rationale",
            "type": "string"
          }
        ]
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Agent response",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "billingDisputeSopIndex",
      "type": "uipath.agent.resource.context.index.billing-dispute-sop-index.cc45b9b4-dbf6-47b3-40ac-08debc0cec5b",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Billing Dispute SOP Index"
      },
      "inputs": {
        "source": "439391e2-0729-47c7-acea-b7d0b73deabe"
      }
    },
    {
      "id": "switchAction",
      "type": "core.logic.switch",
      "typeVersion": "1.1",
      "display": {
        "label": "Switch on Recommended Action"
      },
      "inputs": {
        "cases": [
          {
            "id": "escalate",
            "label": "escalate_to_manager",
            "expression": "$vars.disputeAnalyst.output.recommendedAction === 'escalate_to_manager'"
          },
          {
            "id": "autoResolve",
            "label": "auto_resolve",
            "expression": "$vars.disputeAnalyst.output.recommendedAction === 'auto_resolve'"
          },
          {
            "id": "reject",
            "label": "reject",
            "expression": "$vars.disputeAnalyst.output.recommendedAction === 'reject'"
          }
        ]
      }
    },
    {
      "id": "approvalDecision",
      "type": "core.logic.decision",
      "typeVersion": "1.1",
      "display": {
        "label": "Approval Decision"
      },
      "inputs": {
        "expression": "false",
        "trueLabel": "Rejected",
        "falseLabel": "Approved"
      }
    },
    {
      "id": "logCreditAmount",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log Credit Amount"
      },
      "inputs": {
        "script": "const credit = $vars.disputeAnalyst.output.creditAmount;\nreturn { creditAmount: credit };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Credit amount from analyst",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "financialPosting",
      "type": "uipath.core.api-workflow.07d45a91-9413-4dad-82ff-28306c2d85ea",
      "typeVersion": "1.0.0",
      "display": {
        "label": "FinancialPostingFunction"
      },
      "inputs": {}
    },
    {
      "id": "resolutionWriter",
      "type": "uipath.agent.autonomous",
      "typeVersion": "1.2",
      "display": {
        "label": "Resolution Writer Agent"
      },
      "inputs": {
        "systemPrompt": "You are a resolution email writer agent.",
        "userPrompt": "Draft the customer-facing resolution email.",
        "source": "2b3aae58-72dc-437c-82b8-35d532a2bcb5",
        "agentInputVariables": [
          {
            "id": "start__output__webhookPayload",
            "type": "object",
            "binding": "=$vars.start.output.webhookPayload",
            "description": "Webhook payload with invoice number and customer info"
          },
          {
            "id": "disputeAnalyst__output__creditAmount",
            "type": "number",
            "binding": "=$vars.disputeAnalyst.output.creditAmount",
            "description": "Approved credit amount"
          },
          {
            "id": "disputeAnalyst__output__determination",
            "type": "string",
            "binding": "=$vars.disputeAnalyst.output.determination",
            "description": "Analyst determination"
          },
          {
            "id": "disputeAnalyst__output__rationale",
            "type": "string",
            "binding": "=$vars.disputeAnalyst.output.rationale",
            "description": "Analyst rationale"
          }
        ],
        "agentOutputVariables": [
          {
            "id": "subject",
            "type": "string"
          },
          {
            "id": "body",
            "type": "string"
          }
        ]
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Resolution email draft",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "endResolution",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Return Resolution"
      },
      "inputs": {},
      "outputs": {
        "determination": {
          "source": "=js:$vars.disputeAnalyst.output.determination"
        },
        "recommendedAction": {
          "source": "=js:$vars.disputeAnalyst.output.recommendedAction"
        },
        "creditAmount": {
          "source": "=js:$vars.disputeAnalyst.output.creditAmount"
        },
        "rationale": {
          "source": "=js:$vars.disputeAnalyst.output.rationale"
        },
        "resolutionEmailBody": {
          "source": "=js:$vars.resolutionWriter.output.body"
        }
      }
    },
    {
      "id": "endManagerRejection",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Return Manager Rejection"
      },
      "inputs": {},
      "outputs": {
        "determination": {
          "source": "=js:$vars.disputeAnalyst.output.determination"
        },
        "recommendedAction": {
          "source": "=js:$vars.disputeAnalyst.output.recommendedAction"
        },
        "creditAmount": {
          "source": "=js:$vars.disputeAnalyst.output.creditAmount"
        },
        "rationale": {
          "source": "=js:$vars.disputeAnalyst.output.rationale"
        },
        "resolutionEmailBody": {
          "source": "=js:'No resolution email was drafted — dispute rejected by manager.'"
        }
      }
    },
    {
      "id": "endRejection",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Return Rejection"
      },
      "inputs": {},
      "outputs": {
        "determination": {
          "source": "=js:$vars.disputeAnalyst.output.determination"
        },
        "recommendedAction": {
          "source": "=js:$vars.disputeAnalyst.output.recommendedAction"
        },
        "creditAmount": {
          "source": "=js:$vars.disputeAnalyst.output.creditAmount"
        },
        "rationale": {
          "source": "=js:$vars.disputeAnalyst.output.rationale"
        },
        "resolutionEmailBody": {
          "source": "=js:'No resolution email was drafted — dispute rejected.'"
        }
      }
    }
  ],
  "edges": [
