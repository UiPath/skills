{
  "id": "de1dc8d2-3f51-4692-ae93-9ba490192fd4",
  "version": "1.8",
  "name": "PurchaseApproval",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "2be4c9cf-df1f-4b8c-a22f-07b587c586c1",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "managerApproval1",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "Manager Approves Purchase"
      },
      "inputs": {
        "title": "Purchase Approval",
        "recipient": {
          "channels": [
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group"
          }
        },
        "priority": "Medium",
        "schema": {
          "schemaId": "b7e2f4a1-9c3d-4e8b-a1f6-7d5c2b9e3f0a",
          "fields": [
            {
              "id": "purchaseamount",
              "label": "Purchase Amount",
              "type": "number",
              "direction": "input",
              "binding": "vars.purchaseAmount"
            },
            {
              "id": "vendorname",
              "label": "Vendor Name",
              "type": "string",
              "direction": "input",
              "binding": "vars.vendorName"
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "End"
            }
          ]
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "Action": {
              "type": "string",
              "enum": [
                "Approve",
                "Reject"
              ],
              "default": "Approve"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": [
            "Approve",
            "Reject"
          ],
          "default": "Approve"
        }
      }
    },
    {
      "id": "logApproval1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log Approval"
      },
      "inputs": {
        "script": "return { message: \"Approval recorded.\" };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "end1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {}
    }
  ],
  "edges": [
    {
      "id": "edge-start-managerApproval1",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "managerApproval1",
