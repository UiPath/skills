{
  "id": "822dd2d5-685a-4fce-8494-b0038b4e46fb",
  "version": "1.8",
  "name": "BatchTransformDemo",
  "variables": {
    "globals": [
      {
        "id": "csvFile",
        "direction": "in",
        "type": "file",
        "triggerNodeId": "start"
      },
      {
        "id": "result",
        "direction": "out",
        "type": "file"
      }
    ],
    "nodes": [
      {
        "id": "start.output",
        "type": "object",
        "description": "Data passed when manually triggering the workflow.",
        "binding": {
          "nodeId": "start",
          "outputId": "output"
        }
      },
      {
        "id": "batchTransform.output",
        "type": "file",
        "binding": {
          "nodeId": "batchTransform",
          "outputId": "output"
        }
      },
      {
        "id": "batchTransform.error",
        "type": "object",
        "description": "Error information if the node fails",
        "binding": {
          "nodeId": "batchTransform",
          "outputId": "error"
        }
      },
      {
        "id": "end.result",
        "type": "string",
        "binding": {
          "nodeId": "end",
          "outputId": "result"
        }
      }
    ]
  },
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "55eaff53-150c-47de-b9c0-b195606d3113",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "batchTransform",
      "type": "uipath.pattern.batch-transform",
      "typeVersion": "1.0",
      "display": {
        "label": "Batch Transform"
      },
      "inputs": {
        "attachment": "=js:$vars.start.output.csvFile",
        "prompt": "Classify each row by category and write a one-line summary.",
        "enableWebSearchGrounding": false,
        "outputColumns": [
          {
            "name": "Category",
            "description": "One of: Utility, Software, Travel, Other"
          },
          {
            "name": "Summary",
            "description": "Plain-English one-line summary of the row"
          }
        ]
      },
      "outputs": {
        "output": {
          "type": "file",
          "source": "=response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "outputs": {
        "result": {
          "source": "=js:$vars.batchTransform.output"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "e-start-batchTransform",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "batchTransform",
      "targetPort": "input"
    },
    {
      "id": "e-batchTransform-end",
      "sourceNodeId": "batchTransform",
      "sourcePort": "output",
      "targetNodeId": "end",
      "targetPort": "input"
    }
  ],
  "definitions": [
    {
      "nodeType": "core.trigger.manual",
      "version": "1.0",
      "category": "trigger",
      "description": "Start workflow manually",
      "tags": [
        "trigger",
        "start",
        "manual"
      ],
      "sortOrder": 40,
      "display": {
        "label": "Manual trigger",
        "icon": "play",
        "shape": "circle"
      },
      "handleConfiguration": [
        {
          "position": "right",
          "handles": [
            {
              "id": "output",
              "type": "source",
              "handleType": "output",
              "showButton": true,
              "constraints": {
                "forbiddenTargetCategories": [
                  "trigger"
                ]
              }
            }
          ],
          "visible": true
        }
      ],
      "model": {
        "type": "bpmn:StartEvent",
        "entryPointId": true
      },
      "outputDefinition": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the workflow.",
          "source": "null",
          "var": "output"
        }
      },
      "toolbarExtensions": {
        "design": {
          "actions": [
            {
              "id": "change-trigger-type",
              "icon": "square-mouse-pointer",
              "label": "Change trigger type"
            }
          ]
        }
      }
    },
    {
      "nodeType": "uipath.pattern.batch-transform",
      "version": "1.0",
      "category": "data-operations",
      "tags": [
        "batch",
        "transform",
        "csv"
      ],
      "sortOrder": 35,
      "supportsErrorHandling": true,
      "description": "Add AI-generated columns to a CSV",
      "display": {
        "label": "Batch Transform",
        "icon": "grid-2x2-plus"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ]
        },
        {
          "position": "right",
          "handles": [
            {
              "id": "output",
              "type": "source",
              "handleType": "output"
            },
            {
              "id": "error",
              "label": "Error",
              "type": "source",
              "handleType": "output",
              "visible": "{inputs.errorHandlingEnabled}",
              "constraints": {
                "maxConnections": 1
              }
            }
          ]
        }
      ],
      "model": {
        "type": "bpmn:ServiceTask",
        "serviceType": "ECS.BatchTransform"
      },
      "inputDefinition": {
        "type": "object",
        "properties": {
          "attachment": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "enableWebSearchGrounding": {
            "type": "boolean"
          },
          "outputColumns": {
            "type": "array"
          }
        }
      },
      "inputDefaults": {
        "attachment": "",
        "prompt": "",
        "enableWebSearchGrounding": false,
        "outputColumns": [
          {
            "name": "OutputColumn1",
            "description": "Describe what this new column should contain"
          }
        ]
      },
      "outputDefinition": {
        "output": {
          "type": "file",
          "source": "=response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "form": {
        "id": "batch-transform-properties",
        "title": "Batch Transform Configuration",
        "sections": [
          {
            "id": "source",
            "title": "Data source",
            "collapsible": true,
            "defaultExpanded": true,
            "fields": [
              {
                "name": "inputs.attachment",
                "type": "file",
                "label": "Attachment",
                "description": "CSV file to transform",
                "validation": {
                  "required": true,
                  "messages": {
                    "required": "Attachment is required"
                  }
                }
              },
              {
                "name": "inputs.prompt",
                "type": "custom",
                "component": "prompt-editor",
                "label": "Prompt",
                "description": "Specify the task or query for batch processing",
                "componentProps": {
                  "multiline": true,
                  "minRows": 4,
                  "maxRows": 20,
                  "placeholder": "Specify the task or query for batch processing"
                },
                "validation": {
                  "required": true,
                  "messages": {
                    "required": "Prompt is required"
                  }
                }
              },
              {
                "name": "inputs.enableWebSearchGrounding",
                "type": "checkbox",
                "label": "Enable web search grounding",
                "description": "When enabled, batch transform can use web search to ground or enrich results during processing."
              }
            ]
          },
          {
            "id": "outputColumns",
            "title": "Output columns",
            "collapsible": true,
            "defaultExpanded": true,
            "fields": [
              {
                "name": "inputs.outputColumns",
                "type": "custom",
                "component": "output-columns-editor",
                "label": "",
                "description": "Define the columns to be added to the output data",
                "componentProps": {
                  "maxColumns": 10,
                  "namePlaceholder": "Column name",
                  "descriptionPlaceholder": "Describe what this new column should contain",
                  "addButtonPlacement": "footer"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "nodeType": "core.control.end",
      "version": "1.0",
      "category": "control-flow",
      "description": "Mark the end of a workflow path",
      "tags": [
        "control-flow",
        "end",
        "finish",
        "complete"
      ],
      "sortOrder": 20,
      "display": {
        "label": "End",
        "icon": "circle-check",
        "shape": "circle"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ]
        }
      ],
      "model": {
        "type": "bpmn:EndEvent"
      },
      "runtimeConstraints": {
        "exclude": [
          "api-function"
        ]
      }
    }
  ],
  "runtime": "maestro",
  "layout": {
    "nodes": {
      "start": {
        "position": {
          "x": -192,
          "y": 0
        },
        "size": {
          "width": 96,
          "height": 96
        }
      },
      "batchTransform": {
        "position": {
          "x": 0,
          "y": 0
        },
        "size": {
          "width": 96,
          "height": 96
        }
      },
      "end": {
        "position": {
          "x": 192,
          "y": 0
        },
        "size": {
          "width": 96,
          "height": 96
        }
      }
    }
  }
}