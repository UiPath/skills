{
  "id": "f99dab38-e1ef-4f8c-aaa7-c0635eea7e02",
  "version": "1.8",
  "name": "InvoiceToSAP",
  "variables": {
    "globals": {
      "in": [
        {
          "name": "invoiceFile",
          "type": "string",
          "description": "SharePoint file reference — path or download URL of the PDF invoice to extract"
        }
      ],
      "out": [
        {
          "name": "sapPayload",
          "type": "object",
          "description": "Structured invoice fields extracted by IxP, ready for posting to SAP"
        }
      ]
    }
  },
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "8e64439d-2461-43ad-882c-27a0cd5c7659",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "extractInvoiceFields",
      "type": "uipath.ixp.invoiceixp-cef0d447-ixp.ff973488-5d89-8035-86ac-f980b4be6deb-c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Extract Invoice Fields"
      },
      "inputs": {
        "model": {
          "id": "ff973488-5d89-8035-86ac-f980b4be6deb",
          "modelName": "invoiceixp-cef0d447-ixp",
          "modelDisplayName": "InvoiceIXP",
          "folderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "folderName": "Shared",
          "folderPath": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "description": ""
        },
        "modelName": "invoiceixp-cef0d447-ixp",
        "projectName": "invoiceixp-cef0d447-ixp",
        "versionTag": "",
        "folderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
        "folderName": "Shared",
        "fileRef": "=js:$vars.input.invoiceFile",
        "pageRange": ""
      },
      "outputs": {
        "output": {
          "name": "output",
          "type": "object",
          "source": "=this.result",
          "var": "output",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "properties": {
              "ExtractionResult": {
                "type": "object",
                "properties": {
                  "DocumentId": { "type": "string" },
                  "ResultsVersion": { "type": "integer" },
                  "ResultsDocument": {
                    "type": "object",
                    "properties": {
                      "Fields": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "FieldId": { "type": "string" },
                            "FieldName": { "type": "string" },
                            "FieldType": { "type": "string" },
                            "IsMissing": { "type": "boolean" },
                            "Values": { "type": "array", "items": { "type": "string" } },
                            "Confidence": { "type": "integer" }
                          }
                        }
                      },
                      "Tables": {
                        "type": "array",
                        "items": { "type": "object" }
                      }
                    }
                  }
                }
              },
              "ExtractorPayloads": { "type": "object" },
              "BusinessrulesResults": { "type": "array", "items": { "type": "object" } }
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": ["code", "message", "detail", "category", "status"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "detail": { "type": "string" },
              "category": { "type": "string" },
              "status": { "type": "integer" }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "id": "prepareForSAP",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Prepare SAP Payload"
      },
      "inputs": {
        "script": "// Extract structured invoice fields from the IxP result for SAP posting\nconst fields = $vars.extractInvoiceFields.output.ExtractionResult.ResultsDocument.Fields || [];\nconst get = (name) => fields.find(f => f.FieldName === name)?.Values?.[0] || null;\nreturn {\n  vendorName: get('VendorName') || get('Vendor') || get('vendor_name'),\n  invoiceNumber: get('InvoiceNumber') || get('Invoice Number') || get('invoice_number'),\n  invoiceDate: get('InvoiceDate') || get('Invoice Date') || get('invoice_date'),\n  totalAmount: get('Total') || get('TotalAmount') || get('Invoice Total') || get('total_amount'),\n  currency: get('Currency') || get('currency'),\n  taxAmount: get('Tax') || get('TaxAmount') || get('tax_amount'),\n  lineItems: $vars.extractInvoiceFields.output.ExtractionResult.ResultsDocument.Tables || []\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": ["code", "message", "detail", "category", "status"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "detail": { "type": "string" },
              "category": { "type": "string" },
              "status": { "type": "integer" }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "outputs": {
        "sapPayload": "=js:$vars.prepareForSAP.output"
      }
    }
  ],
  "edges": [
    {
      "id": "e-start-extract",
      "source": "start",
      "target": "extractInvoiceFields",
      "sourceHandle": "output",
      "targetPort": "input"
    },
    {
      "id": "e-extract-script",
      "source": "extractInvoiceFields",
      "target": "prepareForSAP",
      "sourceHandle": "success",
      "targetPort": "input"
    },
    {
      "id": "e-script-end",
      "source": "prepareForSAP",
      "target": "end",
      "sourceHandle": "success",
      "targetPort": "input"
    }
  ],
  "definitions": [
    {
