          "connectionFolderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "method": "GET",
          "endpoint": "/v1/GetFilesFolders",
          "queryParameters": {
            "parentReferenceId": "<SHAREPOINT_FOLDER_ID>",
            "filter": "endswith(name,\".pdf\")"
          },
