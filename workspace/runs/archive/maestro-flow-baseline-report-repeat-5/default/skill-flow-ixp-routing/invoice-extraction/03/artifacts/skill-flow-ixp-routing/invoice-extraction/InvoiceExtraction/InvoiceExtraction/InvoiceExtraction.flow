    {
      "id": "mapInvoiceData1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Map Invoice Fields"
      },
      "inputs": {
        "script": "const fields = ($vars.extractInvoiceFields1.output && $vars.extractInvoiceFields1.output.ExtractionResult && $vars.extractInvoiceFields1.output.ExtractionResult.ResultsDocument && $vars.extractInvoiceFields1.output.ExtractionResult.ResultsDocument.Fields) ? $vars.extractInvoiceFields1.output.ExtractionResult.ResultsDocument.Fields : [];\nconst tables = ($vars.extractInvoiceFields1.output && $vars.extractInvoiceFields1.output.ExtractionResult && $vars.extractInvoiceFields1.output.ExtractionResult.ResultsDocument && $vars.extractInvoiceFields1.output.ExtractionResult.ResultsDocument.Tables) ? $vars.extractInvoiceFields1.output.ExtractionResult.ResultsDocument.Tables : [];\nconst getField = (name) => { const f = fields.find(f => f.FieldName === name); return f && f.Values && f.Values.length > 0 ? f.Values[0] : null; };\nreturn {\n  vendorName: getField('VendorName') || getField('vendor_name') || getField('Vendor'),\n  invoiceNumber: getField('InvoiceId') || getField('invoice_number') || getField('InvoiceNumber'),\n  invoiceDate: getField('InvoiceDate') || getField('invoice_date'),\n  totalAmount: getField('InvoiceTotal') || getField('total_amount') || getField('TotalAmount'),\n  lineItems: tables\n};"
      }
    },
    {
      "id": "postToAccountingSystem1",
      "type": "core.action.http.v2",
      "typeVersion": "2.3",
      "display": {
        "label": "Post to Accounting System"
      },
      "inputs": {
        "branches": [],
        "timeout": "PT15M",
        "retryCount": 0,
        "detail": {
          "connector": "uipath-uipath-http",
          "connectionId": "ImplicitConnection",
          "connectionResourceId": null,
          "connectionFolderKey": null,
          "method": "POST",
          "endpoint": "/http-request",
          "bodyParameters": {
            "authentication": "manual",
            "method": "POST",
            "url": "<ACCOUNTING_SYSTEM_API_URL>",
            "body": {
              "vendorName": "=js:$vars.mapInvoiceData1.output.vendorName",
              "invoiceNumber": "=js:$vars.mapInvoiceData1.output.invoiceNumber",
              "invoiceDate": "=js:$vars.mapInvoiceData1.output.invoiceDate",
              "totalAmount": "=js:$vars.mapInvoiceData1.output.totalAmount",
              "lineItems": "=js:$vars.mapInvoiceData1.output.lineItems"
            }
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"connectorVersion\":\"1.4.50\",\"executionType\":null,\"customFieldsRequestDetails\":null,\"instanceParameters\":{\"connectorKey\":\"uipath-uipath-http\",\"objectName\":\"http-request\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\"},\"objectName\":\"http-request\",\"operation\":\"create\",\"packageVersion\":\"1.0.0\",\"httpMethod\":\"POST\",\"path\":\"/http-request\",\"unifiedTypesCompatible\":true,\"savedJitInputFieldId\":\"in_http-request\"}}",
          "uiPathActivityTypeId": "5c4cc855-b42a-37e6-b910-de8588998fce",
          "errorState": {
