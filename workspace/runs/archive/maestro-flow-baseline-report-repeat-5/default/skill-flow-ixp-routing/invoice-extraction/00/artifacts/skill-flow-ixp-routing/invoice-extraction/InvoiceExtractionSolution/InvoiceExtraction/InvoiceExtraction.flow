                      "Fields": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "FieldId": { "type": "string" },
                            "FieldName": { "type": "string" },
                            "FieldType": { "type": "string" },
                            "IsMissing": { "type": "boolean" },
                            "Values": { "type": "array", "items": { "type": "string" } },
                            "Confidence": { "type": "integer" }
                          }
                        }
                      },
