        "folderName": "Shared",
        "fileRef": "=js:$vars.getInvoiceFile1.output.URL",
        "pageRange": ""
      },
      "outputs": {
        "output": {
          "name": "output",
          "type": "object",
          "source": "=this.result",
          "var": "output",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
