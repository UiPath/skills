    {
      "id": "parseExtractionResults1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": { "label": "Parse Invoice Fields" },
      "inputs": {
        "script": "const fields = $vars.extractInvoiceFields1.output.ExtractionResult.ResultsDocument.Fields || [];\nconst getField = (name) => fields.find(f => f.FieldName === name)?.Values?.[0] || null;\nconst tables = $vars.extractInvoiceFields1.output.ExtractionResult.ResultsDocument.Tables || [];\nreturn {\n  vendorName: getField('VendorName') || getField('vendor') || getField('Vendor'),\n  invoiceNumber: getField('InvoiceNumber') || getField('invoiceNumber') || getField('Invoice Number'),\n  invoiceDate: getField('InvoiceDate') || getField('invoiceDate') || getField('Invoice Date'),\n  totalAmount: getField('TotalAmount') || getField('totalAmount') || getField('Total Amount'),\n  lineItems: tables.map(t => t.Values)\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "end1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": { "label": "End" }
    },
