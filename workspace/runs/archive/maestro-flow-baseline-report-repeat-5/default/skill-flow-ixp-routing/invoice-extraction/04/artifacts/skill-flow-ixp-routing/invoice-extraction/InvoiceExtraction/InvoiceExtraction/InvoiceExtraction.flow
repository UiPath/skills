    {
      "id": "buildInvoicePayload1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Build Invoice Payload"
      },
      "inputs": {
        "language": "javascript",
        "script": "const fields = ($vars.extractInvoiceFields1.output.ExtractionResult || {}).ResultsDocument?.Fields || [];\nconst tables = ($vars.extractInvoiceFields1.output.ExtractionResult || {}).ResultsDocument?.Tables || [];\nconst getField = (name) => fields.find(f => f.FieldName === name)?.Values?.[0] || null;\nreturn {\n  vendorName: getField('vendor_name') || getField('VendorName') || getField('vendor'),\n  invoiceNumber: getField('invoice_number') || getField('InvoiceNumber') || getField('invoice_id'),\n  invoiceDate: getField('invoice_date') || getField('InvoiceDate') || getField('date'),\n  totalAmount: getField('total_amount') || getField('TotalAmount') || getField('total'),\n  lineItems: tables[0]?.Values || []\n};"
      }
    },
    {
      "id": "doneSuccess1",
      "type": "core.control.end",
      "typeVersion": "1.0",
