    {
      "id": "parseReceipt",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Parse merchant, date, total"
      },
      "inputs": {
        "script": "const fields = ($vars.extractReceiptFields.output.ExtractionResult && $vars.extractReceiptFields.output.ExtractionResult.ResultsDocument && $vars.extractReceiptFields.output.ExtractionResult.ResultsDocument.Fields) || [];\nconst find = (names) => {\n  const hit = fields.find(f => names.includes(f.FieldName));\n  return hit && hit.Values && hit.Values[0] ? hit.Values[0] : '';\n};\nconst merchant = find(['merchant_name', 'Merchant', 'vendor', 'store_name', 'Vendor']);\nconst date = find(['purchase_date', 'Date', 'transaction_date', 'date', 'receipt_date']);\nconst total = find(['total_amount', 'Total', 'total', 'amount', 'Amount', 'grand_total']);\nreturn { merchant, date, total };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {},
      "outputs": {
        "merchant": {
          "source": "=js:$vars.parseReceipt.output.merchant"
        },
        "receiptDate": {
          "source": "=js:$vars.parseReceipt.output.date"
        },
        "total": {
          "source": "=js:$vars.parseReceipt.output.total"
        }
      }
    }
