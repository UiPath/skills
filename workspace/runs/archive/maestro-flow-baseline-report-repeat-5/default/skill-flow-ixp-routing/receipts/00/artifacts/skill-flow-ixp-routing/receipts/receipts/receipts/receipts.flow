    {
      "id": "parseReceiptFields",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Parse Merchant, Date, Total"
      },
      "inputs": {
        "script": "const fields = ($vars.extractReceiptFields.output && $vars.extractReceiptFields.output.ExtractionResult && $vars.extractReceiptFields.output.ExtractionResult.ResultsDocument && $vars.extractReceiptFields.output.ExtractionResult.ResultsDocument.Fields) ? $vars.extractReceiptFields.output.ExtractionResult.ResultsDocument.Fields : [];\nconst find = (name) => { const f = fields.find(f => f.FieldName === name); return f && !f.IsMissing && f.Values && f.Values.length > 0 ? f.Values[0] : null; };\nreturn { merchant: find('vendor_name') || find('merchant') || find('store_name') || null, date: find('purchase_date') || find('date') || find('transaction_date') || null, total: find('total_price') || find('total') || find('amount') || null };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {},
      "outputs": {}
    }
