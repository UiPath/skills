    {
      "id": "extractContractFields",
      "type": "uipath.ixp.employment-agreements-d4ee40a0-ixp.97f6f1c4-2b0d-8044-8892-c8809e742924-c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Extract Contract Fields"
      },
      "inputs": {
        "model": {
          "id": "97f6f1c4-2b0d-8044-8892-c8809e742924",
          "modelName": "employment-agreements-d4ee40a0-ixp",
          "modelDisplayName": "employment-agreements-d4ee40a0-ixp",
          "folderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "folderName": "Shared",
          "folderPath": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "description": ""
        },
        "modelName": "employment-agreements-d4ee40a0-ixp",
        "description": "",
        "projectName": "employment-agreements-d4ee40a0-ixp",
        "versionTag": "",
        "folderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
        "folderName": "Shared",
        "fileRef": "=js:$vars.start.output.contractFile",
        "pageRange": ""
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Extraction result from the IxP model",
          "source": "=this.result",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if extraction fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "parseContractFields",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Parse Contract Fields"
      },
      "inputs": {
        "script": "const fields = ($vars.extractContractFields.output && $vars.extractContractFields.output.ExtractionResult && $vars.extractContractFields.output.ExtractionResult.ResultsDocument && $vars.extractContractFields.output.ExtractionResult.ResultsDocument.Fields) ? $vars.extractContractFields.output.ExtractionResult.ResultsDocument.Fields : [];\nconst findField = function(names) {\n  for (var i = 0; i < names.length; i++) {\n    var f = fields.find(function(x) { return x.FieldName === names[i]; });\n    if (f && f.Values && f.Values.length > 0) return f.Values[0];\n  }\n  return '';\n};\nvar party1 = findField(['Party 1', 'EmployerName', 'Employer', 'FirstParty', 'Employee']);\nvar party2 = findField(['Party 2', 'EmployeeName', 'Employee', 'SecondParty', 'Employer']);\nvar partyNames = [party1, party2].filter(function(p) { return p; }).join(', ') || 'Unknown';\nvar effectiveDate = findField(['Effective Date', 'EffectiveDate', 'StartDate', 'Contract Date', 'ContractDate']);\nvar terminationClause = findField(['Termination Clause', 'TerminationClause', 'Termination', 'TerminationDate', 'Notice Period']);\nreturn { partyNames: partyNames, effectiveDate: effectiveDate, terminationClause: terminationClause };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "approvalReview",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "Contract Approval Review"
      },
      "inputs": {
        "schema": {
          "schemaId": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
          "fields": [
            {
              "id": "partyNames",
              "label": "Party Names",
              "type": "text",
              "direction": "input",
              "binding": "vars.parseContractFields.output.partyNames"
            },
            {
              "id": "effectiveDate",
              "label": "Effective Date",
              "type": "text",
              "direction": "input",
              "binding": "vars.parseContractFields.output.effectiveDate"
            },
            {
              "id": "terminationClause",
              "label": "Termination Clause",
              "type": "text",
              "direction": "input",
              "binding": "vars.parseContractFields.output.terminationClause"
            },
            {
              "id": "reviewerComments",
              "label": "Reviewer Comments",
              "type": "text",
              "direction": "output",
              "variable": "vars.reviewerComments"
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "End"
            }
          ]
        },
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group"
          }
        },
        "priority": "Medium",
        "title": "Contract Review Required"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "reviewerComments": {
              "type": "string"
            },
            "Action": {
              "type": "string",
              "enum": [
                "Approve",
                "Reject"
              ],
              "default": "Approve"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": [
            "Approve",
            "Reject"
          ],
          "default": "Approve"
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {}
    }
  ],
  "edges": [
    {
      "id": "edge-start-extract",
