    {
      "id": "e2",
      "sourceNodeId": "classifyEmail1",
      "sourcePort": "success",
      "targetNodeId": "isUrgent1",
      "targetPort": "input"
    },
    {
      "id": "e3",
      "sourceNodeId": "classifyEmail1",
      "sourcePort": "error",
      "targetNodeId": "endError1",
      "targetPort": "input"
    },
    {
      "id": "e4",
      "sourceNodeId": "isUrgent1",
      "sourcePort": "true",
      "targetNodeId": "notifySlack1",
      "targetPort": "input"
    },
    {
      "id": "e5",
      "sourceNodeId": "isUrgent1",
      "sourcePort": "false",
      "targetNodeId": "createTicketMock1",
      "targetPort": "input"
    },
    {
      "id": "e6",
      "sourceNodeId": "notifySlack1",
      "sourcePort": "output",
      "targetNodeId": "replyToCustomerUrgent1",
      "targetPort": "input"
    },
    {
      "id": "e7",
      "sourceNodeId": "replyToCustomerUrgent1",
      "sourcePort": "output",
      "targetNodeId": "endUrgent1",
      "targetPort": "input"
    },
    {
      "id": "e8",
      "sourceNodeId": "createTicketMock1",
      "sourcePort": "output",
      "targetNodeId": "replyToCustomerNormal1",
      "targetPort": "input"
    },
    {
      "id": "e9",
      "sourceNodeId": "replyToCustomerNormal1",
      "sourcePort": "output",
      "targetNodeId": "endNormal1",
      "targetPort": "input"
    }
  ],
