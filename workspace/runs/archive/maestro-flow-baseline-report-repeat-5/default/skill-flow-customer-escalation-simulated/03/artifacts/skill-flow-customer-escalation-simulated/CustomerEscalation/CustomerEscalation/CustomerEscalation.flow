{
  "id": "c2dd35c0-5eea-404e-a50b-19c06f11ff89",
  "version": "1.8",
  "name": "CustomerEscalation",
  "nodes": [
    {
      "id": "emailReceived1",
      "type": "uipath.connector.trigger.uipath-mock-outlook.instant-email-received",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Email Received"
      },
      "inputs": {
        "entryPointId": "8e880503-5c96-4e1c-8bcd-7a2961550a2f",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "classifyEmail1",
      "type": "uipath.agent.autonomous",
      "typeVersion": "1.2",
      "display": {
        "label": "Classify Email"
      },
      "inputs": {
        "systemPrompt": "You are a customer support triage agent.",
        "userPrompt": "Classify the incoming support email.",
        "source": "59fec14f-23bc-46e4-8384-18b4b40bf96d",
        "agentInputVariables": [
          {
            "id": "emailReceived1__output__subject",
            "type": "string",
            "binding": "=$vars.emailReceived1.output.subject",
            "description": "Bound from $vars.emailReceived1.output.subject"
          },
          {
            "id": "emailReceived1__output__body",
            "type": "string",
            "binding": "=$vars.emailReceived1.output.body",
            "description": "Bound from $vars.emailReceived1.output.body"
          },
          {
            "id": "emailReceived1__output__from",
            "type": "string",
            "binding": "=$vars.emailReceived1.output.from",
            "description": "Bound from $vars.emailReceived1.output.from"
          }
        ],
        "agentOutputVariables": [
          {
            "id": "isUrgentTone",
            "type": "boolean"
          },
          {
            "id": "isVip",
            "type": "boolean"
          }
        ],
        "errorHandlingEnabled": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Agent response",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "isUrgent1",
      "type": "core.logic.decision",
      "typeVersion": "1.1",
      "display": {
        "label": "Is Urgent?"
      },
      "inputs": {
        "expression": "$vars.classifyEmail1.output.isUrgentTone === true && $vars.classifyEmail1.output.isVip === true",
        "trueLabel": "Urgent VIP",
        "falseLabel": "Normal"
      }
    },
    {
      "id": "notifySlack1",
      "type": "uipath.connector.uipath-salesforce-slack.send-message-to-channel",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Notify Slack"
      },
      "inputs": {}
    },
    {
      "id": "replyToCustomerUrgent1",
      "type": "uipath.connector.uipath-mock-outlook.reply-to-email",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Reply to Customer Urgent"
      },
      "inputs": {}
    },
    {
      "id": "createTicketMock1",
      "type": "core.logic.mock",
      "typeVersion": "1.0",
      "display": {
        "label": "Create Support Ticket"
      }
    },
    {
      "id": "replyToCustomerNormal1",
      "type": "uipath.connector.uipath-mock-outlook.reply-to-email",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Reply to Customer Normal"
      },
      "inputs": {}
    },
    {
      "id": "endUrgent1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Done (Urgent)"
      }
    },
    {
      "id": "endNormal1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Done (Normal)"
      }
    },
    {
      "id": "endError1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Done (Error)"
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "sourceNodeId": "emailReceived1",
      "sourcePort": "output",
      "targetNodeId": "classifyEmail1",
      "targetPort": "input"
