{
  "id": "40d68394-d5d4-4287-b2e6-2a7da519ee5c",
  "version": "1.8",
  "name": "SupportEmailTriage",
  "nodes": [
    {
      "id": "classifyEmail1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Classify Email"
      },
      "inputs": {
        "script": "const email = $vars.emailReceived1.output;\nconst subject = (email.subject || '').toLowerCase();\nconst bodyText = (email.bodyPreview || '').toLowerCase();\nconst fromAddress = (email.from && email.from.emailAddress ? email.from.emailAddress.address : '').toLowerCase();\nconst text = subject + ' ' + bodyText;\n\nconst vipPatterns = ['enterprise-customer.com', 'bigclient.com', 'vip@example.com', 'ceo@', 'director@', 'vp@'];\nconst isVIP = vipPatterns.some(function(p) { return fromAddress.indexOf(p) !== -1; });\n\nconst urgentKeywords = ['urgent', 'critical', 'outage', 'down', 'asap', 'emergency', 'escalate', 'not working', 'failed', 'failure', 'immediately', 'refund', 'legal', 'lawsuit', 'complaint', 'angry', 'furious', 'unacceptable'];\nconst isUrgent = urgentKeywords.some(function(k) { return text.indexOf(k) !== -1; });\n\nconst isUrgentVIP = isVIP && isUrgent;\nconst fromName = email.from && email.from.emailAddress ? (email.from.emailAddress.name || fromAddress) : fromAddress;\n\nreturn { isUrgentVIP: isUrgentVIP, isVIP: isVIP, isUrgent: isUrgent, fromAddress: fromAddress, fromName: fromName };"
      }
    },
    {
      "id": "isCritical1",
      "type": "core.logic.decision",
      "typeVersion": "1.1",
      "display": {
        "label": "Is Critical?"
      },
      "inputs": {
        "expression": "$vars.classifyEmail1.output.isUrgentVIP === true",
        "trueLabel": "Urgent VIP",
        "falseLabel": "Standard"
      }
    },
    {
      "id": "end1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      }
    },
    {
      "id": "end2",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      }
    },
