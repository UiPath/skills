{
  "id": "f12b8f3b-2744-49c7-a320-4011f2ebc491",
  "version": "1.8",
  "name": "CustomerEscalation",
  "nodes": [
    {
      "id": "emailReceived1",
      "type": "uipath.connector.trigger.uipath-mock-outlook.email-received",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Email Received"
      },
      "inputs": {
        "entryPointId": "bf2377fe-0910-4b66-821d-2a30e2175f1a",
        "isDefaultEntryPoint": true,
        "detail": {
          "connector": "uipath-mock-outlook",
          "connectionId": "00000000-0000-0000-0000-000000000000",
          "connectionResourceId": "00000000-0000-0000-0000-000000000000",
          "connectionFolderKey": "00000000-0000-0000-0000-000000000000",
          "eventParameters": {},
          "objectName": "Message",
          "eventType": "EMAIL_RECEIVED",
          "eventMode": "polling",
          "filterExpression": "",
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"instanceParameters\":{\"connectorKey\":\"uipath-mock-outlook\",\"objectName\":\"Message\",\"activityType\":\"CuratedTrigger\",\"version\":\"1.0.0\",\"eventOperation\":\"EMAIL_RECEIVED\",\"eventMode\":\"polling\",\"supportsStreaming\":false},\"objectName\":\"Message\",\"packageVersion\":\"1.0.0\",\"connectorVersion\":null,\"executionType\":null,\"httpMethod\":null,\"path\":null,\"filter\":null}}",
          "uiPathActivityTypeId": "4e3af23b-d9ee-322c-8a56-b1bbc2e42d6f",
          "errorState": {
            "issues": []
          }
        }
      }
    },
    {
      "id": "classify",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Classify Email"
      },
      "inputs": {
        "errorHandlingEnabled": true,
        "script": "const emailData = $vars.emailReceived1.output;\nconst subject = (emailData.subject || emailData.Subject || '').toLowerCase();\nconst body = (emailData.body || emailData.Body || emailData.bodyPreview || '').toLowerCase();\nconst sender = emailData.from || emailData.sender || emailData.From || '';\nconst senderDomain = (sender.split('@')[1] || '').toLowerCase().trim();\nconst text = subject + ' ' + body;\n\n// Urgency detection\nconst urgentKeywords = ['urgent', 'critical', 'emergency', 'asap', 'immediately', 'down', 'outage', 'broken', 'not working', 'help needed', 'p0'];\nconst matchedKeyword = urgentKeywords.find(function(kw) { return text.includes(kw); });\nconst isUrgent = !!matchedKeyword;\n\n// VIP client detection — important enterprise/partner domains\n// Update this list as your client base grows\nconst vipDomains = [\n  'acmecorp.com',\n  'globaltech.com',\n  'enterprise-partner.com',\n  'bigsystems.io',\n  'keyaccount.net',\n  'strategicclient.com',\n  'platinumpartner.co',\n  'premiumcustomer.org'\n];\nconst isVip = vipDomains.some(function(domain) { return senderDomain === domain; });\n\nreturn {\n  isUrgent: isUrgent,\n  isVip: isVip,\n  isVipUrgent: isUrgent && isVip,\n  reason: isUrgent ? 'Matched keyword: ' + matchedKeyword : 'No urgency keywords detected',\n  subject: emailData.subject || emailData.Subject || '(no subject)',\n  sender: sender,\n  senderDomain: senderDomain\n};"
      }
    },
    {
      "id": "isUrgent",
      "type": "core.logic.decision",
      "typeVersion": "1.1",
      "display": {
        "label": "VIP + Urgent?"
      },
      "inputs": {
        "expression": "$vars.classify.output.isUrgent === true && $vars.classify.output.isVip === true",
        "trueLabel": "VIP Urgent",
        "falseLabel": "Standard"
      }
    },
    {
      "id": "slackAlertToTeam1",
      "type": "uipath.connector.uipath-salesforce-slack.send-message-to-channel",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Slack Alert to Team"
      },
      "inputs": {
        "errorHandlingEnabled": true,
        "detail": {
          "connector": "uipath-salesforce-slack",
          "connectionId": "849e85d8-1aa9-4d52-8bbd-20041c8f05d8",
          "connectionResourceId": "849e85d8-1aa9-4d52-8bbd-20041c8f05d8",
          "connectionFolderKey": "5da18ec0-7de1-4e57-aaf1-ddc8a369c199",
          "method": "POST",
          "endpoint": "/send_message_to_channel_v2",
          "bodyParameters": {
            "text": "=js:\"VIP URGENT email — white glove required!\\nFrom: \" + $vars.classify.output.sender + \" (\" + $vars.classify.output.senderDomain + \")\\nSubject: \" + $vars.classify.output.subject + \"\\nReason: \" + $vars.classify.output.reason"
          },
          "queryParameters": {
            "channel": "C041274J3N2",
            "send_as": "bot"
          },
          "uiPathActivityTypeId": "37a305b2-89b1-315d-b73f-1778839a6c47",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"instanceParameters\":{\"connectorKey\":\"uipath-salesforce-slack\",\"objectName\":\"send_message_to_channel_v2\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"send_message_to_channel_v2\",\"operation\":\"create\",\"httpMethod\":\"POST\",\"path\":\"/send_message_to_channel_v2\",\"packageVersion\":\"1.0.0\",\"connectorVersion\":null,\"executionType\":null,\"customFieldsRequestDetails\":null,\"unifiedTypesCompatible\":true,\"savedJitInputFieldId\":\"in_send_message_to_channel_v2\"}}"
        }
      }
    },
    {
      "id": "replyUrgentAck1",
      "type": "uipath.connector.uipath-mock-outlook.reply-to-email",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Reply Urgent Ack"
      },
      "inputs": {
        "errorHandlingEnabled": true,
        "detail": {
          "connector": "uipath-mock-outlook",
          "connectionId": "00000000-0000-0000-0000-000000000000",
          "connectionResourceId": "00000000-0000-0000-0000-000000000000",
          "connectionFolderKey": "00000000-0000-0000-0000-000000000000",
          "method": "POST",
          "endpoint": "/ReplyToEmail",
          "bodyParameters": {
            "comment": "=js:\"Dear customer,\\n\\nThank you for contacting us. We have received your email regarding: \" + $vars.classify.output.subject + \"\\n\\nThis has been flagged as urgent and a member of our support team will be in touch with you very shortly.\\n\\nBest regards,\\nCustomer Support Team\""
          },
          "queryParameters": {
            "id": "=js:$vars.emailReceived1.output.id"
          },
          "uiPathActivityTypeId": "32a8d360-93ab-34bf-817f-17c8e31040a0",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"instanceParameters\":{\"connectorKey\":\"uipath-mock-outlook\",\"objectName\":\"ReplyToEmail\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"ReplyToEmail\",\"operation\":\"create\",\"httpMethod\":\"POST\",\"path\":\"/ReplyToEmail\",\"packageVersion\":\"1.0.0\",\"connectorVersion\":null,\"executionType\":null,\"customFieldsRequestDetails\":null,\"unifiedTypesCompatible\":true,\"savedJitInputFieldId\":\"in_ReplyToEmail\"}}"
        }
      }
    },
    {
      "id": "doneUrgent",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Done (Urgent)"
      },
      "inputs": {}
    },
    {
      "id": "createJiraTicket1",
      "type": "uipath.connector.uipath-atlassian-jira.create-issue",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Create Jira Ticket"
      },
      "inputs": {
        "errorHandlingEnabled": true,
        "detail": {
          "connector": "uipath-atlassian-jira",
          "connectionId": "f5273a4d-d492-4bcd-a106-5a20bf89a3ef",
          "connectionResourceId": "f5273a4d-d492-4bcd-a106-5a20bf89a3ef",
          "connectionFolderKey": "5da18ec0-7de1-4e57-aaf1-ddc8a369c199",
          "method": "POST",
          "endpoint": "/curated_create_issue",
          "bodyParameters": {
            "fields.project.key": "BT",
            "fields.issuetype.id": "10008",
            "fields.summary": "=js:\"[Support] \" + $vars.classify.output.subject",
            "fields.description": "=js:\"Submitted by: \" + $vars.classify.output.sender + \"\\n\\nOriginal subject: \" + $vars.classify.output.subject"
          },
          "uiPathActivityTypeId": "f90a75ba-d728-34b6-a84a-fb1f995b784b",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"instanceParameters\":{\"connectorKey\":\"uipath-atlassian-jira\",\"objectName\":\"curated_create_issue\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"curated_create_issue\",\"operation\":\"create\",\"httpMethod\":\"POST\",\"path\":\"/curated_create_issue\",\"packageVersion\":\"1.0.0\",\"connectorVersion\":null,\"executionType\":null,\"customFieldsRequestDetails\":{\"objectActionName\":\"GenerateSchema\",\"parameterValues\":[[\"fields_sub_project_sub_key\",\"BT\"],[\"fields_sub_issuetype_sub_id\",\"10008\"]]},\"unifiedTypesCompatible\":true,\"savedJitInputFieldId\":\"in_curated_create_issue\"}}"
        }
      }
    },
    {
      "id": "replyTicketConfirmation1",
      "type": "uipath.connector.uipath-mock-outlook.reply-to-email",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Reply Ticket Confirmation"
      },
      "inputs": {
        "errorHandlingEnabled": true,
        "detail": {
          "connector": "uipath-mock-outlook",
          "connectionId": "00000000-0000-0000-0000-000000000000",
          "connectionResourceId": "00000000-0000-0000-0000-000000000000",
          "connectionFolderKey": "00000000-0000-0000-0000-000000000000",
          "method": "POST",
          "endpoint": "/ReplyToEmail",
          "bodyParameters": {
            "comment": "=js:\"Dear customer,\\n\\nThank you for contacting us. We have created a support ticket for your request.\\n\\nTicket Reference: \" + $vars.createJiraTicket1.output.key + \"\\nSubject: \" + $vars.classify.output.subject + \"\\n\\nOne of our agents will review your request and follow up with you soon.\\n\\nBest regards,\\nCustomer Support Team\""
          },
          "queryParameters": {
            "id": "=js:$vars.emailReceived1.output.id"
          },
          "uiPathActivityTypeId": "32a8d360-93ab-34bf-817f-17c8e31040a0",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"instanceParameters\":{\"connectorKey\":\"uipath-mock-outlook\",\"objectName\":\"ReplyToEmail\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"ReplyToEmail\",\"operation\":\"create\",\"httpMethod\":\"POST\",\"path\":\"/ReplyToEmail\",\"packageVersion\":\"1.0.0\",\"connectorVersion\":null,\"executionType\":null,\"customFieldsRequestDetails\":null,\"unifiedTypesCompatible\":true,\"savedJitInputFieldId\":\"in_ReplyToEmail\"}}"
        }
      }
    },
    {
      "id": "doneNormal",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Done (Normal)"
      },
      "inputs": {}
    },
    {
      "id": "errorHandler",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Error Handler"
      },
      "inputs": {
        "errorHandlingEnabled": false,
        "script": "const classifyErr = ($vars.classify && $vars.classify.error) || {};\nconst slackErr = ($vars.slackAlertToTeam1 && $vars.slackAlertToTeam1.error) || {};\nconst jiraErr = ($vars.createJiraTicket1 && $vars.createJiraTicket1.error) || {};\nconst replyUrgentErr = ($vars.replyUrgentAck1 && $vars.replyUrgentAck1.error) || {};\nconst replyTicketErr = ($vars.replyTicketConfirmation1 && $vars.replyTicketConfirmation1.error) || {};\nconst err = classifyErr.message ? classifyErr : slackErr.message ? slackErr : jiraErr.message ? jiraErr : replyUrgentErr.message ? replyUrgentErr : replyTicketErr.message ? replyTicketErr : {};\nreturn {\n  handled: true,\n  errorCode: err.code || 'UNKNOWN',\n  errorMessage: err.message || 'An unexpected error occurred in the support triage workflow'\n};"
      }
    },
    {
      "id": "doneError",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Done (Error)"
      },
      "inputs": {}
    }
