{
  "id": "67f7d882-349e-4df6-af96-3aed77882fc2",
  "version": "1.8",
  "name": "ExpenseApproval",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "246ccd0a-68f3-41b9-9b9b-4102178ae946",
        "isDefaultEntryPoint": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the trigger.",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "fetchExpense1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Fetch Expense Details"
      },
      "inputs": {
        "script": "// Mock: pull expense details from internal system\nreturn {\n  expenseId: \"EXP-2024-001\",\n  amount: 1250.00,\n  submitterName: \"Jane Smith\",\n  category: \"Travel\"\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "managerReview1",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "Manager Review"
      },
      "inputs": {
        "title": "Expense Approval Request",
        "priority": "Medium",
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group",
            "groupName": "expense-approvers"
          }
        },
        "schema": {
          "schemaId": "b5c2d3e4-1f6a-4b7c-8d9e-0a1b2c3d4e5f",
          "fields": [
            {
              "id": "expenseid",
              "label": "Expense ID",
              "type": "string",
              "direction": "input",
              "binding": "vars.fetchExpense1.output.expenseId"
            },
            {
              "id": "amount",
              "label": "Amount",
              "type": "number",
              "direction": "input",
              "binding": "vars.fetchExpense1.output.amount"
            },
            {
              "id": "submitter",
              "label": "Submitted By",
              "type": "string",
              "direction": "input",
              "binding": "vars.fetchExpense1.output.submitterName"
            },
            {
              "id": "category",
              "label": "Category",
              "type": "string",
              "direction": "input",
              "binding": "vars.fetchExpense1.output.category"
            },
            {
              "id": "rejectionreason",
              "label": "Rejection Reason",
              "type": "string",
              "direction": "output",
              "variable": "vars.rejectionReason",
              "required": false
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "Continue"
            }
          ]
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "rejectionreason": {
              "type": "string"
            },
            "Action": {
              "type": "string",
              "enum": [
                "Approve",
                "Reject"
              ],
              "default": "Approve"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": [
            "Approve",
            "Reject"
          ],
          "default": "Approve"
        }
      }
    },
    {
      "id": "logOutcome1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log Outcome"
      },
      "inputs": {
        "script": "// Read manager's decision and optional rejection reason\nvar decision = $vars.managerReview1.status;\nvar isApproved = decision === \"Approve\";\nvar rejectionReason = $vars.managerReview1.output.rejectionreason;\n\nreturn {\n  expenseId: $vars.fetchExpense1.output.expenseId,\n  submitterName: $vars.fetchExpense1.output.submitterName,\n  amount: $vars.fetchExpense1.output.amount,\n  category: $vars.fetchExpense1.output.category,\n  decision: decision,\n  approved: isApproved,\n  rejectionReason: isApproved ? null : rejectionReason,\n  logMessage: isApproved\n    ? \"Expense \" + $vars.fetchExpense1.output.expenseId + \" APPROVED for \" + $vars.fetchExpense1.output.submitterName + \" (\" + $vars.fetchExpense1.output.category + \", $\" + $vars.fetchExpense1.output.amount + \")\"\n    : \"Expense \" + $vars.fetchExpense1.output.expenseId + \" REJECTED for \" + $vars.fetchExpense1.output.submitterName + \" — Reason: \" + rejectionReason\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "end1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Done"
      },
      "inputs": {}
    }
  ],
  "edges": [
    {
      "id": "edge-start-fetchExpense1",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "fetchExpense1",
      "targetPort": "input"
    },
    {
      "id": "edge-fetchExpense1-managerReview1",
      "sourceNodeId": "fetchExpense1",
      "sourcePort": "success",
      "targetNodeId": "managerReview1",
      "targetPort": "input"
    },
    {
      "id": "edge-managerReview1-logOutcome1",
      "sourceNodeId": "managerReview1",
      "sourcePort": "completed",
      "targetNodeId": "logOutcome1",
      "targetPort": "input"
    },
    {
      "id": "edge-logOutcome1-end1",
      "sourceNodeId": "logOutcome1",
      "sourcePort": "success",
      "targetNodeId": "end1",
      "targetPort": "input"
    }
  ],
