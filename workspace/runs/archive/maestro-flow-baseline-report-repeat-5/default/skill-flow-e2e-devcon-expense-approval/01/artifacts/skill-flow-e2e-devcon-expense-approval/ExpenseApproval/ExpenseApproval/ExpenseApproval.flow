{
  "id": "c582a39d-2d0e-41ba-9aef-8c95585847ff",
  "version": "1.8",
  "name": "ExpenseApproval",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "411a14a5-595b-411a-a3a6-e89979bfcc28",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "fetchExpense1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Fetch Expense Details"
      },
      "inputs": {
        "script": "// Mock: pull expense details from internal system\nreturn {\n  expenseId: \"EXP-2024-001\",\n  submitter: \"Jane Smith\",\n  category: \"Travel\",\n  amount: 1250.00\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "managerReview1",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "Manager Review"
      },
      "inputs": {
        "title": "Expense Approval",
        "priority": "Medium",
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group",
            "value": "expense-approvers"
          }
        },
        "schema": {
          "schemaId": "b8e3f1a2-4c7d-4e9b-a5f6-2d3e8c1f7a4b",
          "fields": [
            {
              "id": "expenseid",
              "label": "Expense ID",
              "type": "string",
              "direction": "input",
              "binding": "vars.fetchExpense1.output.expenseId"
            },
            {
              "id": "submitter",
              "label": "Submitted By",
              "type": "string",
              "direction": "input",
              "binding": "vars.fetchExpense1.output.submitter"
            },
            {
              "id": "category",
              "label": "Category",
              "type": "string",
              "direction": "input",
              "binding": "vars.fetchExpense1.output.category"
            },
            {
              "id": "amount",
              "label": "Amount",
              "type": "number",
              "direction": "input",
              "binding": "vars.fetchExpense1.output.amount"
            },
            {
              "id": "rejectionreason",
              "label": "Rejection Reason",
              "type": "string",
              "direction": "output",
              "variable": "vars.rejectionReason",
              "required": false
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "End"
            }
          ]
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "rejectionreason": {
              "type": "string"
            },
            "Action": {
              "type": "string",
              "enum": [
                "Approve",
                "Reject"
              ],
              "default": "Approve"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": [
            "Approve",
            "Reject"
          ],
          "default": "Approve"
        }
      }
    },
    {
      "id": "logOutcome1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log Outcome"
      },
      "inputs": {
        "script": "// Log the manager's decision and rejection reason (if rejected)\nconst decision = $vars.managerReview1.status;\nconst rejectionReason = $vars.managerReview1.output.rejectionreason;\nreturn {\n  expenseId: $vars.fetchExpense1.output.expenseId,\n  submitter: $vars.fetchExpense1.output.submitter,\n  decision: decision,\n  rejectionReason: decision === \"Reject\" ? rejectionReason : null\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Done"
      },
      "inputs": {}
    }
  ],
  "edges": [
    {
      "id": "edge-start-fetchExpense1",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "fetchExpense1",
      "targetPort": "input"
    },
    {
      "id": "edge-fetchExpense1-managerReview1",
      "sourceNodeId": "fetchExpense1",
      "sourcePort": "success",
      "targetNodeId": "managerReview1",
      "targetPort": "input"
    },
    {
      "id": "edge-managerReview1-logOutcome1",
      "sourceNodeId": "managerReview1",
      "sourcePort": "completed",
      "targetNodeId": "logOutcome1",
      "targetPort": "input"
    },
    {
      "id": "edge-logOutcome1-end",
      "sourceNodeId": "logOutcome1",
      "sourcePort": "success",
      "targetNodeId": "end",
      "targetPort": "input"
    }
  ],
  "definitions": [
    {
      "nodeType": "core.trigger.manual",
      "version": "1.0",
      "category": "trigger",
      "description": "Start workflow manually",
      "tags": [
        "trigger",
