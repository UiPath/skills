{
  "id": "b2d0e10b-04e8-4843-a9c1-e430f2d83953",
  "version": "1.8",
  "name": "CustomerEscalation",
  "nodes": [
    {
      "id": "classifyUrgency1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Classify Urgency"
      },
      "inputs": {
        "script": "var subject = ($vars.emailReceivedOutlook1.output.subject || '').toLowerCase(); var body = $vars.emailReceivedOutlook1.output.body || {}; var bodyText = (body.content || '').toLowerCase(); var text = subject + ' ' + bodyText; var urgentKeywords = ['urgent', 'asap', 'critical', 'emergency', 'outage', 'down', 'broken', 'blocked', 'p0', 'p1', 'immediate', 'hotfix']; var isUrgent = urgentKeywords.some(function(kw) { return text.indexOf(kw) !== -1; }); return { isUrgent: isUrgent };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Urgency classification result",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error if script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "classifyVip1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Classify VIP"
      },
      "inputs": {
        "script": "var emailFrom = $vars.emailReceivedOutlook1.output.from || {}; var senderEmail = ((emailFrom.emailAddress || {}).address || '').toLowerCase(); var vipDomains = ['@acme.com', '@bigcorp.com', '@enterprise.com', '@vip.com', '@partner.com', '@fortune500.com']; var isVip = vipDomains.some(function(d) { return senderEmail.indexOf(d) !== -1; }); return { isVip: isVip, senderEmail: senderEmail };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "VIP classification result",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error if script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "decideRouting1",
      "type": "core.logic.decision",
      "typeVersion": "1.1",
      "display": {
        "label": "Urgent AND VIP?"
      },
      "inputs": {
        "expression": "$vars.classifyUrgency1.output.isUrgent && $vars.classifyVip1.output.isVip",
        "trueLabel": "High-Touch",
        "falseLabel": "Standard"
      }
    },
    {
      "id": "generateTicket1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Generate Support Ticket"
      },
      "inputs": {
        "script": "var subject = ($vars.emailReceivedOutlook1.output.subject || 'No Subject'); var emailFrom = $vars.emailReceivedOutlook1.output.from || {}; var senderEmail = ((emailFrom.emailAddress || {}).address || 'unknown'); var receivedAt = $vars.emailReceivedOutlook1.output.receivedDateTime || ''; var ticketSuffix = receivedAt.replace(/[^0-9]/g, '').substr(2, 8) || '000000'; var ticketId = 'TKT-' + ticketSuffix; var ticketBody = 'Thank you for contacting support. Your support ticket has been created. Ticket ID: ' + ticketId + ' | Subject: ' + subject + ' | Sender: ' + senderEmail + ' | Our team will respond within 24 hours.'; return { ticketId: ticketId, ticketBody: ticketBody, senderEmail: senderEmail };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Generated ticket details",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error if script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "endHighTouch",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End - High Touch"
      },
      "inputs": {}
    },
    {
      "id": "endStandard",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End - Standard"
      },
      "inputs": {}
    },
    {
