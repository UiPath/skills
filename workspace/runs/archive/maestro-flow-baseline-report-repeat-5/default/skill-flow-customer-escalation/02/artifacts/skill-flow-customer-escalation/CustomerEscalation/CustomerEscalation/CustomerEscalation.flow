{
  "id": "67086642-5f89-4f70-8965-95873929ded9",
  "version": "1.8",
  "name": "CustomerEscalation",
  "nodes": [
    {
      "id": "urgencyClassify",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Classify Urgency"
      },
      "inputs": {
        "script": "var email = $vars.emailReceived1.output;\nvar subject = (email && email.subject) ? email.subject.toLowerCase() : '';\nvar bodyContent = (email && email.body && email.body.content) ? email.body.content.toLowerCase() : '';\nvar text = subject + ' ' + bodyContent;\nvar urgentKeywords = ['urgent', 'critical', 'asap', 'emergency', 'immediate', 'escalate', 'outage', 'down', 'broken', 'failure', 'priority', 'sev1', 'severity 1', 'blocker'];\nvar isUrgent = urgentKeywords.some(function(kw) { return text.indexOf(kw) !== -1; });\nreturn { isUrgent: isUrgent, reason: isUrgent ? 'Matched urgency keyword' : 'No urgency keyword found' };"
      }
    },
    {
      "id": "vipClassify",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Classify VIP"
      },
      "inputs": {
        "script": "var email = $vars.emailReceived1.output;\nvar from = (email && email.from && email.from.emailAddress && email.from.emailAddress.address) ? email.from.emailAddress.address.toLowerCase() : '';\nvar vipDomains = ['enterprise.com', 'vip.com', 'premier.com', 'gold.com', 'platinum.com', 'strategic.com', 'partner.com'];\nvar vipPrefixes = ['ceo@', 'cto@', 'cfo@', 'coo@', 'vp@', 'director@', 'president@', 'svp@', 'evp@'];\nvar isVipDomain = vipDomains.some(function(d) { return from.indexOf('@' + d) !== -1; });\nvar isVipPrefix = vipPrefixes.some(function(p) { return from.indexOf(p) !== -1; });\nvar isVip = isVipDomain || isVipPrefix;\nreturn { isVip: isVip, senderEmail: from, reason: isVip ? (isVipDomain ? 'VIP domain' : 'VIP title prefix') : 'Standard sender' };"
      }
    },
    {
      "id": "routeDecision",
      "type": "core.logic.decision",
      "typeVersion": "1.1",
      "display": {
        "label": "Urgent AND VIP?"
      },
      "inputs": {
        "expression": "$vars.urgencyClassify.output.isUrgent === true && $vars.vipClassify.output.isVip === true",
        "trueLabel": "High-Touch",
        "falseLabel": "Standard"
      }
    },
    {
      "id": "generateTicket",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Generate Support Ticket"
      },
      "inputs": {
        "script": "var email = $vars.emailReceived1.output;\nvar from = (email && email.from && email.from.emailAddress && email.from.emailAddress.address) ? email.from.emailAddress.address : 'unknown@unknown.com';\nvar subject = (email && email.subject) ? email.subject : '(no subject)';\nvar msgId = (email && email.id) ? email.id.replace(/[^a-zA-Z0-9]/g, '').substring(0, 8).toUpperCase() : 'SUPPORT';\nvar ticketId = 'TKT-' + msgId;\nvar replyBody = 'Thank you for contacting support. Your request has been received and a ticket has been created.\\n\\nTicket ID: ' + ticketId + '\\nSubject: ' + subject + '\\nPriority: Normal\\n\\nOur support team will respond within 24 business hours.\\n\\nRegards,\\nSupport Team';\nreturn { ticketId: ticketId, senderEmail: from, subject: subject, status: 'Open', priority: 'Normal', replyBody: replyBody };"
      }
    },
    {
      "id": "endHighTouch",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End High-Touch"
      }
    },
    {
      "id": "endStandard",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End Standard"
      }
    },
    {
      "id": "emailReceived1",
      "type": "uipath.connector.trigger.uipath-microsoft-outlook365.email-received",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Email Received"
      },
      "inputs": {
        "entryPointId": "5751755d-c427-405d-93e0-ec2521f4ecae",
        "detail": {
          "connector": "uipath-microsoft-outlook365",
          "connectionId": "75dfafb4-3717-470c-a5f6-bdc144757a67",
          "connectionResourceId": "75dfafb4-3717-470c-a5f6-bdc144757a67",
          "connectionFolderKey": "5da18ec0-7de1-4e57-aaf1-ddc8a369c199",
          "eventParameters": {},
