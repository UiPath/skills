{
  "id": "84177e08-80e0-4e49-9f7c-885b0a8358f5",
  "version": "1.8",
  "name": "CustomerEscalation",
  "nodes": [
    {
      "id": "emailReceived1",
      "type": "uipath.connector.trigger.uipath-microsoft-outlook365.email-received",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Email Received"
      },
      "inputs": {
        "entryPointId": "8b3373e3-beab-428d-8800-eb316a15fe33",
        "isDefaultEntryPoint": true,
        "detail": {
          "connector": "uipath-microsoft-outlook365",
          "connectionId": "75dfafb4-3717-470c-a5f6-bdc144757a67",
          "connectionResourceId": "75dfafb4-3717-470c-a5f6-bdc144757a67",
          "connectionFolderKey": "5da18ec0-7de1-4e57-aaf1-ddc8a369c199",
          "eventParameters": {
            "parentFolderId": "AAMkAGNiNDVjZmJmLTczOTEtNDQ2MS04Njc2LTUwM2I3ZDgxOWQwMAAuAAAAAAAJJRkzOJfsTKZfQqhMUHzlAQAJDKUrZhoLQZ5wELpOfJPCAAAAAAEMAAA="
          },
          "objectName": "Message",
          "eventType": "EMAIL_RECEIVED",
          "eventMode": "polling",
          "filterExpression": "(parentFolderId == 'AAMkAGNiNDVjZmJmLTczOTEtNDQ2MS04Njc2LTUwM2I3ZDgxOWQwMAAuAAAAAAAJJRkzOJfsTKZfQqhMUHzlAQAJDKUrZhoLQZ5wELpOfJPCAAAAAAEMAAA=')",
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"instanceParameters\":{\"connectorKey\":\"uipath-microsoft-outlook365\",\"objectName\":\"Message\",\"activityType\":\"CuratedTrigger\",\"version\":\"1.0.0\",\"eventOperation\":\"EMAIL_RECEIVED\",\"eventMode\":\"polling\",\"supportsStreaming\":false},\"objectName\":\"Message\",\"packageVersion\":\"1.0.0\",\"connectorVersion\":null,\"executionType\":null,\"httpMethod\":null,\"path\":null,\"filter\":null}}",
          "uiPathActivityTypeId": "d76ca053-6e7e-3472-b98c-3094b802d83c",
          "errorState": {
            "issues": []
          }
        }
      }
    },
    {
      "id": "classifyUrgency1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Classify Urgency"
      },
      "inputs": {
        "script": "var subject = ($vars.emailReceived1.output && $vars.emailReceived1.output.subject) ? $vars.emailReceived1.output.subject : '';\nvar body = ($vars.emailReceived1.output && $vars.emailReceived1.output.body && $vars.emailReceived1.output.body.content) ? $vars.emailReceived1.output.body.content : '';\nvar text = (subject + ' ' + body).toLowerCase();\nvar urgentKeywords = ['urgent', 'critical', 'asap', 'emergency', 'priority', 'escalate', 'escalation', 'immediate', 'time-sensitive', 'sev1', 'sev 1', 'p0', 'p1', 'blocker', 'production down', 'outage', 'breach'];\nvar isUrgent = urgentKeywords.some(function(kw) { return text.indexOf(kw) !== -1; });\nreturn { isUrgent: isUrgent };"
      }
    },
    {
      "id": "classifyVip1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Classify VIP"
      },
      "inputs": {
        "script": "var from = '';\nif ($vars.emailReceived1.output && $vars.emailReceived1.output.from && $vars.emailReceived1.output.from.emailAddress) {\n  from = $vars.emailReceived1.output.from.emailAddress.address || '';\n}\nfrom = from.toLowerCase();\nvar vipDomains = ['uipath.com', 'enterprise.com', 'vip.example.com', 'gold.customer.com'];\nvar vipAddresses = ['ceo@acmecorp.com', 'cto@bigclient.com', 'vp.engineering@partner.io'];\nvar domain = from.split('@')[1] || '';\nvar isVip = vipDomains.indexOf(domain) !== -1 || vipAddresses.indexOf(from) !== -1;\nreturn { isVip: isVip, senderEmail: from };"
      }
    },
    {
      "id": "routeDecision1",
      "type": "core.logic.decision",
      "typeVersion": "1.1",
      "display": {
        "label": "Urgent AND VIP?"
      },
      "inputs": {
        "expression": "$vars.classifyUrgency1.output.isUrgent === true && $vars.classifyVip1.output.isVip === true",
        "trueLabel": "High-Touch",
        "falseLabel": "Standard"
      }
    },
    {
      "id": "notifySlackVipEscalation1",
      "type": "uipath.connector.uipath-salesforce-slack.send-message-to-channel",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Notify Slack VIP Escalation"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-salesforce-slack",
          "connectionId": "849e85d8-1aa9-4d52-8bbd-20041c8f05d8",
          "connectionResourceId": "849e85d8-1aa9-4d52-8bbd-20041c8f05d8",
          "connectionFolderKey": "5da18ec0-7de1-4e57-aaf1-ddc8a369c199",
          "method": "POST",
          "endpoint": "/send_message_to_channel_v2",
          "bodyParameters": {
            "channel": "C041274J3N2",
            "text": "=js:'🚨 VIP ESCALATION\\n\\nFrom: ' + (.classifyVip1.output.senderEmail || 'unknown') + '\\nSubject: ' + (.emailReceived1.output.subject || '(no subject)') + '\\n\\nThis email has been classified as URGENT and from a VIP sender. Immediate attention required.'"
          },
          "queryParameters": {
            "send_as": "bot"
          },
          "uiPathActivityTypeId": "37a305b2-89b1-315d-b73f-1778839a6c47",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"instanceParameters\":{\"connectorKey\":\"uipath-salesforce-slack\",\"objectName\":\"send_message_to_channel_v2\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"send_message_to_channel_v2\",\"operation\":\"create\",\"httpMethod\":\"POST\",\"path\":\"/send_message_to_channel_v2\",\"packageVersion\":\"1.0.0\",\"connectorVersion\":null,\"executionType\":null,\"customFieldsRequestDetails\":null,\"unifiedTypesCompatible\":true,\"savedJitInputFieldId\":\"in_send_message_to_channel_v2\"}}"
        }
      }
    },
    {
      "id": "replyAcknowledgment1",
      "type": "uipath.connector.uipath-microsoft-outlook365.reply-to-email",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Reply Acknowledgment"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-microsoft-outlook365",
          "connectionId": "75dfafb4-3717-470c-a5f6-bdc144757a67",
          "connectionResourceId": "75dfafb4-3717-470c-a5f6-bdc144757a67",
          "connectionFolderKey": "5da18ec0-7de1-4e57-aaf1-ddc8a369c199",
          "method": "POST",
          "endpoint": "/ReplyToEmailV2",
          "bodyParameters": {
            "comment": "Thank you for reaching out. Your email has been flagged as a high-priority VIP escalation and our senior support team is already on it. You can expect a personal response within the next 30 minutes.\n\nWe appreciate your patience and take your concerns very seriously.\n\nBest regards,\nCustomer Success Team"
          },
          "queryParameters": {
            "id": "=js:.emailReceived1.output.id",
            "saveAsDraft": false
          },
          "uiPathActivityTypeId": "da9976dd-3d71-35b4-bb8c-509419cb46eb",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"instanceParameters\":{\"connectorKey\":\"uipath-microsoft-outlook365\",\"objectName\":\"ReplyToEmailV2\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"ReplyToEmailV2\",\"operation\":\"create\",\"httpMethod\":\"POST\",\"path\":\"/ReplyToEmailV2\",\"packageVersion\":\"1.0.0\",\"connectorVersion\":null,\"executionType\":null,\"customFieldsRequestDetails\":null,\"unifiedTypesCompatible\":true}}",
          "multipartParameters": [
            {
              "name": "file",
              "dataType": "file"
            },
            {
              "name": "body",
              "dataType": "string"
            }
          ],
          "inputMetadata": {
            "type": "multipart",
            "multipart": {
              "bodyFieldName": "body"
            }
          }
        }
      }
    },
    {
      "id": "endHighTouch1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End High-Touch"
      },
      "inputs": {}
    },
    {
      "id": "generateTicket1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Generate Support Ticket"
      },
      "inputs": {
        "script": "var ts = $vars.emailReceived1.output && $vars.emailReceived1.output.receivedDateTime ? $vars.emailReceived1.output.receivedDateTime : '';\nvar ticketId = 'TKT-' + (ts ? ts.replace(/[^0-9]/g, '').slice(-6) : '000000');\nvar subject = ($vars.emailReceived1.output && $vars.emailReceived1.output.subject) ? $vars.emailReceived1.output.subject : '(no subject)';\nvar sender = $vars.classifyVip1.output.senderEmail || 'unknown';\nvar ticketBody = 'Dear Customer,\\n\\nThank you for reaching out. We have created a support ticket for your request.\\n\\nTicket ID: ' + ticketId + '\\nSubject: ' + subject + '\\nSubmitted by: ' + sender + '\\n\\nOur support team will review your request and get back to you within 24 hours.\\n\\nBest regards,\\nSupport Team';\nreturn { ticketId: ticketId, ticketBody: ticketBody, subject: subject };"
      }
    },
    {
      "id": "replyWithTicketDetails1",
      "type": "uipath.connector.uipath-microsoft-outlook365.reply-to-email",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Reply With Ticket Details"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-microsoft-outlook365",
          "connectionId": "75dfafb4-3717-470c-a5f6-bdc144757a67",
          "connectionResourceId": "75dfafb4-3717-470c-a5f6-bdc144757a67",
          "connectionFolderKey": "5da18ec0-7de1-4e57-aaf1-ddc8a369c199",
          "method": "POST",
          "endpoint": "/ReplyToEmailV2",
          "bodyParameters": {
            "comment": "=js:.generateTicket1.output.ticketBody"
          },
          "queryParameters": {
            "id": "=js:.emailReceived1.output.id",
            "saveAsDraft": false
          },
          "uiPathActivityTypeId": "da9976dd-3d71-35b4-bb8c-509419cb46eb",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"instanceParameters\":{\"connectorKey\":\"uipath-microsoft-outlook365\",\"objectName\":\"ReplyToEmailV2\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"ReplyToEmailV2\",\"operation\":\"create\",\"httpMethod\":\"POST\",\"path\":\"/ReplyToEmailV2\",\"packageVersion\":\"1.0.0\",\"connectorVersion\":null,\"executionType\":null,\"customFieldsRequestDetails\":null,\"unifiedTypesCompatible\":true}}",
          "multipartParameters": [
            {
              "name": "file",
              "dataType": "file"
            },
            {
              "name": "body",
              "dataType": "string"
            }
          ],
          "inputMetadata": {
            "type": "multipart",
            "multipart": {
              "bodyFieldName": "body"
            }
          }
        }
      }
    },
    {
      "id": "endStandard1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End Standard"
      },
