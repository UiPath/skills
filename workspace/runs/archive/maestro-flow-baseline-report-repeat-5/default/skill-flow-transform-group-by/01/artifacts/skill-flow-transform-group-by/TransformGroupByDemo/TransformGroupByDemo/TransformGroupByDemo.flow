      "form": {
        "id": "data-transform-group-by-form",
        "title": "Group By",
        "sections": [
          {
            "defaultExpanded": true,
            "id": "group-by-section",
            "title": "Group By configuration",
            "fields": [
              {
                "name": "inputs",
