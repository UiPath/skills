{
  "id": "d3285e46-c681-4b89-8687-6a396191e910",
  "version": "1.8",
  "name": "TriageEval",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "1f886b9b-6c10-454a-aba2-088139abdeb1",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "triageAgent1",
      "type": "uipath.agent.autonomous",
      "typeVersion": "1.2",
      "display": {
        "label": "Email Triage Agent"
      },
      "inputs": {
        "systemPrompt": "You are an expert email triage agent. Classify incoming support emails.",
        "userPrompt": "Classify the following email: {{input.start__output__email}}",
        "source": "3006c51b-9718-4b35-b051-fc524f79cdfa",
        "agentInputVariables": [
          {
            "id": "start__output__email",
            "type": "string",
            "binding": "=$vars.start.output.email",
            "description": "The raw email text to triage"
          }
        ],
        "agentOutputVariables": [
          {
            "id": "category",
            "type": "string"
          },
          {
            "id": "priority",
            "type": "string"
          }
        ]
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Agent triage result containing category and priority",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the agent fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "end1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "outputs": {
        "category": {
          "source": "=js:$vars.triageAgent1.output.category"
        },
        "priority": {
          "source": "=js:$vars.triageAgent1.output.priority"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "edge-start-agent",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "triageAgent1",
      "targetPort": "input"
    },
    {
      "id": "edge-agent-end",
      "sourceNodeId": "triageAgent1",
      "sourcePort": "success",
      "targetNodeId": "end1",
      "targetPort": "input"
    }
  ],
  "definitions": [
    {
      "nodeType": "core.trigger.manual",
      "version": "1.0",
      "category": "trigger",
      "description": "Start workflow manually",
      "tags": [
        "trigger",
        "start",
        "manual"
      ],
      "sortOrder": 40,
      "display": {
        "label": "Manual trigger",
        "icon": "play",
        "shape": "circle"
      },
      "handleConfiguration": [
        {
          "position": "right",
          "handles": [
            {
              "id": "output",
              "type": "source",
              "handleType": "output",
              "showButton": true,
              "constraints": {
                "forbiddenTargetCategories": [
                  "trigger"
                ]
              }
            }
          ],
          "visible": true
        }
      ],
      "model": {
        "type": "bpmn:StartEvent",
        "entryPointId": true
      },
      "outputDefinition": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the workflow.",
          "source": "null",
          "var": "output"
        }
      },
      "toolbarExtensions": {
        "design": {
          "actions": [
            {
              "id": "change-trigger-type",
              "icon": "square-mouse-pointer",
              "label": "Change trigger type"
            }
          ]
        }
      }
    },
    {
      "nodeType": "uipath.agent.autonomous",
      "version": "1.2",
      "category": "agent",
      "description": "AI agent that completes tasks autonomously",
      "tags": [
        "agentic",
        "ai",
        "autonomous",
        "agent"
      ],
      "sortOrder": 5,
      "supportsErrorHandling": true,
      "display": {
        "label": "Autonomous Agent",
        "icon": "autonomous-agent",
        "shape": "rectangle"
      },
      "handleConfiguration": [
        {
          "position": "top",
          "handles": [
            {
              "id": "escalation",
              "type": "source",
              "handleType": "artifact",
              "label": "Escalations",
              "showButton": true,
              "constraints": {
                "allowedTargets": [
                  {
                    "nodeType": "uipath.agent.resource.escalation"
                  },
                  {
                    "nodeType": "uipath.agent.resource.escalation.*"
                  }
                ],
                "validationMessage": "Only Agent Escalation nodes can connect here",
                "addNodePanel": {
                  "searchScope": "deep",
                  "searchProviders": []
                }
              }
            }
          ]
        },
        {
          "position": "bottom",
          "handles": [
            {
              "id": "context",
              "type": "source",
              "handleType": "artifact",
              "label": "Context",
              "showButton": true,
              "constraints": {
                "allowedTargets": [
                  {
                    "nodeType": "uipath.agent.resource.context.*"
                  }
                ],
                "validationMessage": "Only Context resource nodes can connect here",
                "addNodePanel": {
                  "searchScope": "deep",
                  "searchProviders": [],
                  "refreshOnFocus": "context",
                  "createNewActions": [
                    {
                      "label": "Create new Context",
                      "icon": "external-link",
                      "description": "Opens in a new tab",
                      "urlTemplate": "/{org}/agents_/indexes/add",
                      "categoryId": "agent"
                    }
                  ]
                }
              }
            },
            {
              "id": "tool",
              "type": "source",
              "handleType": "artifact",
              "label": "Tools",
              "showButton": true,
              "constraints": {
                "allowedTargets": [
                  {
                    "nodeType": "uipath.agent.resource.tool.*"
                  }
                ],
                "validationMessage": "Only Tool resource nodes can connect here",
                "addNodePanel": {
                  "searchScope": "deep",
                  "searchProviders": [],
                  "refreshOnFocus": "mcp",
                  "createNewActions": [
                    {
                      "label": "Create new MCP server",
                      "icon": "plus",
                      "urlTemplate": "/{org}/{tenant}/orchestrator_/mcp",
                      "categoryId": "agent.tool.mcp"
                    }
                  ]
                }
              }
            }
          ]
        },
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ]
        },
        {
          "position": "right",
          "handles": [
            {
              "id": "success",
              "type": "source",
              "handleType": "output",
              "isDefaultForType": true
            },
            {
              "id": "error",
              "label": "Error",
              "type": "source",
              "handleType": "output",
              "visible": "{inputs.errorHandlingEnabled}",
              "constraints": {
                "maxConnections": 1
              }
            }
          ]
        }
      ],
      "model": {
        "type": "bpmn:ServiceTask",
        "serviceType": "Orchestrator.StartInlineAgentJob",
        "version": "v2",
        "source": true
      }
    },
    {
      "nodeType": "core.control.end",
      "version": "1.0",
      "category": "control-flow",
      "description": "Mark the end of a workflow path",
      "tags": [
        "control-flow",
        "end",
        "finish",
        "complete"
      ],
      "sortOrder": 20,
      "display": {
        "label": "End",
        "icon": "circle-check",
        "shape": "circle"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ]
        }
      ],
      "model": {
        "type": "bpmn:EndEvent"
      },
      "runtimeConstraints": {
        "exclude": [
          "api-function"
        ]
      }
    }
  ],
  "variables": {
    "globals": [
      {
        "id": "email",
        "direction": "in",
        "type": "string",
        "description": "The raw email text to triage",
        "triggerNodeId": "start"
      },
      {
        "id": "category",
        "direction": "out",
        "type": "string",
        "description": "Triage category assigned by the agent"
      },
      {
        "id": "priority",
        "direction": "out",
        "type": "string",
        "description": "Priority level assigned by the agent"
      }
    ],
    "nodes": [
      {
        "id": "start.output",
        "type": "object",
        "description": "Data passed when manually triggering the workflow.",
        "binding": {
          "nodeId": "start",
          "outputId": "output"
        }
      },
      {
        "id": "triageAgent1.output",
        "type": "object",
        "description": "Agent triage result containing category and priority",
        "binding": {
          "nodeId": "triageAgent1",
          "outputId": "output"
        }
      },
      {
        "id": "triageAgent1.error",
        "type": "object",
        "description": "Error information if the agent fails",
        "binding": {
          "nodeId": "triageAgent1",
          "outputId": "error"
        }
      },
      {
        "id": "end1.category",
        "type": "string",
        "binding": {
          "nodeId": "end1",
          "outputId": "category"
        }
      },
      {
        "id": "end1.priority",
        "type": "string",
        "binding": {
          "nodeId": "end1",
          "outputId": "priority"
        }
      }
    ],
    "variableUpdates": {}
  },
  "runtime": "maestro",
  "layout": {
    "nodes": {
      "start": {
        "position": {
          "x": -192,
          "y": 0
        },
        "size": {
          "width": 96,
          "height": 96
        },
        "collapsed": false
      },
      "triageAgent1": {
        "position": {
          "x": 0,
          "y": 0
        },
        "size": {
          "width": 288,
          "height": 96
        },
        "collapsed": false
      },
      "end1": {
        "position": {
          "x": 384,
