{
  "id": "6bcee71a-97bf-4224-b122-020633b32b27",
  "version": "1.8",
  "name": "ContractReview",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "f0b90b96-e0fa-4760-9579-706ed8b9b9c0",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "extractMeta",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "extractMeta"
      },
      "inputs": {
        "script": "return { message: 'Extracting contract metadata' };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "legalReview",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "Legal Review"
      },
      "inputs": {
        "schema": {
          "schemaId": "a3f7c2d1-5e84-4b96-8f20-1d3e7a9b0c45",
          "fields": [
            {
              "id": "contract_id",
              "label": "Contract ID",
              "type": "text",
              "direction": "input",
              "binding": "vars.start.output.contract_id"
            },
            {
              "id": "contract_value",
              "label": "Contract Value",
              "type": "number",
              "direction": "input",
              "binding": "vars.start.output.contract_value"
            },
            {
              "id": "approved",
              "label": "Approved",
              "type": "boolean",
              "direction": "output",
              "required": true,
              "variable": "vars.approved"
            },
            {
              "id": "legal_notes",
              "label": "Legal Notes",
              "type": "text",
              "direction": "output",
              "required": false,
              "variable": "vars.legal_notes"
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "Continue"
            }
          ]
        },
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group"
          }
        },
        "priority": "Medium"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "approved": {
              "type": "boolean"
            },
            "legal_notes": {
              "type": "string"
            },
            "Action": {
              "type": "string",
              "enum": [
                "Approve",
                "Reject"
              ],
              "default": "Approve"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": [
            "Approve",
            "Reject"
          ],
          "default": "Approve"
        }
      }
    },
    {
      "id": "end1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {},
      "outputs": {
        "approved": {
          "source": "=js:$vars.legalReview.output.approved"
        },
        "legal_notes": {
          "source": "=js:$vars.legalReview.output.legal_notes"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "edge_start_output_extractMeta_input",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "extractMeta",
      "targetPort": "input"
    },
    {
      "id": "edge_extractMeta_success_legalReview_input",
      "sourceNodeId": "extractMeta",
      "sourcePort": "success",
      "targetNodeId": "legalReview",
      "targetPort": "input"
    },
    {
      "id": "edge_legalReview_completed_end1_input",
      "sourceNodeId": "legalReview",
      "sourcePort": "completed",
      "targetNodeId": "end1",
      "targetPort": "input"
    }
  ],
  "definitions": [
    {
