{
  "id": "3646874a-1941-45da-a08a-22638376addf",
  "version": "1.8",
  "name": "QueueWrite",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "2429f2af-1016-4f86-b886-973ac2a8f9a9",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "enqueueItem",
      "type": "core.action.queue.create",
      "typeVersion": "1.2",
      "display": {
        "label": "Write Queue Item"
      },
      "inputs": {
        "queue": "MyQueue",
        "itemData": "=js:JSON.stringify({ payload: \"Hello from Flow\" })",
        "priority": "Normal"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the queue operation",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the queue operation fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      }
    }
  ],
  "edges": [
    {
      "id": "edge-start-enqueue",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "enqueueItem",
      "targetPort": "input"
    },
    {
      "id": "edge-enqueue-end",
      "sourceNodeId": "enqueueItem",
      "sourcePort": "success",
      "targetNodeId": "end",
      "targetPort": "input"
    }
  ],
