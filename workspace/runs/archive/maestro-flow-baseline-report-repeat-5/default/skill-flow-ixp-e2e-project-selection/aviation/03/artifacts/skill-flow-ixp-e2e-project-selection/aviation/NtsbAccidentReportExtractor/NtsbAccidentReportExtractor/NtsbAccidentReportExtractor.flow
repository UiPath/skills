      "id": "extractReport",
      "type": "uipath.ixp.aviation-investigation-final-report-demo-a42b1d4d-ixp.937c414b-7879-8059-8b29-e8401d2dd3ba-c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Extract NTSB Report Fields"
      },
      "inputs": {
        "model": {
          "id": "937c414b-7879-8059-8b29-e8401d2dd3ba",
          "modelName": "aviation-investigation-final-report-demo-a42b1d4d-ixp",
          "modelDisplayName": "aviation-investigation-final-report-demo-a42b1d4d-ixp",
          "folderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "folderName": "Shared",
          "folderPath": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "description": ""
        },
        "modelName": "aviation-investigation-final-report-demo-a42b1d4d-ixp",
        "description": "",
        "projectName": "aviation-investigation-final-report-demo-a42b1d4d-ixp",
        "versionTag": "",
        "folderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
        "folderName": "Shared",
        "fileRef": "=js:$vars.reportPdf",
        "pageRange": ""
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "IxP extraction result",
          "source": "=this.result",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "logNtsbNumber",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log NTSB Number"
      },
      "inputs": {
        "script": "var fields = ($vars.extractReport.output.ExtractionResult && $vars.extractReport.output.ExtractionResult.ResultsDocument && $vars.extractReport.output.ExtractionResult.ResultsDocument.Fields) ? $vars.extractReport.output.ExtractionResult.ResultsDocument.Fields : [];\nfunction getField(name) {\n  var f = fields.find(function(x) { return x.FieldName === name; });\n  return (f && f.Values && f.Values.length > 0) ? f.Values[0] : null;\n}\nvar ntsbNumber = getField('NTSB Number') || getField('ntsb_number') || getField('NTSBNumber') || getField('accident_number') || getField('Accident Number') || null;\nvar eventDate = getField('Event Date') || getField('event_date') || getField('EventDate') || getField('Accident Date') || null;\nvar city = getField('City') || getField('city') || null;\nvar state = getField('State') || getField('state') || null;\nvar location = (city && state) ? (city + ', ' + state) : (city || state || null);\nvar aircraftMake = getField('Aircraft Make') || getField('aircraft_make') || getField('Make') || null;\nvar aircraftModel = getField('Aircraft Model') || getField('aircraft_model') || getField('Model') || null;\nvar aircraftMakeModel = (aircraftMake && aircraftModel) ? (aircraftMake + ' ' + aircraftModel) : (aircraftMake || aircraftModel || null);\nvar aircraftDamage = getField('Aircraft Damage') || getField('aircraft_damage') || getField('Damage') || null;\nreturn {\n  ntsbNumber: ntsbNumber,\n  eventDate: eventDate,\n  location: location,\n  aircraftMakeModel: aircraftMakeModel,\n  aircraftDamage: aircraftDamage\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "end1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      }
    }
  ],
  "edges": [
