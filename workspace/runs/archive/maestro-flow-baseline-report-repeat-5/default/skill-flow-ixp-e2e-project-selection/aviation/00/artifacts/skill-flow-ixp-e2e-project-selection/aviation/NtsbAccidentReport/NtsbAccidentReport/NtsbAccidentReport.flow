    {
      "id": "logNtsbNumber",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log NTSB Number"
      },
      "inputs": {
        "script": "const fields = $vars.extractNtsbReport.output?.ExtractionResult?.ResultsDocument?.Fields ?? [];\nconst get = (name) => fields.find(f => f.FieldName === name)?.Values?.[0] ?? null;\nconst ntsbNumber = get('Accident Number') ?? get('NTSB Number') ?? get('NTSB Accident Number') ?? get('Accident No');\nconst eventDate = get('Event Date') ?? get('Date of Accident') ?? get('Accident Date') ?? get('Date');\nconst city = get('City') ?? get('Accident City') ?? get('Accident Location City');\nconst state = get('State') ?? get('Accident State') ?? get('Accident Location State');\nconst aircraftMake = get('Aircraft Make') ?? get('Make');\nconst aircraftModel = get('Aircraft Model') ?? get('Model');\nconst aircraftDamage = get('Aircraft Damage') ?? get('Damage');\nreturn {\n  ntsbNumber,\n  eventDate,\n  city,\n  state,\n  location: city && state ? city + ', ' + state : (city ?? state),\n  aircraftMake,\n  aircraftModel,\n  aircraftDamage\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      }
    }
