    {
      "id": "logNtsbNumber",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log NTSB Number"
      },
      "inputs": {
        "script": "const fields = $vars.extractNtsbFields.output?.ExtractionResult?.ResultsDocument?.Fields || [];\nconst find = name => (fields.find(f => f.FieldName === name)?.Values || [])[0] || '';\nconst ntsbNumber = find('NTSB Number');\nconst eventDate = find('Event Date');\nconst city = find('City');\nconst state = find('State');\nconst aircraftMake = find('Aircraft Make');\nconst aircraftModel = find('Aircraft Model');\nconst aircraftDamage = find('Aircraft Damage');\nreturn {\n  ntsbNumber,\n  eventDate,\n  location: [city, state].filter(Boolean).join(', '),\n  aircraftMakeModel: [aircraftMake, aircraftModel].filter(Boolean).join(' '),\n  aircraftDamage\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "outputs": {
        "ntsbNumber": {
          "source": "=js:$vars.logNtsbNumber.output.ntsbNumber"
        },
        "eventDate": {
          "source": "=js:$vars.logNtsbNumber.output.eventDate"
        },
        "location": {
          "source": "=js:$vars.logNtsbNumber.output.location"
        },
        "aircraftMakeModel": {
          "source": "=js:$vars.logNtsbNumber.output.aircraftMakeModel"
        },
        "aircraftDamage": {
          "source": "=js:$vars.logNtsbNumber.output.aircraftDamage"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "edge-start-extract",
