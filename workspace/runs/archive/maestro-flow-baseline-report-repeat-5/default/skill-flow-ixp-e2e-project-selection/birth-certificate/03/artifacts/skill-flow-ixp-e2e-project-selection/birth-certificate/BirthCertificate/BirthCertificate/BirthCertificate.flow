    {
      "id": "logChildName",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log Child Full Name"
      },
      "inputs": {
        "script": "const fields = ($vars.extractBirthCertificate.output.ExtractionResult || {}).ResultsDocument && $vars.extractBirthCertificate.output.ExtractionResult.ResultsDocument.Fields || [];\nconst findField = function(name) {\n  const f = fields.find(function(x) { return x.FieldName === name; });\n  return f && f.Values && f.Values[0] ? f.Values[0] : null;\n};\nconst childFullName = findField('Full Name') || findField('Child Full Name') || findField('Child Name') || findField('Name') || null;\nconst dateOfBirth = findField('Date of Birth') || findField('Birth Date') || findField('DOB') || null;\nconst placeOfBirth = findField('Place of Birth') || findField('Birth Place') || findField('Birth City') || findField('City of Birth') || null;\nconst fatherName = findField(\"Father's Full Name\") || findField('Father Name') || findField(\"Father's Name\") || findField('Father') || null;\nconst motherName = findField(\"Mother's Full Name\") || findField('Mother Name') || findField(\"Mother's Name\") || findField('Mother') || null;\nreturn {\n  childFullName: childFullName,\n  dateOfBirth: dateOfBirth,\n  placeOfBirth: placeOfBirth,\n  fatherName: fatherName,\n  motherName: motherName\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "status": {
                "type": "integer"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "outputs": {
        "childFullName": {
          "source": "=js:$vars.logChildName.output.childFullName"
        }
      }
