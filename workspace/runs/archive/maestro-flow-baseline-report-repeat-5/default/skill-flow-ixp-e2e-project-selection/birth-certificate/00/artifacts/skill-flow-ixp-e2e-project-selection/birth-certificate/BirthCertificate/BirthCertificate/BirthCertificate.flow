          "folderName": "Shared",
          "folderPath": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "description": ""
        },
        "modelName": "birth_certificates_oob-6252526a-ixp",
        "description": "",
        "projectName": "birth_certificates_oob-6252526a-ixp",
        "versionTag": "",
        "folderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
        "folderName": "Shared",
        "fileRef": "=js:$vars.start.output.certificate",
        "pageRange": ""
      },
      "outputs": {
        "output": {
          "name": "output",
          "type": "object",
          "source": "=this.result",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "logChildName",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log Child Full Name"
      },
      "inputs": {
        "script": "var fields = ($vars.extractBirthCertificate.output.ExtractionResult && $vars.extractBirthCertificate.output.ExtractionResult.ResultsDocument && $vars.extractBirthCertificate.output.ExtractionResult.ResultsDocument.Fields) ? $vars.extractBirthCertificate.output.ExtractionResult.ResultsDocument.Fields : [];\nfunction findField(names) {\n  for (var i = 0; i < names.length; i++) {\n    var match = fields.find(function(f) { return f.FieldName === names[i]; });\n    if (match && match.Values && match.Values.length > 0) return match.Values[0];\n  }\n  return null;\n}\nvar childFullName = findField(['full_name', 'FullName', 'Child Full Name', 'child_full_name', 'Name']);\nvar dateOfBirth = findField(['date_of_birth', 'DateOfBirth', 'Date of Birth', 'BirthDate']);\nvar placeOfBirth = findField(['place_of_birth', 'PlaceOfBirth', 'Place of Birth', 'BirthPlace']);\nvar fatherName = findField(['father_name', 'FatherName', 'Father Name', 'father_full_name']);\nvar motherName = findField(['mother_name', 'MotherName', 'Mother Name', 'mother_full_name']);\nreturn { childFullName: childFullName, dateOfBirth: dateOfBirth, placeOfBirth: placeOfBirth, fatherName: fatherName, motherName: motherName };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {}
    }
  ],
