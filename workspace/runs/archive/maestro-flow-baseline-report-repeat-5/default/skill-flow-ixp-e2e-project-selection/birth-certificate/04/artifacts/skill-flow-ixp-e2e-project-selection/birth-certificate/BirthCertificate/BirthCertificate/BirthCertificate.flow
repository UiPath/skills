    {
      "id": "logChildName",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log Child Full Name"
      },
      "inputs": {
        "script": "const fields = ($vars.extractBirthCertificate.output.ExtractionResult && $vars.extractBirthCertificate.output.ExtractionResult.ResultsDocument && $vars.extractBirthCertificate.output.ExtractionResult.ResultsDocument.Fields) ? $vars.extractBirthCertificate.output.ExtractionResult.ResultsDocument.Fields : [];\nconst childFullName = (fields.find(function(f) { return f.FieldName === 'Child Full Name'; }) || fields.find(function(f) { return f.FieldName === 'child_full_name'; }) || fields.find(function(f) { return f.FieldName === 'ChildName'; }) || fields.find(function(f) { return f.FieldName === 'Full Name'; }) || {});\nconst dateOfBirth = (fields.find(function(f) { return f.FieldName === 'Date of Birth'; }) || fields.find(function(f) { return f.FieldName === 'date_of_birth'; }) || fields.find(function(f) { return f.FieldName === 'DateOfBirth'; }) || {});\nconst placeOfBirth = (fields.find(function(f) { return f.FieldName === 'Place of Birth'; }) || fields.find(function(f) { return f.FieldName === 'place_of_birth'; }) || fields.find(function(f) { return f.FieldName === 'PlaceOfBirth'; }) || {});\nconst fatherName = (fields.find(function(f) { return f.FieldName === \"Father's Name\"; }) || fields.find(function(f) { return f.FieldName === 'father_name'; }) || fields.find(function(f) { return f.FieldName === 'FatherName'; }) || {});\nconst motherName = (fields.find(function(f) { return f.FieldName === \"Mother's Name\"; }) || fields.find(function(f) { return f.FieldName === 'mother_name'; }) || fields.find(function(f) { return f.FieldName === 'MotherName'; }) || {});\nconst childFullNameValue = (childFullName.Values && childFullName.Values[0]) ? childFullName.Values[0] : null;\nconst dateOfBirthValue = (dateOfBirth.Values && dateOfBirth.Values[0]) ? dateOfBirth.Values[0] : null;\nconst placeOfBirthValue = (placeOfBirth.Values && placeOfBirth.Values[0]) ? placeOfBirth.Values[0] : null;\nconst fatherNameValue = (fatherName.Values && fatherName.Values[0]) ? fatherName.Values[0] : null;\nconst motherNameValue = (motherName.Values && motherName.Values[0]) ? motherName.Values[0] : null;\nreturn {\n  childFullName: childFullNameValue,\n  dateOfBirth: dateOfBirthValue,\n  placeOfBirth: placeOfBirthValue,\n  fatherName: fatherNameValue,\n  motherName: motherNameValue\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
