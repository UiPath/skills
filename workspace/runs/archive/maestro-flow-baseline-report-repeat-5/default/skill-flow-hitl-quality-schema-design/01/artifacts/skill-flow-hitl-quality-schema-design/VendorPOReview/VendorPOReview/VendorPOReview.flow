{
  "id": "abc81f08-954a-4d74-8376-1a1de20d000d",
  "version": "1.8",
  "name": "VendorPOReview",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "fedeb5a1-bd8c-4a45-a13c-fa381c84a0be",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "fetchPoData1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Fetch PO Data"
      },
      "inputs": {
        "script": "return {\n  poNumber: \"PO-2024-00742\",\n  vendorName: \"Acme Supplies Ltd.\",\n  totalAmount: 18750.00\n};"
      }
    },
    {
      "id": "poReview1",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "PO Review"
      },
      "inputs": {
        "title": "Purchase Order Review",
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group"
          }
        },
        "priority": "High",
        "schema": {
          "schemaId": "d4e7f812-3a9b-4c62-b1f5-8e2d0a5c3f91",
          "fields": [
            {
              "id": "ponumber",
              "label": "PO Number",
              "type": "string",
              "direction": "input",
              "binding": "vars.fetchPoData1.output.poNumber"
            },
            {
              "id": "vendorname",
              "label": "Vendor Name",
              "type": "string",
              "direction": "input",
              "binding": "vars.fetchPoData1.output.vendorName"
            },
            {
              "id": "totalamount",
              "label": "Total Amount",
              "type": "number",
              "direction": "input",
              "binding": "vars.fetchPoData1.output.totalAmount"
            },
            {
              "id": "decision",
              "label": "Decision",
              "type": "string",
              "direction": "output",
              "variable": "vars.decision",
              "required": true
            },
            {
              "id": "notes",
              "label": "Notes",
              "type": "string",
              "direction": "output",
              "variable": "vars.notes",
              "required": false
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "End"
            }
          ]
        }
      }
    },
    {
      "id": "routeOnDecision1",
      "type": "core.logic.decision",
      "typeVersion": "1.1",
      "display": {
        "label": "Route on Decision"
      },
      "inputs": {
        "expression": "=js:$vars.poReview1.status === \"Approve\"",
        "TrueLabel": "Approve",
        "FalseLabel": "Reject"
      }
    },
    {
      "id": "logPoApproved1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log PO Approved"
      },
      "inputs": {
        "script": "const decision = $vars.poReview1.output.decision;\nconst notes = $vars.poReview1.output.notes;\nconsole.log(\"PO approved\");\nconsole.log(\"Decision:\", decision);\nif (notes) console.log(\"Notes:\", notes);\nreturn { approved: true, message: \"PO approved\" };"
      }
    },
    {
      "id": "endRejected1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End (Rejected)"
      },
      "inputs": {}
    }
  ],
  "edges": [
    {
      "id": "start-output-fetchPoData1-input",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "fetchPoData1",
      "targetPort": "input"
    },
    {
      "id": "fetchPoData1-success-poReview1-input",
      "sourceNodeId": "fetchPoData1",
      "sourcePort": "success",
      "targetNodeId": "poReview1",
      "targetPort": "input"
    },
    {
      "id": "poReview1-completed-routeOnDecision1-input",
      "sourceNodeId": "poReview1",
      "sourcePort": "completed",
      "targetNodeId": "routeOnDecision1",
      "targetPort": "input"
    },
    {
      "id": "routeOnDecision1-true-logPoApproved1-input",
      "sourceNodeId": "routeOnDecision1",
      "sourcePort": "true",
      "targetNodeId": "logPoApproved1",
      "targetPort": "input"
    },
    {
      "id": "routeOnDecision1-false-endRejected1-input",
      "sourceNodeId": "routeOnDecision1",
      "sourcePort": "false",
      "targetNodeId": "endRejected1",
      "targetPort": "input"
    }
  ],
  "definitions": [
    {
      "nodeType": "core.trigger.manual",
      "version": "1.0",
      "category": "trigger",
      "description": "Start workflow manually",
      "tags": [
        "trigger",
        "start",
        "manual"
      ],
      "sortOrder": 40,
      "display": {
        "label": "Manual trigger",
        "icon": "play",
        "shape": "circle"
      },
      "handleConfiguration": [
        {
          "position": "right",
          "handles": [
            {
              "id": "output",
              "type": "source",
              "handleType": "output",
              "showButton": true,
              "constraints": {
                "forbiddenTargetCategories": [
                  "trigger"
                ]
              }
            }
          ],
          "visible": true
        }
      ],
      "model": {
        "type": "bpmn:StartEvent",
        "entryPointId": true
      },
      "outputDefinition": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the workflow.",
          "source": "null",
          "var": "output"
        }
      },
      "toolbarExtensions": {
        "design": {
          "actions": [
            {
              "id": "change-trigger-type",
              "icon": "square-mouse-pointer",
              "label": "Change trigger type"
            }
          ]
        }
      }
    },
    {
      "nodeType": "core.action.script",
      "version": "1.0",
      "category": "data-operations",
      "description": "Run custom JavaScript code",
      "tags": [
        "code",
        "javascript",
        "python"
      ],
      "sortOrder": 35,
      "supportsErrorHandling": true,
      "display": {
        "label": "Script",
        "icon": "code"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ]
        },
        {
          "position": "right",
          "handles": [
            {
              "id": "success",
              "type": "source",
              "handleType": "output"
            },
            {
              "id": "error",
              "label": "Error",
              "type": "source",
              "handleType": "output",
              "visible": "{inputs.errorHandlingEnabled}",
              "constraints": {
                "maxConnections": 1
              }
            }
          ]
        }
      ],
      "debug": {
        "runtime": "clientScript"
      },
      "model": {
        "type": "bpmn:ScriptTask"
      },
      "inputDefinition": {
        "type": "object",
        "properties": {
          "script": {
            "type": "string",
            "minLength": 1,
            "errorMessage": "A script function is required",
            "validationSeverity": "warning"
          }
        },
        "required": [
          "script"
        ]
      },
      "inputDefaults": {
        "script": ""
      },
      "outputDefinition": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "form": {
        "id": "script-properties",
        "title": "Script configuration",
        "sections": [
          {
            "id": "script",
            "title": "Script",
            "collapsible": true,
            "defaultExpanded": true,
            "fields": [
              {
                "name": "inputs.script",
                "type": "custom",
                "component": "script-editor",
                "componentProps": {
                  "language": "javascript",
                  "returnType": "any",
                  "validationMode": "script",
                  "minHeight": 200,
                  "placeholder": " // Return an object with your result\nreturn {\n  message: \"Web request response\",\n  data: $vars.httpRequest1.output\n                  };"
                },
                "label": "Code",
                "description": "JavaScript expression that returns a result object"
              }
            ]
          }
        ]
      }
    },
    {
      "nodeType": "uipath.human-in-the-loop.quick-form",
