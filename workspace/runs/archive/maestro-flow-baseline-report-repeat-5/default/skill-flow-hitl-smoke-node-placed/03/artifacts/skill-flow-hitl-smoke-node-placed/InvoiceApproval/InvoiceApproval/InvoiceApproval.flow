{
  "id": "d4adfadc-813f-4f0a-b4cb-bcffac91d125",
  "version": "1.8",
  "name": "InvoiceApproval",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "65ac5c54-8cd0-43f6-adf3-d9da764ed523",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "invoiceReview1",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "Invoice Review"
      },
      "inputs": {
        "title": "Invoice Review",
        "recipient": {
          "channels": ["Email", "ActionCenter"],
          "connections": {},
          "assignee": { "type": "group" }
        },
        "priority": "Low",
        "schema": {
          "schemaId": "7362b2cf-542a-4a31-88b5-874fa0de0c19",
          "fields": [
            {
              "id": "invoiceid",
              "label": "Invoice ID",
              "type": "string",
              "direction": "input",
              "binding": "vars.start.output.invoiceId"
            },
            {
              "id": "amount",
              "label": "Amount",
              "type": "number",
              "direction": "input",
              "binding": "vars.start.output.amount"
            }
          ],
          "outcomes": [
            { "id": "approve", "name": "Approve", "type": "string", "isPrimary": true,  "action": "Continue" },
            { "id": "reject",  "name": "Reject",  "type": "string", "isPrimary": false, "action": "End" }
          ]
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output"
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": ["Approve", "Reject"],
          "default": "Approve"
        }
      }
    },
    {
      "id": "end1",
      "type": "core.control.end",
      "typeVersion": "1.0.0",
      "display": {
        "label": "End",
        "icon": "circle-check",
        "shape": "circle"
      },
      "inputs": {},
      "model": {
        "type": "bpmn:EndEvent"
      }
    }
  ],
  "edges": [
    {
      "id": "start-output-invoiceReview1-input",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "invoiceReview1",
      "targetPort": "input"
    },
    {
      "id": "invoiceReview1-completed-end1-input",
      "sourceNodeId": "invoiceReview1",
      "sourcePort": "completed",
      "targetNodeId": "end1",
      "targetPort": "input"
    }
  ],
  "definitions": [
    {
      "nodeType": "core.trigger.manual",
      "version": "1.0",
      "category": "trigger",
      "description": "Start workflow manually",
      "tags": ["trigger", "start", "manual"],
      "sortOrder": 40,
      "display": {
        "label": "Manual trigger",
        "icon": "play",
        "shape": "circle"
      },
      "handleConfiguration": [
        {
          "position": "right",
          "handles": [
            {
              "id": "output",
              "type": "source",
              "handleType": "output",
              "showButton": true,
              "constraints": {
                "forbiddenTargetCategories": ["trigger"]
              }
            }
          ],
          "visible": true
        }
      ],
      "model": {
        "type": "bpmn:StartEvent",
        "entryPointId": true
      },
      "outputDefinition": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the workflow.",
          "source": "null",
          "var": "output"
        }
      },
      "toolbarExtensions": {
        "design": {
          "actions": [
            {
              "id": "change-trigger-type",
              "icon": "square-mouse-pointer",
              "label": "Change trigger type"
            }
          ]
        }
      }
    },
    {
      "nodeType": "uipath.human-in-the-loop.quick-form",
      "version": "1.0",
      "category": "human-task",
      "description": "Fast inline approvals with inline debug",
      "tags": ["human-task", "hitl", "human-in-the-loop", "quick-form", "approval"],
      "sortOrder": 27,
      "display": {
        "label": "Quick Form",
        "icon": "users",
        "shape": "square"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ],
          "visible": true
        },
        {
          "position": "right",
          "handles": [
            {
              "id": "completed",
              "label": "Completed",
              "type": "source",
              "handleType": "output",
              "showButton": true,
              "constraints": {
                "forbiddenTargetCategories": ["trigger"]
              }
            }
          ],
          "visible": true
        }
      ],
      "model": { "type": "bpmn:UserTask", "serviceType": "Actions.HITL" },
      "inputDefaults": {
        "schema": {
          "fields": [],
          "outcomes": [
            { "id": "submit", "name": "Submit", "type": "string", "isPrimary": true, "action": "Continue" }
          ]
        },
        "recipient": {
          "channels": ["Email", "ActionCenter"],
          "connections": {},
          "assignee": { "type": "group" }
        }
      },
      "outputDefinition": {
        "output": { "type": "object", "description": "Task result data", "source": "=result", "var": "output" },
        "status": { "type": "string", "description": "Task completion status", "source": "=result.Action", "var": "status" }
      }
    },
    {
      "nodeType": "core.control.end",
      "version": "1.0.0",
      "category": "control-flow",
      "description": "Mark the end of a workflow path",
      "tags": ["control-flow", "end", "finish", "complete"],
      "sortOrder": 20,
      "display": {
        "label": "End",
        "icon": "circle-check",
        "shape": "circle"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ]
        }
      ],
      "model": {
        "type": "bpmn:EndEvent"
      },
      "runtimeConstraints": {
        "exclude": ["api-function"]
      }
    }
  ],
  "layout": {
    "nodes": {
      "start": {
        "position": { "x": 256, "y": 144 }
      },
      "invoiceReview1": {
        "position": { "x": 512, "y": 144 }
      },
      "end1": {
        "position": { "x": 768, "y": 144 }
      }
    }
  },
  "variables": {
    "nodes": [
      {
        "id": "start.output",
        "type": "object",
        "description": "Data passed when manually triggering the workflow.",
        "binding": { "nodeId": "start", "outputId": "output" }
      },
      {
        "id": "invoiceReview1.output",
        "type": "object",
        "description": "Task result data",
        "binding": { "nodeId": "invoiceReview1", "outputId": "output" }
      },
      {
        "id": "invoiceReview1.status",
        "type": "string",
        "description": "Task completion status",
        "binding": { "nodeId": "invoiceReview1", "outputId": "status" }
      }
    ],
    "globals": []
  }
}
