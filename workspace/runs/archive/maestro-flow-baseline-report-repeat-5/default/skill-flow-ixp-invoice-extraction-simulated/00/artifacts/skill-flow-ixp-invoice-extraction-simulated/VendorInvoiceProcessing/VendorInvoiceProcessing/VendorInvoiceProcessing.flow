          "eventType": "FILE_CREATED",
          "eventMode": "polling",
          "filterExpression": "((ParentID=='01ZQOZ3CROCP6UGVC34BC3VYM7R3ZIIXVV')&&(Extension=='pdf'))",
          "pathParameters": {
            "ParentDriveID": "b!NqflADV1F0OyTPKj8kXJf9qob1-JXAtJovOyZmUVjnp3MSH5K3ABSIKgQEloSUDs"
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"instanceParameters\":{\"connectorKey\":\"uipath-microsoft-onedrive\",\"objectName\":\"File\",\"activityType\":\"CuratedTrigger\",\"version\":\"1.0.0\",\"eventOperation\":\"FILE_CREATED\",\"eventMode\":\"polling\",\"supportsStreaming\":false},\"objectName\":\"File\",\"packageVersion\":\"1.0.0\",\"connectorVersion\":null,\"executionType\":null,\"httpMethod\":null,\"path\":null,\"filter\":{\"groupOperator\":0,\"index\":0,\"filters\":[{\"id\":\"ParentID\",\"operator\":\"Equals\",\"value\":{\"value\":\"01ZQOZ3CROCP6UGVC34BC3VYM7R3ZIIXVV\",\"rawString\":\"\\\"01ZQOZ3CROCP6UGVC34BC3VYM7R3ZIIXVV\\\"\",\"isLiteral\":true},\"uiId\":\"93c06c0a-c88e-4df1-b713-2dde8cd826ba\"},{\"id\":\"Extension\",\"operator\":\"Equals\",\"value\":{\"value\":\"pdf\",\"rawString\":\"\\\"pdf\\\"\",\"isLiteral\":true},\"uiId\":\"038c3397-0695-41dc-9e19-82718aaed94f\"}],\"groups\":[],\"uuId\":\"f8010f03-bbe3-40b0-815d-95d1ebebab4f\"}}}",
          "uiPathActivityTypeId": "3579e230-6ba6-39f9-9870-d6afd1e17512",
