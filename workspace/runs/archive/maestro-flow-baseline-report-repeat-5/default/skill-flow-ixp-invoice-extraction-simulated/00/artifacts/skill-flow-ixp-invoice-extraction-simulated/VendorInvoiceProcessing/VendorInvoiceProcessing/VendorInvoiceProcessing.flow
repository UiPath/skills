        "detail": {
          "connector": "uipath-microsoft-onedrive",
          "connectionId": "ae311606-25b7-43ef-9cd0-f3dc0b3a9b58",
          "connectionResourceId": "ae311606-25b7-43ef-9cd0-f3dc0b3a9b58",
          "connectionFolderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "eventParameters": {},
