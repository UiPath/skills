    {
      "id": "extractInvoiceFieldsMock",
      "type": "core.logic.mock",
      "typeVersion": "1.0",
      "display": {
        "label": "Extract Invoice Fields (mock — IxP model not yet deployed)"
      },
      "inputs": {},
      "outputs": {
        "output": {
          "type": "object",
          "description": "Mock output value",
          "source": "null",
          "var": "output"
        }
      }
    },
    {
      "id": "formatResults",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Format Extracted Fields"
      },
      "inputs": {
        "script": "const fields = ($vars.extractInvoiceFieldsMock.output &&\n                $vars.extractInvoiceFieldsMock.output.ExtractionResult &&\n                $vars.extractInvoiceFieldsMock.output.ExtractionResult.ResultsDocument &&\n                $vars.extractInvoiceFieldsMock.output.ExtractionResult.ResultsDocument.Fields)\n  ? $vars.extractInvoiceFieldsMock.output.ExtractionResult.ResultsDocument.Fields\n  : [];\n\nfunction getField(name) {\n  const f = fields.find(f => f.FieldName === name);\n  return f && f.Values && f.Values.length > 0 ? f.Values[0] : null;\n}\n\nconst lineItemsRaw = ($vars.extractInvoiceFieldsMock.output &&\n                      $vars.extractInvoiceFieldsMock.output.ExtractionResult &&\n                      $vars.extractInvoiceFieldsMock.output.ExtractionResult.ResultsDocument &&\n                      $vars.extractInvoiceFieldsMock.output.ExtractionResult.ResultsDocument.Tables)\n  ? $vars.extractInvoiceFieldsMock.output.ExtractionResult.ResultsDocument.Tables\n  : [];\n\nconst lineItems = lineItemsRaw.map(row => ({\n  description: (row.find(c => c.FieldName === 'Description') || {}).Values?.[0] || null,\n  quantity:    (row.find(c => c.FieldName === 'Quantity')    || {}).Values?.[0] || null,\n  unitPrice:   (row.find(c => c.FieldName === 'Unit Price')  || {}).Values?.[0] || null,\n  lineTotal:   (row.find(c => c.FieldName === 'Line Total')  || {}).Values?.[0] || null\n}));\n\nreturn {\n  invoiceNumber: getField('Invoice Number'),\n  vendorName:    getField('Vendor Name'),\n  invoiceDate:   getField('Invoice Date'),\n  totalAmount:   getField('Total Amount'),\n  lineItems:     lineItems,\n  fileName:      $vars.newInvoiceInSharepoint1.output.FullName,\n  fileUrl:       $vars.newInvoiceInSharepoint1.output.URL\n};",
        "errorHandlingEnabled": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "errorHandler",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Handle Extraction Error"
      },
      "inputs": {
        "script": "return {\n  error: true,\n  message: ($vars.extractInvoiceFieldsMock.error && $vars.extractInvoiceFieldsMock.error.message)\n    ? $vars.extractInvoiceFieldsMock.error.message\n    : 'Extraction failed',\n  detail: ($vars.extractInvoiceFieldsMock.error && $vars.extractInvoiceFieldsMock.error.detail)\n    ? $vars.extractInvoiceFieldsMock.error.detail\n    : null,\n  fileName: $vars.newInvoiceInSharepoint1.output.FullName\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "doneSuccess",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Done"
      },
      "inputs": {},
      "outputs": {
        "extractedInvoice": {
          "source": "=js:$vars.formatResults.output"
        },
        "sapResponse": {
          "source": "=js:$vars.postInvoiceToSap1.output"
        }
      }
    },
    {
      "id": "doneError",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
