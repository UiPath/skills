          "connectionFolderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "eventParameters": {},
          "objectName": "File",
          "eventType": "FILE_CREATED",
          "eventMode": "polling",
          "filterExpression": "Extension = 'pdf' AND ParentID = 'REPLACE_WITH_NEW_VENDOR_SHAREPOINT_FOLDER_ID'",
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"instanceParameters\":{\"connectorKey\":\"uipath-microsoft-onedrive\",\"objectName\":\"File\",\"activityType\":\"CuratedTrigger\",\"version\":\"1.0.0\",\"eventOperation\":\"FILE_CREATED\",\"eventMode\":\"polling\",\"supportsStreaming\":false},\"objectName\":\"File\",\"packageVersion\":\"1.0.0\",\"connectorVersion\":null,\"executionType\":null,\"httpMethod\":null,\"path\":null,\"filter\":{\"logicalOperator\":\"AND\",\"conditions\":[{\"field\":\"Extension\",\"operator\":\"EQ\",\"value\":\"pdf\"},{\"field\":\"ParentID\",\"operator\":\"EQ\",\"value\":\"REPLACE_WITH_NEW_VENDOR_SHAREPOINT_FOLDER_ID\"}]}}}",
          "uiPathActivityTypeId": "3579e230-6ba6-39f9-9870-d6afd1e17512",
          "errorState": {
