{
  "id": "f4a73357-44fc-4c5c-8aa9-df87c5fb7c56",
  "version": "1.8",
  "name": "VendorInvoiceProcessing",
  "nodes": [
    {
      "id": "mapFields",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Map Extracted Fields"
      },
      "inputs": {
        "errorHandlingEnabled": true,
        "script": "// Reads InvoiceIXP extraction output and maps to SAP invoice structure.\nconst ixpOut = $vars.extractInvoiceFields1.output || {};\nconst fields = ixpOut.ExtractionResult?.ResultsDocument?.Fields || [];\nconst tables = ixpOut.ExtractionResult?.ResultsDocument?.Tables || [];\nconst get = (name) => fields.find(f => f.FieldName === name)?.Values?.[0] ?? null;\nreturn {\n  invoiceNumber: get('Invoice Number'),\n  vendorName: get('Vendor Name'),\n  invoiceDate: get('Invoice Date'),\n  totalAmount: get('Total Amount'),\n  lineItems: tables\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "id": "end1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      }
    },
    {
      "id": "terminateOnError",
      "type": "core.logic.terminate",
      "typeVersion": "1.0",
      "display": {
        "label": "Terminate on Error"
      }
    },
    {
      "id": "postInvoiceToSapEndpoint1",
      "type": "core.action.http.v2",
      "typeVersion": "2.3",
      "display": {
        "label": "POST Invoice to SAP Endpoint"
      },
      "inputs": {
        "branches": [],
        "timeout": "PT15M",
        "retryCount": 0,
        "errorHandlingEnabled": true,
        "detail": {
          "connector": "uipath-uipath-http",
          "connectionId": "ImplicitConnection",
          "connectionResourceId": null,
          "connectionFolderKey": null,
          "method": "POST",
          "endpoint": "/http-request",
          "bodyParameters": {
            "authentication": "manual",
            "method": "POST",
            "url": "https://YOUR_SAP_ENDPOINT_URL_HERE",
            "headers": {
              "Content-Type": "application/json",
              "Accept": "application/json"
            },
            "body": {
              "type": "json",
              "content": "=js:JSON.stringify({ invoiceNumber: $vars.mapFields.output.invoiceNumber, vendorName: $vars.mapFields.output.vendorName, invoiceDate: $vars.mapFields.output.invoiceDate, totalAmount: $vars.mapFields.output.totalAmount, lineItems: $vars.mapFields.output.lineItems })"
            }
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"connectorVersion\":\"1.4.50\",\"executionType\":null,\"customFieldsRequestDetails\":null,\"instanceParameters\":{\"connectorKey\":\"uipath-uipath-http\",\"objectName\":\"http-request\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\"},\"objectName\":\"http-request\",\"operation\":\"create\",\"packageVersion\":\"1.0.0\",\"httpMethod\":\"POST\",\"path\":\"/http-request\",\"unifiedTypesCompatible\":true,\"savedJitInputFieldId\":\"in_http-request\"}}",
          "uiPathActivityTypeId": "5c4cc855-b42a-37e6-b910-de8588998fce",
          "errorState": {
            "issues": []
          },
          "telemetryData": {
            "connectorKey": "uipath-uipath-http",
            "connectorName": "HTTP",
            "operationType": "create",
            "objectName": "http-request",
            "objectDisplayName": "HTTP Request",
            "primaryKeyName": ""
          }
        }
      }
    },
