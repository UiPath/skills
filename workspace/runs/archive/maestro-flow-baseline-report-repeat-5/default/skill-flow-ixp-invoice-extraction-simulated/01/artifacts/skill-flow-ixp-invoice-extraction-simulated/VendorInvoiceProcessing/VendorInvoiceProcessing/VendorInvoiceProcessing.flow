{
  "id": "1f48d3c0-da6e-4f28-b2ff-9a689c145e1a",
  "version": "1.8",
  "name": "VendorInvoiceProcessing",
  "nodes": [
    {
      "id": "extractInvoiceFieldsMock",
      "type": "core.logic.mock",
      "typeVersion": "1.0",
      "display": {
        "label": "Extract Invoice Fields (mock — IxP model not yet deployed to folder)"
      }
    },
    {
      "id": "buildSapPayload1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Build SAP Invoice Payload"
      },
      "inputs": {
        "script": "// Assemble SAP invoice payload from IxP extracted fields.\n// NOTE: After replacing the IxP mock with the live model, update field access to:\n//   const fields = $vars.<ixpNodeId>.output.ExtractionResult.ResultsDocument.Fields || [];\n//   const get = name => (fields.find(f => f.FieldName === name)?.Values?.[0]?.Value) ?? null;\n//   const tables = $vars.<ixpNodeId>.output.ExtractionResult.ResultsDocument.Tables || [];\n//   const liTable = tables.find(t => t.ColumnInfo?.some(c => c.FieldName === 'Description')) || { ColumnInfo: [], Rows: [] };\n//   const colId = name => liTable.ColumnInfo.find(c => c.FieldName === name)?.FieldId ?? null;\n//   const lineItems = liTable.Rows.map(row => {\n//     const cell = fid => row.Cells.find(c => c.FieldId === fid)?.Values?.[0]?.Value ?? null;\n//     return {\n//       description: cell(colId('Description')),\n//       quantity:    cell(colId('Quantity')),\n//       unitPrice:   cell(colId('Unit Price')),\n//       amount:      cell(colId('Amount')),\n//       lineTotal:   cell(colId('Line Total')),\n//     };\n//   });\n//   return {\n//     invoiceNumber: get('Invoice Number'),\n//     invoiceDate:   get('Invoice Date'),\n//     dueDate:       get('Due Date'),\n//     vendorName:    get('Vendor Name'),\n//     poNumber:      get('PO Number'),\n//     currency:      get('Currency'),\n//     subtotal:      get('Subtotal'),\n//     taxAmount:     get('Tax Amount'),\n//     totalDue:      get('Total Due'),\n//     paymentTerms:  get('Payment Terms'),\n//     lineItems:     lineItems,\n//   };\nconst out = $vars.extractInvoiceFieldsMock.output || {};\nconst lineItems = Array.isArray(out.LineItems) ? out.LineItems.map(li => ({\n  description: li.Description ?? null,\n  quantity:    li.Quantity    ?? null,\n  unitPrice:   li.UnitPrice   ?? null,\n  amount:      li.Amount      ?? null,\n  lineTotal:   li.LineTotal   ?? null,\n})) : [];\nreturn {\n  invoiceNumber: out.InvoiceNumber ?? null,\n  invoiceDate:   out.InvoiceDate   ?? null,\n  dueDate:       out.DueDate       ?? null,\n  vendorName:    out.VendorName    ?? null,\n  poNumber:      out.PONumber      ?? null,\n  currency:      out.Currency      ?? null,\n  subtotal:      out.Subtotal      ?? null,\n  taxAmount:     out.TaxAmount     ?? null,\n  totalDue:      out.TotalDue      ?? null,\n  paymentTerms:  out.PaymentTerms  ?? null,\n  lineItems:     lineItems,\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
