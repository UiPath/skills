              "id": "{nodeId}.output",
              "name": "output",
              "type": "jsonSchema",
              "elementId": "{nodeId}",
              "custom": true
            },
            {
              "condition": "hasEdgeFromHandle('error')",
              "id": "{nodeId}.error",
              "name": "error",
              "type": "jsonSchema",
              "elementId": "{nodeId}",
              "custom": true
            }
          ],
          "nodes": [
            {
              "id": "{nodeId}",
              "type": "bpmn:SubProcess",
              "replaceOriginal": true,
              "data": {
                "label": "{node.data.label}",
                "isExpanded": true,
                "model": {
                  "serviceType": "BPMN.Variables",
                  "subprocessVariables": {
                    "inputOutputs": [
                      {
                        "id": "response",
                        "name": "response",
                        "type": "jsonSchema",
                        "variableType": "inputOutput"
                      },
                      {
                        "id": "error",
                        "name": "error",
                        "type": "jsonSchema",
                        "variableType": "inputOutput"
                      }
                    ]
                  },
                  "outputs": [
                    {
                      "name": "output",
                      "type": "jsonSchema",
                      "source": "=vars.response",
                      "var": "{nodeId}.output",
                      "custom": true
                    },
                    {
                      "name": "error",
                      "type": "jsonSchema",
                      "source": "=vars.error",
                      "var": "{nodeId}.error",
                      "custom": true
                    }
                  ]
                }
              },
              "nodes": [
                {
                  "id": "_Implicit_StartEvent_{nodeId}",
                  "type": "bpmn:StartEvent",
                  "parentId": "{nodeId}",
                  "position": {
                    "x": 0,
                    "y": 0
                  },
                  "data": {
                    "label": "HTTP Request Start"
