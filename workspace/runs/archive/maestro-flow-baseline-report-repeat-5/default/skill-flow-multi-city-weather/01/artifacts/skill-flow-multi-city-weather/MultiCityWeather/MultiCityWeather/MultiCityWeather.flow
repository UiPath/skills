{
  "id": "bbf9469b-9f6d-447e-b5a3-02ea3ab844d4",
  "version": "1.8",
  "name": "MultiCityWeather",
  "nodes": [
    {
      "id": "initCities",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Initialize Cities"
      },
      "inputs": {
        "script": "return {\n  cities: [\n    { city: 'Seattle', lat: 47.6062, lon: -122.3321 },\n    { city: 'Phoenix', lat: 33.4484, lon: -112.074 },\n    { city: 'New York', lat: 40.7128, lon: -74.006 }\n  ]\n};"
      }
    },
    {
      "id": "loop1",
      "type": "core.logic.loop",
      "typeVersion": "2.4",
      "display": {
        "label": "Loop Over Cities"
      },
      "inputs": {
        "collection": "=js:$vars.initCities.output.cities",
        "parallel": false
      }
    },
    {
      "id": "classifyWeather",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Classify Weather"
      },
      "inputs": {
        "script": "const temp = $vars.fetchWeather1.output.body.current_weather.temperature;\nconst city = $vars.loop1.currentItem.city;\nreturn {\n  city: city,\n  temperature: temp,\n  verdict: temp > 60 ? 'warm' : 'cold'\n};"
      },
      "parentId": "loop1"
    },
    {
      "id": "end1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {},
      "outputs": {
        "results": {
          "source": "=js:$vars.results"
        },
        "weatherResults": {
          "source": "=js:$vars.results"
        }
      }
    },
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "a70577f7-91bc-4b4e-bff8-d963fd71c6ab",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "fetchWeather1",
      "type": "core.action.http.v2",
      "typeVersion": "2.3",
      "display": {
        "label": "Fetch Weather"
      },
      "inputs": {
        "branches": [],
        "timeout": "PT15M",
        "retryCount": 0,
        "detail": {
          "connector": "uipath-uipath-http",
          "connectionId": "ImplicitConnection",
          "connectionResourceId": null,
          "connectionFolderKey": null,
          "method": "POST",
          "endpoint": "/http-request",
          "bodyParameters": {
            "authentication": "manual",
            "method": "GET",
            "url": "=js:`https://api.open-meteo.com/v1/forecast?latitude=${$vars.loop1.currentItem.lat}&longitude=${$vars.loop1.currentItem.lon}&current_weather=true&temperature_unit=fahrenheit`"
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"connectorVersion\":\"1.4.50\",\"executionType\":null,\"customFieldsRequestDetails\":null,\"instanceParameters\":{\"connectorKey\":\"uipath-uipath-http\",\"objectName\":\"http-request\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\"},\"objectName\":\"http-request\",\"operation\":\"create\",\"packageVersion\":\"1.0.0\",\"httpMethod\":\"POST\",\"path\":\"/http-request\",\"unifiedTypesCompatible\":true,\"savedJitInputFieldId\":\"in_http-request\"}}",
          "uiPathActivityTypeId": "5c4cc855-b42a-37e6-b910-de8588998fce",
          "errorState": {
            "issues": []
          },
          "telemetryData": {
            "connectorKey": "uipath-uipath-http",
            "connectorName": "HTTP",
            "operationType": "create",
            "objectName": "http-request",
            "objectDisplayName": "HTTP Request",
            "primaryKeyName": ""
          }
        }
      },
      "parentId": "loop1"
    }
  ],
  "edges": [
    {
      "id": "e-start-initCities",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "initCities",
      "targetPort": "input"
    },
    {
      "id": "e-initCities-loop1",
      "sourceNodeId": "initCities",
      "sourcePort": "success",
      "targetNodeId": "loop1",
      "targetPort": "input"
    },
    {
      "id": "e-loop1-fetchWeather1",
      "sourceNodeId": "loop1",
      "sourcePort": "start",
      "targetNodeId": "fetchWeather1",
      "targetPort": "input"
    },
    {
      "id": "e-fetchWeather1-classifyWeather",
      "sourceNodeId": "fetchWeather1",
      "sourcePort": "default",
      "targetNodeId": "classifyWeather",
      "targetPort": "input"
    },
    {
      "id": "e-classifyWeather-loop1",
      "sourceNodeId": "classifyWeather",
      "sourcePort": "success",
      "targetNodeId": "loop1",
      "targetPort": "continue"
    },
    {
      "id": "e-loop1-end1",
      "sourceNodeId": "loop1",
      "sourcePort": "success",
      "targetNodeId": "end1",
      "targetPort": "input"
    }
  ],
  "definitions": [
    {
      "nodeType": "core.control.end",
      "version": "1.0",
