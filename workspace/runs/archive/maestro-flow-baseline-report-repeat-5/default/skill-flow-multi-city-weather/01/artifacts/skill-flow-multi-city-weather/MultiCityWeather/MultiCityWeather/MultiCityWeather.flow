      },
      "model": {
        "type": "bpmn:ServiceTask",
        "serviceType": "Intsvc.UnifiedHttpRequest",
        "context": [
          {
            "name": "connectorKey",
            "type": "string",
            "value": "uipath-uipath-http"
          },
          {
            "name": "objectName",
            "type": "string",
            "value": "http-request"
          },
          {
