          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input",
              "label": ""
            }
          ]
        },
        {
          "position": "right",
          "handles": [
            {
              "id": "branch-{item.id}",
              "type": "source",
              "handleType": "output",
              "label": "{item.name}",
              "repeat": "inputs.branches"
            },
            {
              "id": "default",
              "type": "source",
              "handleType": "output",
              "label": ""
            },
            {
              "id": "error",
              "label": "Error",
              "type": "source",
              "handleType": "output",
              "visible": "{inputs.errorHandlingEnabled}",
              "constraints": {
