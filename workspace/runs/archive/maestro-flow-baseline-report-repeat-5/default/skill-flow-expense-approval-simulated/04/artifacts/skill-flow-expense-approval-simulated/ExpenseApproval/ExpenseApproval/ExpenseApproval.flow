{
  "id": "83a68d14-56a8-410c-ac69-1868eae3489e",
  "version": "1.8",
  "name": "ExpenseApproval",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "377ad951-951d-4a92-b40b-c4c05e59f807",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "buildForm",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Prepare Expense Details"
      },
      "inputs": {
        "script": "return {\n  submitterName: $vars.submitterName,\n  expenseId: $vars.expenseId,\n  amount: $vars.amount,\n  category: $vars.category\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "managerApproval",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "Manager Approval"
      },
      "inputs": {
        "title": "Expense Report Approval Request",
        "priority": "Medium",
        "schema": {
          "schemaId": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
          "fields": [
            {
              "id": "submitterName",
              "label": "Submitted By",
              "type": "text",
              "direction": "input",
              "binding": "vars.buildForm.output.submitterName"
            },
            {
              "id": "expenseId",
              "label": "Expense ID",
              "type": "text",
              "direction": "input",
              "binding": "vars.buildForm.output.expenseId"
            },
            {
              "id": "amount",
              "label": "Amount",
              "type": "number",
              "direction": "input",
              "binding": "vars.buildForm.output.amount"
            },
            {
              "id": "category",
              "label": "Category",
              "type": "text",
              "direction": "input",
              "binding": "vars.buildForm.output.category"
            },
            {
              "id": "rejectionReason",
              "label": "Rejection Reason (optional)",
              "type": "text",
              "direction": "output",
              "variable": "vars.rejectionReason"
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "Continue"
            }
          ]
        },
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group",
            "name": "expense-approvers"
          }
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "rejectionReason": {
              "type": "string"
            },
            "Action": {
              "type": "string",
              "enum": [
                "Approve",
                "Reject"
              ],
              "default": "Approve"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": [
            "Approve",
            "Reject"
          ],
          "default": "Approve"
        }
      }
    },
    {
      "id": "logOutcome",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log Outcome"
      },
      "inputs": {
        "script": "var decision = $vars.managerApproval.output.Action;\nreturn {\n  approvalStatus: decision === 'Approve' ? 'approved' : 'rejected',\n  logEntry: {\n    submitter: $vars.submitterName,\n    expenseId: $vars.expenseId,\n    amount: $vars.amount,\n    category: $vars.category,\n    decision: decision,\n    rejectionReason: $vars.managerApproval.output.rejectionReason || ''\n  }\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "endDone",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Done"
      },
      "inputs": {},
      "outputs": {
        "approvalStatus": {
          "source": "=js:$vars.logOutcome.output.approvalStatus"
        },
        "rejectionReason": {
          "source": "=js:$vars.rejectionReason"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "e-start-buildForm",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "buildForm",
      "targetPort": "input"
    },
    {
      "id": "e-buildForm-managerApproval",
      "sourceNodeId": "buildForm",
      "sourcePort": "success",
      "targetNodeId": "managerApproval",
      "targetPort": "input"
    },
    {
      "id": "e-managerApproval-logOutcome",
      "sourceNodeId": "managerApproval",
      "sourcePort": "completed",
      "targetNodeId": "logOutcome",
      "targetPort": "input"
    },
    {
      "id": "e-logOutcome-end",
      "sourceNodeId": "logOutcome",
      "sourcePort": "success",
      "targetNodeId": "endDone",
      "targetPort": "input"
    }
  ],
