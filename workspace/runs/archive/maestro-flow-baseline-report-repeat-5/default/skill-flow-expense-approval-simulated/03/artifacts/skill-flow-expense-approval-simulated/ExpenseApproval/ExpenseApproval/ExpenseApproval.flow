{
  "id": "dda062e5-93dd-4ad8-aa48-4e0bd3e8d590",
  "version": "1.8",
  "name": "ExpenseApproval",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Expense Report Submitted"
      },
      "inputs": {
        "entryPointId": "ca4a91a7-be2f-49de-9f33-cf5eead28055",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "logSubmission",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log Submission Received"
      },
      "inputs": {
        "script": "return {\n  step: \"submission_received\",\n  logged: true,\n  message: \"[STEP 1] Expense report received from \" + ($vars.start.output.submittedBy || \"unknown\") + \". Amount: $\" + ($vars.start.output.amount || 0) + \". Category: \" + ($vars.start.output.category || \"N/A\") + \". Expense ID: \" + ($vars.start.output.expenseId || \"N/A\") + \". Routing to manager for approval.\"\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "managerApproval",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "Manager Approval"
      },
      "inputs": {
        "title": "Expense Approval Request",
        "priority": "Medium",
        "schema": {
          "schemaId": "a1b2c3d4-e5f6-7890-abcd-111122223333",
          "fields": [
            {
              "id": "submittedby",
              "label": "Submitted By",
              "type": "text",
              "direction": "input",
              "binding": "vars.start.output.submittedBy"
            },
            {
              "id": "amount",
              "label": "Amount ($)",
              "type": "number",
              "direction": "input",
              "binding": "vars.start.output.amount"
            },
            {
              "id": "category",
              "label": "Category",
              "type": "text",
              "direction": "input",
              "binding": "vars.start.output.category"
            },
            {
              "id": "expenseid",
              "label": "Expense ID",
              "type": "text",
              "direction": "input",
              "binding": "vars.start.output.expenseId"
            },
            {
              "id": "rejectionreason",
              "label": "Rejection Reason (optional)",
              "type": "text",
              "direction": "output",
              "variable": "vars.rejectionReason"
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "Continue"
            }
          ]
        },
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group",
            "name": "expense-approvers"
          }
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "rejectionreason": {
              "type": "string"
            },
            "Action": {
              "type": "string",
              "enum": [
                "Approve",
                "Reject"
              ],
              "default": "Approve"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": [
            "Approve",
            "Reject"
          ],
          "default": "Approve"
        }
      }
    },
    {
      "id": "logOutcome",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log Outcome"
      },
      "inputs": {
        "script": "var outcome = $vars.managerApproval.status;\nvar label = (outcome === \"Approve\") ? \"APPROVED\" : \"REJECTED\";\nvar msg = \"[STEP 3] Expense report \" + label + \". Submitted by: \" + ($vars.start.output.submittedBy || \"unknown\") + \". Amount: $\" + ($vars.start.output.amount || 0) + \". Expense ID: \" + ($vars.start.output.expenseId || \"N/A\") + \". Category: \" + ($vars.start.output.category || \"N/A\");\nif (outcome === \"Reject\") {\n  msg += \". Rejection reason: \" + ($vars.managerApproval.output.rejectionreason || \"None provided\");\n}\nreturn { step: \"outcome_logged\", logged: true, outcome: outcome, message: msg };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "endDone",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Done"
      },
      "inputs": {}
    }
  ],
  "edges": [
    {
      "id": "e1",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "logSubmission",
      "targetPort": "input"
    },
    {
      "id": "e2",
      "sourceNodeId": "logSubmission",
      "sourcePort": "success",
      "targetNodeId": "managerApproval",
      "targetPort": "input"
    },
    {
      "id": "e3",
      "sourceNodeId": "managerApproval",
      "sourcePort": "completed",
      "targetNodeId": "logOutcome",
      "targetPort": "input"
    },
    {
      "id": "e4",
      "sourceNodeId": "logOutcome",
      "sourcePort": "success",
      "targetNodeId": "endDone",
      "targetPort": "input"
    }
  ],
  "definitions": [
    {
