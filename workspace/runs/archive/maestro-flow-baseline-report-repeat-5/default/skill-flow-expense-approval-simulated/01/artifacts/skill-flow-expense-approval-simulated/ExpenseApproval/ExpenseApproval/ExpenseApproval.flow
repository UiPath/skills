{
  "id": "6e87d9ff-6cf6-413b-97c8-3259364551d1",
  "version": "1.8",
  "name": "ExpenseApproval",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "7727bd9d-ad5f-4ba9-86ed-8fb6600617fd",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "fetchExpense",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Fetch Expense Details"
      },
      "inputs": {
        "script": "// TODO: replace with a real API call or connector lookup\n// returning hardcoded sample data for now\nreturn {\n  expenseId: \"EXP-2024-0042\",\n  submitterName: \"Jane Smith\",\n  amount: 349.50,\n  description: \"Client dinner - Q3 planning meeting\",\n  submittedAt: \"2026-07-24\",\n  category: \"Meals & Entertainment\"\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the action fails.",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "hitlReview",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "Manager Review"
      },
      "inputs": {
        "title": "Expense Report Review",
        "priority": "Medium",
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group",
            "group": "expense-approvers"
          }
        },
        "schema": {
          "schemaId": "f8e7d6c5-b4a3-4210-9876-543210fedcba",
          "fields": [
            {
              "id": "expenseid",
              "label": "Expense ID",
              "type": "string",
              "direction": "input",
              "binding": "vars.fetchExpense.output.expenseId"
            },
            {
              "id": "submittername",
              "label": "Submitted By",
              "type": "string",
              "direction": "input",
              "binding": "vars.fetchExpense.output.submitterName"
            },
            {
              "id": "amount",
              "label": "Amount",
              "type": "number",
              "direction": "input",
              "binding": "vars.fetchExpense.output.amount"
            },
            {
              "id": "category",
              "label": "Category",
              "type": "string",
              "direction": "input",
              "binding": "vars.fetchExpense.output.category"
            },
            {
              "id": "description",
              "label": "Description",
              "type": "string",
              "direction": "input",
              "binding": "vars.fetchExpense.output.description"
            },
            {
              "id": "rejectionreason",
              "label": "Rejection Reason",
              "type": "string",
              "direction": "output",
              "variable": "vars.rejectionReason"
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "End"
            }
          ]
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "rejectionReason": {
              "type": "string"
            },
            "Action": {
              "type": "string",
              "enum": [
                "Approve",
                "Reject"
              ],
              "default": "Approve"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": [
            "Approve",
            "Reject"
          ],
          "default": "Approve"
        }
      }
    },
    {
      "id": "managerDecision",
      "type": "core.logic.decision",
      "typeVersion": "1.1",
      "display": {
        "label": "Approved?"
      },
      "inputs": {
        "expression": "$vars.hitlReview.status === \"Approve\"",
        "trueLabel": "Approved",
        "falseLabel": "Rejected"
      }
    },
    {
      "id": "logApproved",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log Approval"
      },
      "inputs": {
        "script": "return {\n  outcome: \"approved\",\n  submitterName: $vars.fetchExpense.output.submitterName,\n  amount: $vars.fetchExpense.output.amount,\n  description: $vars.fetchExpense.output.description,\n  message: \"Expense approved for \" + $vars.fetchExpense.output.submitterName + \" - Amount: \" + $vars.fetchExpense.output.amount\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the action fails.",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "logRejected",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log Rejection"
      },
      "inputs": {
        "script": "return {\n  outcome: \"rejected\",\n  submitterName: $vars.fetchExpense.output.submitterName,\n  amount: $vars.fetchExpense.output.amount,\n  description: $vars.fetchExpense.output.description,\n  rejectionReason: $vars.hitlReview.output.rejectionreason,\n  message: \"Expense rejected for \" + $vars.fetchExpense.output.submitterName + \" - Amount: \" + $vars.fetchExpense.output.amount + \" - Reason: \" + ($vars.hitlReview.output.rejectionreason || \"No reason provided\")\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the action fails.",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "doneApproved",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Done - Approved"
      }
    },
    {
      "id": "doneRejected",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Done - Rejected"
      }
    }
  ],
  "edges": [
    {
      "id": "e-start-fetch",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "fetchExpense",
      "targetPort": "input"
    },
    {
      "id": "e-fetch-hitl",
      "sourceNodeId": "fetchExpense",
      "sourcePort": "success",
      "targetNodeId": "hitlReview",
      "targetPort": "input"
    },
    {
      "id": "e-hitl-decision",
      "sourceNodeId": "hitlReview",
      "sourcePort": "completed",
      "targetNodeId": "managerDecision",
      "targetPort": "input"
    },
    {
      "id": "e-decision-approved",
      "sourceNodeId": "managerDecision",
      "sourcePort": "true",
      "targetNodeId": "logApproved",
      "targetPort": "input"
    },
    {
      "id": "e-decision-rejected",
      "sourceNodeId": "managerDecision",
      "sourcePort": "false",
      "targetNodeId": "logRejected",
      "targetPort": "input"
    },
    {
      "id": "e-logapproved-done",
      "sourceNodeId": "logApproved",
      "sourcePort": "success",
      "targetNodeId": "doneApproved",
      "targetPort": "input"
    },
    {
      "id": "e-logrejected-done",
      "sourceNodeId": "logRejected",
      "sourcePort": "success",
      "targetNodeId": "doneRejected",
      "targetPort": "input"
    }
  ],
  "definitions": [
    {
