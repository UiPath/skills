{
  "id": "7f4f643f-031f-4ec4-84ce-b03743809e4f",
  "version": "1.8",
  "name": "ExpenseApproval",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Expense Report Submitted"
      },
      "inputs": {
        "entryPointId": "16629ccd-ae67-4b2a-863f-21829ea11006",
        "isDefaultEntryPoint": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the workflow.",
          "source": "null",
          "var": "output"
        }
      }
    },
    {
      "id": "managerApproval",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "Manager Approval"
      },
      "inputs": {
        "title": "Expense Report Review",
        "priority": "Medium",
        "schema": {
          "schemaId": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
          "fields": [
            {
              "id": "submittedByDisplay",
              "label": "Submitted By",
              "type": "text",
              "direction": "input",
              "binding": "vars.start.output.submittedBy"
            },
            {
              "id": "titleDisplay",
              "label": "Expense Title",
              "type": "text",
              "direction": "input",
              "binding": "vars.start.output.expenseTitle"
            },
            {
              "id": "amountDisplay",
              "label": "Amount ($)",
              "type": "number",
              "direction": "input",
              "binding": "vars.start.output.amount"
            },
            {
              "id": "categoryDisplay",
              "label": "Category",
              "type": "text",
              "direction": "input",
              "binding": "vars.start.output.category"
            },
            {
              "id": "comments",
              "label": "Comments",
              "type": "text",
              "direction": "output",
              "variable": "vars.managerComments"
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "Continue"
            }
          ]
        },
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group",
            "group": "expense-approvers"
          }
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "comments": {
              "type": "string"
            },
            "Action": {
              "type": "string",
              "enum": [
                "Approve",
                "Reject"
              ],
              "default": "Approve"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": [
            "Approve",
            "Reject"
          ],
          "default": "Approve"
        }
      }
    },
    {
      "id": "checkDecision",
      "type": "core.logic.decision",
      "typeVersion": "1.1",
      "display": {
        "label": "Approved?"
      },
      "inputs": {
        "expression": "$vars.managerApproval.status === \"Approve\"",
        "trueLabel": "Approved",
        "falseLabel": "Rejected"
      }
    },
    {
      "id": "logApproved",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log Approval"
      },
      "inputs": {
        "script": "const record = {\n  expenseTitle: $vars.start.output.expenseTitle,\n  submittedBy: $vars.start.output.submittedBy,\n  amount: $vars.start.output.amount,\n  category: $vars.start.output.category,\n  decision: \"Approved\",\n  decisionBy: \"Manager\",\n  comments: $vars.managerApproval.output.comments\n};\nreturn { logged: true, record: record };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "logRejected",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log Rejection"
      },
      "inputs": {
        "script": "const record = {\n  expenseTitle: $vars.start.output.expenseTitle,\n  submittedBy: $vars.start.output.submittedBy,\n  amount: $vars.start.output.amount,\n  category: $vars.start.output.category,\n  decision: \"Rejected\",\n  decisionBy: \"Manager\",\n  comments: $vars.managerApproval.output.comments\n};\nreturn { logged: true, record: record };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "endApproved",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Expense Approved"
      },
      "inputs": {},
      "outputs": {
        "logResult": {
          "source": "=js:$vars.logApproved.output.record"
        }
      }
    },
    {
      "id": "endRejected",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Expense Rejected"
      },
      "inputs": {},
      "outputs": {
        "logResult": {
          "source": "=js:$vars.logRejected.output.record"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "edge-start-approval",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "managerApproval",
      "targetPort": "input"
    },
    {
      "id": "edge-approval-decision",
      "sourceNodeId": "managerApproval",
      "sourcePort": "completed",
      "targetNodeId": "checkDecision",
      "targetPort": "input"
    },
    {
      "id": "edge-decision-approved",
      "sourceNodeId": "checkDecision",
      "sourcePort": "true",
      "targetNodeId": "logApproved",
      "targetPort": "input"
    },
    {
      "id": "edge-decision-rejected",
      "sourceNodeId": "checkDecision",
      "sourcePort": "false",
      "targetNodeId": "logRejected",
      "targetPort": "input"
    },
    {
      "id": "edge-approved-end",
      "sourceNodeId": "logApproved",
      "sourcePort": "success",
      "targetNodeId": "endApproved",
      "targetPort": "input"
    },
    {
      "id": "edge-rejected-end",
      "sourceNodeId": "logRejected",
      "sourcePort": "success",
      "targetNodeId": "endRejected",
      "targetPort": "input"
    }
  ],
  "definitions": [
    {
      "nodeType": "core.trigger.manual",
      "version": "1.0",
