{
  "id": "6aaffabb-26bb-4d8d-8d6d-8d66ca962e86",
  "version": "1.8",
  "name": "LeaveRequest",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "a214ca1c-0833-4ba1-8093-753c4e4421ae",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "managerReview",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "Manager Reviews Leave Request"
      },
      "inputs": {
        "title": "Leave Request Approval",
        "priority": "Medium",
        "schema": {
          "schemaId": "b1c2d3e4-f5a6-7890-abcd-ef1234567890",
          "fields": [
            {
              "id": "employeeName",
              "label": "Employee Name",
              "type": "text",
              "direction": "input",
              "binding": "vars.start.output.employeeName"
            },
            {
              "id": "numberOfDays",
              "label": "Number of Days",
              "type": "number",
              "direction": "input",
              "binding": "vars.start.output.numberOfDays"
            },
            {
              "id": "approved",
              "label": "Approved",
              "type": "checkbox",
              "direction": "output",
              "variable": "vars.approved"
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "Continue"
            }
          ]
        },
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group"
          }
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "approved": {
              "type": "boolean"
            },
            "Action": {
              "type": "string",
              "enum": [
                "Approve",
                "Reject"
              ],
              "default": "Approve"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": [
            "Approve",
            "Reject"
          ],
          "default": "Approve"
        }
      }
    },
    {
      "id": "decisionApproved",
      "type": "core.logic.decision",
      "typeVersion": "1.1",
      "display": {
        "label": "Approved?"
      },
      "inputs": {
        "expression": "$vars.managerReview.output.approved === true",
        "trueLabel": "Approved",
        "falseLabel": "Rejected"
      }
    },
    {
      "id": "scriptApproved",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log Leave Approved"
      },
      "inputs": {
        "script": "return { message: 'Leave approved' };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "scriptRejected",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log Leave Rejected"
      },
      "inputs": {
        "script": "return { message: 'Leave rejected' };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "endApproved",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End (Approved)"
      },
      "inputs": {}
    },
    {
      "id": "endRejected",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End (Rejected)"
      },
      "inputs": {}
    }
  ],
  "edges": [
    {
      "id": "edge-start-to-hitl",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "managerReview",
      "targetPort": "input"
    },
    {
      "id": "edge-hitl-to-decision",
      "sourceNodeId": "managerReview",
      "sourcePort": "completed",
      "targetNodeId": "decisionApproved",
      "targetPort": "input"
    },
    {
      "id": "edge-decision-true",
      "sourceNodeId": "decisionApproved",
      "sourcePort": "true",
      "targetNodeId": "scriptApproved",
      "targetPort": "input"
    },
    {
      "id": "edge-decision-false",
      "sourceNodeId": "decisionApproved",
      "sourcePort": "false",
      "targetNodeId": "scriptRejected",
      "targetPort": "input"
    },
    {
      "id": "edge-script-approved-to-end",
      "sourceNodeId": "scriptApproved",
      "sourcePort": "success",
      "targetNodeId": "endApproved",
      "targetPort": "input"
    },
    {
      "id": "edge-script-rejected-to-end",
      "sourceNodeId": "scriptRejected",
      "sourcePort": "success",
      "targetNodeId": "endRejected",
      "targetPort": "input"
    }
  ],
  "definitions": [
    {
      "nodeType": "core.trigger.manual",
      "version": "1.0",
