{
  "id": "5b09989f-d17b-47a1-8a24-84f6696b4da1",
  "version": "1.8",
  "name": "SeasonLookup",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "1b2febb2-684b-400a-aa77-9afcd4381943",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "switchQuarter",
      "type": "core.logic.switch",
      "typeVersion": "1.1",
      "display": {
        "label": "Route by Quarter"
      },
      "inputs": {
        "cases": [
          {
            "id": "q1",
            "label": "Quarter 1 - Spring",
            "expression": "$vars.start.output.quarter === 1"
          },
          {
            "id": "q2",
            "label": "Quarter 2 - Summer",
            "expression": "$vars.start.output.quarter === 2"
          },
          {
            "id": "q3",
            "label": "Quarter 3 - Fall",
            "expression": "$vars.start.output.quarter === 3"
          },
          {
            "id": "q4",
            "label": "Quarter 4 - Winter",
            "expression": "$vars.start.output.quarter === 4"
          }
        ]
      }
    },
    {
      "id": "setSpring",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Set Spring"
      },
      "inputs": {
        "script": "return { season: 'Spring' };"
      }
    },
    {
      "id": "setSummer",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Set Summer"
      },
      "inputs": {
        "script": "return { season: 'Summer' };"
      }
    },
    {
      "id": "setFall",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Set Fall"
      },
      "inputs": {
        "script": "return { season: 'Fall' };"
      }
    },
    {
      "id": "setWinter",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Set Winter"
      },
      "inputs": {
        "script": "return { season: 'Winter' };"
      }
    },
    {
      "id": "endSpring",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End Spring"
      },
      "inputs": {},
      "outputs": {
        "season": {
          "source": "=js:$vars.setSpring.output.season"
        }
      }
    },
    {
      "id": "endSummer",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End Summer"
      },
      "inputs": {},
      "outputs": {
        "season": {
          "source": "=js:$vars.setSummer.output.season"
        }
      }
    },
    {
      "id": "endFall",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End Fall"
      },
      "inputs": {},
      "outputs": {
        "season": {
          "source": "=js:$vars.setFall.output.season"
        }
      }
    },
    {
      "id": "endWinter",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End Winter"
      },
      "inputs": {},
      "outputs": {
        "season": {
          "source": "=js:$vars.setWinter.output.season"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "edge-start-switch",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "switchQuarter",
      "targetPort": "input"
    },
    {
      "id": "edge-switch-spring",
      "sourceNodeId": "switchQuarter",
