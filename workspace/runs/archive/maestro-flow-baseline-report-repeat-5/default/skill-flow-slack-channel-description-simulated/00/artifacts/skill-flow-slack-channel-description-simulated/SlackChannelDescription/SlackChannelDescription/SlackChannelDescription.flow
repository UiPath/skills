  "name": "SlackChannelDescription",
  "nodes": [
    {
      "id": "logDescription1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log Channel Description"
      },
      "inputs": {
        "script": "const info = $vars.getChannelInfo1.output;\nconst name = info && info.name ? info.name : '(unknown)';\nconst purpose = info && info.purpose && info.purpose.value ? info.purpose.value : '(no description set)';\nconst topic = info && info.topic && info.topic.value ? info.topic.value : '(no topic set)';\nreturn {\n  channelName: name,\n  description: purpose,\n  topic: topic,\n  summary: 'Channel: #' + name + ' | Description: ' + purpose + ' | Topic: ' + topic\n};"
      }
    },
    {
      "id": "end1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {}
