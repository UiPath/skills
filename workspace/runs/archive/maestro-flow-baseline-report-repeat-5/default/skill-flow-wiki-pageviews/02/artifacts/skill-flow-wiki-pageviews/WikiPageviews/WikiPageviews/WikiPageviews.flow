{
  "id": "b9b2095a-6821-48ca-b23d-3babe61dcf39",
  "version": "1.8",
  "name": "WikiPageviews",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "7e89fae8-c5f3-40aa-8303-e8bcecbb7370",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "fetchPageviews1",
      "type": "core.action.http.v2",
      "typeVersion": "2.3",
      "display": {
        "label": "Fetch Pageviews"
      },
      "inputs": {
        "branches": [],
        "timeout": "PT15M",
        "retryCount": 0,
        "errorHandlingEnabled": true,
        "detail": {
          "connector": "uipath-uipath-http",
          "connectionId": "ImplicitConnection",
          "connectionResourceId": null,
          "connectionFolderKey": null,
          "method": "POST",
          "endpoint": "/http-request",
          "bodyParameters": {
            "authentication": "manual",
            "method": "GET",
            "url": "=js:`https://wikimedia.org/api/rest_v1/metrics/pageviews/per-article/en.wikipedia/all-access/user/${$vars.article}/daily/${$vars.date1}/${$vars.date2}`",
            "headers": {
              "User-Agent": "WikiPageviewsFlow/1.0 (example@example.com)"
            }
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"connectorVersion\":\"1.4.50\",\"executionType\":null,\"customFieldsRequestDetails\":null,\"instanceParameters\":{\"connectorKey\":\"uipath-uipath-http\",\"objectName\":\"http-request\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\"},\"objectName\":\"http-request\",\"operation\":\"create\",\"packageVersion\":\"1.0.0\",\"httpMethod\":\"POST\",\"path\":\"/http-request\",\"unifiedTypesCompatible\":true,\"savedJitInputFieldId\":\"in_http-request\"}}",
          "uiPathActivityTypeId": "5c4cc855-b42a-37e6-b910-de8588998fce",
          "errorState": {
            "issues": []
          },
          "telemetryData": {
            "connectorKey": "uipath-uipath-http",
            "connectorName": "HTTP",
            "operationType": "create",
            "objectName": "http-request",
            "objectDisplayName": "HTTP Request",
            "primaryKeyName": ""
          }
        }
      }
    },
    {
      "id": "filterHighTraffic",
      "type": "core.action.transform.filter",
      "typeVersion": "1.0",
      "display": {
        "label": "Filter Views > 500"
      },
      "inputs": {
        "collection": "$vars.fetchPageviews1.output.body.items",
        "operations": [
          {
            "id": "op1",
            "type": "filter",
            "config": {
              "operation": "and",
              "filters": [
                {
                  "id": "f1",
                  "field": "views",
                  "condition": "greater_than",
                  "value": 500
                }
              ]
            }
          }
        ]
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the transform",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the transform fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "sumViews",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Sum Views"
      },
      "inputs": {
        "script": "const items = $vars.filterHighTraffic.output;\nconst arr = Array.isArray(items) ? items : [];\nconst total = arr.reduce(function(sum, item) { return sum + (item.views || 0); }, 0);\nreturn { total: total };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "endSuccess",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Done"
      },
      "inputs": {},
      "outputs": {
        "result": {
          "source": "=js:$vars.sumViews.output.total"
        }
      }
    },
    {
      "id": "endError",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Article Not Found"
      },
      "inputs": {},
      "outputs": {
        "result": {
          "source": "=js:'Article not found'"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "e-start-fetchPageviews1",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "fetchPageviews1",
      "targetPort": "input"
    },
    {
      "id": "e-fetchPageviews1-filterHighTraffic",
      "sourceNodeId": "fetchPageviews1",
      "sourcePort": "default",
      "targetNodeId": "filterHighTraffic",
      "targetPort": "input"
    },
    {
      "id": "e-fetchPageviews1-endError",
      "sourceNodeId": "fetchPageviews1",
      "sourcePort": "error",
      "targetNodeId": "endError",
      "targetPort": "input"
    },
    {
      "id": "e-filterHighTraffic-sumViews",
      "sourceNodeId": "filterHighTraffic",
      "sourcePort": "output",
      "targetNodeId": "sumViews",
      "targetPort": "input"
    },
    {
      "id": "e-sumViews-endSuccess",
      "sourceNodeId": "sumViews",
      "sourcePort": "success",
      "targetNodeId": "endSuccess",
      "targetPort": "input"
    }
  ],
