        "type": "boolean",
        "description": "Whether engineering escalation is needed"
      },
      {
        "id": "responseMode",
        "direction": "out",
        "type": "string",
        "description": "Response mode: Immediate, SameDay, NextBusinessDay, or Standard"
      },
      {
        "id": "caseKey",
        "direction": "out",
        "type": "string",
        "description": "Case key formed as CASE-{correlationId}"
      }
