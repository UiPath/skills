        "description": "Customer tier (e.g. Enterprise, Premier, Standard)",
        "triggerNodeId": "start"
      },
      {
        "id": "productionDown",
        "direction": "in",
        "type": "boolean",
        "description": "Whether production is currently down for the customer",
        "triggerNodeId": "start"
      },
      {
        "id": "workaroundAvailable",
        "direction": "in",
        "type": "boolean",
        "description": "Whether a workaround is available for the issue",
        "triggerNodeId": "start"
      },
      {
        "id": "businessImpact",
        "direction": "in",
        "type": "string",
        "description": "Business impact level (e.g. High, Medium, Low)",
        "triggerNodeId": "start"
      },
      {
        "id": "correlationId",
        "direction": "in",
        "type": "string",
        "description": "Unique identifier for the escalation",
        "triggerNodeId": "start"
      },
      {
        "id": "severity",
        "direction": "out",
        "type": "string",
        "description": "Computed severity: Critical, High, Medium, or Low"
      },
      {
        "id": "engineeringNeeded",
