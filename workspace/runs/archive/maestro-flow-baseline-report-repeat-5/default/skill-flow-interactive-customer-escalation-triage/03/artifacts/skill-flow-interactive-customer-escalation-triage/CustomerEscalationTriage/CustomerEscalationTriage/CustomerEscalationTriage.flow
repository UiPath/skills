        "shape": "circle"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ]
        }
      ],
      "model": {
        "type": "bpmn:EndEvent"
      },
      "runtimeConstraints": {
        "exclude": [
          "api-function"
        ]
      }
    }
  ],
  "variables": {
    "globals": [
      {
        "id": "customerTier",
        "direction": "in",
        "type": "string",
        "description": "Customer tier (e.g. Enterprise, Standard)"
      },
      {
        "id": "productionDown",
        "direction": "in",
        "type": "boolean",
        "description": "Whether production is fully down"
      },
      {
        "id": "workaroundAvailable",
        "direction": "in",
        "type": "boolean",
        "description": "Whether a workaround is available"
      },
      {
        "id": "businessImpact",
        "direction": "in",
        "type": "string",
        "description": "Description of the business impact"
      },
      {
        "id": "correlationId",
        "direction": "in",
        "type": "string",
        "description": "Correlation ID for the escalation case"
      },
      {
        "id": "severity",
        "direction": "out",
        "type": "string",
        "description": "Classified severity level (Sev1, Sev2, Sev3)"
      },
      {
        "id": "engineeringNeeded",
        "direction": "out",
        "type": "boolean",
        "description": "Whether engineering escalation is needed"
      },
      {
        "id": "responseMode",
        "direction": "out",
        "type": "string",
        "description": "Response mode for the case"
      },
      {
        "id": "caseKey",
        "direction": "out",
        "type": "string",
        "description": "Case key (echoes correlationId)"
      }
    ],
    "nodes": [
