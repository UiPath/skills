{
  "id": "605de869-9ef7-450f-bbee-e1f46bb33c45",
  "version": "1.8",
  "name": "CustomerEscalationTriage",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "3c9b755a-ddd7-4dfa-b997-25c1fd5864bc",
        "isDefaultEntryPoint": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the workflow.",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "computeTriage",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Compute Triage"
      },
      "inputs": {
        "script": "const tier = $vars.customerTier || '';\nconst prodDown = $vars.productionDown === true;\nconst workaround = $vars.workaroundAvailable === true;\n\nlet sev;\nif (tier === 'Enterprise' && prodDown && !workaround) {\n  sev = 'Sev1';\n} else if (prodDown && workaround) {\n  sev = 'Sev2';\n} else {\n  sev = 'Sev3';\n}\n\nconst eng = sev === 'Sev1' || sev === 'Sev2';\n\nreturn { severity: sev, engineeringNeeded: eng, responseMode: 'Draft', caseKey: $vars.correlationId };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Done"
      },
      "inputs": {},
      "outputs": {
        "severity": {
          "source": "=js:$vars.computeTriage.output.severity"
        },
        "engineeringNeeded": {
          "source": "=js:$vars.computeTriage.output.engineeringNeeded"
        },
        "responseMode": {
          "source": "=js:$vars.computeTriage.output.responseMode"
        },
        "caseKey": {
          "source": "=js:$vars.computeTriage.output.caseKey"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "edge-start-computeTriage",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "computeTriage",
      "targetPort": "input"
    },
    {
      "id": "edge-computeTriage-end",
      "sourceNodeId": "computeTriage",
      "sourcePort": "success",
      "targetNodeId": "end",
      "targetPort": "input"
    }
  ],
  "definitions": [
    {
      "nodeType": "core.trigger.manual",
      "version": "1.0",
      "category": "trigger",
      "description": "Start workflow manually",
      "tags": [
        "trigger",
        "start",
        "manual"
      ],
      "sortOrder": 40,
      "display": {
        "label": "Manual trigger",
        "icon": "play",
        "shape": "circle"
      },
      "handleConfiguration": [
        {
          "position": "right",
          "handles": [
            {
              "id": "output",
              "type": "source",
              "handleType": "output",
              "showButton": true,
              "constraints": {
                "forbiddenTargetCategories": [
                  "trigger"
                ]
              }
            }
          ],
          "visible": true
        }
      ],
      "model": {
        "type": "bpmn:StartEvent",
        "entryPointId": true
      },
      "outputDefinition": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the workflow.",
          "source": "null",
          "var": "output"
        }
      },
      "toolbarExtensions": {
        "design": {
          "actions": [
            {
              "id": "change-trigger-type",
              "icon": "square-mouse-pointer",
              "label": "Change trigger type"
            }
          ]
        }
      }
    },
    {
      "nodeType": "core.action.script",
      "version": "1.0",
      "category": "data-operations",
      "description": "Run custom JavaScript code",
      "tags": [
        "code",
        "javascript",
        "python"
      ],
      "sortOrder": 35,
      "supportsErrorHandling": true,
      "display": {
        "label": "Script",
        "icon": "code"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ]
        },
        {
          "position": "right",
          "handles": [
            {
              "id": "success",
              "type": "source",
              "handleType": "output"
            },
            {
              "id": "error",
              "label": "Error",
              "type": "source",
              "handleType": "output",
              "visible": "{inputs.errorHandlingEnabled}",
              "constraints": {
                "maxConnections": 1
              }
            }
          ]
        }
      ],
      "debug": {
        "runtime": "clientScript"
      },
      "model": {
        "type": "bpmn:ScriptTask"
      },
      "inputDefinition": {
        "type": "object",
        "properties": {
          "script": {
            "type": "string",
            "minLength": 1,
            "errorMessage": "A script function is required",
            "validationSeverity": "warning"
          }
        },
        "required": [
          "script"
        ]
      },
      "inputDefaults": {
        "script": ""
      },
      "outputDefinition": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "form": {
        "id": "script-properties",
        "title": "Script configuration",
        "sections": [
          {
            "id": "script",
            "title": "Script",
            "collapsible": true,
            "defaultExpanded": true,
            "fields": [
              {
                "name": "inputs.script",
                "type": "custom",
                "component": "script-editor",
                "componentProps": {
                  "language": "javascript",
                  "returnType": "any",
                  "validationMode": "script",
                  "minHeight": 200,
                  "placeholder": " // Return an object with your result\nreturn {\n  message: \"Web request response\",\n  data: $vars.httpRequest1.output\n                  };"
                },
                "label": "Code",
                "description": "JavaScript expression that returns a result object"
              }
            ]
          }
        ]
      }
    },
    {
      "nodeType": "core.control.end",
      "version": "1.0",
      "category": "control-flow",
      "description": "Mark the end of a workflow path",
      "tags": [
        "control-flow",
        "end",
        "finish",
        "complete"
      ],
      "sortOrder": 20,
      "display": {
        "label": "End",
        "icon": "circle-check",
        "shape": "circle"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ]
        }
      ],
      "model": {
        "type": "bpmn:EndEvent"
      },
      "runtimeConstraints": {
        "exclude": [
          "api-function"
        ]
      }
    }
  ],
  "bindings": [],
  "variables": {
    "globals": [
      {
        "id": "customerTier",
        "direction": "in",
        "type": "string",
        "description": "Customer tier: platinum, gold, silver, or standard"
      },
      {
        "id": "productionDown",
        "direction": "in",
        "type": "boolean",
        "description": "Whether the customer's production system is currently down"
      },
      {
        "id": "workaroundAvailable",
        "direction": "in",
        "type": "boolean",
        "description": "Whether a workaround is available for the reported issue"
      },
      {
        "id": "businessImpact",
        "direction": "in",
        "type": "string",
        "description": "Business impact level: critical, high, medium, or low"
      },
      {
        "id": "correlationId",
        "direction": "in",
        "type": "string",
        "description": "Correlation ID for tracking this escalation"
      },
      {
        "id": "severity",
        "direction": "out",
        "type": "string",
        "description": "Computed severity level: P1, P2, P3, or P4"
      },
      {
        "id": "engineeringNeeded",
        "direction": "out",
        "type": "boolean",
        "description": "Whether engineering escalation is required"
      },
      {
        "id": "responseMode",
        "direction": "out",
        "type": "string",
        "description": "Required response mode: immediate, urgent, standard, or low-priority"
      },
      {
        "id": "caseKey",
        "direction": "out",
        "type": "string",
        "description": "Unique case key composed from correlationId and severity"
      }
    ],
    "nodes": [
      {
        "id": "start.output",
        "type": "object",
        "description": "Data passed when manually triggering the workflow.",
        "binding": {
          "nodeId": "start",
          "outputId": "output"
        }
      },
      {
