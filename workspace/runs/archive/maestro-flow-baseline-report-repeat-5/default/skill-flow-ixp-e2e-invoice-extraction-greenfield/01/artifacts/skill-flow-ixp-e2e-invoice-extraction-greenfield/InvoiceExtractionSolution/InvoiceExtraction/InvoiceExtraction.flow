    {
      "nodeType": "core.action.http.v2",
      "version": "2.3",
      "category": "data-operations",
      "description": "HTTP request with managed authentication",
      "tags": ["connector", "http", "api", "rest", "request"],
      "sortOrder": 35,
      "supportsErrorHandling": true,
      "display": { "label": "HTTP Request", "icon": "app-window" },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            { "id": "input", "type": "target", "handleType": "input", "label": "" }
          ]
        },
        {
          "position": "right",
          "handles": [
            {
              "id": "branch-{item.id}",
              "type": "source",
              "handleType": "output",
              "label": "{item.name}",
              "repeat": "inputs.branches"
            },
            { "id": "default", "type": "source", "handleType": "output", "label": "" },
            {
              "id": "error",
              "label": "Error",
              "type": "source",
              "handleType": "output",
              "visible": "{inputs.errorHandlingEnabled}",
              "constraints": { "maxConnections": 1 }
            }
          ],
          "visible": true
        }
      ],
      "debug": { "runtime": "bpmnEngine" },
      "model": {
        "type": "bpmn:ServiceTask",
        "serviceType": "Intsvc.UnifiedHttpRequest",
        "context": [
          { "name": "connectorKey", "type": "string", "value": "uipath-uipath-http" },
          { "name": "objectName", "type": "string", "value": "http-request" },
          { "name": "connection", "type": "string", "value": "<bindings.uipath-uipath-http connection>" },
          { "name": "folderKey", "type": "string", "value": "<bindings.FolderKey>" },
          { "name": "activityConfigurationVersion", "type": "string", "value": "v1" },
          {
            "name": "metadata",
            "body": {
              "telemetryData": { "connectorKey": "uipath-uipath-http", "connectorName": "HTTP Request" },
              "inputMetadata": {},
              "errorState": { "hasError": true }
            },
            "type": "json"
          }
        ],
        "expansion": {
          "processLevelVariables": [
            { "id": "{nodeId}.output", "name": "output", "type": "jsonSchema", "elementId": "{nodeId}", "custom": true },
            { "condition": "hasEdgeFromHandle('error')", "id": "{nodeId}.error", "name": "error", "type": "jsonSchema", "elementId": "{nodeId}", "custom": true }
          ],
          "nodes": [
            {
              "id": "{nodeId}",
              "type": "bpmn:SubProcess",
              "replaceOriginal": true,
              "data": {
                "label": "{node.data.label}",
                "isExpanded": true,
                "model": {
                  "serviceType": "BPMN.Variables",
                  "subprocessVariables": {
                    "inputOutputs": [
                      { "id": "response", "name": "response", "type": "jsonSchema", "variableType": "inputOutput" },
                      { "id": "error", "name": "error", "type": "jsonSchema", "variableType": "inputOutput" }
                    ]
                  },
                  "outputs": [
                    { "name": "output", "type": "jsonSchema", "source": "=vars.response", "var": "{nodeId}.output", "custom": true },
                    { "name": "error", "type": "jsonSchema", "source": "=vars.error", "var": "{nodeId}.error", "custom": true }
                  ]
                }
              },
              "nodes": [
                { "id": "_Implicit_StartEvent_{nodeId}", "type": "bpmn:StartEvent", "parentId": "{nodeId}", "position": { "x": 0, "y": 0 }, "data": { "label": "HTTP Request Start" } },
                {
                  "id": "_Implicit_HttpTask_{nodeId}",
                  "type": "bpmn:SendTask",
                  "parentId": "{nodeId}",
                  "position": { "x": 0, "y": 0 },
                  "propagate": {
                    "detail": true,
                    "retry": {
                      "condition": "node.data.inputs.retryCount > 0",
                      "maxRetryCount": "node.data.inputs.retryCount",
                      "retryBackoff": "node.data.inputs.timeout",
                      "retryBackoffDefault": "PT1S",
                      "retryAllErrors": "true",
                      "retryBackoffType": "Static"
                    }
                  },
                  "data": {
                    "label": "{node.data.label}",
                    "model": {
                      "serviceType": "Intsvc.UnifiedHttpRequest",
                      "context": [
                        { "name": "connectorKey", "type": "string", "value": "uipath-uipath-http" },
                        { "name": "objectName", "type": "string", "value": "http-request" },
                        { "name": "connection", "type": "string", "value": "<bindings.uipath-uipath-http connection>" },
                        { "name": "folderKey", "type": "string", "value": "<bindings.FolderKey>" },
                        { "name": "activityConfigurationVersion", "type": "string", "value": "v1" },
                        {
                          "name": "metadata",
                          "body": {
                            "telemetryData": { "connectorKey": "uipath-uipath-http", "connectorName": "HTTP Request" },
                            "inputMetadata": {},
                            "errorState": { "hasError": true }
                          },
                          "type": "json"
                        }
                      ],
                      "outputs": [
                        { "name": "response", "type": "json", "source": "=response", "var": "response", "internal": true }
                      ]
                    }
                  }
                },
                {
                  "id": "_Implicit_Gateway_{nodeId}",
                  "type": "bpmn:ExclusiveGateway",
                  "parentId": "{nodeId}",
                  "position": { "x": 0, "y": 0 },
                  "condition": "node.data.inputs.branches.length > 0",
                  "data": { "label": "Response branch", "defaultFlowId": "_Implicit_Edge__Implicit_Gateway_{nodeId}__Implicit_EndEvent_Default_{nodeId}" }
                },
                { "forEach": "node.data.inputs.branches", "id": "_Implicit_EndEvent_{branchName}_{nodeId}", "type": "bpmn:EndEvent", "parentId": "{nodeId}", "position": { "x": 0, "y": 0 }, "data": { "label": "{branch.name}" } },
                { "id": "_Implicit_EndEvent_Default_{nodeId}", "type": "bpmn:EndEvent", "parentId": "{nodeId}", "position": { "x": 0, "y": 0 }, "data": { "label": "Default" } },
                {
                  "condition": "hasEdgeFromHandle('error')",
                  "id": "_Implicit_EndEvent_Failure_{nodeId}",
                  "type": "bpmn:EndEvent",
                  "parentId": "{nodeId}",
                  "position": { "x": 0, "y": 0 },
                  "data": {
                    "label": "Failure",
                    "model": {
                      "serviceType": "BPMN.Variables",
                      "outputs": [
                        { "name": "error", "type": "boolean", "source": "=true", "var": "error", "internal": true }
                      ]
                    }
                  }
                },
                {
                  "condition": "hasEdgeFromHandle('error')",
                  "id": "_Implicit_BoundaryError_{nodeId}",
                  "type": "bpmn:BoundaryEvent",
                  "parentId": "{nodeId}",
                  "position": { "x": 0, "y": 0 },
                  "data": {
                    "label": "Error",
                    "cancelActivity": false,
                    "attachedToId": "_Implicit_HttpTask_{nodeId}",
                    "eventDefinition": { "type": "bpmn:ErrorEventDefinition", "id": "_Implicit_BoundaryError_{nodeId}_Error" },
                    "model": {
                      "outputs": [
                        { "name": "Error", "type": "jsonSchema", "source": "=Error", "var": "response", "internal": true }
                      ]
                    }
                  }
                }
              ],
              "edges": [
                { "id": "_Implicit_Edge__Implicit_StartEvent_{nodeId}__Implicit_HttpTask_{nodeId}", "source": "_Implicit_StartEvent_{nodeId}", "target": "_Implicit_HttpTask_{nodeId}", "type": "bpmn:SequenceFlow", "data": {} },
                { "condition": "node.data.inputs.branches.length === 0", "id": "_Implicit_Edge__Implicit_HttpTask_{nodeId}__Implicit_EndEvent_Default_{nodeId}", "source": "_Implicit_HttpTask_{nodeId}", "target": "_Implicit_EndEvent_Default_{nodeId}", "type": "bpmn:SequenceFlow", "data": {} },
                { "condition": "node.data.inputs.branches.length > 0", "id": "_Implicit_Edge__Implicit_HttpTask_{nodeId}__Implicit_Gateway_{nodeId}", "source": "_Implicit_HttpTask_{nodeId}", "target": "_Implicit_Gateway_{nodeId}", "type": "bpmn:SequenceFlow", "data": {} },
                { "forEach": "node.data.inputs.branches", "condition": "node.data.inputs.branches.length > 0", "id": "_Implicit_Edge__Implicit_Gateway_{nodeId}__Implicit_EndEvent_{branchName}_{nodeId}", "source": "_Implicit_Gateway_{nodeId}", "target": "_Implicit_EndEvent_{branchName}_{nodeId}", "type": "bpmn:SequenceFlow", "data": { "conditionExpression": "{branch.conditionExpression}", "label": "{branch.name}" } },
                { "condition": "node.data.inputs.branches.length > 0", "id": "_Implicit_Edge__Implicit_Gateway_{nodeId}__Implicit_EndEvent_Default_{nodeId}", "source": "_Implicit_Gateway_{nodeId}", "target": "_Implicit_EndEvent_Default_{nodeId}", "type": "bpmn:SequenceFlow", "data": { "label": "Default" } },
                { "condition": "hasEdgeFromHandle('error')", "id": "_Implicit_Edge__Implicit_BoundaryError_{nodeId}__Implicit_EndEvent_Failure_{nodeId}", "source": "_Implicit_BoundaryError_{nodeId}", "target": "_Implicit_EndEvent_Failure_{nodeId}", "type": "bpmn:SequenceFlow", "data": {} }
              ]
            },
            {
              "id": "_Implicit_PostSubprocessGateway_{nodeId}",
              "type": "bpmn:ExclusiveGateway",
              "condition": "(node.data.inputs.branches.length > 0 || hasEdgeFromHandle('error')) && originalEdges.length > 0",
              "parentId": null,
              "position": { "x": 0, "y": 0 },
              "data": { "label": "Post-Subprocess Branch" }
            }
          ],
          "edges": [
            { "condition": "(node.data.inputs.branches.length > 0 || hasEdgeFromHandle('error')) && originalEdges.length > 0", "id": "_Implicit_Edge_{nodeId}__Implicit_PostSubprocessGateway_{nodeId}", "source": "{nodeId}", "target": "_Implicit_PostSubprocessGateway_{nodeId}", "type": "bpmn:SequenceFlow", "data": {} },
            { "forEach": "node.data.inputs.branches", "condition": "node.data.inputs.branches.length > 0", "matchOriginalEdgeByHandle": "branch-{branch.id}", "preserveEdgeId": true, "source": "_Implicit_PostSubprocessGateway_{nodeId}", "type": "bpmn:SequenceFlow", "data": { "conditionExpression": "{branch.conditionExpression}", "label": "{branch.name}" } },
            { "condition": "node.data.inputs.branches.length > 0 || hasEdgeFromHandle('error')", "matchOriginalEdgeByHandle": "default", "preserveEdgeId": true, "source": "_Implicit_PostSubprocessGateway_{nodeId}", "type": "bpmn:SequenceFlow", "data": { "label": "Default" } },
            { "condition": "hasEdgeFromHandle('error')", "matchOriginalEdgeByHandle": "error", "preserveEdgeId": true, "source": "_Implicit_PostSubprocessGateway_{nodeId}", "type": "bpmn:SequenceFlow", "data": { "conditionExpression": "=js:vars.{nodeId}.error || vars.{nodeId}.output?.statusCode >= 400", "label": "Error" } },
            { "condition": "node.data.inputs.branches.length === 0 && !hasEdgeFromHandle('error')", "matchOriginalEdgeByHandle": "default", "preserveEdgeId": true, "source": "{nodeId}", "type": "bpmn:SequenceFlow" }
          ]
        }
      },
      "inputDefinition": {
        "type": "object",
        "properties": {
          "branches": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "conditionExpression": { "type": "string" }
              }
            }
          },
          "timeout": {
            "type": "string",
            "pattern": "^P(?!$)(\\d+Y)?(\\d+M)?(\\d+W)?(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+S)?)?$",
            "errorMessage": { "pattern": "Timeout must be in ISO 8601 duration format (e.g., PT15M, PT1H, P1D)" }
          },
          "retryCount": { "type": "number" }
        }
      },
      "inputDefaults": { "branches": [], "timeout": "PT15M", "retryCount": 0 },
      "outputDefinition": {
        "output": { "type": "object", "description": "HTTP response object", "source": "=response", "var": "output" },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": ["code", "message", "detail", "category", "status"],
            "properties": {
              "code": { "type": "string", "description": "Error code as a string" },
              "message": { "type": "string", "description": "High-level error message" },
              "detail": { "type": "string", "description": "Detailed error description" },
              "category": { "type": "string", "description": "Error category" },
              "status": { "type": "integer", "description": "HTTP status code" }
            },
            "additionalProperties": false
          }
        }
      },
