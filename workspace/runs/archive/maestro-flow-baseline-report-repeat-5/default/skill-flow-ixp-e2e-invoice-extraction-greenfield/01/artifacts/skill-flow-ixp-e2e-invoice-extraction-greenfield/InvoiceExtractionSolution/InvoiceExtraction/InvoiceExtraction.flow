    {
      "id": "buildSapPayload1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Build SAP Payload"
      },
      "inputs": {
        "script": "const fields = ($vars.extractInvoiceFields1.output.ExtractionResult?.ResultsDocument?.Fields) || [];\nconst tables = ($vars.extractInvoiceFields1.output.ExtractionResult?.ResultsDocument?.Tables) || [];\nconst getField = (name) => fields.find(f => f.FieldName === name)?.Values?.[0] ?? null;\nreturn {\n  invoiceNumber: getField('InvoiceNumber'),\n  vendorName: getField('VendorName'),\n  invoiceDate: getField('InvoiceDate'),\n  totalAmount: getField('TotalAmount'),\n  lineItems: tables.map(t => t.Values)\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": ["code", "message", "detail", "category", "status"],
            "properties": {
              "code": { "type": "string", "description": "Error code as a string" },
              "message": { "type": "string", "description": "High-level error message" },
              "detail": { "type": "string", "description": "Detailed error description" },
              "category": { "type": "string", "description": "Error category" },
              "status": { "type": "integer", "description": "HTTP status code" }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "id": "postInvoiceToSap1",
      "type": "core.action.http.v2",
      "typeVersion": "2.3",
      "display": {
        "label": "Post Invoice to SAP"
      },
      "inputs": {
        "branches": [],
        "timeout": "PT15M",
