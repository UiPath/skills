{
  "id": "c9e8f9d5-0a57-40ca-8fc1-ef8778082257",
  "version": "1.8",
  "name": "InvoiceExtractionFlow",
  "nodes": [
    {
      "id": "postInvoiceToSap1",
      "type": "core.action.http.v2",
      "typeVersion": "2.3",
      "display": {
        "label": "POST Invoice to SAP"
      },
      "inputs": {
        "branches": [],
        "timeout": "PT15M",
        "retryCount": 0
      }
    },
    {
      "id": "extractInvoice1",
      "type": "uipath.ixp.invoiceixp-cef0d447-ixp.ff973488-5d89-8035-86ac-f980b4be6deb-c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Extract Invoice Fields"
      },
      "inputs": {
        "model": {
          "id": "ff973488-5d89-8035-86ac-f980b4be6deb",
          "modelName": "invoiceixp-cef0d447-ixp",
          "modelDisplayName": "InvoiceIXP",
          "folderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "folderName": "Shared",
          "folderPath": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "description": ""
        },
        "modelName": "invoiceixp-cef0d447-ixp",
        "projectName": "invoiceixp-cef0d447-ixp",
        "versionTag": "",
        "folderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
        "folderName": "Shared",
        "fileRef": "=js:$vars.downloadInvoicePdf1.output",
        "pageRange": ""
      },
      "outputs": {
        "output": {
          "name": "output",
          "type": "object",
          "source": "=this.result",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "buildSapPayload1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Build SAP Payload"
      },
      "inputs": {
        "script": "var fields = ($vars.extractInvoice1.output && $vars.extractInvoice1.output.ExtractionResult && $vars.extractInvoice1.output.ExtractionResult.ResultsDocument) ? ($vars.extractInvoice1.output.ExtractionResult.ResultsDocument.Fields || []) : [];\nvar tables = ($vars.extractInvoice1.output && $vars.extractInvoice1.output.ExtractionResult && $vars.extractInvoice1.output.ExtractionResult.ResultsDocument) ? ($vars.extractInvoice1.output.ExtractionResult.ResultsDocument.Tables || []) : [];\nfunction getField(names) { for (var i = 0; i < names.length; i++) { var f = fields.find(function(x) { return x.FieldName === names[i]; }); if (f && f.Values && f.Values.length > 0) return f.Values[0]; } return null; }\nreturn { invoiceNumber: getField(['InvoiceNumber', 'invoice_number', 'Invoice Number', 'Invoice #']), vendor: getField(['VendorName', 'Vendor', 'vendor', 'Supplier']), invoiceDate: getField(['InvoiceDate', 'invoice_date', 'Invoice Date', 'Date']), totalAmount: getField(['TotalAmount', 'total_amount', 'Total Amount', 'Total', 'Amount Due']), lineItems: tables };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "end1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      }
    }
  ],
  "edges": [
    {
      "id": "e-extract-script",
      "sourceNodeId": "extractInvoice1",
      "sourcePort": "success",
      "targetNodeId": "buildSapPayload1",
      "targetPort": "input"
    },
    {
      "id": "e-script-http",
