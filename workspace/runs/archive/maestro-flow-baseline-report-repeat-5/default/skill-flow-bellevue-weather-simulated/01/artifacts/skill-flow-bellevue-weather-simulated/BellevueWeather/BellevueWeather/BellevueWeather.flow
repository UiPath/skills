{
  "id": "dd819c19-1065-4f7a-a655-63257fadd01a",
  "version": "1.8",
  "name": "BellevueWeather",
  "nodes": [
    {
      "id": "evaluateWeather1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Evaluate Weather"
      },
      "inputs": {
        "script": "const w = $vars.getBellevueWeather1.output.current_weather;\nconst tempC = w ? w.temperature : null;\nconst tempF = tempC !== null ? Math.round(tempC * 9 / 5 + 32) : null;\nconst isNiceDay = tempF !== null && tempF > 60;\nconst message = isNiceDay ? 'nice day' : 'bring a jacket';\nreturn { isNiceDay: isNiceDay, message: message, temperatureF: tempF };"
      }
    },
    {
      "id": "end1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      }
    },
    {
