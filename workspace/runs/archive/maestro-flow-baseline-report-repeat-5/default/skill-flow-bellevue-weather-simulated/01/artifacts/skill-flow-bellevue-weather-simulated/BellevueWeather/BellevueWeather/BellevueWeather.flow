      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "c0fe1ef7-d0f6-47f0-b8e5-3ae4f6f8ce5a",
        "isDefaultEntryPoint": true
      }
    },
