{
  "id": "2bd72adc-7e3a-4ceb-9576-2e62f55ff847",
  "version": "1.8",
  "name": "BellevueWeatherFlow",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "2625c15a-c27d-4770-9e19-288fbc3f358d",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "getBellevueWeather1",
      "type": "uipath.connector.custom-codereval-openmeteoapis.getcurrentweather",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Get Bellevue Weather"
      },
      "inputs": {
        "detail": {
          "connector": "custom-codereval-openmeteoapis",
          "connectionId": "21ca654f-b67b-4f97-9eb3-1f93bd3bb5cc",
          "connectionResourceId": "21ca654f-b67b-4f97-9eb3-1f93bd3bb5cc",
          "connectionFolderKey": "5da18ec0-7de1-4e57-aaf1-ddc8a369c199",
          "method": "GET",
          "endpoint": "/forecast",
          "queryParameters": {
            "latitude": 47.6101,
            "longitude": -122.2015,
            "current_weather": true,
            "temperature_unit": "fahrenheit"
          },
          "uiPathActivityTypeId": "e39eee57-b09f-36fb-b131-4f4feb46b707",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"instanceParameters\":{\"connectorKey\":\"custom-codereval-openmeteoapis\",\"objectName\":\"V1Forecast\",\"httpMethod\":\"GETBYID\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"V1Forecast\",\"operation\":\"retrieve\",\"httpMethod\":\"GET\",\"path\":\"/forecast\",\"packageVersion\":\"1.0.0\",\"connectorVersion\":null,\"executionType\":null,\"customFieldsRequestDetails\":null,\"unifiedTypesCompatible\":true}}"
        }
      }
    },
    {
      "id": "evaluateWeather1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Evaluate Weather"
      },
      "inputs": {
        "script": "var temp = $vars.getBellevueWeather1.output.current_weather.temperature;\n\n// Nice day: above 60 F. At or below 60 F: bring a jacket.\nvar isNice = temp > 60;\n\nreturn {\n  isNiceDay: isNice,\n  temperature: temp,\n  message: isNice ? 'nice day' : 'bring a jacket'\n};"
      }
    },
    {
      "id": "isNiceDay1",
      "type": "core.logic.decision",
      "typeVersion": "1.1",
      "display": {
        "label": "Is it a nice day?"
      },
      "inputs": {
        "expression": "$vars.evaluateWeather1.output.isNiceDay === true",
        "trueLabel": "Yes, nice day!",
        "falseLabel": "Not so nice"
      }
    },
    {
      "id": "endNiceDay",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "nice day"
      },
      "inputs": {}
    },
    {
      "id": "endNotNiceDay",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "bring a jacket"
      },
      "inputs": {}
    }
  ],
  "edges": [
    {
      "id": "e1",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "getBellevueWeather1",
      "targetPort": "input"
    },
    {
      "id": "e2",
      "sourceNodeId": "getBellevueWeather1",
