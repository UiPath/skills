      "id": "e3",
      "sourceNodeId": "evaluateWeather1",
      "sourcePort": "success",
      "targetNodeId": "isNiceDay1",
      "targetPort": "input"
    },
    {
      "id": "e4",
      "sourceNodeId": "isNiceDay1",
      "sourcePort": "true",
      "targetNodeId": "endNiceDay",
      "targetPort": "input"
    },
    {
      "id": "e5",
      "sourceNodeId": "isNiceDay1",
      "sourcePort": "false",
      "targetNodeId": "endNotNiceDay",
      "targetPort": "input"
    }
  ],
