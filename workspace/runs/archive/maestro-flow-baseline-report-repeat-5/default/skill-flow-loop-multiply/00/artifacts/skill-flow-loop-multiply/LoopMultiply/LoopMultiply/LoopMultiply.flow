{
  "id": "cb2f586f-a551-4d4b-a5fd-91f2b0e3bd3d",
  "version": "1.8",
  "name": "LoopMultiply",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "06c6835e-1b2f-427c-8858-95f5cad75219",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "loop1",
      "type": "core.logic.loop",
      "typeVersion": "2.4",
      "display": {
        "label": "Loop over numbers"
      },
      "inputs": {
        "collection": "=js:$vars.numbers",
        "parallel": false
      }
    },
    {
      "id": "multiply",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Multiply"
      },
      "inputs": {
        "script": "return $vars.product * $vars.loop1.currentItem;"
      },
      "parentId": "loop1"
    },
    {
      "id": "end1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {},
      "outputs": {
        "product": {
          "source": "=js:$vars.product"
        },
        "result": {
          "source": "=js:$vars.product"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "loop1",
      "targetPort": "input"
    },
    {
      "id": "e2",
      "sourceNodeId": "loop1",
      "sourcePort": "start",
      "targetNodeId": "multiply",
      "targetPort": "input"
    },
    {
      "id": "e3",
      "sourceNodeId": "multiply",
      "sourcePort": "success",
      "targetNodeId": "loop1",
      "targetPort": "continue"
    },
    {
      "id": "e4",
      "sourceNodeId": "loop1",
      "sourcePort": "success",
      "targetNodeId": "end1",
      "targetPort": "input"
    }
  ],
  "definitions": [
    {
      "nodeType": "core.trigger.manual",
