          "connectionFolderKey": "5da18ec0-7de1-4e57-aaf1-ddc8a369c199",
          "method": "POST",
          "endpoint": "/curated_create_issue",
          "bodyParameters": {
            "fields.project.key": "CE",
            "fields.issuetype.id": "11457",
            "fields.summary": "=js:$vars.loop1.currentItem.summary"
          },
          "uiPathActivityTypeId": "f90a75ba-d728-34b6-a84a-fb1f995b784b",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"instanceParameters\":{\"connectorKey\":\"uipath-atlassian-jira\",\"objectName\":\"curated_create_issue\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"curated_create_issue\",\"operation\":\"create\",\"httpMethod\":\"POST\",\"path\":\"/curated_create_issue\",\"packageVersion\":\"1.0.0\",\"connectorVersion\":null,\"executionType\":null,\"customFieldsRequestDetails\":{\"objectActionName\":\"GenerateSchema\",\"parameterValues\":[[\"fields_sub_project_sub_key\",\"CE\"],[\"fields_sub_issuetype_sub_id\",\"11457\"]]},\"unifiedTypesCompatible\":true,\"savedJitInputFieldId\":\"in_curated_create_issue\"}}"
        }
      },
      "parentId": "loop1"
    },
    {
      "id": "decision1",
      "type": "core.logic.decision",
      "typeVersion": "1.1",
      "display": {
        "label": "Is High Priority?"
      },
      "inputs": {
        "expression": "$vars.loop1.currentItem.priority === \"High\""
      },
      "parentId": "loop1"
    },
