{
  "id": "d9eed5d4-7c4d-46f5-b444-939b9f6f6265",
  "version": "1.8",
  "name": "POReview",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "3a878b24-23d8-47e3-8cb8-c546b0d38350",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "mockPO1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Generate Mock PO"
      },
      "inputs": {
        "script": "return {\n  poNumber: \"PO-2026-0042\",\n  vendorName: \"Acme Supplies Ltd.\",\n  itemDescription: \"Office Equipment - Standing Desks (x10)\",\n  quantity: 10,\n  unitPrice: 450.00,\n  totalAmount: 4500.00,\n  department: \"Engineering\",\n  requestedBy: \"Alex Johnson\",\n  requestedDate: \"2026-07-20\"\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "poReview1",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "PO Review"
      },
      "inputs": {
        "title": "Purchase Order Review",
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group"
          }
        },
        "priority": "High",
        "schema": {
          "schemaId": "b2f4e8a1-3c7d-4f9b-a5e2-8d1c6f3b0e47",
          "fields": [
            {
              "id": "ponumber",
              "label": "PO Number",
              "type": "string",
              "direction": "input",
              "binding": "vars.mockPO1.output.poNumber"
            },
            {
              "id": "vendorname",
              "label": "Vendor Name",
              "type": "string",
              "direction": "input",
              "binding": "vars.mockPO1.output.vendorName"
            },
            {
              "id": "itemdescription",
              "label": "Item Description",
              "type": "string",
              "direction": "input",
              "binding": "vars.mockPO1.output.itemDescription"
            },
            {
              "id": "quantity",
              "label": "Quantity",
              "type": "number",
              "direction": "input",
              "binding": "vars.mockPO1.output.quantity"
            },
            {
              "id": "unitprice",
              "label": "Unit Price ($)",
              "type": "number",
              "direction": "input",
              "binding": "vars.mockPO1.output.unitPrice"
            },
            {
              "id": "totalamount",
              "label": "Total Amount ($)",
              "type": "number",
              "direction": "input",
              "binding": "vars.mockPO1.output.totalAmount"
            },
            {
              "id": "department",
              "label": "Department",
              "type": "string",
              "direction": "input",
              "binding": "vars.mockPO1.output.department"
            },
            {
              "id": "requestedby",
              "label": "Requested By",
              "type": "string",
              "direction": "input",
              "binding": "vars.mockPO1.output.requestedBy"
            },
            {
              "id": "notes",
              "label": "Notes (optional)",
              "type": "string",
              "direction": "output",
              "variable": "vars.reviewNotes"
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "End"
            }
          ]
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "notes": {
              "type": "string"
            },
            "Action": {
              "type": "string",
              "enum": [
                "Approve",
                "Reject"
              ],
              "default": "Approve"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": [
            "Approve",
            "Reject"
          ],
          "default": "Approve"
        }
      }
    },
    {
      "id": "routeDecision1",
      "type": "core.logic.decision",
      "typeVersion": "1.1",
      "display": {
        "label": "Approved?"
      },
      "inputs": {
        "expression": "$vars.poReview1.status === \"Approve\"",
        "trueLabel": "Approved",
        "falseLabel": "Rejected"
      }
    },
    {
      "id": "handleApproval1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Handle Approval"
      },
      "inputs": {
        "script": "const po = $vars.mockPO1.output;\nconst notes = $vars.poReview1.output.notes || \"\";\nreturn {\n  status: \"APPROVED\",\n  poNumber: po.poNumber,\n  approvedAmount: po.totalAmount,\n  approvedBy: \"Reviewer\",\n  notes: notes,\n  message: \"Purchase Order \" + po.poNumber + \" has been approved for $\" + po.totalAmount\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "handleRejection1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Handle Rejection"
      },
      "inputs": {
        "script": "const po = $vars.mockPO1.output;\nconst notes = $vars.poReview1.output.notes || \"\";\nreturn {\n  status: \"REJECTED\",\n  poNumber: po.poNumber,\n  rejectedAmount: po.totalAmount,\n  rejectedBy: \"Reviewer\",\n  notes: notes,\n  message: \"Purchase Order \" + po.poNumber + \" has been rejected. Reason: \" + (notes || \"No reason provided\")\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "endApproved",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "PO Approved"
      },
      "inputs": {}
    },
    {
      "id": "endRejected",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "PO Rejected"
      },
      "inputs": {}
    }
  ],
  "edges": [
    {
      "id": "edge-start-mockPO1",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "mockPO1",
      "targetPort": "input"
    },
    {
      "id": "edge-mockPO1-poReview1",
      "sourceNodeId": "mockPO1",
      "sourcePort": "success",
      "targetNodeId": "poReview1",
      "targetPort": "input"
    },
    {
      "id": "edge-poReview1-routeDecision1",
      "sourceNodeId": "poReview1",
      "sourcePort": "completed",
      "targetNodeId": "routeDecision1",
      "targetPort": "input"
    },
    {
      "id": "edge-routeDecision1-handleApproval1",
      "sourceNodeId": "routeDecision1",
      "sourcePort": "true",
      "targetNodeId": "handleApproval1",
      "targetPort": "input"
    },
    {
      "id": "edge-routeDecision1-handleRejection1",
      "sourceNodeId": "routeDecision1",
      "sourcePort": "false",
      "targetNodeId": "handleRejection1",
      "targetPort": "input"
    },
    {
      "id": "edge-handleApproval1-endApproved",
      "sourceNodeId": "handleApproval1",
      "sourcePort": "success",
      "targetNodeId": "endApproved",
      "targetPort": "input"
    },
    {
      "id": "edge-handleRejection1-endRejected",
      "sourceNodeId": "handleRejection1",
      "sourcePort": "success",
      "targetNodeId": "endRejected",
      "targetPort": "input"
    }
  ],
  "definitions": [
    {
      "nodeType": "core.trigger.manual",
