{
  "id": "6c3a73e9-04f9-4bab-9a25-31a2db0fba04",
  "version": "1.8",
  "name": "VendorPOReview",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "b689724c-e02f-489a-88ff-9bd07d81381d",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "mockPoData1",
      "type": "core.code.javascript",
      "typeVersion": "1.0",
      "display": {
        "label": "Mock PO Data"
      },
      "inputs": {
        "code": "return {\n  poNumber: \"PO-2024-001\",\n  vendorName: \"Acme Supplies Inc.\",\n  totalAmount: 4750.00\n};"
      }
    },
    {
      "id": "poReview1",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "PO Review"
      },
      "inputs": {
        "title": "PO Review",
        "recipient": {
          "channels": ["Email", "ActionCenter"],
          "connections": {},
          "assignee": { "type": "group" }
        },
        "priority": "High",
        "schema": {
          "schemaId": "7b3e9c12-4a5f-4d8e-b1f6-2c8a3d9e0f45",
          "fields": [
            {
              "id": "ponumber",
              "label": "PO Number",
              "type": "string",
              "direction": "input",
              "binding": "vars.mockPoData1.output.poNumber"
            },
            {
              "id": "vendorname",
              "label": "Vendor Name",
              "type": "string",
              "direction": "input",
              "binding": "vars.mockPoData1.output.vendorName"
            },
            {
              "id": "totalamount",
              "label": "Total Amount ($)",
              "type": "number",
              "direction": "input",
              "binding": "vars.mockPoData1.output.totalAmount"
            },
            {
              "id": "notes",
              "label": "Notes",
              "type": "string",
              "direction": "output",
              "variable": "vars.notes",
              "required": false
            }
          ],
          "outcomes": [
            { "id": "approve", "name": "Approve", "type": "string", "isPrimary": true,  "action": "Continue" },
            { "id": "reject",  "name": "Reject",  "type": "string", "isPrimary": false, "action": "End" }
          ]
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "notes":  { "type": "string" },
            "Action": { "type": "string", "enum": ["Approve", "Reject"], "default": "Approve" }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": ["Approve", "Reject"],
          "default": "Approve"
        }
      }
    },
    {
      "id": "logApproval1",
      "type": "core.code.javascript",
      "typeVersion": "1.0",
      "display": {
        "label": "Log Approval"
      },
      "inputs": {
        "code": "const poNumber = $vars.mockPoData1.output.poNumber;\nconst vendorName = $vars.mockPoData1.output.vendorName;\nconst totalAmount = $vars.mockPoData1.output.totalAmount;\nconst notes = $vars.poReview1.output.notes;\nconsole.log(`PO ${poNumber} from ${vendorName} ($${totalAmount}) was approved.`);\nif (notes) {\n  console.log(`Reviewer notes: ${notes}`);\n}\nreturn { logged: true, poNumber: poNumber };"
      }
    }
  ],
  "edges": [
    {
      "id": "start-output-mockPoData1-input",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "mockPoData1",
      "targetPort": "input"
    },
    {
      "id": "mockPoData1-output-poReview1-input",
      "sourceNodeId": "mockPoData1",
      "sourcePort": "output",
      "targetNodeId": "poReview1",
      "targetPort": "input"
    },
    {
      "id": "poReview1-completed-logApproval1-input",
      "sourceNodeId": "poReview1",
      "sourcePort": "completed",
      "targetNodeId": "logApproval1",
      "targetPort": "input"
    }
  ],
  "definitions": [
    {
      "nodeType": "core.trigger.manual",
      "version": "1.0",
      "category": "trigger",
      "description": "Start workflow manually",
      "tags": [
        "trigger",
        "start",
        "manual"
      ],
      "sortOrder": 40,
      "display": {
        "label": "Manual trigger",
        "icon": "play",
        "shape": "circle"
      },
      "handleConfiguration": [
        {
          "position": "right",
          "handles": [
            {
              "id": "output",
              "type": "source",
              "handleType": "output",
              "showButton": true,
              "constraints": {
                "forbiddenTargetCategories": [
                  "trigger"
                ]
              }
            }
          ],
          "visible": true
        }
      ],
      "model": {
        "type": "bpmn:StartEvent",
        "entryPointId": true
      },
      "outputDefinition": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the workflow.",
          "source": "null",
          "var": "output"
        }
      },
      "toolbarExtensions": {
        "design": {
          "actions": [
            {
              "id": "change-trigger-type",
              "icon": "square-mouse-pointer",
              "label": "Change trigger type"
            }
          ]
        }
      }
    },
    {
      "nodeType": "core.code.javascript",
      "version": "1.0",
      "category": "action",
      "description": "Execute a JavaScript code snippet",
      "tags": ["code", "script", "javascript"],
      "sortOrder": 10,
      "display": {
        "label": "Code",
        "icon": "code",
        "shape": "rectangle"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ],
          "visible": true
        },
        {
          "position": "right",
          "handles": [
            {
              "id": "output",
              "type": "source",
              "handleType": "output",
              "showButton": true,
              "constraints": {
                "forbiddenTargetCategories": ["trigger"]
              }
            }
          ],
          "visible": true
        }
      ],
      "model": { "type": "bpmn:ScriptTask" },
      "outputDefinition": {
        "output": {
          "type": "object",
          "description": "Script output",
          "source": "=result",
          "var": "output"
        }
      }
    },
    {
      "nodeType": "uipath.human-in-the-loop.quick-form",
      "version": "1.0",
      "category": "human-task",
      "description": "Fast inline approvals with inline debug",
      "tags": ["human-task", "hitl", "human-in-the-loop", "quick-form", "approval"],
      "sortOrder": 27,
      "display": {
        "label": "Quick Form",
        "icon": "users",
        "shape": "square"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ],
          "visible": true
        },
        {
          "position": "right",
          "handles": [
            {
              "id": "completed",
              "label": "Completed",
              "type": "source",
              "handleType": "output",
              "showButton": true,
              "constraints": {
                "forbiddenTargetCategories": ["trigger"]
              }
            }
          ],
          "visible": true
        }
      ],
      "model": { "type": "bpmn:UserTask", "serviceType": "Actions.HITL" },
      "inputDefaults": {
        "schema": {
          "fields": [],
          "outcomes": [
            { "id": "submit", "name": "Submit", "type": "string", "isPrimary": true, "action": "Continue" }
          ]
        },
        "recipient": {
          "channels": ["Email", "ActionCenter"],
          "connections": {},
          "assignee": { "type": "group" }
        }
      },
      "outputDefinition": {
        "output": { "type": "object", "description": "Task result data", "source": "=result", "var": "output" },
        "status": { "type": "string", "description": "Task completion status", "source": "=result.Action", "var": "status" }
      }
    }
  ],
  "layout": {
    "nodes": {
      "start": {
        "position": { "x": 256, "y": 144 }
      },
      "mockPoData1": {
        "position": { "x": 512, "y": 144 }
      },
      "poReview1": {
        "position": { "x": 768, "y": 144 }
      },
      "logApproval1": {
        "position": { "x": 1024, "y": 144 }
      }
    }
  },
  "variables": {
    "nodes": [
      {
        "id": "start.output",
        "type": "object",
        "description": "Data passed when manually triggering the workflow.",
        "binding": { "nodeId": "start", "outputId": "output" }
      },
      {
        "id": "mockPoData1.output",
        "type": "object",
        "description": "Mock PO data output",
        "binding": { "nodeId": "mockPoData1", "outputId": "output" }
      },
      {
        "id": "poReview1.output",
        "type": "object",
        "description": "Task result data",
        "binding": { "nodeId": "poReview1", "outputId": "output" }
      },
      {
        "id": "poReview1.status",
        "type": "string",
        "description": "Task completion status",
        "binding": { "nodeId": "poReview1", "outputId": "status" }
      },
      {
        "id": "logApproval1.output",
        "type": "object",
        "description": "Script output",
        "binding": { "nodeId": "logApproval1", "outputId": "output" }
      }
    ]
  }
}
