{
  "id": "d0677592-42d8-487c-8fdd-74fedf85c822",
  "version": "1.8",
  "name": "POReview",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "c9c1aeaf-3207-4f9f-afe6-124e64937b61",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "mockPOData1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Mock PO Data"
      },
      "inputs": {
        "script": "return {\n  poNumber: \"PO-2024-0042\",\n  vendorName: \"Acme Supplies Ltd\",\n  totalAmount: 14750\n};"
      }
    },
    {
      "id": "reviewPO1",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "Review PO"
      },
      "inputs": {
        "title": "Review PO",
        "recipient": {
          "channels": ["Email", "ActionCenter"],
          "connections": {},
          "assignee": {
            "type": "group"
          }
        },
        "priority": "High",
        "schema": {
          "schemaId": "229bd303-f7ed-4a26-bce7-3c8db2504da6",
          "fields": [
            {
              "id": "ponumber",
              "label": "PO Number",
              "type": "string",
              "direction": "input",
              "binding": "vars.mockPOData1.output.poNumber"
            },
            {
              "id": "vendorname",
              "label": "Vendor Name",
              "type": "string",
              "direction": "input",
              "binding": "vars.mockPOData1.output.vendorName"
            },
            {
              "id": "totalamount",
              "label": "Total Amount",
              "type": "number",
              "direction": "input",
              "binding": "vars.mockPOData1.output.totalAmount"
            },
            {
              "id": "notes",
              "label": "Notes",
              "type": "string",
              "direction": "output",
              "variable": "vars.notes"
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "End"
            }
          ]
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "notes": { "type": "string" },
            "Action": { "type": "string", "enum": ["Approve", "Reject"], "default": "Approve" }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": ["Approve", "Reject"],
          "default": "Approve"
        }
      }
    },
    {
      "id": "checkDecision1",
      "type": "core.logic.decision",
      "typeVersion": "1.1",
      "display": {
        "label": "Approved?"
      },
      "inputs": {
        "expression": "$vars.reviewPO1.status === \"approve\"",
        "trueLabel": "Approved",
        "falseLabel": "Rejected"
      }
    },
    {
      "id": "logApproval1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log Approval"
      },
      "inputs": {
        "script": "const poNumber = $vars.mockPOData1.output.poNumber;\nconst notes = $vars.reviewPO1.output.notes;\nreturn {\n  message: \"PO \" + poNumber + \" was approved.\",\n  notes: notes || \"\"\n};"
      }
    },
    {
      "id": "endApproved1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Done"
      },
      "inputs": {}
    },
    {
      "id": "endRejected1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Rejected — End"
      },
      "inputs": {}
    }
  ],
  "edges": [
    {
      "id": "start-output-mockPOData1-input",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "mockPOData1",
      "targetPort": "input"
    },
    {
      "id": "mockPOData1-success-reviewPO1-input",
      "sourceNodeId": "mockPOData1",
      "sourcePort": "success",
      "targetNodeId": "reviewPO1",
      "targetPort": "input"
    },
    {
      "id": "reviewPO1-completed-checkDecision1-input",
      "sourceNodeId": "reviewPO1",
      "sourcePort": "completed",
      "targetNodeId": "checkDecision1",
      "targetPort": "input"
    },
    {
      "id": "checkDecision1-true-logApproval1-input",
      "sourceNodeId": "checkDecision1",
      "sourcePort": "true",
      "targetNodeId": "logApproval1",
      "targetPort": "input"
    },
    {
      "id": "checkDecision1-false-endRejected1-input",
      "sourceNodeId": "checkDecision1",
      "sourcePort": "false",
      "targetNodeId": "endRejected1",
      "targetPort": "input"
    },
    {
      "id": "logApproval1-success-endApproved1-input",
      "sourceNodeId": "logApproval1",
      "sourcePort": "success",
      "targetNodeId": "endApproved1",
      "targetPort": "input"
    }
  ],
  "definitions": [
    {
      "nodeType": "core.trigger.manual",
      "version": "1.0",
      "category": "trigger",
      "description": "Start workflow manually",
      "tags": ["trigger", "start", "manual"],
      "sortOrder": 40,
      "display": {
        "label": "Manual trigger",
        "icon": "play",
        "shape": "circle"
      },
      "handleConfiguration": [
        {
          "position": "right",
          "handles": [
            {
              "id": "output",
              "type": "source",
              "handleType": "output",
              "showButton": true,
              "constraints": {
                "forbiddenTargetCategories": ["trigger"]
              }
            }
          ],
          "visible": true
        }
      ],
      "model": {
        "type": "bpmn:StartEvent",
        "entryPointId": true
      },
      "outputDefinition": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the workflow.",
          "source": "null",
          "var": "output"
        }
      },
      "toolbarExtensions": {
        "design": {
          "actions": [
            {
              "id": "change-trigger-type",
              "icon": "square-mouse-pointer",
              "label": "Change trigger type"
            }
          ]
        }
      }
    },
    {
      "nodeType": "core.action.script",
      "version": "1.0",
      "category": "data-operations",
      "description": "Run custom JavaScript code",
      "tags": ["code", "javascript", "python"],
      "sortOrder": 35,
      "display": {
        "label": "Script",
        "icon": "code"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ]
        },
        {
          "position": "right",
          "handles": [
            {
              "id": "success",
              "type": "source",
              "handleType": "output"
            }
          ]
        }
      ],
      "model": {
        "type": "bpmn:ScriptTask"
      },
      "outputDefinition": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "nodeType": "uipath.human-in-the-loop.quick-form",
      "version": "1.0",
      "category": "human-task",
      "description": "Fast inline approvals with inline debug",
      "tags": ["human-task", "hitl", "human-in-the-loop", "quick-form", "approval"],
      "sortOrder": 27,
      "display": {
        "label": "Quick Form",
        "icon": "users",
        "shape": "square"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ],
          "visible": true
        },
        {
          "position": "right",
          "handles": [
            {
              "id": "completed",
              "label": "Completed",
              "type": "source",
              "handleType": "output",
              "showButton": true,
              "constraints": {
                "forbiddenTargetCategories": ["trigger"]
              }
            }
          ],
          "visible": true
        }
      ],
      "model": {
        "type": "bpmn:UserTask",
        "serviceType": "Actions.HITL"
      },
      "inputDefaults": {
        "schema": {
          "fields": [],
          "outcomes": [
            {
              "id": "submit",
              "name": "Submit",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            }
          ]
        },
        "recipient": {
          "channels": ["Email", "ActionCenter"],
          "connections": {},
          "assignee": { "type": "group" }
        }
      },
      "outputDefinition": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output"
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status"
        }
      }
    },
    {
      "nodeType": "core.logic.decision",
      "version": "1.1",
      "category": "control-flow",
      "description": "Branch based on a true/false condition",
      "tags": ["control-flow", "if", "loop", "switch"],
      "sortOrder": 20,
      "display": {
        "label": "Decision",
        "icon": "trending-up-down"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ],
          "visible": true
        },
        {
          "position": "right",
          "handles": [
            {
              "id": "true",
              "type": "source",
              "handleType": "output",
              "label": "{inputs.trueLabel}",
              "constraints": { "minConnections": 1 }
            },
            {
              "id": "false",
              "type": "source",
              "handleType": "output",
              "label": "{inputs.falseLabel}"
            }
          ],
          "visible": true
        }
      ],
      "model": {
        "type": "bpmn:InclusiveGateway"
      },
      "inputDefinition": {
        "type": "object",
        "properties": {
          "expression": { "type": "string", "minLength": 1 },
          "trueLabel": { "type": "string" },
          "falseLabel": { "type": "string" }
        },
        "required": ["expression"]
      },
      "outputDefinition": {
        "matchedCase": {
          "type": "string",
          "description": "The label of the matched branch",
          "var": "matchedCase"
        },
        "matchedCaseId": {
          "type": "string",
          "description": "The branch that was taken (true or false)",
          "var": "matchedCaseId"
        }
      },
      "inputDefaults": {
        "trueLabel": "True",
        "falseLabel": "False"
      }
    },
    {
      "nodeType": "core.control.end",
      "version": "1.0",
      "category": "control-flow",
      "description": "Mark the end of a workflow path",
      "tags": ["control-flow", "end", "finish", "complete"],
      "sortOrder": 20,
      "display": {
        "label": "End",
        "icon": "circle-check",
        "shape": "circle"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ]
        }
      ],
      "model": {
        "type": "bpmn:EndEvent"
      }
    }
  ],
  "layout": {
    "nodes": {
      "start":          { "position": { "x": 80,  "y": 240 } },
      "mockPOData1":    { "position": { "x": 280, "y": 240 } },
      "reviewPO1":      { "position": { "x": 520, "y": 240 } },
      "checkDecision1": { "position": { "x": 760, "y": 240 } },
      "logApproval1":   { "position": { "x": 1000, "y": 160 } },
      "endApproved1":   { "position": { "x": 1240, "y": 160 } },
      "endRejected1":   { "position": { "x": 1000, "y": 320 } }
    }
  },
  "workflow": {
    "variables": {
      "nodes": [
        {
          "id": "start.output",
          "type": "object",
          "description": "Data passed when manually triggering the workflow.",
          "binding": { "nodeId": "start", "outputId": "output" }
        },
        {
          "id": "mockPOData1.output",
          "type": "object",
          "description": "The return value of the script",
          "binding": { "nodeId": "mockPOData1", "outputId": "output" }
        },
        {
          "id": "reviewPO1.output",
          "type": "object",
          "description": "Task result data",
          "binding": { "nodeId": "reviewPO1", "outputId": "output" }
        },
        {
          "id": "reviewPO1.status",
          "type": "string",
          "description": "Task completion status",
          "binding": { "nodeId": "reviewPO1", "outputId": "status" }
        },
        {
          "id": "checkDecision1.matchedCase",
          "type": "string",
          "description": "The label of the matched branch",
          "binding": { "nodeId": "checkDecision1", "outputId": "matchedCase" }
        },
        {
          "id": "checkDecision1.matchedCaseId",
          "type": "string",
          "description": "The branch that was taken (true or false)",
          "binding": { "nodeId": "checkDecision1", "outputId": "matchedCaseId" }
        },
        {
          "id": "logApproval1.output",
          "type": "object",
          "description": "The return value of the script",
          "binding": { "nodeId": "logApproval1", "outputId": "output" }
        }
      ],
      "globals": []
    }
  }
}
