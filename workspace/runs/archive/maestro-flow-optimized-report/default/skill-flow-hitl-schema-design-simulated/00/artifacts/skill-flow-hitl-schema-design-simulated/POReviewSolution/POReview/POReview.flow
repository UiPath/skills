{
  "id": "217021b9-e3da-4fbb-aeb5-1493d415ac5a",
  "version": "1.8",
  "name": "POReview",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "e7406c84-ee5e-46d9-ad62-ca4d70d0e6b1",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "fetchPO1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Fetch PO Data"
      },
      "inputs": {
        "script": "// Retrieve PO details by PO number passed from the trigger.\n// In production, replace this with an HTTP call to your ERP / procurement system.\nconst poNumber = $vars.start.output.poNumber;\nreturn {\n  poNumber: poNumber || \"PO-2026-0042\",\n  vendor: \"Acme Supplies Ltd.\",\n  totalAmount: 12500.00,\n  requestedBy: \"Jane Smith\",\n  submissionDate: \"2026-07-24\",\n  description: \"Office equipment and supplies for Q3 operations\",\n  lineItems: \"3x Laptop ($3,000 each), 10x Keyboard ($50 each), Misc. supplies ($1,000)\"\n};"
      }
    },
    {
      "id": "poReview1",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "PO Review"
      },
      "inputs": {
        "title": "Purchase Order Review",
        "recipient": {
          "channels": ["Email", "ActionCenter"],
          "connections": {},
          "assignee": { "type": "group" }
        },
        "priority": "High",
        "schema": {
          "schemaId": "b8f3c2d1-9a4e-4f7b-a5c6-2d3e4f5a6b7c",
          "fields": [
            {
              "id": "ponumber",
              "label": "PO Number",
              "type": "string",
              "direction": "input",
              "binding": "vars.fetchPO1.output.poNumber"
            },
            {
              "id": "vendor",
              "label": "Vendor",
              "type": "string",
              "direction": "input",
              "binding": "vars.fetchPO1.output.vendor"
            },
            {
              "id": "totalamount",
              "label": "Total Amount",
              "type": "number",
              "direction": "input",
              "binding": "vars.fetchPO1.output.totalAmount"
            },
            {
              "id": "requestedby",
              "label": "Requested By",
              "type": "string",
              "direction": "input",
              "binding": "vars.fetchPO1.output.requestedBy"
            },
            {
              "id": "submissiondate",
              "label": "Submission Date",
              "type": "date",
              "direction": "input",
              "binding": "vars.fetchPO1.output.submissionDate"
            },
            {
              "id": "description",
              "label": "Description",
              "type": "string",
              "direction": "input",
              "binding": "vars.fetchPO1.output.description"
            },
            {
              "id": "lineitems",
              "label": "Line Items",
              "type": "string",
              "direction": "input",
              "binding": "vars.fetchPO1.output.lineItems"
            },
            {
              "id": "notes",
              "label": "Notes",
              "type": "string",
              "direction": "output",
              "variable": "vars.reviewNotes",
              "required": false
            }
          ],
          "outcomes": [
            { "id": "approve", "name": "Approve", "type": "string", "isPrimary": true,  "action": "Continue" },
            { "id": "reject",  "name": "Reject",  "type": "string", "isPrimary": false, "action": "End" }
          ]
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "notes":  { "type": "string" },
            "Action": { "type": "string", "enum": ["Approve", "Reject"], "default": "Approve" }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": ["Approve", "Reject"],
          "default": "Approve"
        }
      }
    },
    {
      "id": "routeDecision1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Route Decision"
      },
      "inputs": {
        "script": "// This node is only reached when the reviewer clicks Approve.\n// Reject ends the flow at the review step and never runs this script.\nconst poNumber = $vars.fetchPO1.output.poNumber;\nreturn {\n  message: `PO ${poNumber} approved.`\n};"
      }
    }
  ],
  "edges": [
    {
      "id": "start-output-fetchPO1-input",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "fetchPO1",
      "targetPort": "input"
    },
    {
      "id": "fetchPO1-success-poReview1-input",
      "sourceNodeId": "fetchPO1",
      "sourcePort": "success",
      "targetNodeId": "poReview1",
      "targetPort": "input"
    },
    {
      "id": "poReview1-completed-routeDecision1-input",
      "sourceNodeId": "poReview1",
      "sourcePort": "completed",
      "targetNodeId": "routeDecision1",
      "targetPort": "input"
    }
  ],
  "definitions": [
    {
      "nodeType": "core.trigger.manual",
      "version": "1.0",
      "category": "trigger",
      "description": "Start workflow manually",
      "tags": [
        "trigger",
        "start",
        "manual"
      ],
      "sortOrder": 40,
      "display": {
        "label": "Manual trigger",
        "icon": "play",
        "shape": "circle"
      },
      "handleConfiguration": [
        {
          "position": "right",
          "handles": [
            {
              "id": "output",
              "type": "source",
              "handleType": "output",
              "showButton": true,
              "constraints": {
                "forbiddenTargetCategories": [
                  "trigger"
                ]
              }
            }
          ],
          "visible": true
        }
      ],
      "model": {
        "type": "bpmn:StartEvent",
        "entryPointId": true
      },
      "outputDefinition": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the workflow.",
          "source": "null",
          "var": "output"
        }
      },
      "toolbarExtensions": {
        "design": {
          "actions": [
            {
              "id": "change-trigger-type",
              "icon": "square-mouse-pointer",
              "label": "Change trigger type"
            }
          ]
        }
      }
    },
    {
      "nodeType": "core.action.script",
      "version": "1.0",
      "category": "data-operations",
      "description": "Run custom JavaScript code",
      "tags": ["code", "javascript", "python"],
      "sortOrder": 35,
      "supportsErrorHandling": true,
      "display": {
        "label": "Script",
        "icon": "code"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ]
        },
        {
          "position": "right",
          "handles": [
            {
              "id": "success",
              "type": "source",
              "handleType": "output"
            },
            {
              "id": "error",
              "label": "Error",
              "type": "source",
              "handleType": "output",
              "visible": "{inputs.errorHandlingEnabled}",
              "constraints": {
                "maxConnections": 1
              }
            }
          ]
        }
      ],
      "debug": {
        "runtime": "clientScript"
      },
      "model": {
        "type": "bpmn:ScriptTask"
      },
      "inputDefinition": {
        "type": "object",
        "properties": {
          "script": {
            "type": "string",
            "minLength": 1,
            "errorMessage": "A script function is required",
            "validationSeverity": "warning"
          }
        },
        "required": ["script"]
      },
      "inputDefaults": {
        "script": ""
      },
      "outputDefinition": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "nodeType": "uipath.human-in-the-loop.quick-form",
      "version": "1.0",
      "category": "human-task",
      "description": "Fast inline approvals with inline debug",
      "tags": ["human-task", "hitl", "human-in-the-loop", "quick-form", "approval"],
      "sortOrder": 27,
      "display": {
        "label": "Quick Form",
        "icon": "users",
        "shape": "square"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ],
          "visible": true
        },
        {
          "position": "right",
          "handles": [
            {
              "id": "completed",
              "label": "Completed",
              "type": "source",
              "handleType": "output",
              "showButton": true,
              "constraints": { "forbiddenTargetCategories": ["trigger"] }
            }
          ],
          "visible": true
        }
      ],
      "model": { "type": "bpmn:UserTask", "serviceType": "Actions.HITL" },
      "inputDefaults": {
        "schema": {
          "fields": [],
          "outcomes": [{ "id": "submit", "name": "Submit", "type": "string", "isPrimary": true, "action": "Continue" }]
        },
        "recipient": {
          "channels": ["Email", "ActionCenter"],
          "connections": {},
          "assignee": { "type": "group" }
        }
      },
      "outputDefinition": {
        "output": { "type": "object", "description": "Task result data", "source": "=result", "var": "output" },
        "status": { "type": "string", "description": "Task completion status", "source": "=result.Action", "var": "status" }
      }
    }
  ],
  "variables": {
    "nodes": [
      {
        "id": "start.output",
        "type": "object",
        "description": "Data passed when manually triggering the workflow.",
        "binding": { "nodeId": "start", "outputId": "output" }
      },
      {
        "id": "fetchPO1.output",
        "type": "object",
        "description": "The return value of the script",
        "binding": { "nodeId": "fetchPO1", "outputId": "output" }
      },
      {
        "id": "poReview1.output",
        "type": "object",
        "description": "Task result data",
        "binding": { "nodeId": "poReview1", "outputId": "output" }
      },
      {
        "id": "poReview1.status",
        "type": "string",
        "description": "Task completion status",
        "binding": { "nodeId": "poReview1", "outputId": "status" }
      },
      {
        "id": "routeDecision1.output",
        "type": "object",
        "description": "The return value of the script",
        "binding": { "nodeId": "routeDecision1", "outputId": "output" }
      }
    ]
  },
  "layout": {
    "nodes": {
      "start":           { "position": { "x": 256,  "y": 144 } },
      "fetchPO1":        { "position": { "x": 480,  "y": 144 } },
      "poReview1":       { "position": { "x": 720,  "y": 144 } },
      "routeDecision1":  { "position": { "x": 960,  "y": 144 } }
    }
  }
}
