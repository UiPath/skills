{
  "id": "6314690f-6d7a-496b-9223-56e0281c5293",
  "version": "1.8",
  "name": "HttpWebhook",
  "nodes": [
    {
      "id": "validatePayload",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Validate Payload"
      },
      "inputs": {
        "script": "var payload = $vars.httpWebhook1.output;\nvar body = payload && payload.body ? payload.body : payload;\nvar isValid = body !== null && body !== undefined && typeof body === 'object';\nvar statusCode = 200;\nvar message = 'OK';\nif (!isValid) {\n  statusCode = 400;\n  message = 'Bad Request: payload is not a valid JSON object';\n} else if (!body.hasOwnProperty('data')) {\n  statusCode = 422;\n  message = 'Unprocessable Entity: missing required field \"data\"';\n}\nreturn { statusCode: statusCode, message: message, valid: isValid && body.hasOwnProperty('data') };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the action fails.",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "end1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {},
      "outputs": {}
    },
    {
      "id": "httpWebhook1",
      "type": "uipath.connector.trigger.uipath-http-webhook.http-webhook",
