{
  "id": "30441fff-13ff-4a00-9d99-8094108ab999",
  "version": "1.8",
  "name": "CustomerEscalation",
  "nodes": [
    {
      "id": "emailReceived1",
      "type": "uipath.connector.trigger.uipath-microsoft-outlook365.email-received",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Email Received"
      },
      "inputs": {
        "entryPointId": "6240f6aa-db51-4678-a4be-eecd99ec4a68",
        "isDefaultEntryPoint": true,
        "detail": {
          "connector": "uipath-microsoft-outlook365",
          "connectionId": "dd657127-91f5-4568-a3a3-c024bc03fb0f",
          "connectionResourceId": "dd657127-91f5-4568-a3a3-c024bc03fb0f",
          "connectionFolderKey": "def71452-bad1-40fa-be08-da175e89bd1a",
          "eventParameters": {
            "parentFolderId": "AAMkAGNiNDVjZmJmLTczOTEtNDQ2MS04Njc2LTUwM2I3ZDgxOWQwMAAuAAAAAAAJJRkzOJfsTKZfQqhMUHzlAQAJDKUrZhoLQZ5wELpOfJPCAAAAAAEMAAA="
          },
          "objectName": "Message",
          "eventType": "EMAIL_RECEIVED",
          "eventMode": "polling",
          "filterExpression": "(parentFolderId == 'AAMkAGNiNDVjZmJmLTczOTEtNDQ2MS04Njc2LTUwM2I3ZDgxOWQwMAAuAAAAAAAJJRkzOJfsTKZfQqhMUHzlAQAJDKUrZhoLQZ5wELpOfJPCAAAAAAEMAAA=')",
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"instanceParameters\":{\"connectorKey\":\"uipath-microsoft-outlook365\",\"objectName\":\"Message\",\"activityType\":\"CuratedTrigger\",\"version\":\"1.0.0\",\"eventOperation\":\"EMAIL_RECEIVED\",\"eventMode\":\"polling\",\"supportsStreaming\":false},\"objectName\":\"Message\",\"packageVersion\":\"1.0.0\",\"connectorVersion\":null,\"executionType\":null,\"httpMethod\":null,\"path\":null,\"filter\":null}}",
          "uiPathActivityTypeId": "d76ca053-6e7e-3472-b98c-3094b802d83c",
          "errorState": {
            "issues": []
          }
        }
      }
    },
    {
      "id": "classifyEmail1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Classify Email"
      },
      "inputs": {
        "errorHandlingEnabled": true,
        "script": "const vipList = ($vars.vipDomains || 'acme.com,globex.com').split(',').map(d => d.trim().toLowerCase());\nconst keywordList = ($vars.urgentKeywords || 'urgent,critical,outage').split(',').map(k => k.trim().toLowerCase());\nconst emailOutput = $vars.emailReceived1.output;\nconst fromField = emailOutput.from || '';\nconst senderEmail = (typeof fromField === 'object' && fromField.emailAddress) ? fromField.emailAddress.address : String(fromField);\nconst senderDomain = senderEmail.toLowerCase().split('@')[1] || '';\nconst subject = (emailOutput.subject || '').toLowerCase();\nconst bodyRaw = emailOutput.body || '';\nconst bodyText = (typeof bodyRaw === 'object' && bodyRaw.content) ? bodyRaw.content : String(bodyRaw);\nconst emailText = subject + ' ' + bodyText.toLowerCase();\nconst isVip = vipList.some(d => senderDomain === d || senderDomain.endsWith('.' + d));\nconst isUrgent = keywordList.some(k => emailText.includes(k));\nconst isEscalation = isVip && isUrgent;\nreturn { isVip: isVip, isUrgent: isUrgent, isEscalation: isEscalation, reason: 'VIP:' + isVip + ' Urgent:' + isUrgent, senderEmail: senderEmail };"
      }
    },
    {
      "id": "checkEscalation1",
      "type": "core.logic.decision",
      "typeVersion": "1.1",
      "display": {
        "label": "Is Escalation"
      },
      "inputs": {
        "expression": "$vars.classifyEmail1.output.isEscalation === true",
        "trueLabel": "Escalate",
        "falseLabel": "Standard"
      }
    },
    {
      "id": "slackAlertToTeam1",
      "type": "uipath.connector.uipath-salesforce-slack.send-message-to-channel",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Slack Alert to Team"
      },
      "inputs": {
        "errorHandlingEnabled": true,
        "detail": {
          "connector": "uipath-salesforce-slack",
          "connectionId": "e03f734e-0f80-4e8a-a7c1-0ece309b0ca4",
          "connectionResourceId": "e03f734e-0f80-4e8a-a7c1-0ece309b0ca4",
          "connectionFolderKey": "def71452-bad1-40fa-be08-da175e89bd1a",
          "method": "POST",
          "endpoint": "/send_message_to_channel_v2",
          "bodyParameters": {
            "channel": "=js:$vars.slackChannelId",
            "text": "=js:\"🚨 *VIP Escalation Alert*\\n*From:* \" + $vars.classifyEmail1.output.senderEmail + \"\\n*Subject:* \" + $vars.emailReceived1.output.subject + \"\\n*Reason:* \" + $vars.classifyEmail1.output.reason + \"\\n\\nPlease action this immediately.\""
          },
          "queryParameters": {
            "send_as": "bot"
          },
          "uiPathActivityTypeId": "37a305b2-89b1-315d-b73f-1778839a6c47",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"instanceParameters\":{\"connectorKey\":\"uipath-salesforce-slack\",\"objectName\":\"send_message_to_channel_v2\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"send_message_to_channel_v2\",\"operation\":\"create\",\"httpMethod\":\"POST\",\"path\":\"/send_message_to_channel_v2\",\"packageVersion\":\"1.0.0\",\"connectorVersion\":null,\"executionType\":null,\"customFieldsRequestDetails\":null,\"unifiedTypesCompatible\":true,\"savedJitInputFieldId\":\"in_send_message_to_channel_v2\"}}"
        }
      }
    },
    {
      "id": "replyVipUrgent1",
      "type": "uipath.connector.uipath-microsoft-outlook365.reply-to-email",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Reply VIP Urgent"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-microsoft-outlook365",
          "connectionId": "dd657127-91f5-4568-a3a3-c024bc03fb0f",
          "connectionResourceId": "dd657127-91f5-4568-a3a3-c024bc03fb0f",
          "connectionFolderKey": "def71452-bad1-40fa-be08-da175e89bd1a",
          "method": "POST",
          "endpoint": "/ReplyToEmailV2",
          "bodyParameters": {
            "body": "=js:\"Thank you for contacting us. We have identified your message as high priority and a senior team member is now personally handling it. You can expect to hear from us very shortly.\\n\\nBest regards,\\nThe Support Team\""
          },
          "queryParameters": {
            "id": "=js:$vars.emailReceived1.output.id",
            "saveAsDraft": false
          },
          "uiPathActivityTypeId": "da9976dd-3d71-35b4-bb8c-509419cb46eb",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"instanceParameters\":{\"connectorKey\":\"uipath-microsoft-outlook365\",\"objectName\":\"ReplyToEmailV2\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"ReplyToEmailV2\",\"operation\":\"create\",\"httpMethod\":\"POST\",\"path\":\"/ReplyToEmailV2\",\"packageVersion\":\"1.0.0\",\"connectorVersion\":null,\"executionType\":null,\"customFieldsRequestDetails\":null,\"unifiedTypesCompatible\":true}}",
          "multipartParameters": [
            {
              "name": "file",
              "dataType": "file"
            },
            {
              "name": "body",
              "dataType": "string"
            }
          ],
          "inputMetadata": {
            "type": "multipart",
            "multipart": {
              "bodyFieldName": "body"
            }
          }
        }
      }
    },
    {
      "id": "createSupportTicket1",
      "type": "uipath.connector.uipath-zendesk-zendesk.create-ticket",
      "typeVersion": "1.0.0",
