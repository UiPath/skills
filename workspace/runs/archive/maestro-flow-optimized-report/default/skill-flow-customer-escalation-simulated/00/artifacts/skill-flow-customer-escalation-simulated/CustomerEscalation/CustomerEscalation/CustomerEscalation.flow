    {
      "id": "logError1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log Error"
      },
      "inputs": {
        "script": "const errs = [$vars.classifyEmail1 && $vars.classifyEmail1.error, $vars.slackAlertToTeam1 && $vars.slackAlertToTeam1.error, $vars.createSupportTicket1 && $vars.createSupportTicket1.error].filter(Boolean);\nconst err = errs[0] || {};\nreturn { errorMessage: err.message || 'Flow error occurred', errorCode: err.code || '', errorDetail: err.detail || '' };"
      }
    },
