          "connectionResourceId": "dd657127-91f5-4568-a3a3-c024bc03fb0f",
          "connectionFolderKey": "def71452-bad1-40fa-be08-da175e89bd1a",
          "method": "POST",
          "endpoint": "/ReplyToEmailV2",
          "bodyParameters": {
            "body": "=js:\"Thank you for contacting our support team. Your request has been logged and a ticket has been created for you.\\n\\nTicket Reference: #\" + $vars.createSupportTicket1.output.id + \"\\n\\nOur team will review your request and get back to you as soon as possible.\\n\\nBest regards,\\nThe Support Team\""
          },
          "queryParameters": {
            "id": "=js:$vars.emailReceived1.output.id",
            "saveAsDraft": false
          },
          "uiPathActivityTypeId": "da9976dd-3d71-35b4-bb8c-509419cb46eb",
          "errorState": {
            "issues": []
