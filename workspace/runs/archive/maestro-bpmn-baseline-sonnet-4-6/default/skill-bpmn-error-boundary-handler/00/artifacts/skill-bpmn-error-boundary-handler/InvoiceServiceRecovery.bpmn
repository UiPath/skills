<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="UiPath (https://bpmn.uipath.com)" exporterVersion="1.0">

  <!-- Error declaration: boundary event must reference an error with an errorCode -->
  <bpmn:error id="Error_InvoiceServiceFailed" name="InvoiceServiceFailed" errorCode="INVOICE_SERVICE_ERROR" />

  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:migrationVersion version="11.5" />
      <uipath:variables version="v1">
        <uipath:inputOutput id="Var_InvoicePayload" name="InvoicePayload" type="json" />
        <uipath:inputOutput id="Var_ServiceResponse" name="ServiceResponse" type="json" />
        <uipath:inputOutput id="Var_RecoveryResult" name="RecoveryResult" type="string" />
      </uipath:variables>
    </bpmn:extensionElements>

    <!-- Manual start event -->
    <bpmn:startEvent id="Start_1" name="Start">
      <bpmn:outgoing>Flow_Start_to_PostInvoice</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Post invoice to downstream service — registry template: Intsvc.UnifiedHttpRequest -->
    <!-- BpmnElement is bpmn:SendTask; normalised to lower-camel bpmn:sendTask -->
    <bpmn:sendTask id="Task_PostInvoice" name="Post Invoice">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Intsvc.UnifiedHttpRequest" version="v1" />
          <uipath:context>
            <uipath:input name="mode" value="manual" />
            <uipath:input name="method" value="POST" />
            <uipath:input name="url" value="https://downstream-service.example.com/invoices" />
            <uipath:input name="headers" value="{&quot;Content-Type&quot;:&quot;application/json&quot;}" />
            <uipath:input name="parameters" value="{}" />
            <uipath:input name="body" value="=vars.Var_InvoicePayload" />
          </uipath:context>
          <uipath:output name="response" type="jsonSchema" source="=response" var="Var_ServiceResponse" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_to_PostInvoice</bpmn:incoming>
      <bpmn:outgoing>Flow_PostInvoice_to_End_Success</bpmn:outgoing>
    </bpmn:sendTask>

    <!-- Interrupting error boundary event attached to Task_PostInvoice -->
    <bpmn:boundaryEvent id="Boundary_InvoiceError" name="Invoice Service Error"
        attachedToRef="Task_PostInvoice" cancelActivity="true">
      <bpmn:errorEventDefinition errorRef="Error_InvoiceServiceFailed" />
      <bpmn:outgoing>Flow_Boundary_to_Recovery</bpmn:outgoing>
    </bpmn:boundaryEvent>

    <!-- Happy-path end event -->
    <bpmn:endEvent id="End_Success" name="Invoice Posted">
      <bpmn:incoming>Flow_PostInvoice_to_End_Success</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Recovery task — registry template: BPMN.ScriptTask -->
    <!-- BpmnElement is bpmn:ScriptTask; normalised to lower-camel bpmn:scriptTask -->
    <bpmn:scriptTask id="Task_Recovery" name="Handle Service Failure" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{}]]></uipath:input>
          <uipath:output name="recoveryResult" type="string" var="Var_RecoveryResult" source="=result.response" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Boundary_to_Recovery</bpmn:incoming>
      <bpmn:outgoing>Flow_Recovery_to_End_Failure</bpmn:outgoing>
      <bpmn:script><![CDATA[return { response: "Invoice posting failed; recovery logged." };]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- Recovery end event -->
    <bpmn:endEvent id="End_Failure" name="Recovery Complete">
      <bpmn:incoming>Flow_Recovery_to_End_Failure</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="Flow_Start_to_PostInvoice"    sourceRef="Start_1"           targetRef="Task_PostInvoice" />
    <bpmn:sequenceFlow id="Flow_PostInvoice_to_End_Success" sourceRef="Task_PostInvoice" targetRef="End_Success" />
    <bpmn:sequenceFlow id="Flow_Boundary_to_Recovery"    sourceRef="Boundary_InvoiceError" targetRef="Task_Recovery" />
    <bpmn:sequenceFlow id="Flow_Recovery_to_End_Failure" sourceRef="Task_Recovery"      targetRef="End_Failure" />

  </bpmn:process>

  <!-- Diagram interchange: one BPMNShape per node, one BPMNEdge per flow -->
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_1">

      <!-- Shapes: lay out left-to-right on the happy path, recovery path below -->
      <bpmndi:BPMNShape id="S_Start_1" bpmnElement="Start_1">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_Task_PostInvoice" bpmnElement="Task_PostInvoice">
        <dc:Bounds x="250" y="78" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Boundary event shape sits on the edge of Task_PostInvoice -->
      <bpmndi:BPMNShape id="S_Boundary_InvoiceError" bpmnElement="Boundary_InvoiceError">
        <dc:Bounds x="282" y="140" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_End_Success" bpmnElement="End_Success">
        <dc:Bounds x="420" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_Task_Recovery" bpmnElement="Task_Recovery">
        <dc:Bounds x="250" y="250" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_End_Failure" bpmnElement="End_Failure">
        <dc:Bounds x="420" y="272" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Edges -->
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_Start_to_PostInvoice" bpmnElement="Flow_Start_to_PostInvoice">
        <di:waypoint x="196" y="118" />
        <di:waypoint x="250" y="118" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_PostInvoice_to_End_Success" bpmnElement="Flow_PostInvoice_to_End_Success">
        <di:waypoint x="350" y="118" />
        <di:waypoint x="420" y="118" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_Boundary_to_Recovery" bpmnElement="Flow_Boundary_to_Recovery">
        <di:waypoint x="300" y="176" />
        <di:waypoint x="300" y="250" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_Recovery_to_End_Failure" bpmnElement="Flow_Recovery_to_End_Failure">
        <di:waypoint x="350" y="290" />
        <di:waypoint x="420" y="290" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
