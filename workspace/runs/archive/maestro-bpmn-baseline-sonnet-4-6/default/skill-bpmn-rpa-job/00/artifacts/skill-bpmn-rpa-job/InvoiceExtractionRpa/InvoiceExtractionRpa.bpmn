<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="UiPath (https://bpmn.uipath.com)" exporterVersion="1.0">

  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:migrationVersion version="11.5" />
      <uipath:variables version="v1">
        <!-- Input variable: invoice document path passed to the RPA job -->
        <uipath:input id="Var_InvoiceDocPath" name="InvoiceDocPath" type="string" />
        <!-- Output variable: invoice title extracted by the RPA job -->
        <uipath:output id="Var_ExtractedTitle" name="ExtractedTitle" type="string" />
      </uipath:variables>
      <!-- Process-level binding for the Orchestrator RPA process resource -->
      <uipath:bindings version="v1">
        <uipath:binding
            id="Binding_InvoiceExtractJob"
            resource="process"
            propertyAttribute="Key"
            default="&lt;RELEASE_KEY&gt;" />
      </uipath:bindings>
    </bpmn:extensionElements>

    <!-- Start event: manual trigger -->
    <bpmn:startEvent id="Start_Manual" name="Start">
      <bpmn:extensionElements>
        <uipath:entryPointId value="00000000-0000-0000-0000-000000000001" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_StartToJob</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- RPA service task: Orchestrator.StartJob from registry template -->
    <bpmn:serviceTask id="Task_ExtractInvoiceTitle" name="Extract Invoice Title">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.StartJob" version="v1" />
          <uipath:context>
            <!-- Synthetic placeholder values; no real keys or IDs -->
            <uipath:input name="releaseKey" value="&lt;RELEASE_KEY&gt;" />
            <uipath:input name="folderId" value="&lt;FOLDER_ID&gt;" />
            <uipath:input name="folderPath" value="&lt;FOLDER_PATH&gt;" />
            <uipath:input name="name" value="InvoiceExtractionProcess" />
          </uipath:context>
          <!-- Job argument: bind the InvoiceDocPath process variable as input -->
          <uipath:input name="JobArguments" type="json" target="bodyField"><![CDATA[{"invoiceDocPath":"=vars.Var_InvoiceDocPath"}]]></uipath:input>
          <!-- Capture job response into the ExtractedTitle process variable -->
          <uipath:output name="Process response" type="Orchestrator.RunJob" var="Var_ExtractedTitle" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_StartToJob</bpmn:incoming>
      <bpmn:outgoing>Flow_JobToEnd</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- End event -->
    <bpmn:endEvent id="End_1" name="End">
      <bpmn:incoming>Flow_JobToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="Flow_StartToJob" sourceRef="Start_Manual" targetRef="Task_ExtractInvoiceTitle" />
    <bpmn:sequenceFlow id="Flow_JobToEnd" sourceRef="Task_ExtractInvoiceTitle" targetRef="End_1" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_1">
      <!-- Start event -->
      <bpmndi:BPMNShape id="S_Start_Manual" bpmnElement="Start_Manual">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <!-- RPA service task -->
      <bpmndi:BPMNShape id="S_Task_ExtractInvoiceTitle" bpmnElement="Task_ExtractInvoiceTitle">
        <dc:Bounds x="260" y="78" width="160" height="80" />
      </bpmndi:BPMNShape>
      <!-- End event -->
      <bpmndi:BPMNShape id="S_End_1" bpmnElement="End_1">
        <dc:Bounds x="492" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <!-- Edges -->
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_StartToJob" bpmnElement="Flow_StartToJob">
        <di:waypoint x="196" y="118" />
        <di:waypoint x="260" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_JobToEnd" bpmnElement="Flow_JobToEnd">
        <di:waypoint x="420" y="118" />
        <di:waypoint x="492" y="118" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
