<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="UiPath (https://bpmn.uipath.com)" exporterVersion="1.0">

  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:migrationVersion version="11.5" />
      <uipath:variables version="v1">
        <!-- amount: process input supplied by the manual start trigger -->
        <uipath:inputOutput id="Var_Amount"      name="amount"      type="number" />
        <!-- daysOverdue: process input supplied by the manual start trigger -->
        <uipath:inputOutput id="Var_DaysOverdue" name="daysOverdue" type="number" />
        <!-- riskScore: output produced by the script task -->
        <uipath:output      id="Var_RiskScore"   name="riskScore"   type="number" />
      </uipath:variables>
    </bpmn:extensionElements>

    <!-- Manual start event: amount and daysOverdue are supplied as process inputs -->
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_StartToScript</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Script task: calculates risk score using Jint-compatible JavaScript v3 -->
    <bpmn:scriptTask id="Task_CalculateRiskScore" name="Calculate Risk Score"
                     scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <!-- v3 is the current preferred script version -->
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <!--
            Input mapping: fields are exposed as top-level identifiers in the
            script body (i.e. `amount` and `daysOverdue`, not `args.amount`).
            Variable-id expressions (=vars.<id>) are required here.
          -->
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"amount":"=vars.Var_Amount","daysOverdue":"=vars.Var_DaysOverdue"}]]></uipath:input>
          <!--
            Output mapping: `source="=result.response"` binds the `response`
            property returned by the script.  `var` points at the declared
            variable id; the target id is NOT placed in `name`.
          -->
          <uipath:output name="riskScore" type="number" var="Var_RiskScore" source="=result.response" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_StartToScript</bpmn:incoming>
      <bpmn:outgoing>Flow_ScriptToEnd</bpmn:outgoing>
      <!--
        Jint runtime: no Node.js modules, no filesystem, no network, no browser
        globals.  The mapped args fields (`amount`, `daysOverdue`) are injected
        as top-level identifiers.  Return an object with a `response` property
        so the output mapping `source="=result.response"` resolves correctly.
      -->
      <bpmn:script><![CDATA[
var score = (amount * 0.05) + (daysOverdue * 3);
return { response: score };
]]></bpmn:script>
    </bpmn:scriptTask>

    <bpmn:endEvent id="EndEvent_1" name="End">
      <bpmn:incoming>Flow_ScriptToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_StartToScript"
                       sourceRef="StartEvent_1"
                       targetRef="Task_CalculateRiskScore" />
    <bpmn:sequenceFlow id="Flow_ScriptToEnd"
                       sourceRef="Task_CalculateRiskScore"
                       targetRef="EndEvent_1" />
  </bpmn:process>

  <!-- BPMN DI: one BPMNShape per node, one BPMNEdge per sequence flow -->
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_1">

      <!-- Start event: 36x36 -->
      <bpmndi:BPMNShape id="S_StartEvent_1" bpmnElement="StartEvent_1">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Script task: 100x80, centred on y=100 -->
      <bpmndi:BPMNShape id="S_Task_CalculateRiskScore" bpmnElement="Task_CalculateRiskScore">
        <dc:Bounds x="260" y="78" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- End event: 36x36 -->
      <bpmndi:BPMNShape id="S_EndEvent_1" bpmnElement="EndEvent_1">
        <dc:Bounds x="432" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Flow: Start -> Script task -->
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_StartToScript" bpmnElement="Flow_StartToScript">
        <di:waypoint x="196" y="118" />
        <di:waypoint x="260" y="118" />
      </bpmndi:BPMNEdge>

      <!-- Flow: Script task -> End -->
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_ScriptToEnd" bpmnElement="Flow_ScriptToEnd">
        <di:waypoint x="360" y="118" />
        <di:waypoint x="432" y="118" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
