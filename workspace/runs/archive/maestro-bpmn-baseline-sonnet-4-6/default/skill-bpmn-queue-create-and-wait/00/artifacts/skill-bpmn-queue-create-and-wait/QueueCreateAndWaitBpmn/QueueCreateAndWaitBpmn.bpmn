<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="UiPath (https://bpmn.uipath.com)" exporterVersion="1.0">

  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:migrationVersion version="11.5" />
      <uipath:variables version="v1">
        <!-- Input: the JSON payload to place on the queue -->
        <uipath:inputOutput id="Var_ItemPayload" name="ItemPayload" type="json" />
        <!-- Output: the processed queue item returned by CreateAndWaitForQueueItem -->
        <uipath:output id="Var_ProcessedItem" name="ProcessedItem" type="Orchestrator.CreateQueueItem" />
      </uipath:variables>
    </bpmn:extensionElements>

    <!-- ============================================================
         Nodes
    ============================================================ -->

    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_Start_To_CreateAndWait</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Synchronous wrapper: blocks until the queue item is processed.
         Template: Orchestrator.CreateAndWaitForQueueItem (registry get).
         BPMN host normalised from bpmn:ServiceTask to bpmn:serviceTask. -->
    <bpmn:serviceTask id="Task_CreateAndWait" name="Create and wait for queue item">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.CreateAndWaitForQueueItem" version="v1" />
          <uipath:context>
            <uipath:input name="queueName" value="&lt;QUEUE_NAME&gt;" />
            <uipath:input name="folderId" value="&lt;FOLDER_ID&gt;" />
            <uipath:input name="folderPath" value="&lt;FOLDER_PATH&gt;" />
          </uipath:context>
          <!-- Bind the process variable Var_ItemPayload as the queue item body -->
          <uipath:input name="ItemData" type="json" target="body"><![CDATA[{"specificContent":"=vars.Var_ItemPayload"}]]></uipath:input>
          <!-- Capture the processed item into Var_ProcessedItem -->
          <uipath:output name="response" type="Orchestrator.CreateQueueItem" var="Var_ProcessedItem" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_To_CreateAndWait</bpmn:incoming>
      <bpmn:outgoing>Flow_CreateAndWait_To_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_1" name="End">
      <bpmn:incoming>Flow_CreateAndWait_To_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- ============================================================
         Sequence flows
    ============================================================ -->

    <bpmn:sequenceFlow id="Flow_Start_To_CreateAndWait"
        sourceRef="StartEvent_1"
        targetRef="Task_CreateAndWait" />

    <bpmn:sequenceFlow id="Flow_CreateAndWait_To_End"
        sourceRef="Task_CreateAndWait"
        targetRef="EndEvent_1" />

  </bpmn:process>

  <!-- ============================================================
       Diagram interchange — one BPMNShape per node, one BPMNEdge per flow
  ============================================================ -->

  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_1">

      <!-- Shapes -->
      <bpmndi:BPMNShape id="S_StartEvent_1" bpmnElement="StartEvent_1">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_Task_CreateAndWait" bpmnElement="Task_CreateAndWait">
        <dc:Bounds x="260" y="78" width="160" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_EndEvent_1" bpmnElement="EndEvent_1">
        <dc:Bounds x="492" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Edges -->
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_Start_To_CreateAndWait"
          bpmnElement="Flow_Start_To_CreateAndWait">
        <di:waypoint x="196" y="118" />
        <di:waypoint x="260" y="118" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_CreateAndWait_To_End"
          bpmnElement="Flow_CreateAndWait_To_End">
        <di:waypoint x="420" y="118" />
        <di:waypoint x="492" y="118" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
