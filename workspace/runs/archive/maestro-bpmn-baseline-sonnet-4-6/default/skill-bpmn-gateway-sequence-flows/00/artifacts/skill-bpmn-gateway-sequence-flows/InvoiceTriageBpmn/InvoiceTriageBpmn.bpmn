<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_InvoiceTriageBpmn"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="UiPath (https://bpmn.uipath.com)" exporterVersion="1.0">

  <bpmn:process id="Process_InvoiceTriageBpmn" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:migrationVersion version="11.5" />
      <uipath:variables version="v1">
        <!-- Input variables supplied at process start -->
        <uipath:inputOutput id="Var_InvoiceId" name="invoiceId" type="string" elementId="Start_Manual" />
        <uipath:inputOutput id="Var_Amount"    name="amount"    type="number" elementId="Start_Manual" />
      </uipath:variables>
    </bpmn:extensionElements>

    <!-- ============================================================
         START EVENT
         ============================================================ -->
    <bpmn:startEvent id="Start_Manual" name="Invoice Received">
      <bpmn:extensionElements>
        <uipath:entryPointId value="EntryPoint_ManualStart" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_StartToRecord</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- ============================================================
         TASK 1 - Record Invoice Intake
         ============================================================ -->
    <bpmn:scriptTask id="Task_RecordIntake" name="Record Invoice Intake" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"invoiceId":"=vars.Var_InvoiceId","amount":"=vars.Var_Amount"}]]></uipath:input>
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_StartToRecord</bpmn:incoming>
      <bpmn:outgoing>Flow_RecordToRoute</bpmn:outgoing>
      <bpmn:script><![CDATA[
/* Skeleton: record that invoice intake has been logged */
return { response: "intake_recorded" };
]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- ============================================================
         EXCLUSIVE GATEWAY - Route by Amount (split)
         default route -> auto approval (amount < 1000)
         ============================================================ -->
    <bpmn:exclusiveGateway id="Gw_Route" name="Route by Amount" default="Flow_LowValue">
      <bpmn:incoming>Flow_RecordToRoute</bpmn:incoming>
      <bpmn:outgoing>Flow_HighValue</bpmn:outgoing>
      <bpmn:outgoing>Flow_LowValue</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- ============================================================
         TASK 2a - Manager Review (high-value path)
         ============================================================ -->
    <bpmn:scriptTask id="Task_ManagerReview" name="Manager Review" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"invoiceId":"=vars.Var_InvoiceId","amount":"=vars.Var_Amount"}]]></uipath:input>
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_HighValue</bpmn:incoming>
      <bpmn:outgoing>Flow_ManagerToMerge</bpmn:outgoing>
      <bpmn:script><![CDATA[
/* Skeleton: manager reviews high-value invoice */
return { response: "manager_approved" };
]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- ============================================================
         TASK 2b - Auto Approval (low-value / default path)
         ============================================================ -->
    <bpmn:scriptTask id="Task_AutoApproval" name="Auto Approval" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"invoiceId":"=vars.Var_InvoiceId","amount":"=vars.Var_Amount"}]]></uipath:input>
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_LowValue</bpmn:incoming>
      <bpmn:outgoing>Flow_AutoToMerge</bpmn:outgoing>
      <bpmn:script><![CDATA[
/* Skeleton: automatically approve low-value invoice */
return { response: "auto_approved" };
]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- ============================================================
         EXCLUSIVE GATEWAY - Approval Merge (converging XOR join)
         Merges the two approval paths before the parallel split.
         One outgoing flow; set as default (no condition required).
         ============================================================ -->
    <bpmn:exclusiveGateway id="Gw_Merge" name="Approval Merge" default="Flow_MergeToFork">
      <bpmn:incoming>Flow_ManagerToMerge</bpmn:incoming>
      <bpmn:incoming>Flow_AutoToMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_MergeToFork</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- ============================================================
         PARALLEL GATEWAY - Follow-up Fork (AND split)
         Starts notify-requester and archive-decision in parallel.
         ============================================================ -->
    <bpmn:parallelGateway id="Gw_ParallelFork" name="Follow-up Fork">
      <bpmn:incoming>Flow_MergeToFork</bpmn:incoming>
      <bpmn:outgoing>Flow_ForkToNotify</bpmn:outgoing>
      <bpmn:outgoing>Flow_ForkToArchive</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- ============================================================
         TASK 3a - Notify Requester
         ============================================================ -->
    <bpmn:scriptTask id="Task_NotifyRequester" name="Notify Requester" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"invoiceId":"=vars.Var_InvoiceId"}]]></uipath:input>
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ForkToNotify</bpmn:incoming>
      <bpmn:outgoing>Flow_NotifyToJoin</bpmn:outgoing>
      <bpmn:script><![CDATA[
/* Skeleton: send decision notification to requester */
return { response: "notified" };
]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- ============================================================
         TASK 3b - Archive Decision
         ============================================================ -->
    <bpmn:scriptTask id="Task_ArchiveDecision" name="Archive Decision" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"invoiceId":"=vars.Var_InvoiceId","amount":"=vars.Var_Amount"}]]></uipath:input>
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ForkToArchive</bpmn:incoming>
      <bpmn:outgoing>Flow_ArchiveToJoin</bpmn:outgoing>
      <bpmn:script><![CDATA[
/* Skeleton: archive the approval decision record */
return { response: "archived" };
]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- ============================================================
         PARALLEL GATEWAY - Follow-up Join (AND join)
         Synchronises notify and archive before the end event.
         ============================================================ -->
    <bpmn:parallelGateway id="Gw_ParallelJoin" name="Follow-up Join">
      <bpmn:incoming>Flow_NotifyToJoin</bpmn:incoming>
      <bpmn:incoming>Flow_ArchiveToJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_JoinToEnd</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- ============================================================
         END EVENT
         ============================================================ -->
    <bpmn:endEvent id="End_InvoiceTriage" name="Invoice Triaged">
      <bpmn:incoming>Flow_JoinToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- ============================================================
         SEQUENCE FLOWS
         ============================================================ -->

    <!-- Start to first task -->
    <bpmn:sequenceFlow id="Flow_StartToRecord"
        name=""
        sourceRef="Start_Manual" targetRef="Task_RecordIntake" />

    <!-- First task to exclusive routing gateway -->
    <bpmn:sequenceFlow id="Flow_RecordToRoute"
        name=""
        sourceRef="Task_RecordIntake" targetRef="Gw_Route" />

    <!-- High-value route: amount >= 1000 -> Manager Review -->
    <bpmn:sequenceFlow id="Flow_HighValue"
        name="amount &gt;= 1000"
        sourceRef="Gw_Route" targetRef="Task_ManagerReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=vars.Var_Amount >= 1000</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Default (low-value) route -> Auto Approval -->
    <bpmn:sequenceFlow id="Flow_LowValue"
        name="amount &lt; 1000 (default)"
        sourceRef="Gw_Route" targetRef="Task_AutoApproval" />

    <!-- Converging flows into the XOR merge gateway -->
    <bpmn:sequenceFlow id="Flow_ManagerToMerge"
        name=""
        sourceRef="Task_ManagerReview" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="Flow_AutoToMerge"
        name=""
        sourceRef="Task_AutoApproval" targetRef="Gw_Merge" />

    <!-- XOR merge to parallel fork -->
    <bpmn:sequenceFlow id="Flow_MergeToFork"
        name=""
        sourceRef="Gw_Merge" targetRef="Gw_ParallelFork" />

    <!-- Parallel fork to follow-up tasks -->
    <bpmn:sequenceFlow id="Flow_ForkToNotify"
        name=""
        sourceRef="Gw_ParallelFork" targetRef="Task_NotifyRequester" />
    <bpmn:sequenceFlow id="Flow_ForkToArchive"
        name=""
        sourceRef="Gw_ParallelFork" targetRef="Task_ArchiveDecision" />

    <!-- Follow-up tasks to parallel join -->
    <bpmn:sequenceFlow id="Flow_NotifyToJoin"
        name=""
        sourceRef="Task_NotifyRequester" targetRef="Gw_ParallelJoin" />
    <bpmn:sequenceFlow id="Flow_ArchiveToJoin"
        name=""
        sourceRef="Task_ArchiveDecision" targetRef="Gw_ParallelJoin" />

    <!-- Parallel join to end -->
    <bpmn:sequenceFlow id="Flow_JoinToEnd"
        name=""
        sourceRef="Gw_ParallelJoin" targetRef="End_InvoiceTriage" />

  </bpmn:process>

  <!-- ================================================================
       BPMN DI - Shapes and Edges
       Layout: left-to-right, main spine at y=300
         upper branch (Manager Review, Notify Requester) at y=160
         lower branch (Auto Approval, Archive Decision)  at y=440
       Sizes: tasks 100x80, events 36x36, gateways 50x50
       ================================================================ -->
  <bpmndi:BPMNDiagram id="Diagram_InvoiceTriageBpmn">
    <bpmndi:BPMNPlane id="Plane_InvoiceTriageBpmn" bpmnElement="Process_InvoiceTriageBpmn">

      <!-- Shapes -->
      <bpmndi:BPMNShape id="S_Start_Manual" bpmnElement="Start_Manual">
        <dc:Bounds x="160" y="282" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_Task_RecordIntake" bpmnElement="Task_RecordIntake">
        <dc:Bounds x="260" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_Gw_Route" bpmnElement="Gw_Route" isMarkerVisible="true">
        <dc:Bounds x="430" y="275" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_Task_ManagerReview" bpmnElement="Task_ManagerReview">
        <dc:Bounds x="550" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_Task_AutoApproval" bpmnElement="Task_AutoApproval">
        <dc:Bounds x="550" y="400" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_Gw_Merge" bpmnElement="Gw_Merge" isMarkerVisible="true">
        <dc:Bounds x="730" y="275" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_Gw_ParallelFork" bpmnElement="Gw_ParallelFork">
        <dc:Bounds x="860" y="275" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_Task_NotifyRequester" bpmnElement="Task_NotifyRequester">
        <dc:Bounds x="980" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_Task_ArchiveDecision" bpmnElement="Task_ArchiveDecision">
        <dc:Bounds x="980" y="400" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_Gw_ParallelJoin" bpmnElement="Gw_ParallelJoin">
        <dc:Bounds x="1160" y="275" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_End_InvoiceTriage" bpmnElement="End_InvoiceTriage">
        <dc:Bounds x="1282" y="282" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Edges -->

      <!-- Start -> Record Invoice Intake -->
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_StartToRecord" bpmnElement="Flow_StartToRecord">
        <di:waypoint x="196" y="300" />
        <di:waypoint x="260" y="300" />
      </bpmndi:BPMNEdge>

      <!-- Record Invoice Intake -> Gw_Route -->
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_RecordToRoute" bpmnElement="Flow_RecordToRoute">
        <di:waypoint x="360" y="300" />
        <di:waypoint x="430" y="300" />
      </bpmndi:BPMNEdge>

      <!-- Gw_Route -> Manager Review (high-value, upward) -->
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_HighValue" bpmnElement="Flow_HighValue">
        <di:waypoint x="455" y="275" />
        <di:waypoint x="455" y="160" />
        <di:waypoint x="550" y="160" />
      </bpmndi:BPMNEdge>

      <!-- Gw_Route -> Auto Approval (default, downward) -->
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_LowValue" bpmnElement="Flow_LowValue">
        <di:waypoint x="455" y="325" />
        <di:waypoint x="455" y="440" />
        <di:waypoint x="550" y="440" />
      </bpmndi:BPMNEdge>

      <!-- Manager Review -> Gw_Merge (downward) -->
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_ManagerToMerge" bpmnElement="Flow_ManagerToMerge">
        <di:waypoint x="650" y="160" />
        <di:waypoint x="755" y="160" />
        <di:waypoint x="755" y="275" />
      </bpmndi:BPMNEdge>

      <!-- Auto Approval -> Gw_Merge (upward) -->
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_AutoToMerge" bpmnElement="Flow_AutoToMerge">
        <di:waypoint x="650" y="440" />
        <di:waypoint x="755" y="440" />
        <di:waypoint x="755" y="325" />
      </bpmndi:BPMNEdge>

      <!-- Gw_Merge -> Gw_ParallelFork -->
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_MergeToFork" bpmnElement="Flow_MergeToFork">
        <di:waypoint x="780" y="300" />
        <di:waypoint x="860" y="300" />
      </bpmndi:BPMNEdge>

      <!-- Gw_ParallelFork -> Notify Requester (upward) -->
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_ForkToNotify" bpmnElement="Flow_ForkToNotify">
        <di:waypoint x="885" y="275" />
        <di:waypoint x="885" y="160" />
        <di:waypoint x="980" y="160" />
      </bpmndi:BPMNEdge>

      <!-- Gw_ParallelFork -> Archive Decision (downward) -->
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_ForkToArchive" bpmnElement="Flow_ForkToArchive">
        <di:waypoint x="885" y="325" />
        <di:waypoint x="885" y="440" />
        <di:waypoint x="980" y="440" />
      </bpmndi:BPMNEdge>

      <!-- Notify Requester -> Gw_ParallelJoin (downward) -->
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_NotifyToJoin" bpmnElement="Flow_NotifyToJoin">
        <di:waypoint x="1080" y="160" />
        <di:waypoint x="1185" y="160" />
        <di:waypoint x="1185" y="275" />
      </bpmndi:BPMNEdge>

      <!-- Archive Decision -> Gw_ParallelJoin (upward) -->
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_ArchiveToJoin" bpmnElement="Flow_ArchiveToJoin">
        <di:waypoint x="1080" y="440" />
        <di:waypoint x="1185" y="440" />
        <di:waypoint x="1185" y="325" />
      </bpmndi:BPMNEdge>

      <!-- Gw_ParallelJoin -> End -->
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_JoinToEnd" bpmnElement="Flow_JoinToEnd">
        <di:waypoint x="1210" y="300" />
        <di:waypoint x="1282" y="300" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
