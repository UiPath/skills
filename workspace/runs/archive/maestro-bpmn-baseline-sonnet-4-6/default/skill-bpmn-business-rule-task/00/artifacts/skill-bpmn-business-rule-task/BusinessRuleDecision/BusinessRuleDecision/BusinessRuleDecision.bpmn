<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="UiPath (https://bpmn.uipath.com)" exporterVersion="1.0">

  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:migrationVersion version="11.5" />
      <uipath:variables version="v1">
        <uipath:input  id="Var_ApplicantScore"  name="ApplicantScore"  type="number" elementId="Start_Manual" />
        <uipath:input  id="Var_RequestedAmount" name="RequestedAmount" type="number" elementId="Start_Manual" />
        <uipath:output id="Var_EligibilityResult" name="EligibilityResult" type="string" />
        <uipath:output id="Var_RuleOutput"        name="RuleOutput"        type="json"   />
      </uipath:variables>
    </bpmn:extensionElements>

    <!-- Manual start: applicant score and requested amount are entry-point inputs -->
    <bpmn:startEvent id="Start_Manual" name="Loan Precheck Request">
      <bpmn:extensionElements>
        <uipath:entryPointId value="9c832edb-7e2e-46d2-98ce-b70063199cc9" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_StartToRule</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Business Rule Task: registry template for Orchestrator.BusinessRules -->
    <bpmn:businessRuleTask id="Task_EvaluateEligibility" name="Evaluate Eligibility">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.BusinessRules" version="v1" />
          <uipath:context>
            <uipath:input name="releaseKey" value="" />
            <uipath:input name="folderId"   value="" />
            <uipath:input name="folderPath" value="" />
            <uipath:input name="name"       value="" />
          </uipath:context>
          <uipath:input name="JobArguments" type="json" target="bodyField"><![CDATA[{"ApplicantScore":"=vars.Var_ApplicantScore","RequestedAmount":"=vars.Var_RequestedAmount"}]]></uipath:input>
          <uipath:output name="EligibilityResult" type="string" var="Var_EligibilityResult" source="=result.EligibilityResult" />
          <uipath:output name="RuleOutput"        type="json"   var="Var_RuleOutput"        source="=result" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_StartToRule</bpmn:incoming>
      <bpmn:outgoing>Flow_RuleToGateway</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <!-- Exclusive gateway: route by rule outcome -->
    <bpmn:exclusiveGateway id="Gw_Outcome" name="Eligible?" default="Flow_ToReview">
      <bpmn:incoming>Flow_RuleToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_ToApproved</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToReview</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="End_Approved" name="Approved">
      <bpmn:incoming>Flow_ToApproved</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_Review" name="Requires Review">
      <bpmn:incoming>Flow_ToReview</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="Flow_StartToRule"   sourceRef="Start_Manual"          targetRef="Task_EvaluateEligibility" />
    <bpmn:sequenceFlow id="Flow_RuleToGateway" sourceRef="Task_EvaluateEligibility" targetRef="Gw_Outcome" />
    <bpmn:sequenceFlow id="Flow_ToApproved"    sourceRef="Gw_Outcome"            targetRef="End_Approved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=vars.Var_EligibilityResult == "approved"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ToReview"      sourceRef="Gw_Outcome"            targetRef="End_Review" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_1">
      <!-- Start event -->
      <bpmndi:BPMNShape id="S_Start_Manual" bpmnElement="Start_Manual">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <!-- Business Rule Task -->
      <bpmndi:BPMNShape id="S_Task_EvaluateEligibility" bpmnElement="Task_EvaluateEligibility">
        <dc:Bounds x="250" y="78" width="160" height="80" />
      </bpmndi:BPMNShape>
      <!-- Exclusive gateway -->
      <bpmndi:BPMNShape id="S_Gw_Outcome" bpmnElement="Gw_Outcome">
        <dc:Bounds x="470" y="93" width="50" height="50" />
      </bpmndi:BPMNShape>
      <!-- Approved end event -->
      <bpmndi:BPMNShape id="S_End_Approved" bpmnElement="End_Approved">
        <dc:Bounds x="580" y="40" width="36" height="36" />
      </bpmndi:BPMNShape>
      <!-- Review end event -->
      <bpmndi:BPMNShape id="S_End_Review" bpmnElement="End_Review">
        <dc:Bounds x="580" y="160" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Edges -->
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_StartToRule" bpmnElement="Flow_StartToRule">
        <di:waypoint x="196" y="118" />
        <di:waypoint x="250" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_RuleToGateway" bpmnElement="Flow_RuleToGateway">
        <di:waypoint x="410" y="118" />
        <di:waypoint x="470" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_ToApproved" bpmnElement="Flow_ToApproved">
        <di:waypoint x="495" y="93" />
        <di:waypoint x="495" y="58" />
        <di:waypoint x="580" y="58" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_ToReview" bpmnElement="Flow_ToReview">
        <di:waypoint x="495" y="143" />
        <di:waypoint x="495" y="178" />
        <di:waypoint x="580" y="178" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
