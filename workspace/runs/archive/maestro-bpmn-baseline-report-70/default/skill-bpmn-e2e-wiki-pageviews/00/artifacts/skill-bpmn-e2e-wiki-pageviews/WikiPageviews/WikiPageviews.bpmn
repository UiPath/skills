<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="UiPath (https://bpmn.uipath.com)" exporterVersion="1.0">

  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:migrationVersion version="11.5" />
      <uipath:variables version="v1">
        <!-- Entry-point input variables (scoped to start event) -->
        <uipath:input id="Var_Article" name="article" type="string" elementId="Start_Manual" />
        <uipath:input id="Var_Date1"   name="date1"   type="string" elementId="Start_Manual" />
        <uipath:input id="Var_Date2"   name="date2"   type="string" elementId="Start_Manual" />
        <!-- Working variables -->
        <uipath:inputOutput id="Var_Valid"    name="valid"    type="boolean" />
        <uipath:inputOutput id="Var_Records"  name="records"  type="json" />
        <uipath:inputOutput id="Var_Filtered" name="filtered" type="json" />
        <!-- Root output variable; json to hold either a number or the not-found string -->
        <uipath:output id="Var_Total" name="total" type="json" />
      </uipath:variables>
    </bpmn:extensionElements>

    <!-- Manual start: plain none start event with entry-point ID -->
    <bpmn:startEvent id="Start_Manual" name="Start">
      <bpmn:extensionElements>
        <uipath:entryPointId value="Entry_ManualStart" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_StartToFetch</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Script task: fetchPageviews -->
    <bpmn:scriptTask id="Task_FetchPageviews" name="fetchPageviews" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"article":"=vars.Var_Article","date1":"=vars.Var_Date1","date2":"=vars.Var_Date2"}]]></uipath:input>
          <uipath:output name="records" type="json"    var="Var_Records" source="=result.response.records" />
          <uipath:output name="valid"   type="boolean" var="Var_Valid"   source="=result.response.valid" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_StartToFetch</bpmn:incoming>
      <bpmn:outgoing>Flow_FetchToGw</bpmn:outgoing>
      <bpmn:script><![CDATA[
var knownArticles = { "Wikipedia": true, "JavaScript": true, "BPMN": true, "UiPath": true };
if (!knownArticles[article]) {
  return { response: { valid: false, records: [] } };
}
var start = new Date(date1);
var end   = new Date(date2);
var records = [];
var seed = 17;
for (var d = new Date(start); d <= end; d.setDate(d.getDate() + 1)) {
  seed = (seed * 1103515245 + 12345) & 0x7fffffff;
  var views = 200 + (seed % 1200);
  records.push({ date: d.toISOString().slice(0, 10), views: views });
}
return { response: { valid: true, records: records } };
]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- Exclusive gateway: route on valid -->
    <bpmn:exclusiveGateway id="Gw_Valid" name="valid?" default="Flow_Valid">
      <bpmn:incoming>Flow_FetchToGw</bpmn:incoming>
      <bpmn:outgoing>Flow_Invalid</bpmn:outgoing>
      <bpmn:outgoing>Flow_Valid</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End event: article not found (sets total to the not-found message) -->
    <bpmn:endEvent id="End_NotFound" name="Article not found">
      <bpmn:extensionElements>
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.Variables" version="v1" />
          <uipath:output name="total" type="string" var="Var_Total" source="Article not found" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Invalid</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Script task: filterHighTraffic (keeps days with views > 500) -->
    <bpmn:scriptTask id="Task_FilterHighTraffic" name="filterHighTraffic" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"records":"=vars.Var_Records"}]]></uipath:input>
          <uipath:output name="filtered" type="json" var="Var_Filtered" source="=result.response" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Valid</bpmn:incoming>
      <bpmn:outgoing>Flow_FilterToAggregate</bpmn:outgoing>
      <bpmn:script><![CDATA[
var filtered = records.filter(function(r) { return r.views > 500; });
return { response: filtered };
]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- Script task: aggregateTotal (sums filtered views into total) -->
    <bpmn:scriptTask id="Task_AggregateTotal" name="aggregateTotal" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"filtered":"=vars.Var_Filtered"}]]></uipath:input>
          <uipath:output name="total" type="number" var="Var_Total" source="=result.response" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_FilterToAggregate</bpmn:incoming>
      <bpmn:outgoing>Flow_AggregateToEnd</bpmn:outgoing>
      <bpmn:script><![CDATA[
var total = 0;
for (var i = 0; i < filtered.length; i++) {
  total += filtered[i].views;
}
return { response: total };
]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- End event: valid path done -->
    <bpmn:endEvent id="End_Done" name="Done">
      <bpmn:incoming>Flow_AggregateToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="Flow_StartToFetch"     sourceRef="Start_Manual"        targetRef="Task_FetchPageviews" />
    <bpmn:sequenceFlow id="Flow_FetchToGw"         sourceRef="Task_FetchPageviews" targetRef="Gw_Valid" />
    <bpmn:sequenceFlow id="Flow_Invalid"           sourceRef="Gw_Valid"            targetRef="End_NotFound">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=vars.Var_Valid == false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Valid"             sourceRef="Gw_Valid"            targetRef="Task_FilterHighTraffic" />
    <bpmn:sequenceFlow id="Flow_FilterToAggregate" sourceRef="Task_FilterHighTraffic" targetRef="Task_AggregateTotal" />
    <bpmn:sequenceFlow id="Flow_AggregateToEnd"    sourceRef="Task_AggregateTotal" targetRef="End_Done" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_1">

      <!-- Start -->
      <bpmndi:BPMNShape id="S_Start_Manual" bpmnElement="Start_Manual">
        <dc:Bounds x="160" y="112" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- fetchPageviews -->
      <bpmndi:BPMNShape id="S_Task_FetchPageviews" bpmnElement="Task_FetchPageviews">
        <dc:Bounds x="260" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Exclusive gateway -->
      <bpmndi:BPMNShape id="S_Gw_Valid" bpmnElement="Gw_Valid" isMarkerVisible="true">
        <dc:Bounds x="430" y="105" width="50" height="50" />
      </bpmndi:BPMNShape>

      <!-- End: not found (above gateway) -->
      <bpmndi:BPMNShape id="S_End_NotFound" bpmnElement="End_NotFound">
        <dc:Bounds x="540" y="32" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- filterHighTraffic -->
      <bpmndi:BPMNShape id="S_Task_FilterHighTraffic" bpmnElement="Task_FilterHighTraffic">
        <dc:Bounds x="560" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- aggregateTotal -->
      <bpmndi:BPMNShape id="S_Task_AggregateTotal" bpmnElement="Task_AggregateTotal">
        <dc:Bounds x="730" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- End: done -->
      <bpmndi:BPMNShape id="S_End_Done" bpmnElement="End_Done">
        <dc:Bounds x="902" y="112" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Edges -->
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_StartToFetch" bpmnElement="Flow_StartToFetch">
        <di:waypoint x="196" y="130" />
        <di:waypoint x="260" y="130" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_FetchToGw" bpmnElement="Flow_FetchToGw">
        <di:waypoint x="360" y="130" />
        <di:waypoint x="430" y="130" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_Invalid" bpmnElement="Flow_Invalid">
        <di:waypoint x="455" y="105" />
        <di:waypoint x="455" y="50" />
        <di:waypoint x="540" y="50" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_Valid" bpmnElement="Flow_Valid">
        <di:waypoint x="480" y="130" />
        <di:waypoint x="560" y="130" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_FilterToAggregate" bpmnElement="Flow_FilterToAggregate">
        <di:waypoint x="660" y="130" />
        <di:waypoint x="730" y="130" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_AggregateToEnd" bpmnElement="Flow_AggregateToEnd">
        <di:waypoint x="830" y="130" />
        <di:waypoint x="902" y="130" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
