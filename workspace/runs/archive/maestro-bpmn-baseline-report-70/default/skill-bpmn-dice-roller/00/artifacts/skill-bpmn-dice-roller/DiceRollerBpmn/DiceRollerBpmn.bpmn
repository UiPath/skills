<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_1"
    exporter="UiPath Maestro (https://uipath.com)"
    exporterVersion="1.200.0-dev.7984">
  <bpmn:process id="Process_1" name="DiceRollerBpmn" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:variables version="v1">
        <uipath:inputOutput id="Var_Roll" name="roll" type="number" />
      </uipath:variables>
      <uipath:bindings version="v1" />
    </bpmn:extensionElements>
    <bpmn:startEvent id="Event_start" name="core.trigger.manual">
      <bpmn:extensionElements>
        <uipath:entryPointId value="cab8a1ae-afb2-4275-a87e-055131687c3e" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_Start_to_Script</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:scriptTask id="Task_RollDie" name="Roll Die" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{}]]></uipath:input>
          <uipath:output name="roll" type="number" var="Var_Roll" source="=result.response" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_to_Script</bpmn:incoming>
      <bpmn:outgoing>Flow_Script_to_Gateway</bpmn:outgoing>
      <bpmn:script><![CDATA[var roll = Math.floor(Math.random() * 6) + 1;
return { response: roll };]]></bpmn:script>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Gw_HighOrLow" name="High or Low?" default="Flow_Low">
      <bpmn:incoming>Flow_Script_to_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_High</bpmn:outgoing>
      <bpmn:outgoing>Flow_Low</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_High" name="High">
      <bpmn:incoming>Flow_High</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Low" name="Low">
      <bpmn:incoming>Flow_Low</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_to_Script" sourceRef="Event_start" targetRef="Task_RollDie" />
    <bpmn:sequenceFlow id="Flow_Script_to_Gateway" sourceRef="Task_RollDie" targetRef="Gw_HighOrLow" />
    <bpmn:sequenceFlow id="Flow_High" sourceRef="Gw_HighOrLow" targetRef="End_High">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=vars.Var_Roll >= 4</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Low" sourceRef="Gw_HighOrLow" targetRef="End_Low" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="S_Event_start" bpmnElement="Event_start">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_RollDie" bpmnElement="Task_RollDie">
        <dc:Bounds x="260" y="78" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Gw_HighOrLow" bpmnElement="Gw_HighOrLow">
        <dc:Bounds x="420" y="93" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End_High" bpmnElement="End_High">
        <dc:Bounds x="560" y="50" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End_Low" bpmnElement="End_Low">
        <dc:Bounds x="560" y="168" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="E_Flow_Start_to_Script" bpmnElement="Flow_Start_to_Script">
        <di:waypoint x="196" y="118" />
        <di:waypoint x="260" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_Script_to_Gateway" bpmnElement="Flow_Script_to_Gateway">
        <di:waypoint x="360" y="118" />
        <di:waypoint x="420" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_High" bpmnElement="Flow_High">
        <di:waypoint x="445" y="93" />
        <di:waypoint x="445" y="68" />
        <di:waypoint x="560" y="68" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_Low" bpmnElement="Flow_Low">
        <di:waypoint x="445" y="143" />
        <di:waypoint x="445" y="186" />
        <di:waypoint x="560" y="186" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
