<?xml version="1.0" encoding="UTF-8"?>
<!--
  Project  : SlackDigestBoundaryBpmn
  Intent   : Manual start → Prepare Digest → Send Slack Digest (Integration
             Service draft boundary) → End
  Status   : DRAFT – CLI-owned enrichment required before upload/run.
             See ENRICHMENT_BLOCKERS.md for the complete blocker list.
-->
<definitions
  xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:uipath="http://schemas.uipath.com/workflow/activities"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_SlackDigestBoundaryBpmn"
  targetNamespace="http://uipath.com/bpmn/SlackDigestBoundaryBpmn"
  exporter="Claude Code BPMN Author – draft"
  exporterVersion="1.0.0">

  <!-- ═══════════════════════════════════════════════════════════════════
       Process definition
  ═══════════════════════════════════════════════════════════════════ -->
  <process
    id="Process_SlackDigestBoundary"
    name="SlackDigestBoundaryBpmn"
    isExecutable="false"
    uipath:isAttended="true">

    <!-- ── Process-level documentation ──────────────────────────────── -->
    <documentation>
      Draft BPMN for a Slack digest workflow.
      Shape sequence: Manual Start Event → Prepare Digest (Script Task) →
      Send Slack Digest (Service Task / Integration Service boundary) → End Event.

      IMPORTANT: This file is a draft boundary artefact.
      The Integration Service step (Task_SendSlackDigest) intentionally omits
      connector-operation metadata, connection binding, dynamic schemas,
      generated output definitions, bindings_v2.json, and package metadata.
      Those artefacts are CLI-owned enrichment. See ENRICHMENT_BLOCKERS.md.
    </documentation>

    <!-- ── Process variables (dataObject elements) ──────────────────── -->
    <!--
      Variables declared as DataObjectReference so they are visible to
      tools that read BPMN variable metadata.  Concrete type schemas are
      CLI-generated artefacts and are therefore omitted here.
    -->

    <dataObject id="DataObject_DigestConfig" name="DigestConfig" isCollection="false">
      <documentation>
        Input bag: channel/topic filter configuration supplied by the caller.
        Shape: { channelIds: string[], lookbackHours: number, title: string }
        CLI enrichment required: schema generated by connector schema generator.
      </documentation>
    </dataObject>
    <dataObjectReference id="DataObjectRef_DigestConfig"
      name="DigestConfig"
      dataObjectRef="DataObject_DigestConfig"/>

    <dataObject id="DataObject_DigestPayload" name="DigestPayload" isCollection="false">
      <documentation>
        Intermediate variable: formatted Slack message blocks produced by
        Task_PrepareDigest and consumed by Task_SendSlackDigest.
        Shape: { text: string, blocks: object[] }
      </documentation>
    </dataObject>
    <dataObjectReference id="DataObjectRef_DigestPayload"
      name="DigestPayload"
      dataObjectRef="DataObject_DigestPayload"/>

    <dataObject id="DataObject_SlackResponse" name="SlackResponse" isCollection="false">
      <documentation>
        Output variable: raw API response from the Slack connector.
        Exact schema is a CLI-generated artefact (dynamic connector output
        schema). Declared as opaque object until CLI enrichment is applied.
      </documentation>
    </dataObject>
    <dataObjectReference id="DataObjectRef_SlackResponse"
      name="SlackResponse"
      dataObjectRef="DataObject_SlackResponse"/>

    <!-- ── Flow elements ─────────────────────────────────────────────── -->

    <!-- 1. Manual Start Event -->
    <startEvent
      id="StartEvent_Manual"
      name="Start – Manual Trigger">
      <documentation>
        Attended / manual start. A human initiates the process from UiPath
        Apps or an Orchestrator trigger. No automated trigger is configured
        in this draft; trigger bindings are CLI-owned enrichment.
      </documentation>
      <outgoing>SequenceFlow_StartToPrepare</outgoing>
    </startEvent>

    <!-- 2. Prepare Digest (Script Task – pure orchestration logic) -->
    <scriptTask
      id="Task_PrepareDigest"
      name="Prepare Digest"
      scriptFormat="uipath-workflow">
      <documentation>
        Reads DigestConfig, fetches and formats messages into Slack Block Kit
        payload, and writes result to DigestPayload.
        Implemented as a UiPath workflow activity sequence (no external
        connector required).
      </documentation>
      <incoming>SequenceFlow_StartToPrepare</incoming>
      <outgoing>SequenceFlow_PrepareToSend</outgoing>

      <!-- Input mapping: DigestConfig → task input -->
      <ioSpecification id="IOSpec_PrepareDigest">
        <dataInput  id="DI_PrepareDigestConfig"  name="config"/>
        <dataOutput id="DO_PrepareDigestPayload" name="payload"/>
        <inputSet  id="IS_PrepareDigest">
          <dataInputRefs>DI_PrepareDigestConfig</dataInputRefs>
        </inputSet>
        <outputSet id="OS_PrepareDigest">
          <dataOutputRefs>DO_PrepareDigestPayload</dataOutputRefs>
        </outputSet>
      </ioSpecification>

      <dataInputAssociation id="DIA_ConfigToPrepare">
        <sourceRef>DataObjectRef_DigestConfig</sourceRef>
        <targetRef>DI_PrepareDigestConfig</targetRef>
        <transformation>
          <!-- Identity transform: pass DigestConfig object directly -->
          <formalExpression>DigestConfig</formalExpression>
        </transformation>
      </dataInputAssociation>
      <dataOutputAssociation id="DOA_PrepareToPayload">
        <sourceRef>DO_PrepareDigestPayload</sourceRef>
        <targetRef>DataObjectRef_DigestPayload</targetRef>
      </dataOutputAssociation>

      <!-- Script body stub (UiPath workflow reference; real body is XAML) -->
      <script><!-- STUB: replaced by UiPath Studio XAML at design time --></script>
    </scriptTask>

    <!-- 3. Send Slack Digest – Integration Service draft boundary -->
    <!--
      BPMN WRAPPER RATIONALE
      ──────────────────────
      Integration Service invocations in UiPath are modelled as serviceTask
      elements.  The @implementation attribute would normally be
      "##WebService" or a UiPath-specific URI once the CLI injects the
      connector resource key.  Here it is left as the BPMN default
      ("##unspecified") to mark the draft boundary explicitly.

      The uipath:* extension attributes below name the intent so that
      human readers and tooling can identify the step without mistaking it
      for a fully-bound connector call.

      CLI-OWNED FIELDS (intentionally absent):
        • uipath:connectorResourceKey  – assigned by `uip` during package publish
        • uipath:connectionId          – bound to a live connection in Orchestrator
        • uipath:operationId           – selected connector operation (e.g. PostMessage)
        • uipath:inputSchema           – dynamic schema generated by connector CLI
        • uipath:outputSchema          – dynamic schema generated by connector CLI
        • bindings_v2.json entry       – CLI-generated connector binding manifest
        • Package / nuget metadata     – CLI-owned at pack time
    -->
    <serviceTask
      id="Task_SendSlackDigest"
      name="Send Slack Digest&#10;[Integration Service – DRAFT BOUNDARY]"
      implementation="##unspecified"
      uipath:activityType="IntegrationServiceActivity"
      uipath:connectorIntent="Slack"
      uipath:operationIntent="PostMessage"
      uipath:enrichmentStatus="DRAFT_BOUNDARY_CLI_ENRICHMENT_REQUIRED">
      <documentation>
        DRAFT BOUNDARY – Integration Service step.

        Intent  : Post the prepared digest as a Slack message via UiPath
                  Integration Service (Slack connector).
        Status  : Executable boundary only. The following are CLI-owned
                  enrichment artefacts and are NOT present in this file:
                    – Connector resource key
                    – Connection ID / binding
                    – Connector operation ID and metadata
                    – Dynamic input schema (connector-generated)
                    – Dynamic output schema (connector-generated)
                    – bindings_v2.json entry
                    – NuGet package metadata
                  See ENRICHMENT_BLOCKERS.md for instructions.

        Inputs  : DigestPayload (text, blocks)
        Outputs : SlackResponse (opaque until CLI enrichment)
      </documentation>
      <incoming>SequenceFlow_PrepareToSend</incoming>
      <outgoing>SequenceFlow_SendToEnd</outgoing>

      <!-- I/O specification: intentional stubs pending CLI schema generation -->
      <ioSpecification id="IOSpec_SendSlackDigest">
        <dataInput  id="DI_SendPayload"   name="payload_STUB"/>
        <dataOutput id="DO_SendResponse"  name="response_STUB"/>
        <inputSet  id="IS_SendSlackDigest">
          <dataInputRefs>DI_SendPayload</dataInputRefs>
        </inputSet>
        <outputSet id="OS_SendSlackDigest">
          <dataOutputRefs>DO_SendResponse</dataOutputRefs>
        </outputSet>
      </ioSpecification>

      <dataInputAssociation id="DIA_PayloadToSend">
        <sourceRef>DataObjectRef_DigestPayload</sourceRef>
        <targetRef>DI_SendPayload</targetRef>
        <transformation>
          <!--
            STUB: real mapping is generated by CLI schema resolver.
            Expected fields after enrichment:
              channel  ← DigestConfig.channelIds[0]   (or multi-post loop)
              text     ← DigestPayload.text
              blocks   ← DigestPayload.blocks
          -->
          <formalExpression>STUB_CLI_MAPPING_REQUIRED</formalExpression>
        </transformation>
      </dataInputAssociation>
      <dataOutputAssociation id="DOA_ResponseToVar">
        <sourceRef>DO_SendResponse</sourceRef>
        <targetRef>DataObjectRef_SlackResponse</targetRef>
      </dataOutputAssociation>
    </serviceTask>

    <!-- 4. End Event -->
    <endEvent
      id="EndEvent_Normal"
      name="End">
      <documentation>Normal process completion.</documentation>
      <incoming>SequenceFlow_SendToEnd</incoming>
    </endEvent>

    <!-- ── Sequence flows ─────────────────────────────────────────────── -->
    <sequenceFlow
      id="SequenceFlow_StartToPrepare"
      name=""
      sourceRef="StartEvent_Manual"
      targetRef="Task_PrepareDigest"/>
    <sequenceFlow
      id="SequenceFlow_PrepareToSend"
      name=""
      sourceRef="Task_PrepareDigest"
      targetRef="Task_SendSlackDigest"/>
    <sequenceFlow
      id="SequenceFlow_SendToEnd"
      name=""
      sourceRef="Task_SendSlackDigest"
      targetRef="EndEvent_Normal"/>

  </process>

  <!-- ═══════════════════════════════════════════════════════════════════
       BPMNDI – Diagram geometry
       Canvas origin: (160, 80)  |  Lane width: 680  |  Row height: 80
  ═══════════════════════════════════════════════════════════════════ -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_SlackDigestBoundaryBpmn">
    <bpmndi:BPMNPlane
      id="BPMNPlane_SlackDigestBoundaryBpmn"
      bpmnElement="Process_SlackDigestBoundary">

      <!-- ── Shapes ──────────────────────────────────────────────── -->

      <!-- StartEvent_Manual  (36 × 36, centred on row y=160) -->
      <bpmndi:BPMNShape
        id="Shape_StartEvent_Manual"
        bpmnElement="StartEvent_Manual">
        <dc:Bounds x="160" y="142" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="136" y="185" width="86" height="27"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Task_PrepareDigest  (100 × 80) -->
      <bpmndi:BPMNShape
        id="Shape_Task_PrepareDigest"
        bpmnElement="Task_PrepareDigest">
        <dc:Bounds x="258" y="120" width="100" height="80"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>

      <!-- Task_SendSlackDigest  (140 × 80, wider to accommodate label) -->
      <bpmndi:BPMNShape
        id="Shape_Task_SendSlackDigest"
        bpmnElement="Task_SendSlackDigest">
        <dc:Bounds x="420" y="120" width="160" height="80"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>

      <!-- EndEvent_Normal  (36 × 36) -->
      <bpmndi:BPMNShape
        id="Shape_EndEvent_Normal"
        bpmnElement="EndEvent_Normal">
        <dc:Bounds x="642" y="142" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="649" y="185" width="22" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- DataObjectReference shapes (placed below the flow lane) -->

      <!-- DigestConfig  -->
      <bpmndi:BPMNShape
        id="Shape_DataObjectRef_DigestConfig"
        bpmnElement="DataObjectRef_DigestConfig"
        isHorizontal="false">
        <dc:Bounds x="258" y="265" width="36" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="240" y="322" width="72" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- DigestPayload  -->
      <bpmndi:BPMNShape
        id="Shape_DataObjectRef_DigestPayload"
        bpmnElement="DataObjectRef_DigestPayload"
        isHorizontal="false">
        <dc:Bounds x="388" y="265" width="36" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="366" y="322" width="80" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- SlackResponse  -->
      <bpmndi:BPMNShape
        id="Shape_DataObjectRef_SlackResponse"
        bpmnElement="DataObjectRef_SlackResponse"
        isHorizontal="false">
        <dc:Bounds x="526" y="265" width="36" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="504" y="322" width="80" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- ── Sequence flow edges ─────────────────────────────────── -->

      <bpmndi:BPMNEdge
        id="Edge_SequenceFlow_StartToPrepare"
        bpmnElement="SequenceFlow_StartToPrepare">
        <di:waypoint x="196" y="160"/>
        <di:waypoint x="258" y="160"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge
        id="Edge_SequenceFlow_PrepareToSend"
        bpmnElement="SequenceFlow_PrepareToSend">
        <di:waypoint x="358" y="160"/>
        <di:waypoint x="420" y="160"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge
        id="Edge_SequenceFlow_SendToEnd"
        bpmnElement="SequenceFlow_SendToEnd">
        <di:waypoint x="580" y="160"/>
        <di:waypoint x="642" y="160"/>
      </bpmndi:BPMNEdge>

      <!-- ── Data association edges ──────────────────────────────── -->

      <!-- DigestConfig → PrepareDigest -->
      <bpmndi:BPMNEdge
        id="Edge_DIA_ConfigToPrepare"
        bpmnElement="DIA_ConfigToPrepare">
        <di:waypoint x="276" y="265"/>
        <di:waypoint x="276" y="200"/>
      </bpmndi:BPMNEdge>

      <!-- PrepareDigest → DigestPayload -->
      <bpmndi:BPMNEdge
        id="Edge_DOA_PrepareToPayload"
        bpmnElement="DOA_PrepareToPayload">
        <di:waypoint x="308" y="200"/>
        <di:waypoint x="406" y="265"/>
      </bpmndi:BPMNEdge>

      <!-- DigestPayload → SendSlackDigest -->
      <bpmndi:BPMNEdge
        id="Edge_DIA_PayloadToSend"
        bpmnElement="DIA_PayloadToSend">
        <di:waypoint x="424" y="265"/>
        <di:waypoint x="500" y="200"/>
      </bpmndi:BPMNEdge>

      <!-- SendSlackDigest → SlackResponse -->
      <bpmndi:BPMNEdge
        id="Edge_DOA_ResponseToVar"
        bpmnElement="DOA_ResponseToVar">
        <di:waypoint x="544" y="200"/>
        <di:waypoint x="544" y="265"/>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</definitions>
