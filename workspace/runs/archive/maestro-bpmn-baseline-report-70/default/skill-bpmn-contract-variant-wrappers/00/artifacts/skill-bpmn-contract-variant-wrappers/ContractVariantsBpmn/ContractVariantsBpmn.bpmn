<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="UiPath (https://bpmn.uipath.com)" exporterVersion="1.0">

  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:migrationVersion version="11.5" />
      <uipath:variables version="v1">
        <uipath:inputOutput id="Var_AgentJobResult" name="AgentJobResult" type="object" />
        <uipath:inputOutput id="Var_A2AResult" name="A2AResult" type="object" />
        <uipath:inputOutput id="Var_ApiWorkflowResult" name="ApiWorkflowResult" type="object" />
        <uipath:inputOutput id="Var_BusinessRulesResult" name="BusinessRulesResult" type="object" />
        <uipath:inputOutput id="Var_QueueItemResult" name="QueueItemResult" type="object" />
        <uipath:inputOutput id="Var_QueueWaitResult" name="QueueWaitResult" type="object" />
        <uipath:inputOutput id="Var_AgenticResult" name="AgenticResult" type="object" />
        <uipath:inputOutput id="Var_AgenticAsyncResult" name="AgenticAsyncResult" type="object" />
        <uipath:inputOutput id="Var_CaseMgmtResult" name="CaseMgmtResult" type="object" />
        <uipath:inputOutput id="Var_CaseMgmtAsyncResult" name="CaseMgmtAsyncResult" type="object" />
        <uipath:inputOutput id="Var_WaitEventResult" name="WaitEventResult" type="object" />
        <uipath:inputOutput id="Var_SendMsgResult" name="SendMsgResult" type="object" />
        <uipath:inputOutput id="Var_CasePlanResult" name="CasePlanResult" type="object" />
        <uipath:inputOutput id="Var_GuardrailsResult" name="GuardrailsResult" type="object" />
        <uipath:inputOutput id="Var_RulesResult" name="RulesResult" type="object" />
        <uipath:inputOutput id="Var_ScriptResult" name="ScriptResult" type="string" />
      </uipath:variables>
      <uipath:bindings version="v1">
        <uipath:binding id="Binding_AgentName" resource="process" propertyAttribute="name" default="PLACEHOLDER_AGENT_NAME" />
        <uipath:binding id="Binding_AgentFolder" resource="process" propertyAttribute="folderPath" default="PLACEHOLDER_AGENT_FOLDER" />
        <uipath:binding id="Binding_IsConnection" resource="Connection" propertyAttribute="ConnectionId" default="PLACEHOLDER_CONNECTION_ID" />
      </uipath:bindings>
    </bpmn:extensionElements>

    <bpmn:startEvent id="Start_1" name="Start">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_StartAgentJob" name="Start Agent Job">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.StartAgentJob" version="v1" />
          <uipath:context>
            <uipath:input name="name" value="=bindings.Binding_AgentName" />
            <uipath:input name="folderPath" value="=bindings.Binding_AgentFolder" />
          </uipath:context>
          <uipath:input name="JobArguments" type="json" target="bodyField"><![CDATA[{}]]></uipath:input>
          <uipath:output name="Process response" type="Orchestrator.RunJob" var="Var_AgentJobResult" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_A2AExecution" name="A2A Agent Execution">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="A2A.AgentExecution" version="v1" />
          <uipath:input name="body" type="json" target="body"><![CDATA[{"agentUrl":"PLACEHOLDER_AGENT_URL","skillId":"PLACEHOLDER_SKILL_ID","input":"PLACEHOLDER_INPUT_TEXT","authToken":"PLACEHOLDER_AUTH_TOKEN","agentName":"PLACEHOLDER_A2A_AGENT_NAME"}]]></uipath:input>
          <uipath:output name="a2aResponse" type="A2A.AgentExecution" var="Var_A2AResult" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_ApiWorkflow" name="Execute API Workflow Async">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.ExecuteApiWorkflowAsync" version="v1" />
          <uipath:context>
            <uipath:input name="releaseKey" value="PLACEHOLDER_RELEASE_KEY" />
            <uipath:input name="folderId" value="PLACEHOLDER_FOLDER_ID" />
            <uipath:input name="folderPath" value="PLACEHOLDER_FOLDER_PATH" />
            <uipath:input name="name" value="PLACEHOLDER_WORKFLOW_NAME" />
          </uipath:context>
          <uipath:input name="JobArguments" type="json" target="bodyField"><![CDATA[{}]]></uipath:input>
          <uipath:output name="Process response" type="Orchestrator.RunJob" var="Var_ApiWorkflowResult" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:businessRuleTask id="Task_BusinessRules" name="Execute Business Rule">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.BusinessRules" version="v1" />
          <uipath:context>
            <uipath:input name="releaseKey" value="PLACEHOLDER_RULE_RELEASE_KEY" />
            <uipath:input name="folderId" value="PLACEHOLDER_FOLDER_ID" />
            <uipath:input name="folderPath" value="PLACEHOLDER_FOLDER_PATH" />
            <uipath:input name="name" value="PLACEHOLDER_RULE_NAME" />
          </uipath:context>
          <uipath:input name="JobArguments" type="json" target="bodyField"><![CDATA[{}]]></uipath:input>
          <uipath:output name="Execute business rule [Preview]" type="Orchestrator.BusinessRules" var="Var_BusinessRulesResult" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:sendTask id="Task_CreateQueue" name="Create Queue Item">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.CreateQueueItem" version="v1" />
          <uipath:context>
            <uipath:input name="queueName" value="PLACEHOLDER_QUEUE_NAME" />
            <uipath:input name="folderId" value="PLACEHOLDER_FOLDER_ID" />
            <uipath:input name="folderPath" value="PLACEHOLDER_FOLDER_PATH" />
          </uipath:context>
          <uipath:input name="ItemData" type="json" target="body"><![CDATA[{}]]></uipath:input>
          <uipath:output name="response" type="Orchestrator.CreateQueueItem" var="Var_QueueItemResult" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:serviceTask id="Task_CreateAndWait" name="Create and Wait for Queue Item">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.CreateAndWaitForQueueItem" version="v1" />
          <uipath:context>
            <uipath:input name="queueName" value="PLACEHOLDER_QUEUE_NAME" />
            <uipath:input name="folderId" value="PLACEHOLDER_FOLDER_ID" />
            <uipath:input name="folderPath" value="PLACEHOLDER_FOLDER_PATH" />
          </uipath:context>
          <uipath:input name="ItemData" type="json" target="body"><![CDATA[{}]]></uipath:input>
          <uipath:output name="response" type="Orchestrator.CreateQueueItem" var="Var_QueueWaitResult" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:callActivity id="Task_StartAgentic" name="Start Agentic Process">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.StartAgenticProcess" version="v1" />
          <uipath:context>
            <uipath:input name="releaseKey" value="PLACEHOLDER_AGENTIC_RELEASE_KEY" />
            <uipath:input name="folderId" value="PLACEHOLDER_FOLDER_ID" />
            <uipath:input name="folderPath" value="PLACEHOLDER_FOLDER_PATH" />
            <uipath:input name="name" value="PLACEHOLDER_AGENTIC_PROCESS_NAME" />
          </uipath:context>
          <uipath:input name="JobArguments" type="json" target="bodyField"><![CDATA[{}]]></uipath:input>
          <uipath:output name="Process response" type="Orchestrator.RunJob" var="Var_AgenticResult" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:callActivity>

    <bpmn:callActivity id="Task_StartAgenticAsync" name="Start Agentic Process Async">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.StartAgenticProcessAsync" version="v1" />
          <uipath:context>
            <uipath:input name="releaseKey" value="PLACEHOLDER_AGENTIC_ASYNC_KEY" />
            <uipath:input name="folderId" value="PLACEHOLDER_FOLDER_ID" />
            <uipath:input name="folderPath" value="PLACEHOLDER_FOLDER_PATH" />
            <uipath:input name="name" value="PLACEHOLDER_AGENTIC_ASYNC_NAME" />
          </uipath:context>
          <uipath:input name="JobArguments" type="json" target="bodyField"><![CDATA[{}]]></uipath:input>
          <uipath:output name="Process response" type="Orchestrator.RunJob" var="Var_AgenticAsyncResult" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:callActivity>

    <bpmn:callActivity id="Task_StartCase" name="Start Case Mgmt Process">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.StartCaseMgmtProcess" version="v1" />
          <uipath:context>
            <uipath:input name="releaseKey" value="PLACEHOLDER_CASE_RELEASE_KEY" />
            <uipath:input name="folderId" value="PLACEHOLDER_FOLDER_ID" />
            <uipath:input name="folderPath" value="PLACEHOLDER_FOLDER_PATH" />
            <uipath:input name="name" value="PLACEHOLDER_CASE_PROCESS_NAME" />
          </uipath:context>
          <uipath:input name="JobArguments" type="json" target="bodyField"><![CDATA[{}]]></uipath:input>
          <uipath:output name="Process response" type="Orchestrator.RunJob" var="Var_CaseMgmtResult" />
        </uipath:activity>
        <uipath:caseManagement version="v1"><![CDATA[{"caseType":"PLACEHOLDER_CASE_TYPE","caseDefinitionKey":"PLACEHOLDER_CASE_DEF_KEY","attributes":{}}]]></uipath:caseManagement>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:callActivity>

    <bpmn:callActivity id="Task_StartCaseAsync" name="Start Case Mgmt Process Async">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.StartCaseMgmtProcessAsync" version="v1" />
          <uipath:context>
            <uipath:input name="releaseKey" value="PLACEHOLDER_CASE_ASYNC_KEY" />
            <uipath:input name="folderId" value="PLACEHOLDER_FOLDER_ID" />
            <uipath:input name="folderPath" value="PLACEHOLDER_FOLDER_PATH" />
            <uipath:input name="name" value="PLACEHOLDER_CASE_ASYNC_NAME" />
          </uipath:context>
          <uipath:input name="JobArguments" type="json" target="bodyField"><![CDATA[{}]]></uipath:input>
          <uipath:output name="Process response" type="Orchestrator.RunJob" var="Var_CaseMgmtAsyncResult" />
        </uipath:activity>
        <uipath:caseManagement version="v1"><![CDATA[{"caseType":"PLACEHOLDER_CASE_TYPE","caseDefinitionKey":"PLACEHOLDER_CASE_ASYNC_DEF","attributes":{}}]]></uipath:caseManagement>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:callActivity>

    <bpmn:receiveTask id="Task_WaitForEvent" name="Wait for Connector Event">
      <bpmn:extensionElements>
        <uipath:event version="v1">
          <uipath:type value="Intsvc.WaitForEvent" version="v1" />
          <uipath:input name="connectionId" value="=bindings.Binding_IsConnection" />
          <uipath:input name="connectorKey" value="PLACEHOLDER_CONNECTOR_KEY" />
          <uipath:input name="folderId" value="PLACEHOLDER_FOLDER_ID" />
          <uipath:input name="folderPath" value="PLACEHOLDER_FOLDER_PATH" />
          <uipath:input name="folderKey" value="PLACEHOLDER_FOLDER_KEY" />
          <uipath:input name="operation" value="PLACEHOLDER_EVENT_OPERATION" />
          <uipath:input name="objectName" value="PLACEHOLDER_OBJECT_NAME" />
          <uipath:output name="result" type="custom" source="." var="Var_WaitEventResult" />
        </uipath:event>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:receiveTask>

    <bpmn:intermediateThrowEvent id="Throw_SendMessage" name="Send Internal Message">
      <bpmn:extensionElements>
        <uipath:event version="v1">
          <uipath:type value="Maestro.SendMessageEvent" version="v1" />
          <uipath:context>
            <uipath:input name="name" value="PLACEHOLDER_MSG_NAME" />
            <uipath:input name="_label" value="PLACEHOLDER_MSG_LABEL" />
            <uipath:input name="inputSchema" value="{}" />
          </uipath:context>
          <uipath:input name="ItemData" type="json" target="body"><![CDATA[{"Reference":"PLACEHOLDER_MSG_REF","SpecificContent":{},"Error":"","TimeToLive":""}]]></uipath:input>
          <uipath:output name="response" type="Maestro.SendMessageEvent" var="Var_SendMsgResult" />
        </uipath:event>
      </bpmn:extensionElements>
      <bpmn:messageEventDefinition />
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <bpmn:serviceTask id="Task_CasePlanScheduler" name="Case Plan Scheduler (Preserve)">
      <bpmn:extensionElements>
        <uipath:migrationVersion version="11" />
        <uipath:activity version="v1">
          <uipath:type value="Maestro.CasePlanScheduler" version="v1" />
          <uipath:context>
            <uipath:input name="planDefinition" value="PLACEHOLDER_PLAN_DEF" />
            <uipath:input name="_label" value="PLACEHOLDER_SCHEDULER_LABEL" />
          </uipath:context>
          <uipath:input name="body" type="json" target="body"><![CDATA[{}]]></uipath:input>
          <uipath:output name="schedulerOutput" type="Maestro.CasePlanScheduler" var="Var_CasePlanResult" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_CaseMgrGuardrails" name="Case Manager Guardrails (Preserve)">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Maestro.CaseManagerGuardrails" version="v1" />
          <uipath:context>
            <uipath:input name="decisions" value="PLACEHOLDER_DECISIONS_JSON" />
            <uipath:input name="_label" value="PLACEHOLDER_GUARDRAILS_LABEL" />
          </uipath:context>
          <uipath:input name="body" type="json" target="body"><![CDATA[{}]]></uipath:input>
          <uipath:output name="guardrailsOutput" type="Maestro.CaseManagerGuardrails" var="Var_GuardrailsResult" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_CaseRulesEval" name="Case Rules Evaluator (Preserve)">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Maestro.CaseRulesEvaluator" version="v1" />
          <uipath:context>
            <uipath:input name="caseDeterministicRules" value="PLACEHOLDER_RULES_JSON" />
            <uipath:input name="caseCurrentExecutionState" value="PLACEHOLDER_STATE_JSON" />
            <uipath:input name="_label" value="PLACEHOLDER_EVALUATOR_LABEL" />
          </uipath:context>
          <uipath:input name="caseManagerInput" type="json" target="body"><![CDATA[{}]]></uipath:input>
          <uipath:output name="schedulerOutput" type="Maestro.CaseRulesEvaluator" var="Var_RulesResult" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:scriptTask id="Task_LegacyScript" name="Legacy Script (v2 Preserved)" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:migrationVersion version="5" />
        <uipath:scriptVersion value="v2" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args"><![CDATA[{}]]></uipath:input>
          <uipath:output name="scriptResult" type="string" var="Var_ScriptResult" source="=result.response" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:script><![CDATA[return { response: "PLACEHOLDER_SCRIPT_OUTPUT" };]]></bpmn:script>
    </bpmn:scriptTask>

    <bpmn:task id="Task_GenericActivity" name="Generic Activity (Preserve)">
      <bpmn:extensionElements>
        <uipath:Activity>
          <uipath:input name="Payload" value="PLACEHOLDER_GENERIC_PAYLOAD" />
        </uipath:Activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="End_1" name="End">
      <bpmn:incoming>Flow_18</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_1" targetRef="Task_StartAgentJob" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_StartAgentJob" targetRef="Task_A2AExecution" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_A2AExecution" targetRef="Task_ApiWorkflow" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_ApiWorkflow" targetRef="Task_BusinessRules" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_BusinessRules" targetRef="Task_CreateQueue" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_CreateQueue" targetRef="Task_CreateAndWait" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_CreateAndWait" targetRef="Task_StartAgentic" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_StartAgentic" targetRef="Task_StartAgenticAsync" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_StartAgenticAsync" targetRef="Task_StartCase" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_StartCase" targetRef="Task_StartCaseAsync" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_StartCaseAsync" targetRef="Task_WaitForEvent" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_WaitForEvent" targetRef="Throw_SendMessage" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Throw_SendMessage" targetRef="Task_CasePlanScheduler" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_CasePlanScheduler" targetRef="Task_CaseMgrGuardrails" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_CaseMgrGuardrails" targetRef="Task_CaseRulesEval" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_CaseRulesEval" targetRef="Task_LegacyScript" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_LegacyScript" targetRef="Task_GenericActivity" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_GenericActivity" targetRef="End_1" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_1">

      <bpmndi:BPMNShape id="S_Start_1" bpmnElement="Start_1">
        <dc:Bounds x="120" y="282" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_Task_StartAgentJob" bpmnElement="Task_StartAgentJob">
        <dc:Bounds x="200" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_Task_A2AExecution" bpmnElement="Task_A2AExecution">
        <dc:Bounds x="360" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_Task_ApiWorkflow" bpmnElement="Task_ApiWorkflow">
        <dc:Bounds x="520" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_Task_BusinessRules" bpmnElement="Task_BusinessRules">
        <dc:Bounds x="680" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_Task_CreateQueue" bpmnElement="Task_CreateQueue">
        <dc:Bounds x="840" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_Task_CreateAndWait" bpmnElement="Task_CreateAndWait">
        <dc:Bounds x="1000" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_Task_StartAgentic" bpmnElement="Task_StartAgentic">
        <dc:Bounds x="1160" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_Task_StartAgenticAsync" bpmnElement="Task_StartAgenticAsync">
        <dc:Bounds x="1320" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_Task_StartCase" bpmnElement="Task_StartCase">
        <dc:Bounds x="1480" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_Task_StartCaseAsync" bpmnElement="Task_StartCaseAsync">
