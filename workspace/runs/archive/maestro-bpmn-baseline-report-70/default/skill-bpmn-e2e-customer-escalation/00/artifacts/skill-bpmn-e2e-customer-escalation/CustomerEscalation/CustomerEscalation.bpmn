<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="UiPath (https://bpmn.uipath.com)" exporterVersion="1.0">

  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:migrationVersion version="11.5" />
      <uipath:variables version="v1">
        <!-- Entry-point inputs (scoped to the start event) -->
        <uipath:input  id="Var_Subject"      name="subject"      type="string"  elementId="Start_Manual" />
        <uipath:input  id="Var_SenderDomain" name="senderDomain" type="string"  elementId="Start_Manual" />
        <!-- Working variables (root-scoped, readable at runtime) -->
        <uipath:inputOutput id="Var_Urgent"   name="urgent"   type="boolean" />
        <uipath:inputOutput id="Var_Vip"      name="vip"      type="boolean" />
        <uipath:inputOutput id="Var_TicketId" name="ticketId" type="string"  />
      </uipath:variables>
    </bpmn:extensionElements>

    <!-- Manual start event -->
    <bpmn:startEvent id="Start_Manual" name="Receive Request">
      <bpmn:extensionElements>
        <uipath:entryPointId value="Entry_ManualStart" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_StartToClassifyUrgency</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Script task: classify urgency -->
    <bpmn:scriptTask id="Task_ClassifyUrgency" name="classifyUrgency" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"subject":"=vars.Var_Subject"}]]></uipath:input>
          <uipath:output name="urgent" type="boolean" var="Var_Urgent" source="=result.response" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_StartToClassifyUrgency</bpmn:incoming>
      <bpmn:outgoing>Flow_ClassifyUrgencyToClassifyVip</bpmn:outgoing>
      <bpmn:script><![CDATA[
var urgentKeywords = ["urgent", "critical", "escalate", "outage", "blocked"];
var lowerSubject = (subject || "").toLowerCase();
var isUrgent = urgentKeywords.some(function(k) { return lowerSubject.indexOf(k) !== -1; });
return { response: isUrgent };
]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- Script task: classify vip -->
    <bpmn:scriptTask id="Task_ClassifyVip" name="classifyVip" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"senderDomain":"=vars.Var_SenderDomain"}]]></uipath:input>
          <uipath:output name="vip" type="boolean" var="Var_Vip" source="=result.response" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ClassifyUrgencyToClassifyVip</bpmn:incoming>
      <bpmn:outgoing>Flow_ClassifyVipToGateway</bpmn:outgoing>
      <bpmn:script><![CDATA[
var vipDomains = ["premier.example.com", "enterprise.example.com", "vip.example.com"];
var domain = (senderDomain || "").toLowerCase();
var isVip = vipDomains.some(function(d) { return domain === d; });
return { response: isVip };
]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- Exclusive gateway: route escalation -->
    <bpmn:exclusiveGateway id="Gw_RouteEscalation" name="routeEscalation" default="Flow_DefaultToCreateTicket">
      <bpmn:incoming>Flow_ClassifyVipToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_HighTouchToSpecialist</bpmn:outgoing>
      <bpmn:outgoing>Flow_DefaultToCreateTicket</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- User task: escalate to specialist (urgent AND vip path) -->
    <bpmn:userTask id="Task_EscalateToSpecialist" name="Escalate to specialist">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Actions.HITL" version="v1" />
          <uipath:context>
            <uipath:input name="appId" value="" />
            <uipath:input name="appVersion" value="" />
            <uipath:input name="actions" value="" />
            <uipath:input name="key" value="" />
            <uipath:input name="taskTitle" value="Escalate to specialist" />
          </uipath:context>
          <uipath:input name="HitlTaskArguments" type="json" target="bodyField"><![CDATA[{"subject":"=vars.Var_Subject","senderDomain":"=vars.Var_SenderDomain"}]]></uipath:input>
          <uipath:output name="Process response" type="Actions.HITL" var="Var_TicketId" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_HighTouchToSpecialist</bpmn:incoming>
      <bpmn:outgoing>Flow_SpecialistToEnd</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Script task: create ticket (default path) -->
    <bpmn:scriptTask id="Task_CreateTicket" name="createTicket" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"subject":"=vars.Var_Subject","senderDomain":"=vars.Var_SenderDomain"}]]></uipath:input>
          <uipath:output name="ticketId" type="string" var="Var_TicketId" source="=result.response" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_DefaultToCreateTicket</bpmn:incoming>
      <bpmn:outgoing>Flow_CreateTicketToEnd</bpmn:outgoing>
      <bpmn:script><![CDATA[
var ts = new Date().getTime ? new Date().getTime() : 0;
var prefix = "TKT";
var domainPart = (senderDomain || "unknown").replace(/[^a-zA-Z0-9]/g, "").toUpperCase().substring(0, 6);
var ticketId = prefix + "-" + domainPart + "-" + (Math.random ? Math.abs(Math.random() * 100000 | 0) : 42);
return { response: ticketId };
]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- End event: high-touch (specialist) path -->
    <bpmn:endEvent id="End_Escalated" name="Escalated to Specialist">
      <bpmn:incoming>Flow_SpecialistToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End event: default (ticket) path -->
    <bpmn:endEvent id="End_TicketCreated" name="Ticket Created">
      <bpmn:incoming>Flow_CreateTicketToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="Flow_StartToClassifyUrgency"          sourceRef="Start_Manual"           targetRef="Task_ClassifyUrgency" />
    <bpmn:sequenceFlow id="Flow_ClassifyUrgencyToClassifyVip"    sourceRef="Task_ClassifyUrgency"   targetRef="Task_ClassifyVip" />
    <bpmn:sequenceFlow id="Flow_ClassifyVipToGateway"            sourceRef="Task_ClassifyVip"       targetRef="Gw_RouteEscalation" />
    <bpmn:sequenceFlow id="Flow_HighTouchToSpecialist"           sourceRef="Gw_RouteEscalation"     targetRef="Task_EscalateToSpecialist">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=vars.Var_Urgent == true &amp;&amp; vars.Var_Vip == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DefaultToCreateTicket"           sourceRef="Gw_RouteEscalation"     targetRef="Task_CreateTicket" />
    <bpmn:sequenceFlow id="Flow_SpecialistToEnd"                 sourceRef="Task_EscalateToSpecialist" targetRef="End_Escalated" />
    <bpmn:sequenceFlow id="Flow_CreateTicketToEnd"               sourceRef="Task_CreateTicket"      targetRef="End_TicketCreated" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_1">

      <!-- Start event -->
      <bpmndi:BPMNShape id="S_Start_Manual" bpmnElement="Start_Manual">
        <dc:Bounds x="160" y="200" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- classifyUrgency script task -->
      <bpmndi:BPMNShape id="S_Task_ClassifyUrgency" bpmnElement="Task_ClassifyUrgency">
        <dc:Bounds x="260" y="178" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- classifyVip script task -->
      <bpmndi:BPMNShape id="S_Task_ClassifyVip" bpmnElement="Task_ClassifyVip">
        <dc:Bounds x="430" y="178" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- routeEscalation gateway -->
      <bpmndi:BPMNShape id="S_Gw_RouteEscalation" bpmnElement="Gw_RouteEscalation">
        <dc:Bounds x="605" y="193" width="50" height="50" />
      </bpmndi:BPMNShape>

      <!-- Escalate to specialist user task -->
      <bpmndi:BPMNShape id="S_Task_EscalateToSpecialist" bpmnElement="Task_EscalateToSpecialist">
        <dc:Bounds x="730" y="90" width="120" height="80" />
      </bpmndi:BPMNShape>

      <!-- createTicket script task -->
      <bpmndi:BPMNShape id="S_Task_CreateTicket" bpmnElement="Task_CreateTicket">
        <dc:Bounds x="730" y="295" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- End: Escalated -->
      <bpmndi:BPMNShape id="S_End_Escalated" bpmnElement="End_Escalated">
        <dc:Bounds x="930" y="112" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- End: Ticket Created -->
      <bpmndi:BPMNShape id="S_End_TicketCreated" bpmnElement="End_TicketCreated">
        <dc:Bounds x="910" y="317" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Edges -->
      <bpmndi:BPMNEdge id="E_Flow_StartToClassifyUrgency" bpmnElement="Flow_StartToClassifyUrgency">
        <di:waypoint x="196" y="218" />
        <di:waypoint x="260" y="218" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="E_Flow_ClassifyUrgencyToClassifyVip" bpmnElement="Flow_ClassifyUrgencyToClassifyVip">
        <di:waypoint x="360" y="218" />
        <di:waypoint x="430" y="218" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="E_Flow_ClassifyVipToGateway" bpmnElement="Flow_ClassifyVipToGateway">
        <di:waypoint x="530" y="218" />
        <di:waypoint x="605" y="218" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="E_Flow_HighTouchToSpecialist" bpmnElement="Flow_HighTouchToSpecialist">
        <di:waypoint x="630" y="193" />
        <di:waypoint x="630" y="130" />
        <di:waypoint x="730" y="130" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="E_Flow_DefaultToCreateTicket" bpmnElement="Flow_DefaultToCreateTicket">
        <di:waypoint x="630" y="243" />
        <di:waypoint x="630" y="335" />
        <di:waypoint x="730" y="335" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="E_Flow_SpecialistToEnd" bpmnElement="Flow_SpecialistToEnd">
        <di:waypoint x="850" y="130" />
        <di:waypoint x="930" y="130" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="E_Flow_CreateTicketToEnd" bpmnElement="Flow_CreateTicketToEnd">
        <di:waypoint x="830" y="335" />
        <di:waypoint x="910" y="335" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
