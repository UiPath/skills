<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="UiPath (https://bpmn.uipath.com)" exporterVersion="1.0">

  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:migrationVersion version="11.5" />
      <uipath:variables version="v1">
        <uipath:inputOutput id="Var_ReviewResult" name="ReviewResult" type="object" />
      </uipath:variables>
    </bpmn:extensionElements>

    <!-- Manual start event (no event definition = none/manual) -->
    <bpmn:startEvent id="Start_1" name="Start">
      <bpmn:outgoing>Flow_Start_Review</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- User task: human reviews and approves request (Actions.HITL from registry) -->
    <bpmn:userTask id="Task_Review" name="Review and Approve Request">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Actions.HITL" version="v1" />
          <uipath:context>
            <uipath:input name="appId" value="" />
            <uipath:input name="appVersion" value="" />
            <uipath:input name="actions" value="" />
            <uipath:input name="key" value="" />
            <uipath:input name="taskTitle" value="Review and Approve Request" />
          </uipath:context>
          <uipath:input name="HitlTaskArguments" type="json" target="bodyField"><![CDATA[{}]]></uipath:input>
          <uipath:output name="Process response" type="Actions.HITL" var="Var_ReviewResult" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_Review</bpmn:incoming>
      <bpmn:outgoing>Flow_Review_End</bpmn:outgoing>
    </bpmn:userTask>

    <!-- NON-INTERRUPTING timer boundary event: fires after PT1H without cancelling the userTask -->
    <bpmn:boundaryEvent id="Boundary_Timer" attachedToRef="Task_Review" cancelActivity="false">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT1H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
      <bpmn:outgoing>Flow_Timer_Reminder</bpmn:outgoing>
    </bpmn:boundaryEvent>

    <!-- Normal end event when the user task completes -->
    <bpmn:endEvent id="End_Main" name="Request Processed">
      <bpmn:incoming>Flow_Review_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Reminder task triggered by the non-interrupting timer (BPMN.ScriptTask from registry) -->
    <bpmn:scriptTask id="Task_Reminder" name="Send Reminder" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{}]]></uipath:input>
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Timer_Reminder</bpmn:incoming>
      <bpmn:outgoing>Flow_Reminder_End</bpmn:outgoing>
      <bpmn:script><![CDATA[return { response: "Reminder sent: request is still pending approval" };]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- Dedicated end event for the reminder branch (user task continues in parallel) -->
    <bpmn:endEvent id="End_Reminder" name="Reminder Sent">
      <bpmn:incoming>Flow_Reminder_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="Flow_Start_Review" sourceRef="Start_1" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="Flow_Review_End" sourceRef="Task_Review" targetRef="End_Main" />
    <bpmn:sequenceFlow id="Flow_Timer_Reminder" sourceRef="Boundary_Timer" targetRef="Task_Reminder" />
    <bpmn:sequenceFlow id="Flow_Reminder_End" sourceRef="Task_Reminder" targetRef="End_Reminder" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_1">

      <!-- One BPMNShape per node -->
      <bpmndi:BPMNShape id="S_Start_1" bpmnElement="Start_1">
        <dc:Bounds x="152" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_Task_Review" bpmnElement="Task_Review">
        <dc:Bounds x="250" y="78" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Boundary event sits at the bottom-centre edge of Task_Review -->
      <bpmndi:BPMNShape id="S_Boundary_Timer" bpmnElement="Boundary_Timer">
        <dc:Bounds x="282" y="140" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_End_Main" bpmnElement="End_Main">
        <dc:Bounds x="420" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_Task_Reminder" bpmnElement="Task_Reminder">
        <dc:Bounds x="250" y="240" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_End_Reminder" bpmnElement="End_Reminder">
        <dc:Bounds x="420" y="262" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- One BPMNEdge per sequence flow -->
      <bpmndi:BPMNEdge id="E_Flow_Start_Review" bpmnElement="Flow_Start_Review">
        <di:waypoint x="188" y="118" />
        <di:waypoint x="250" y="118" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="E_Flow_Review_End" bpmnElement="Flow_Review_End">
        <di:waypoint x="350" y="118" />
        <di:waypoint x="420" y="118" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="E_Flow_Timer_Reminder" bpmnElement="Flow_Timer_Reminder">
        <di:waypoint x="300" y="176" />
        <di:waypoint x="300" y="240" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="E_Flow_Reminder_End" bpmnElement="Flow_Reminder_End">
        <di:waypoint x="350" y="280" />
        <di:waypoint x="420" y="280" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
