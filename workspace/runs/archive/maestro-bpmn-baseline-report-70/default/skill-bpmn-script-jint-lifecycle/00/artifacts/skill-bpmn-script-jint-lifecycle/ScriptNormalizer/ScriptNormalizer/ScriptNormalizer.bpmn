<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="UiPath (https://bpmn.uipath.com)" exporterVersion="1.0">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:migrationVersion version="11.5" />
      <uipath:variables version="v1">
        <uipath:inputOutput id="Var_RawRequest" name="rawRequest" type="string" elementId="Start_Manual" />
        <uipath:inputOutput id="Var_NormalizedResponse" name="normalizedResponse" type="json" />
      </uipath:variables>
    </bpmn:extensionElements>
    <bpmn:startEvent id="Start_Manual" name="Manual Start">
      <bpmn:extensionElements>
        <uipath:entryPointId value="a1b2c3d4-e5f6-7890-abcd-ef1234567890" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_StartToNormalize</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:scriptTask id="Task_NormalizeRequest" name="Normalize Request" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args"><![CDATA[{"rawRequest":"=vars.Var_RawRequest"}]]></uipath:input>
          <uipath:output name="normalizedResponse" type="json" var="Var_NormalizedResponse" source="=result.response" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_StartToNormalize</bpmn:incoming>
      <bpmn:outgoing>Flow_NormalizeToEnd</bpmn:outgoing>
      <bpmn:script><![CDATA[
var parsed;
if (typeof rawRequest === "string") {
  try {
    parsed = JSON.parse(rawRequest);
  } catch (e) {
    parsed = { raw: rawRequest };
  }
} else if (rawRequest !== null && typeof rawRequest === "object") {
  parsed = rawRequest;
} else {
  parsed = { raw: String(rawRequest) };
}

var normalized = {
  requestId: parsed.requestId ? String(parsed.requestId).trim() : "",
  method: parsed.method ? String(parsed.method).toUpperCase().trim() : "GET",
  path: parsed.path ? String(parsed.path).trim() : "/",
  headers: parsed.headers && typeof parsed.headers === "object" ? parsed.headers : {},
  body: parsed.body !== undefined ? parsed.body : null,
  timestamp: parsed.timestamp ? String(parsed.timestamp).trim() : "",
  normalized: true
};

return { response: normalized };
]]></bpmn:script>
    </bpmn:scriptTask>
    <bpmn:endEvent id="End_Success" name="Success">
      <bpmn:incoming>Flow_NormalizeToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_StartToNormalize" sourceRef="Start_Manual" targetRef="Task_NormalizeRequest" />
    <bpmn:sequenceFlow id="Flow_NormalizeToEnd" sourceRef="Task_NormalizeRequest" targetRef="End_Success" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="S_Start_Manual" bpmnElement="Start_Manual">
        <dc:Bounds x="160" y="200" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_NormalizeRequest" bpmnElement="Task_NormalizeRequest">
        <dc:Bounds x="260" y="178" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End_Success" bpmnElement="End_Success">
        <dc:Bounds x="432" y="200" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="E_Flow_StartToNormalize" bpmnElement="Flow_StartToNormalize">
        <di:waypoint x="196" y="218" />
        <di:waypoint x="260" y="218" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Flow_NormalizeToEnd" bpmnElement="Flow_NormalizeToEnd">
        <di:waypoint x="360" y="218" />
        <di:waypoint x="432" y="218" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
