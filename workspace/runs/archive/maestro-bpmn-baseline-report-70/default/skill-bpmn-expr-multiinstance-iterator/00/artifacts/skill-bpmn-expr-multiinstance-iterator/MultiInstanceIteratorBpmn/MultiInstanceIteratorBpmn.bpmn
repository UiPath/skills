<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="UiPath (https://bpmn.uipath.com)" exporterVersion="1.0">

  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:migrationVersion version="11.5" />
      <uipath:variables version="v1">
        <uipath:input id="Var_Items" name="Items" type="array" />
        <uipath:inputOutput id="Var_CurrentLine" name="CurrentLine" type="string" />
        <uipath:inputOutput id="Var_CurrentIndex" name="CurrentIndex" type="number" />
      </uipath:variables>
    </bpmn:extensionElements>

    <bpmn:startEvent id="Start_1" name="Start">
      <bpmn:outgoing>Flow_StartToSub</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:subProcess id="Sub_MultiInstance" name="Process Each Item">
      <bpmn:extensionElements>
        <uipath:variables version="v1" />
      </bpmn:extensionElements>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true">
        <bpmn:extensionElements>
          <uipath:loopCharacteristics
              inputCollection="=vars.Var_Items"
              inputElement="iterator[0]" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:incoming>Flow_StartToSub</bpmn:incoming>
      <bpmn:outgoing>Flow_SubToEnd</bpmn:outgoing>

      <bpmn:startEvent id="Sub_Start" name="Sub Start">
        <bpmn:outgoing>Flow_SubStart_MapItem</bpmn:outgoing>
      </bpmn:startEvent>

      <bpmn:scriptTask id="Task_MapItem" name="Map Current Item" scriptFormat="JavaScript">
        <bpmn:extensionElements>
          <uipath:scriptVersion value="v3" />
          <uipath:mapping version="v1">
            <uipath:type value="BPMN.ScriptTask" version="v1" />
            <uipath:input name="args"><![CDATA[{"currentItem":"=iterator[0].item"}]]></uipath:input>
            <uipath:output name="currentLine" type="string" var="Var_CurrentLine" source="=result.response" />
          </uipath:mapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_SubStart_MapItem</bpmn:incoming>
        <bpmn:outgoing>Flow_MapItem_MapIndex</bpmn:outgoing>
        <bpmn:script><![CDATA[return { response: String(currentItem) };]]></bpmn:script>
      </bpmn:scriptTask>

      <bpmn:scriptTask id="Task_MapIndex" name="Map Loop Index" scriptFormat="JavaScript">
        <bpmn:extensionElements>
          <uipath:scriptVersion value="v3" />
          <uipath:mapping version="v1">
            <uipath:type value="BPMN.ScriptTask" version="v1" />
            <uipath:input name="args"><![CDATA[{"loopIndex":"=iterator[0].loopCounter"}]]></uipath:input>
            <uipath:output name="currentIndex" type="number" var="Var_CurrentIndex" source="=result.response" />
          </uipath:mapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_MapItem_MapIndex</bpmn:incoming>
        <bpmn:outgoing>Flow_MapIndex_SubEnd</bpmn:outgoing>
        <bpmn:script><![CDATA[return { response: loopIndex };]]></bpmn:script>
      </bpmn:scriptTask>

      <bpmn:endEvent id="Sub_End" name="Sub End">
        <bpmn:incoming>Flow_MapIndex_SubEnd</bpmn:incoming>
      </bpmn:endEvent>

      <bpmn:sequenceFlow id="Flow_SubStart_MapItem" sourceRef="Sub_Start" targetRef="Task_MapItem" />
      <bpmn:sequenceFlow id="Flow_MapItem_MapIndex" sourceRef="Task_MapItem" targetRef="Task_MapIndex" />
      <bpmn:sequenceFlow id="Flow_MapIndex_SubEnd" sourceRef="Task_MapIndex" targetRef="Sub_End" />
    </bpmn:subProcess>

    <bpmn:endEvent id="End_1" name="End">
      <bpmn:incoming>Flow_SubToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_StartToSub" sourceRef="Start_1" targetRef="Sub_MultiInstance" />
    <bpmn:sequenceFlow id="Flow_SubToEnd" sourceRef="Sub_MultiInstance" targetRef="End_1" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_1">

      <bpmndi:BPMNShape id="S_Start_1" bpmnElement="Start_1">
        <dc:Bounds x="160" y="200" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_Sub_MultiInstance" bpmnElement="Sub_MultiInstance" isExpanded="true">
        <dc:Bounds x="250" y="100" width="560" height="236" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_Sub_Start" bpmnElement="Sub_Start">
        <dc:Bounds x="290" y="200" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_Task_MapItem" bpmnElement="Task_MapItem">
        <dc:Bounds x="390" y="178" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_Task_MapIndex" bpmnElement="Task_MapIndex">
        <dc:Bounds x="550" y="178" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_Sub_End" bpmnElement="Sub_End">
        <dc:Bounds x="720" y="200" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_End_1" bpmnElement="End_1">
        <dc:Bounds x="870" y="200" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_StartToSub" bpmnElement="Flow_StartToSub">
        <di:waypoint x="196" y="218" />
        <di:waypoint x="250" y="218" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_SubStart_MapItem" bpmnElement="Flow_SubStart_MapItem">
        <di:waypoint x="326" y="218" />
        <di:waypoint x="390" y="218" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_MapItem_MapIndex" bpmnElement="Flow_MapItem_MapIndex">
        <di:waypoint x="490" y="218" />
        <di:waypoint x="550" y="218" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_MapIndex_SubEnd" bpmnElement="Flow_MapIndex_SubEnd">
        <di:waypoint x="650" y="218" />
        <di:waypoint x="720" y="218" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_SubToEnd" bpmnElement="Flow_SubToEnd">
        <di:waypoint x="810" y="218" />
        <di:waypoint x="870" y="218" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
