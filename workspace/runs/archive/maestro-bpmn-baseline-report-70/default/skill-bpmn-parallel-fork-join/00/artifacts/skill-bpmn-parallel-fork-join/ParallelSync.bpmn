<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="UiPath (https://bpmn.uipath.com)" exporterVersion="1.0">

  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:migrationVersion version="11.5" />
    </bpmn:extensionElements>

    <!-- Start event -->
    <bpmn:startEvent id="Start_1" name="Start">
      <bpmn:outgoing>Flow_Start_Fork</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Parallel fork gateway: one incoming, two outgoing, no conditions -->
    <bpmn:parallelGateway id="Fork_1" name="Fork">
      <bpmn:incoming>Flow_Start_Fork</bpmn:incoming>
      <bpmn:outgoing>Flow_Fork_A</bpmn:outgoing>
      <bpmn:outgoing>Flow_Fork_B</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Branch A task -->
    <bpmn:task id="Task_A" name="Branch A">
      <bpmn:incoming>Flow_Fork_A</bpmn:incoming>
      <bpmn:outgoing>Flow_A_Join</bpmn:outgoing>
    </bpmn:task>

    <!-- Branch B task -->
    <bpmn:task id="Task_B" name="Branch B">
      <bpmn:incoming>Flow_Fork_B</bpmn:incoming>
      <bpmn:outgoing>Flow_B_Join</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel join gateway: two incoming, one outgoing, no conditions -->
    <bpmn:parallelGateway id="Join_1" name="Join">
      <bpmn:incoming>Flow_A_Join</bpmn:incoming>
      <bpmn:incoming>Flow_B_Join</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_End</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- End event -->
    <bpmn:endEvent id="End_1" name="End">
      <bpmn:incoming>Flow_Join_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="Flow_Start_Fork" sourceRef="Start_1"  targetRef="Fork_1" />
    <bpmn:sequenceFlow id="Flow_Fork_A"     sourceRef="Fork_1"   targetRef="Task_A" />
    <bpmn:sequenceFlow id="Flow_Fork_B"     sourceRef="Fork_1"   targetRef="Task_B" />
    <bpmn:sequenceFlow id="Flow_A_Join"     sourceRef="Task_A"   targetRef="Join_1" />
    <bpmn:sequenceFlow id="Flow_B_Join"     sourceRef="Task_B"   targetRef="Join_1" />
    <bpmn:sequenceFlow id="Flow_Join_End"   sourceRef="Join_1"   targetRef="End_1"  />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_1">

      <!-- Shapes: events 36x36, gateways 50x50, tasks 100x80 -->
      <!-- Main centerline y=200; upper branch y=120; lower branch y=300 -->

      <bpmndi:BPMNShape id="S_Start_1" bpmnElement="Start_1">
        <dc:Bounds x="160" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_Fork_1" bpmnElement="Fork_1">
        <dc:Bounds x="258" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_Task_A" bpmnElement="Task_A">
        <dc:Bounds x="380" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_Task_B" bpmnElement="Task_B">
        <dc:Bounds x="380" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_Join_1" bpmnElement="Join_1">
        <dc:Bounds x="542" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_End_1" bpmnElement="End_1">
        <dc:Bounds x="654" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Edges -->

      <!-- Start -> Fork (straight horizontal) -->
      <bpmndi:BPMNEdge id="E_Start_Fork" bpmnElement="Flow_Start_Fork">
        <di:waypoint x="196" y="200" />
        <di:waypoint x="258" y="200" />
      </bpmndi:BPMNEdge>

      <!-- Fork -> Task A (up to upper branch) -->
      <bpmndi:BPMNEdge id="E_Fork_A" bpmnElement="Flow_Fork_A">
        <di:waypoint x="283" y="175" />
        <di:waypoint x="283" y="120" />
        <di:waypoint x="380" y="120" />
      </bpmndi:BPMNEdge>

      <!-- Fork -> Task B (down to lower branch) -->
      <bpmndi:BPMNEdge id="E_Fork_B" bpmnElement="Flow_Fork_B">
        <di:waypoint x="283" y="225" />
        <di:waypoint x="283" y="300" />
        <di:waypoint x="380" y="300" />
      </bpmndi:BPMNEdge>

      <!-- Task A -> Join (route from right of A up to join) -->
      <bpmndi:BPMNEdge id="E_A_Join" bpmnElement="Flow_A_Join">
        <di:waypoint x="480" y="120" />
        <di:waypoint x="567" y="120" />
        <di:waypoint x="567" y="175" />
      </bpmndi:BPMNEdge>

      <!-- Task B -> Join (route from right of B up to join) -->
      <bpmndi:BPMNEdge id="E_B_Join" bpmnElement="Flow_B_Join">
        <di:waypoint x="480" y="300" />
        <di:waypoint x="567" y="300" />
        <di:waypoint x="567" y="225" />
      </bpmndi:BPMNEdge>

      <!-- Join -> End (straight horizontal) -->
      <bpmndi:BPMNEdge id="E_Join_End" bpmnElement="Flow_Join_End">
        <di:waypoint x="592" y="200" />
        <di:waypoint x="654" y="200" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
