<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="UiPath Maestro (https://uipath.com)" exporterVersion="1.200.0-dev.7984">

  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:migrationVersion version="11.5" />
      <uipath:variables version="v1">
        <uipath:inputOutput id="Var_Value" name="value" type="number" />
        <uipath:inputOutput id="Var_Direction" name="direction" type="string" />
        <uipath:inputOutput id="Var_NormalizedValue" name="normalizedValue" type="number" />
        <uipath:inputOutput id="Var_ConvertedValue" name="convertedValue" type="number" />
        <uipath:inputOutput id="Var_Result" name="result" type="string" />
      </uipath:variables>
      <uipath:bindings version="v1" />
    </bpmn:extensionElements>

    <bpmn:startEvent id="Event_start" name="core.trigger.manual">
      <bpmn:extensionElements>
        <uipath:entryPointId value="be140450-3f41-47df-91a3-1a8f4a2cdeef" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:scriptTask id="Task_Normalize" name="Normalize Input" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"inputValue":"=vars.Var_Value","inputDirection":"=vars.Var_Direction"}]]></uipath:input>
          <uipath:output name="normalizedValue" type="number" var="Var_NormalizedValue" source="=result.response" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:script><![CDATA[
var raw = (typeof inputValue === "number") ? inputValue : parseFloat(inputValue);
var normalized = isNaN(raw) ? 0 : raw;
return { response: normalized };
]]></bpmn:script>
    </bpmn:scriptTask>

    <bpmn:scriptTask id="Task_Convert" name="Apply Conversion" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"normalizedValue":"=vars.Var_NormalizedValue","direction":"=vars.Var_Direction"}]]></uipath:input>
          <uipath:output name="convertedValue" type="number" var="Var_ConvertedValue" source="=result.response" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:script><![CDATA[
var converted;
if (direction === "f2i") {
  converted = normalizedValue * 12;
} else if (direction === "i2f") {
  converted = normalizedValue / 12;
} else if (direction === "y2f") {
  converted = normalizedValue * 3;
} else {
  converted = normalizedValue;
}
return { response: converted };
]]></bpmn:script>
    </bpmn:scriptTask>

    <bpmn:scriptTask id="Task_Format" name="Format Result" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"convertedValue":"=vars.Var_ConvertedValue","direction":"=vars.Var_Direction"}]]></uipath:input>
          <uipath:output name="result" type="string" var="Var_Result" source="=result.response" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:script><![CDATA[
var rounded = Math.round(convertedValue * 10000) / 10000;
var unitLabel;
if (direction === "f2i") {
  unitLabel = "inches";
} else if (direction === "i2f") {
  unitLabel = "feet";
} else if (direction === "y2f") {
  unitLabel = "feet";
} else {
  unitLabel = "units";
}
return { response: rounded.toString() + " " + unitLabel };
]]></bpmn:script>
    </bpmn:scriptTask>

    <bpmn:endEvent id="End_1" name="End">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="Event_start" targetRef="Task_Normalize" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Normalize" targetRef="Task_Convert" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Convert" targetRef="Task_Format" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Format" targetRef="End_1" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="S_Event_start" bpmnElement="Event_start">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_Normalize" bpmnElement="Task_Normalize">
        <dc:Bounds x="260" y="78" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_Convert" bpmnElement="Task_Convert">
        <dc:Bounds x="420" y="78" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_Format" bpmnElement="Task_Format">
        <dc:Bounds x="580" y="78" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End_1" bpmnElement="End_1">
        <dc:Bounds x="742" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="196" y="118" />
        <di:waypoint x="260" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="360" y="118" />
        <di:waypoint x="420" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_3" bpmnElement="Flow_3">
        <di:waypoint x="520" y="118" />
        <di:waypoint x="580" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_4" bpmnElement="Flow_4">
        <di:waypoint x="680" y="118" />
        <di:waypoint x="742" y="118" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
