<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="UiPath (https://bpmn.uipath.com)" exporterVersion="1.0">

  <bpmn:process id="Process_VendorPOReview" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:migrationVersion version="11.5" />
      <uipath:variables version="v1">
        <!-- PO context variables (read-only inputs from script task) -->
        <uipath:inputOutput id="Var_PONumber"     name="PONumber"     type="string" />
        <uipath:inputOutput id="Var_VendorName"   name="VendorName"   type="string" />
        <uipath:inputOutput id="Var_TotalAmount"  name="TotalAmount"  type="number" />
        <!-- HITL reviewer output variables -->
        <uipath:inputOutput id="Var_Decision"     name="Decision"     type="string" />
        <uipath:inputOutput id="Var_Notes"        name="Notes"        type="string" />
      </uipath:variables>
    </bpmn:extensionElements>

    <!-- START: manual (none) start event -->
    <bpmn:startEvent id="Start_1" name="Start PO Review">
      <bpmn:outgoing>Flow_StartToFetch</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- SCRIPT TASK: fetch (mock) PO context -->
    <bpmn:scriptTask id="Task_FetchPOContext" name="Fetch PO Context" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{}]]></uipath:input>
          <uipath:output name="poNumber"    type="string" var="Var_PONumber"    source="=result.response.poNumber" />
          <uipath:output name="vendorName"  type="string" var="Var_VendorName"  source="=result.response.vendorName" />
          <uipath:output name="totalAmount" type="number" var="Var_TotalAmount" source="=result.response.totalAmount" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_StartToFetch</bpmn:incoming>
      <bpmn:outgoing>Flow_FetchToReview</bpmn:outgoing>
      <bpmn:script><![CDATA[
return {
  response: {
    poNumber:    "PO-2026-00142",
    vendorName:  "Acme Supplies Ltd.",
    totalAmount: 47850.00
  }
};
]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- USER TASK: HITL review by procurement officer -->
    <bpmn:userTask id="Task_ReviewPO" name="Review Purchase Order">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Actions.HITL" version="v1" />
          <uipath:context>
            <uipath:input name="appId"       value="" />
            <uipath:input name="appVersion"  value="" />
            <uipath:input name="actions"     value="" />
            <uipath:input name="key"         value="" />
            <uipath:input name="taskTitle"   value="Procurement Officer: Review PO" />
          </uipath:context>
          <uipath:input name="HitlTaskArguments" type="json" target="bodyField"><![CDATA[{
  "poNumber":   "=vars.Var_PONumber",
  "vendorName": "=vars.Var_VendorName",
  "totalAmount": "=vars.Var_TotalAmount"
}]]></uipath:input>
          <uipath:output name="decision" type="string" var="Var_Decision" source="=result.response.decision" />
          <uipath:output name="notes"    type="string" var="Var_Notes"    source="=result.response.notes" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_FetchToReview</bpmn:incoming>
      <bpmn:outgoing>Flow_ReviewToGateway</bpmn:outgoing>
    </bpmn:userTask>

    <!-- EXCLUSIVE GATEWAY: route on officer's decision -->
    <bpmn:exclusiveGateway id="Gw_Decision" name="Approved?" default="Flow_Reject">
      <bpmn:incoming>Flow_ReviewToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Approve</bpmn:outgoing>
      <bpmn:outgoing>Flow_Reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- SCRIPT TASK: record approval -->
    <bpmn:scriptTask id="Task_RecordApproval" name="Record Approval" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{
  "poNumber":   "=vars.Var_PONumber",
  "vendorName": "=vars.Var_VendorName",
  "totalAmount": "=vars.Var_TotalAmount",
  "notes":      "=vars.Var_Notes"
}]]></uipath:input>
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Approve</bpmn:incoming>
      <bpmn:outgoing>Flow_ApprovalToEnd</bpmn:outgoing>
      <bpmn:script><![CDATA[
/* Mock: log the approval record */
return { response: { recorded: true, poNumber: poNumber } };
]]></bpmn:script>
    </bpmn:scriptTask>

    <!-- END EVENT: approved -->
    <bpmn:endEvent id="End_Approved" name="PO Approved">
      <bpmn:incoming>Flow_ApprovalToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- END EVENT: rejected -->
    <bpmn:endEvent id="End_Rejected" name="PO Rejected">
      <bpmn:incoming>Flow_Reject</bpmn:incoming>
    </bpmn:endEvent>

    <!-- SEQUENCE FLOWS -->
    <bpmn:sequenceFlow id="Flow_StartToFetch"    sourceRef="Start_1"          targetRef="Task_FetchPOContext" />
    <bpmn:sequenceFlow id="Flow_FetchToReview"   sourceRef="Task_FetchPOContext" targetRef="Task_ReviewPO" />
    <bpmn:sequenceFlow id="Flow_ReviewToGateway" sourceRef="Task_ReviewPO"    targetRef="Gw_Decision" />
    <bpmn:sequenceFlow id="Flow_Approve"         sourceRef="Gw_Decision"      targetRef="Task_RecordApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=vars.Var_Decision == "Approve"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Reject"          sourceRef="Gw_Decision"      targetRef="End_Rejected" />
    <bpmn:sequenceFlow id="Flow_ApprovalToEnd"   sourceRef="Task_RecordApproval" targetRef="End_Approved" />
  </bpmn:process>

  <!-- BPMN DI -->
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_VendorPOReview">

      <!-- Start event -->
      <bpmndi:BPMNShape id="S_Start_1" bpmnElement="Start_1">
        <dc:Bounds x="152" y="232" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Fetch PO Context script task -->
      <bpmndi:BPMNShape id="S_Task_FetchPOContext" bpmnElement="Task_FetchPOContext">
        <dc:Bounds x="250" y="210" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Review PO user task -->
      <bpmndi:BPMNShape id="S_Task_ReviewPO" bpmnElement="Task_ReviewPO">
        <dc:Bounds x="420" y="210" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Decision gateway -->
      <bpmndi:BPMNShape id="S_Gw_Decision" bpmnElement="Gw_Decision">
        <dc:Bounds x="595" y="225" width="50" height="50" />
      </bpmndi:BPMNShape>

      <!-- Record Approval script task -->
      <bpmndi:BPMNShape id="S_Task_RecordApproval" bpmnElement="Task_RecordApproval">
        <dc:Bounds x="720" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- End: Approved -->
      <bpmndi:BPMNShape id="S_End_Approved" bpmnElement="End_Approved">
        <dc:Bounds x="892" y="162" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- End: Rejected -->
      <bpmndi:BPMNShape id="S_End_Rejected" bpmnElement="End_Rejected">
        <dc:Bounds x="892" y="322" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Edges -->
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_StartToFetch" bpmnElement="Flow_StartToFetch">
        <di:waypoint x="188" y="250" />
        <di:waypoint x="250" y="250" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_FetchToReview" bpmnElement="Flow_FetchToReview">
        <di:waypoint x="350" y="250" />
        <di:waypoint x="420" y="250" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_ReviewToGateway" bpmnElement="Flow_ReviewToGateway">
        <di:waypoint x="520" y="250" />
        <di:waypoint x="595" y="250" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_Approve" bpmnElement="Flow_Approve">
        <di:waypoint x="620" y="225" />
        <di:waypoint x="620" y="180" />
        <di:waypoint x="720" y="180" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_Reject" bpmnElement="Flow_Reject">
        <di:waypoint x="620" y="275" />
        <di:waypoint x="620" y="340" />
        <di:waypoint x="892" y="340" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_ApprovalToEnd" bpmnElement="Flow_ApprovalToEnd">
        <di:waypoint x="820" y="180" />
        <di:waypoint x="892" y="180" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
