<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:uipath="http://uipath.org/schema/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" exporter="UiPath Maestro (https://uipath.com)" exporterVersion="1.201.0-dev.8275">
  <bpmn:process id="Process_1" name="Maestro Process">
    <bpmn:extensionElements>
      <uipath:variables version="v1">
        <uipath:inputOutput id="Var_HitlResult" name="HitlResult" type="string" />
        <uipath:inputOutput id="Var_RpaJobResult" name="RpaJobResult" type="string" />
      </uipath:variables>
      <uipath:bindings version="v1" />
    </bpmn:extensionElements>
    <bpmn:startEvent id="Event_start" name="core.trigger.manual">
      <bpmn:extensionElements>
        <uipath:entryPointId value="06f24d77-ee2d-41eb-9e95-6f3705771d0f" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_StartToApproval</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_ApproveAccess" name="Approve Employee Access Request">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Actions.HITL" version="v1" />
          <uipath:context>
            <uipath:input name="appId" value="PLACEHOLDER_ACTION_APP_ID" />
            <uipath:input name="appVersion" value="1" />
            <uipath:input name="actions" value="Approve,Reject" />
            <uipath:input name="key" value="PLACEHOLDER_FOLDER_KEY" />
            <uipath:input name="taskTitle" value="Review Employee Access Provisioning Request" />
          </uipath:context>
          <uipath:input name="HitlTaskArguments" type="json" target="bodyField"><![CDATA[{"requestedBy":"PLACEHOLDER_REQUESTOR","systemName":"PLACEHOLDER_TARGET_SYSTEM"}]]></uipath:input>
          <uipath:output name="Process response" type="Actions.HITL" var="Var_HitlResult" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_StartToApproval</bpmn:incoming>
      <bpmn:outgoing>Flow_ApprovalToProvision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_ProvisionAccess" name="Start Access Provisioning Job">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.StartJob" version="v1" />
          <uipath:context>
            <uipath:input name="releaseKey" value="PLACEHOLDER_PROCESS_KEY" />
            <uipath:input name="folderId" value="PLACEHOLDER_FOLDER_ID" />
            <uipath:input name="folderPath" value="PLACEHOLDER_FOLDER_PATH" />
            <uipath:input name="name" value="PLACEHOLDER_EmployeeAccessProvisioning" />
          </uipath:context>
          <uipath:input name="JobArguments" type="json" target="bodyField"><![CDATA[{"employeeId":"PLACEHOLDER_EMPLOYEE_ID","systemName":"PLACEHOLDER_TARGET_SYSTEM"}]]></uipath:input>
          <uipath:output name="Process response" type="Orchestrator.RunJob" var="Var_RpaJobResult" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ApprovalToProvision</bpmn:incoming>
      <bpmn:outgoing>Flow_ProvisionToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_end" name="Access Provisioning Complete">
      <bpmn:incoming>Flow_ProvisionToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_StartToApproval" sourceRef="Event_start" targetRef="Task_ApproveAccess" />
    <bpmn:sequenceFlow id="Flow_ApprovalToProvision" sourceRef="Task_ApproveAccess" targetRef="Task_ProvisionAccess" />
    <bpmn:sequenceFlow id="Flow_ProvisionToEnd" sourceRef="Task_ProvisionAccess" targetRef="Event_end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="S_Event_start" bpmnElement="Event_start">
        <dc:Bounds x="152" y="144" width="96" height="96" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="152" y="245" width="96" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_ApproveAccess" bpmnElement="Task_ApproveAccess">
        <dc:Bounds x="330" y="150" width="120" height="84" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_ProvisionAccess" bpmnElement="Task_ProvisionAccess">
        <dc:Bounds x="540" y="150" width="120" height="84" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Event_end" bpmnElement="Event_end">
        <dc:Bounds x="752" y="144" width="96" height="96" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="752" y="245" width="96" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_StartToApproval" bpmnElement="Flow_StartToApproval">
        <di:waypoint x="248" y="192" />
        <di:waypoint x="330" y="192" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_ApprovalToProvision" bpmnElement="Flow_ApprovalToProvision">
        <di:waypoint x="450" y="192" />
        <di:waypoint x="540" y="192" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_ProvisionToEnd" bpmnElement="Flow_ProvisionToEnd">
        <di:waypoint x="660" y="192" />
        <di:waypoint x="752" y="192" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
