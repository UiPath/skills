<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:uipath="http://uipath.org/schema/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" exporter="UiPath Maestro (https://uipath.com)" exporterVersion="1.201.0-dev.8275">
  <bpmn:process id="Process_1" name="Maestro Process" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:variables version="v1">
        <uipath:input id="Var_Amount" name="amount" type="number" elementId="Event_start" />
        <uipath:input id="Var_DaysOverdue" name="daysOverdue" type="number" elementId="Event_start" />
        <uipath:output id="Var_RiskScore" name="riskScore" type="number" />
      </uipath:variables>
      <uipath:bindings version="v1" />
    </bpmn:extensionElements>
    <bpmn:startEvent id="Event_start" name="core.trigger.manual">
      <bpmn:extensionElements>
        <uipath:entryPointId value="fd2dd4b6-16a2-4f1a-a0b8-deede5bd68e9" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_ToScript</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:scriptTask id="Task_RiskScore" name="Calculate Risk Score" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"amount":"=vars.Var_Amount","daysOverdue":"=vars.Var_DaysOverdue"}]]></uipath:input>
          <uipath:output name="riskScore" type="number" var="Var_RiskScore" source="=result.response" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToScript</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
      <bpmn:script><![CDATA[
var amountFactor = amount * 0.001;
var overdueFactor = daysOverdue * 5;
var score = amountFactor + overdueFactor;
if (score > 100) {
  score = 100;
}
if (score < 0) {
  score = 0;
}
return { response: Math.round(score) };
]]></bpmn:script>
    </bpmn:scriptTask>
    <bpmn:endEvent id="Event_end" name="Done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToScript" sourceRef="Event_start" targetRef="Task_RiskScore" />
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_RiskScore" targetRef="Event_end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="S_Event_start" bpmnElement="Event_start">
        <dc:Bounds x="160" y="100" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="140" y="140" width="76" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_RiskScore" bpmnElement="Task_RiskScore">
        <dc:Bounds x="260" y="78" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Event_end" bpmnElement="Event_end">
        <dc:Bounds x="420" y="100" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="410" y="140" width="56" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_ToScript" bpmnElement="Flow_ToScript">
        <di:waypoint x="196" y="118" />
        <di:waypoint x="260" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_ToEnd" bpmnElement="Flow_ToEnd">
        <di:waypoint x="360" y="118" />
        <di:waypoint x="420" y="118" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
