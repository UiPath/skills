<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="UiPath (https://bpmn.uipath.com)" exporterVersion="1.0">

  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:migrationVersion version="11.5" />
      <uipath:variables version="v1">
        <uipath:inputOutput id="Var_OperandA" name="operandA" type="number" elementId="Start_Manual" />
        <uipath:inputOutput id="Var_OperandB" name="operandB" type="number" elementId="Start_Manual" />
        <uipath:inputOutput id="Var_Operator" name="operator" type="string" elementId="Start_Manual" />
        <uipath:output id="Var_Result" name="result" type="number" />
      </uipath:variables>
    </bpmn:extensionElements>

    <bpmn:startEvent id="Start_Manual" name="Manual Start">
      <bpmn:extensionElements>
        <uipath:entryPointId value="8f2c6a1e-4b7d-4e3a-9c5f-1d6e8a2b3c9f" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_StartToGateway</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:exclusiveGateway id="Gw_Operator" name="Operator?" default="Flow_GwToDivide">
      <bpmn:incoming>Flow_StartToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_GwToAdd</bpmn:outgoing>
      <bpmn:outgoing>Flow_GwToSubtract</bpmn:outgoing>
      <bpmn:outgoing>Flow_GwToMultiply</bpmn:outgoing>
      <bpmn:outgoing>Flow_GwToDivide</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:scriptTask id="Task_Add" name="Add" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"operandA":"=vars.Var_OperandA","operandB":"=vars.Var_OperandB"}]]></uipath:input>
          <uipath:output name="result" type="number" var="Var_Result" source="=result.response" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_GwToAdd</bpmn:incoming>
      <bpmn:outgoing>Flow_AddToEnd</bpmn:outgoing>
      <bpmn:script><![CDATA[return { response: operandA + operandB };]]></bpmn:script>
    </bpmn:scriptTask>

    <bpmn:scriptTask id="Task_Subtract" name="Subtract" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"operandA":"=vars.Var_OperandA","operandB":"=vars.Var_OperandB"}]]></uipath:input>
          <uipath:output name="result" type="number" var="Var_Result" source="=result.response" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_GwToSubtract</bpmn:incoming>
      <bpmn:outgoing>Flow_SubtractToEnd</bpmn:outgoing>
      <bpmn:script><![CDATA[return { response: operandA - operandB };]]></bpmn:script>
    </bpmn:scriptTask>

    <bpmn:scriptTask id="Task_Multiply" name="Multiply" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"operandA":"=vars.Var_OperandA","operandB":"=vars.Var_OperandB"}]]></uipath:input>
          <uipath:output name="result" type="number" var="Var_Result" source="=result.response" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_GwToMultiply</bpmn:incoming>
      <bpmn:outgoing>Flow_MultiplyToEnd</bpmn:outgoing>
      <bpmn:script><![CDATA[return { response: operandA * operandB };]]></bpmn:script>
    </bpmn:scriptTask>

    <bpmn:scriptTask id="Task_Divide" name="Divide" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"operandA":"=vars.Var_OperandA","operandB":"=vars.Var_OperandB"}]]></uipath:input>
          <uipath:output name="result" type="number" var="Var_Result" source="=result.response" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_GwToDivide</bpmn:incoming>
      <bpmn:outgoing>Flow_DivideToEnd</bpmn:outgoing>
      <bpmn:script><![CDATA[return { response: operandA / operandB };]]></bpmn:script>
    </bpmn:scriptTask>

    <bpmn:endEvent id="End_Add" name="Add Done">
      <bpmn:incoming>Flow_AddToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Subtract" name="Subtract Done">
      <bpmn:incoming>Flow_SubtractToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Multiply" name="Multiply Done">
      <bpmn:incoming>Flow_MultiplyToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Divide" name="Divide Done">
      <bpmn:incoming>Flow_DivideToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_StartToGateway" sourceRef="Start_Manual" targetRef="Gw_Operator" />

    <bpmn:sequenceFlow id="Flow_GwToAdd" sourceRef="Gw_Operator" targetRef="Task_Add">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=vars.Var_Operator == "add"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_GwToSubtract" sourceRef="Gw_Operator" targetRef="Task_Subtract">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=vars.Var_Operator == "subtract"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_GwToMultiply" sourceRef="Gw_Operator" targetRef="Task_Multiply">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=vars.Var_Operator == "multiply"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <!-- Flow_GwToDivide is the gateway's default flow: no condition expression -->
    <bpmn:sequenceFlow id="Flow_GwToDivide" sourceRef="Gw_Operator" targetRef="Task_Divide" />

    <bpmn:sequenceFlow id="Flow_AddToEnd" sourceRef="Task_Add" targetRef="End_Add" />
    <bpmn:sequenceFlow id="Flow_SubtractToEnd" sourceRef="Task_Subtract" targetRef="End_Subtract" />
    <bpmn:sequenceFlow id="Flow_MultiplyToEnd" sourceRef="Task_Multiply" targetRef="End_Multiply" />
    <bpmn:sequenceFlow id="Flow_DivideToEnd" sourceRef="Task_Divide" targetRef="End_Divide" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_1">

      <bpmndi:BPMNShape id="S_Start_Manual" bpmnElement="Start_Manual">
        <dc:Bounds x="160" y="252" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_Gw_Operator" bpmnElement="Gw_Operator">
        <dc:Bounds x="260" y="245" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_Task_Add" bpmnElement="Task_Add">
        <dc:Bounds x="400" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End_Add" bpmnElement="End_Add">
        <dc:Bounds x="580" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_Task_Subtract" bpmnElement="Task_Subtract">
        <dc:Bounds x="400" y="210" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End_Subtract" bpmnElement="End_Subtract">
        <dc:Bounds x="580" y="232" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_Task_Multiply" bpmnElement="Task_Multiply">
        <dc:Bounds x="400" y="340" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End_Multiply" bpmnElement="End_Multiply">
        <dc:Bounds x="580" y="362" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_Task_Divide" bpmnElement="Task_Divide">
        <dc:Bounds x="400" y="470" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End_Divide" bpmnElement="End_Divide">
        <dc:Bounds x="580" y="492" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_StartToGateway" bpmnElement="Flow_StartToGateway">
        <di:waypoint x="196" y="270" />
        <di:waypoint x="260" y="270" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_GwToAdd" bpmnElement="Flow_GwToAdd">
        <di:waypoint x="285" y="245" />
        <di:waypoint x="285" y="120" />
        <di:waypoint x="400" y="120" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_GwToSubtract" bpmnElement="Flow_GwToSubtract">
        <di:waypoint x="285" y="245" />
        <di:waypoint x="285" y="250" />
        <di:waypoint x="400" y="250" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_GwToMultiply" bpmnElement="Flow_GwToMultiply">
        <di:waypoint x="285" y="295" />
        <di:waypoint x="285" y="380" />
        <di:waypoint x="400" y="380" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_GwToDivide" bpmnElement="Flow_GwToDivide">
        <di:waypoint x="285" y="295" />
        <di:waypoint x="285" y="510" />
        <di:waypoint x="400" y="510" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_AddToEnd" bpmnElement="Flow_AddToEnd">
        <di:waypoint x="500" y="120" />
        <di:waypoint x="580" y="120" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_SubtractToEnd" bpmnElement="Flow_SubtractToEnd">
        <di:waypoint x="500" y="250" />
        <di:waypoint x="580" y="250" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_MultiplyToEnd" bpmnElement="Flow_MultiplyToEnd">
        <di:waypoint x="500" y="380" />
        <di:waypoint x="580" y="380" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_DivideToEnd" bpmnElement="Flow_DivideToEnd">
        <di:waypoint x="500" y="510" />
        <di:waypoint x="580" y="510" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
