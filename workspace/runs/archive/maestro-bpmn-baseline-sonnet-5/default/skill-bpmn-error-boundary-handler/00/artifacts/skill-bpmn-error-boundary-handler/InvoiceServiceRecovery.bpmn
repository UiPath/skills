<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_InvoiceServiceRecovery" targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="UiPath (https://bpmn.uipath.com)" exporterVersion="1.0">

  <bpmn:error id="Error_ServiceUnavailable" name="ServiceUnavailable" errorCode="INVOICE_SERVICE_UNAVAILABLE" />

  <bpmn:process id="Process_InvoiceServiceRecovery" name="InvoiceServiceRecovery" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:migrationVersion version="11.5" />
      <uipath:variables version="v1">
        <uipath:inputOutput id="Var_InvoiceId" name="InvoiceId" type="string" />
        <uipath:inputOutput id="Var_InvoicePayload" name="InvoicePayload" type="json" />
        <uipath:inputOutput id="Var_PostResponse" name="PostResponse" type="json" />
        <uipath:inputOutput id="Var_RecoveryStatus" name="RecoveryStatus" type="string" />
      </uipath:variables>
      <uipath:bindings version="v1">
        <uipath:binding id="Binding_InvoiceServiceUrl" resource="Connection" propertyAttribute="ConnectionId" default="&lt;CONNECTION_ID&gt;" />
      </uipath:bindings>
    </bpmn:extensionElements>

    <bpmn:startEvent id="Start_Manual" name="Start">
      <bpmn:outgoing>Flow_StartToPost</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sendTask id="Task_PostInvoice" name="Post Invoice to Service">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Intsvc.UnifiedHttpRequest" version="v1" />
          <uipath:context>
            <uipath:input name="mode" value="manual" />
            <uipath:input name="method" value="POST" />
            <uipath:input name="url" value="=bindings.Binding_InvoiceServiceUrl" />
            <uipath:input name="headers" value="{&quot;Content-Type&quot;:&quot;application/json&quot;}" />
            <uipath:input name="parameters" value="{}" />
            <uipath:input name="body" value="=vars.Var_InvoicePayload" />
          </uipath:context>
          <uipath:output name="response" type="jsonSchema" source="=response" var="Var_PostResponse" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_StartToPost</bpmn:incoming>
      <bpmn:outgoing>Flow_PostToEndSuccess</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:boundaryEvent id="Boundary_ServiceError" name="Service Error" attachedToRef="Task_PostInvoice" cancelActivity="true">
      <bpmn:errorEventDefinition errorRef="Error_ServiceUnavailable" />
      <bpmn:outgoing>Flow_BoundaryToRecovery</bpmn:outgoing>
    </bpmn:boundaryEvent>

    <bpmn:scriptTask id="Task_Recovery" name="Recover Failed Invoice Post" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"invoiceId":"=vars.Var_InvoiceId"}]]></uipath:input>
          <uipath:output name="status" type="string" var="Var_RecoveryStatus" source="=result.response" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_BoundaryToRecovery</bpmn:incoming>
      <bpmn:outgoing>Flow_RecoveryToEndRecovered</bpmn:outgoing>
      <bpmn:script><![CDATA[return { response: "queued-for-retry:" + invoiceId };]]></bpmn:script>
    </bpmn:scriptTask>

    <bpmn:endEvent id="End_Success" name="Invoice Posted">
      <bpmn:incoming>Flow_PostToEndSuccess</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_Recovered" name="Recovered">
      <bpmn:incoming>Flow_RecoveryToEndRecovered</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_StartToPost" sourceRef="Start_Manual" targetRef="Task_PostInvoice" />
    <bpmn:sequenceFlow id="Flow_PostToEndSuccess" sourceRef="Task_PostInvoice" targetRef="End_Success" />
    <bpmn:sequenceFlow id="Flow_BoundaryToRecovery" sourceRef="Boundary_ServiceError" targetRef="Task_Recovery" />
    <bpmn:sequenceFlow id="Flow_RecoveryToEndRecovered" sourceRef="Task_Recovery" targetRef="End_Recovered" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_InvoiceServiceRecovery">
    <bpmndi:BPMNPlane id="Plane_InvoiceServiceRecovery" bpmnElement="Process_InvoiceServiceRecovery">
      <bpmndi:BPMNShape id="S_Start_Manual" bpmnElement="Start_Manual">
        <dc:Bounds x="160" y="140" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_PostInvoice" bpmnElement="Task_PostInvoice">
        <dc:Bounds x="260" y="118" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Boundary_ServiceError" bpmnElement="Boundary_ServiceError">
        <dc:Bounds x="292" y="180" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End_Success" bpmnElement="End_Success">
        <dc:Bounds x="430" y="140" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_Recovery" bpmnElement="Task_Recovery">
        <dc:Bounds x="260" y="280" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End_Recovered" bpmnElement="End_Recovered">
        <dc:Bounds x="430" y="300" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_StartToPost" bpmnElement="Flow_StartToPost">
        <di:waypoint x="196" y="158" />
        <di:waypoint x="260" y="158" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_PostToEndSuccess" bpmnElement="Flow_PostToEndSuccess">
        <di:waypoint x="360" y="158" />
        <di:waypoint x="430" y="158" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_BoundaryToRecovery" bpmnElement="Flow_BoundaryToRecovery">
        <di:waypoint x="310" y="216" />
        <di:waypoint x="310" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_RecoveryToEndRecovered" bpmnElement="Flow_RecoveryToEndRecovered">
        <di:waypoint x="360" y="320" />
        <di:waypoint x="430" y="318" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
