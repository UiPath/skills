{
  "id": "41f04ea9-e5e9-42bd-ac4c-71b828bf77ae",
  "version": "1.8",
  "name": "VendorInvoiceProcessing",
  "nodes": [
    {
      "id": "extractInvoice",
      "type": "uipath.ixp.idp-benchmark-invoices-c735405a-ixp.f6df6382-0af4-80b4-9690-e540cf2af19a-c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Extract Invoice Fields"
      },
      "inputs": {
        "model": {
          "id": "f6df6382-0af4-80b4-9690-e540cf2af19a",
          "modelName": "idp-benchmark---invoices-c735405a-ixp",
          "modelDisplayName": "idp-benchmark---invoices-c735405a-ixp",
          "folderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "folderName": "Shared",
          "folderPath": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "description": ""
        },
        "modelName": "idp-benchmark---invoices-c735405a-ixp",
        "projectName": "idp-benchmark---invoices-c735405a-ixp",
        "folderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
        "folderName": "Shared",
        "versionTag": "",
        "pageRange": "",
        "fileRef": "=js:$vars.downloadInvoicePdf1.output.output",
        "errorHandlingEnabled": true
      },
      "outputs": {
        "output": {
          "name": "output",
          "type": "object",
          "source": "=this.result",
          "var": "output",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "properties": {
              "ExtractionResult": {
                "type": "object",
                "properties": {
                  "DocumentId": {
                    "type": "string"
                  },
                  "ResultsVersion": {
                    "type": "integer"
                  },
                  "ResultsDocument": {
                    "type": "object",
                    "properties": {
                      "Fields": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "FieldId": {
                              "type": "string"
                            },
                            "FieldName": {
                              "type": "string"
                            },
                            "FieldType": {
                              "type": "string"
                            },
                            "IsMissing": {
                              "type": "boolean"
                            },
                            "Values": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            },
                            "Confidence": {
                              "type": "integer"
                            },
                            "OperatorConfirmed": {
                              "type": "boolean"
                            }
                          }
                        }
                      },
                      "Tables": {
                        "type": "array",
                        "items": {
                          "type": "object"
                        }
                      }
                    }
                  }
                }
              },
              "ExtractorPayloads": {
                "type": "object"
              },
              "BusinessrulesResults": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "status": {
                "type": "integer"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "id": "parseFields",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Parse & Validate Invoice Data"
      },
      "inputs": {
        "script": "const fields = ($vars.extractInvoice.output.ExtractionResult && $vars.extractInvoice.output.ExtractionResult.ResultsDocument && $vars.extractInvoice.output.ExtractionResult.ResultsDocument.Fields) ? $vars.extractInvoice.output.ExtractionResult.ResultsDocument.Fields : [];\n\nconst get = (name) => {\n  const f = fields.find(f => f.FieldName === name);\n  return f && !f.IsMissing && f.Values && f.Values.length > 0 ? f.Values[0] : null;\n};\n\nconst getConf = (name) => {\n  const f = fields.find(f => f.FieldName === name);\n  return f ? (f.Confidence || 0) : 0;\n};\n\nconst invoiceNumber = get('invoice_id') || get('InvoiceNumber') || get('Invoice Number') || get('invoice_number');\nconst vendorName   = get('vendor_name') || get('VendorName') || get('Vendor Name');\nconst invoiceDate  = get('invoice_date') || get('InvoiceDate') || get('Invoice Date');\nconst dueDate      = get('due_date') || get('DueDate') || get('Due Date');\nconst totalAmount  = get('total_amount') || get('TotalAmount') || get('Total Amount') || get('Total Due') || get('total_due');\nconst currency     = get('currency') || get('Currency') || 'USD';\n\nconst confScores = [\n  getConf('invoice_id') || getConf('InvoiceNumber') || getConf('Invoice Number'),\n  getConf('vendor_name') || getConf('VendorName') || getConf('Vendor Name'),\n  getConf('total_amount') || getConf('TotalAmount') || getConf('Total Amount') || getConf('Total Due')\n].filter(c => c > 0);\n\nconst avgConfidence = confScores.length > 0\n  ? Math.round(confScores.reduce((a, b) => a + b, 0) / confScores.length)\n  : 0;\n\nconst highConfidence = avgConfidence >= 80 && invoiceNumber && totalAmount;\n\nreturn {\n  invoiceNumber,\n  vendorName,\n  invoiceDate,\n  dueDate,\n  totalAmount,\n  currency,\n  avgConfidence,\n  highConfidence,\n  fieldCount: fields.length\n};",
        "errorHandlingEnabled": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "checkConfidence",
      "type": "core.logic.decision",
      "typeVersion": "1.1",
      "display": {
        "label": "High Confidence Extraction?"
      },
      "inputs": {
        "expression": "$vars.parseFields.output.highConfidence === true",
        "trueLabel": "Auto-approve",
        "falseLabel": "Needs Review"
      }
    },
    {
      "id": "hitlReview",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "AP Team Review"
      },
      "inputs": {
        "title": "Invoice Requires Manual Review",
        "priority": "Medium",
        "schema": {
          "schemaId": "a3f7c291-04e8-4b12-9d65-7e83f1a02c4b",
          "fields": [
            {
              "id": "invoiceNumber",
              "label": "Invoice Number",
              "type": "text",
              "direction": "input",
              "binding": "vars.parseFields.output.invoiceNumber"
            },
            {
              "id": "vendorName",
              "label": "Vendor Name",
              "type": "text",
              "direction": "input",
              "binding": "vars.parseFields.output.vendorName"
            },
            {
              "id": "totalAmount",
              "label": "Total Amount",
              "type": "text",
              "direction": "input",
              "binding": "vars.parseFields.output.totalAmount"
            },
            {
              "id": "avgConfidence",
              "label": "Extraction Confidence (%)",
              "type": "number",
              "direction": "input",
              "binding": "vars.parseFields.output.avgConfidence"
            },
            {
              "id": "reviewedInvoiceNumber",
              "label": "Confirmed Invoice Number",
              "type": "text",
              "direction": "output",
              "variable": "vars.reviewedInvoiceNumber"
            },
            {
              "id": "reviewedAmount",
              "label": "Confirmed Amount",
              "type": "text",
              "direction": "output",
              "variable": "vars.reviewedAmount"
            },
            {
              "id": "reviewNotes",
              "label": "Review Notes",
              "type": "text",
              "direction": "output",
              "variable": "vars.reviewNotes"
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "End"
            }
          ]
        },
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group"
          }
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "reviewedInvoiceNumber": {
              "type": "string"
            },
            "reviewedAmount": {
              "type": "string"
            },
            "reviewNotes": {
              "type": "string"
            },
            "Action": {
              "type": "string",
              "enum": [
                "Approve",
                "Reject"
              ],
              "default": "Approve"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": [
            "Approve",
            "Reject"
          ],
          "default": "Approve"
        }
      }
    },
    {
      "id": "endAutoProcessed",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Invoice Auto-Processed"
      },
      "outputs": {
        "invoiceNumber": {
          "source": "=js:$vars.parseFields.output.invoiceNumber"
        },
        "vendorName": {
          "source": "=js:$vars.parseFields.output.vendorName"
        },
        "totalAmount": {
          "source": "=js:$vars.parseFields.output.totalAmount"
        },
        "processingStatus": {
          "source": "=js:'auto-approved'"
        },
        "reviewedInvoiceNumber": {
          "source": "=js:$vars.reviewedInvoiceNumber"
        },
        "reviewedAmount": {
          "source": "=js:$vars.reviewedAmount"
        },
        "reviewNotes": {
          "source": "=js:$vars.reviewNotes"
        },
        "sapDocumentId": {
          "source": "=js:$vars.postInvoiceToSap1.output && $vars.postInvoiceToSap1.output.id ? $vars.postInvoiceToSap1.output.id : null"
        }
      }
    },
    {
      "id": "endReviewed",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Invoice Reviewed & Approved"
      },
      "outputs": {
        "invoiceNumber": {
          "source": "=js:$vars.hitlReview.output.reviewedInvoiceNumber || $vars.parseFields.output.invoiceNumber"
        },
        "vendorName": {
          "source": "=js:$vars.parseFields.output.vendorName"
        },
        "totalAmount": {
          "source": "=js:$vars.hitlReview.output.reviewedAmount || $vars.parseFields.output.totalAmount"
        },
        "processingStatus": {
          "source": "=js:'human-approved'"
        },
        "reviewedInvoiceNumber": {
          "source": "=js:$vars.hitlReview.output.reviewedInvoiceNumber"
        },
        "reviewedAmount": {
          "source": "=js:$vars.hitlReview.output.reviewedAmount"
        },
        "reviewNotes": {
          "source": "=js:$vars.reviewNotes"
        },
        "sapDocumentId": {
          "source": "=js:$vars.postInvoiceToSap1.output && $vars.postInvoiceToSap1.output.id ? $vars.postInvoiceToSap1.output.id : null"
        }
      }
    },
    {
      "id": "terminateError",
      "type": "core.logic.terminate",
      "typeVersion": "1.0",
      "display": {
        "label": "Extraction Failed"
      },
      "inputs": {
        "errorMessage": "=js:($vars.extractInvoice.error && $vars.extractInvoice.error.message) ? 'Invoice extraction failed: ' + $vars.extractInvoice.error.message : ($vars.parseFields.error && $vars.parseFields.error.message) ? 'Field parsing failed: ' + $vars.parseFields.error.message : 'Invoice processing failed'"
      },
      "outputs": {
        "invoiceNumber": {
          "source": "=js:null"
        },
        "vendorName": {
          "source": "=js:null"
        },
        "totalAmount": {
          "source": "=js:null"
        },
        "processingStatus": {
          "source": "=js:'error'"
        },
        "reviewedInvoiceNumber": {
          "source": "=js:null"
        },
        "reviewedAmount": {
          "source": "=js:null"
        },
        "reviewNotes": {
          "source": "=js:null"
        },
        "sapDocumentId": {
          "source": "=js:null"
        }
      }
    },
    {
      "id": "invoiceReceivedSharepoint1",
