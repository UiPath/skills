{
  "id": "d198bcd0-a527-4911-819b-0f715178c525",
  "version": "1.8",
  "name": "PurchaseApproval",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual Trigger"
      },
      "inputs": {
        "entryPointId": "fad4477a-c363-4dd3-9965-02c54f6b30ed",
        "isDefaultEntryPoint": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the workflow.",
          "source": "null",
          "var": "output"
        }
      }
    },
    {
      "id": "managerApproval",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "Manager Approves Purchase"
      },
      "inputs": {
        "schema": {
          "schemaId": "b7e3c4a1-9f28-4d5e-a6c2-3e8b0f1d7a94",
          "fields": [
            {
              "id": "purchaseAmount",
              "label": "Purchase Amount",
              "type": "number",
              "direction": "input",
              "binding": "vars.start.output.purchaseAmount"
            },
            {
              "id": "vendorName",
              "label": "Vendor Name",
              "type": "text",
              "direction": "input",
              "binding": "vars.start.output.vendorName"
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "End"
            }
          ]
        },
        "recipient": {
          "channels": [
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group"
          }
        },
        "priority": "Medium",
        "title": "Purchase Approval Required"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "Action": {
              "type": "string",
              "enum": [
                "Approve",
                "Reject"
              ],
              "default": "Approve"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": [
            "Approve",
            "Reject"
          ],
          "default": "Approve"
        }
      }
    },
    {
      "id": "logApproval",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log Approval"
      },
      "inputs": {
        "script": "return { message: \"Approval recorded.\" };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {}
    }
  ],
  "edges": [
    {
      "id": "edge-start-approval",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "managerApproval",
      "targetPort": "input"
    },
    {
      "id": "edge-approval-log",
      "sourceNodeId": "managerApproval",
      "sourcePort": "completed",
      "targetNodeId": "logApproval",
      "targetPort": "input"
    },
    {
      "id": "edge-log-end",
      "sourceNodeId": "logApproval",
      "sourcePort": "success",
      "targetNodeId": "end",
      "targetPort": "input"
    }
  ],
  "definitions": [
    {
