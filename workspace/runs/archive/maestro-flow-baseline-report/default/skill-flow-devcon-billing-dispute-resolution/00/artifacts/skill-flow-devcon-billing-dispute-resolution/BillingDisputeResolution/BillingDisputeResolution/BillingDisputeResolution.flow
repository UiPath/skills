      },
      "inputs": {
        "systemPrompt": "You are a customer communication specialist. Write a professional resolution letter.",
        "userPrompt": "Write the resolution communication for this billing dispute.",
        "source": "16ad9c3d-64e8-4e1c-a052-ed14a4e89f3a",
        "agentInputVariables": [
          {
            "id": "start__output__webhookPayload",
            "type": "object",
            "binding": "=$vars.start.output.webhookPayload",
            "description": "The billing dispute webhook payload"
          },
          {
