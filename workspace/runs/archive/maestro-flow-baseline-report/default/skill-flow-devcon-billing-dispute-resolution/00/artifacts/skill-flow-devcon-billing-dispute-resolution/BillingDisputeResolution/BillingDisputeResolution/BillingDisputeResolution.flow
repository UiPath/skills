            "description": "Credit amount to apply"
          },
          {
            "id": "disputeAnalyst1__output__rationale",
            "type": "string",
            "binding": "=$vars.disputeAnalyst1.output.rationale",
            "description": "Rationale for decision"
          }
        ],
        "agentOutputVariables": [
          {
            "id": "subject",
            "type": "string"
          },
          {
            "id": "body",
            "type": "string"
          }
        ]
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Agent response",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
