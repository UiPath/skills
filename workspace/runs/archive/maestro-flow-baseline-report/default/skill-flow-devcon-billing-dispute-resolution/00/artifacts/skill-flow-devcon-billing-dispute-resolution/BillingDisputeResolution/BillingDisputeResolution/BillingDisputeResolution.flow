    {
      "id": "discrepancyDetection1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Discrepancy Detection"
      },
      "inputs": {
        "script": "const disputedItems = ($vars.start.output.webhookPayload && $vars.start.output.webhookPayload.dispute && $vars.start.output.webhookPayload.dispute.disputedLineItems) ? $vars.start.output.webhookPayload.dispute.disputedLineItems : [];\nconst erpRecords = ($vars.erpLookup1.output && $vars.erpLookup1.output.value) ? $vars.erpLookup1.output.value : [];\nconst crmRecords = ($vars.crmLookup1.output && $vars.crmLookup1.output.value) ? $vars.crmLookup1.output.value : [];\n\nconst discrepancies = [];\nlet totalOvercharge = 0;\nlet totalUndercharge = 0;\n\nfor (const item of disputedItems) {\n  const erpMatch = erpRecords.find(r => r.LineItemId === item.lineItemId || r.Description === item.description);\n  if (erpMatch) {\n    const erpAmount = parseFloat(erpMatch.Amount || 0);\n    const disputedAmount = parseFloat(item.disputedAmount || 0);\n    const diff = disputedAmount - erpAmount;\n    if (Math.abs(diff) > 0.01) {\n      discrepancies.push({\n        lineItemId: item.lineItemId,\n        description: item.description,\n        billedAmount: disputedAmount,\n        erpAmount: erpAmount,\n        difference: diff,\n        type: diff > 0 ? 'overcharge' : 'undercharge'\n      });\n      if (diff > 0) totalOvercharge += diff;\n      else totalUndercharge += Math.abs(diff);\n    }\n  } else {\n    discrepancies.push({\n      lineItemId: item.lineItemId,\n      description: item.description,\n      billedAmount: parseFloat(item.disputedAmount || 0),\n      erpAmount: 0,\n      difference: parseFloat(item.disputedAmount || 0),\n      type: 'no_match'\n    });\n    totalOvercharge += parseFloat(item.disputedAmount || 0);\n  }\n}\n\nreturn {\n  discrepancies: discrepancies,\n  totalOvercharge: totalOvercharge,\n  totalUndercharge: totalUndercharge,\n  netDiscrepancy: totalOvercharge - totalUndercharge,\n  hasDiscrepancies: discrepancies.length > 0,\n  crmData: crmRecords,\n  erpData: erpRecords\n};",
        "language": "javascript"
      }
    },
    {
      "id": "disputeAnalyst1",
      "type": "uipath.agent.autonomous",
      "typeVersion": "1.2",
      "display": {
        "label": "Dispute Analyst"
      },
      "inputs": {
        "systemPrompt": "You are a billing dispute analyst. Analyze the provided dispute data and return a structured determination.",
        "userPrompt": "Analyze the billing dispute and return your determination.",
        "source": "58bf81e3-62f5-4181-a82e-c282463a6f91",
        "agentInputVariables": [
          {
            "id": "start__output__webhookPayload",
            "type": "object",
            "binding": "=$vars.start.output.webhookPayload",
            "description": "The billing dispute webhook payload"
          },
          {
            "id": "discrepancyDetection1__output__discrepancies",
            "type": "array",
            "binding": "=$vars.discrepancyDetection1.output.discrepancies",
            "description": "List of detected discrepancies"
          },
          {
            "id": "discrepancyDetection1__output__totalOvercharge",
            "type": "number",
            "binding": "=$vars.discrepancyDetection1.output.totalOvercharge",
            "description": "Total overcharge amount"
          },
          {
            "id": "discrepancyDetection1__output__totalUndercharge",
            "type": "number",
            "binding": "=$vars.discrepancyDetection1.output.totalUndercharge",
            "description": "Total undercharge amount"
          },
          {
            "id": "discrepancyDetection1__output__netDiscrepancy",
            "type": "number",
            "binding": "=$vars.discrepancyDetection1.output.netDiscrepancy",
            "description": "Net discrepancy amount"
          },
          {
            "id": "discrepancyDetection1__output__crmData",
            "type": "array",
            "binding": "=$vars.discrepancyDetection1.output.crmData",
            "description": "CRM customer data"
          }
        ],
        "agentOutputVariables": [
          {
            "id": "determination",
            "type": "string"
          },
          {
            "id": "recommendedAction",
            "type": "string"
          },
          {
            "id": "autoResolutionEligible",
            "type": "boolean"
          },
          {
            "id": "creditAmount",
            "type": "number"
          },
          {
            "id": "confidence",
            "type": "number"
          },
          {
            "id": "rationale",
            "type": "string"
          }
        ]
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Agent response",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
