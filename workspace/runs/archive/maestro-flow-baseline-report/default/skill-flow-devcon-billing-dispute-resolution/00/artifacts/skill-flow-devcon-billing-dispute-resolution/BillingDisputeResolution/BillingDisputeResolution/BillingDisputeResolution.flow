    {
      "id": "normalizeData1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Normalize IxP Output"
      },
      "inputs": {
        "script": "const fields = ($vars.extractInvoice1.output.ExtractionResult && $vars.extractInvoice1.output.ExtractionResult.ResultsDocument && $vars.extractInvoice1.output.ExtractionResult.ResultsDocument.Fields) ? $vars.extractInvoice1.output.ExtractionResult.ResultsDocument.Fields : [];\nconst normalized = fields.map(f => ({\n  Id: f.FieldId,\n  Name: f.FieldName,\n  Value: (f.Values && f.Values.length > 0) ? f.Values[0] : null,\n  Type: f.FieldType,\n  IsMissing: f.IsMissing,\n  Confidence: f.Confidence\n}));\nreturn { fields: normalized };",
        "language": "javascript"
      }
    },
    {
      "id": "crmLookup1",
