{
  "id": "5f104c2f-7dcf-4d01-810d-865a864208ad",
  "version": "1.8",
  "name": "VendorApproval",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual Trigger"
      },
      "inputs": {
        "entryPointId": "c8a3c48d-c0bd-4075-b9d4-c66e80512ccc",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "setVendorContext",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Set Vendor Context"
      },
      "inputs": {
        "script": "return { vendorName: \"Acme Corp\", creditScore: 720 };"
      }
    },
    {
      "id": "complianceReview",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "Compliance Review"
      },
      "inputs": {
        "schema": {
          "schemaId": "b3e7a12c-4f9d-4e81-9c05-d72f3a8b1e56",
          "fields": [
            {
              "id": "vendorName",
              "label": "Vendor Name",
              "type": "text",
              "direction": "input",
              "binding": "vars.setVendorContext.output.vendorName"
            },
            {
              "id": "creditScore",
              "label": "Credit Score",
              "type": "number",
              "direction": "input",
              "binding": "vars.setVendorContext.output.creditScore"
            },
            {
              "id": "approved",
              "label": "Approved",
              "type": "boolean",
              "direction": "output",
              "required": true,
              "variable": "vars.approved"
            },
            {
              "id": "risk_notes",
              "label": "Risk Notes",
              "type": "text",
              "direction": "output",
              "variable": "vars.risk_notes"
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "End"
            }
          ]
        },
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group"
          }
        },
        "priority": "Medium"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "approved": {
              "type": "boolean"
            },
            "risk_notes": {
              "type": "string"
            },
            "Action": {
              "type": "string",
              "enum": [
                "Approve",
                "Reject"
              ],
              "default": "Approve"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": [
            "Approve",
            "Reject"
          ],
          "default": "Approve"
        }
      }
    },
    {
      "id": "approvalDecision",
      "type": "core.logic.decision",
      "typeVersion": "1.1",
      "display": {
        "label": "Approved?"
      },
      "inputs": {
        "expression": "$vars.complianceReview.output.approved",
        "trueLabel": "Approved",
        "falseLabel": "Rejected"
      }
    },
    {
      "id": "onboardVendor",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Vendor Onboarded"
      },
      "inputs": {
        "script": "return { message: \"Vendor onboarded\" };"
      }
    },
    {
      "id": "rejectVendor",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Vendor Rejected"
      },
      "inputs": {
        "script": "return { message: \"Vendor rejected\" };"
      }
    },
    {
      "id": "endApproved",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      }
    },
    {
      "id": "endRejected",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      }
    }
  ],
  "edges": [
    {
      "id": "edge-start-setVendorContext",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "setVendorContext",
      "targetPort": "input"
    },
    {
      "id": "edge-setVendorContext-complianceReview",
      "sourceNodeId": "setVendorContext",
      "sourcePort": "success",
      "targetNodeId": "complianceReview",
      "targetPort": "input"
    },
    {
      "id": "edge-complianceReview-approvalDecision",
      "sourceNodeId": "complianceReview",
      "sourcePort": "completed",
      "targetNodeId": "approvalDecision",
      "targetPort": "input"
    },
    {
      "id": "edge-decision-true-onboard",
      "sourceNodeId": "approvalDecision",
      "sourcePort": "true",
      "targetNodeId": "onboardVendor",
      "targetPort": "input"
    },
    {
      "id": "edge-decision-false-reject",
      "sourceNodeId": "approvalDecision",
      "sourcePort": "false",
      "targetNodeId": "rejectVendor",
      "targetPort": "input"
    },
    {
      "id": "edge-onboard-endApproved",
      "sourceNodeId": "onboardVendor",
      "sourcePort": "success",
      "targetNodeId": "endApproved",
      "targetPort": "input"
    },
    {
      "id": "edge-reject-endRejected",
      "sourceNodeId": "rejectVendor",
      "sourcePort": "success",
      "targetNodeId": "endRejected",
      "targetPort": "input"
    }
  ],
  "definitions": [
    {
      "nodeType": "core.trigger.manual",
      "version": "1.0",
      "category": "trigger",
      "description": "Start workflow manually",
      "tags": [
        "trigger",
        "start",
        "manual"
      ],
      "sortOrder": 40,
      "display": {
        "label": "Manual trigger",
        "icon": "play",
        "shape": "circle"
      },
      "handleConfiguration": [
        {
          "position": "right",
          "handles": [
            {
              "id": "output",
              "type": "source",
              "handleType": "output",
              "showButton": true,
              "constraints": {
                "forbiddenTargetCategories": [
                  "trigger"
                ]
              }
            }
          ],
          "visible": true
        }
      ],
      "model": {
        "type": "bpmn:StartEvent",
        "entryPointId": true
      },
      "outputDefinition": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the workflow.",
          "source": "null",
          "var": "output"
        }
      },
      "toolbarExtensions": {
        "design": {
          "actions": [
            {
              "id": "change-trigger-type",
              "icon": "square-mouse-pointer",
              "label": "Change trigger type"
            }
          ]
        }
      }
    },
    {
      "nodeType": "core.action.script",
      "version": "1.0",
      "category": "data-operations",
      "description": "Run custom JavaScript code",
      "tags": [
        "code",
        "javascript",
        "python"
      ],
      "sortOrder": 35,
      "supportsErrorHandling": true,
      "display": {
        "label": "Script",
        "icon": "code"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ]
        },
        {
          "position": "right",
          "handles": [
            {
              "id": "success",
              "type": "source",
              "handleType": "output"
            },
            {
              "id": "error",
              "label": "Error",
              "type": "source",
              "handleType": "output",
              "visible": "{inputs.errorHandlingEnabled}",
              "constraints": {
                "maxConnections": 1
              }
            }
          ]
        }
      ],
      "debug": {
        "runtime": "clientScript"
      },
      "model": {
        "type": "bpmn:ScriptTask"
      },
      "inputDefinition": {
        "type": "object",
        "properties": {
          "script": {
            "type": "string",
            "minLength": 1,
            "errorMessage": "A script function is required",
            "validationSeverity": "warning"
          }
        },
        "required": [
          "script"
        ]
      },
      "inputDefaults": {
        "script": ""
      },
      "outputDefinition": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "form": {
        "id": "script-properties",
        "title": "Script configuration",
        "sections": [
          {
            "id": "script",
            "title": "Script",
            "collapsible": true,
            "defaultExpanded": true,
            "fields": [
              {
                "name": "inputs.script",
                "type": "custom",
                "component": "script-editor",
                "componentProps": {
                  "language": "javascript",
                  "returnType": "any",
                  "validationMode": "script",
                  "minHeight": 200,
                  "placeholder": " // Return an object with your result\nreturn {\n  message: \"Web request response\",\n  data: $vars.httpRequest1.output\n                  };"
                },
                "label": "Code",
                "description": "JavaScript expression that returns a result object"
              }
            ]
          }
        ]
      }
    },
    {
      "nodeType": "uipath.human-in-the-loop.quick-form",
      "version": "1.0",
      "category": "human-task",
      "description": "Fast inline approvals with inline debug",
      "tags": [
