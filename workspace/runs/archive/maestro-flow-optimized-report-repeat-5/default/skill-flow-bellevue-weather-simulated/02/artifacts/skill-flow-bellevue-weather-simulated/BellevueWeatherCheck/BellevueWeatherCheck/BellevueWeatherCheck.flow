{
  "id": "821494db-e425-49ad-9334-259bc0045ca9",
  "version": "1.8",
  "name": "BellevueWeatherCheck",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "fb380e20-60a8-4cce-8134-972b2e192a18",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "evaluateWeather",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Evaluate: Is It a Nice Day?"
      },
      "inputs": {
        "script": "var raw = $vars.getBellevueWeather1.output;\nvar cw = raw && raw.current_weather ? raw.current_weather : {};\nvar tempC = cw.temperature !== undefined ? cw.temperature : null;\nvar tempF = tempC !== null ? Math.round(tempC * 9 / 5 + 32) : null;\nvar windKmh = cw.windspeed !== undefined ? cw.windspeed : null;\nvar windMph = windKmh !== null ? Math.round(windKmh * 0.621371) : null;\nvar wmoCode = cw.weathercode !== undefined ? cw.weathercode : -1;\nvar conditionMap = { 0: \"Clear Sky\", 1: \"Mainly Clear\", 2: \"Partly Cloudy\", 3: \"Overcast\", 45: \"Fog\", 48: \"Depositing Rime Fog\", 51: \"Light Drizzle\", 53: \"Moderate Drizzle\", 55: \"Dense Drizzle\", 61: \"Slight Rain\", 63: \"Moderate Rain\", 65: \"Heavy Rain\", 71: \"Slight Snow\", 73: \"Moderate Snow\", 75: \"Heavy Snow\", 80: \"Slight Showers\", 81: \"Moderate Showers\", 82: \"Violent Showers\", 95: \"Thunderstorm\", 96: \"Thunderstorm with Hail\", 99: \"Thunderstorm with Heavy Hail\" };\nvar condition = conditionMap[wmoCode] !== undefined ? conditionMap[wmoCode] : \"Unknown (WMO \" + wmoCode + \")\";\nvar isNice = tempF !== null && tempF > 60;\nvar reasons = [];\nif (!isNice) { reasons.push(tempF !== null ? \"Temperature is 60\\u00b0F or below (\" + tempF + \"\\u00b0F)\" : \"Temperature unavailable\"); }\nvar verdict = isNice ? \"nice day\" : \"bring a jacket\";\nreturn { isNice: isNice, verdict: verdict, reasons: reasons, tempF: tempF, windMph: windMph, condition: condition, wmoCode: wmoCode };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Day evaluation result",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "buildReport",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Build Weather Report"
      },
      "inputs": {
        "script": "var e = $vars.evaluateWeather.output;\nvar sep = \"==================================================\";\nvar lines = [\n  sep,\n  \"  Bellevue Weather Check — Bellevue, WA (live)\",\n  sep,\n  \"  Condition    : \" + e.condition,\n  \"  Temperature  : \" + (e.tempF !== null ? e.tempF + \"\\u00b0F\" : \"N/A\"),\n  \"  Wind         : \" + (e.windMph !== null ? e.windMph + \" mph\" : \"N/A\"),\n  \"  WMO Code     : \" + e.wmoCode,\n  \"--------------------------------------------------\",\n  \"  Verdict: \" + e.verdict\n];\nif (!e.isNice && e.reasons.length > 0) {\n  lines.push(\"\");\n  lines.push(\"  Reasons:\");\n  for (var i = 0; i < e.reasons.length; i++) {\n    lines.push(\"    \\u2022 \" + e.reasons[i]);\n  }\n}\nlines.push(sep);\nreturn { report: lines.join(\"\\n\"), isNiceDay: e.isNice, verdict: e.verdict };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Formatted weather report",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Done"
      },
      "inputs": {},
      "outputs": {
        "report": {
          "source": "=js:$vars.buildReport.output.report"
        },
        "isNiceDay": {
          "source": "=js:$vars.buildReport.output.isNiceDay"
        },
        "verdict": {
          "source": "=js:$vars.buildReport.output.verdict"
        }
      }
    },
    {
      "id": "getBellevueWeather1",
      "type": "uipath.connector.custom-codereval-openmeteoapis.getcurrentweather",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Get Bellevue Weather"
      },
      "inputs": {
        "detail": {
          "connector": "custom-codereval-openmeteoapis",
          "connectionId": "21ca654f-b67b-4f97-9eb3-1f93bd3bb5cc",
          "connectionResourceId": "21ca654f-b67b-4f97-9eb3-1f93bd3bb5cc",
          "connectionFolderKey": "5da18ec0-7de1-4e57-aaf1-ddc8a369c199",
          "method": "GET",
          "endpoint": "/forecast",
          "queryParameters": {
            "latitude": 47.6101,
            "longitude": -122.2015,
            "current_weather": true,
            "timezone": "America/Los_Angeles",
            "temperature_unit": "celsius"
          },
          "uiPathActivityTypeId": "e39eee57-b09f-36fb-b131-4f4feb46b707",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"instanceParameters\":{\"connectorKey\":\"custom-codereval-openmeteoapis\",\"objectName\":\"V1Forecast\",\"httpMethod\":\"GETBYID\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"V1Forecast\",\"operation\":\"retrieve\",\"httpMethod\":\"GET\",\"path\":\"/forecast\",\"packageVersion\":\"1.0.0\",\"connectorVersion\":null,\"executionType\":null,\"customFieldsRequestDetails\":null,\"unifiedTypesCompatible\":true}}"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "edge-start-getweather",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "getBellevueWeather1",
