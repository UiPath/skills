{
  "id": "a7a62cbf-e87d-4706-909d-509bfde17de1",
  "version": "1.8",
  "name": "CustomerEscalationTriage",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "23476fbe-a4ff-453e-be3c-3074a0262270",
        "isDefaultEntryPoint": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the workflow.",
          "source": "null",
          "var": "output"
        }
      }
    },
    {
      "id": "checkProductionDown",
      "type": "core.logic.decision",
      "typeVersion": "1.1",
      "display": {
        "label": "Production Down?"
      },
      "inputs": {
        "expression": "$vars.start.output.productionDown === true",
        "trueLabel": "Yes",
        "falseLabel": "No"
      }
    },
    {
      "id": "checkWorkaround",
      "type": "core.logic.decision",
      "typeVersion": "1.1",
      "display": {
        "label": "Workaround Available?"
      },
      "inputs": {
        "expression": "$vars.start.output.workaroundAvailable === true",
        "trueLabel": "Yes",
        "falseLabel": "No"
      }
    },
    {
      "id": "checkEnterprise",
      "type": "core.logic.decision",
      "typeVersion": "1.1",
      "display": {
        "label": "Enterprise Tier?"
      },
      "inputs": {
        "expression": "$vars.start.output.customerTier === \"Enterprise\"",
        "trueLabel": "Yes",
        "falseLabel": "No"
      }
    },
    {
      "id": "classifySev1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Classify Sev1"
      },
      "inputs": {
        "script": "return {\n  severity: \"Sev1\",\n  engineeringNeeded: true,\n  responseMode: \"Draft\",\n  caseKey: $vars.start.output.correlationId\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Sev1 classification result",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "classifySev2",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Classify Sev2"
      },
      "inputs": {
        "script": "return {\n  severity: \"Sev2\",\n  engineeringNeeded: true,\n  responseMode: \"Draft\",\n  caseKey: $vars.start.output.correlationId\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Sev2 classification result",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "classifySev3",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Classify Sev3"
      },
      "inputs": {
        "script": "return {\n  severity: \"Sev3\",\n  engineeringNeeded: false,\n  responseMode: \"Draft\",\n  caseKey: $vars.start.output.correlationId\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Sev3 classification result",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "endSev1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End - Sev1"
      },
      "inputs": {},
      "outputs": {
        "severity": {
          "source": "=js:$vars.classifySev1.output.severity"
        },
        "engineeringNeeded": {
          "source": "=js:$vars.classifySev1.output.engineeringNeeded"
        },
        "responseMode": {
          "source": "=js:$vars.classifySev1.output.responseMode"
        },
        "caseKey": {
          "source": "=js:$vars.classifySev1.output.caseKey"
        }
      }
    },
    {
      "id": "endSev2",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End - Sev2"
      },
      "inputs": {},
      "outputs": {
        "severity": {
          "source": "=js:$vars.classifySev2.output.severity"
        },
        "engineeringNeeded": {
          "source": "=js:$vars.classifySev2.output.engineeringNeeded"
        },
        "responseMode": {
          "source": "=js:$vars.classifySev2.output.responseMode"
        },
        "caseKey": {
          "source": "=js:$vars.classifySev2.output.caseKey"
        }
      }
    },
    {
      "id": "endSev3",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End - Sev3"
      },
      "inputs": {},
      "outputs": {
        "severity": {
          "source": "=js:$vars.classifySev3.output.severity"
        },
        "engineeringNeeded": {
          "source": "=js:$vars.classifySev3.output.engineeringNeeded"
        },
        "responseMode": {
          "source": "=js:$vars.classifySev3.output.responseMode"
        },
        "caseKey": {
          "source": "=js:$vars.classifySev3.output.caseKey"
        }
      }
    }
  ],
  "edges": [
