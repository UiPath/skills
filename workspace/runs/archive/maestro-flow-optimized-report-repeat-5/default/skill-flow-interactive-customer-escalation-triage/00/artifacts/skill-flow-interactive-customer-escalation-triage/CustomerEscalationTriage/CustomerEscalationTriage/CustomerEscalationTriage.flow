        "type": "boolean",
        "description": "Whether the customer's production environment is down",
        "triggerNodeId": "start"
      },
      {
        "id": "workaroundAvailable",
        "direction": "in",
        "type": "boolean",
        "description": "Whether a workaround is available",
        "triggerNodeId": "start"
      },
      {
        "id": "businessImpact",
        "direction": "in",
        "type": "string",
        "description": "The business impact level (e.g. high, medium, low)",
        "triggerNodeId": "start"
      },
      {
        "id": "correlationId",
