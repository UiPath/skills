{
  "id": "06d14f9f-8e54-4240-b580-52940041f1d1",
  "version": "1.8",
  "name": "CustomerEscalationTriage",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "aecf57bc-86d7-49e2-8d35-25e495a3e71d",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "triageScript",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Triage Logic"
      },
      "inputs": {
        "script": "var customerTier = $vars.start.output.customerTier;\nvar productionDown = $vars.start.output.productionDown;\nvar workaroundAvailable = $vars.start.output.workaroundAvailable;\nvar correlationId = $vars.start.output.correlationId;\n\nvar severity;\nif (customerTier === 'enterprise' && productionDown && !workaroundAvailable) {\n  severity = 'Sev1';\n} else if (productionDown) {\n  severity = 'Sev2';\n} else {\n  severity = 'Sev3';\n}\n\nvar engineeringNeeded = severity === 'Sev1' || severity === 'Sev2';\nvar responseMode = 'Draft';\nvar caseKey = correlationId;\n\nreturn { severity: severity, engineeringNeeded: engineeringNeeded, responseMode: responseMode, caseKey: caseKey };"
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Done"
      },
      "inputs": {},
      "outputs": {
        "severity": {
          "source": "=js:$vars.triageScript.output.severity"
        },
        "engineeringNeeded": {
          "source": "=js:$vars.triageScript.output.engineeringNeeded"
        },
        "responseMode": {
          "source": "=js:$vars.triageScript.output.responseMode"
        },
        "caseKey": {
          "source": "=js:$vars.triageScript.output.caseKey"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "e_start_triage",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "triageScript",
      "targetPort": "input"
    },
    {
      "id": "e_triage_end",
      "sourceNodeId": "triageScript",
      "sourcePort": "success",
      "targetNodeId": "end",
      "targetPort": "input"
    }
  ],
  "definitions": [
    {
      "nodeType": "core.trigger.manual",
      "version": "1.0",
      "category": "trigger",
      "description": "Start workflow manually",
      "tags": [
        "trigger",
        "start",
        "manual"
      ],
      "sortOrder": 40,
      "display": {
        "label": "Manual trigger",
        "icon": "play",
        "shape": "circle"
      },
      "handleConfiguration": [
        {
          "position": "right",
          "handles": [
            {
              "id": "output",
              "type": "source",
              "handleType": "output",
              "showButton": true,
              "constraints": {
                "forbiddenTargetCategories": [
                  "trigger"
                ]
              }
            }
          ],
          "visible": true
        }
      ],
      "model": {
