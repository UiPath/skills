        "type": "string",
        "description": "Correlation ID for the escalation case",
        "triggerNodeId": "start"
      },
      {
        "id": "severity",
        "direction": "out",
        "type": "string",
        "description": "Computed severity level: critical, high, medium, or low"
      },
      {
        "id": "engineeringNeeded",
        "direction": "out",
        "type": "boolean",
        "description": "Whether engineering escalation is needed"
      },
      {
        "id": "responseMode",
        "direction": "out",
        "type": "string",
        "description": "Response mode: immediate, urgent, standard, or deferred"
      },
      {
        "id": "caseKey",
        "direction": "out",
        "type": "string",
        "description": "Case key derived from severity and correlationId"
      }
