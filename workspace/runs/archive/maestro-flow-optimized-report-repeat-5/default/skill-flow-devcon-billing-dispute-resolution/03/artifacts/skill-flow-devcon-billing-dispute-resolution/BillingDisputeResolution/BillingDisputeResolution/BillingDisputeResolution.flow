    {
      "id": "extractInvoice",
      "type": "uipath.ixp.invoices-billing-f0c606f9-ixp.99f5bbfa-5f29-8033-8662-25001b6bb18e-79a7d12e-da84-4bf4-ab60-7f34b44dd178",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Invoice Extraction (IxP)"
      },
      "inputs": {
        "model": {
          "id": "99f5bbfa-5f29-8033-8662-25001b6bb18e",
          "modelName": "invoices-billing-f0c606f9-ixp",
          "modelDisplayName": "invoices-billing",
          "folderKey": "79a7d12e-da84-4bf4-ab60-7f34b44dd178",
          "folderName": "Shared/uipath-maestro-flow/BillingDispute",
          "folderPath": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c.5da18ec0-7de1-4e57-aaf1-ddc8a369c199.79a7d12e-da84-4bf4-ab60-7f34b44dd178",
          "description": ""
        },
        "modelName": "invoices-billing-f0c606f9-ixp",
        "projectName": "invoices-billing-f0c606f9-ixp",
        "folderKey": "79a7d12e-da84-4bf4-ab60-7f34b44dd178",
        "folderName": "Shared/uipath-maestro-flow/BillingDispute",
        "versionTag": "",
        "pageRange": "",
        "fileRef": "=js:$vars.start.output.disputedInvoice"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Extraction result",
          "source": "=this.result",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if extraction fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "normalizeData",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Normalize Data"
      },
      "inputs": {
        "script": "var fields = ($vars.extractInvoice.output && $vars.extractInvoice.output.ExtractionResult && $vars.extractInvoice.output.ExtractionResult.ResultsDocument && $vars.extractInvoice.output.ExtractionResult.ResultsDocument.Fields) ? $vars.extractInvoice.output.ExtractionResult.ResultsDocument.Fields : [];\nvar normalized = fields.map(function(f) {\n  return {\n    Id: f.FieldId || '',\n    Name: f.FieldName || '',\n    Value: (f.Values && f.Values.length > 0) ? f.Values[0] : null,\n    Type: f.FieldType || '',\n    IsMissing: f.IsMissing || false,\n    Confidence: f.Confidence || 0\n  };\n});\nreturn { fields: normalized };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Normalized field projection",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "crmLookup1",
      "type": "uipath.connector.uipath-uipath-dataservice.query-entity-records",
      "typeVersion": "1.0.0",
      "display": {
        "label": "CRM Lookup"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-uipath-dataservice",
          "connectionId": "d61e5d0e-04af-4f93-95cc-151d81fa08dc",
          "connectionResourceId": "d61e5d0e-04af-4f93-95cc-151d81fa08dc",
          "connectionFolderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "method": "POST",
          "endpoint": "/v2/{entityName}/qer",
          "pathParameters": {
            "entityName": "BillingDisputeCRM"
          },
          "uiPathActivityTypeId": "703065b9-a310-33b8-9d4d-12df0a6f520b",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"instanceParameters\":{\"connectorKey\":\"uipath-uipath-dataservice\",\"objectName\":\"QueryEntityRecordsCurated\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"QueryEntityRecordsCurated\",\"operation\":\"list\",\"httpMethod\":\"POST\",\"path\":\"/v2/{entityName}/qer\",\"packageVersion\":\"1.0.0\",\"connectorVersion\":null,\"executionType\":null,\"customFieldsRequestDetails\":null,\"unifiedTypesCompatible\":true,\"savedFilterTrees\":{\"queryExpression\":{\"filters\":[{\"id\":\"accountNumber\",\"operator\":\"Equals\",\"value\":{\"value\":\"$vars.start.output.webhookPayload.customer.accountNumber\",\"isLiteral\":false}}],\"groupOperator\":0}}}}",
          "inputMetadata": {
            "operation": "list",
            "pagination": {
              "maxPageSize": 1000
            }
          },
          "queryParameters": {
            "queryExpression": "=js:`accountNumber = '${($vars.start.output.webhookPayload && $vars.start.output.webhookPayload.customer && $vars.start.output.webhookPayload.customer.accountNumber) ? $vars.start.output.webhookPayload.customer.accountNumber : ''}'`"
          }
        }
      }
    },
    {
      "id": "erpLookup1",
      "type": "uipath.connector.uipath-uipath-dataservice.query-entity-records",
      "typeVersion": "1.0.0",
      "display": {
        "label": "ERP Lookup"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-uipath-dataservice",
          "connectionId": "d61e5d0e-04af-4f93-95cc-151d81fa08dc",
          "connectionResourceId": "d61e5d0e-04af-4f93-95cc-151d81fa08dc",
          "connectionFolderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "method": "POST",
          "endpoint": "/v2/{entityName}/qer",
          "pathParameters": {
            "entityName": "BillingDisputeERP"
          },
          "uiPathActivityTypeId": "703065b9-a310-33b8-9d4d-12df0a6f520b",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"instanceParameters\":{\"connectorKey\":\"uipath-uipath-dataservice\",\"objectName\":\"QueryEntityRecordsCurated\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"QueryEntityRecordsCurated\",\"operation\":\"list\",\"httpMethod\":\"POST\",\"path\":\"/v2/{entityName}/qer\",\"packageVersion\":\"1.0.0\",\"connectorVersion\":null,\"executionType\":null,\"customFieldsRequestDetails\":null,\"unifiedTypesCompatible\":true,\"savedFilterTrees\":{\"queryExpression\":{\"filters\":[{\"id\":\"invoiceNumber\",\"operator\":\"Equals\",\"value\":{\"value\":\"(() => { var inv = ($vars.start.output.webhookPayload && $vars.start.output.webhookPayload.invoice && $vars.start.output.webhookPayload.invoice.invoiceNumber) ? String($vars.start.output.webhookPayload.invoice.invoiceNumber) : ''; var norm = inv.trim().toUpperCase(); if (!norm.startsWith('MCS-')) norm = 'MCS-' + norm; return norm; })()\",\"isLiteral\":false}}],\"groupOperator\":0}}}}",
          "inputMetadata": {
            "operation": "list",
            "pagination": {
              "maxPageSize": 1000
            }
          },
          "queryParameters": {
            "queryExpression": "=js:(() => { var inv = ($vars.start.output.webhookPayload && $vars.start.output.webhookPayload.invoice && $vars.start.output.webhookPayload.invoice.invoiceNumber) ? String($vars.start.output.webhookPayload.invoice.invoiceNumber) : ''; var norm = inv.trim().toUpperCase(); if (!norm.startsWith('MCS-')) norm = 'MCS-' + norm; return `invoiceNumber = '${norm}'`; })()"
          }
        }
      }
    },
    {
      "id": "mergeLookups",
      "type": "core.logic.merge",
      "typeVersion": "1.0",
      "display": {
        "label": "Merge"
      },
      "inputs": {}
    },
    {
      "id": "detectDiscrepancies",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Discrepancy Detection"
      },
      "inputs": {
        "script": "var disputedItems = ($vars.start.output.webhookPayload && $vars.start.output.webhookPayload.dispute && $vars.start.output.webhookPayload.dispute.disputedLineItems) ? $vars.start.output.webhookPayload.dispute.disputedLineItems : [];\nvar erpRecords = ($vars.erpLookup1.output && $vars.erpLookup1.output.value) ? $vars.erpLookup1.output.value : [];\nvar mismatches = [];\nvar totalOvercharge = 0;\nvar totalUndercharge = 0;\ndisputedItems.forEach(function(item) {\n  var erpRow = erpRecords.find(function(r) { return String(r.lineNumber) === String(item.lineNumber); });\n  if (erpRow) {\n    var contractPrice = erpRow.unitPrice || 0;\n    var billedPrice = item.unitPrice || 0;\n    var diff = (billedPrice - contractPrice) * (item.quantity || 1);\n    if (diff !== 0) {\n      mismatches.push({\n        lineNumber: item.lineNumber,\n        description: item.description,\n        quantity: item.quantity,\n        billedUnitPrice: billedPrice,\n        contractUnitPrice: contractPrice,\n        billedAmount: item.amount,\n        contractAmount: contractPrice * (item.quantity || 1),\n        variance: diff\n      });\n      if (diff > 0) totalOvercharge += diff;\n      else totalUndercharge += Math.abs(diff);\n    }\n  }\n});\nreturn { mismatches: mismatches, totalOvercharge: totalOvercharge, totalUndercharge: totalUndercharge };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Discrepancy detection results",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "disputeAnalystAgent",
      "type": "uipath.agent.autonomous",
      "typeVersion": "1.2",
      "display": {
        "label": "Dispute Analyst Agent"
      },
      "inputs": {
        "systemPrompt": "You are a billing dispute analyst. Analyze the invoice data, CRM and ERP records, and discrepancy summary to produce a structured determination.",
        "userPrompt": "Analyze the billing dispute and return a structured JSON determination.",
        "source": "9115702c-f03e-4fae-85d1-f3037172a364",
        "agentInputVariables": [
          {
            "id": "start__output__webhookPayload",
            "type": "object",
            "binding": "=$vars.start.output.webhookPayload",
            "description": "Billing dispute webhook payload"
          },
          {
            "id": "normalizeData__output__fields",
            "type": "array",
            "binding": "=$vars.normalizeData.output.fields",
            "description": "Normalized invoice fields from IxP extraction"
          },
          {
            "id": "crmLookup1__output__value",
            "type": "object",
            "binding": "=$vars.crmLookup1.output",
            "description": "CRM customer account records"
          },
          {
            "id": "erpLookup1__output__value",
            "type": "object",
            "binding": "=$vars.erpLookup1.output",
            "description": "ERP contract/invoice records"
          },
          {
            "id": "detectDiscrepancies__output__mismatches",
            "type": "array",
            "binding": "=$vars.detectDiscrepancies.output.mismatches",
            "description": "Detected line item pricing discrepancies"
          },
          {
            "id": "detectDiscrepancies__output__totalOvercharge",
            "type": "number",
            "binding": "=$vars.detectDiscrepancies.output.totalOvercharge",
            "description": "Total overcharge amount"
          },
          {
            "id": "detectDiscrepancies__output__totalUndercharge",
            "type": "number",
            "binding": "=$vars.detectDiscrepancies.output.totalUndercharge",
            "description": "Total undercharge amount"
          }
        ],
        "agentOutputVariables": [
          {
            "id": "determination",
            "type": "string"
          },
          {
            "id": "recommendedAction",
            "type": "string"
          },
          {
            "id": "autoResolutionEligible",
            "type": "boolean"
          },
          {
            "id": "creditAmount",
            "type": "number"
          },
          {
            "id": "confidence",
            "type": "number"
          },
          {
            "id": "rationale",
            "type": "string"
          }
        ]
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Agent determination output",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the agent fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "contextBillingDisputeSOP",
      "type": "uipath.agent.resource.context.index.billing-dispute-sop-index.cc45b9b4-dbf6-47b3-40ac-08debc0cec5b",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Billing Dispute SOP Index"
      },
      "inputs": {
        "source": "b7f2a3c1-4e8d-4f9a-8b2e-c1d3e5f7a9b2"
      }
    },
    {
      "id": "routeOnAction",
      "type": "core.logic.switch",
      "typeVersion": "1.1",
      "display": {
        "label": "Switch on recommendedAction"
      },
      "inputs": {
        "cases": [
          {
            "id": "escalate",
            "label": "escalate_to_manager",
            "expression": "$vars.disputeAnalystAgent.output.recommendedAction === 'escalate_to_manager'"
          },
          {
            "id": "autoResolve",
            "label": "auto_resolve",
            "expression": "$vars.disputeAnalystAgent.output.recommendedAction === 'auto_resolve'"
          },
          {
            "id": "reject",
            "label": "reject",
            "expression": "$vars.disputeAnalystAgent.output.recommendedAction === 'reject'"
          }
        ]
      }
    },
    {
      "id": "approvalDecision",
      "type": "core.logic.decision",
      "typeVersion": "1.1",
      "display": {
        "label": "Approval Decision"
      },
      "inputs": {
        "expression": "=js:false",
        "trueLabel": "Rejected",
        "falseLabel": "Approved"
      }
    },
    {
      "id": "logCreditAmount",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log Credit Amount"
      },
      "inputs": {
        "script": "var credit = $vars.disputeAnalystAgent.output.creditAmount;\nreturn { creditAmount: credit };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Credit amount for auto-resolve path",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "financialPosting",
      "type": "uipath.core.api-workflow.07d45a91-9413-4dad-82ff-28306c2d85ea",
      "typeVersion": "1.0.0",
      "display": {
        "label": "FinancialPostingFunction"
      },
      "inputs": {
        "invoiceNumber": "=js:$vars.start.output.webhookPayload && $vars.start.output.webhookPayload.invoice ? $vars.start.output.webhookPayload.invoice.invoiceNumber : ''"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the API workflow",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the API workflow fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "resolutionWriterAgent",
      "type": "uipath.agent.autonomous",
      "typeVersion": "1.2",
      "display": {
        "label": "Resolution Writer Agent"
      },
      "inputs": {
        "systemPrompt": "You are a customer resolution specialist. Draft professional customer-facing resolution emails for billing disputes.",
        "userPrompt": "Draft the resolution email for this billing dispute.",
        "source": "0504529f-562c-4ba3-9c34-89e3c53e67bb",
        "agentInputVariables": [
          {
            "id": "start__output__webhookPayload",
            "type": "object",
            "binding": "=$vars.start.output.webhookPayload",
            "description": "Billing dispute webhook payload with customer and invoice details"
          },
          {
            "id": "disputeAnalystAgent__output__determination",
            "type": "string",
            "binding": "=$vars.disputeAnalystAgent.output.determination",
            "description": "Analyst determination"
          },
          {
            "id": "disputeAnalystAgent__output__creditAmount",
            "type": "number",
            "binding": "=$vars.disputeAnalystAgent.output.creditAmount",
            "description": "Approved credit amount"
          },
          {
            "id": "disputeAnalystAgent__output__rationale",
            "type": "string",
            "binding": "=$vars.disputeAnalystAgent.output.rationale",
            "description": "Analyst rationale"
          }
        ],
        "agentOutputVariables": [
          {
            "id": "subject",
            "type": "string"
          },
          {
            "id": "body",
            "type": "string"
          }
        ]
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Resolution email subject and body",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the agent fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "endResolution",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Return Resolution"
      },
      "inputs": {},
      "outputs": {
        "determination": {
          "source": "=js:$vars.disputeAnalystAgent.output.determination"
        },
        "recommendedAction": {
          "source": "=js:$vars.disputeAnalystAgent.output.recommendedAction"
        },
        "creditAmount": {
          "source": "=js:$vars.disputeAnalystAgent.output.creditAmount"
        },
        "rationale": {
          "source": "=js:$vars.disputeAnalystAgent.output.rationale"
        },
        "resolutionEmailBody": {
          "source": "=js:$vars.resolutionWriterAgent.output.body"
        }
      }
    },
    {
      "id": "endManagerRejection",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Return Manager Rejection"
      },
      "inputs": {},
      "outputs": {
        "determination": {
          "source": "=js:$vars.disputeAnalystAgent.output.determination"
        },
        "recommendedAction": {
          "source": "=js:$vars.disputeAnalystAgent.output.recommendedAction"
        },
        "creditAmount": {
          "source": "=js:$vars.disputeAnalystAgent.output.creditAmount"
        },
        "rationale": {
          "source": "=js:$vars.disputeAnalystAgent.output.rationale"
        },
        "resolutionEmailBody": {
          "source": "=js:'No resolution email drafted — dispute rejected by manager.'"
        }
      }
    },
    {
      "id": "endRejection",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Return Rejection"
      },
      "inputs": {},
      "outputs": {
        "determination": {
          "source": "=js:$vars.disputeAnalystAgent.output.determination"
        },
        "recommendedAction": {
          "source": "=js:$vars.disputeAnalystAgent.output.recommendedAction"
        },
        "creditAmount": {
          "source": "=js:$vars.disputeAnalystAgent.output.creditAmount"
        },
        "rationale": {
          "source": "=js:$vars.disputeAnalystAgent.output.rationale"
        },
        "resolutionEmailBody": {
          "source": "=js:'No resolution email drafted — dispute rejected.'"
        }
      }
    }
  ],
  "edges": [
