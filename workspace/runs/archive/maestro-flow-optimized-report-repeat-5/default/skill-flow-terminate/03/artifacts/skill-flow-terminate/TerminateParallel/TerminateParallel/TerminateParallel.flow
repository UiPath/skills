          "var": "output"
        }
      }
    },
    {
      "id": "terminateBranchA",
      "type": "core.logic.terminate",
      "typeVersion": "1.0",
      "display": {
        "label": "Terminate (Branch A)"
      },
      "inputs": {}
    },
    {
      "id": "delayBranchB",
      "type": "core.logic.delay",
      "typeVersion": "1.0",
      "display": {
        "label": "Wait 10 Seconds (Branch B)"
      },
      "inputs": {
        "timerType": "timeDuration",
        "timerPreset": "custom",
        "timerValue": "PT10S"
      }
    },
    {
      "id": "scriptOutputDone",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Output done (Branch B)"
      },
      "inputs": {
        "script": "return { message: \"done\" };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "endBranchB",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End (Branch B)"
      },
      "inputs": {}
    }
  ],
  "edges": [
    {
      "id": "edge-start-terminate",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "terminateBranchA",
      "targetPort": "input"
    },
    {
      "id": "edge-start-delay",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "delayBranchB",
      "targetPort": "input"
    },
    {
      "id": "edge-delay-script",
      "sourceNodeId": "delayBranchB",
