{
  "id": "97a0b196-0e58-4aa3-aaf8-7d51a0b31e6d",
  "version": "1.8",
  "name": "BillingInvoiceLookup",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "5c38fdee-657d-4069-910a-85f477cffad3",
        "isDefaultEntryPoint": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the workflow.",
          "source": "null",
          "var": "output"
        }
      }
    },
    {
      "id": "normalizeInvoice",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Normalize Invoice Number"
      },
      "inputs": {
        "script": "var raw = $vars.start.output.invoiceNumber;\nvar trimmed = (raw || '').trim().toUpperCase();\nvar normalized = trimmed.startsWith('MCS-') ? trimmed : ('MCS-' + trimmed);\nreturn { normalizedInvoiceNumber: normalized };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "queryBillingdisputeerp1",
      "type": "uipath.connector.uipath-uipath-dataservice.query-entity-records",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Query BillingDisputeERP"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-uipath-dataservice",
          "connectionId": "d61e5d0e-04af-4f93-95cc-151d81fa08dc",
          "connectionResourceId": "d61e5d0e-04af-4f93-95cc-151d81fa08dc",
          "connectionFolderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "method": "POST",
          "endpoint": "/v2/{entityName}/qer",
          "pathParameters": {
            "entityName": "BillingDisputeERP"
          },
          "uiPathActivityTypeId": "703065b9-a310-33b8-9d4d-12df0a6f520b",
          "errorState": {
            "issues": []
          },
          "queryParameters": {
            "queryExpression": "=js:\"invoiceNumber = '\" + $vars.normalizeInvoice.output.normalizedInvoiceNumber + \"'\""
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"instanceParameters\":{\"connectorKey\":\"uipath-uipath-dataservice\",\"objectName\":\"QueryEntityRecordsCurated\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"QueryEntityRecordsCurated\",\"operation\":\"list\",\"httpMethod\":\"POST\",\"path\":\"/v2/{entityName}/qer\",\"packageVersion\":\"1.0.0\",\"connectorVersion\":null,\"executionType\":null,\"customFieldsRequestDetails\":{\"objectActionName\":\"GenerateSchema\",\"parameterValues\":[[\"entityName\",\"BillingDisputeERP\"]]},\"savedFilterTrees\":{\"queryExpression\":{\"groupOperator\":0,\"index\":0,\"filters\":[{\"id\":\"invoiceNumber\",\"operator\":\"Equals\",\"value\":{\"value\":\"MCS-\",\"rawString\":\"\\\"MCS-\\\"\",\"isLiteral\":true}}],\"groups\":[]}},\"unifiedTypesCompatible\":true}}",
          "inputMetadata": {
            "operation": "list",
            "pagination": {
              "maxPageSize": 1000
            }
          }
        }
      }
    },
    {
      "id": "extractResults",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Extract Results"
      },
      "inputs": {
        "script": "var output = $vars.queryBillingdisputeerp1.output;\nvar records;\nif (Array.isArray(output)) {\n  records = output;\n} else if (output && Array.isArray(output.value)) {\n  records = output.value;\n} else if (output && Array.isArray(output.records)) {\n  records = output.records;\n} else if (output && Array.isArray(output.items)) {\n  records = output.items;\n} else {\n  records = [];\n}\nvar count = records.length;\nvar firstInvoice = (count > 0 && records[0] && records[0].invoiceNumber) ? records[0].invoiceNumber : '';\nreturn { matchedInvoiceNumber: firstInvoice, lineItemCount: count };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "end1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {},
      "outputs": {
        "matchedInvoiceNumber": {
          "source": "=js:$vars.extractResults.output.matchedInvoiceNumber"
        },
        "lineItemCount": {
          "source": "=js:$vars.extractResults.output.lineItemCount"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "normalizeInvoice",
