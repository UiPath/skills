    {
      "id": "buildSapPayload1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Build SAP Payload"
      },
      "inputs": {
        "language": "javascript",
        "script": "const fields = ($vars.extractInvoiceFields1.output && $vars.extractInvoiceFields1.output.ExtractionResult && $vars.extractInvoiceFields1.output.ExtractionResult.ResultsDocument && $vars.extractInvoiceFields1.output.ExtractionResult.ResultsDocument.Fields) ? $vars.extractInvoiceFields1.output.ExtractionResult.ResultsDocument.Fields : [];\nconst tables = ($vars.extractInvoiceFields1.output && $vars.extractInvoiceFields1.output.ExtractionResult && $vars.extractInvoiceFields1.output.ExtractionResult.ResultsDocument && $vars.extractInvoiceFields1.output.ExtractionResult.ResultsDocument.Tables) ? $vars.extractInvoiceFields1.output.ExtractionResult.ResultsDocument.Tables : [];\nconst getField = (name) => { const f = fields.find(function(x) { return x.FieldName === name; }); return f && f.Values && f.Values.length > 0 ? f.Values[0] : null; };\nconst lineItems = tables.length > 0 && tables[0].Values ? tables[0].Values.map(function(row) { const cells = row.Cells || []; const info = row.ColumnInfo || []; return cells.reduce(function(acc, cell) { const col = info[cell.ColumnIndex]; const colName = col ? col.FieldName : ('col' + cell.ColumnIndex); const val = cell.Values && cell.Values[0] ? cell.Values[0].Value : null; acc[colName] = val; return acc; }, {}); }) : [];\nreturn { sapPayload: { invoiceNumber: getField('InvoiceNumber') || getField('Invoice Number') || getField('invoice_number'), vendor: getField('VendorName') || getField('Vendor Name') || getField('vendor') || getField('Vendor'), invoiceDate: getField('InvoiceDate') || getField('Invoice Date') || getField('invoice_date'), totalAmount: getField('TotalAmount') || getField('Total Amount') || getField('total_amount') || getField('InvoiceTotal') || getField('Invoice Total'), lineItems: lineItems } };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
