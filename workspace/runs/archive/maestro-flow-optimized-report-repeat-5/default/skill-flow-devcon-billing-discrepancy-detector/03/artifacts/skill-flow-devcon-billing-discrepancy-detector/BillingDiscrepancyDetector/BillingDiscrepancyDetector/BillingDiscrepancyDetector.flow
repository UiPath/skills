    {
      "id": "queryErpRecords1",
      "type": "uipath.connector.uipath-uipath-dataservice.query-entity-records",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Query ERP Records"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-uipath-dataservice",
          "connectionId": "d61e5d0e-04af-4f93-95cc-151d81fa08dc",
          "connectionResourceId": "d61e5d0e-04af-4f93-95cc-151d81fa08dc",
          "connectionFolderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "method": "POST",
          "endpoint": "/v2/{entityName}/qer",
          "pathParameters": {
            "entityName": "BillingDisputeERP"
          },
          "queryParameters": {
            "queryExpression": "=js:`invoiceNumber = '${$vars.start.output.invoiceNumber}'`"
          },
          "uiPathActivityTypeId": "703065b9-a310-33b8-9d4d-12df0a6f520b",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"instanceParameters\":{\"connectorKey\":\"uipath-uipath-dataservice\",\"objectName\":\"QueryEntityRecordsCurated\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"QueryEntityRecordsCurated\",\"operation\":\"list\",\"httpMethod\":\"POST\",\"path\":\"/v2/{entityName}/qer\",\"packageVersion\":\"1.0.0\",\"connectorVersion\":null,\"executionType\":null,\"customFieldsRequestDetails\":{\"objectActionName\":\"GenerateSchema\",\"parameterValues\":[[\"entityName\",\"BillingDisputeERP\"]]},\"unifiedTypesCompatible\":true}}",
          "inputMetadata": {
            "operation": "list",
            "pagination": {
              "maxPageSize": 1000
            }
          }
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the connector.",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "queryCrmRecord1",
      "type": "uipath.connector.uipath-uipath-dataservice.query-entity-records",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Query CRM Record"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-uipath-dataservice",
          "connectionId": "d61e5d0e-04af-4f93-95cc-151d81fa08dc",
          "connectionResourceId": "d61e5d0e-04af-4f93-95cc-151d81fa08dc",
          "connectionFolderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "method": "POST",
          "endpoint": "/v2/{entityName}/qer",
          "pathParameters": {
            "entityName": "BillingDisputeCRM"
          },
          "queryParameters": {
            "queryExpression": "=js:`accountNumber = '${$vars.start.output.accountNumber}'`"
          },
          "uiPathActivityTypeId": "703065b9-a310-33b8-9d4d-12df0a6f520b",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"instanceParameters\":{\"connectorKey\":\"uipath-uipath-dataservice\",\"objectName\":\"QueryEntityRecordsCurated\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"QueryEntityRecordsCurated\",\"operation\":\"list\",\"httpMethod\":\"POST\",\"path\":\"/v2/{entityName}/qer\",\"packageVersion\":\"1.0.0\",\"connectorVersion\":null,\"executionType\":null,\"customFieldsRequestDetails\":{\"objectActionName\":\"GenerateSchema\",\"parameterValues\":[[\"entityName\",\"BillingDisputeCRM\"]]},\"unifiedTypesCompatible\":true}}",
          "inputMetadata": {
            "operation": "list",
            "pagination": {
              "maxPageSize": 1000
            }
          }
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the connector.",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "mergeBranches",
      "type": "core.logic.merge",
      "typeVersion": "1.0",
      "display": {
        "label": "Merge Branches"
      },
      "inputs": {}
    },
    {
      "id": "computeResult",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Compute Result"
      },
      "inputs": {
        "script": "var erpRows = ($vars.queryErpRecords1.output && $vars.queryErpRecords1.output.value) ? $vars.queryErpRecords1.output.value : [];\nvar crmRows = ($vars.queryCrmRecord1.output && $vars.queryCrmRecord1.output.value) ? $vars.queryCrmRecord1.output.value : [];\nvar disputedLineNumber = $vars.start.output.disputedLineNumber;\nvar disputedUnitPrice = $vars.start.output.disputedUnitPrice;\nvar disputedQuantity = $vars.start.output.disputedQuantity;\nvar invoiced = disputedUnitPrice * disputedQuantity;\nvar matchedRow = erpRows.find(function(r) { return r.lineNumber === disputedLineNumber; });\nvar contracted = matchedRow ? matchedRow.amount : 0;\nvar diff = invoiced - contracted;\nvar totalOvercharge = diff > 0 ? diff : 0;\nvar discrepancyCount = totalOvercharge > 0 ? 1 : 0;\nvar matchedInvoiceNumber = erpRows.length > 0 && erpRows[0].invoiceNumber ? erpRows[0].invoiceNumber : $vars.start.output.invoiceNumber;\nvar accountTier = crmRows.length > 0 && crmRows[0].accountTier ? crmRows[0].accountTier : '';\nreturn { totalOvercharge: totalOvercharge, discrepancyCount: discrepancyCount, matchedInvoiceNumber: matchedInvoiceNumber, accountTier: accountTier };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {},
      "outputs": {
        "totalOvercharge": {
          "source": "=js:$vars.computeResult.output.totalOvercharge"
        },
        "discrepancyCount": {
          "source": "=js:$vars.computeResult.output.discrepancyCount"
        },
        "matchedInvoiceNumber": {
          "source": "=js:$vars.computeResult.output.matchedInvoiceNumber"
        },
        "accountTier": {
          "source": "=js:$vars.computeResult.output.accountTier"
        }
      }
    }
  ],
