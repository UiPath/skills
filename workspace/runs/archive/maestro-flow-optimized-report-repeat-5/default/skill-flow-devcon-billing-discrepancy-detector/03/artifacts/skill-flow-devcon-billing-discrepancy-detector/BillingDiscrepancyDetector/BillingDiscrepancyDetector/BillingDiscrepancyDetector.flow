{
  "id": "0efbe87a-ffb6-4724-bbf1-845a42f2d961",
  "version": "1.8",
  "name": "BillingDiscrepancyDetector",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
