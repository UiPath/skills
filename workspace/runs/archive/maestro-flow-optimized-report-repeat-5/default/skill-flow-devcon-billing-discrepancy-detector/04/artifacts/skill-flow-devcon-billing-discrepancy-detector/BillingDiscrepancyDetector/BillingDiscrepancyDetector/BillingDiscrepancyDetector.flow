    {
      "id": "queryErpRecords1",
      "type": "uipath.connector.uipath-uipath-dataservice.query-entity-records",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Query ERP Records"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-uipath-dataservice",
          "connectionId": "d61e5d0e-04af-4f93-95cc-151d81fa08dc",
          "connectionResourceId": "d61e5d0e-04af-4f93-95cc-151d81fa08dc",
          "connectionFolderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "method": "POST",
          "endpoint": "/v2/{entityName}/qer",
          "pathParameters": {
            "entityName": "BillingDisputeERP"
          },
          "uiPathActivityTypeId": "703065b9-a310-33b8-9d4d-12df0a6f520b",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"instanceParameters\":{\"connectorKey\":\"uipath-uipath-dataservice\",\"objectName\":\"QueryEntityRecordsCurated\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"QueryEntityRecordsCurated\",\"operation\":\"list\",\"httpMethod\":\"POST\",\"path\":\"/v2/{entityName}/qer\",\"packageVersion\":\"1.0.0\",\"connectorVersion\":null,\"executionType\":null,\"customFieldsRequestDetails\":{\"objectActionName\":\"FetchObjectMetadataTenant\",\"parameterValues\":[[\"entityName\",\"BillingDisputeERP\"]]},\"unifiedTypesCompatible\":true}}",
          "inputMetadata": {
            "operation": "list",
            "pagination": {
              "maxPageSize": 1000
            }
          }
        }
      }
    },
    {
      "id": "queryCrmAccount1",
      "type": "uipath.connector.uipath-uipath-dataservice.query-entity-records",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Query CRM Account"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-uipath-dataservice",
          "connectionId": "d61e5d0e-04af-4f93-95cc-151d81fa08dc",
          "connectionResourceId": "d61e5d0e-04af-4f93-95cc-151d81fa08dc",
          "connectionFolderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "method": "POST",
          "endpoint": "/v2/{entityName}/qer",
          "pathParameters": {
            "entityName": "BillingDisputeCRM"
          },
          "uiPathActivityTypeId": "703065b9-a310-33b8-9d4d-12df0a6f520b",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"instanceParameters\":{\"connectorKey\":\"uipath-uipath-dataservice\",\"objectName\":\"QueryEntityRecordsCurated\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"QueryEntityRecordsCurated\",\"operation\":\"list\",\"httpMethod\":\"POST\",\"path\":\"/v2/{entityName}/qer\",\"packageVersion\":\"1.0.0\",\"connectorVersion\":null,\"executionType\":null,\"customFieldsRequestDetails\":{\"objectActionName\":\"FetchObjectMetadataTenant\",\"parameterValues\":[[\"entityName\",\"BillingDisputeCRM\"]]},\"unifiedTypesCompatible\":true}}",
          "inputMetadata": {
            "operation": "list",
            "pagination": {
              "maxPageSize": 1000
            }
          }
        }
      }
    },
    {
      "id": "mergeResults",
      "type": "core.logic.merge",
      "typeVersion": "1.0",
      "display": {
        "label": "Merge Lookups"
      },
      "inputs": {}
    },
    {
      "id": "computeResult",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Compute Discrepancy"
      },
      "inputs": {
        "script": "var erpBody = $vars.queryErpRecords1.output.body;\nvar erpRows = Array.isArray(erpBody) ? erpBody : (erpBody && Array.isArray(erpBody.value) ? erpBody.value : []);\nvar crmBody = $vars.queryCrmAccount1.output.body;\nvar crmRows = Array.isArray(crmBody) ? crmBody : (crmBody && Array.isArray(crmBody.value) ? crmBody.value : []);\nvar disputedLineNumber = $vars.start.output.disputedLineNumber;\nvar disputedUnitPrice = $vars.start.output.disputedUnitPrice;\nvar disputedQuantity = $vars.start.output.disputedQuantity;\nvar invoiced = disputedUnitPrice * disputedQuantity;\nvar matchedRow = null;\nfor (var i = 0; i < erpRows.length; i++) {\n  if (erpRows[i].lineNumber == disputedLineNumber) { matchedRow = erpRows[i]; break; }\n}\nvar contracted = matchedRow ? matchedRow.amount : 0;\nvar diff = invoiced - contracted;\nvar totalOvercharge = diff > 0 ? diff : 0;\nvar discrepancyCount = totalOvercharge > 0 ? 1 : 0;\nvar matchedInvoiceNumber = erpRows.length > 0 ? (erpRows[0].invoiceNumber || '') : '';\nvar crmRow = crmRows.length > 0 ? crmRows[0] : null;\nvar accountTier = crmRow ? (crmRow.accountTier || '') : '';\nreturn { totalOvercharge: totalOvercharge, discrepancyCount: discrepancyCount, matchedInvoiceNumber: matchedInvoiceNumber, accountTier: accountTier };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "end1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {},
      "outputs": {
        "totalOvercharge": {
          "source": "=js:$vars.computeResult.output.totalOvercharge"
        },
        "discrepancyCount": {
          "source": "=js:$vars.computeResult.output.discrepancyCount"
        },
        "matchedInvoiceNumber": {
          "source": "=js:$vars.computeResult.output.matchedInvoiceNumber"
        },
        "accountTier": {
          "source": "=js:$vars.computeResult.output.accountTier"
        }
      }
    }
  ],
