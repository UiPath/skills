{
  "id": "a871fb8a-24df-4e3b-91d9-fc8dbd6280a1",
  "version": "1.8",
  "name": "LeaveRequest",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "a8f84345-ef21-4abc-92c1-1e5e44b45c0b",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "managerReview1",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "Manager Review"
      },
      "inputs": {
        "title": "Leave Request Review",
        "recipient": {
          "channels": ["Email", "ActionCenter"],
          "connections": {},
          "assignee": { "type": "group" }
        },
        "priority": "Low",
        "schema": {
          "schemaId": "d99ffc4d-f806-46ab-8901-b620dd997d61",
          "fields": [
            {
              "id": "employeename",
              "label": "Employee Name",
              "type": "string",
              "direction": "input",
              "binding": "vars.start.output.employeeName"
            },
            {
              "id": "numberofdays",
              "label": "Number of Days",
              "type": "number",
              "direction": "input",
              "binding": "vars.start.output.numberOfDays"
            },
            {
              "id": "approved",
              "label": "Approved",
              "type": "boolean",
              "direction": "output",
              "variable": "vars.approved",
              "required": true
            }
          ],
          "outcomes": [
            { "id": "approve", "name": "Approve", "type": "string", "isPrimary": true, "action": "Continue" },
            { "id": "reject",  "name": "Reject",  "type": "string", "isPrimary": false, "action": "End" }
          ]
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "approved": { "type": "boolean" },
            "Action":   { "type": "string", "enum": ["Approve", "Reject"], "default": "Approve" }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": ["Approve", "Reject"],
          "default": "Approve"
        }
      }
    },
    {
      "id": "approvalDecision1",
      "type": "core.logic.decision",
      "typeVersion": "1.1",
      "display": {
        "label": "Approved?"
      },
      "inputs": {
        "expression": "$vars.managerReview1.output.approved === true",
        "trueLabel": "Approved",
        "falseLabel": "Rejected"
      }
    },
    {
      "id": "logApproved1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log Approved"
      },
      "inputs": {
        "script": "console.log('Leave approved');\nreturn { message: 'Leave approved' };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "logRejected1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log Rejected"
      },
      "inputs": {
        "script": "console.log('Leave rejected');\nreturn { message: 'Leave rejected' };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "end1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End (Approved)"
      },
      "inputs": {}
    },
    {
      "id": "end2",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End (Rejected)"
      },
      "inputs": {}
    }
  ],
  "edges": [
    {
      "id": "start-output-managerReview1-input",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "managerReview1",
      "targetPort": "input"
    },
    {
      "id": "managerReview1-completed-approvalDecision1-input",
      "sourceNodeId": "managerReview1",
      "sourcePort": "completed",
      "targetNodeId": "approvalDecision1",
      "targetPort": "input"
    },
    {
      "id": "approvalDecision1-true-logApproved1-input",
      "sourceNodeId": "approvalDecision1",
      "sourcePort": "true",
      "targetNodeId": "logApproved1",
      "targetPort": "input"
    },
    {
      "id": "approvalDecision1-false-logRejected1-input",
      "sourceNodeId": "approvalDecision1",
      "sourcePort": "false",
      "targetNodeId": "logRejected1",
      "targetPort": "input"
    },
    {
      "id": "logApproved1-success-end1-input",
      "sourceNodeId": "logApproved1",
      "sourcePort": "success",
      "targetNodeId": "end1",
      "targetPort": "input"
    },
    {
      "id": "logRejected1-success-end2-input",
      "sourceNodeId": "logRejected1",
      "sourcePort": "success",
      "targetNodeId": "end2",
      "targetPort": "input"
    }
  ],
  "definitions": [
    {
      "nodeType": "core.trigger.manual",
      "version": "1.0",
      "category": "trigger",
      "description": "Start workflow manually",
      "tags": ["trigger", "start", "manual"],
      "sortOrder": 40,
      "display": {
        "label": "Manual trigger",
        "icon": "play",
        "shape": "circle"
      },
      "handleConfiguration": [
        {
          "position": "right",
          "handles": [
            {
              "id": "output",
              "type": "source",
              "handleType": "output",
              "showButton": true,
              "constraints": {
                "forbiddenTargetCategories": ["trigger"]
              }
            }
          ],
          "visible": true
        }
      ],
      "model": {
        "type": "bpmn:StartEvent",
        "entryPointId": true
      },
      "outputDefinition": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the workflow.",
          "source": "null",
          "var": "output"
        }
      },
      "toolbarExtensions": {
        "design": {
          "actions": [
            {
              "id": "change-trigger-type",
              "icon": "square-mouse-pointer",
              "label": "Change trigger type"
            }
          ]
        }
      }
    },
    {
      "nodeType": "uipath.human-in-the-loop.quick-form",
      "version": "1.0",
      "category": "human-task",
      "description": "Fast inline approvals with inline debug",
      "tags": ["human-task", "hitl", "human-in-the-loop", "quick-form", "approval"],
      "sortOrder": 27,
      "display": {
        "label": "Quick Form",
        "icon": "users",
        "shape": "square"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ],
          "visible": true
        },
        {
          "position": "right",
          "handles": [
            {
              "id": "completed",
              "label": "Completed",
              "type": "source",
              "handleType": "output",
              "showButton": true,
              "constraints": {
                "forbiddenTargetCategories": ["trigger"]
              }
            }
          ],
          "visible": true
        }
      ],
      "model": { "type": "bpmn:UserTask", "serviceType": "Actions.HITL" },
      "inputDefaults": {
        "schema": {
          "fields": [],
          "outcomes": [
            { "id": "submit", "name": "Submit", "type": "string", "isPrimary": true, "action": "Continue" }
          ]
        },
        "recipient": {
          "channels": ["Email", "ActionCenter"],
          "connections": {},
          "assignee": { "type": "group" }
        }
      },
      "outputDefinition": {
        "output": { "type": "object", "description": "Task result data", "source": "=result", "var": "output" },
        "status": { "type": "string", "description": "Task completion status", "source": "=result.Action", "var": "status" }
      }
    },
    {
      "nodeType": "core.logic.decision",
      "version": "1.1",
      "category": "control-flow",
      "description": "Branch based on a true/false condition",
      "tags": ["control-flow", "if", "loop", "switch"],
      "sortOrder": 20,
      "display": {
        "label": "Decision",
        "icon": "trending-up-down"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ],
          "visible": true
        },
        {
          "position": "right",
          "handles": [
            {
              "id": "true",
              "type": "source",
              "handleType": "output",
              "label": "{inputs.trueLabel}",
              "constraints": { "minConnections": 1 }
            },
            {
              "id": "false",
              "type": "source",
              "handleType": "output",
              "label": "{inputs.falseLabel}"
            }
          ],
          "visible": true
        }
      ],
      "model": { "type": "bpmn:InclusiveGateway" },
      "inputDefaults": {
        "trueLabel": "True",
        "falseLabel": "False"
      }
    },
    {
      "nodeType": "core.action.script",
      "version": "1.0",
      "category": "data-operations",
      "description": "Run custom JavaScript code",
      "tags": ["code", "javascript", "python"],
      "sortOrder": 35,
      "supportsErrorHandling": true,
      "display": {
        "label": "Script",
        "icon": "code"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ]
        },
        {
          "position": "right",
          "handles": [
            {
              "id": "success",
              "type": "source",
              "handleType": "output"
            },
            {
              "id": "error",
              "label": "Error",
              "type": "source",
              "handleType": "output",
              "visible": "{inputs.errorHandlingEnabled}",
              "constraints": { "maxConnections": 1 }
            }
          ]
        }
      ],
      "model": { "type": "bpmn:ScriptTask" }
    },
    {
      "nodeType": "core.control.end",
      "version": "1.0",
      "category": "control-flow",
      "description": "Mark the end of a workflow path",
      "tags": ["control-flow", "end", "finish", "complete"],
      "sortOrder": 20,
      "display": {
        "label": "End",
        "icon": "circle-check",
        "shape": "circle"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ]
        }
      ],
      "model": { "type": "bpmn:EndEvent" }
    }
  ],
  "layout": {
    "nodes": {
      "start":              { "position": { "x": 100,  "y": 300 } },
      "managerReview1":     { "position": { "x": 350,  "y": 300 } },
      "approvalDecision1":  { "position": { "x": 650,  "y": 300 } },
      "logApproved1":       { "position": { "x": 900,  "y": 150 } },
      "logRejected1":       { "position": { "x": 900,  "y": 450 } },
      "end1":               { "position": { "x": 1150, "y": 150 } },
      "end2":               { "position": { "x": 1150, "y": 450 } }
    }
  },
  "variables": {
    "nodes": [
      {
        "id": "start.output",
        "type": "object",
        "description": "Data passed when manually triggering the workflow.",
        "binding": { "nodeId": "start", "outputId": "output" }
      },
      {
        "id": "managerReview1.output",
        "type": "object",
        "description": "Task result data",
        "binding": { "nodeId": "managerReview1", "outputId": "output" }
      },
      {
        "id": "managerReview1.status",
        "type": "string",
        "description": "Task completion status",
        "binding": { "nodeId": "managerReview1", "outputId": "status" }
      },
      {
        "id": "approvalDecision1.matchedCase",
        "type": "string",
        "description": "The label of the matched branch",
        "binding": { "nodeId": "approvalDecision1", "outputId": "matchedCase" }
      },
      {
        "id": "approvalDecision1.matchedCaseId",
        "type": "string",
        "description": "The branch that was taken (true or false)",
        "binding": { "nodeId": "approvalDecision1", "outputId": "matchedCaseId" }
      },
      {
        "id": "logApproved1.output",
        "type": "object",
        "description": "The return value of the script",
        "binding": { "nodeId": "logApproved1", "outputId": "output" }
      },
      {
        "id": "logRejected1.output",
        "type": "object",
        "description": "The return value of the script",
        "binding": { "nodeId": "logRejected1", "outputId": "output" }
      }
    ],
    "globals": []
  }
}
