{
  "id": "da030c90-8f2a-498e-984c-929ab9213d76",
  "version": "1.8",
  "name": "POReview",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Start"
      },
      "inputs": {
        "entryPointId": "5a763f5d-b70a-4635-bac1-659e64af4e98",
        "isDefaultEntryPoint": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the trigger.",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "fetchPO",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Fetch PO Data [PLACEHOLDER]"
      },
      "inputs": {
        "script": "// TODO: Replace with a real data source (e.g. ERP API, SharePoint, database)\nreturn {\n  poNumber: 'PO-2024-00123',\n  vendor: 'Acme Corp',\n  amount: 4500.00,\n  description: 'Office supplies Q3'\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "hitlReview",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "Review Purchase Order"
      },
      "inputs": {
        "schema": {
          "schemaId": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
          "fields": [
            {
              "id": "poNumber",
              "label": "PO Number",
              "type": "text",
              "direction": "input",
              "binding": "vars.fetchPO.output.poNumber"
            },
            {
              "id": "vendor",
              "label": "Vendor",
              "type": "text",
              "direction": "input",
              "binding": "vars.fetchPO.output.vendor"
            },
            {
              "id": "amount",
              "label": "Amount",
              "type": "number",
              "direction": "input",
              "binding": "vars.fetchPO.output.amount"
            },
            {
              "id": "comments",
              "label": "Comments",
              "type": "text",
              "direction": "output",
              "variable": "vars.reviewComments"
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "End"
            }
          ]
        },
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group"
          }
        },
        "priority": "High"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "comments": {
              "type": "string"
            },
            "Action": {
              "type": "string",
              "enum": [
                "Approve",
                "Reject"
              ],
              "default": "Approve"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": [
            "Approve",
            "Reject"
          ],
          "default": "Approve"
        }
      }
    },
    {
      "id": "logApproval",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log PO Approved"
      },
      "inputs": {
        "script": "var poNumber = $vars.fetchPO.output.poNumber || 'N/A';\nvar vendor = $vars.fetchPO.output.vendor || 'N/A';\nvar amount = $vars.fetchPO.output.amount || 0;\nvar comments = $vars.hitlReview.output.comments || '';\nreturn {\n  message: 'PO Approved: ' + poNumber + ' | Vendor: ' + vendor + ' | Amount: ' + amount + ' | Comments: ' + comments,\n  poNumber: poNumber,\n  status: 'Approved'\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {}
    }
  ],
  "edges": [
    {
      "id": "edge-start-fetchPO",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "fetchPO",
      "targetPort": "input"
    },
    {
      "id": "edge-fetchPO-hitl",
      "sourceNodeId": "fetchPO",
      "sourcePort": "success",
      "targetNodeId": "hitlReview",
      "targetPort": "input"
    },
    {
      "id": "edge-hitl-log",
      "sourceNodeId": "hitlReview",
      "sourcePort": "completed",
      "targetNodeId": "logApproval",
      "targetPort": "input"
    },
    {
      "id": "edge-log-end",
      "sourceNodeId": "logApproval",
      "sourcePort": "success",
      "targetNodeId": "end",
      "targetPort": "input"
    }
  ],
  "definitions": [
    {
      "nodeType": "core.trigger.manual",
      "version": "1.0",
