{
  "id": "1c01b5d1-da9f-4829-b411-8a057bdd7f0a",
  "version": "1.8",
  "name": "VendorPOReview",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "86c5cfa0-670e-4e3c-94ed-466277a83001",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "fetchPO1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Fetch PO Data"
      },
      "inputs": {
        "script": "return {\n  poNumber: 'PO-2026-0042',\n  vendorName: 'Acme Supplies Ltd.',\n  totalAmount: 12450.00\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "poReview1",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "Purchase Order Review"
      },
      "inputs": {
        "title": "Purchase Order Review",
        "recipient": {
          "channels": ["Email", "ActionCenter"],
          "connections": {},
          "assignee": { "type": "group" }
        },
        "priority": "High",
        "schema": {
          "schemaId": "f4a7d2c8-3e15-4b9f-a6c3-d8e2b5f1c9a7",
          "fields": [
            {
              "id": "ponumber",
              "label": "PO Number",
              "type": "string",
              "direction": "input",
              "binding": "vars.fetchPO1.output.poNumber"
            },
            {
              "id": "vendorname",
              "label": "Vendor Name",
              "type": "string",
              "direction": "input",
              "binding": "vars.fetchPO1.output.vendorName"
            },
            {
              "id": "totalamount",
              "label": "Total Amount",
              "type": "number",
              "direction": "input",
              "binding": "vars.fetchPO1.output.totalAmount"
            },
            {
              "id": "notes",
              "label": "Notes",
              "type": "string",
              "direction": "output",
              "variable": "vars.notes"
            }
          ],
          "outcomes": [
            { "id": "approve", "name": "Approve", "type": "string", "isPrimary": true,  "action": "Continue" },
            { "id": "reject",  "name": "Reject",  "type": "string", "isPrimary": false, "action": "End" }
          ]
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "notes":  { "type": "string" },
            "Action": { "type": "string", "enum": ["Approve", "Reject"], "default": "Approve" }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": ["Approve", "Reject"],
          "default": "Approve"
        }
      }
    },
    {
      "id": "logApproval1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log Approval"
      },
      "inputs": {
        "script": "const poNumber = $vars.fetchPO1.output.poNumber;\nconst notes = $vars.poReview1.output.notes;\nconsole.log('PO ' + poNumber + ' approved. Notes: ' + (notes || '(none)'));\nreturn { logged: true, poNumber: poNumber, notes: notes };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "start-output-fetchPO1-input",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "fetchPO1",
      "targetPort": "input"
    },
    {
      "id": "fetchPO1-success-poReview1-input",
      "sourceNodeId": "fetchPO1",
      "sourcePort": "success",
      "targetNodeId": "poReview1",
      "targetPort": "input"
    },
    {
      "id": "poReview1-completed-logApproval1-input",
      "sourceNodeId": "poReview1",
      "sourcePort": "completed",
      "targetNodeId": "logApproval1",
      "targetPort": "input"
    }
  ],
  "definitions": [
    {
      "nodeType": "core.trigger.manual",
      "version": "1.0",
      "category": "trigger",
      "description": "Start workflow manually",
      "tags": ["trigger", "start", "manual"],
      "sortOrder": 40,
      "display": {
        "label": "Manual trigger",
        "icon": "play",
        "shape": "circle"
      },
      "handleConfiguration": [
        {
          "position": "right",
          "handles": [
            {
              "id": "output",
              "type": "source",
              "handleType": "output",
              "showButton": true,
              "constraints": {
                "forbiddenTargetCategories": ["trigger"]
              }
            }
          ],
          "visible": true
        }
      ],
      "model": {
        "type": "bpmn:StartEvent",
        "entryPointId": true
      },
      "outputDefinition": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the workflow.",
          "source": "null",
          "var": "output"
        }
      },
      "toolbarExtensions": {
        "design": {
          "actions": [
            {
              "id": "change-trigger-type",
              "icon": "square-mouse-pointer",
              "label": "Change trigger type"
            }
          ]
        }
      }
    },
    {
      "nodeType": "core.action.script",
      "version": "1.0",
      "category": "data-operations",
      "description": "Run custom JavaScript code",
      "tags": ["code", "javascript", "python"],
      "sortOrder": 35,
      "supportsErrorHandling": true,
      "display": {
        "label": "Script",
        "icon": "code"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ]
        },
        {
          "position": "right",
          "handles": [
            {
              "id": "success",
              "type": "source",
              "handleType": "output"
            },
            {
              "id": "error",
              "label": "Error",
              "type": "source",
              "handleType": "output",
              "visible": "{inputs.errorHandlingEnabled}",
              "constraints": {
                "maxConnections": 1
              }
            }
          ]
        }
      ],
      "debug": { "runtime": "clientScript" },
      "model": { "type": "bpmn:ScriptTask" },
      "inputDefinition": {
        "type": "object",
        "properties": {
          "script": {
            "type": "string",
            "minLength": 1,
            "errorMessage": "A script function is required",
            "validationSeverity": "warning"
          }
        },
        "required": ["script"]
      },
      "inputDefaults": {
        "script": ""
      },
      "outputDefinition": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "nodeType": "uipath.human-in-the-loop.quick-form",
      "version": "1.0",
      "category": "human-task",
      "description": "Fast inline approvals with inline debug",
      "tags": ["human-task", "hitl", "human-in-the-loop", "quick-form", "approval"],
      "sortOrder": 27,
      "display": {
        "label": "Quick Form",
        "icon": "users",
        "shape": "square"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ],
          "visible": true
        },
        {
          "position": "right",
          "handles": [
            {
              "id": "completed",
              "label": "Completed",
              "type": "source",
              "handleType": "output",
              "showButton": true,
              "constraints": {
                "forbiddenTargetCategories": ["trigger"]
              }
            }
          ],
          "visible": true
        }
      ],
      "model": { "type": "bpmn:UserTask", "serviceType": "Actions.HITL" },
      "inputDefaults": {
        "schema": {
          "fields": [],
          "outcomes": [
            { "id": "submit", "name": "Submit", "type": "string", "isPrimary": true, "action": "Continue" }
          ]
        },
        "recipient": {
          "channels": ["Email", "ActionCenter"],
          "connections": {},
          "assignee": { "type": "group" }
        }
      },
      "outputDefinition": {
        "output": { "type": "object", "description": "Task result data",          "source": "=result",        "var": "output" },
        "status": { "type": "string", "description": "Task completion status",    "source": "=result.Action", "var": "status" }
      }
    }
  ],
  "layout": {
    "nodes": {
      "start":        { "position": { "x": 256,  "y": 144 } },
      "fetchPO1":     { "position": { "x": 512,  "y": 144 } },
      "poReview1":    { "position": { "x": 800,  "y": 144 } },
      "logApproval1": { "position": { "x": 1088, "y": 144 } }
    }
  },
  "variables": {
    "nodes": [
      {
        "id": "start.output",
        "type": "object",
        "description": "Data passed when manually triggering the workflow.",
        "binding": { "nodeId": "start", "outputId": "output" }
      },
      {
        "id": "fetchPO1.output",
        "type": "object",
        "description": "The return value of the script",
        "binding": { "nodeId": "fetchPO1", "outputId": "output" }
      },
      {
        "id": "poReview1.output",
        "type": "object",
        "description": "Task result data",
        "binding": { "nodeId": "poReview1", "outputId": "output" }
      },
      {
        "id": "poReview1.status",
        "type": "string",
        "description": "Task completion status",
        "binding": { "nodeId": "poReview1", "outputId": "status" }
      },
      {
        "id": "logApproval1.output",
        "type": "object",
        "description": "The return value of the script",
        "binding": { "nodeId": "logApproval1", "outputId": "output" }
      }
    ]
  }
}
