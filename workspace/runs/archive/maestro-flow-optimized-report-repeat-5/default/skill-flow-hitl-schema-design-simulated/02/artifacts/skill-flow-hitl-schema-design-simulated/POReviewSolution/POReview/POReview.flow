{
  "id": "e2080e05-f4ca-480c-8e5c-df6be99bf60c",
  "version": "1.8",
  "name": "POReview",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "749f784e-3b74-42a3-ac3f-3756aeeae28a",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "fetchPO1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Fetch PO Data"
      },
      "inputs": {
        "script": "return { ponumber: \"PO-2024-00187\", vendorname: \"Acme Supplies Ltd\", totalamount: 14750.00 };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Mock PO data",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the action fails.",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "poReview1",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "PO Review"
      },
      "inputs": {
        "title": "PO Review",
        "recipient": {
          "channels": ["Email", "ActionCenter"],
          "connections": {},
          "assignee": { "type": "group" }
        },
        "priority": "High",
        "schema": {
          "schemaId": "b7d3e9f2-1a4c-4e8b-a5f6-2c9d0e7b3a1f",
          "fields": [
            {
              "id": "ponumber",
              "label": "PO Number",
              "type": "string",
              "direction": "input",
              "binding": "vars.fetchPO1.output.ponumber"
            },
            {
              "id": "vendorname",
              "label": "Vendor Name",
              "type": "string",
              "direction": "input",
              "binding": "vars.fetchPO1.output.vendorname"
            },
            {
              "id": "totalamount",
              "label": "Total Amount",
              "type": "number",
              "direction": "input",
              "binding": "vars.fetchPO1.output.totalamount"
            },
            {
              "id": "comments",
              "label": "Comments",
              "type": "string",
              "direction": "output",
              "variable": "vars.comments",
              "required": false
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "End"
            }
          ]
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "comments": { "type": "string" },
            "Action":   { "type": "string", "enum": ["Approve", "Reject"], "default": "Approve" }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": ["Approve", "Reject"],
          "default": "Approve"
        }
      }
    },
    {
      "id": "checkDecision1",
      "type": "core.logic.decision",
      "typeVersion": "1.1",
      "display": {
        "label": "Approved?"
      },
      "inputs": {
        "expression": "$vars.poReview1.status === \"Approve\""
      }
    },
    {
      "id": "logApproval1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log Approval"
      },
      "inputs": {
        "script": "return { message: \"PO \" + $vars.fetchPO1.output.ponumber + \" approved by reviewer.\", ponumber: $vars.fetchPO1.output.ponumber, vendorname: $vars.fetchPO1.output.vendorname, totalamount: $vars.fetchPO1.output.totalamount, comments: $vars.poReview1.output.comments };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Approval log entry",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the action fails.",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "endApproved1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End — Approved"
      },
      "inputs": {}
    },
    {
      "id": "endRejected1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End — Rejected"
      },
      "inputs": {}
    }
  ],
  "edges": [
    {
      "id": "start-output-fetchPO1-input",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "fetchPO1",
      "targetPort": "input"
    },
    {
      "id": "fetchPO1-success-poReview1-input",
      "sourceNodeId": "fetchPO1",
      "sourcePort": "success",
      "targetNodeId": "poReview1",
      "targetPort": "input"
    },
    {
      "id": "poReview1-completed-checkDecision1-input",
      "sourceNodeId": "poReview1",
      "sourcePort": "completed",
      "targetNodeId": "checkDecision1",
      "targetPort": "input"
    },
    {
      "id": "checkDecision1-true-logApproval1-input",
      "sourceNodeId": "checkDecision1",
      "sourcePort": "true",
      "targetNodeId": "logApproval1",
      "targetPort": "input"
    },
    {
      "id": "logApproval1-success-endApproved1-input",
      "sourceNodeId": "logApproval1",
      "sourcePort": "success",
      "targetNodeId": "endApproved1",
      "targetPort": "input"
    },
    {
      "id": "checkDecision1-false-endRejected1-input",
      "sourceNodeId": "checkDecision1",
      "sourcePort": "false",
      "targetNodeId": "endRejected1",
      "targetPort": "input"
    }
  ],
  "definitions": [
    {
      "nodeType": "core.trigger.manual",
      "version": "1.0",
      "category": "trigger",
      "description": "Start workflow manually",
      "tags": ["trigger", "start", "manual"],
      "sortOrder": 40,
      "display": {
        "label": "Manual trigger",
        "icon": "play",
        "shape": "circle"
      },
      "handleConfiguration": [
        {
          "position": "right",
          "handles": [
            {
              "id": "output",
              "type": "source",
              "handleType": "output",
              "showButton": true,
              "constraints": {
                "forbiddenTargetCategories": ["trigger"]
              }
            }
          ],
          "visible": true
        }
      ],
      "model": {
        "type": "bpmn:StartEvent",
        "entryPointId": true
      },
      "outputDefinition": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the workflow.",
          "source": "null",
          "var": "output"
        }
      },
      "toolbarExtensions": {
        "design": {
          "actions": [
            {
              "id": "change-trigger-type",
              "icon": "square-mouse-pointer",
              "label": "Change trigger type"
            }
          ]
        }
      }
    },
    {
      "nodeType": "uipath.human-in-the-loop.quick-form",
      "version": "1.0",
      "category": "human-task",
      "description": "Fast inline approvals with inline debug",
      "tags": ["human-task", "hitl", "human-in-the-loop", "quick-form", "approval"],
      "sortOrder": 27,
      "display": {
        "label": "Quick Form",
        "icon": "users",
        "shape": "square"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ],
          "visible": true
        },
        {
          "position": "right",
          "handles": [
            {
              "id": "completed",
              "label": "Completed",
              "type": "source",
              "handleType": "output",
              "showButton": true,
              "constraints": {
                "forbiddenTargetCategories": ["trigger"]
              }
            }
          ],
          "visible": true
        }
      ],
      "model": { "type": "bpmn:UserTask", "serviceType": "Actions.HITL" },
      "inputDefaults": {
        "schema": {
          "fields": [],
          "outcomes": [
            {
              "id": "submit",
              "name": "Submit",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            }
          ]
        },
        "recipient": {
          "channels": ["Email", "ActionCenter"],
          "connections": {},
          "assignee": { "type": "group" }
        }
      },
      "outputDefinition": {
        "output": { "type": "object", "description": "Task result data", "source": "=result", "var": "output" },
        "status": { "type": "string", "description": "Task completion status", "source": "=result.Action", "var": "status" }
      }
    },
    {
      "nodeType": "core.action.script",
      "version": "1.0",
      "category": "data-operations",
      "description": "Run custom JavaScript code",
      "tags": ["code", "javascript", "python"],
      "sortOrder": 35,
      "supportsErrorHandling": true,
      "display": { "label": "Script", "icon": "code" },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            { "id": "input", "type": "target", "handleType": "input" }
          ]
        },
        {
          "position": "right",
          "handles": [
            { "id": "success", "type": "source", "handleType": "output" },
            { "id": "error", "label": "Error", "type": "source", "handleType": "output", "visible": "{inputs.errorHandlingEnabled}", "constraints": { "maxConnections": 1 } }
          ]
        }
      ],
      "debug": { "runtime": "clientScript" },
      "model": { "type": "bpmn:ScriptTask" },
      "inputDefinition": {
        "type": "object",
        "properties": {
          "script": { "type": "string", "minLength": 1, "errorMessage": "A script function is required", "validationSeverity": "warning" }
        },
        "required": ["script"]
      },
      "inputDefaults": { "script": "" },
      "outputDefinition": {
        "output": { "type": "object", "description": "The return value of the script", "source": "=result.response", "var": "output" },
        "error": { "type": "object", "description": "Error information if the node fails", "source": "=Error", "var": "error" }
      }
    },
    {
      "nodeType": "core.logic.decision",
      "version": "1.1",
      "category": "control-flow",
      "description": "Branch based on a true/false condition",
      "tags": ["control-flow", "if", "loop", "switch"],
      "sortOrder": 20,
      "display": { "label": "Decision", "icon": "trending-up-down" },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            { "id": "input", "type": "target", "handleType": "input" }
          ],
          "visible": true
        },
        {
          "position": "right",
          "handles": [
            { "id": "true", "type": "source", "handleType": "output", "label": "{inputs.trueLabel}", "constraints": { "minConnections": 1 } },
            { "id": "false", "type": "source", "handleType": "output", "label": "{inputs.falseLabel}" }
          ],
          "visible": true
        }
      ],
      "debug": { "runtime": "clientScript" },
      "model": { "type": "bpmn:InclusiveGateway" },
      "inputDefinition": {
        "type": "object",
        "properties": {
          "expression": { "type": "string", "minLength": 1, "errorMessage": "A condition expression is required" },
          "trueLabel": { "type": "string" },
          "falseLabel": { "type": "string" }
        },
        "required": ["expression"]
      },
      "outputDefinition": {
        "matchedCase": { "type": "string", "description": "The label of the matched branch (true/false label)", "var": "matchedCase" },
        "matchedCaseId": { "type": "string", "description": "The branch that was taken (true or false)", "var": "matchedCaseId" }
      },
      "inputDefaults": { "trueLabel": "True", "falseLabel": "False" }
    },
    {
      "nodeType": "core.control.end",
      "version": "1.0",
      "category": "control-flow",
      "description": "Mark the end of a workflow path",
      "tags": ["control-flow", "end", "finish", "complete"],
      "sortOrder": 20,
      "display": { "label": "End", "icon": "circle-check", "shape": "circle" },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            { "id": "input", "type": "target", "handleType": "input" }
          ]
        }
      ],
      "model": { "type": "bpmn:EndEvent" },
      "runtimeConstraints": { "exclude": ["api-function"] }
    }
  ],
  "layout": {
    "nodes": {
      "start":          { "position": { "x": 128,  "y": 240 } },
      "fetchPO1":       { "position": { "x": 320,  "y": 240 } },
      "poReview1":      { "position": { "x": 544,  "y": 240 } },
      "checkDecision1": { "position": { "x": 768,  "y": 240 } },
      "logApproval1":   { "position": { "x": 992,  "y": 160 } },
      "endApproved1":   { "position": { "x": 1216, "y": 160 } },
      "endRejected1":   { "position": { "x": 992,  "y": 320 } }
    }
  },
  "variables": {
    "nodes": [
      {
        "id": "start.output",
        "type": "object",
        "description": "Data passed when manually triggering the workflow.",
        "binding": { "nodeId": "start", "outputId": "output" }
      },
      {
        "id": "fetchPO1.output",
        "type": "object",
        "description": "Mock PO data",
        "binding": { "nodeId": "fetchPO1", "outputId": "output" }
      },
      {
        "id": "poReview1.output",
        "type": "object",
        "description": "Task result data",
        "binding": { "nodeId": "poReview1", "outputId": "output" }
      },
      {
        "id": "poReview1.status",
        "type": "string",
        "description": "Task completion status",
        "binding": { "nodeId": "poReview1", "outputId": "status" }
      },
      {
        "id": "logApproval1.output",
        "type": "object",
        "description": "Approval log entry",
        "binding": { "nodeId": "logApproval1", "outputId": "output" }
      }
    ]
  }
}
