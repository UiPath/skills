{
  "id": "70d6c4d6-219b-42a3-b48b-fd920f46505b",
  "version": "1.8",
  "name": "TransformGroupByDemo",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "c9030ca6-152d-46e7-ae6a-548f3c1af3b7",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "employees",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Static employee data"
      },
      "inputs": {
        "script": "return { items: [ { name: 'Alice', department: 'Engineering', salary: 90000 }, { name: 'Bob', department: 'Engineering', salary: 95000 }, { name: 'Carol', department: 'Marketing', salary: 75000 }, { name: 'Dave', department: 'Marketing', salary: 80000 }, { name: 'Eve', department: 'Engineering', salary: 100000 }, { name: 'Frank', department: 'HR', salary: 70000 } ] };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "groupByDept",
      "type": "core.action.transform.group-by",
      "typeVersion": "1.0",
      "display": {
        "label": "Group by Department"
      },
      "inputs": {
        "collection": "$vars.employees.output.items",
        "operations": [
          {
            "id": "op1",
            "type": "groupBy",
            "config": {
              "groupByField": "department",
              "aggregations": [
                {
                  "id": "a1",
                  "field": "",
                  "operation": "count",
                  "alias": "headcount"
                },
                {
                  "id": "a2",
                  "field": "salary",
                  "operation": "sum",
                  "alias": "totalSalary"
                },
                {
                  "id": "a3",
                  "field": "salary",
                  "operation": "average",
                  "alias": "avgSalary"
                }
              ]
            }
          }
        ]
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the transform",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the transform fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {}
    }
  ],
  "edges": [
    {
      "id": "e1",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "employees",
      "targetPort": "input"
    },
    {
      "id": "e2",
      "sourceNodeId": "employees",
      "sourcePort": "success",
      "targetNodeId": "groupByDept",
      "targetPort": "input"
    },
    {
      "id": "e3",
      "sourceNodeId": "groupByDept",
      "sourcePort": "output",
      "targetNodeId": "end",
      "targetPort": "input"
    }
  ],
  "definitions": [
    {
      "nodeType": "core.trigger.manual",
      "version": "1.0",
      "category": "trigger",
      "description": "Start workflow manually",
      "tags": [
        "trigger",
        "start",
        "manual"
      ],
      "sortOrder": 40,
      "display": {
        "label": "Manual trigger",
        "icon": "play",
        "shape": "circle"
      },
      "handleConfiguration": [
        {
          "position": "right",
          "handles": [
            {
              "id": "output",
              "type": "source",
              "handleType": "output",
              "showButton": true,
              "constraints": {
                "forbiddenTargetCategories": [
                  "trigger"
                ]
              }
            }
          ],
          "visible": true
        }
      ],
      "model": {
        "type": "bpmn:StartEvent",
        "entryPointId": true
      },
      "outputDefinition": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the workflow.",
          "source": "null",
          "var": "output"
        }
      },
      "toolbarExtensions": {
        "design": {
          "actions": [
            {
              "id": "change-trigger-type",
              "icon": "square-mouse-pointer",
              "label": "Change trigger type"
            }
