    {
      "id": "buildResult",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Build Extraction Result"
      },
      "inputs": {
        "script": "const fields = ($vars.extractReportFields.output && $vars.extractReportFields.output.ExtractionResult && $vars.extractReportFields.output.ExtractionResult.ResultsDocument && $vars.extractReportFields.output.ExtractionResult.ResultsDocument.Fields) ? $vars.extractReportFields.output.ExtractionResult.ResultsDocument.Fields : [];\nfunction getField(name) {\n  const f = fields.find(function(x) { return x.FieldName === name; });\n  return (f && f.Values && f.Values.length > 0) ? f.Values[0] : null;\n}\nconst ntsbNumber = getField('NTSB Number') || getField('ntsb_number') || getField('NTSBNumber') || getField('Report Number') || getField('Accident Number');\nconst eventDate = getField('Event Date') || getField('event_date') || getField('Accident Date') || getField('Date');\nconst city = getField('City') || getField('city') || getField('Location City') || getField('Accident City');\nconst state = getField('State') || getField('state') || getField('Location State') || getField('Accident State');\nconst location = (city && state) ? (city + ', ' + state) : (city || state || getField('Location') || null);\nconst aircraftMake = getField('Aircraft Make') || getField('aircraft_make') || getField('Make') || getField('Manufacturer');\nconst aircraftModel = getField('Aircraft Model') || getField('aircraft_model') || getField('Model');\nconst aircraftMakeModel = (aircraftMake && aircraftModel) ? (aircraftMake + ' ' + aircraftModel) : (aircraftMake || aircraftModel || null);\nconst aircraftDamage = getField('Aircraft Damage') || getField('aircraft_damage') || getField('Damage') || getField('Damage Level');\nreturn {\n  ntsbNumber: ntsbNumber,\n  eventDate: eventDate,\n  location: location,\n  aircraftMakeModel: aircraftMakeModel,\n  aircraftDamage: aircraftDamage\n};"
      }
    },
    {
      "id": "logNtsbNumber",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log NTSB Number"
      },
      "inputs": {
        "script": "const ntsbNumber = $vars.buildResult.output.ntsbNumber;\nreturn { logged: ntsbNumber };"
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {},
      "outputs": {
        "ntsbNumber": {
          "source": "=js:$vars.buildResult.output.ntsbNumber"
        },
        "eventDate": {
          "source": "=js:$vars.buildResult.output.eventDate"
        },
        "location": {
          "source": "=js:$vars.buildResult.output.location"
        },
        "aircraftMakeModel": {
          "source": "=js:$vars.buildResult.output.aircraftMakeModel"
        },
        "aircraftDamage": {
          "source": "=js:$vars.buildResult.output.aircraftDamage"
        }
      }
    }
