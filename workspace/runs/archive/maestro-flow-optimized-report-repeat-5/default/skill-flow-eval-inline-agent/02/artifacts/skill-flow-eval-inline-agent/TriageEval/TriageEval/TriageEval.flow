{
  "id": "2f18f6f0-a943-4274-9695-ce939c3d0848",
  "version": "1.8",
  "name": "TriageEval",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "ff49873a-1cdb-4af7-a6a9-e4c33fd62c0d",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "triageAgent",
      "type": "uipath.agent.autonomous",
      "typeVersion": "1.2",
      "display": {
        "label": "Triage Email"
      },
      "inputs": {
        "systemPrompt": "Classify the inbound support email into a category and priority.",
        "userPrompt": "Classify this email: {{input.start__output__email}}",
        "source": "d5db481c-2fe8-4ae9-b76c-d9e5c15396f8",
        "agentInputVariables": [
          {
            "id": "start__output__email",
            "type": "string",
            "binding": "=$vars.start.output.email",
            "description": "Bound from $vars.start.output.email"
          }
        ],
        "agentOutputVariables": [
          {
            "id": "category",
            "type": "string"
          },
          {
            "id": "priority",
            "type": "string"
          }
        ]
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Agent response",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Done"
      },
      "inputs": {},
      "outputs": {
        "category": {
          "source": "=js:$vars.triageAgent.output.category"
        },
        "priority": {
          "source": "=js:$vars.triageAgent.output.priority"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "edge-start-to-agent",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "triageAgent",
      "targetPort": "input"
    },
    {
      "id": "edge-agent-to-end",
      "sourceNodeId": "triageAgent",
      "sourcePort": "success",
      "targetNodeId": "end",
      "targetPort": "input"
    }
  ],
  "definitions": [
    {
      "nodeType": "core.trigger.manual",
      "version": "1.0",
      "category": "trigger",
      "description": "Start workflow manually",
      "tags": [
        "trigger",
        "start",
        "manual"
      ],
      "sortOrder": 40,
      "display": {
        "label": "Manual trigger",
        "icon": "play",
        "shape": "circle"
      },
      "handleConfiguration": [
        {
          "position": "right",
          "handles": [
            {
              "id": "output",
              "type": "source",
              "handleType": "output",
              "showButton": true,
              "constraints": {
                "forbiddenTargetCategories": [
                  "trigger"
                ]
              }
            }
          ],
          "visible": true
        }
      ],
      "model": {
        "type": "bpmn:StartEvent",
        "entryPointId": true
      },
      "outputDefinition": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the workflow.",
          "source": "null",
          "var": "output"
        }
      },
      "toolbarExtensions": {
        "design": {
          "actions": [
            {
              "id": "change-trigger-type",
              "icon": "square-mouse-pointer",
              "label": "Change trigger type"
            }
          ]
        }
      }
    },
    {
      "nodeType": "uipath.agent.autonomous",
      "version": "1.2",
      "category": "agent",
      "description": "AI agent that completes tasks autonomously",
      "tags": [
        "agentic",
        "ai",
        "autonomous",
        "agent"
      ],
      "sortOrder": 5,
      "supportsErrorHandling": true,
      "display": {
        "label": "Autonomous Agent",
        "icon": "autonomous-agent",
        "shape": "rectangle"
      },
      "handleConfiguration": [
        {
          "position": "top",
          "handles": [
            {
              "id": "escalation",
              "type": "source",
              "handleType": "artifact",
              "label": "Escalations",
              "showButton": true,
              "constraints": {
                "allowedTargets": [
                  {
                    "nodeType": "uipath.agent.resource.escalation"
                  },
                  {
                    "nodeType": "uipath.agent.resource.escalation.*"
                  }
                ],
                "validationMessage": "Only Agent Escalation nodes can connect here",
                "addNodePanel": {
                  "searchScope": "deep",
                  "searchProviders": []
                }
              }
            }
          ]
        },
        {
          "position": "bottom",
          "handles": [
            {
              "id": "context",
              "type": "source",
              "handleType": "artifact",
              "label": "Context",
              "showButton": true,
              "constraints": {
                "allowedTargets": [
                  {
                    "nodeType": "uipath.agent.resource.context.*"
                  }
                ],
                "validationMessage": "Only Agent Context nodes can connect here",
                "addNodePanel": {
                  "searchScope": "deep",
                  "searchProviders": []
                }
              }
            },
            {
              "id": "tool",
              "type": "source",
              "handleType": "artifact",
              "label": "Tools",
              "showButton": true,
              "constraints": {
                "allowedTargets": [
                  {
                    "nodeType": "uipath.agent.resource.tool.*"
                  }
                ],
                "validationMessage": "Only Agent Tool nodes can connect here",
                "addNodePanel": {
                  "searchScope": "deep",
                  "searchProviders": []
                }
              }
            }
          ]
        },
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ]
        },
        {
          "position": "right",
          "handles": [
            {
              "id": "success",
              "type": "source",
              "handleType": "output",
              "showButton": true,
              "constraints": {
                "forbiddenTargetCategories": [
                  "trigger"
                ]
              }
            },
            {
              "id": "error",
              "type": "source",
              "handleType": "output",
              "showButton": false,
              "constraints": {
                "forbiddenTargetCategories": [
                  "trigger"
                ]
              }
            }
          ]
        }
      ],
      "inputDefinition": {
        "type": "object",
        "properties": {
          "systemPrompt": {
            "type": "string",
            "minLength": 1
          },
          "userPrompt": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "temperature": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "maxTokenPerResponse": {
            "type": "number",
            "minimum": 0
          },
          "modelMaxTokens": {
            "type": "number",
            "minimum": 0
          },
          "maxIterations": {
            "type": "number",
            "minimum": 1,
            "maximum": 100
          },
          "guardrails": {
            "type": "array"
          },
          "agentInputVariables": {
            "type": "array"
          },
          "agentOutputVariables": {
            "type": "array"
          }
        },
        "required": [
          "systemPrompt",
          "userPrompt",
          "model"
        ]
      },
      "outputDefinition": {
        "output": {
          "type": "object",
          "description": "Agent response",
          "var": "output",
          "source": "=result.response"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      },
      "model": {
        "source": true,
        "type": "bpmn:ServiceTask",
        "serviceType": "Orchestrator.StartInlineAgentJob",
        "version": "v2",
        "context": [
          {
            "name": "_label",
            "type": "string",
            "value": ""
          },
          {
            "name": "name",
            "type": "string",
            "value": ""
          },
          {
            "name": "entryPoint",
            "type": "string",
            "value": ""
          }
        ]
      },
      "debug": {
        "runtime": "bpmnEngine"
      }
    },
    {
      "nodeType": "core.control.end",
      "version": "1.0",
      "category": "control-flow",
      "description": "Mark the end of a workflow path",
      "tags": [
        "control-flow",
        "end",
        "finish",
        "complete"
      ],
      "sortOrder": 20,
      "display": {
        "label": "End",
        "icon": "circle-check",
        "shape": "circle"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ]
        }
      ],
      "model": {
        "type": "bpmn:EndEvent"
      }
    }
  ],
  "bindings": [],
  "variables": {
    "globals": [
      {
        "id": "email",
        "type": "string",
        "direction": "in",
        "triggerNodeId": "start"
      },
      {
        "id": "category",
        "type": "string",
        "direction": "out"
      },
      {
        "id": "priority",
        "type": "string",
        "direction": "out"
      }
    ],
    "nodes": [
      {
        "id": "start.output",
        "type": "object",
        "description": "Data passed when manually triggering the workflow.",
        "binding": {
          "nodeId": "start",
          "outputId": "output"
        }
      },
      {
        "id": "triageAgent.output",
        "type": "object",
        "description": "Agent response",
        "binding": {
          "nodeId": "triageAgent",
          "outputId": "output"
        }
      },
      {
        "id": "triageAgent.error",
        "type": "object",
        "description": "Error information if the node fails",
        "binding": {
          "nodeId": "triageAgent",
          "outputId": "error"
        }
      },
      {
        "id": "end.category",
        "type": "string",
        "binding": {
          "nodeId": "end",
          "outputId": "category"
        }
      },
      {
        "id": "end.priority",
        "type": "string",
        "binding": {
          "nodeId": "end",
          "outputId": "priority"
        }
      }
    ]
  },
  "runtime": "maestro",
  "layout": {
    "nodes": {
      "start": {
        "position": {
          "x": -192,
          "y": 0
        },
        "size": {
          "width": 96,
          "height": 96
        },
