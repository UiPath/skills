{
  "id": "6d5b7bab-3bde-4e77-9cf2-2587c1846676",
  "version": "1.8",
  "name": "VendorApproval",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "934a3e17-ffa0-407f-ae68-f524f4c1b5d8",
        "isDefaultEntryPoint": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the trigger.",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "setVendorContext1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Set Vendor Context"
      },
      "inputs": {
        "script": "return { vendorName: \"Acme Corp\", creditScore: 720 };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "vendorReview1",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "Compliance Officer Review"
      },
      "inputs": {
        "title": "Vendor Onboarding Review",
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group"
          }
        },
        "priority": "Low",
        "schema": {
          "schemaId": "b4e2f1a3-9c5d-4b8e-a7f2-3d6c9e0b1a2f",
          "fields": [
            {
              "id": "vendorname",
              "label": "Vendor Name",
              "type": "string",
              "direction": "input",
              "binding": "vars.setVendorContext1.output.vendorName"
            },
            {
              "id": "creditscore",
              "label": "Credit Score",
              "type": "number",
              "direction": "input",
              "binding": "vars.setVendorContext1.output.creditScore"
            },
            {
              "id": "approved",
              "label": "Approved",
              "type": "boolean",
              "direction": "output",
              "variable": "vars.approved",
              "required": true
            },
            {
              "id": "risk_notes",
              "label": "Risk Notes",
              "type": "string",
              "direction": "output",
              "variable": "vars.risk_notes",
              "required": false
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "End"
            }
          ]
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "approved": {
              "type": "boolean"
            },
            "risk_notes": {
              "type": "string"
            },
            "Action": {
              "type": "string",
              "enum": [
                "Approve",
                "Reject"
              ],
              "default": "Approve"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": [
            "Approve",
            "Reject"
          ],
          "default": "Approve"
        }
      }
    },
    {
      "id": "checkApproval1",
      "type": "core.logic.decision",
      "typeVersion": "1.1",
      "display": {
        "label": "Approved?"
      },
      "inputs": {
        "expression": "$vars.vendorReview1.output.approved === true"
      }
    },
    {
      "id": "onboardVendor1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log: Vendor Onboarded"
      },
      "inputs": {
        "script": "return { message: \"Vendor onboarded\", vendorName: $vars.setVendorContext1.output.vendorName };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "rejectVendor1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log: Vendor Rejected"
      },
      "inputs": {
        "script": "return { message: \"Vendor rejected\", vendorName: $vars.setVendorContext1.output.vendorName };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "endApproved1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End (Approved)"
      },
      "inputs": {}
    },
    {
      "id": "endRejected1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End (Rejected)"
      },
      "inputs": {}
    }
  ],
  "edges": [
    {
      "id": "edge-start-setVendorContext1",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "setVendorContext1",
      "targetPort": "input"
    },
    {
      "id": "edge-setVendorContext1-vendorReview1",
      "sourceNodeId": "setVendorContext1",
      "sourcePort": "success",
      "targetNodeId": "vendorReview1",
      "targetPort": "input"
    },
    {
      "id": "edge-vendorReview1-checkApproval1",
      "sourceNodeId": "vendorReview1",
      "sourcePort": "completed",
      "targetNodeId": "checkApproval1",
      "targetPort": "input"
    },
    {
      "id": "edge-checkApproval1-true-onboardVendor1",
      "sourceNodeId": "checkApproval1",
      "sourcePort": "true",
      "targetNodeId": "onboardVendor1",
      "targetPort": "input"
    },
    {
      "id": "edge-checkApproval1-false-rejectVendor1",
      "sourceNodeId": "checkApproval1",
      "sourcePort": "false",
      "targetNodeId": "rejectVendor1",
      "targetPort": "input"
    },
    {
      "id": "edge-onboardVendor1-endApproved1",
      "sourceNodeId": "onboardVendor1",
      "sourcePort": "success",
      "targetNodeId": "endApproved1",
      "targetPort": "input"
    },
    {
      "id": "edge-rejectVendor1-endRejected1",
      "sourceNodeId": "rejectVendor1",
      "sourcePort": "success",
      "targetNodeId": "endRejected1",
      "targetPort": "input"
    }
  ],
  "definitions": [
    {
      "nodeType": "core.trigger.manual",
      "version": "1.0",
