{
  "id": "813fb838-e1f7-424e-baf3-3926826eddea",
  "version": "1.8",
  "name": "VendorApproval",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "1be8c66d-7872-4df0-8570-f5cd1ea67684",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "setVendorContext1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Set Vendor Context"
      },
      "inputs": {
        "script": "return {\n  vendorName: \"Acme Corp\",\n  creditScore: 720\n};"
      }
    },
    {
      "id": "complianceReview1",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "Compliance Officer Review"
      },
      "inputs": {
        "title": "Compliance Officer Review",
        "recipient": {
          "channels": ["Email", "ActionCenter"],
          "connections": {},
          "assignee": { "type": "group" }
        },
        "priority": "Low",
        "schema": {
          "schemaId": "6890629d-1829-4293-858e-1826dfd5638c",
          "fields": [
            {
              "id": "vendorname",
              "label": "Vendor Name",
              "type": "string",
              "direction": "input",
              "binding": "vars.setVendorContext1.output.vendorName"
            },
            {
              "id": "creditscore",
              "label": "Credit Score",
              "type": "number",
              "direction": "input",
              "binding": "vars.setVendorContext1.output.creditScore"
            },
            {
              "id": "approved",
              "label": "Approved",
              "type": "boolean",
              "direction": "output",
              "variable": "vars.approved",
              "required": true
            },
            {
              "id": "risk_notes",
              "label": "Risk Notes",
              "type": "string",
              "direction": "output",
              "variable": "vars.riskNotes",
              "required": false
            }
          ],
          "outcomes": [
            { "id": "approve", "name": "Approve", "type": "string", "isPrimary": true,  "action": "Continue" },
            { "id": "reject",  "name": "Reject",  "type": "string", "isPrimary": false, "action": "End" }
          ]
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "approved":   { "type": "boolean" },
            "risk_notes": { "type": "string" },
            "Action":     { "type": "string", "enum": ["Approve", "Reject"], "default": "Approve" }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": ["Approve", "Reject"],
          "default": "Approve"
        }
      }
    },
    {
      "id": "approvalDecision1",
      "type": "core.logic.decision",
      "typeVersion": "1.1",
      "display": {
        "label": "Approved?"
      },
      "inputs": {
        "expression": "$vars.complianceReview1.output.approved === true",
        "trueLabel": "Approved",
        "falseLabel": "Rejected"
      }
    },
    {
      "id": "logOnboarded1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log Vendor Onboarded"
      },
      "inputs": {
        "script": "console.log(\"Vendor onboarded\");\nreturn { message: \"Vendor onboarded\" };"
      }
    },
    {
      "id": "logRejected1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log Vendor Rejected"
      },
      "inputs": {
        "script": "console.log(\"Vendor rejected\");\nreturn { message: \"Vendor rejected\" };"
      }
    },
    {
      "id": "endApproved1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End (Approved)"
      }
    },
    {
      "id": "endRejected1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End (Rejected)"
      }
    }
  ],
  "edges": [
    {
      "id": "start-output-setVendorContext1-input",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "setVendorContext1",
      "targetPort": "input"
    },
    {
      "id": "setVendorContext1-success-complianceReview1-input",
      "sourceNodeId": "setVendorContext1",
      "sourcePort": "success",
      "targetNodeId": "complianceReview1",
      "targetPort": "input"
    },
    {
      "id": "complianceReview1-completed-approvalDecision1-input",
      "sourceNodeId": "complianceReview1",
      "sourcePort": "completed",
      "targetNodeId": "approvalDecision1",
      "targetPort": "input"
    },
    {
      "id": "approvalDecision1-true-logOnboarded1-input",
      "sourceNodeId": "approvalDecision1",
      "sourcePort": "true",
      "targetNodeId": "logOnboarded1",
      "targetPort": "input"
    },
    {
      "id": "approvalDecision1-false-logRejected1-input",
      "sourceNodeId": "approvalDecision1",
      "sourcePort": "false",
      "targetNodeId": "logRejected1",
      "targetPort": "input"
    },
    {
      "id": "logOnboarded1-success-endApproved1-input",
      "sourceNodeId": "logOnboarded1",
      "sourcePort": "success",
      "targetNodeId": "endApproved1",
      "targetPort": "input"
    },
    {
      "id": "logRejected1-success-endRejected1-input",
      "sourceNodeId": "logRejected1",
      "sourcePort": "success",
      "targetNodeId": "endRejected1",
      "targetPort": "input"
    }
  ],
  "definitions": [
    {
      "nodeType": "core.trigger.manual",
      "version": "1.0",
      "category": "trigger",
      "description": "Start workflow manually",
      "tags": ["trigger", "start", "manual"],
      "sortOrder": 40,
      "display": {
        "label": "Manual trigger",
        "icon": "play",
        "shape": "circle"
      },
      "handleConfiguration": [
        {
          "position": "right",
          "handles": [
            {
              "id": "output",
              "type": "source",
              "handleType": "output",
              "showButton": true,
              "constraints": {
                "forbiddenTargetCategories": ["trigger"]
              }
            }
          ],
          "visible": true
        }
      ],
      "model": {
        "type": "bpmn:StartEvent",
        "entryPointId": true
      },
      "outputDefinition": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the workflow.",
          "source": "null",
          "var": "output"
        }
      },
      "toolbarExtensions": {
        "design": {
          "actions": [
            {
              "id": "change-trigger-type",
              "icon": "square-mouse-pointer",
              "label": "Change trigger type"
            }
          ]
        }
      }
    },
    {
      "nodeType": "core.action.script",
      "version": "1.0",
      "category": "data-operations",
      "description": "Run custom JavaScript code",
      "tags": ["code", "javascript", "python"],
      "sortOrder": 35,
      "supportsErrorHandling": true,
      "display": {
        "label": "Script",
        "icon": "code"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            { "id": "input", "type": "target", "handleType": "input" }
          ]
        },
        {
          "position": "right",
          "handles": [
            { "id": "success", "type": "source", "handleType": "output" },
            {
              "id": "error",
              "label": "Error",
              "type": "source",
              "handleType": "output",
              "visible": "{inputs.errorHandlingEnabled}",
              "constraints": { "maxConnections": 1 }
            }
          ]
        }
      ],
      "debug": { "runtime": "clientScript" },
      "model": { "type": "bpmn:ScriptTask" },
      "inputDefinition": {
        "type": "object",
        "properties": {
          "script": { "type": "string", "minLength": 1, "errorMessage": "A script function is required", "validationSeverity": "warning" }
        },
        "required": ["script"]
      },
      "inputDefaults": { "script": "" },
      "outputDefinition": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "nodeType": "uipath.human-in-the-loop.quick-form",
      "version": "1.0",
      "category": "human-task",
      "description": "Fast inline approvals with inline debug",
      "tags": ["human-task", "hitl", "human-in-the-loop", "quick-form", "approval"],
      "sortOrder": 27,
      "display": {
        "label": "Quick Form",
        "icon": "users",
        "shape": "square"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            { "id": "input", "type": "target", "handleType": "input" }
          ],
          "visible": true
        },
        {
          "position": "right",
          "handles": [
            {
              "id": "completed",
              "label": "Completed",
              "type": "source",
              "handleType": "output",
              "showButton": true,
              "constraints": { "forbiddenTargetCategories": ["trigger"] }
            }
          ],
          "visible": true
        }
      ],
      "model": { "type": "bpmn:UserTask", "serviceType": "Actions.HITL" },
      "inputDefaults": {
        "schema": {
          "fields": [],
          "outcomes": [{ "id": "submit", "name": "Submit", "type": "string", "isPrimary": true, "action": "Continue" }]
        },
        "recipient": {
          "channels": ["Email", "ActionCenter"],
          "connections": {},
          "assignee": { "type": "group" }
        }
      },
      "outputDefinition": {
        "output": { "type": "object", "description": "Task result data", "source": "=result", "var": "output" },
        "status": { "type": "string", "description": "Task completion status", "source": "=result.Action", "var": "status" }
      }
    },
    {
      "nodeType": "core.logic.decision",
      "version": "1.1",
      "category": "control-flow",
      "description": "Branch based on a true/false condition",
      "tags": ["control-flow", "if", "loop", "switch"],
      "sortOrder": 20,
      "display": {
        "label": "Decision",
        "icon": "trending-up-down"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            { "id": "input", "type": "target", "handleType": "input" }
          ],
          "visible": true
        },
        {
          "position": "right",
          "handles": [
            {
              "id": "true",
              "type": "source",
              "handleType": "output",
              "label": "{inputs.trueLabel}",
              "constraints": { "minConnections": 1 }
            },
            {
              "id": "false",
              "type": "source",
              "handleType": "output",
              "label": "{inputs.falseLabel}"
            }
          ],
          "visible": true
        }
      ],
      "debug": { "runtime": "clientScript" },
      "model": { "type": "bpmn:InclusiveGateway" },
      "inputDefinition": {
        "type": "object",
        "properties": {
          "expression": { "type": "string", "minLength": 1, "errorMessage": "A condition expression is required" },
          "trueLabel":  { "type": "string" },
          "falseLabel": { "type": "string" }
        },
        "required": ["expression"]
      },
      "outputDefinition": {
        "matchedCase":   { "type": "string", "description": "The label of the matched branch (true/false label)", "var": "matchedCase" },
        "matchedCaseId": { "type": "string", "description": "The branch that was taken (true or false)", "var": "matchedCaseId" }
      },
      "inputDefaults": { "trueLabel": "True", "falseLabel": "False" }
    },
    {
      "nodeType": "core.control.end",
      "version": "1.0",
      "category": "control-flow",
      "description": "Mark the end of a workflow path",
      "tags": ["control-flow", "end", "finish", "complete"],
      "sortOrder": 20,
      "display": {
        "label": "End",
        "icon": "circle-check",
        "shape": "circle"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            { "id": "input", "type": "target", "handleType": "input" }
          ]
        }
      ],
      "model": { "type": "bpmn:EndEvent" },
      "runtimeConstraints": { "exclude": ["api-function"] }
    }
  ],
  "layout": {
    "nodes": {
      "start":              { "position": { "x": 100,  "y": 300 } },
      "setVendorContext1":  { "position": { "x": 300,  "y": 300 } },
      "complianceReview1":  { "position": { "x": 550,  "y": 300 } },
      "approvalDecision1":  { "position": { "x": 800,  "y": 300 } },
      "logOnboarded1":      { "position": { "x": 1050, "y": 180 } },
      "logRejected1":       { "position": { "x": 1050, "y": 420 } },
      "endApproved1":       { "position": { "x": 1300, "y": 180 } },
      "endRejected1":       { "position": { "x": 1300, "y": 420 } }
    }
  },
  "variables": {
    "nodes": [
      {
        "id": "start.output",
        "type": "object",
        "description": "Data passed when manually triggering the workflow.",
        "binding": { "nodeId": "start", "outputId": "output" }
      },
      {
        "id": "setVendorContext1.output",
        "type": "object",
        "description": "The return value of the script",
        "binding": { "nodeId": "setVendorContext1", "outputId": "output" }
      },
      {
        "id": "setVendorContext1.error",
        "type": "object",
        "description": "Error information if the node fails",
        "binding": { "nodeId": "setVendorContext1", "outputId": "error" }
      },
      {
        "id": "complianceReview1.output",
        "type": "object",
        "description": "Task result data",
        "binding": { "nodeId": "complianceReview1", "outputId": "output" }
      },
      {
        "id": "complianceReview1.status",
        "type": "string",
        "description": "Task completion status",
        "binding": { "nodeId": "complianceReview1", "outputId": "status" }
      },
      {
        "id": "approvalDecision1.matchedCase",
        "type": "string",
        "description": "The label of the matched branch (true/false label)",
        "binding": { "nodeId": "approvalDecision1", "outputId": "matchedCase" }
      },
      {
        "id": "approvalDecision1.matchedCaseId",
        "type": "string",
        "description": "The branch that was taken (true or false)",
        "binding": { "nodeId": "approvalDecision1", "outputId": "matchedCaseId" }
      },
      {
        "id": "logOnboarded1.output",
        "type": "object",
        "description": "The return value of the script",
        "binding": { "nodeId": "logOnboarded1", "outputId": "output" }
      },
      {
        "id": "logOnboarded1.error",
        "type": "object",
        "description": "Error information if the node fails",
        "binding": { "nodeId": "logOnboarded1", "outputId": "error" }
      },
      {
        "id": "logRejected1.output",
        "type": "object",
        "description": "The return value of the script",
        "binding": { "nodeId": "logRejected1", "outputId": "output" }
      },
      {
        "id": "logRejected1.error",
        "type": "object",
        "description": "Error information if the node fails",
        "binding": { "nodeId": "logRejected1", "outputId": "error" }
      }
    ],
    "globals": []
  }
}
