      "type": "uipath.connector.uipath-salesforce-sfdc.search-using-soql",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Query Accounts with Opportunities"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-salesforce-sfdc",
          "connectionId": "f4f880b6-8148-42e4-a7f8-cd7de72a5141",
          "connectionResourceId": "f4f880b6-8148-42e4-a7f8-cd7de72a5141",
          "connectionFolderKey": "def71452-bad1-40fa-be08-da175e89bd1a",
          "method": "POST",
          "endpoint": "/curated_soqlQuery",
          "bodyParameters": {
            "query": "SELECT Id, Name, (SELECT Id, Name, StageName, Amount, CloseDate FROM Opportunities) FROM Account"
          },
          "uiPathActivityTypeId": "7aee02cf-218d-322e-9e67-7b78b6d6ebec",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"instanceParameters\":{\"connectorKey\":\"uipath-salesforce-sfdc\",\"objectName\":\"curated_soqlQuery\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"curated_soqlQuery\",\"operation\":\"list\",\"httpMethod\":\"POST\",\"path\":\"/curated_soqlQuery\",\"packageVersion\":\"1.0.0\",\"connectorVersion\":null,\"executionType\":null,\"customFieldsRequestDetails\":{\"objectActionName\":\"GenerateQuerySchema\",\"parameterValues\":[[\"query\",\"SELECT Id, Name, (SELECT Id, Name, StageName, Amount, CloseDate FROM Opportunities) FROM Account\"]]},\"unifiedTypesCompatible\":true}}",
          "inputMetadata": {
            "operation": "list",
            "pagination": {
              "maxPageSize": 1000
            }
          }
        }
      }
    }
