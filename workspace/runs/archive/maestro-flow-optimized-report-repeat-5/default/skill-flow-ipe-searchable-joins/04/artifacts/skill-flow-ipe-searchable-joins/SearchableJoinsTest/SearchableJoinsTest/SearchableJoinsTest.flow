  "name": "SearchableJoinsTest",
  "nodes": [
    {
      "id": "hasOpportunitiesDecision1",
      "type": "core.logic.decision",
      "typeVersion": "1.1",
      "display": {
        "label": "Has Opportunities?"
      },
      "inputs": {
        "expression": "$vars.queryAccountsWithOpportunities1.output && $vars.queryAccountsWithOpportunities1.output.length > 0 && $vars.queryAccountsWithOpportunities1.output.some(function(a) { return a.Opportunities && a.Opportunities.records && a.Opportunities.records.length > 0; })",
        "trueLabel": "Has Opportunities",
        "falseLabel": "No Opportunities"
      }
    },
    {
      "id": "endWithOpportunities1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End — Has Opportunities"
      },
      "inputs": {}
    },
    {
