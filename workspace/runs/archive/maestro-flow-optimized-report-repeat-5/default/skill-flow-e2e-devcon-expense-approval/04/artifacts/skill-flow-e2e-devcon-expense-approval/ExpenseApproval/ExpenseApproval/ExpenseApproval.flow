{
  "id": "53c5e92c-1d56-4b14-9a5d-2244358f6ca6",
  "version": "1.8",
  "name": "ExpenseApproval",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "70f83960-b054-46f8-bb5e-cb202018692f",
        "isDefaultEntryPoint": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the trigger.",
          "source": "null",
          "var": "output"
        }
      }
    },
    {
      "id": "mockExpenseData1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Mock Expense Data"
      },
      "inputs": {
        "script": "return {\n  expense_id: \"EXP-2024-0042\",\n  amount: 1250.00,\n  submitter_name: \"Jane Smith\",\n  category: \"Travel\"\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "managerReview1",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "Manager Review"
      },
      "inputs": {
        "title": "Expense Approval Request",
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group",
            "group": "expense-approvers"
          }
        },
        "priority": "Medium",
        "schema": {
          "schemaId": "a7f3c291-4b8e-4f9a-b2c5-6d8e1f3a7b9c",
          "fields": [
            {
              "id": "expenseid",
              "label": "Expense ID",
              "type": "string",
              "direction": "input",
              "binding": "vars.mockExpenseData1.output.expense_id"
            },
            {
              "id": "amount",
              "label": "Amount",
              "type": "number",
              "direction": "input",
              "binding": "vars.mockExpenseData1.output.amount"
            },
            {
              "id": "submittername",
              "label": "Submitted By",
              "type": "string",
              "direction": "input",
              "binding": "vars.mockExpenseData1.output.submitter_name"
            },
            {
              "id": "category",
              "label": "Category",
              "type": "string",
              "direction": "input",
              "binding": "vars.mockExpenseData1.output.category"
            },
            {
              "id": "isapproved",
              "label": "Approved",
              "type": "boolean",
              "direction": "output",
              "variable": "vars.isApproved",
              "required": true
            },
            {
              "id": "rejectionreason",
              "label": "Rejection Reason",
              "type": "string",
              "direction": "output",
              "variable": "vars.rejectionReason",
              "required": false
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "End"
            }
          ]
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "isapproved": {
              "type": "boolean"
            },
            "rejectionreason": {
              "type": "string"
            },
            "Action": {
              "type": "string",
              "enum": [
                "Approve",
                "Reject"
              ],
              "default": "Approve"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": [
            "Approve",
            "Reject"
          ],
          "default": "Approve"
        }
      }
    },
    {
      "id": "logOutcome1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log Outcome"
      },
      "inputs": {
        "script": "const decision = $vars.managerReview1.output.isapproved;\nconst reason = $vars.managerReview1.output.rejectionreason;\nconst expenseId = $vars.mockExpenseData1.output.expense_id;\nconst submitter = $vars.mockExpenseData1.output.submitter_name;\nconst amount = $vars.mockExpenseData1.output.amount;\n\nconst outcome = decision ? 'APPROVED' : 'REJECTED';\nlet log = `Expense ${expenseId} submitted by ${submitter} for $${amount} was ${outcome}.`;\nif (!decision && reason) {\n  log += ` Rejection reason: ${reason}`;\n}\nreturn { outcome, log, expense_id: expenseId, is_approved: decision, rejection_reason: reason || null };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {}
    }
  ],
  "edges": [
    {
      "id": "edge-start-mockExpenseData1",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "mockExpenseData1",
      "targetPort": "input"
    },
    {
      "id": "edge-mockExpenseData1-managerReview1",
      "sourceNodeId": "mockExpenseData1",
      "sourcePort": "success",
      "targetNodeId": "managerReview1",
      "targetPort": "input"
    },
    {
      "id": "edge-managerReview1-logOutcome1",
      "sourceNodeId": "managerReview1",
      "sourcePort": "completed",
      "targetNodeId": "logOutcome1",
      "targetPort": "input"
    },
    {
      "id": "edge-logOutcome1-end",
      "sourceNodeId": "logOutcome1",
      "sourcePort": "success",
      "targetNodeId": "end",
      "targetPort": "input"
    }
  ],
