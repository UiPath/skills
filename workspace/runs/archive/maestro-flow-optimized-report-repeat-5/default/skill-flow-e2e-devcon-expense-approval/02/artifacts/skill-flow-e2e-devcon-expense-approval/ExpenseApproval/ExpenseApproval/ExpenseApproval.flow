{
  "id": "ee5f41fc-dddb-4f12-a882-89f0b84e02eb",
  "version": "1.8",
  "name": "ExpenseApproval",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "946e34c9-8bf3-43bc-b272-65f0005da623",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "fetchExpense",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Fetch Expense Details"
      },
      "inputs": {
        "script": "return {\n  expenseId: \"EXP-2024-001\",\n  amount: 1250.00,\n  submitter: \"Jane Smith\",\n  category: \"Travel\"\n};"
      }
    },
    {
      "id": "managerReview",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "Manager Review"
      },
      "inputs": {
        "title": "Expense Approval Request",
        "schema": {
          "schemaId": "c7e2a1f3-84b9-4d50-9e6c-1a2b3c4d5e6f",
          "fields": [
            {
              "id": "expenseid",
              "label": "Expense ID",
              "type": "text",
              "direction": "input",
              "binding": "vars.fetchExpense.output.expenseId"
            },
            {
              "id": "amount",
              "label": "Amount",
              "type": "number",
              "direction": "input",
              "binding": "vars.fetchExpense.output.amount"
            },
            {
              "id": "submitter",
              "label": "Submitted By",
              "type": "text",
              "direction": "input",
              "binding": "vars.fetchExpense.output.submitter"
            },
            {
              "id": "category",
              "label": "Category",
              "type": "text",
              "direction": "input",
              "binding": "vars.fetchExpense.output.category"
            },
            {
              "id": "rejectionreason",
              "label": "Rejection Reason",
              "type": "text",
              "direction": "output",
              "variable": "vars.rejectionReason"
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "Continue"
            }
          ]
        },
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group",
            "name": "expense-approvers"
          }
        },
        "priority": "Medium"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "rejectionreason": {
              "type": "string"
            },
            "Action": {
              "type": "string",
              "enum": [
                "Approve",
                "Reject"
              ],
              "default": "Approve"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": [
            "Approve",
            "Reject"
          ],
          "default": "Approve"
        }
      }
    },
    {
      "id": "logOutcome",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log Outcome"
      },
      "inputs": {
        "script": "const decision = $vars.managerReview.status;\nconst rejectionReason = $vars.managerReview.output.rejectionreason;\nif (decision === 'Approve') {\n  return { outcome: 'Approved', message: 'Expense approved by manager.' };\n} else {\n  return { outcome: 'Rejected', message: 'Expense rejected by manager.', reason: rejectionReason || 'No reason provided' };\n}"
      }
    },
    {
      "id": "doneEnd",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Done"
      },
      "inputs": {}
    }
  ],
  "edges": [
    {
      "id": "e-start-fetchExpense",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "fetchExpense",
      "targetPort": "input"
    },
    {
      "id": "e-fetchExpense-managerReview",
      "sourceNodeId": "fetchExpense",
      "sourcePort": "success",
      "targetNodeId": "managerReview",
      "targetPort": "input"
    },
    {
      "id": "e-managerReview-logOutcome",
      "sourceNodeId": "managerReview",
      "sourcePort": "completed",
      "targetNodeId": "logOutcome",
      "targetPort": "input"
    },
    {
      "id": "e-logOutcome-doneEnd",
      "sourceNodeId": "logOutcome",
      "sourcePort": "success",
      "targetNodeId": "doneEnd",
      "targetPort": "input"
    }
  ],
  "definitions": [
    {
      "nodeType": "core.trigger.manual",
      "version": "1.0",
      "category": "trigger",
      "description": "Start workflow manually",
      "tags": [
        "trigger",
        "start",
        "manual"
      ],
      "sortOrder": 40,
      "display": {
        "label": "Manual trigger",
        "icon": "play",
        "shape": "circle"
      },
      "handleConfiguration": [
        {
          "position": "right",
          "handles": [
            {
              "id": "output",
              "type": "source",
              "handleType": "output",
              "showButton": true,
              "constraints": {
                "forbiddenTargetCategories": [
                  "trigger"
                ]
              }
            }
          ],
          "visible": true
        }
      ],
      "model": {
        "type": "bpmn:StartEvent",
