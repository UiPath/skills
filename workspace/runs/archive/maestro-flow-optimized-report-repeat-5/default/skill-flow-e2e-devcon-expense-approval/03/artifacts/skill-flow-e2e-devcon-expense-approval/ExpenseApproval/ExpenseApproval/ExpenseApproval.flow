{
  "id": "21d66419-d2b7-45f6-a635-a63797fb28e2",
  "version": "1.8",
  "name": "ExpenseApproval",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "c31adbac-dd0c-4736-a1fb-4f3b179d07dd",
        "isDefaultEntryPoint": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the workflow.",
          "source": "null",
          "var": "output"
        }
      }
    },
    {
      "id": "fetchExpenseDetails1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Fetch Expense Details"
      },
      "inputs": {
        "script": "// Mock: simulate pulling an expense report from the internal system\nreturn {\n  expenseId: \"EXP-2024-00142\",\n  submitter: \"Jane Smith\",\n  amount: 1250.00,\n  category: \"Travel\",\n  description: \"Flight and hotel for Q3 customer visit\",\n  submittedAt: \"2024-07-20\"\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "managerReview1",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "Manager Review"
      },
      "inputs": {
        "title": "Expense Approval Request",
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group",
            "value": "expense-approvers"
          }
        },
        "priority": "Low",
        "schema": {
          "schemaId": "b7e2f4a1-3c8d-4e9b-a5f6-1d2e3c4b5a6f",
          "fields": [
            {
              "id": "expenseid",
              "label": "Expense ID",
              "type": "string",
              "direction": "input",
              "binding": "vars.fetchExpenseDetails1.output.expenseId"
            },
            {
              "id": "submitter",
              "label": "Submitted By",
              "type": "string",
              "direction": "input",
              "binding": "vars.fetchExpenseDetails1.output.submitter"
            },
            {
              "id": "amount",
              "label": "Amount ($)",
              "type": "number",
              "direction": "input",
              "binding": "vars.fetchExpenseDetails1.output.amount"
            },
            {
              "id": "category",
              "label": "Category",
              "type": "string",
              "direction": "input",
              "binding": "vars.fetchExpenseDetails1.output.category"
            },
            {
              "id": "description",
              "label": "Description",
              "type": "string",
              "direction": "input",
              "binding": "vars.fetchExpenseDetails1.output.description"
            },
            {
              "id": "approved",
              "label": "Approved?",
              "type": "boolean",
              "direction": "output",
              "variable": "vars.approved",
              "required": true
            },
            {
              "id": "rejectionreason",
              "label": "Rejection Reason",
              "type": "string",
              "direction": "output",
              "variable": "vars.rejectionReason",
              "required": false
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "Continue"
            }
          ]
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "approved": {
              "type": "boolean"
            },
            "rejectionreason": {
              "type": "string"
            },
            "Action": {
              "type": "string",
              "enum": [
                "Approve",
                "Reject"
              ],
              "default": "Approve"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": [
            "Approve",
            "Reject"
          ],
          "default": "Approve"
        }
      }
    },
    {
      "id": "logOutcome1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log Outcome"
      },
      "inputs": {
        "script": "const decision = $vars.managerReview1.output.approved;\nconst reason = $vars.managerReview1.output.rejectionreason;\nconst action = $vars.managerReview1.status;\nconst expenseId = $vars.fetchExpenseDetails1.output.expenseId;\nconst submitter = $vars.fetchExpenseDetails1.output.submitter;\nconst amount = $vars.fetchExpenseDetails1.output.amount;\n\nconst logEntry = {\n  expenseId: expenseId,\n  submitter: submitter,\n  amount: amount,\n  managerDecision: action,\n  approved: decision,\n  rejectionReason: (action === 'Reject' && reason) ? reason : null,\n  processedAt: new Date().toISOString()\n};\n\nreturn { logEntry: logEntry, summary: `Expense ${expenseId} by ${submitter} was ${action}d.` };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "end1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Done"
      },
      "inputs": {}
    }
  ],
  "edges": [
    {
      "id": "edge-start-fetchExpenseDetails1",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "fetchExpenseDetails1",
