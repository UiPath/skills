{
  "id": "1db0be54-d43a-4bb2-b93c-b2d76b874cf0",
  "version": "1.8",
  "name": "CustomerEscalation",
  "nodes": [
    {
      "id": "classifyUrgency1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Classify Urgency"
      },
      "inputs": {
        "script": "var subject = ($vars.newEmailReceived1.output.subject || '').toLowerCase();\nvar body = ($vars.newEmailReceived1.output['body.content'] || '').toLowerCase();\nvar combined = subject + ' ' + body;\nvar urgentKeywords = ['urgent', 'asap', 'critical', 'emergency', 'outage', 'down', 'blocker', 'sev1', 'sev 1', 'high priority', 'immediate', 'escalate', 'breaking'];\nvar isUrgent = urgentKeywords.some(function(kw) { return combined.indexOf(kw) !== -1; });\nreturn { isUrgent: isUrgent, matchedKeywords: urgentKeywords.filter(function(kw) { return combined.indexOf(kw) !== -1; }) };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Urgency classification result",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "classifyVip1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Classify VIP"
      },
      "inputs": {
        "script": "var senderEmail = ($vars.newEmailReceived1.output['sender.emailAddress.address'] || $vars.newEmailReceived1.output['from.emailAddress.address'] || '').toLowerCase();\nvar vipDomains = ['enterprise.com', 'goldpartner.com', 'premiumcorp.com', 'vip.example.com', 'bigclient.io', 'strategicaccount.com'];\nvar vipEmails = ['ceo@company.com', 'cto@company.com', 'vp.sales@bigclient.io', 'account.manager@enterprise.com'];\nvar senderDomain = senderEmail.split('@')[1] || '';\nvar isVipByDomain = vipDomains.some(function(d) { return senderDomain === d || senderDomain.endsWith('.' + d); });\nvar isVipByEmail = vipEmails.indexOf(senderEmail) !== -1;\nvar isVip = isVipByDomain || isVipByEmail;\nreturn { isVip: isVip, senderEmail: senderEmail, senderDomain: senderDomain, matchedByDomain: isVipByDomain, matchedByEmail: isVipByEmail };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "VIP classification result",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "routeEscalation1",
      "type": "core.logic.decision",
      "typeVersion": "1.1",
      "display": {
        "label": "High-Touch Route?"
      },
      "inputs": {
        "expression": "$vars.classifyUrgency1.output.isUrgent === true && $vars.classifyVip1.output.isVip === true"
      }
    },
    {
      "id": "generateTicket1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Generate Support Ticket"
      },
      "inputs": {
        "script": "var ts = new Date().getTime();\nvar ticketId = 'TKT-' + ts.toString().slice(-6);\nvar senderEmail = $vars.newEmailReceived1.output['sender.emailAddress.address'] || $vars.newEmailReceived1.output['from.emailAddress.address'] || 'unknown';\nvar subject = $vars.newEmailReceived1.output.subject || '(no subject)';\nvar priority = $vars.classifyUrgency1.output.isUrgent ? 'High' : 'Normal';\nreturn {\n  ticketId: ticketId,\n  summary: 'Support ticket created for: ' + subject,\n  priority: priority,\n  reporterEmail: senderEmail,\n  replyBody: 'Thank you for contacting support. Your request has been logged.\\n\\nTicket ID: ' + ticketId + '\\nPriority: ' + priority + '\\nSubject: ' + subject + '\\n\\nOur team will respond within 24 hours. You can reference your ticket ID in future communications.\\n\\nBest regards,\\nSupport Team'\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Generated ticket details",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "endHighTouch1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End - High Touch"
      },
      "inputs": {}
    },
    {
      "id": "endStandard1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End - Standard"
      },
      "inputs": {}
    },
    {
      "id": "newEmailReceived1",
      "type": "uipath.connector.trigger.uipath-microsoft-outlook365.email-received",
      "typeVersion": "1.0.0",
      "display": {
        "label": "New Email Received"
      },
      "inputs": {
        "entryPointId": "be2a6f78-ae25-4c28-92e2-b4d74df81b05",
