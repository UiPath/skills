{
  "id": "1c516297-c903-4fcb-baf8-86e9f9cd204d",
  "version": "1.8",
  "name": "CustomerEscalation",
  "nodes": [
    {
      "id": "classifyUrgency1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Classify Urgency"
      },
      "inputs": {
        "script": "var subject = ($vars.emailReceived1.output.subject || '').toLowerCase();\nvar body = ($vars.emailReceived1.output.body || '').toLowerCase();\nvar combined = subject + ' ' + body;\nvar urgentKeywords = ['urgent', 'critical', 'asap', 'emergency', 'immediately', 'escalate', 'outage', 'blocker', 'p0', 'p1', 'sev1', 'sev0', 'high priority', 'time sensitive'];\nvar isUrgent = urgentKeywords.some(function(kw) { return combined.indexOf(kw) !== -1; });\nreturn { isUrgent: isUrgent };"
      }
    },
    {
      "id": "classifyVip1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Classify VIP"
      },
      "inputs": {
        "script": "var from = ($vars.emailReceived1.output.from || '').toLowerCase();\nvar vipDomains = ['enterprise.com', 'bigcorp.com', 'vip-client.com', 'goldpartner.io', 'platinumaccount.net'];\nvar vipEmails = ['ceo@', 'cto@', 'cfo@', 'vp@', 'svp@', 'evp@', 'president@', 'chairman@'];\nvar isVipDomain = vipDomains.some(function(d) { return from.indexOf(d) !== -1; });\nvar isVipRole = vipEmails.some(function(prefix) { return from.indexOf(prefix) !== -1; });\nvar isVip = isVipDomain || isVipRole;\nreturn { isVip: isVip, from: from };"
      }
    },
    {
      "id": "routingDecision1",
      "type": "core.logic.decision",
      "typeVersion": "1.1",
      "display": {
        "label": "Urgent AND VIP?"
      },
      "inputs": {
        "expression": "$vars.classifyUrgency1.output.isUrgent === true && $vars.classifyVip1.output.isVip === true",
        "trueLabel": "High-Touch",
        "falseLabel": "Standard"
      }
    },
    {
      "id": "generateTicket1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Generate Support Ticket"
      },
      "inputs": {
        "script": "var ticketId = 'TKT-' + (Date.now ? Math.floor(Math.random() * 90000 + 10000) : 99999);\nvar subject = $vars.emailReceived1.output.subject || '(no subject)';\nvar from = $vars.emailReceived1.output.from || 'unknown';\nvar ticketBody = 'Thank you for contacting support.\\n\\nWe have created a support ticket for your request.\\n\\nTicket ID: ' + ticketId + '\\nSubject: ' + subject + '\\nSender: ' + from + '\\n\\nOur support team will follow up within 1 business day.\\n\\nBest regards,\\nSupport Team';\nreturn { ticketId: ticketId, ticketBody: ticketBody, subject: subject, from: from };"
      }
    },
    {
      "id": "endHighTouch1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End High-Touch"
      }
    },
    {
      "id": "endStandard1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End Standard"
      }
    },
    {
      "id": "emailReceived1",
      "type": "uipath.connector.trigger.uipath-microsoft-outlook365.email-received",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Email Received"
      },
      "inputs": {
        "entryPointId": "16581563-6156-485b-8e70-d66232a74b40",
        "detail": {
          "connector": "uipath-microsoft-outlook365",
          "connectionId": "75dfafb4-3717-470c-a5f6-bdc144757a67",
          "connectionResourceId": "75dfafb4-3717-470c-a5f6-bdc144757a67",
          "connectionFolderKey": "5da18ec0-7de1-4e57-aaf1-ddc8a369c199",
          "eventParameters": {
            "parentFolderId": "AAMkAGNiNDVjZmJmLTczOTEtNDQ2MS04Njc2LTUwM2I3ZDgxOWQwMAAuAAAAAAAJJRkzOJfsTKZfQqhMUHzlAQAJDKUrZhoLQZ5wELpOfJPCAAAAAAEMAAA="
          },
          "objectName": "Message",
          "eventType": "EMAIL_RECEIVED",
          "eventMode": "polling",
          "filterExpression": "(parentFolderId == 'AAMkAGNiNDVjZmJmLTczOTEtNDQ2MS04Njc2LTUwM2I3ZDgxOWQwMAAuAAAAAAAJJRkzOJfsTKZfQqhMUHzlAQAJDKUrZhoLQZ5wELpOfJPCAAAAAAEMAAA=')",
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"instanceParameters\":{\"connectorKey\":\"uipath-microsoft-outlook365\",\"objectName\":\"Message\",\"activityType\":\"CuratedTrigger\",\"version\":\"1.0.0\",\"eventOperation\":\"EMAIL_RECEIVED\",\"eventMode\":\"polling\",\"supportsStreaming\":false},\"objectName\":\"Message\",\"packageVersion\":\"1.0.0\",\"connectorVersion\":null,\"executionType\":null,\"httpMethod\":null,\"path\":null,\"filter\":null}}",
          "uiPathActivityTypeId": "d76ca053-6e7e-3472-b98c-3094b802d83c",
