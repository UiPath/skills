{
  "id": "69e94b52-c3f7-49cb-a528-8eaa35e2cb15",
  "version": "1.8",
  "name": "CustomerEscalation",
  "nodes": [
    {
      "id": "emailReceived1",
      "type": "uipath.connector.trigger.uipath-microsoft-outlook365.email-received",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Email Received"
      },
      "inputs": {
        "entryPointId": "752cc499-6b26-4555-b6c9-3d2dd329fff7",
        "isDefaultEntryPoint": true,
        "detail": {
          "connector": "uipath-microsoft-outlook365",
          "connectionId": "75dfafb4-3717-470c-a5f6-bdc144757a67",
          "connectionResourceId": "75dfafb4-3717-470c-a5f6-bdc144757a67",
          "connectionFolderKey": "5da18ec0-7de1-4e57-aaf1-ddc8a369c199",
          "eventParameters": {
            "parentFolderId": "AAMkAGNiNDVjZmJmLTczOTEtNDQ2MS04Njc2LTUwM2I3ZDgxOWQwMAAuAAAAAAAJJRkzOJfsTKZfQqhMUHzlAQAJDKUrZhoLQZ5wELpOfJPCAAAAAAEMAAA="
          },
          "objectName": "Message",
          "eventType": "EMAIL_RECEIVED",
          "eventMode": "polling",
          "filterExpression": "(parentFolderId == 'AAMkAGNiNDVjZmJmLTczOTEtNDQ2MS04Njc2LTUwM2I3ZDgxOWQwMAAuAAAAAAAJJRkzOJfsTKZfQqhMUHzlAQAJDKUrZhoLQZ5wELpOfJPCAAAAAAEMAAA=')",
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"instanceParameters\":{\"connectorKey\":\"uipath-microsoft-outlook365\",\"objectName\":\"Message\",\"activityType\":\"CuratedTrigger\",\"version\":\"1.0.0\",\"eventOperation\":\"EMAIL_RECEIVED\",\"eventMode\":\"polling\",\"supportsStreaming\":false},\"objectName\":\"Message\",\"packageVersion\":\"1.0.0\",\"connectorVersion\":null,\"executionType\":null,\"httpMethod\":null,\"path\":null,\"filter\":null}}",
          "uiPathActivityTypeId": "d76ca053-6e7e-3472-b98c-3094b802d83c",
          "errorState": {
            "issues": []
          }
        }
      }
    },
    {
      "id": "classifyUrgency1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Classify Urgency"
      },
      "inputs": {
        "script": "const subject = ($vars.emailReceived1.output.subject || '').toLowerCase();\nconst body = ($vars.emailReceived1.output.bodyPreview || '').toLowerCase();\nconst urgentKeywords = ['urgent', 'critical', 'emergency', 'asap', 'high priority', 'outage', 'down', 'blocker', 'p0', 'p1', 'escalation', 'immediate', 'incident', 'sev1', 'sev2'];\nconst isUrgent = urgentKeywords.some(function(kw) { return subject.indexOf(kw) !== -1 || body.indexOf(kw) !== -1; });\nreturn { isUrgent: isUrgent };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Urgency classification result",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "classifyVip1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Classify VIP"
      },
      "inputs": {
        "script": "const from = $vars.emailReceived1.output.from;\nconst senderEmail = (from && from.emailAddress && from.emailAddress.address) ? from.emailAddress.address.toLowerCase() : '';\nconst subject = ($vars.emailReceived1.output.subject || '');\nconst vipDomains = ['@enterprise.com', '@vip.example.com', '@partner.com', '@uipath.com', '@uipathsandboxes.onmicrosoft.com'];\nconst isVipDomain = vipDomains.some(function(d) { return senderEmail.indexOf(d) !== -1; });\nconst isVipTag = subject.indexOf('[VIP]') === 0 || subject.indexOf('[vip]') === 0;\nconst isVip = isVipDomain || isVipTag;\nreturn { isVip: isVip, senderEmail: senderEmail };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "VIP classification result",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "routeDecision1",
      "type": "core.logic.decision",
      "typeVersion": "1.1",
      "display": {
        "label": "Urgent AND VIP?"
      },
      "inputs": {
        "expression": "$vars.classifyUrgency1.output.isUrgent === true && $vars.classifyVip1.output.isVip === true",
        "trueLabel": "High Touch",
        "falseLabel": "Standard"
      }
    },
    {
      "id": "slackNotifyVip1",
      "type": "uipath.connector.uipath-salesforce-slack.send-message-to-channel",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Slack Notify VIP"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-salesforce-slack",
          "connectionId": "849e85d8-1aa9-4d52-8bbd-20041c8f05d8",
          "connectionResourceId": "849e85d8-1aa9-4d52-8bbd-20041c8f05d8",
          "connectionFolderKey": "5da18ec0-7de1-4e57-aaf1-ddc8a369c199",
          "method": "POST",
          "endpoint": "/send_message_to_channel_v2",
          "bodyParameters": {
            "channel": "C01H4SPS77W",
            "messageToSend": "=js:`🚨 VIP URGENT ESCALATION\\nFrom: ${$vars.classifyVip1.output.senderEmail}\\nSubject: ${$vars.emailReceived1.output.subject}\\nThis email requires immediate high-touch response.`"
          },
          "uiPathActivityTypeId": "37a305b2-89b1-315d-b73f-1778839a6c47",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"instanceParameters\":{\"connectorKey\":\"uipath-salesforce-slack\",\"objectName\":\"send_message_to_channel_v2\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"send_message_to_channel_v2\",\"operation\":\"create\",\"httpMethod\":\"POST\",\"path\":\"/send_message_to_channel_v2\",\"packageVersion\":\"1.0.0\",\"connectorVersion\":null,\"executionType\":null,\"customFieldsRequestDetails\":null,\"unifiedTypesCompatible\":true,\"savedJitInputFieldId\":\"in_send_message_to_channel_v2\"}}"
        }
      }
    },
    {
      "id": "replyFastAck1",
      "type": "uipath.connector.uipath-microsoft-outlook365.reply-to-email",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Reply Fast Ack"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-microsoft-outlook365",
          "connectionId": "75dfafb4-3717-470c-a5f6-bdc144757a67",
          "connectionResourceId": "75dfafb4-3717-470c-a5f6-bdc144757a67",
          "connectionFolderKey": "5da18ec0-7de1-4e57-aaf1-ddc8a369c199",
          "method": "POST",
          "endpoint": "/ReplyToEmailV2",
          "bodyParameters": {
            "messageId": "=js:$vars.emailReceived1.output.id",
            "replyBody": "=js:`Thank you for reaching out. Your message has been flagged as urgent and you have been identified as a priority customer. A dedicated support specialist has been notified and will contact you shortly.\\n\\nWe appreciate your business and will ensure this is handled with the highest priority.`"
          },
          "uiPathActivityTypeId": "da9976dd-3d71-35b4-bb8c-509419cb46eb",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"instanceParameters\":{\"connectorKey\":\"uipath-microsoft-outlook365\",\"objectName\":\"ReplyToEmailV2\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"ReplyToEmailV2\",\"operation\":\"create\",\"httpMethod\":\"POST\",\"path\":\"/ReplyToEmailV2\",\"packageVersion\":\"1.0.0\",\"connectorVersion\":null,\"executionType\":null,\"customFieldsRequestDetails\":null,\"unifiedTypesCompatible\":true}}",
          "multipartParameters": [
            {
              "name": "file",
              "dataType": "file"
            },
            {
              "name": "body",
              "dataType": "string"
            }
          ],
          "inputMetadata": {
            "type": "multipart",
            "multipart": {
              "bodyFieldName": "body"
            }
          }
        }
      }
    },
    {
      "id": "doneHighTouch",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Done - High Touch"
      },
      "inputs": {}
    },
    {
      "id": "generateTicket1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Generate Support Ticket"
      },
      "inputs": {
        "script": "var subject = $vars.emailReceived1.output.subject || '(no subject)';\nvar sender = $vars.classifyVip1.output.senderEmail || 'unknown';\nvar isUrgent = $vars.classifyUrgency1.output.isUrgent;\nvar priority = isUrgent ? 'High' : 'Normal';\nvar emailIdRaw = ($vars.emailReceived1.output.id || 'EMAIL00001');\nvar emailIdShort = emailIdRaw.substring(0, 8).replace(/[^A-Za-z0-9]/g, '0').toUpperCase();\nvar ticketId = 'TKT-' + emailIdShort;\nvar replyBody = 'Thank you for contacting support.\\n\\nYour request has been received and a support ticket has been created:\\n\\n  Ticket ID: ' + ticketId + '\\n  Priority: ' + priority + '\\n  Subject: ' + subject + '\\n\\nOur team will respond within the standard SLA window. Please reference ticket ID ' + ticketId + ' in future correspondence.';\nreturn { ticketId: ticketId, subject: subject, sender: sender, priority: priority, replyBody: replyBody };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Generated ticket details",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "replyTicket1",
      "type": "uipath.connector.uipath-microsoft-outlook365.reply-to-email",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Reply Ticket"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-microsoft-outlook365",
          "connectionId": "75dfafb4-3717-470c-a5f6-bdc144757a67",
          "connectionResourceId": "75dfafb4-3717-470c-a5f6-bdc144757a67",
          "connectionFolderKey": "5da18ec0-7de1-4e57-aaf1-ddc8a369c199",
          "method": "POST",
          "endpoint": "/ReplyToEmailV2",
          "bodyParameters": {
            "messageId": "=js:$vars.emailReceived1.output.id",
            "replyBody": "=js:$vars.generateTicket1.output.replyBody"
          },
          "uiPathActivityTypeId": "da9976dd-3d71-35b4-bb8c-509419cb46eb",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"instanceParameters\":{\"connectorKey\":\"uipath-microsoft-outlook365\",\"objectName\":\"ReplyToEmailV2\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"ReplyToEmailV2\",\"operation\":\"create\",\"httpMethod\":\"POST\",\"path\":\"/ReplyToEmailV2\",\"packageVersion\":\"1.0.0\",\"connectorVersion\":null,\"executionType\":null,\"customFieldsRequestDetails\":null,\"unifiedTypesCompatible\":true}}",
          "multipartParameters": [
            {
              "name": "file",
