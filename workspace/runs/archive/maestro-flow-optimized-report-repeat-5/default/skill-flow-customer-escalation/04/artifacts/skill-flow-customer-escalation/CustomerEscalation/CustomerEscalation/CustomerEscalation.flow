      "typeVersion": "1.0.0",
      "display": {
        "label": "Reply - Ticket Details"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-microsoft-outlook365",
          "connectionId": "5af6fa90-234d-4b0d-a2f1-3815cfd9e15d",
          "connectionResourceId": "5af6fa90-234d-4b0d-a2f1-3815cfd9e15d",
          "connectionFolderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "method": "POST",
          "endpoint": "/ReplyToEmailV2",
          "bodyParameters": {
            "comment": "Thank you for contacting our support team. A support ticket has been created for your request. Our team will review your case and respond within 1 business day. Please keep this email for your records as your ticket reference. Best regards, Customer Support Team"
          },
