    {
      "id": "classifyUrgency",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Classify Urgency"
      },
      "inputs": {
        "script": "const subject = ($vars.emailReceived1.output.subject || '').toLowerCase(); const bodyText = ($vars.emailReceived1.output.body && $vars.emailReceived1.output.body.content ? $vars.emailReceived1.output.body.content : '').toLowerCase(); const text = subject + ' ' + bodyText; const urgentKeywords = ['urgent', 'asap', 'critical', 'emergency', 'deadline', 'escalat', 'immediately', 'priority', 'blocked', 'blocker', 'outage', 'not working', 'sla', 'incident', 'down']; const isUrgent = urgentKeywords.some(kw => text.includes(kw)); return { isUrgent: isUrgent };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "classifyVip",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Classify VIP"
      },
      "inputs": {
        "script": "const fromAddr = ($vars.emailReceived1.output.from && $vars.emailReceived1.output.from.emailAddress ? $vars.emailReceived1.output.from.emailAddress.address : '').toLowerCase(); const senderAddr = ($vars.emailReceived1.output.sender && $vars.emailReceived1.output.sender.emailAddress ? $vars.emailReceived1.output.sender.emailAddress.address : '').toLowerCase(); const email = fromAddr || senderAddr; const domain = email.indexOf('@') !== -1 ? email.split('@')[1] : ''; const vipDomains = ['acme-corp.com', 'enterprise-partner.com', 'bigclient.io', 'premier-client.com', 'strategic.io']; const isVip = vipDomains.includes(domain); return { isVip: isVip, senderEmail: email, domain: domain };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "decision1",
      "type": "core.logic.decision",
      "typeVersion": "1.1",
      "display": {
        "label": "Urgent AND VIP?"
      },
      "inputs": {
        "expression": "$vars.classifyUrgency.output.isUrgent === true && $vars.classifyVip.output.isVip === true",
        "trueLabel": "High Touch",
        "falseLabel": "Standard"
      }
    },
    {
      "id": "createTicket",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Create Support Ticket"
      },
      "inputs": {
        "script": "const subject = $vars.emailReceived1.output.subject || 'No Subject'; const senderEmail = $vars.classifyVip.output.senderEmail || ''; const rand = Math.random().toString(36).substr(2, 8).toUpperCase(); const ticketId = 'TKT-' + rand; const replyBody = 'Dear Customer, thank you for contacting our support team. A ticket has been created: Ticket ID: ' + ticketId + ' | Subject: ' + subject + ' | From: ' + senderEmail + '. Our team will respond within 1 business day. Best regards, Customer Support'; const replySubject = '[' + ticketId + '] Re: ' + subject; return { ticketId: ticketId, replyBody: replyBody, replySubject: replySubject };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "endHighTouch",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End - High Touch"
      },
      "inputs": {}
    },
    {
      "id": "endStandard",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End - Standard"
      },
      "inputs": {}
    }
  ],
