      "id": "replyFastAcknowledgment1",
      "type": "uipath.connector.uipath-microsoft-outlook365.reply-to-email",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Reply - Fast Acknowledgment"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-microsoft-outlook365",
          "connectionId": "5af6fa90-234d-4b0d-a2f1-3815cfd9e15d",
          "connectionResourceId": "5af6fa90-234d-4b0d-a2f1-3815cfd9e15d",
          "connectionFolderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "method": "POST",
          "endpoint": "/ReplyToEmailV2",
          "bodyParameters": {
            "comment": "Thank you for reaching out. As a valued VIP client, your urgent matter has been flagged for immediate high-touch support. A dedicated team member will contact you within the next 30 minutes. We appreciate your continued partnership."
          },
          "uiPathActivityTypeId": "da9976dd-3d71-35b4-bb8c-509419cb46eb",
          "errorState": {
