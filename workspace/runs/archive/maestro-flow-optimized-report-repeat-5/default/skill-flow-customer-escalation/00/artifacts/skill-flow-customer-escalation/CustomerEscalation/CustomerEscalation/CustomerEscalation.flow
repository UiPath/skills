{
  "id": "b5cf36c7-a450-40c9-8269-ca19572cf05c",
  "version": "1.8",
  "name": "CustomerEscalation",
  "nodes": [
    {
      "id": "emailReceived1",
      "type": "uipath.connector.trigger.uipath-mock-outlook.email-received",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Email Received"
      },
      "inputs": {
        "entryPointId": "6bc70eb2-28cd-4fc0-8769-a10d4d5e3010",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "classifyUrgency1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Classify Urgency"
      },
      "inputs": {
        "script": "var subject = ($vars.emailReceived1.output.subject || '').toLowerCase();\nvar bodyText = ($vars.emailReceived1.output.body || $vars.emailReceived1.output.bodyPreview || '').toLowerCase();\nvar urgentKeywords = ['urgent', 'asap', 'critical', 'emergency', 'immediately', 'escalate', 'outage', 'down', 'broken', 'blocker', 'high priority', 'p0', 'p1', 'sev1', 'severity 1', 'time sensitive'];\nvar combined = subject + ' ' + bodyText;\nvar isUrgent = urgentKeywords.some(function(kw) { return combined.indexOf(kw) !== -1; });\nvar matched = urgentKeywords.filter(function(kw) { return combined.indexOf(kw) !== -1; });\nreturn { isUrgent: isUrgent, matchedKeywords: matched };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Urgency classification result",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails.",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "classifyVip1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Classify VIP"
      },
      "inputs": {
        "script": "var senderEmail = ($vars.emailReceived1.output.from || $vars.emailReceived1.output.sender || '').toLowerCase();\nvar vipDomains = ['acmecorp.com', 'bigclient.com', 'enterprise.com', 'globalpartner.com', 'strategic.io'];\nvar vipEmails = ['ceo@example.com', 'cto@example.com', 'vp@example.com', 'president@example.com'];\nvar isVipDomain = vipDomains.some(function(d) { return senderEmail.indexOf('@' + d) !== -1; });\nvar isVipEmail = vipEmails.some(function(a) { return senderEmail.indexOf(a) !== -1; });\nvar isVip = isVipDomain || isVipEmail;\nreturn { isVip: isVip, senderEmail: senderEmail, matchedDomain: isVipDomain, matchedAddress: isVipEmail };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "VIP classification result",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails.",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "routeDecision1",
      "type": "core.logic.decision",
      "typeVersion": "1.1",
      "display": {
        "label": "Urgent AND VIP?"
      },
      "inputs": {
        "expression": "$vars.classifyUrgency1.output.isUrgent === true && $vars.classifyVip1.output.isVip === true",
        "trueLabel": "High-Touch",
        "falseLabel": "Standard"
      }
    },
    {
      "id": "notifySlack1",
      "type": "uipath.connector.uipath-salesforce-slack.send-message-to-channel",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Notify Slack"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-salesforce-slack",
          "connectionId": "849e85d8-1aa9-4d52-8bbd-20041c8f05d8",
          "connectionResourceId": "849e85d8-1aa9-4d52-8bbd-20041c8f05d8",
          "connectionFolderKey": "5da18ec0-7de1-4e57-aaf1-ddc8a369c199",
          "method": "POST",
          "endpoint": "/send_message_to_channel_v2",
          "bodyParameters": {
            "channel": "C01G1P7CU58",
            "text": "=js:`🚨 HIGH-TOUCH ESCALATION 🚨\\nFrom: ${$vars.emailReceived1.output.from || $vars.emailReceived1.output.sender || 'unknown'}\\nSubject: ${$vars.emailReceived1.output.subject || '(no subject)'}\\nUrgency keywords: ${($vars.classifyUrgency1.output.matchedKeywords||[]).join(', ')}\\nVIP: ${$vars.classifyVip1.output.senderEmail}\\nPlease respond immediately.`"
          },
          "queryParameters": {
            "send_as": "bot"
          },
          "uiPathActivityTypeId": "37a305b2-89b1-315d-b73f-1778839a6c47",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"instanceParameters\":{\"connectorKey\":\"uipath-salesforce-slack\",\"objectName\":\"send_message_to_channel_v2\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"send_message_to_channel_v2\",\"operation\":\"create\",\"httpMethod\":\"POST\",\"path\":\"/send_message_to_channel_v2\",\"packageVersion\":\"1.0.0\",\"connectorVersion\":null,\"executionType\":null,\"customFieldsRequestDetails\":null,\"unifiedTypesCompatible\":true,\"savedJitInputFieldId\":\"in_send_message_to_channel_v2\"}}"
        }
      }
    },
    {
      "id": "replyHighTouchAck1",
      "type": "uipath.connector.uipath-mock-outlook.reply-to-email",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Reply: High-Touch Ack"
      },
      "inputs": {}
    },
    {
      "id": "endHighTouch1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End: High-Touch"
      }
    },
    {
      "id": "generateTicket1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Generate Support Ticket"
      },
      "inputs": {
        "script": "var subject = $vars.emailReceived1.output.subject || '(no subject)';\nvar sender = $vars.emailReceived1.output.from || $vars.emailReceived1.output.sender || 'unknown';\nvar instanceId = $metadata.instanceId || '';\nvar ticketId = 'TKT-' + instanceId.toString().slice(-8).toUpperCase();\nvar priority = $vars.classifyUrgency1.output.isUrgent ? 'High' : 'Normal';\nvar replyBody = 'Thank you for contacting support. Your ticket has been created: ' + ticketId + ' (Priority: ' + priority + '). Our team will respond within 24 hours.';\nreturn { ticketId: ticketId, subject: subject, sender: sender, priority: priority, status: 'Open', replyBody: replyBody };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Generated ticket details",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails.",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "replyTicketDetails1",
      "type": "uipath.connector.uipath-mock-outlook.reply-to-email",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Reply: Ticket Details"
      },
      "inputs": {}
    },
    {
      "id": "endStandard1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End: Standard"
      }
    }
  ],
  "edges": [
