{
  "id": "1883302a-0c21-44b0-9a86-0425f55ae6d5",
  "version": "1.8",
  "name": "ExpenseApproval",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "e6f24078-6e60-4a90-906c-4ea4513ae608",
        "isDefaultEntryPoint": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the trigger.",
          "source": "null",
          "var": "output"
        }
      }
    },
    {
      "id": "managerReview",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "Manager Review"
      },
      "inputs": {
        "schema": {
          "schemaId": "99a5893b-eeb2-4bf2-b28a-7f34d0fccf24",
          "fields": [
            {
              "id": "submittername",
              "label": "Submitter Name",
              "type": "text",
              "direction": "input",
              "binding": "vars.start.output.submitterName"
            },
            {
              "id": "expenseid",
              "label": "Expense ID",
              "type": "text",
              "direction": "input",
              "binding": "vars.start.output.expenseId"
            },
            {
              "id": "amount",
              "label": "Amount",
              "type": "number",
              "direction": "input",
              "binding": "vars.start.output.amount"
            },
            {
              "id": "category",
              "label": "Category",
              "type": "text",
              "direction": "input",
              "binding": "vars.start.output.category"
            },
            {
              "id": "rejectionreason",
              "label": "Rejection Reason (optional)",
              "type": "text",
              "direction": "output",
              "variable": "vars.rejectionReason"
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "End"
            }
          ]
        },
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group",
            "name": "expense-approvers"
          }
        },
        "priority": "Low"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "rejectionreason": {
              "type": "string"
            },
            "Action": {
              "type": "string",
              "enum": [
                "Approve",
                "Reject"
              ],
              "default": "Approve"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": [
            "Approve",
            "Reject"
          ],
          "default": "Approve"
        }
      }
    },
    {
      "id": "decideOutcome",
      "type": "core.logic.decision",
      "typeVersion": "1.1",
      "display": {
        "label": "Approved?"
      },
      "inputs": {
        "expression": "$vars.managerReview.status === \"Approve\"",
        "trueLabel": "Approved",
        "falseLabel": "Rejected"
      }
    },
    {
      "id": "logApproval",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log Approval"
      },
      "inputs": {
        "script": "var d = new Date();\nreturn {\n  logEntry: {\n    expenseId: $vars.start.output.expenseId,\n    submitterName: $vars.start.output.submitterName,\n    amount: $vars.start.output.amount,\n    category: $vars.start.output.category,\n    decision: \"Approved\",\n    rejectionReason: null,\n    timestamp: d.toISOString()\n  }\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "logRejection",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log Rejection"
      },
      "inputs": {
        "script": "var d = new Date();\nreturn {\n  logEntry: {\n    expenseId: $vars.start.output.expenseId,\n    submitterName: $vars.start.output.submitterName,\n    amount: $vars.start.output.amount,\n    category: $vars.start.output.category,\n    decision: \"Rejected\",\n    rejectionReason: $vars.managerReview.output.rejectionreason || null,\n    timestamp: d.toISOString()\n  }\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "doneApproved",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Done - Approved"
      },
      "inputs": {},
      "outputs": {
        "approvalLog": {
          "source": "=js:$vars.logApproval.output.logEntry"
        }
      }
    },
    {
      "id": "doneRejected",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Done - Rejected"
      },
      "inputs": {},
      "outputs": {
        "approvalLog": {
          "source": "=js:$vars.logRejection.output.logEntry"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "edge-start-managerReview",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "managerReview",
      "targetPort": "input"
    },
    {
      "id": "edge-managerReview-decideOutcome",
      "sourceNodeId": "managerReview",
      "sourcePort": "completed",
      "targetNodeId": "decideOutcome",
      "targetPort": "input"
    },
    {
      "id": "edge-decideOutcome-logApproval",
      "sourceNodeId": "decideOutcome",
      "sourcePort": "true",
      "targetNodeId": "logApproval",
      "targetPort": "input"
    },
    {
      "id": "edge-decideOutcome-logRejection",
      "sourceNodeId": "decideOutcome",
      "sourcePort": "false",
      "targetNodeId": "logRejection",
      "targetPort": "input"
    },
    {
      "id": "edge-logApproval-doneApproved",
      "sourceNodeId": "logApproval",
      "sourcePort": "success",
      "targetNodeId": "doneApproved",
      "targetPort": "input"
    },
    {
      "id": "edge-logRejection-doneRejected",
      "sourceNodeId": "logRejection",
      "sourcePort": "success",
      "targetNodeId": "doneRejected",
      "targetPort": "input"
    }
  ],
  "definitions": [
    {
      "nodeType": "core.trigger.manual",
      "version": "1.0",
