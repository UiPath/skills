  "runtime": "maestro",
  "layout": {
    "nodes": {
      "start": {
        "position": {
          "x": -192,
          "y": 0
        },
        "size": {
          "width": 96,
          "height": 96
        },
        "collapsed": false
      },
      "managerReview": {
        "position": {
          "x": 0,
          "y": 0
        },
        "size": {
          "width": 96,
          "height": 96
        },
        "collapsed": false
