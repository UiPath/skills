{
  "id": "6c0e24ec-c7bc-4454-94e3-a66a53d337a2",
  "version": "1.8",
  "name": "ExpenseApproval",
  "runtime": "maestro",
  "variables": {
    "globals": [],
    "nodes": [
      {
        "id": "start.output",
        "type": "object",
        "description": "Data passed when manually triggering the workflow.",
        "binding": {
          "nodeId": "start",
          "outputId": "output"
        }
      },
      {
        "id": "fetchExpense.output",
        "type": "object",
        "description": "The return value of the script",
        "binding": {
          "nodeId": "fetchExpense",
          "outputId": "output"
        }
      },
      {
        "id": "fetchExpense.error",
        "type": "object",
        "description": "Error information if the node fails",
        "binding": {
          "nodeId": "fetchExpense",
          "outputId": "error"
        }
      },
      {
        "id": "managerApproval.output",
        "type": "object",
        "description": "Task result data",
        "binding": {
          "nodeId": "managerApproval",
          "outputId": "output"
        }
      },
      {
        "id": "managerApproval.status",
        "type": "string",
        "description": "Task completion status",
        "binding": {
          "nodeId": "managerApproval",
          "outputId": "status"
        }
      },
      {
        "id": "checkDecision.matchedCase",
        "type": "string",
        "description": "The label of the matched branch (true/false label)",
        "binding": {
          "nodeId": "checkDecision",
          "outputId": "matchedCase"
        }
      },
      {
        "id": "checkDecision.matchedCaseId",
        "type": "string",
        "description": "The branch that was taken (true or false)",
        "binding": {
          "nodeId": "checkDecision",
          "outputId": "matchedCaseId"
        }
      },
      {
        "id": "logOutcome.output",
        "type": "object",
        "description": "The return value of the script",
        "binding": {
          "nodeId": "logOutcome",
          "outputId": "output"
        }
      },
      {
        "id": "logOutcome.error",
        "type": "object",
        "description": "Error information if the node fails",
        "binding": {
          "nodeId": "logOutcome",
          "outputId": "error"
        }
      }
    ]
  },
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Expense Report Submitted"
      },
      "inputs": {
        "entryPointId": "66acaa70-dc82-423d-8d26-4cd340c372f2",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "fetchExpense",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Fetch Expense Details"
      },
      "inputs": {
        "script": "// Simulated fetch from expense management system\nconst expenseId = $vars.start.output.expenseId || 'EXP-0001';\nconst submittedBy = $vars.start.output.submittedBy || 'Jane Smith';\nconst amount = $vars.start.output.amount || 250.00;\nconst category = $vars.start.output.category || 'Travel';\nreturn {\n  expenseId: expenseId,\n  submittedBy: submittedBy,\n  amount: amount,\n  category: category\n};"
      }
    },
    {
      "id": "managerApproval",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "Manager Approval"
      },
      "inputs": {
        "title": "Expense Report Approval",
        "priority": "Medium",
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group",
            "name": "expense-approvers"
          }
        },
        "schema": {
          "schemaId": "b2c3d4e5-f6a7-8901-bcde-f12345678901",
          "fields": [
            {
              "id": "expenseid",
              "label": "Expense ID",
              "type": "text",
              "direction": "input",
              "binding": "vars.fetchExpense.output.expenseId"
            },
            {
              "id": "submittedby",
              "label": "Submitted By",
              "type": "text",
              "direction": "input",
              "binding": "vars.fetchExpense.output.submittedBy"
            },
            {
              "id": "amount",
              "label": "Amount",
              "type": "number",
              "direction": "input",
              "binding": "vars.fetchExpense.output.amount"
            },
            {
              "id": "category",
              "label": "Category",
              "type": "text",
              "direction": "input",
              "binding": "vars.fetchExpense.output.category"
            },
            {
              "id": "rejectionreason",
              "label": "Rejection Reason",
              "type": "text",
              "direction": "output",
              "variable": "vars.rejectionReason"
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "Continue"
            }
          ]
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "rejectionreason": {
              "type": "string"
            },
            "Action": {
              "type": "string",
              "enum": [
                "Approve",
                "Reject"
              ],
              "default": "Approve"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": [
            "Approve",
            "Reject"
          ],
          "default": "Approve"
        }
      }
    },
    {
      "id": "checkDecision",
      "type": "core.logic.decision",
      "typeVersion": "1.1",
      "display": {
        "label": "Approved?"
      },
      "inputs": {
        "expression": "$vars.managerApproval.status === \"Approve\"",
        "trueLabel": "Approved",
        "falseLabel": "Rejected"
      }
    },
    {
      "id": "logOutcome",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log Outcome"
      },
      "inputs": {
        "script": "const decision = $vars.managerApproval.status || 'Unknown';\nconst expenseId = $vars.fetchExpense.output.expenseId || '';\nconst submittedBy = $vars.fetchExpense.output.submittedBy || '';\nconst amount = $vars.fetchExpense.output.amount || 0;\nconst category = $vars.fetchExpense.output.category || '';\nconst rejectionReason = $vars.managerApproval.output.rejectionreason || '';\nconst suffix = (decision === 'Reject' && rejectionReason) ? ' | Reason: ' + rejectionReason : '';\nreturn {\n  expenseId: expenseId,\n  submittedBy: submittedBy,\n  amount: amount,\n  category: category,\n  decision: decision,\n  rejectionReason: rejectionReason,\n  logMessage: decision.toUpperCase() + ': Expense ' + expenseId + ' by ' + submittedBy + ' | Amount: ' + amount + ' | Category: ' + category + suffix\n};"
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      }
    }
  ],
  "edges": [
    {
      "id": "e-start-fetch",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "fetchExpense",
      "targetPort": "input"
    },
    {
      "id": "e-fetch-hitl",
      "sourceNodeId": "fetchExpense",
      "sourcePort": "success",
      "targetNodeId": "managerApproval",
      "targetPort": "input"
    },
    {
      "id": "e-hitl-decision",
      "sourceNodeId": "managerApproval",
      "sourcePort": "completed",
      "targetNodeId": "checkDecision",
      "targetPort": "input"
    },
    {
      "id": "e-decision-approved-log",
      "sourceNodeId": "checkDecision",
      "sourcePort": "true",
      "targetNodeId": "logOutcome",
      "targetPort": "input"
    },
    {
      "id": "e-decision-rejected-log",
      "sourceNodeId": "checkDecision",
      "sourcePort": "false",
      "targetNodeId": "logOutcome",
      "targetPort": "input"
    },
    {
      "id": "e-log-end",
      "sourceNodeId": "logOutcome",
      "sourcePort": "success",
      "targetNodeId": "end",
      "targetPort": "input"
    }
  ],
  "definitions": [
    {
      "nodeType": "core.trigger.manual",
      "version": "1.0",
      "category": "trigger",
      "description": "Start workflow manually",
      "tags": [
        "trigger",
        "start",
        "manual"
      ],
      "sortOrder": 40,
      "display": {
        "label": "Manual trigger",
        "icon": "play",
        "shape": "circle"
      },
      "handleConfiguration": [
        {
          "position": "right",
          "handles": [
            {
              "id": "output",
              "type": "source",
              "handleType": "output",
              "showButton": true,
              "constraints": {
                "forbiddenTargetCategories": [
                  "trigger"
                ]
              }
            }
          ],
          "visible": true
        }
      ],
      "model": {
        "type": "bpmn:StartEvent",
        "entryPointId": true
      },
      "outputDefinition": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the workflow.",
          "source": "null",
          "var": "output"
        }
      },
      "toolbarExtensions": {
        "design": {
          "actions": [
            {
              "id": "change-trigger-type",
              "icon": "square-mouse-pointer",
              "label": "Change trigger type"
            }
          ]
        }
      }
    },
    {
      "nodeType": "core.action.script",
      "version": "1.0",
      "category": "data-operations",
      "description": "Run custom JavaScript code",
      "tags": [
        "code",
        "javascript",
        "python"
      ],
      "sortOrder": 35,
      "supportsErrorHandling": true,
      "display": {
        "label": "Script",
        "icon": "code"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ]
        },
        {
          "position": "right",
          "handles": [
            {
              "id": "success",
              "type": "source",
              "handleType": "output"
            },
            {
              "id": "error",
              "label": "Error",
              "type": "source",
              "handleType": "output",
              "visible": "{inputs.errorHandlingEnabled}",
              "constraints": {
                "maxConnections": 1
              }
            }
          ]
        }
      ],
      "debug": {
        "runtime": "clientScript"
      },
      "model": {
        "type": "bpmn:ScriptTask"
      },
      "inputDefinition": {
        "type": "object",
        "properties": {
          "script": {
            "type": "string",
            "minLength": 1,
            "errorMessage": "A script function is required",
            "validationSeverity": "warning"
          }
        },
        "required": [
          "script"
        ]
      },
      "inputDefaults": {
        "script": ""
      },
      "outputDefinition": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "nodeType": "uipath.human-in-the-loop.quick-form",
      "version": "1.0",
      "category": "human-task",
      "description": "Fast inline approvals with inline debug",
      "tags": [
        "human-task",
        "hitl",
        "human-in-the-loop",
        "quick-form",
        "approval"
      ],
      "sortOrder": 27,
      "display": {
        "label": "Quick Form",
        "icon": "users",
        "shape": "square"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ],
          "visible": true
        },
        {
          "position": "right",
          "handles": [
            {
              "id": "completed",
              "type": "source",
              "handleType": "output",
              "showButton": true,
              "constraints": {
                "forbiddenTargetCategories": [
                  "trigger"
                ]
              }
            }
          ],
          "visible": true
        }
      ],
      "model": {
        "type": "bpmn:UserTask",
        "serviceType": "Actions.HITL"
      },
      "inputDefaults": {
        "schema": {
          "fields": [],
          "outcomes": [
            {
              "id": "submit",
              "name": "Submit",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            }
          ]
        },
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group"
          }
        }
      },
      "outputDefinition": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output"
        },
        "status": {
          "type": "string",
          "description": "Task completion status (completed, cancelled, timeout)",
          "source": "=result.Action",
          "var": "status"
        }
      }
    },
    {
      "nodeType": "core.logic.decision",
      "version": "1.1",
      "category": "control-flow",
      "description": "Branch based on a true/false condition",
      "tags": [
        "control-flow",
        "if",
        "loop",
        "switch"
      ],
      "sortOrder": 20,
      "display": {
        "label": "Decision",
        "icon": "trending-up-down"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ],
          "visible": true
        },
        {
          "position": "right",
          "handles": [
            {
              "id": "true",
              "type": "source",
              "handleType": "output",
              "label": "{inputs.trueLabel}",
              "constraints": {
                "minConnections": 1
              }
            },
            {
              "id": "false",
              "type": "source",
              "handleType": "output",
              "label": "{inputs.falseLabel}"
            }
          ],
          "visible": true
        }
      ],
      "debug": {
        "runtime": "clientScript"
      },
      "model": {
        "type": "bpmn:InclusiveGateway"
      },
      "inputDefinition": {
        "type": "object",
        "properties": {
          "expression": {
            "type": "string",
            "minLength": 1,
            "errorMessage": "A condition expression is required"
          },
          "trueLabel": {
            "type": "string"
          },
          "falseLabel": {
            "type": "string"
          }
        },
        "required": [
          "expression"
        ]
      },
      "outputDefinition": {
        "matchedCase": {
          "type": "string",
          "description": "The label of the matched branch (true/false label)",
          "var": "matchedCase"
        },
        "matchedCaseId": {
          "type": "string",
          "description": "The branch that was taken (true or false)",
          "var": "matchedCaseId"
        }
      },
      "inputDefaults": {
        "trueLabel": "True",
        "falseLabel": "False"
      }
    },
    {
      "nodeType": "core.control.end",
      "version": "1.0",
      "category": "control-flow",
      "description": "Mark the end of a workflow path",
      "tags": [
