{
  "id": "915afe62-a5de-4f94-8d78-be1cb7266b99",
  "version": "1.8",
  "name": "ExpenseApproval",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Expense Submitted"
      },
      "inputs": {
        "entryPointId": "88ac545b-b75b-4414-b716-5f88f146591e",
        "isDefaultEntryPoint": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the workflow.",
          "source": "null",
          "var": "output"
        }
      }
    },
    {
      "id": "validateExpense",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Validate Expense"
      },
      "inputs": {
        "script": "var input = $vars.start.output || {};\nvar employeeName = input.employeeName || \"John Doe\";\nvar amount = input.amount || 150.00;\nvar category = input.category || \"Travel\";\nvar expenseId = input.expenseId || \"EXP-\" + Math.floor(Math.random() * 90000 + 10000);\nif (amount <= 0) { return { valid: false, error: \"Amount must be positive\" }; }\nif (!employeeName) { return { valid: false, error: \"Employee name is required\" }; }\nreturn { valid: true, expenseId: expenseId, employeeName: employeeName, amount: amount, category: category, submittedAt: \"2026-07-24T17:28:00Z\" };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "managerReview",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "Manager Review"
      },
      "inputs": {
        "schema": {
          "schemaId": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
          "fields": [
            {
              "id": "expenseId",
              "label": "Expense ID",
              "type": "text",
              "direction": "input",
              "binding": "vars.validateExpense.output.expenseId"
            },
            {
              "id": "employeeName",
              "label": "Employee Name",
              "type": "text",
              "direction": "input",
              "binding": "vars.validateExpense.output.employeeName"
            },
            {
              "id": "amount",
              "label": "Amount ($)",
              "type": "number",
              "direction": "input",
              "binding": "vars.validateExpense.output.amount"
            },
            {
              "id": "category",
              "label": "Category",
              "type": "text",
              "direction": "input",
              "binding": "vars.validateExpense.output.category"
            },
            {
              "id": "rejectionReason",
              "label": "Rejection Reason (if rejecting)",
              "type": "text",
              "direction": "output",
              "variable": "vars.rejectionReason"
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "Continue"
            }
          ]
        },
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group",
            "name": "expense-approvers"
          }
        },
        "priority": "Medium",
        "title": "Expense Approval Request"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "rejectionReason": {
              "type": "string"
            },
            "Action": {
              "type": "string",
              "enum": [
                "Approve",
                "Reject"
              ],
              "default": "Approve"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": [
            "Approve",
            "Reject"
          ],
          "default": "Approve"
        }
      }
    },
    {
      "id": "recordDecision",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Record Decision"
      },
      "inputs": {
        "script": "var status = $vars.managerReview.status;\nvar rejectionReason = $vars.managerReview.output.rejectionReason;\nvar expense = { expenseId: $vars.validateExpense.output.expenseId, employeeName: $vars.validateExpense.output.employeeName, amount: $vars.validateExpense.output.amount, category: $vars.validateExpense.output.category, status: status, rejectionReason: status === \"Reject\" ? rejectionReason : null, processedAt: \"2026-07-24T17:28:00Z\" };\nreturn { expense: expense, message: status === \"Approve\" ? \"Expense approved and recorded.\" : \"Expense rejected and recorded.\" };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {}
    }
  ],
  "edges": [
    {
      "id": "edge-start-validate",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "validateExpense",
      "targetPort": "input"
    },
    {
      "id": "edge-validate-hitl",
      "sourceNodeId": "validateExpense",
      "sourcePort": "success",
      "targetNodeId": "managerReview",
      "targetPort": "input"
    },
    {
      "id": "edge-hitl-record",
      "sourceNodeId": "managerReview",
      "sourcePort": "completed",
      "targetNodeId": "recordDecision",
      "targetPort": "input"
    },
    {
      "id": "edge-record-end",
      "sourceNodeId": "recordDecision",
      "sourcePort": "success",
      "targetNodeId": "end",
      "targetPort": "input"
    }
  ],
  "definitions": [
