  ],
  "variables": {
    "globals": [
      {
        "id": "expenseId",
        "direction": "in",
        "type": "string",
        "description": "Unique identifier for the expense report"
      },
      {
        "id": "submittedBy",
        "direction": "in",
        "type": "string",
        "description": "Name of the employee who submitted the expense"
      },
      {
        "id": "amount",
        "direction": "in",
        "type": "number",
        "description": "Total amount of the expense in dollars"
      },
      {
        "id": "category",
        "direction": "in",
        "type": "string",
        "description": "Expense category (e.g. Travel, Meals, Software)"
      },
      {
        "id": "managerComments",
        "direction": "out",
        "type": "string",
        "description": "Comments entered by the manager during review"
      },
      {
        "id": "approvalDecision",
        "direction": "out",
        "type": "string",
        "description": "Final decision: Approve or Reject"
      },
      {
        "id": "approvalLog",
        "direction": "out",
        "type": "string",
        "description": "Full log entry recording the manager decision"
      }
    ],
    "nodes": [
