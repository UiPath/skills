{
  "id": "50df0d25-b4ab-4b43-b6f5-0c7b5a456d2c",
  "version": "1.8",
  "name": "ExpenseApproval",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "04ef4d80-1829-477f-9a4c-4fc43320b850",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "preparePacket",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Prepare Review Packet"
      },
      "inputs": {
        "script": "const expenseId = $vars.expenseId;\nconst submittedBy = $vars.submittedBy;\nconst amount = $vars.amount;\nconst category = $vars.category;\nreturn {\n  expenseId: expenseId,\n  submittedBy: submittedBy,\n  amount: amount,\n  category: category,\n  summary: `Expense #${expenseId} submitted by ${submittedBy} for $${amount} (${category})`\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "managerReview",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "Manager Review"
      },
      "inputs": {
        "title": "Expense Report Approval",
        "priority": "Medium",
        "schema": {
          "schemaId": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
          "fields": [
            {
              "id": "expenseid",
              "label": "Expense ID",
              "type": "text",
              "direction": "input",
              "binding": "vars.preparePacket.output.expenseId"
            },
            {
              "id": "submittedby",
              "label": "Submitted By",
              "type": "text",
              "direction": "input",
              "binding": "vars.preparePacket.output.submittedBy"
            },
            {
              "id": "amount",
              "label": "Amount ($)",
              "type": "number",
              "direction": "input",
              "binding": "vars.preparePacket.output.amount"
            },
            {
              "id": "category",
              "label": "Category",
              "type": "text",
              "direction": "input",
              "binding": "vars.preparePacket.output.category"
            },
            {
              "id": "comments",
              "label": "Manager Comments",
              "type": "text",
              "direction": "output",
              "variable": "vars.managerComments"
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "Continue"
            }
          ]
        },
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group",
            "name": "expense-approvers"
          }
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "comments": {
              "type": "string"
            },
            "Action": {
              "type": "string",
              "enum": [
                "Approve",
                "Reject"
              ],
              "default": "Approve"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": [
            "Approve",
            "Reject"
          ],
          "default": "Approve"
        }
      }
    },
    {
      "id": "logDecision",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log Decision"
      },
      "inputs": {
        "script": "const expenseId = $vars.preparePacket.output.expenseId;\nconst submittedBy = $vars.preparePacket.output.submittedBy;\nconst amount = $vars.preparePacket.output.amount;\nconst category = $vars.preparePacket.output.category;\nconst decision = $vars.managerReview.status;\nconst comments = $vars.managerReview.output.comments || '';\nreturn {\n  decision: decision,\n  expenseId: expenseId,\n  submittedBy: submittedBy,\n  amount: amount,\n  category: category,\n  managerComments: comments,\n  logEntry: `${decision.toUpperCase()}: Expense #${expenseId} by ${submittedBy} ($${amount}, ${category}). Manager notes: ${comments}`\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "done",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Done"
      },
      "inputs": {},
      "outputs": {
        "approvalDecision": {
          "source": "=js:$vars.logDecision.output.decision"
        },
        "approvalLog": {
          "source": "=js:$vars.logDecision.output.logEntry"
        },
        "managerComments": {
          "source": "=js:$vars.managerReview.output.comments || ''"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "preparePacket",
      "targetPort": "input"
    },
    {
      "id": "e2",
      "sourceNodeId": "preparePacket",
      "sourcePort": "success",
      "targetNodeId": "managerReview",
      "targetPort": "input"
    },
    {
      "id": "e3",
      "sourceNodeId": "managerReview",
      "sourcePort": "completed",
      "targetNodeId": "logDecision",
      "targetPort": "input"
    },
    {
      "id": "e4",
      "sourceNodeId": "logDecision",
      "sourcePort": "success",
      "targetNodeId": "done",
      "targetPort": "input"
    }
  ],
  "definitions": [
    {
