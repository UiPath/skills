{
  "id": "9b74ee38-8dd5-4f62-9f27-5421bdb17505",
  "version": "1.8",
  "name": "ExpenseApproval",
  "nodes": [
    {
      "id": "fetchExpense",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Fetch Expense Details"
      },
      "inputs": {
        "script": "// Mock: replace this node with an HTTP or RPA node to call your real expense system\nconst expenseId = ($vars.start.output && $vars.start.output.expenseId) || \"EXP-2024-0042\";\nreturn {\n  expenseId: expenseId,\n  submittedBy: \"Jane Smith\",\n  expenseAmount: 450.00,\n  expenseDescription: \"Client dinner — Q3 business development\",\n  submittedDate: \"2024-07-24\",\n  category: \"Entertainment\"\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Submit Expense Report"
      },
      "inputs": {
        "entryPointId": "b56c7797-c50c-43f5-968b-ed5633adaad2",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "managerReview",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "Manager Review"
      },
      "inputs": {
        "title": "Expense Report Approval",
        "priority": "Medium",
        "schema": {
          "schemaId": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
          "fields": [
            {
              "id": "expenseId",
              "label": "Expense ID",
              "type": "text",
              "direction": "input",
              "binding": "vars.fetchExpense.output.expenseId"
            },
            {
              "id": "submittedBy",
              "label": "Submitted By",
              "type": "text",
              "direction": "input",
              "binding": "vars.fetchExpense.output.submittedBy"
            },
            {
              "id": "expenseAmount",
              "label": "Amount ($)",
              "type": "number",
              "direction": "input",
              "binding": "vars.fetchExpense.output.expenseAmount"
            },
            {
              "id": "expenseDescription",
              "label": "Description",
              "type": "text",
              "direction": "input",
              "binding": "vars.fetchExpense.output.expenseDescription"
            },
            {
              "id": "category",
              "label": "Category",
              "type": "text",
              "direction": "input",
              "binding": "vars.fetchExpense.output.category"
            },
            {
              "id": "rejectionReason",
              "label": "Rejection Reason (required if rejecting)",
              "type": "text",
              "direction": "output",
              "variable": "vars.rejectionReason"
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "Continue"
            }
          ]
        },
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group",
            "name": "expense-approvers"
          }
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "rejectionReason": {
              "type": "string"
            },
            "Action": {
              "type": "string",
              "enum": [
                "Approve",
                "Reject"
              ],
              "default": "Approve"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": [
            "Approve",
            "Reject"
          ],
          "default": "Approve"
        }
      }
    },
    {
      "id": "logDecision",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log Decision"
      },
      "inputs": {
        "script": "const decision = $vars.managerReview.status;\nconst rejectionReason = ($vars.managerReview.output && $vars.managerReview.output.rejectionReason) || \"\";\nconst expense = $vars.fetchExpense.output;\nreturn {\n  logged: true,\n  expenseId: expense.expenseId,\n  submittedBy: expense.submittedBy,\n  amount: expense.expenseAmount,\n  decision: decision,\n  rejectionReason: decision === \"Reject\" ? rejectionReason : null,\n  outcome: decision === \"Approve\" ? \"Approved and queued for payment\" : \"Rejected and returned to submitter\"\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      }
    }
  ],
  "edges": [
    {
      "id": "edge-start-to-fetch",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "fetchExpense",
      "targetPort": "input"
    },
    {
      "id": "edge-fetch-to-review",
      "sourceNodeId": "fetchExpense",
      "sourcePort": "success",
      "targetNodeId": "managerReview",
      "targetPort": "input"
    },
    {
      "id": "edge-review-to-log",
      "sourceNodeId": "managerReview",
      "sourcePort": "completed",
      "targetNodeId": "logDecision",
      "targetPort": "input"
    },
    {
      "id": "edge-log-to-end",
      "sourceNodeId": "logDecision",
      "sourcePort": "success",
      "targetNodeId": "end",
      "targetPort": "input"
    }
  ],
  "definitions": [
    {
      "nodeType": "core.action.script",
      "version": "1.0",
      "category": "data-operations",
      "description": "Run custom JavaScript code",
      "tags": [
        "code",
        "javascript",
        "python"
      ],
      "sortOrder": 35,
      "supportsErrorHandling": true,
      "display": {
        "label": "Script",
