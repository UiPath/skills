{
  "id": "cf1649bc-6b79-46be-bdb7-13c7f248dfdd",
  "version": "1.8",
  "name": "ExpenseApproval",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "d95d16a2-d333-4664-8518-09d03bb6fa1c",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "expenseReview1",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "Expense Review"
      },
      "inputs": {
        "title": "Expense Review",
        "recipient": {
          "channels": ["Email", "ActionCenter"],
          "connections": {},
          "assignee": { "type": "group" }
        },
        "priority": "Low",
        "schema": {
          "schemaId": "b4e2a1f7-3c6d-4e8b-a9d0-7f2c5e1b3a6d",
          "fields": [
            {
              "id": "amount",
              "label": "Expense Amount",
              "type": "number",
              "direction": "input",
              "binding": "vars.start.output.amount"
            },
            {
              "id": "requestername",
              "label": "Requester Name",
              "type": "string",
              "direction": "input",
              "binding": "vars.start.output.requesterName"
            },
            {
              "id": "category",
              "label": "Category",
              "type": "string",
              "direction": "input",
              "binding": "vars.start.output.category"
            },
            {
              "id": "approved",
              "label": "Approved",
              "type": "boolean",
              "direction": "output",
              "variable": "vars.approved",
              "required": true
            },
            {
              "id": "comments",
              "label": "Comments",
              "type": "string",
              "direction": "output",
              "variable": "vars.comments"
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "End"
            }
          ]
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "approved":  { "type": "boolean" },
            "comments":  { "type": "string" },
            "Action":    { "type": "string", "enum": ["Approve", "Reject"], "default": "Approve" }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": ["Approve", "Reject"],
          "default": "Approve"
        }
      }
    },
    {
      "id": "logDecision1",
      "type": "core.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log Decision"
      },
      "inputs": {
        "script": "const approved = $vars.expenseReview1.output.approved;\nconst comments = $vars.expenseReview1.output.comments;\nconsole.log(`Decision: ${approved}, Comments: ${comments}`);\nreturn { approved, comments };"
      }
    },
    {
      "id": "end1",
      "type": "core.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {}
    }
  ],
  "edges": [
    {
      "id": "start-output-expenseReview1-input",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "expenseReview1",
      "targetPort": "input"
    },
    {
      "id": "expenseReview1-completed-logDecision1-input",
      "sourceNodeId": "expenseReview1",
      "sourcePort": "completed",
      "targetNodeId": "logDecision1",
      "targetPort": "input"
    },
    {
      "id": "logDecision1-output-end1-input",
      "sourceNodeId": "logDecision1",
      "sourcePort": "output",
      "targetNodeId": "end1",
      "targetPort": "input"
    }
  ],
  "definitions": [
