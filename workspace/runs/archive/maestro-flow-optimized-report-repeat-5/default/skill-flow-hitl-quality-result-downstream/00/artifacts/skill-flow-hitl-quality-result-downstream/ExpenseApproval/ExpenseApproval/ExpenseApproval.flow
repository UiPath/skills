{
  "id": "51293299-edd0-4099-ba54-2ab097e78c29",
  "version": "1.8",
  "name": "ExpenseApproval",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "41a20c5f-73a0-47ac-a1b4-b92d962e9b8c",
        "isDefaultEntryPoint": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the trigger.",
          "source": "null",
          "var": "output"
        }
      }
    },
    {
      "id": "expenseReview1",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "Expense Review"
      },
      "inputs": {
        "title": "Expense Review",
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group"
          }
        },
        "priority": "Low",
        "schema": {
          "schemaId": "400aec13-2025-479f-9660-61a37dc081c9",
          "fields": [
            {
              "id": "expenseamount",
              "label": "Expense Amount",
              "type": "number",
              "direction": "input",
              "binding": "vars.start.output.expenseAmount"
            },
            {
              "id": "requestername",
              "label": "Requester Name",
              "type": "string",
              "direction": "input",
              "binding": "vars.start.output.requesterName"
            },
            {
              "id": "category",
              "label": "Category",
              "type": "string",
              "direction": "input",
              "binding": "vars.start.output.category"
            },
            {
              "id": "approved",
              "label": "Approved",
              "type": "boolean",
              "direction": "output",
              "variable": "vars.approved",
              "required": true
            },
            {
              "id": "comments",
              "label": "Comments",
              "type": "string",
              "direction": "output",
              "variable": "vars.comments",
              "required": false
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "End"
            }
          ]
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "approved": {
              "type": "boolean"
            },
            "comments": {
              "type": "string"
            },
            "Action": {
              "type": "string",
              "enum": [
                "Approve",
                "Reject"
              ],
              "default": "Approve"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": [
            "Approve",
            "Reject"
          ],
          "default": "Approve"
        }
      }
    },
    {
      "id": "logDecision1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log Decision"
      },
      "inputs": {
        "script": "const approved = $vars.expenseReview1.output.approved;\nconst comments = $vars.expenseReview1.output.comments;\nreturn { message: 'Decision: ' + approved + ', Comments: ' + comments };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {}
    }
  ],
  "edges": [
    {
      "id": "edge-start-expenseReview1",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "expenseReview1",
      "targetPort": "input"
    },
    {
      "id": "edge-expenseReview1-logDecision1",
      "sourceNodeId": "expenseReview1",
      "sourcePort": "completed",
      "targetNodeId": "logDecision1",
      "targetPort": "input"
    },
    {
      "id": "edge-logDecision1-end",
      "sourceNodeId": "logDecision1",
      "sourcePort": "success",
      "targetNodeId": "end",
      "targetPort": "input"
    }
  ],
