{
  "id": "2466ae1a-2d92-4600-86f9-5268fb00c4f2",
  "version": "1.8",
  "name": "SlackWeatherPipeline",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "e33122b3-b4d7-40d8-9fa8-ad9f9756958a",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "getOfficeBellevueChannelInfo1",
      "type": "uipath.connector.uipath-salesforce-slack.get-channel-info",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Get Office-Bellevue Channel Info"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-salesforce-slack",
          "connectionId": "849e85d8-1aa9-4d52-8bbd-20041c8f05d8",
          "connectionResourceId": "849e85d8-1aa9-4d52-8bbd-20041c8f05d8",
          "connectionFolderKey": "5da18ec0-7de1-4e57-aaf1-ddc8a369c199",
          "method": "GET",
          "endpoint": "/ConversationsInfo/{conversationsInfoId}",
          "pathParameters": {
            "conversationsInfoId": "C0B50H7DE2F"
          },
          "uiPathActivityTypeId": "f9995f55-16e3-3c65-b860-af01aa2a1e47",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"instanceParameters\":{\"connectorKey\":\"uipath-salesforce-slack\",\"objectName\":\"ConversationsInfo_GET\",\"httpMethod\":\"GETBYID\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"method\"},\"objectName\":\"ConversationsInfo_GET\",\"operation\":\"retrieve\",\"httpMethod\":\"GET\",\"path\":\"/ConversationsInfo/{conversationsInfoId}\",\"packageVersion\":\"1.0.0\",\"connectorVersion\":null,\"executionType\":null,\"customFieldsRequestDetails\":null,\"unifiedTypesCompatible\":true}}"
        }
      }
    },
    {
      "id": "getCurrentWeather1",
      "type": "uipath.connector.custom-codereval-openmeteoapis.getcurrentweather",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Get Current Weather"
      },
      "inputs": {
        "detail": {
          "connector": "custom-codereval-openmeteoapis",
          "connectionId": "21ca654f-b67b-4f97-9eb3-1f93bd3bb5cc",
          "connectionResourceId": "21ca654f-b67b-4f97-9eb3-1f93bd3bb5cc",
          "connectionFolderKey": "5da18ec0-7de1-4e57-aaf1-ddc8a369c199",
          "method": "GET",
          "endpoint": "/forecast",
          "queryParameters": {
            "latitude": 47.61038,
            "longitude": -122.20068,
            "current_weather": true,
            "temperature_unit": "fahrenheit"
          },
          "uiPathActivityTypeId": "e39eee57-b09f-36fb-b131-4f4feb46b707",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"instanceParameters\":{\"connectorKey\":\"custom-codereval-openmeteoapis\",\"objectName\":\"V1Forecast\",\"httpMethod\":\"GETBYID\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"V1Forecast\",\"operation\":\"retrieve\",\"httpMethod\":\"GET\",\"path\":\"/forecast\",\"packageVersion\":\"1.0.0\",\"connectorVersion\":null,\"executionType\":null,\"customFieldsRequestDetails\":null,\"unifiedTypesCompatible\":true}}"
        }
      }
    },
    {
      "id": "parseCity",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Parse City from Address"
      },
      "inputs": {
        "script": "var address = $vars.getOfficeBellevueChannelInfo1.output.body.channel.purpose.value || '';\nvar parts = address.split(',');\nvar city = parts.length >= 2 ? parts[parts.length - 2].trim() : 'Bellevue';\nreturn { city: city, rawAddress: address };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "checkTemp",
      "type": "core.logic.decision",
      "typeVersion": "1.1",
      "display": {
        "label": "Temperature > 60F?"
      },
      "inputs": {
        "expression": "$vars.getCurrentWeather1.output.body.current_weather.temperature > 60"
      }
    },
    {
      "id": "buildVerdictWarm",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Set Warm Verdict"
      },
      "inputs": {
        "script": "return { verdict: 'warm office today' };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "buildVerdictCold",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Set Cold Verdict"
      },
      "inputs": {
        "script": "return { verdict: 'cold office today' };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "endWarm",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End - Warm"
      },
      "inputs": {},
      "outputs": {
        "verdict": {
          "source": "=js:$vars.buildVerdictWarm.output.verdict"
        }
      }
    },
    {
      "id": "endCold",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End - Cold"
      },
      "inputs": {},
      "outputs": {
        "verdict": {
          "source": "=js:$vars.buildVerdictCold.output.verdict"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "e-start-slackInfo",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "getOfficeBellevueChannelInfo1",
