    {
      "id": "checkAmount",
      "type": "core.logic.decision",
      "typeVersion": "1.1",
      "display": {
        "label": "Amount > 1000?"
      },
      "inputs": {
        "expression": "Number($vars.extractInvoice.output.ExtractionResult.ResultsDocument.Fields.find(f => f.FieldName === 'total_amount')?.Values?.[0]) > 1000",
        "trueLabel": "High Value",
        "falseLabel": "Auto Approve"
      }
    },
    {
      "id": "highValueReview",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "HighValueReview"
      },
      "inputs": {
        "script": "const vendor = $vars.extractInvoice.output.ExtractionResult.ResultsDocument.Fields.find(f => f.FieldName === 'vendor_name')?.Values?.[0] || 'Unknown Vendor';\nconst total = $vars.extractInvoice.output.ExtractionResult.ResultsDocument.Fields.find(f => f.FieldName === 'total_amount')?.Values?.[0] || '0';\nreturn { summary: 'HIGH VALUE REVIEW: Invoice from ' + vendor + ' for amount ' + total + ' requires manual approval.' };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "autoApprove",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "AutoApprove"
      },
      "inputs": {
        "script": "const vendor = $vars.extractInvoice.output.ExtractionResult.ResultsDocument.Fields.find(f => f.FieldName === 'vendor_name')?.Values?.[0] || 'Unknown Vendor';\nconst total = $vars.extractInvoice.output.ExtractionResult.ResultsDocument.Fields.find(f => f.FieldName === 'total_amount')?.Values?.[0] || '0';\nreturn { summary: 'AUTO APPROVED: Invoice from ' + vendor + ' for amount ' + total + ' automatically approved.' };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "endHighValue",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      }
    },
    {
      "id": "endAutoApprove",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      }
    }
  ],
