          "position": "right",
          "boundary": "inner",
          "handles": [
            {
              "id": "continue",
              "label": "continue",
              "type": "target",
              "handleType": "input"
            },
            {
              "id": "break",
              "label": "break",
              "type": "target",
              "handleType": "input",
              "visible": "inputs.breakEnabled"
            }
          ]
        }
      ],
      "model": {
        "type": "bpmn:SubProcess"
      },
      "inputDefinition": {
        "type": "object",
        "properties": {
          "collection": {
            "type": "array"
          },
          "parallel": {
            "type": "boolean"
          },
          "completionCondition": {
            "type": "string"
          },
          "breakEnabled": {
            "type": "boolean"
          }
        },
