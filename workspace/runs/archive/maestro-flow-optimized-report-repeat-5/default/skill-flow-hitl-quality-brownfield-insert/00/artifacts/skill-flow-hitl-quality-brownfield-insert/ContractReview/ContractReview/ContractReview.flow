{
  "id": "678b8a74-91e1-4609-9037-e27b89579f7f",
  "version": "1.8",
  "name": "ContractReview",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "c0db496d-d6a9-4a0d-aca8-9b0be1da63ab",
        "isDefaultEntryPoint": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the trigger.",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "extractMeta",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "extractMeta"
      },
      "inputs": {
        "script": "console.log('Extracting contract metadata'); return { message: 'Extracting contract metadata' };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "legalReview",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "Legal Review"
      },
      "inputs": {
        "schema": {
          "schemaId": "33a05cf7-e37f-42c3-b2f1-106d8855ea69",
          "fields": [
            {
              "id": "contract_id",
              "label": "Contract ID",
              "type": "text",
              "direction": "input",
              "binding": "vars.extractMeta.output.contract_id"
            },
            {
              "id": "contract_value",
              "label": "Contract Value",
              "type": "number",
              "direction": "input",
              "binding": "vars.extractMeta.output.contract_value"
            },
            {
              "id": "approved",
              "label": "Approved",
              "type": "boolean",
              "direction": "output",
              "required": true,
              "variable": "vars.approved"
            },
            {
              "id": "legal_notes",
              "label": "Legal Notes",
              "type": "text",
              "direction": "output",
              "required": false,
              "variable": "vars.legal_notes"
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "End"
            }
          ]
        },
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group"
          }
        },
        "priority": "Low"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "approved": {
              "type": "boolean"
            },
            "legal_notes": {
              "type": "string"
            },
            "Action": {
              "type": "string",
              "enum": [
                "Approve",
                "Reject"
              ],
              "default": "Approve"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": [
            "Approve",
            "Reject"
          ],
          "default": "Approve"
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {}
    }
  ],
  "edges": [
    {
      "id": "edge_start_output_extractMeta_input",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "extractMeta",
      "targetPort": "input"
    },
    {
      "id": "edge_extractMeta_success_legalReview_input",
      "sourceNodeId": "extractMeta",
      "sourcePort": "success",
      "targetNodeId": "legalReview",
      "targetPort": "input"
    },
    {
      "id": "edge_legalReview_completed_end_input",
      "sourceNodeId": "legalReview",
      "sourcePort": "completed",
      "targetNodeId": "end",
      "targetPort": "input"
    }
  ],
  "definitions": [
    {
      "nodeType": "core.trigger.manual",
