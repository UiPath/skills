    {
      "id": "parseExtractionResults1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Parse Extraction Results"
      },
      "inputs": {
        "script": "// Reads the InvoiceIXP extraction result and returns structured invoice fields.\n// Field names depend on how IT configured the InvoiceIXP model — confirm with IT\n// if any field comes back null at runtime (common names shown below).\nconst out = $vars.extractInvoiceFields1.output;\nconst fields = (out && out.ExtractionResult)\n  ? out.ExtractionResult.ResultsDocument.Fields || []\n  : [];\n\nconst getField = (name) => {\n  const f = fields.find(function(f) { return f.FieldName === name; });\n  return f ? (f.Values && f.Values[0] !== undefined ? f.Values[0] : null) : null;\n};\n\n// Try common invoice field names — update to match IT's model taxonomy if needed\nconst invoiceNumber = getField('Invoice Number') || getField('InvoiceNumber') || getField('invoice_number');\nconst vendorName   = getField('Vendor Name')    || getField('VendorName')    || getField('vendor_name');\nconst invoiceDate  = getField('Invoice Date')   || getField('InvoiceDate')   || getField('invoice_date');\nconst totalAmount  = getField('Total Amount')   || getField('TotalAmount')   || getField('total_amount') || getField('Total Due');\n\n// Line items — IXP tables live in ResultsDocument.Tables[]\nconst tables = (out && out.ExtractionResult)\n  ? out.ExtractionResult.ResultsDocument.Tables || []\n  : [];\n\n// Tables.Values[] contains row arrays; each row has Cells[]\nconst lineItems = [];\nif (tables.length > 0) {\n  var tbl = tables[0];\n  var rows = tbl.Values || [];\n  var colInfo = rows.length > 0 ? (rows[0].ColumnInfo || []) : [];\n  var colIdx = function(name) {\n    for (var i = 0; i < colInfo.length; i++) {\n      if (colInfo[i].FieldName === name) return i;\n    }\n    return -1;\n  };\n  var descIdx  = colIdx('Description');\n  var qtyIdx   = colIdx('Quantity');\n  var upIdx    = colIdx('Unit Price');\n  var ltIdx    = colIdx('Line Total') >= 0 ? colIdx('Line Total') : colIdx('Amount');\n  for (var r = 0; r < rows.length; r++) {\n    var cells = rows[r].Cells || [];\n    var cellVal = function(idx) {\n      if (idx < 0 || idx >= cells.length) return null;\n      var v = cells[idx].Values;\n      return (v && v[0]) ? v[0].Value || null : null;\n    };\n    lineItems.push({\n      description: cellVal(descIdx),\n      quantity:    cellVal(qtyIdx),\n      unitPrice:   cellVal(upIdx),\n      lineTotal:   cellVal(ltIdx)\n    });\n  }\n}\n\nreturn { invoiceNumber: invoiceNumber, vendorName: vendorName, invoiceDate: invoiceDate,\n         totalAmount: totalAmount, lineItems: lineItems, lineItemCount: lineItems.length };"
      }
    },
    {
      "id": "end1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Invoice Processed"
      }
