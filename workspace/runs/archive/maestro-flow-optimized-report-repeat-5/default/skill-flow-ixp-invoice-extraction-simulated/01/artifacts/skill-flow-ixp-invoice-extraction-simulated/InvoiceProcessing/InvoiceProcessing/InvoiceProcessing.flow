        "folderName": "Shared",
        "fileRef": "=js:$vars.downloadInvoicePdf1.output",
        "pageRange": "",
        "errorHandlingEnabled": true
      }
    },
    {
      "id": "parseInvoiceFields1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Parse Invoice Fields"
      },
      "inputs": {
        "script": "const fields = ($vars.extractInvoiceFields1.output && $vars.extractInvoiceFields1.output.ExtractionResult && $vars.extractInvoiceFields1.output.ExtractionResult.ResultsDocument) ? ($vars.extractInvoiceFields1.output.ExtractionResult.ResultsDocument.Fields || []) : [];\nconst getField = function(name) {\n  var f = fields.find(function(field) { return field.FieldName === name; });\n  return (f && f.Values && f.Values.length > 0) ? f.Values[0] : null;\n};\nreturn {\n  VendorName: getField('VendorName') || getField('Vendor') || getField('SupplierName') || '',\n  InvoiceNumber: getField('InvoiceNumber') || getField('InvoiceId') || getField('InvoiceNo') || '',\n  InvoiceDate: getField('InvoiceDate') || getField('Date') || '',\n  TotalAmount: getField('TotalAmount') || getField('Amount') || getField('GrossAmount') || '',\n  Currency: getField('Currency') || getField('CurrencyCode') || '',\n  PurchaseOrderNumber: getField('PurchaseOrderNumber') || getField('PONumber') || ''\n};",
        "errorHandlingEnabled": true
      }
    },
    {
      "id": "createSapInvoiceRecord1",
      "type": "uipath.connector.uipath-sap-odata.insert-record",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Create SAP Invoice Record"
      },
      "inputs": {
        "errorHandlingEnabled": true,
        "bodyParameters": "=js:$vars.parseInvoiceFields1.output"
      }
    },
    {
      "id": "invoiceProcessedEnd1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Invoice Processed"
      },
      "inputs": {}
    },
    {
      "id": "downloadFailTerminate1",
      "type": "core.logic.terminate",
      "typeVersion": "1.0",
      "display": {
        "label": "Download Failed"
      },
      "inputs": {}
    },
    {
      "id": "extractionFailTerminate1",
      "type": "core.logic.terminate",
      "typeVersion": "1.0",
      "display": {
        "label": "Extraction Failed"
      },
      "inputs": {}
    },
    {
      "id": "sapFailTerminate1",
      "type": "core.logic.terminate",
      "typeVersion": "1.0",
      "display": {
