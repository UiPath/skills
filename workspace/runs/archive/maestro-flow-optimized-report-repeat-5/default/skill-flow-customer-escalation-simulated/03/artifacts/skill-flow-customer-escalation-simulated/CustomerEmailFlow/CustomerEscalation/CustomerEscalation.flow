  "name": "CustomerEscalation",
  "nodes": [
    {
      "id": "emailReceived1",
      "type": "uipath.connector.trigger.uipath-microsoft-outlook365.email-received",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Email Received"
      },
      "inputs": {
        "entryPointId": "acaec40e-4de9-45af-8e77-2c420579124d",
        "isDefaultEntryPoint": true,
        "detail": {
          "connector": "uipath-microsoft-outlook365",
          "connectionId": "5af6fa90-234d-4b0d-a2f1-3815cfd9e15d",
          "connectionResourceId": "5af6fa90-234d-4b0d-a2f1-3815cfd9e15d",
          "connectionFolderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "eventParameters": {
            "parentFolderId": "AAMkADc3YmExNDZiLTY3ODMtNGZlMy1iNDQ0LTNiMTE0MDRjNzljMgAuAAAAAADoMGLM4jLUQ6xxQfoAdqTFAQBKthe0RNZlRpEaiq3vHYncAAAAAAEMAAA="
          },
          "objectName": "Message",
          "eventType": "EMAIL_RECEIVED",
          "eventMode": "polling",
          "filterExpression": "(parentFolderId == 'AAMkADc3YmExNDZiLTY3ODMtNGZlMy1iNDQ0LTNiMTE0MDRjNzljMgAuAAAAAADoMGLM4jLUQ6xxQfoAdqTFAQBKthe0RNZlRpEaiq3vHYncAAAAAAEMAAA=')",
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"instanceParameters\":{\"connectorKey\":\"uipath-microsoft-outlook365\",\"objectName\":\"Message\",\"activityType\":\"CuratedTrigger\",\"version\":\"1.0.0\",\"eventOperation\":\"EMAIL_RECEIVED\",\"eventMode\":\"polling\",\"supportsStreaming\":false},\"objectName\":\"Message\",\"packageVersion\":\"1.0.0\",\"connectorVersion\":null,\"executionType\":null,\"httpMethod\":null,\"path\":null,\"filter\":null}}",
          "uiPathActivityTypeId": "d76ca053-6e7e-3472-b98c-3094b802d83c",
          "errorState": {
            "issues": []
          }
        }
      }
    },
    {
      "id": "triageEmail1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Triage: Urgent + VIP?"
      },
      "inputs": {
        "script": "const subject = ($vars.emailReceived1.output.subject || '').toLowerCase();\nconst bodyContent = ($vars.emailReceived1.output.body && $vars.emailReceived1.output.body.content)\n  ? $vars.emailReceived1.output.body.content\n  : ($vars.emailReceived1.output.bodyPreview || '');\nconst body = bodyContent.toLowerCase();\nconst fromAddr = ($vars.emailReceived1.output.from && $vars.emailReceived1.output.from.emailAddress)\n  ? ($vars.emailReceived1.output.from.emailAddress.address || '').toLowerCase()\n  : '';\nconst fromName = ($vars.emailReceived1.output.from && $vars.emailReceived1.output.from.emailAddress)\n  ? ($vars.emailReceived1.output.from.emailAddress.name || '').toLowerCase()\n  : '';\nconst combined = subject + ' ' + body;\n\nconst urgentKeywords = ['urgent', 'asap', 'critical', 'emergency', 'outage', 'down', 'immediately', 'p0', 'blocker', 'fire', 'high priority', 'sev1', 'severity 1'];\nconst vipKeywords = ['vip', 'enterprise', 'premium', 'diamond', 'gold tier', 'executive', 'priority customer', 'strategic account', 'key account'];\n\nconst isUrgent = urgentKeywords.some(function(k) { return combined.indexOf(k) !== -1; });\nconst isVip = vipKeywords.some(function(k) {\n  return combined.indexOf(k) !== -1 || fromAddr.indexOf(k) !== -1 || fromName.indexOf(k) !== -1;\n});\n\nreturn {\n  isUrgent: isUrgent,\n  isVip: isVip,\n  emailId: $vars.emailReceived1.output.id || '',\n  fromAddress: fromAddr,\n  fromName: ($vars.emailReceived1.output.from && $vars.emailReceived1.output.from.emailAddress)\n    ? ($vars.emailReceived1.output.from.emailAddress.name || fromAddr)\n    : fromAddr,\n  subject: $vars.emailReceived1.output.subject || '(no subject)'\n};"
      }
    },
    {
      "id": "isUrgentVip1",
      "type": "core.logic.decision",
      "typeVersion": "1.1",
      "display": {
        "label": "Urgent AND VIP?"
      },
      "inputs": {
        "expression": "$vars.triageEmail1.output.isUrgent && $vars.triageEmail1.output.isVip",
        "trueLabel": "Urgent + VIP",
        "falseLabel": "Everything Else"
      }
    },
    {
      "id": "postVipAlertToSlack1",
      "type": "uipath.connector.uipath-salesforce-slack.send-message-to-channel",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Post VIP Alert to Slack"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-salesforce-slack",
          "connectionId": "849e85d8-1aa9-4d52-8bbd-20041c8f05d8",
          "connectionResourceId": "849e85d8-1aa9-4d52-8bbd-20041c8f05d8",
          "connectionFolderKey": "5da18ec0-7de1-4e57-aaf1-ddc8a369c199",
          "method": "POST",
          "endpoint": "/send_message_to_channel_v2",
          "bodyParameters": {
            "channel": "C01G1P7CU58",
            "messageToSend": "=js:\"\\uD83D\\uDEA8 VIP Escalation: Urgent email from \" + ($vars.triageEmail1.output.fromName || $vars.triageEmail1.output.fromAddress || \"unknown\") + \" \\u2014 Subject: \" + ($vars.triageEmail1.output.subject || \"(no subject)\") + \". Please respond immediately.\""
          },
          "uiPathActivityTypeId": "37a305b2-89b1-315d-b73f-1778839a6c47",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"instanceParameters\":{\"connectorKey\":\"uipath-salesforce-slack\",\"objectName\":\"send_message_to_channel_v2\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"send_message_to_channel_v2\",\"operation\":\"create\",\"httpMethod\":\"POST\",\"path\":\"/send_message_to_channel_v2\",\"packageVersion\":\"1.0.0\",\"connectorVersion\":null,\"executionType\":null,\"customFieldsRequestDetails\":null,\"unifiedTypesCompatible\":true,\"savedJitInputFieldId\":\"in_send_message_to_channel_v2\"}}"
        }
      }
    },
    {
      "id": "sendVipAcknowledgment1",
      "type": "uipath.connector.uipath-microsoft-outlook365.reply-to-email",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Send VIP Acknowledgment"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-microsoft-outlook365",
          "connectionId": "5af6fa90-234d-4b0d-a2f1-3815cfd9e15d",
          "connectionResourceId": "5af6fa90-234d-4b0d-a2f1-3815cfd9e15d",
          "connectionFolderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "method": "POST",
          "endpoint": "/ReplyToEmailV2",
          "bodyParameters": {
            "comment": "=js:\"Dear \" + ($vars.triageEmail1.output.fromName || \"Customer\") + \",\\n\\nWe have received your urgent message and our team is on it right now. You will hear back from us very shortly.\\n\\nBest regards,\\nSupport Team\""
          },
          "queryParameters": {
            "id": "=js:$vars.emailReceived1.output.id",
            "saveAsDraft": false
          },
          "uiPathActivityTypeId": "da9976dd-3d71-35b4-bb8c-509419cb46eb",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"instanceParameters\":{\"connectorKey\":\"uipath-microsoft-outlook365\",\"objectName\":\"ReplyToEmailV2\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"ReplyToEmailV2\",\"operation\":\"create\",\"httpMethod\":\"POST\",\"path\":\"/ReplyToEmailV2\",\"packageVersion\":\"1.0.0\",\"connectorVersion\":null,\"executionType\":null,\"customFieldsRequestDetails\":null,\"unifiedTypesCompatible\":true}}",
          "multipartParameters": [
            {
              "name": "file",
              "dataType": "file"
            },
            {
              "name": "body",
              "dataType": "string"
            }
          ],
          "inputMetadata": {
            "type": "multipart",
            "multipart": {
              "bodyFieldName": "body"
            }
          }
        }
      }
    },
    {
      "id": "endVip1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End (VIP Path)"
      },
      "inputs": {}
    },
    {
      "id": "createTicket1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Create Support Ticket"
      },
      "inputs": {
        "script": "const emailId = $vars.emailReceived1.output.id || '';\nconst subject = $vars.emailReceived1.output.subject || '(no subject)';\nconst fromAddr = ($vars.emailReceived1.output.from && $vars.emailReceived1.output.from.emailAddress)\n  ? ($vars.emailReceived1.output.from.emailAddress.address || 'unknown')\n  : 'unknown';\nconst receivedAt = $vars.emailReceived1.output.receivedDateTime || $vars.emailReceived1.output.sentDateTime || '';\n\n// Generate a deterministic ticket ID from the email ID characters\nvar hash = 0;\nfor (var i = 0; i < emailId.length && i < 16; i++) {\n  hash = (hash * 31 + emailId.charCodeAt(i)) & 0x7fffffff;\n}\nvar ticketNum = (hash % 900000) + 100000;\nvar ticketId = 'TKT-' + ticketNum;\n\nreturn {\n  ticketId: ticketId,\n  emailId: emailId,\n  subject: subject,\n  fromAddress: fromAddr,\n  receivedAt: receivedAt,\n  replyBody: 'Dear Customer,\\n\\nThank you for contacting support. Your request has been received and a support ticket has been created for you.\\n\\nTicket ID: ' + ticketId + '\\nSubject: ' + subject + '\\nReceived: ' + receivedAt + '\\n\\nOur team will review your request and get back to you as soon as possible.\\n\\nBest regards,\\nSupport Team'\n};"
      }
    },
    {
      "id": "sendTicketReply1",
      "type": "uipath.connector.uipath-microsoft-outlook365.reply-to-email",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Send Ticket Reply"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-microsoft-outlook365",
          "connectionId": "5af6fa90-234d-4b0d-a2f1-3815cfd9e15d",
          "connectionResourceId": "5af6fa90-234d-4b0d-a2f1-3815cfd9e15d",
          "connectionFolderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "method": "POST",
          "endpoint": "/ReplyToEmailV2",
          "bodyParameters": {
            "comment": "=js:$vars.createTicket1.output.replyBody"
          },
          "queryParameters": {
            "id": "=js:$vars.emailReceived1.output.id",
            "saveAsDraft": false
          },
          "uiPathActivityTypeId": "da9976dd-3d71-35b4-bb8c-509419cb46eb",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"instanceParameters\":{\"connectorKey\":\"uipath-microsoft-outlook365\",\"objectName\":\"ReplyToEmailV2\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"ReplyToEmailV2\",\"operation\":\"create\",\"httpMethod\":\"POST\",\"path\":\"/ReplyToEmailV2\",\"packageVersion\":\"1.0.0\",\"connectorVersion\":null,\"executionType\":null,\"customFieldsRequestDetails\":null,\"unifiedTypesCompatible\":true}}",
          "multipartParameters": [
            {
              "name": "file",
              "dataType": "file"
            },
            {
              "name": "body",
              "dataType": "string"
            }
          ],
          "inputMetadata": {
            "type": "multipart",
            "multipart": {
              "bodyFieldName": "body"
            }
          }
        }
      }
    },
