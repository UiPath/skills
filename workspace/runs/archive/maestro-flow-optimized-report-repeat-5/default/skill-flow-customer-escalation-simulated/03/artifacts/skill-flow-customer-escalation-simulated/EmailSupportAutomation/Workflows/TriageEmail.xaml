<Activity mc:Ignorable="sap sap2010" x:Class="Workflows_TriageEmail"
  mva:VisualBasic.Settings="{x:Null}"
  xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:mva="clr-namespace:Microsoft.VisualBasic.Activities;assembly=System.Activities"
  xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation"
  xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
  xmlns:sco="clr-namespace:System.Collections.ObjectModel;assembly=mscorlib"
  xmlns:ui="http://schemas.uipath.com/workflow/activities"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Members>
    <x:Property Name="in_Subject" Type="InArgument(x:String)" />
    <x:Property Name="in_Body" Type="InArgument(x:String)" />
    <x:Property Name="out_Category" Type="OutArgument(x:String)" />
    <x:Property Name="out_Priority" Type="OutArgument(x:String)" />
  </x:Members>
  <TextExpression.NamespacesForImplementation>
    <sco:Collection x:TypeArguments="x:String">
      <x:String>System.Activities</x:String>
      <x:String>System.Activities.Statements</x:String>
      <x:String>Microsoft.VisualBasic</x:String>
      <x:String>Microsoft.VisualBasic.Activities</x:String>
      <x:String>System</x:String>
      <x:String>System.Collections.Generic</x:String>
      <x:String>System.Linq</x:String>
      <x:String>UiPath.Core</x:String>
      <x:String>UiPath.Core.Activities</x:String>
    </sco:Collection>
  </TextExpression.NamespacesForImplementation>
  <TextExpression.ReferencesForImplementation>
    <sco:Collection x:TypeArguments="AssemblyReference">
      <AssemblyReference>System.Activities</AssemblyReference>
      <AssemblyReference>Microsoft.VisualBasic</AssemblyReference>
      <AssemblyReference>System.Private.CoreLib</AssemblyReference>
      <AssemblyReference>mscorlib</AssemblyReference>
      <AssemblyReference>System</AssemblyReference>
      <AssemblyReference>System.Linq</AssemblyReference>
      <AssemblyReference>UiPath.System.Activities</AssemblyReference>
    </sco:Collection>
  </TextExpression.ReferencesForImplementation>
  <Sequence DisplayName="Triage Email" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="subjectLower" Default="&quot;&quot;" />
      <Variable x:TypeArguments="x:String" Name="bodyLower" Default="&quot;&quot;" />
      <Variable x:TypeArguments="x:String" Name="combinedText" Default="&quot;&quot;" />
    </Sequence.Variables>

    <!-- Normalize subject and body to lowercase for keyword matching -->
    <Assign x:TypeArguments="x:String" DisplayName="Normalize Subject">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">
          <VisualBasicReference x:TypeArguments="x:String" ExpressionText="subjectLower" />
        </OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">
          <VisualBasicValue x:TypeArguments="x:String" ExpressionText="If(in_Subject IsNot Nothing, in_Subject.ToLower(), &quot;&quot;)" />
        </InArgument>
      </Assign.Value>
    </Assign>

    <Assign x:TypeArguments="x:String" DisplayName="Normalize Body">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">
          <VisualBasicReference x:TypeArguments="x:String" ExpressionText="bodyLower" />
        </OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">
          <VisualBasicValue x:TypeArguments="x:String" ExpressionText="If(in_Body IsNot Nothing, in_Body.ToLower(), &quot;&quot;)" />
        </InArgument>
      </Assign.Value>
    </Assign>

    <Assign x:TypeArguments="x:String" DisplayName="Combine Text">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">
          <VisualBasicReference x:TypeArguments="x:String" ExpressionText="combinedText" />
        </OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">
          <VisualBasicValue x:TypeArguments="x:String" ExpressionText="subjectLower &amp; &quot; &quot; &amp; bodyLower" />
        </InArgument>
      </Assign.Value>
    </Assign>

    <!-- Default category and priority -->
    <Assign x:TypeArguments="x:String" DisplayName="Set Default Category">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">
          <VisualBasicReference x:TypeArguments="x:String" ExpressionText="out_Category" />
        </OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">
          <VisualBasicValue x:TypeArguments="x:String" ExpressionText="&quot;General&quot;" />
        </InArgument>
      </Assign.Value>
    </Assign>

    <Assign x:TypeArguments="x:String" DisplayName="Set Default Priority">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">
          <VisualBasicReference x:TypeArguments="x:String" ExpressionText="out_Priority" />
        </OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">
          <VisualBasicValue x:TypeArguments="x:String" ExpressionText="&quot;Normal&quot;" />
        </InArgument>
      </Assign.Value>
    </Assign>

    <!-- URGENT: outage, down, broken, critical, urgent, emergency, not working -->
    <If DisplayName="Check Urgent Keywords">
      <If.Condition>
        <InArgument x:TypeArguments="x:Boolean">
          <VisualBasicValue x:TypeArguments="x:Boolean" ExpressionText="combinedText.Contains(&quot;outage&quot;) OrElse combinedText.Contains(&quot;down&quot;) OrElse combinedText.Contains(&quot;critical&quot;) OrElse combinedText.Contains(&quot;urgent&quot;) OrElse combinedText.Contains(&quot;emergency&quot;) OrElse combinedText.Contains(&quot;not working&quot;) OrElse combinedText.Contains(&quot;broken&quot;)" />
        </InArgument>
      </If.Condition>
      <If.Then>
        <Sequence DisplayName="Then">
          <Assign x:TypeArguments="x:String" DisplayName="Set Urgent Category">
            <Assign.To>
              <OutArgument x:TypeArguments="x:String">
                <VisualBasicReference x:TypeArguments="x:String" ExpressionText="out_Category" />
              </OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:String">
                <VisualBasicValue x:TypeArguments="x:String" ExpressionText="&quot;Urgent&quot;" />
              </InArgument>
            </Assign.Value>
          </Assign>
          <Assign x:TypeArguments="x:String" DisplayName="Set High Priority">
            <Assign.To>
              <OutArgument x:TypeArguments="x:String">
                <VisualBasicReference x:TypeArguments="x:String" ExpressionText="out_Priority" />
              </OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:String">
                <VisualBasicValue x:TypeArguments="x:String" ExpressionText="&quot;High&quot;" />
              </InArgument>
            </Assign.Value>
          </Assign>
        </Sequence>
      </If.Then>
      <If.Else>
        <Sequence DisplayName="Else">
          <!-- BILLING: invoice, payment, charge, refund, billing, subscription -->
          <If DisplayName="Check Billing Keywords">
            <If.Condition>
              <InArgument x:TypeArguments="x:Boolean">
                <VisualBasicValue x:TypeArguments="x:Boolean" ExpressionText="combinedText.Contains(&quot;invoice&quot;) OrElse combinedText.Contains(&quot;payment&quot;) OrElse combinedText.Contains(&quot;charge&quot;) OrElse combinedText.Contains(&quot;refund&quot;) OrElse combinedText.Contains(&quot;billing&quot;) OrElse combinedText.Contains(&quot;subscription&quot;)" />
              </InArgument>
            </If.Condition>
            <If.Then>
              <Sequence DisplayName="Then">
                <Assign x:TypeArguments="x:String" DisplayName="Set Billing Category">
                  <Assign.To>
                    <OutArgument x:TypeArguments="x:String">
                      <VisualBasicReference x:TypeArguments="x:String" ExpressionText="out_Category" />
                    </OutArgument>
                  </Assign.To>
                  <Assign.Value>
                    <InArgument x:TypeArguments="x:String">
                      <VisualBasicValue x:TypeArguments="x:String" ExpressionText="&quot;Billing&quot;" />
                    </InArgument>
                  </Assign.Value>
                </Assign>
              </Sequence>
            </If.Then>
            <If.Else>
              <Sequence DisplayName="Else">
                <!-- TECHNICAL: error, bug, crash, install, setup, configure, login, password, access -->
                <If DisplayName="Check Technical Keywords">
                  <If.Condition>
                    <InArgument x:TypeArguments="x:Boolean">
                      <VisualBasicValue x:TypeArguments="x:Boolean" ExpressionText="combinedText.Contains(&quot;error&quot;) OrElse combinedText.Contains(&quot;bug&quot;) OrElse combinedText.Contains(&quot;crash&quot;) OrElse combinedText.Contains(&quot;install&quot;) OrElse combinedText.Contains(&quot;setup&quot;) OrElse combinedText.Contains(&quot;configure&quot;) OrElse combinedText.Contains(&quot;login&quot;) OrElse combinedText.Contains(&quot;password&quot;) OrElse combinedText.Contains(&quot;access&quot;)" />
                    </InArgument>
                  </If.Condition>
                  <If.Then>
                    <Sequence DisplayName="Then">
                      <Assign x:TypeArguments="x:String" DisplayName="Set Technical Category">
                        <Assign.To>
                          <OutArgument x:TypeArguments="x:String">
                            <VisualBasicReference x:TypeArguments="x:String" ExpressionText="out_Category" />
                          </OutArgument>
                        </Assign.To>
                        <Assign.Value>
                          <InArgument x:TypeArguments="x:String">
                            <VisualBasicValue x:TypeArguments="x:String" ExpressionText="&quot;Technical&quot;" />
                          </InArgument>
                        </Assign.Value>
                      </Assign>
                    </Sequence>
                  </If.Then>
                </If>
              </Sequence>
            </If.Else>
          </If>
        </Sequence>
      </If.Else>
    </If>

    <ui:LogMessage Level="Info" DisplayName="Log Triage Result">
      <ui:LogMessage.Message>
        <InArgument x:TypeArguments="x:Object">
          <VisualBasicValue x:TypeArguments="x:Object" ExpressionText="$&quot;Triage: Subject=[{in_Subject}] → Category={out_Category}, Priority={out_Priority}&quot;" />
        </InArgument>
      </ui:LogMessage.Message>
    </ui:LogMessage>

  </Sequence>
</Activity>
