{
  "id": "cd0fab4c-b05e-45f0-adc6-1bb030e7fccb",
  "version": "1.8",
  "name": "CustomerEscalation",
  "nodes": [
    {
      "id": "classifyEmail1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Classify Email"
      },
      "inputs": {
        "script": "const email = $vars['emailReceived1.output'];\nconst subject = (email && email.subject) ? email.subject.toLowerCase() : '';\nconst body = (email && email.body && email.body.content) ? email.body.content.toLowerCase() : '';\nconst importance = (email && email.importance) ? email.importance.toLowerCase() : 'normal';\nconst senderAddr = (email && email.from && email.from.emailAddress && email.from.emailAddress.address) ? email.from.emailAddress.address : '';\nconst atIdx = senderAddr.indexOf('@');\nconst senderDomain = atIdx >= 0 ? senderAddr.slice(atIdx + 1).toLowerCase() : '';\n\n// === EDIT THESE LISTS TO MATCH YOUR BUSINESS ===\n// VIP domains: emails from these domains are treated as VIP senders\nconst vipDomains = ['enterprise.com', 'bigclient.io', 'premiumcorp.net'];\n// Urgency keywords: any of these in subject or body marks the email as urgent\nconst urgentKeywords = ['urgent', 'critical', 'asap', 'emergency', 'broken', 'outage', 'down', 'not working', 'issue', 'problem', 'escalate', 'refund', 'billing error', 'account suspended', 'legal', 'lawsuit'];\n// ================================================\n\nconst subjectMatch = urgentKeywords.some(function(k) { return subject.indexOf(k) >= 0; });\nconst bodyMatch = urgentKeywords.some(function(k) { return body.indexOf(k) >= 0; });\nconst importanceHigh = importance === 'high';\nconst isUrgent = subjectMatch || bodyMatch || importanceHigh;\nconst isVip = vipDomains.some(function(d) { return senderDomain === d || senderDomain.slice(-(d.length + 1)) === ('.' + d); });\n\nreturn {\n  isUrgent: isUrgent,\n  isVip: isVip,\n  urgentReason: isUrgent ? (importanceHigh ? 'High importance flag' : 'Urgent keyword in email') : null,\n  senderDomain: senderDomain,\n  senderEmail: senderAddr,\n  subject: (email && email.subject) ? email.subject : '(no subject)',\n  emailId: email ? email.id : null\n};"
      }
    },
    {
      "id": "isVipAndUrgent1",
      "type": "core.logic.decision",
      "typeVersion": "1.1",
      "display": {
        "label": "VIP + Urgent?"
      },
      "inputs": {
        "expression": "$vars['classifyEmail1.output'].isUrgent === true && $vars['classifyEmail1.output'].isVip === true",
        "trueLabel": "Escalate now",
        "falseLabel": "Create ticket"
      }
    },
    {
      "id": "endEscalated",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Escalated"
      }
    },
    {
      "id": "endStandard",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Ticket Created"
      }
    },
    {
      "id": "createTicket1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Create Support Ticket"
      },
      "inputs": {
        "script": "const email = $vars['emailReceived1.output'];\nconst emailId = (email && email.id) ? email.id : '';\nconst raw = emailId.slice(-12).replace(/[^A-Za-z0-9]/g, '').toUpperCase();\nconst suffix = (raw.length >= 6 ? raw.slice(0, 6) : (raw + 'XXXXXX').slice(0, 6));\nconst ticketRef = 'TKT-' + suffix;\n// TODO: replace this script with a real ticketing system connector (e.g. Jira, Zendesk, ServiceNow)\nreturn {\n  ticketRef: ticketRef,\n  senderEmail: (email && email.from && email.from.emailAddress) ? email.from.emailAddress.address : null,\n  subject: (email && email.subject) ? email.subject : '(no subject)'\n};"
      }
    },
    {
      "id": "emailReceived1",
      "type": "uipath.connector.trigger.uipath-microsoft-outlook365.email-received",
      "typeVersion": "1.0.0",
