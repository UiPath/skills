    {
      "id": "slackAlert1",
      "type": "uipath.connector.uipath-salesforce-slack.send-message-to-channel",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Slack Alert"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-salesforce-slack",
          "connectionId": "e03f734e-0f80-4e8a-a7c1-0ece309b0ca4",
          "connectionResourceId": "e03f734e-0f80-4e8a-a7c1-0ece309b0ca4",
          "connectionFolderKey": "def71452-bad1-40fa-be08-da175e89bd1a",
          "method": "POST",
          "endpoint": "/send_message_to_channel_v2",
          "bodyParameters": {
            "channel": "SLACK_CHANNEL_PLACEHOLDER",
            "messageToSend": "=js:\"🚨 VIP ESCALATION — \" + $vars.classifyEmail1.output.subject + \"\\nFrom: \" + $vars.classifyEmail1.output.fromName + \" <\" + $vars.classifyEmail1.output.fromEmail + \">\\n\\nThis email has been flagged as both VIP and urgent. Immediate attention required.\""
          },
          "queryParameters": {
            "send_as": "bot"
          },
          "uiPathActivityTypeId": "37a305b2-89b1-315d-b73f-1778839a6c47",
