{
  "id": "c59d64dc-4ccf-4b16-ab5f-b7fbf84ec2b9",
  "version": "1.8",
  "name": "CustomerEscalation",
  "nodes": [
    {
      "id": "classifyEmail1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Classify Email"
      },
      "inputs": {
        "errorHandlingEnabled": true,
        "script": "// ============================================================\n// VIP SENDER CONFIGURATION — edit these lists to match your\n// real enterprise clients and key contacts.\n// ============================================================\nvar VIP_DOMAINS = [\"enterprise.com\", \"bigclient.com\", \"partner.org\", \"keyaccount.io\"];\nvar VIP_ADDRESSES = [\"ceo@acme.com\", \"vip@keyaccount.com\", \"president@partner.org\"];\n\n// ============================================================\n// URGENCY KEYWORD CONFIGURATION — add or remove as needed.\n// ============================================================\nvar URGENCY_KEYWORDS = [\n  \"outage\", \"down\", \"critical\", \"p1\", \"urgent\", \"production down\",\n  \"blocking\", \"data loss\", \"breach\", \"emergency\", \"asap\", \"immediately\",\n  \"not working\", \"broken\", \"error\", \"failed\", \"issue\", \"problem\",\n  \"cannot\", \"unable\", \"stopped\", \"crash\", \"unresponsive\"\n];\n\nvar subject = ($vars.emailReceived1.output.subject || \"\").toLowerCase();\nvar body = ($vars.emailReceived1.output.bodyPreview || \"\").toLowerCase();\nvar fromEmail = ($vars.emailReceived1.output[\"from.emailAddress.address\"] || $vars.emailReceived1.output[\"sender.emailAddress.address\"] || \"\").toLowerCase();\nvar fromName = $vars.emailReceived1.output[\"from.emailAddress.name\"] || $vars.emailReceived1.output[\"sender.emailAddress.name\"] || fromEmail;\nvar emailId = $vars.emailReceived1.output.id || \"\";\n\n// Check VIP sender\nvar isVip = VIP_ADDRESSES.some(function(addr) { return fromEmail === addr.toLowerCase(); });\nif (!isVip) {\n  var emailDomain = fromEmail.split(\"@\")[1] || \"\";\n  isVip = VIP_DOMAINS.some(function(d) { return emailDomain === d.toLowerCase() || emailDomain.endsWith(\".\" + d.toLowerCase()); });\n}\n\n// Check urgency\nvar combined = subject + \" \" + body;\nvar isUrgent = URGENCY_KEYWORDS.some(function(kw) { return combined.indexOf(kw) !== -1; });\n\nreturn {\n  isVip: isVip,\n  isUrgent: isUrgent,\n  fromEmail: fromEmail,\n  fromName: fromName,\n  emailId: emailId,\n  subject: $vars.emailReceived1.output.subject || \"(no subject)\",\n  bodyPreview: $vars.emailReceived1.output.bodyPreview || \"\"\n};"
      }
    },
    {
      "id": "escalationCheck1",
      "type": "core.logic.decision",
      "typeVersion": "1.1",
      "display": {
        "label": "VIP and Urgent?"
      },
      "inputs": {
        "expression": "$vars.classifyEmail1.output.isVip === true && $vars.classifyEmail1.output.isUrgent === true",
        "trueLabel": "Escalate",
        "falseLabel": "Standard"
      }
    },
    {
      "id": "logClassifyError1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log Classification Error"
      },
      "inputs": {
        "script": "return { message: \"Email classification error\", error: $vars.classifyEmail1.error };"
      }
    },
    {
      "id": "endEscalated1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Done — Escalated"
      },
      "inputs": {}
    },
    {
      "id": "endStandard1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Done — Standard"
      },
      "inputs": {}
    },
    {
      "id": "endError1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Done — Error"
      },
      "inputs": {}
    },
