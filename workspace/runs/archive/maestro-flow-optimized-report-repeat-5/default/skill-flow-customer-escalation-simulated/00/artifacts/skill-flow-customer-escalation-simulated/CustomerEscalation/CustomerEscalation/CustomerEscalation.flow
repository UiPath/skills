      "id": "replyEscalated1",
      "type": "uipath.connector.uipath-microsoft-outlook365.reply-to-email",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Reply Escalated"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-microsoft-outlook365",
          "connectionId": "dd657127-91f5-4568-a3a3-c024bc03fb0f",
          "connectionResourceId": "dd657127-91f5-4568-a3a3-c024bc03fb0f",
          "connectionFolderKey": "def71452-bad1-40fa-be08-da175e89bd1a",
          "method": "POST",
          "endpoint": "/ReplyToEmailV2",
          "bodyParameters": {
            "comment": "=js:\"Thank you for reaching out. Your message has been received and escalated directly to our senior support team as a high-priority item.\\n\\nA member of our team will be in touch with you shortly to address your concern personally.\\n\\nWe appreciate your patience and take this matter very seriously.\\n\\n— Customer Support Team\""
          },
          "queryParameters": {
            "id": "=js:$vars.emailReceived1.output.id",
            "saveAsDraft": false
          },
          "uiPathActivityTypeId": "da9976dd-3d71-35b4-bb8c-509419cb46eb",
