<Activity mc:Ignorable="sap sap2010" x:Class="Workflows_RouteEmail"
  mva:VisualBasic.Settings="{x:Null}"
  xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:mva="clr-namespace:Microsoft.VisualBasic.Activities;assembly=System.Activities"
  xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation"
  xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
  xmlns:sco="clr-namespace:System.Collections.ObjectModel;assembly=mscorlib"
  xmlns:scg="clr-namespace:System.Collections.Generic;assembly=System.Private.CoreLib"
  xmlns:sml="clr-namespace:System.Net.Mail;assembly=System.Net.Mail"
  xmlns:ui="http://schemas.uipath.com/workflow/activities"
  xmlns:umae="clr-namespace:UiPath.Mail.Activities.Enums;assembly=UiPath.Mail.Activities"
  xmlns:usau="clr-namespace:UiPath.Shared.Activities.Utils;assembly=UiPath.Mail.Activities"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Members>
    <x:Property Name="in_MailMessage" Type="InArgument(sml:MailMessage)" />
    <x:Property Name="in_Category" Type="InArgument(x:String)" />
    <x:Property Name="in_IMAPServer" Type="InArgument(x:String)" />
    <x:Property Name="in_IMAPPort" Type="InArgument(x:Int32)" />
    <x:Property Name="in_Email" Type="InArgument(x:String)" />
    <x:Property Name="in_Password" Type="InArgument(x:String)" />
    <x:Property Name="in_FromFolder" Type="InArgument(x:String)" />
    <x:Property Name="out_DestinationFolder" Type="OutArgument(x:String)" />
  </x:Members>
  <TextExpression.NamespacesForImplementation>
    <sco:Collection x:TypeArguments="x:String">
      <x:String>System.Activities</x:String>
      <x:String>System.Activities.Statements</x:String>
      <x:String>System.Activities.Expressions</x:String>
      <x:String>System.Activities.Validation</x:String>
      <x:String>System.Activities.XamlIntegration</x:String>
      <x:String>Microsoft.VisualBasic</x:String>
      <x:String>Microsoft.VisualBasic.Activities</x:String>
      <x:String>System</x:String>
      <x:String>System.Collections</x:String>
      <x:String>System.Collections.Generic</x:String>
      <x:String>System.Collections.ObjectModel</x:String>
      <x:String>System.Data</x:String>
      <x:String>System.IO</x:String>
      <x:String>System.Linq</x:String>
      <x:String>System.Net.Mail</x:String>
      <x:String>UiPath.Core</x:String>
      <x:String>UiPath.Core.Activities</x:String>
      <x:String>UiPath.Mail.Activities.Enums</x:String>
    </sco:Collection>
  </TextExpression.NamespacesForImplementation>
  <TextExpression.ReferencesForImplementation>
    <sco:Collection x:TypeArguments="AssemblyReference">
      <AssemblyReference>System.Activities</AssemblyReference>
      <AssemblyReference>Microsoft.VisualBasic</AssemblyReference>
      <AssemblyReference>System.Private.CoreLib</AssemblyReference>
      <AssemblyReference>mscorlib</AssemblyReference>
      <AssemblyReference>System</AssemblyReference>
      <AssemblyReference>System.Linq</AssemblyReference>
      <AssemblyReference>System.Data</AssemblyReference>
      <AssemblyReference>System.Data.Common</AssemblyReference>
      <AssemblyReference>System.Core</AssemblyReference>
      <AssemblyReference>System.Net.Mail</AssemblyReference>
      <AssemblyReference>UiPath.System.Activities</AssemblyReference>
      <AssemblyReference>UiPath.Mail.Activities</AssemblyReference>
    </sco:Collection>
  </TextExpression.ReferencesForImplementation>

  <!--
    RouteEmail workflow
    Inputs:  in_MailMessage (UiPathMailMessage), in_Category, IMAP connection params
    Output:  out_DestinationFolder

    Folder mapping:
      Billing           → Support/Billing
      Technical         → Support/Technical
      UrgentEscalation  → Support/Urgent
      GeneralInquiry    → Support/General   (default)
  -->
  <Sequence DisplayName="RouteEmail" sap2010:WorkflowViewState.IdRef="Sequence_1">

    <!-- Step 1: Map category to destination folder name -->
    <Switch x:TypeArguments="x:String" DisplayName="Map Category to Folder">
      <Switch.Expression>
        <InArgument x:TypeArguments="x:String">
          <VisualBasicValue x:TypeArguments="x:String" ExpressionText="in_Category" />
        </InArgument>
      </Switch.Expression>

      <Sequence x:Key="Billing" DisplayName="Billing folder">
        <Assign x:TypeArguments="x:String" DisplayName="Set Billing folder">
          <Assign.To>
            <OutArgument x:TypeArguments="x:String">
              <VisualBasicReference x:TypeArguments="x:String" ExpressionText="out_DestinationFolder" />
            </OutArgument>
          </Assign.To>
          <Assign.Value>
            <InArgument x:TypeArguments="x:String">
              <VisualBasicValue x:TypeArguments="x:String" ExpressionText="&quot;Support/Billing&quot;" />
            </InArgument>
          </Assign.Value>
        </Assign>
      </Sequence>

      <Sequence x:Key="Technical" DisplayName="Technical folder">
        <Assign x:TypeArguments="x:String" DisplayName="Set Technical folder">
          <Assign.To>
            <OutArgument x:TypeArguments="x:String">
              <VisualBasicReference x:TypeArguments="x:String" ExpressionText="out_DestinationFolder" />
            </OutArgument>
          </Assign.To>
          <Assign.Value>
            <InArgument x:TypeArguments="x:String">
              <VisualBasicValue x:TypeArguments="x:String" ExpressionText="&quot;Support/Technical&quot;" />
            </InArgument>
          </Assign.Value>
        </Assign>
      </Sequence>

      <Sequence x:Key="UrgentEscalation" DisplayName="Urgent folder">
        <Assign x:TypeArguments="x:String" DisplayName="Set Urgent folder">
          <Assign.To>
            <OutArgument x:TypeArguments="x:String">
              <VisualBasicReference x:TypeArguments="x:String" ExpressionText="out_DestinationFolder" />
            </OutArgument>
          </Assign.To>
          <Assign.Value>
            <InArgument x:TypeArguments="x:String">
              <VisualBasicValue x:TypeArguments="x:String" ExpressionText="&quot;Support/Urgent&quot;" />
            </InArgument>
          </Assign.Value>
        </Assign>
      </Sequence>

      <Switch.Default>
        <Sequence DisplayName="Default - General folder">
          <Assign x:TypeArguments="x:String" DisplayName="Set General folder">
            <Assign.To>
              <OutArgument x:TypeArguments="x:String">
                <VisualBasicReference x:TypeArguments="x:String" ExpressionText="out_DestinationFolder" />
              </OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:String">
                <VisualBasicValue x:TypeArguments="x:String" ExpressionText="&quot;Support/General&quot;" />
              </InArgument>
            </Assign.Value>
          </Assign>
        </Sequence>
      </Switch.Default>
    </Switch>

    <!-- Step 2: Move the email to the destination folder via IMAP -->
    <ui:MoveIMAPMailMessageToFolder
      DisplayName="Move Email to Folder"
      Email="[in_Email]"
      Password="[in_Password]"
      Server="[in_IMAPServer]"
      Port="[in_IMAPPort]"
      FromFolder="[in_FromFolder]"
      MailFolder="[out_DestinationFolder]"
      MailMessage="[in_MailMessage]"
      SecureConnection="Auto"
      IgnoreCRL="False"
      UseOAuth="{x:Null}"
      ClientName="{x:Null}"
      ClientVersion="{x:Null}"
      UseISConnection="False"
      CreatedAfterSolutionSupport="True">
      <ui:MoveIMAPMailMessageToFolder.ConnectionDetailsBackupSlot>
        <usau:BackupSlot x:TypeArguments="umae:ConnectionDetails" StoredValue="{x:Null}">
          <usau:BackupSlot.BackupValues>
            <scg:Dictionary x:TypeArguments="umae:ConnectionDetails, scg:List(x:Object)" />
          </usau:BackupSlot.BackupValues>
        </usau:BackupSlot>
      </ui:MoveIMAPMailMessageToFolder.ConnectionDetailsBackupSlot>
    </ui:MoveIMAPMailMessageToFolder>

    <!-- Step 3: Log the routing action -->
    <ui:LogMessage Level="Info" DisplayName="Log Routing">
      <ui:LogMessage.Message>
        <InArgument x:TypeArguments="x:Object">
          <VisualBasicValue x:TypeArguments="x:Object" ExpressionText="$&quot;Email moved to folder: {out_DestinationFolder}&quot;" />
        </InArgument>
      </ui:LogMessage.Message>
    </ui:LogMessage>

  </Sequence>
</Activity>
