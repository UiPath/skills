      },
      "inputs": {}
    },
    {
      "id": "replyToVipSender1",
      "type": "uipath.connector.uipath-microsoft-outlook365.reply-to-email",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Reply to VIP Sender"
      },
      "inputs": {}
    },
    {
      "id": "replyWithTicketId1",
      "type": "uipath.connector.uipath-microsoft-outlook365.reply-to-email",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Reply with Ticket ID"
      },
      "inputs": {}
    }
  ],
  "edges": [
