{
  "id": "cd332497-6197-4882-b2b8-9a4022b74b55",
  "version": "1.8",
  "name": "EmailSorterFlow",
  "nodes": [
    {
      "id": "classifyEmail",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Classify Email"
      },
      "inputs": {
        "script": "const subject = ($vars.start.output.emailSubject || '').toLowerCase();\nconst body = ($vars.start.output.emailBody || '').toLowerCase();\nconst combined = subject + ' ' + body;\n\nlet category = 'GeneralInquiry';\nlet priority = 'Normal';\n\nif (/invoice|payment|charge|billing|refund|subscription|overcharged|credit card|receipt|price/.test(combined)) {\n  category = 'Billing';\n}\nif (/error|bug|crash|broken|not working|technical|issue|problem|support|login|password|cannot access|failed/.test(combined)) {\n  category = 'Technical';\n}\nif (/urgent|escalate|escalation|immediately|asap|critical|emergency|lawsuit|legal action|unacceptable|data loss|account hacked/.test(combined)) {\n  category = 'UrgentEscalation';\n  priority = 'High';\n}\n\nreturn { category, priority };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Classified email category and priority",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error if classification script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "isUrgent",
      "type": "core.logic.decision",
      "typeVersion": "1.1",
      "display": {
        "label": "Urgent Escalation?"
      },
      "inputs": {
        "expression": "$vars.classifyEmail.output.category === 'UrgentEscalation'",
        "trueLabel": "Yes - Urgent",
        "falseLabel": "No - Auto-route"
      }
    },
    {
      "id": "urgentReview",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "Urgent Email Review"
      },
      "inputs": {
        "title": "Urgent Support Email Requires Review",
        "priority": "High",
        "schema": {
          "schemaId": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
          "fields": [
            {
              "id": "emailSubject",
              "label": "Email Subject",
              "type": "text",
              "direction": "input",
              "binding": "vars.start.output.emailSubject"
            },
            {
              "id": "emailSender",
              "label": "Sender",
              "type": "text",
              "direction": "input",
              "binding": "vars.start.output.emailSender"
            },
            {
              "id": "emailBody",
              "label": "Email Body",
              "type": "text",
              "direction": "input",
              "binding": "vars.start.output.emailBody"
            },
            {
              "id": "detectedCategory",
              "label": "Detected Category",
              "type": "text",
              "direction": "input",
              "binding": "vars.classifyEmail.output.category"
            },
            {
              "id": "agentNotes",
              "label": "Agent Notes",
              "type": "text",
              "direction": "output",
              "variable": "vars.agentNotes"
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "escalate",
              "name": "Escalate",
              "type": "string",
              "isPrimary": false,
              "action": "Continue"
            }
          ]
        },
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group"
          }
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Human review outcome and notes",
          "source": "=result",
          "var": "output",
          "properties": {
            "agentNotes": {
              "type": "string"
            },
            "Action": {
              "type": "string",
              "enum": [
                "Approve",
                "Escalate"
              ],
              "default": "Approve"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Selected outcome (Approve or Escalate)",
          "source": "=result.Action",
          "var": "status",
          "enum": [
            "Approve",
            "Escalate"
          ],
          "default": "Approve"
        }
      }
    },
    {
      "id": "checkApproval",
      "type": "core.logic.decision",
      "typeVersion": "1.1",
      "display": {
        "label": "Approved for Auto-Route?"
      },
      "inputs": {
        "expression": "$vars.urgentReview.status === 'Approve'",
        "trueLabel": "Approved",
        "falseLabel": "Escalate Separately"
      }
    },
    {
      "id": "runEmailSorter",
      "type": "uipath.core.rpa-workflow.8d7f0228-97ca-4c39-891e-ec184da58538",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Run EmailSorter"
      },
      "inputs": {
        "errorHandlingEnabled": true,
        "in_IMAPServer": "=js:$vars.start.output.imapServer",
        "in_IMAPPort": "=js:$vars.start.output.imapPort",
        "in_Email": "=js:$vars.start.output.imapEmail",
        "in_Password": "=js:$vars.start.output.imapPassword",
        "in_FetchFolder": "=js:$vars.start.output.fetchFolder || 'Inbox'",
        "in_TopMessages": 30
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "EmailSorter run result (includes out_ProcessedCount)",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if EmailSorter fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "doneSuccess",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Emails Sorted"
      }
    },
    {
      "id": "doneEscalated",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Escalated for Manual Handling"
      }
    },
    {
      "id": "doneError",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Error - Sorting Failed"
      }
    },
    {
      "id": "emailReceived1",
      "type": "uipath.connector.trigger.uipath-microsoft-outlook365.email-received",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Email Received"
      },
      "inputs": {
        "entryPointId": "8d70c2b8-769b-4f8e-acf1-d87bcb883f69",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "slackAlertVipUrgent1",
      "type": "uipath.connector.uipath-salesforce-slack.send-message-to-channel",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Slack Alert VIP Urgent"
      },
      "inputs": {}
    },
    {
      "id": "createFreshdeskTicket1",
      "type": "uipath.connector.uipath-freshworks-freshdesk.create-ticket",
      "typeVersion": "1.0.0",
      "display": {
