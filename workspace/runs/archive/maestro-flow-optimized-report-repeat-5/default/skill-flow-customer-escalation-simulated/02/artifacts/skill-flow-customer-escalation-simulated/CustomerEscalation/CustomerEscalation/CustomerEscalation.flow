{
  "id": "4a112b27-e76e-4fb4-a369-d372d88ea5bd",
  "version": "1.8",
  "name": "CustomerEscalation",
  "nodes": [
    {
      "id": "emailReceived1",
      "type": "uipath.connector.trigger.uipath-microsoft-outlook365.email-received",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Email Received"
      },
      "inputs": {
        "entryPointId": "474f0f3d-3563-46fe-8b86-4009a0ed8b91",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "classifyEmail1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Classify Email Priority"
      },
      "inputs": {
        "errorHandlingEnabled": true,
        "script": "var subject = ($vars.emailReceived1.output.subject || '').toLowerCase();\nvar body = ($vars.emailReceived1.output.bodyPreview || '').toLowerCase();\nvar from = ($vars.emailReceived1.output.from || $vars.emailReceived1.output.sender || '').toLowerCase();\n\n// VIP domains — enterprise accounts that get priority treatment\nvar vipDomains = [\n  'acme.com', 'globex.com', 'initech.com', 'enterprise.com',\n  'bigclient.com', 'techcorp.com', 'megaholdings.com'\n];\n\n// Urgent keywords\nvar urgentKeywords = [\n  'urgent', 'critical', 'outage', 'down', 'broken', 'emergency',\n  'asap', 'refund', 'fraud', 'account suspended', 'locked out',\n  'data loss', 'security breach', 'not working', 'system failure'\n];\n\nvar isVip = vipDomains.some(function(domain) {\n  return from.indexOf('@' + domain) !== -1 || from.indexOf(domain) !== -1;\n});\n\nvar hasUrgentKeyword = urgentKeywords.some(function(kw) {\n  return subject.indexOf(kw) !== -1 || body.indexOf(kw) !== -1;\n});\n\n// HIGH priority requires BOTH a VIP sender AND an urgent keyword\nvar priority = (isVip && hasUrgentKeyword) ? 'high' : 'normal';\n\nvar matchedKeyword = urgentKeywords.find(function(kw) {\n  return subject.indexOf(kw) !== -1 || body.indexOf(kw) !== -1;\n}) || 'none';\n\nreturn {\n  priority: priority,\n  isVip: isVip,\n  hasUrgentKeyword: hasUrgentKeyword,\n  matchedKeyword: matchedKeyword,\n  senderDomain: from.split('@')[1] || 'unknown'\n};"
      }
    },
    {
      "id": "isHighPriority1",
      "type": "core.logic.decision",
      "typeVersion": "1.1",
      "display": {
        "label": "High Priority?"
      },
      "inputs": {
        "expression": "$vars.classifyEmail1.output.priority === 'high'",
        "trueLabel": "High Priority",
        "falseLabel": "Normal Priority"
      }
    },
    {
      "id": "slackAlertSupportTeam1",
      "type": "uipath.connector.uipath-salesforce-slack.send-message-to-channel",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Slack Alert — Support Team"
      },
      "inputs": {
        "errorHandlingEnabled": true
      }
    },
    {
      "id": "autoReplyUrgent1",
      "type": "uipath.connector.uipath-microsoft-outlook365.reply-to-email",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Auto-Reply — Urgent"
      },
      "inputs": {}
    },
    {
      "id": "moveToUrgentFolder1",
      "type": "uipath.connector.uipath-microsoft-outlook365.move-email",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Move to Urgent Folder"
      },
      "inputs": {}
    },
    {
      "id": "createZendeskTicket1",
      "type": "core.logic.mock",
      "typeVersion": "1.0",
      "display": {
        "label": "Create Zendesk Ticket [PLACEHOLDER]"
      },
      "inputs": {}
    },
    {
      "id": "autoReplyNormal1",
      "type": "uipath.connector.uipath-microsoft-outlook365.reply-to-email",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Auto-Reply — Normal"
      },
      "inputs": {}
    },
    {
      "id": "moveToNormalFolder1",
      "type": "uipath.connector.uipath-microsoft-outlook365.move-email",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Move to Normal Folder"
      },
      "inputs": {}
    },
    {
      "id": "logClassifyError1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log Classification Error"
      },
      "inputs": {
        "script": "return {\n  logged: true,\n  errorMessage: ($vars.classifyEmail1.error && $vars.classifyEmail1.error.message) || 'Unknown classification error',\n  emailSubject: ($vars.emailReceived1.output && $vars.emailReceived1.output.subject) || 'unknown'\n};"
      }
    },
    {
      "id": "logSlackError1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log Slack Error"
      },
      "inputs": {
        "script": "return {\n  logged: true,\n  errorMessage: ($vars.slackAlertSupportTeam1.error && $vars.slackAlertSupportTeam1.error.message) || 'Unknown Slack error',\n  emailSubject: ($vars.emailReceived1.output && $vars.emailReceived1.output.subject) || 'unknown'\n};"
      }
    },
    {
      "id": "doneEscalated1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Done — Escalated"
      },
      "inputs": {}
    },
    {
      "id": "doneNormal1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Done — Normal"
      },
      "inputs": {}
    },
    {
      "id": "doneError1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Done — Error"
      },
      "inputs": {}
    }
  ],
