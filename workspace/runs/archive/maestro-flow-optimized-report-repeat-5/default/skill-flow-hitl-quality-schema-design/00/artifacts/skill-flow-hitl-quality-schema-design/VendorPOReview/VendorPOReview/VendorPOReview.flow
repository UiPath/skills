{
  "id": "8abe72ac-42d2-46de-91f9-130444ee3228",
  "version": "1.8",
  "name": "VendorPOReview",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "16f958e8-86fc-4a18-895e-d3e7e1de2919",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "fetchPOData1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Fetch PO Data"
      },
      "inputs": {
        "script": "return { poNumber: \"PO-2024-00142\", vendorName: \"Acme Supplies Ltd\", totalAmount: 48750.00 };"
      }
    },
    {
      "id": "poReview1",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "PO Review"
      },
      "inputs": {
        "title": "Purchase Order Review",
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group"
          }
        },
        "priority": "High",
        "schema": {
          "schemaId": "c7e2a4b1-5f3d-4e8c-a9b6-2d1f7e4c8a3b",
          "fields": [
            {
              "id": "ponumber",
              "label": "PO Number",
              "type": "string",
              "direction": "input",
              "binding": "vars.fetchPOData1.output.poNumber"
            },
            {
              "id": "vendorname",
              "label": "Vendor Name",
              "type": "string",
              "direction": "input",
              "binding": "vars.fetchPOData1.output.vendorName"
            },
            {
              "id": "totalamount",
              "label": "Total Amount",
              "type": "number",
              "direction": "input",
              "binding": "vars.fetchPOData1.output.totalAmount"
            },
            {
              "id": "decision",
              "label": "Decision",
              "type": "string",
              "direction": "output",
              "variable": "vars.decision",
              "required": true
            },
            {
              "id": "notes",
              "label": "Notes",
              "type": "string",
              "direction": "output",
              "variable": "vars.notes",
              "required": false
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "End"
            }
          ]
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "decision": {
              "type": "string"
            },
            "notes": {
              "type": "string"
            },
            "Action": {
              "type": "string",
              "enum": [
                "Approve",
                "Reject"
              ],
              "default": "Approve"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": [
            "Approve",
            "Reject"
          ],
          "default": "Approve"
        }
      }
    },
    {
      "id": "routeDecision1",
      "type": "core.logic.decision",
      "typeVersion": "1.1",
      "display": {
        "label": "Approved?"
      },
      "inputs": {
        "expression": "$vars.poReview1.status === \"Approve\"",
        "trueLabel": "Approve",
        "falseLabel": "Reject"
      }
    },
    {
      "id": "logApproved1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log PO Approved"
      },
      "inputs": {
        "script": "return { message: \"PO approved\", poNumber: $vars.fetchPOData1.output.poNumber };"
      }
    },
    {
      "id": "end1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End (Approved)"
      }
    },
    {
      "id": "end2",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End (Rejected)"
      }
    }
  ],
  "edges": [
    {
      "id": "start-output-fetchPOData1-input",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "fetchPOData1",
      "targetPort": "input"
    },
    {
      "id": "fetchPOData1-success-poReview1-input",
      "sourceNodeId": "fetchPOData1",
      "sourcePort": "success",
      "targetNodeId": "poReview1",
      "targetPort": "input"
    },
    {
      "id": "poReview1-completed-routeDecision1-input",
      "sourceNodeId": "poReview1",
      "sourcePort": "completed",
      "targetNodeId": "routeDecision1",
      "targetPort": "input"
    },
    {
      "id": "routeDecision1-true-logApproved1-input",
      "sourceNodeId": "routeDecision1",
      "sourcePort": "true",
      "targetNodeId": "logApproved1",
      "targetPort": "input"
    },
    {
      "id": "routeDecision1-false-end2-input",
      "sourceNodeId": "routeDecision1",
      "sourcePort": "false",
      "targetNodeId": "end2",
      "targetPort": "input"
    },
    {
      "id": "logApproved1-success-end1-input",
      "sourceNodeId": "logApproved1",
      "sourcePort": "success",
      "targetNodeId": "end1",
      "targetPort": "input"
    }
  ],
  "definitions": [
    {
      "nodeType": "core.trigger.manual",
      "version": "1.0",
      "category": "trigger",
      "description": "Start workflow manually",
      "tags": [
        "trigger",
        "start",
        "manual"
      ],
      "sortOrder": 40,
      "display": {
        "label": "Manual trigger",
        "icon": "play",
        "shape": "circle"
      },
      "handleConfiguration": [
        {
          "position": "right",
          "handles": [
            {
              "id": "output",
              "type": "source",
              "handleType": "output",
              "showButton": true,
              "constraints": {
                "forbiddenTargetCategories": [
                  "trigger"
                ]
              }
            }
          ],
          "visible": true
        }
      ],
      "model": {
        "type": "bpmn:StartEvent",
        "entryPointId": true
      },
      "outputDefinition": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the workflow.",
          "source": "null",
          "var": "output"
        }
      },
      "toolbarExtensions": {
        "design": {
          "actions": [
            {
              "id": "change-trigger-type",
              "icon": "square-mouse-pointer",
              "label": "Change trigger type"
            }
          ]
        }
      }
    },
    {
      "nodeType": "core.action.script",
      "version": "1.0",
      "category": "data-operations",
      "description": "Run custom JavaScript code",
      "tags": [
        "code",
        "javascript",
        "python"
      ],
      "sortOrder": 35,
      "supportsErrorHandling": true,
      "display": {
        "label": "Script",
        "icon": "code"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ]
        },
        {
          "position": "right",
          "handles": [
            {
              "id": "success",
              "type": "source",
              "handleType": "output"
            },
            {
              "id": "error",
              "label": "Error",
              "type": "source",
              "handleType": "output",
              "visible": "{inputs.errorHandlingEnabled}",
              "constraints": {
                "maxConnections": 1
              }
            }
          ]
        }
      ],
      "debug": {
        "runtime": "clientScript"
      },
      "model": {
        "type": "bpmn:ScriptTask"
      },
      "inputDefinition": {
        "type": "object",
        "properties": {
          "script": {
            "type": "string",
            "minLength": 1,
            "errorMessage": "A script function is required",
            "validationSeverity": "warning"
          }
        },
        "required": [
          "script"
        ]
      },
      "inputDefaults": {
        "script": ""
      },
      "outputDefinition": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "nodeType": "uipath.human-in-the-loop.quick-form",
      "version": "1.0",
      "category": "human-task",
      "description": "Fast inline approvals with inline debug",
      "tags": [
        "human-task",
        "hitl",
        "human-in-the-loop",
        "quick-form",
        "approval"
      ],
      "sortOrder": 27,
      "display": {
        "label": "Quick Form",
        "icon": "users",
        "shape": "square"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ],
          "visible": true
        },
        {
          "position": "right",
          "handles": [
            {
              "id": "completed",
              "label": "Completed",
              "type": "source",
              "handleType": "output",
              "showButton": true,
              "constraints": {
                "forbiddenTargetCategories": [
                  "trigger"
                ]
              }
            }
          ],
          "visible": true
        }
      ],
      "model": {
        "type": "bpmn:UserTask",
        "serviceType": "Actions.HITL"
      },
      "inputDefaults": {
        "schema": {
          "fields": [],
          "outcomes": [
            {
              "id": "submit",
              "name": "Submit",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            }
          ]
        },
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group"
          }
        }
      },
      "outputDefinition": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output"
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status"
        }
      }
    },
    {
      "nodeType": "core.logic.decision",
      "version": "1.1",
      "category": "control-flow",
      "description": "Branch based on a true/false condition",
      "tags": [
        "control-flow",
        "if",
        "loop",
        "switch"
      ],
      "sortOrder": 20,
      "display": {
        "label": "Decision",
        "icon": "trending-up-down"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ],
          "visible": true
        },
        {
          "position": "right",
          "handles": [
            {
              "id": "true",
              "type": "source",
              "handleType": "output",
              "label": "{inputs.trueLabel}",
              "constraints": {
                "minConnections": 1
              }
            },
            {
              "id": "false",
              "type": "source",
              "handleType": "output",
              "label": "{inputs.falseLabel}"
            }
          ],
          "visible": true
        }
      ],
      "debug": {
        "runtime": "clientScript"
      },
      "model": {
        "type": "bpmn:InclusiveGateway"
      },
      "inputDefinition": {
        "type": "object",
        "properties": {
          "expression": {
            "type": "string",
            "minLength": 1,
            "errorMessage": "A condition expression is required"
          },
          "trueLabel": {
            "type": "string"
          },
          "falseLabel": {
            "type": "string"
          }
        },
        "required": [
          "expression"
        ]
      },
      "outputDefinition": {
        "matchedCase": {
          "type": "string",
          "description": "The label of the matched branch (true/false label)",
          "var": "matchedCase"
        },
        "matchedCaseId": {
          "type": "string",
          "description": "The branch that was taken (true or false)",
          "var": "matchedCaseId"
        }
      },
      "inputDefaults": {
        "trueLabel": "True",
        "falseLabel": "False"
      }
    },
    {
      "nodeType": "core.control.end",
      "version": "1.0",
      "category": "control-flow",
      "description": "Mark the end of a workflow path",
      "tags": [
        "control-flow",
        "end",
        "finish",
        "complete"
      ],
      "sortOrder": 20,
      "display": {
        "label": "End",
        "icon": "circle-check",
        "shape": "circle"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ]
        }
      ],
      "model": {
        "type": "bpmn:EndEvent"
      },
      "runtimeConstraints": {
        "exclude": [
          "api-function"
        ]
      }
    }
  ],
