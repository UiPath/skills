{
  "id": "f86de2e4-caac-4e28-b2be-27b8587e795b",
  "version": "1.8",
  "name": "VendorPOReview",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "c3399981-c45d-4954-9982-1c5e70bac989",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "fetchPoData1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Fetch PO Data"
      },
      "inputs": {
        "script": "return { poNumber: \"PO-2024-0042\", vendorName: \"Acme Supplies Ltd\", totalAmount: 18750.00 };"
      }
    },
    {
      "id": "poReview1",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "PO Review"
      },
      "inputs": {
        "title": "Purchase Order Review",
        "recipient": {
          "channels": ["Email", "ActionCenter"],
          "connections": {},
          "assignee": { "type": "group" }
        },
        "priority": "High",
        "schema": {
          "schemaId": "b5f2a841-3c7d-4e9f-a1b2-8d3e6f0c4a75",
          "fields": [
            {
              "id": "ponumber",
              "label": "PO Number",
              "type": "string",
              "direction": "input",
              "binding": "vars.fetchPoData1.output.poNumber"
            },
            {
              "id": "vendorname",
              "label": "Vendor Name",
              "type": "string",
              "direction": "input",
              "binding": "vars.fetchPoData1.output.vendorName"
            },
            {
              "id": "totalamount",
              "label": "Total Amount",
              "type": "number",
              "direction": "input",
              "binding": "vars.fetchPoData1.output.totalAmount"
            },
            {
              "id": "decision",
              "label": "Decision",
              "type": "string",
              "direction": "output",
              "variable": "vars.decision",
              "required": true
            },
            {
              "id": "notes",
              "label": "Notes",
              "type": "string",
              "direction": "output",
              "variable": "vars.notes",
              "required": false
            }
          ],
          "outcomes": [
            { "id": "approve", "name": "Approve", "type": "string", "isPrimary": true,  "action": "Continue" },
            { "id": "reject",  "name": "Reject",  "type": "string", "isPrimary": false, "action": "End" }
          ]
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "decision": { "type": "string" },
            "notes":    { "type": "string" },
            "Action":   { "type": "string", "enum": ["Approve", "Reject"], "default": "Approve" }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": ["Approve", "Reject"],
          "default": "Approve"
        }
      }
    },
    {
      "id": "routeOnDecision1",
      "type": "core.logic.decision",
      "typeVersion": "1.1",
      "display": {
        "label": "Route on Decision"
      },
      "inputs": {
        "trueLabel": "Approve",
        "falseLabel": "Reject",
        "expression": "=js:$vars.poReview1.status === \"Approve\""
      }
    },
    {
      "id": "logPoApproved1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log PO Approved"
      },
      "inputs": {
        "script": "console.log(\"PO approved: \" + $vars.fetchPoData1.output.poNumber + \" from \" + $vars.fetchPoData1.output.vendorName);\nreturn { logged: true };"
      }
    },
    {
      "id": "end1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {}
    }
  ],
  "edges": [
    {
      "id": "start-output-fetchPoData1-input",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "fetchPoData1",
      "targetPort": "input"
    },
    {
      "id": "fetchPoData1-success-poReview1-input",
      "sourceNodeId": "fetchPoData1",
      "sourcePort": "success",
      "targetNodeId": "poReview1",
      "targetPort": "input"
    },
    {
      "id": "poReview1-completed-routeOnDecision1-input",
      "sourceNodeId": "poReview1",
      "sourcePort": "completed",
      "targetNodeId": "routeOnDecision1",
      "targetPort": "input"
    },
    {
      "id": "routeOnDecision1-true-logPoApproved1-input",
      "sourceNodeId": "routeOnDecision1",
      "sourcePort": "true",
      "targetNodeId": "logPoApproved1",
      "targetPort": "input"
    },
    {
      "id": "routeOnDecision1-false-end1-input",
      "sourceNodeId": "routeOnDecision1",
      "sourcePort": "false",
      "targetNodeId": "end1",
      "targetPort": "input"
    }
  ],
  "definitions": [
    {
      "nodeType": "core.trigger.manual",
      "version": "1.0",
      "category": "trigger",
      "description": "Start workflow manually",
      "tags": [
        "trigger",
        "start",
        "manual"
      ],
      "sortOrder": 40,
      "display": {
        "label": "Manual trigger",
        "icon": "play",
        "shape": "circle"
      },
      "handleConfiguration": [
        {
          "position": "right",
          "handles": [
            {
              "id": "output",
              "type": "source",
              "handleType": "output",
              "showButton": true,
              "constraints": {
                "forbiddenTargetCategories": [
                  "trigger"
                ]
              }
            }
          ],
          "visible": true
        }
      ],
      "model": {
        "type": "bpmn:StartEvent",
        "entryPointId": true
      },
      "outputDefinition": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the workflow.",
          "source": "null",
          "var": "output"
        }
      },
      "toolbarExtensions": {
        "design": {
          "actions": [
            {
              "id": "change-trigger-type",
              "icon": "square-mouse-pointer",
              "label": "Change trigger type"
            }
          ]
        }
      }
    },
    {
      "nodeType": "core.action.script",
      "version": "1.0",
      "category": "data-operations",
      "description": "Run custom JavaScript code",
      "tags": [
        "code",
        "javascript",
        "python"
      ],
      "sortOrder": 35,
      "supportsErrorHandling": true,
      "display": {
        "label": "Script",
        "icon": "code"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ]
        },
        {
          "position": "right",
          "handles": [
            {
              "id": "success",
              "type": "source",
              "handleType": "output"
            },
            {
              "id": "error",
              "label": "Error",
              "type": "source",
              "handleType": "output",
              "visible": "{inputs.errorHandlingEnabled}",
              "constraints": {
                "maxConnections": 1
              }
            }
          ]
        }
      ],
      "debug": {
        "runtime": "clientScript"
      },
      "model": {
        "type": "bpmn:ScriptTask"
      },
      "inputDefinition": {
        "type": "object",
        "properties": {
          "script": {
            "type": "string",
            "minLength": 1,
            "errorMessage": "A script function is required",
            "validationSeverity": "warning"
          }
        },
        "required": [
          "script"
        ]
      },
      "inputDefaults": {
        "script": ""
      },
      "outputDefinition": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "form": {
        "id": "script-properties",
        "title": "Script configuration",
        "sections": [
          {
            "id": "script",
            "title": "Script",
            "collapsible": true,
            "defaultExpanded": true,
            "fields": [
              {
                "name": "inputs.script",
                "type": "custom",
                "component": "script-editor",
                "componentProps": {
                  "language": "javascript",
                  "returnType": "any",
                  "validationMode": "script",
                  "minHeight": 200,
                  "placeholder": " // Return an object with your result\nreturn {\n  message: \"Web request response\",\n  data: $vars.httpRequest1.output\n                  };"
                },
                "label": "Code",
                "description": "JavaScript expression that returns a result object"
              }
            ]
          }
        ]
      }
    },
    {
      "nodeType": "uipath.human-in-the-loop.quick-form",
      "version": "1.0",
      "category": "human-task",
      "description": "Fast inline approvals with inline debug",
      "tags": ["human-task", "hitl", "human-in-the-loop", "quick-form", "approval"],
      "sortOrder": 27,
      "display": {
        "label": "Quick Form",
        "icon": "users",
        "shape": "square"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ],
          "visible": true
        },
        {
          "position": "right",
          "handles": [
            {
              "id": "completed",
              "label": "Completed",
              "type": "source",
              "handleType": "output",
              "showButton": true,
              "constraints": { "forbiddenTargetCategories": ["trigger"] }
            }
          ],
          "visible": true
        }
      ],
      "model": { "type": "bpmn:UserTask", "serviceType": "Actions.HITL" },
      "inputDefaults": {
        "schema": {
          "fields": [],
          "outcomes": [{ "id": "submit", "name": "Submit", "type": "string", "isPrimary": true, "action": "Continue" }]
        },
        "recipient": {
          "channels": ["Email", "ActionCenter"],
          "connections": {},
          "assignee": { "type": "group" }
        }
      },
      "outputDefinition": {
        "output": { "type": "object", "description": "Task result data", "source": "=result", "var": "output" },
        "status": { "type": "string", "description": "Task completion status", "source": "=result.Action", "var": "status" }
      }
    },
    {
      "nodeType": "core.logic.decision",
      "version": "1.1",
      "category": "control-flow",
      "description": "Branch based on a true/false condition",
      "tags": [
        "control-flow",
        "if",
        "loop",
        "switch"
      ],
      "sortOrder": 20,
      "display": {
        "label": "Decision",
        "icon": "trending-up-down"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ],
          "visible": true
        },
        {
          "position": "right",
          "handles": [
            {
              "id": "true",
              "type": "source",
              "handleType": "output",
              "label": "{inputs.trueLabel}",
              "constraints": {
                "minConnections": 1
              }
            },
            {
              "id": "false",
              "type": "source",
              "handleType": "output",
              "label": "{inputs.falseLabel}"
            }
          ],
          "visible": true
        }
      ],
      "debug": {
        "runtime": "clientScript"
      },
      "model": {
        "type": "bpmn:InclusiveGateway"
      },
      "inputDefinition": {
        "type": "object",
        "properties": {
          "expression": {
            "type": "string",
            "minLength": 1,
            "errorMessage": "A condition expression is required"
          },
          "trueLabel": {
            "type": "string"
          },
          "falseLabel": {
            "type": "string"
          }
        },
        "required": [
          "expression"
        ]
      },
      "outputDefinition": {
        "matchedCase": {
          "type": "string",
          "description": "The label of the matched branch (true/false label)",
          "var": "matchedCase"
        },
        "matchedCaseId": {
          "type": "string",
          "description": "The branch that was taken (true or false)",
          "var": "matchedCaseId"
        }
      },
      "inputDefaults": {
        "trueLabel": "True",
        "falseLabel": "False"
      },
      "form": {
        "id": "decision-properties",
        "title": "Decision configuration",
        "sections": [
          {
            "id": "condition",
            "title": "Condition",
            "fields": [
              {
                "name": "inputs.expression",
                "type": "custom",
                "component": "script-editor",
                "componentProps": {
                  "language": "javascript",
                  "returnType": "boolean",
                  "validationMode": "expression",
                  "minHeight": 100,
                  "placeholder": "e.g., $vars.data.status === \"approved\" && $vars.data.amount > 1000"
                },
                "label": "Expression",
                "description": "JavaScript expression that evaluates to true or false"
              },
              {
                "name": "inputs.trueLabel",
                "type": "text",
                "label": "True branch label",
                "description": "Label shown when condition is true"
              },
              {
                "name": "inputs.falseLabel",
                "type": "text",
                "label": "False branch label",
                "description": "Label shown when condition is false"
              }
            ]
          }
        ]
      }
    },
    {
      "nodeType": "core.control.end",
      "version": "1.0",
      "category": "control-flow",
      "description": "Mark the end of a workflow path",
      "tags": [
        "control-flow",
        "end",
        "finish",
        "complete"
      ],
      "sortOrder": 20,
      "display": {
        "label": "End",
        "icon": "circle-check",
        "shape": "circle"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ]
        }
      ],
      "model": {
        "type": "bpmn:EndEvent"
      },
      "runtimeConstraints": {
        "exclude": [
          "api-function"
        ]
      }
    }
  ],
  "runtime": "maestro",
  "variables": {
    "nodes": [
      {
        "id": "start.output",
        "type": "object",
        "description": "Data passed when manually triggering the workflow.",
        "binding": {
          "nodeId": "start",
          "outputId": "output"
        }
      },
      {
        "id": "fetchPoData1.output",
        "type": "object",
        "description": "The return value of the script",
        "binding": {
          "nodeId": "fetchPoData1",
          "outputId": "output"
        }
      },
      {
        "id": "fetchPoData1.error",
        "type": "object",
        "description": "Error information if the node fails",
        "schema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "required": ["code", "message", "detail", "category", "status"],
          "properties": {
            "code":     { "type": "string", "description": "Error code as a string" },
            "message":  { "type": "string", "description": "High-level error message" },
            "detail":   { "type": "string", "description": "Detailed error description" },
            "category": { "type": "string", "description": "Error category" },
            "status":   { "type": "integer", "description": "HTTP status code" }
          },
          "additionalProperties": false
        },
        "binding": {
          "nodeId": "fetchPoData1",
          "outputId": "error"
        }
      },
      {
        "id": "poReview1.output",
        "type": "object",
        "description": "Task result data",
        "binding": {
          "nodeId": "poReview1",
          "outputId": "output"
        }
      },
      {
        "id": "poReview1.status",
        "type": "string",
        "description": "Task completion status",
        "binding": {
          "nodeId": "poReview1",
          "outputId": "status"
        }
      },
      {
        "id": "routeOnDecision1.matchedCase",
        "type": "string",
        "description": "The label of the matched branch (true/false label)",
        "binding": {
          "nodeId": "routeOnDecision1",
          "outputId": "matchedCase"
        }
      },
      {
        "id": "routeOnDecision1.matchedCaseId",
        "type": "string",
        "description": "The branch that was taken (true or false)",
        "binding": {
          "nodeId": "routeOnDecision1",
          "outputId": "matchedCaseId"
        }
      },
      {
        "id": "logPoApproved1.output",
        "type": "object",
        "description": "The return value of the script",
        "binding": {
          "nodeId": "logPoApproved1",
          "outputId": "output"
        }
      },
      {
        "id": "logPoApproved1.error",
        "type": "object",
        "description": "Error information if the node fails",
        "schema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "required": ["code", "message", "detail", "category", "status"],
          "properties": {
            "code":     { "type": "string", "description": "Error code as a string" },
            "message":  { "type": "string", "description": "High-level error message" },
            "detail":   { "type": "string", "description": "Detailed error description" },
            "category": { "type": "string", "description": "Error category" },
            "status":   { "type": "integer", "description": "HTTP status code" }
          },
          "additionalProperties": false
        },
        "binding": {
          "nodeId": "logPoApproved1",
          "outputId": "error"
        }
      }
    ]
  },
  "layout": {
    "nodes": {
      "start": {
        "position": { "x": 256, "y": 144 }
      },
      "fetchPoData1": {
        "position": { "x": 480, "y": 144 }
      },
      "poReview1": {
        "position": { "x": 760, "y": 144 }
      },
      "routeOnDecision1": {
        "position": { "x": 1040, "y": 144 }
      },
      "logPoApproved1": {
        "position": { "x": 1280, "y": 80 }
      },
      "end1": {
        "position": { "x": 1280, "y": 208 }
      }
    }
  }
}
