  "subflows": {
    "reverseSubflow": {
      "nodes": [
        {
          "id": "subflowStart",
          "type": "core.trigger.manual",
          "typeVersion": "1.0",
          "display": {
            "label": "Start"
          },
          "inputs": {
            "entryPointId": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
            "isDefaultEntryPoint": true
          },
          "outputs": {
            "output": {
              "type": "object",
              "description": "Data passed when manually triggering the workflow.",
              "source": "null",
              "var": "output"
            }
          }
        },
        {
          "id": "scriptReverse",
          "type": "core.action.script",
          "typeVersion": "1.0",
          "display": {
            "label": "Reverse Text"
          },
          "inputs": {
            "script": "var text = $vars.subflowStart.output.text || ''; var reversed = text.split('').reverse().join(''); return { reversed: reversed };"
          },
          "outputs": {
            "output": {
              "type": "object",
              "description": "The return value of the script",
              "source": "=result.response",
              "var": "output"
            },
            "error": {
              "type": "object",
              "description": "Error information if the script fails",
              "source": "=result.Error",
              "var": "error"
            }
          }
        },
        {
          "id": "subflowEnd",
          "type": "core.control.end",
          "typeVersion": "1.0",
          "display": {
            "label": "End"
          },
          "inputs": {},
          "outputs": {
            "reversed": {
              "source": "=js:$vars.scriptReverse.output.reversed"
            }
          }
        }
      ],
      "edges": [
        {
          "id": "sf-e1",
          "sourceNodeId": "subflowStart",
          "sourcePort": "output",
          "targetNodeId": "scriptReverse",
          "targetPort": "input"
        },
        {
          "id": "sf-e2",
          "sourceNodeId": "scriptReverse",
          "sourcePort": "success",
          "targetNodeId": "subflowEnd",
          "targetPort": "input"
        }
      ],
      "variables": {
        "globals": [
          {
            "id": "text",
            "direction": "in",
            "type": "string",
            "defaultValue": "",
            "triggerNodeId": "subflowStart"
          },
          {
            "id": "reversed",
            "direction": "out",
            "type": "string",
            "defaultValue": ""
          }
        ],
        "nodes": [
          {
            "id": "subflowStart.output",
            "type": "object",
            "description": "Data passed when manually triggering the workflow.",
            "binding": {
              "nodeId": "subflowStart",
              "outputId": "output"
            }
          },
          {
            "id": "scriptReverse.output",
            "type": "object",
            "description": "The return value of the script",
            "binding": {
              "nodeId": "scriptReverse",
              "outputId": "output"
            }
          },
          {
            "id": "scriptReverse.error",
            "type": "object",
            "description": "Error information if the script fails",
            "binding": {
              "nodeId": "scriptReverse",
              "outputId": "error"
            }
          },
          {
            "id": "subflowEnd.reversed",
            "type": "string",
            "binding": {
              "nodeId": "subflowEnd",
              "outputId": "reversed"
            }
          }
        ]
      },
