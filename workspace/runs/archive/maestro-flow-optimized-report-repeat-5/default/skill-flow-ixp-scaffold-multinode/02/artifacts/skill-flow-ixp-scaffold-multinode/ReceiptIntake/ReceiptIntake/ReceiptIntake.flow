      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "postReceipt"
      },
      "inputs": {
        "script": "const result = $vars.extractReceipt.output;\nreturn { ok: true, message: 'postReceipt OK', extractionResult: result };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
