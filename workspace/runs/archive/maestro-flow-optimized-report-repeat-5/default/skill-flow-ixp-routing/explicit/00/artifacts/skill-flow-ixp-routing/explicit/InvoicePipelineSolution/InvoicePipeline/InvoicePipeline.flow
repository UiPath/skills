          "visible": true
        }
      ],
      "model": {
        "type": "bpmn:Task"
      },
      "outputDefinition": {
        "output": {
          "type": "object",
          "description": "Mock output value",
          "source": "null",
          "var": "output"
        }
      },
      "runtimeConstraints": {
        "exclude": [
          "api-function"
        ]
      }
