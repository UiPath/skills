    {
      "id": "prepareForSap",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Prepare SAP Payload"
      },
      "inputs": {
        "language": "javascript",
        "script": "const fields = $vars.extractInvoiceFields.output.ExtractionResult.ResultsDocument.Fields || [];\nconst get = (name) => fields.find(f => f.FieldName === name)?.Values?.[0] ?? null;\nreturn {\n  invoiceNumber: get('InvoiceNumber'),\n  invoiceDate:   get('InvoiceDate'),\n  dueDate:       get('DueDate'),\n  totalAmount:   get('TotalAmount'),\n  currency:      get('Currency'),\n  vendorName:    get('VendorName'),\n  poNumber:      get('PurchaseOrderNumber'),\n  lineItems:     ($vars.extractInvoiceFields.output.ExtractionResult.ResultsDocument.Tables || [])\n};"
      }
    },
    {
      "id": "postToSap",
      "type": "core.logic.mock",
      "typeVersion": "1.0",
      "display": {
        "label": "Post Invoice to SAP (mock — wire SAP connector here)"
      }
    },
    {
      "id": "endSuccess",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "outputs": {
        "sapPayload": {
          "source": "=js:$vars.prepareForSap.output"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "edge-start-extract",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "extractInvoiceFields",
      "targetPort": "input"
    },
    {
      "id": "edge-extract-prepare",
      "sourceNodeId": "extractInvoiceFields",
      "sourcePort": "success",
      "targetNodeId": "prepareForSap",
      "targetPort": "input"
    },
    {
      "id": "edge-prepare-post",
      "sourceNodeId": "prepareForSap",
      "sourcePort": "success",
      "targetNodeId": "postToSap",
      "targetPort": "input"
    },
    {
      "id": "edge-post-end",
      "sourceNodeId": "postToSap",
      "sourcePort": "output",
      "targetNodeId": "endSuccess",
      "targetPort": "input"
    }
  ],
