    {
      "id": "parseInvoiceFields1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Parse Invoice Fields"
      },
      "inputs": {
        "language": "javascript",
        "script": "const fields = $vars.extractInvoiceFields1.output.ExtractionResult.ResultsDocument.Fields || [];\nfunction fv(name) {\n  const f = fields.find(function(x) { return x.FieldName === name; });\n  return f && f.Values && f.Values.length > 0 ? f.Values[0] : null;\n}\nconst tables = $vars.extractInvoiceFields1.output.ExtractionResult.ResultsDocument.Tables || [];\nconst lineItems = tables.length > 0 ? tables[0].Values : [];\nreturn {\n  vendorName: fv('vendor_name') || fv('VendorName') || fv('Vendor'),\n  invoiceNumber: fv('invoice_id') || fv('InvoiceNumber') || fv('InvoiceId'),\n  invoiceDate: fv('invoice_date') || fv('InvoiceDate'),\n  totalAmount: fv('invoice_total') || fv('TotalAmount') || fv('Total'),\n  lineItems: lineItems\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
