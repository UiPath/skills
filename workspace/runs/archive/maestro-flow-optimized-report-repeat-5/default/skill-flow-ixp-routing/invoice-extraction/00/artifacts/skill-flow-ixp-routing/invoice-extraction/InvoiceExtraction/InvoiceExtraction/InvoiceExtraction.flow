    {
      "id": "buildInvoiceRecord1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Build Invoice Record"
      },
      "inputs": {
        "script": "const fields = $vars.extractInvoiceFields1.output.ExtractionResult.ResultsDocument.Fields || [];\nconst find = (name) => (fields.find(f => f.FieldName === name) || {}).Values?.[0] || null;\nreturn {\n  vendorName: find('vendor') || find('VendorName') || find('Vendor Name'),\n  invoiceNumber: find('invoice_number') || find('InvoiceNumber') || find('Invoice Number'),\n  invoiceDate: find('invoice_date') || find('InvoiceDate') || find('Invoice Date'),\n  totalAmount: find('total') || find('TotalAmount') || find('Total Amount') || find('Invoice Total'),\n  lineItems: ($vars.extractInvoiceFields1.output.ExtractionResult.ResultsDocument.Tables || []).map(t => t.Values)\n};"
      }
    },
