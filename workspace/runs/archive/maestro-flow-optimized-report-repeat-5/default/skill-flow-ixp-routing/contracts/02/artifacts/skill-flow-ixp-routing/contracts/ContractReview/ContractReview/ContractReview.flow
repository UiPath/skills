    {
      "id": "parseContractFields",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Parse Contract Fields"
      },
      "inputs": {
        "script": "const fields = $vars.extractContractFields.output.ExtractionResult?.ResultsDocument?.Fields || [];\nconst getField = (name) => fields.find(f => f.FieldName === name)?.Values?.[0] || null;\nreturn {\n  partyNames: getField('party_names') || getField('PartyNames') || getField('Parties') || null,\n  effectiveDate: getField('effective_date') || getField('EffectiveDate') || getField('Date') || null,\n  terminationClause: getField('termination_clause') || getField('TerminationClause') || getField('Termination') || null\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "contractApproval",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "Contract Approval"
      },
      "inputs": {
        "schema": {
          "schemaId": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
          "fields": [
            {
              "id": "partyNames",
              "label": "Party Names",
              "type": "text",
              "direction": "input",
              "binding": "vars.parseContractFields.output.partyNames"
            },
            {
              "id": "effectiveDate",
              "label": "Effective Date",
              "type": "text",
              "direction": "input",
              "binding": "vars.parseContractFields.output.effectiveDate"
            },
            {
              "id": "terminationClause",
              "label": "Termination Clause",
              "type": "text",
              "direction": "input",
              "binding": "vars.parseContractFields.output.terminationClause"
            },
            {
              "id": "approvalDecision",
              "label": "Approval Decision",
              "type": "text",
              "direction": "output",
              "variable": "vars.approvalDecision"
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "End"
            }
          ]
        },
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group"
          }
        },
        "priority": "Medium"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "approvalDecision": {
              "type": "string"
            },
            "Action": {
              "type": "string",
              "enum": [
                "Approve",
                "Reject"
              ],
              "default": "Approve"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": [
            "Approve",
            "Reject"
          ],
          "default": "Approve"
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
