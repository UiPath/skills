          "var": "output"
        }
      }
    },
    {
      "id": "extractContractFields",
      "type": "uipath.ixp.employment-agreements-d4ee40a0-ixp.97f6f1c4-2b0d-8044-8892-c8809e742924-c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Extract Contract Fields"
      },
      "inputs": {
        "model": {
          "id": "97f6f1c4-2b0d-8044-8892-c8809e742924",
          "modelName": "employment-agreements-d4ee40a0-ixp",
          "modelDisplayName": "employment-agreements-d4ee40a0-ixp",
          "folderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "folderName": "Shared",
          "folderPath": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "description": ""
        },
        "modelName": "employment-agreements-d4ee40a0-ixp",
        "projectName": "employment-agreements-d4ee40a0-ixp",
        "folderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
        "folderName": "Shared",
        "versionTag": "",
        "pageRange": "",
        "fileRef": "=js:$vars.start.output.contractFile"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Extraction result",
          "source": "=this.result",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "parseFields",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Parse Party Names, Effective Date, Termination Clause"
      },
      "inputs": {
        "script": "const fields = ($vars.extractContractFields.output && $vars.extractContractFields.output.ExtractionResult && $vars.extractContractFields.output.ExtractionResult.ResultsDocument && $vars.extractContractFields.output.ExtractionResult.ResultsDocument.Fields) || [];\nconst get = name => { const f = fields.find(f => f.FieldName === name); return f && f.Values && f.Values[0] || null; };\nreturn {\n  partyNames: get('Party Names') || get('party_names') || get('Parties') || get('Employer') || null,\n  effectiveDate: get('Effective Date') || get('effective_date') || get('Start Date') || null,\n  terminationClause: get('Termination Clause') || get('termination_clause') || get('Termination') || null\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "approvalStep",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "Contract Approval"
      },
      "inputs": {
        "title": "Contract Review & Approval",
        "priority": "Medium",
        "schema": {
          "fields": [
            {
              "id": "partyNames",
              "name": "Party Names",
              "type": "string",
              "isInput": true,
              "defaultValue": "=js:$vars.parseFields.output.partyNames"
            },
            {
              "id": "effectiveDate",
              "name": "Effective Date",
              "type": "string",
              "isInput": true,
              "defaultValue": "=js:$vars.parseFields.output.effectiveDate"
            },
            {
              "id": "terminationClause",
              "name": "Termination Clause",
              "type": "string",
              "isInput": true,
              "defaultValue": "=js:$vars.parseFields.output.terminationClause"
            },
            {
              "id": "reviewNotes",
              "name": "Review Notes",
              "type": "string",
              "isInput": false
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "Continue"
            }
          ]
        },
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group"
          }
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output"
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status"
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {}
    }
