<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:uipath="http://uipath.org/schema/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" exporter="UiPath Maestro (https://uipath.com)" exporterVersion="1.201.0-dev.8275">
  <bpmn:process id="Process_1" name="Maestro Process" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:variables version="v1">
        <uipath:inputOutput id="Var_ExpenseAmount" name="ExpenseAmount" type="number" />
        <uipath:inputOutput id="Var_RequesterName" name="RequesterName" type="string" />
        <uipath:inputOutput id="Var_ExpenseCategory" name="ExpenseCategory" type="string" />
        <uipath:inputOutput id="Var_ApprovalDecision" name="ApprovalDecision" type="string" />
        <uipath:inputOutput id="Var_Comments" name="Comments" type="string" />
      </uipath:variables>
      <uipath:bindings version="v1" />
    </bpmn:extensionElements>
    <bpmn:startEvent id="Event_start" name="core.trigger.manual">
      <bpmn:extensionElements>
        <uipath:entryPointId value="eb56440e-8db7-4026-932e-ebfebd541011" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_ToReview</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_ReviewExpense" name="Review Expense">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Actions.HITL" version="v1" />
          <uipath:context>
            <uipath:input name="appId" value="ExpenseReviewActionApp" />
            <uipath:input name="appVersion" value="1" />
            <uipath:input name="actions" value="Approve,Reject" />
            <uipath:input name="key" value="Shared" />
            <uipath:input name="taskTitle" value="Review Expense Request" />
          </uipath:context>
          <uipath:input name="HitlTaskArguments" type="json" target="bodyField"><![CDATA[{"expenseAmount":"=vars.Var_ExpenseAmount","requesterName":"=vars.Var_RequesterName","expenseCategory":"=vars.Var_ExpenseCategory"}]]></uipath:input>
          <uipath:output name="Process response" type="Actions.HITL" var="Var_ApprovalDecision" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToReview</bpmn:incoming>
      <bpmn:outgoing>Flow_ToGateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Decision" name="Approved?" default="Flow_NotApproved">
      <bpmn:incoming>Flow_ToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_NotApproved</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_RecordApproval" name="Record Approval" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"decision":"=vars.Var_ApprovalDecision","comments":"=vars.Var_Comments"}]]></uipath:input>
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_ToApprovedEnd</bpmn:outgoing>
      <bpmn:script><![CDATA[
console.log("Recording approval decision: " + decision + " comments: " + comments);
return { response: true };
]]></bpmn:script>
    </bpmn:scriptTask>
    <bpmn:endEvent id="End_Approved" name="Approval Recorded">
      <bpmn:incoming>Flow_ToApprovedEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_NotApproved" name="Not Approved">
      <bpmn:incoming>Flow_NotApproved</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToReview" sourceRef="Event_start" targetRef="Task_ReviewExpense" />
    <bpmn:sequenceFlow id="Flow_ToGateway" sourceRef="Task_ReviewExpense" targetRef="Gateway_Decision" />
    <bpmn:sequenceFlow id="Flow_Approved" sourceRef="Gateway_Decision" targetRef="Task_RecordApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=vars.Var_ApprovalDecision == "approved"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NotApproved" sourceRef="Gateway_Decision" targetRef="End_NotApproved" />
    <bpmn:sequenceFlow id="Flow_ToApprovedEnd" sourceRef="Task_RecordApproval" targetRef="End_Approved" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="S_Event_start" bpmnElement="Event_start">
        <dc:Bounds x="160" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="140" y="222" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_ReviewExpense" bpmnElement="Task_ReviewExpense">
        <dc:Bounds x="250" y="160" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Gateway_Decision" bpmnElement="Gateway_Decision" isMarkerVisible="true">
        <dc:Bounds x="440" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="425" y="228" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_RecordApproval" bpmnElement="Task_RecordApproval">
        <dc:Bounds x="590" y="60" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End_Approved" bpmnElement="End_Approved">
        <dc:Bounds x="780" y="82" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="750" y="122" width="96" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End_NotApproved" bpmnElement="End_NotApproved">
        <dc:Bounds x="445" y="320" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="415" y="360" width="96" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_ToReview" bpmnElement="Flow_ToReview">
        <di:waypoint x="196" y="200" />
        <di:waypoint x="250" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_ToGateway" bpmnElement="Flow_ToGateway">
        <di:waypoint x="390" y="200" />
        <di:waypoint x="440" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_Approved" bpmnElement="Flow_Approved">
        <di:waypoint x="465" y="175" />
        <di:waypoint x="465" y="100" />
        <di:waypoint x="590" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_NotApproved" bpmnElement="Flow_NotApproved">
        <di:waypoint x="465" y="225" />
        <di:waypoint x="465" y="320" />
        <di:waypoint x="463" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_ToApprovedEnd" bpmnElement="Flow_ToApprovedEnd">
        <di:waypoint x="730" y="100" />
        <di:waypoint x="780" y="100" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
