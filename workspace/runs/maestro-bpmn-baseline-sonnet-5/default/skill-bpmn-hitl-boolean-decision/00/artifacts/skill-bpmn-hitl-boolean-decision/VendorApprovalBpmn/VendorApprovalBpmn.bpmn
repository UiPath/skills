<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uipath="http://uipath.org/schema/bpmn"
    id="Definitions_VendorApprovalBpmn" targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="UiPath (https://bpmn.uipath.com)" exporterVersion="1.0">
  <bpmn:process id="Process_VendorApproval" name="Vendor Approval" isExecutable="true">
    <bpmn:extensionElements>
      <uipath:migrationVersion version="11.5" />
      <uipath:variables version="v1">
        <uipath:inputOutput id="Var_VendorName" name="VendorName" type="string" />
        <uipath:inputOutput id="Var_CreditScore" name="CreditScore" type="number" />
        <uipath:inputOutput id="Var_ApprovalDecision" name="ApprovalDecision" type="boolean" />
        <uipath:inputOutput id="Var_RiskNotes" name="RiskNotes" type="string" />
        <uipath:inputOutput id="Var_HitlResult" name="HitlResult" type="json" />
      </uipath:variables>
    </bpmn:extensionElements>

    <bpmn:startEvent id="Start_Manual" name="Start Vendor Onboarding">
      <bpmn:outgoing>Flow_StartToSetContext</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:scriptTask id="Task_SetVendorContext" name="Set Vendor Context" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{}]]></uipath:input>
          <uipath:output name="vendorName" type="string" var="Var_VendorName" source="=result.response.vendorName" />
          <uipath:output name="creditScore" type="number" var="Var_CreditScore" source="=result.response.creditScore" />
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_StartToSetContext</bpmn:incoming>
      <bpmn:outgoing>Flow_SetContextToReview</bpmn:outgoing>
      <bpmn:script><![CDATA[
// Mock vendor context lookup for a synthetic placeholder vendor.
var vendorName = "Contoso Synthetic Supplies Ltd.";
var creditScore = 712;
return { response: { vendorName: vendorName, creditScore: creditScore } };
]]></bpmn:script>
    </bpmn:scriptTask>

    <bpmn:userTask id="Task_ComplianceReview" name="Compliance Officer Review">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Actions.HITL" version="v1" />
          <uipath:context>
            <uipath:input name="appId" value="synthetic-vendor-compliance-review-app" />
            <uipath:input name="appVersion" value="1" />
            <uipath:input name="actions" value="Submit" />
            <uipath:input name="key" value="SYNTHETIC_FOLDER_KEY" />
            <uipath:input name="taskTitle" value="Review Vendor: Compliance Approval" />
          </uipath:context>
          <uipath:input name="HitlTaskArguments" type="json" target="bodyField"><![CDATA[
{
  "VendorName": "=vars.Var_VendorName",
  "CreditScore": "=vars.Var_CreditScore"
}
]]></uipath:input>
          <uipath:output name="Process response" type="Actions.HITL" var="Var_HitlResult" />
          <uipath:output name="approved" type="boolean" var="Var_ApprovalDecision" source="=result.response.approved" />
          <uipath:output name="riskNotes" type="string" var="Var_RiskNotes" source="=result.response.riskNotes" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_SetContextToReview</bpmn:incoming>
      <bpmn:outgoing>Flow_ReviewToGateway</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_ApprovalDecision" name="Vendor Approved?">
      <bpmn:incoming>Flow_ReviewToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_ToOnboard</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToReject</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:scriptTask id="Task_OnboardVendor" name="Onboard Vendor" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"vendorName":"=vars.Var_VendorName"}]]></uipath:input>
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToOnboard</bpmn:incoming>
      <bpmn:outgoing>Flow_OnboardToEnd</bpmn:outgoing>
      <bpmn:script><![CDATA[
// Mock vendor onboarding action for the approved synthetic vendor.
return { response: { status: "onboarded", vendorName: vendorName } };
]]></bpmn:script>
    </bpmn:scriptTask>

    <bpmn:scriptTask id="Task_RejectVendor" name="Reject Vendor" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:scriptVersion value="v3" />
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.ScriptTask" version="v1" />
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"vendorName":"=vars.Var_VendorName"}]]></uipath:input>
        </uipath:mapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToReject</bpmn:incoming>
      <bpmn:outgoing>Flow_RejectToEnd</bpmn:outgoing>
      <bpmn:script><![CDATA[
// Mock vendor rejection action for the declined synthetic vendor.
return { response: { status: "rejected", vendorName: vendorName } };
]]></bpmn:script>
    </bpmn:scriptTask>

    <bpmn:endEvent id="End_Onboarded" name="Vendor Onboarded">
      <bpmn:incoming>Flow_OnboardToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_Rejected" name="Vendor Rejected">
      <bpmn:incoming>Flow_RejectToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_StartToSetContext" sourceRef="Start_Manual" targetRef="Task_SetVendorContext" />
    <bpmn:sequenceFlow id="Flow_SetContextToReview" sourceRef="Task_SetVendorContext" targetRef="Task_ComplianceReview" />
    <bpmn:sequenceFlow id="Flow_ReviewToGateway" sourceRef="Task_ComplianceReview" targetRef="Gateway_ApprovalDecision" />
    <bpmn:sequenceFlow id="Flow_ToOnboard" sourceRef="Gateway_ApprovalDecision" targetRef="Task_OnboardVendor">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=vars.Var_ApprovalDecision == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ToReject" sourceRef="Gateway_ApprovalDecision" targetRef="Task_RejectVendor">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=vars.Var_ApprovalDecision == false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_OnboardToEnd" sourceRef="Task_OnboardVendor" targetRef="End_Onboarded" />
    <bpmn:sequenceFlow id="Flow_RejectToEnd" sourceRef="Task_RejectVendor" targetRef="End_Rejected" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_VendorApprovalBpmn">
    <bpmndi:BPMNPlane id="Plane_VendorApprovalBpmn" bpmnElement="Process_VendorApproval">
      <bpmndi:BPMNShape id="S_Start_Manual" bpmnElement="Start_Manual">
        <dc:Bounds x="160" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_SetVendorContext" bpmnElement="Task_SetVendorContext">
        <dc:Bounds x="250" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_ComplianceReview" bpmnElement="Task_ComplianceReview">
        <dc:Bounds x="410" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Gateway_ApprovalDecision" bpmnElement="Gateway_ApprovalDecision">
        <dc:Bounds x="570" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_OnboardVendor" bpmnElement="Task_OnboardVendor">
        <dc:Bounds x="680" y="60" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_RejectVendor" bpmnElement="Task_RejectVendor">
        <dc:Bounds x="680" y="280" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End_Onboarded" bpmnElement="End_Onboarded">
        <dc:Bounds x="840" y="82" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End_Rejected" bpmnElement="End_Rejected">
        <dc:Bounds x="840" y="302" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_StartToSetContext" bpmnElement="Flow_StartToSetContext">
        <di:waypoint x="196" y="200" />
        <di:waypoint x="250" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_SetContextToReview" bpmnElement="Flow_SetContextToReview">
        <di:waypoint x="350" y="200" />
        <di:waypoint x="410" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_ReviewToGateway" bpmnElement="Flow_ReviewToGateway">
        <di:waypoint x="510" y="200" />
        <di:waypoint x="570" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_ToOnboard" bpmnElement="Flow_ToOnboard">
        <di:waypoint x="595" y="175" />
        <di:waypoint x="595" y="100" />
        <di:waypoint x="680" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_ToReject" bpmnElement="Flow_ToReject">
        <di:waypoint x="595" y="225" />
        <di:waypoint x="595" y="320" />
        <di:waypoint x="680" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_OnboardToEnd" bpmnElement="Flow_OnboardToEnd">
        <di:waypoint x="780" y="100" />
        <di:waypoint x="840" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_RejectToEnd" bpmnElement="Flow_RejectToEnd">
        <di:waypoint x="780" y="320" />
        <di:waypoint x="840" y="320" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
