      "id": "extractNtsbFields",
      "type": "uipath.ixp.aviation-investigation-final-report-demo-a42b1d4d-ixp.937c414b-7879-8059-8b29-e8401d2dd3ba-c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Extract NTSB Report Fields"
      },
      "inputs": {
        "model": {
          "id": "937c414b-7879-8059-8b29-e8401d2dd3ba",
          "modelName": "aviation-investigation-final-report-demo-a42b1d4d-ixp",
          "modelDisplayName": "aviation-investigation-final-report-demo-a42b1d4d-ixp",
          "folderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "folderName": "Shared",
          "folderPath": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "description": ""
        },
        "modelName": "aviation-investigation-final-report-demo-a42b1d4d-ixp",
        "description": "",
        "projectName": "aviation-investigation-final-report-demo-a42b1d4d-ixp",
        "versionTag": "",
        "folderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
        "folderName": "Shared",
        "fileRef": "=js:$vars.start.output.reportPdf",
        "pageRange": ""
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The extraction result from the NTSB aviation report",
          "source": "=this.result",
          "var": "output",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "properties": {
              "ExtractionResult": {
                "type": "object",
                "properties": {
                  "DocumentId": {
                    "type": "string"
                  },
                  "ResultsVersion": {
                    "type": "integer"
                  },
                  "ResultsDocument": {
                    "type": "object",
                    "properties": {
                      "Fields": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "FieldId": {
                              "type": "string"
                            },
                            "FieldName": {
                              "type": "string"
                            },
                            "FieldType": {
                              "type": "string"
                            },
                            "IsMissing": {
                              "type": "boolean"
                            },
                            "Values": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            },
                            "Confidence": {
                              "type": "integer"
                            },
                            "OperatorConfirmed": {
                              "type": "boolean"
                            }
                          }
                        }
                      },
                      "Tables": {
                        "type": "array"
                      }
                    }
                  }
                }
              },
              "ExtractorPayloads": {
                "type": "object"
              },
              "BusinessrulesResults": {
                "type": "array"
              }
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "status": {
                "type": "integer"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "id": "parseNtsbFields",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Parse NTSB Fields"
      },
      "inputs": {
        "script": "const fields = ($vars.extractNtsbFields.output && $vars.extractNtsbFields.output.ExtractionResult && $vars.extractNtsbFields.output.ExtractionResult.ResultsDocument && $vars.extractNtsbFields.output.ExtractionResult.ResultsDocument.Fields) ? $vars.extractNtsbFields.output.ExtractionResult.ResultsDocument.Fields : [];\nconst get = (name) => { const f = fields.find(f => f.FieldName === name); return f && f.Values && f.Values.length > 0 ? f.Values[0] : null; };\nconst ntsbNumber = get('NTSB Number') || get('NTSBNumber') || get('Accident Number') || get('accidentNumber') || get('ntsb_number') || get('ntsbNumber') || get('reportNumber') || get('Report Number');\nconst eventDate = get('Event Date') || get('eventDate') || get('Accident Date') || get('accidentDate') || get('Date');\nconst city = get('City') || get('city') || get('Location City') || get('locationCity');\nconst state = get('State') || get('state') || get('Location State') || get('locationState');\nconst location = (city && state) ? (city + ', ' + state) : (city || state || get('Location') || get('location'));\nconst aircraftMake = get('Aircraft Make') || get('aircraftMake') || get('Make') || get('make');\nconst aircraftModel = get('Aircraft Model') || get('aircraftModel') || get('Model') || get('model') || get('AircraftModel');\nconst aircraftDamage = get('Aircraft Damage') || get('aircraftDamage') || get('Damage') || get('damage');\nreturn { ntsbNumber, eventDate, location, city, state, aircraftMake, aircraftModel, aircraftDamage };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "logNtsbNumber",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log NTSB Number"
      },
      "inputs": {
        "script": "const ntsbNumber = $vars.parseNtsbFields.output.ntsbNumber;\nreturn { ntsbNumber };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {}
    }
  ],
  "edges": [
