{
  "id": "4faaf37f-9e1b-48ef-b37d-d4cd4e181813",
  "version": "1.8",
  "name": "SlackWeatherPipeline",
  "nodes": [
    {
      "id": "parseAddress1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Parse City from Description"
      },
      "inputs": {
        "script": "var desc = $vars.getOfficeBellevueChannelInfo1.output.purpose.value || '';\nvar parts = desc.split(',').map(function(p) { return p.trim(); });\nvar city = parts.length >= 2 ? parts[parts.length - 2] : '';\nreturn { city: city };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Parsed address fields",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "computeVerdict1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Compute Verdict"
      },
      "inputs": {
        "script": "var temp = $vars.getCurrentWeather1.output.current_weather.temperature;\nreturn { verdict: temp > 60 ? 'warm office today' : 'cold office today' };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Verdict text",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {},
      "outputs": {
        "verdict": {
          "source": "=js:$vars.computeVerdict1.output.verdict"
        }
      }
    },
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "bcb2c695-0ca4-4046-b40b-c56fb96f4f26",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "getOfficeBellevueChannelInfo1",
      "type": "uipath.connector.uipath-salesforce-slack.get-channel-info",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Get #office-bellevue Channel Info"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-salesforce-slack",
          "connectionId": "849e85d8-1aa9-4d52-8bbd-20041c8f05d8",
          "connectionResourceId": "849e85d8-1aa9-4d52-8bbd-20041c8f05d8",
          "connectionFolderKey": "5da18ec0-7de1-4e57-aaf1-ddc8a369c199",
          "method": "GET",
          "endpoint": "/ConversationsInfo/{conversationsInfoId}",
          "pathParameters": {
            "conversationsInfoId": "C0B50H7DE2F"
          },
          "uiPathActivityTypeId": "f9995f55-16e3-3c65-b860-af01aa2a1e47",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"instanceParameters\":{\"connectorKey\":\"uipath-salesforce-slack\",\"objectName\":\"ConversationsInfo_GET\",\"httpMethod\":\"GETBYID\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"method\"},\"objectName\":\"ConversationsInfo_GET\",\"operation\":\"retrieve\",\"httpMethod\":\"GET\",\"path\":\"/ConversationsInfo/{conversationsInfoId}\",\"packageVersion\":\"1.0.0\",\"connectorVersion\":null,\"executionType\":null,\"customFieldsRequestDetails\":null,\"unifiedTypesCompatible\":true}}"
        }
      }
    },
    {
      "id": "geocodeCity1",
      "type": "core.action.http.v2",
      "typeVersion": "2.3",
      "display": {
        "label": "Geocode City"
      },
      "inputs": {
        "branches": [],
        "timeout": "PT15M",
        "retryCount": 0,
        "detail": {
          "connector": "uipath-uipath-http",
          "connectionId": "ImplicitConnection",
          "connectionResourceId": null,
          "connectionFolderKey": null,
          "method": "POST",
          "endpoint": "/http-request",
          "bodyParameters": {
            "authentication": "manual",
            "method": "GET",
            "url": "=js:`https://geocoding-api.open-meteo.com/v1/search?name=${encodeURIComponent($vars.parseAddress1.output.city)}&count=1&language=en&format=json`"
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"connectorVersion\":\"1.4.50\",\"executionType\":null,\"customFieldsRequestDetails\":null,\"instanceParameters\":{\"connectorKey\":\"uipath-uipath-http\",\"objectName\":\"http-request\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\"},\"objectName\":\"http-request\",\"operation\":\"create\",\"packageVersion\":\"1.0.0\",\"httpMethod\":\"POST\",\"path\":\"/http-request\",\"unifiedTypesCompatible\":true,\"savedJitInputFieldId\":\"in_http-request\"}}",
          "uiPathActivityTypeId": "5c4cc855-b42a-37e6-b910-de8588998fce",
          "errorState": {
            "issues": []
          },
          "telemetryData": {
            "connectorKey": "uipath-uipath-http",
            "connectorName": "HTTP",
            "operationType": "create",
            "objectName": "http-request",
            "objectDisplayName": "HTTP Request",
            "primaryKeyName": ""
          }
        }
      }
    },
    {
      "id": "getCurrentWeather1",
      "type": "uipath.connector.custom-codereval-openmeteoapis.getcurrentweather",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Get Current Weather"
      },
      "inputs": {
        "detail": {
          "connector": "custom-codereval-openmeteoapis",
          "connectionId": "21ca654f-b67b-4f97-9eb3-1f93bd3bb5cc",
          "connectionResourceId": "21ca654f-b67b-4f97-9eb3-1f93bd3bb5cc",
          "connectionFolderKey": "5da18ec0-7de1-4e57-aaf1-ddc8a369c199",
          "method": "GET",
          "endpoint": "/forecast",
          "queryParameters": {
            "latitude": "=js:$vars.geocodeCity1.output.results[0].latitude",
            "longitude": "=js:$vars.geocodeCity1.output.results[0].longitude",
            "current_weather": "true",
            "temperature_unit": "fahrenheit"
          },
          "uiPathActivityTypeId": "e39eee57-b09f-36fb-b131-4f4feb46b707",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"instanceParameters\":{\"connectorKey\":\"custom-codereval-openmeteoapis\",\"objectName\":\"V1Forecast\",\"httpMethod\":\"GETBYID\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"V1Forecast\",\"operation\":\"retrieve\",\"httpMethod\":\"GET\",\"path\":\"/forecast\",\"packageVersion\":\"1.0.0\",\"connectorVersion\":null,\"executionType\":null,\"customFieldsRequestDetails\":null,\"unifiedTypesCompatible\":true}}"
        }
      }
    }
  ],
