{
  "id": "7ab54870-3eb5-4401-a2cd-abaf06f66686",
  "version": "1.8",
  "name": "CustomerEscalation",
  "nodes": [
    {
      "id": "outlookEmailReceived1",
      "type": "uipath.connector.trigger.uipath-mock-outlook.email-received",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Outlook Email Received"
      },
      "inputs": {
        "entryPointId": "5f9d5b14-bf05-4097-a90b-57bd31519f06",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "classifyUrgency1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Classify Urgency"
      },
      "inputs": {
        "script": "var email = $vars.outlookEmailReceived1.output;\nvar subject = (email && email.subject) ? email.subject.toLowerCase() : '';\nvar body = (email && email.body && email.body.content) ? email.body.content.toLowerCase() : '';\nvar urgentKeywords = ['urgent', 'asap', 'critical', 'emergency', 'priority', 'sla breach', 'escalate', 'outage', 'down', 'blocker', 'immediate', 'fire', 'p0', 'p1', 'high priority'];\nvar combined = subject + ' ' + body;\nvar isUrgent = urgentKeywords.some(function(kw) { return combined.indexOf(kw) !== -1; });\nreturn { isUrgent: isUrgent, matchedKeywords: urgentKeywords.filter(function(kw) { return combined.indexOf(kw) !== -1; }) };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Urgency classification result",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "classifyVIP1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Classify VIP"
      },
      "inputs": {
        "script": "var email = $vars.outlookEmailReceived1.output;\nvar fromAddress = '';\nif (email && email.from && email.from.emailAddress && email.from.emailAddress.address) {\n  fromAddress = email.from.emailAddress.address.toLowerCase();\n} else if (email && email.sender && email.sender.emailAddress && email.sender.emailAddress.address) {\n  fromAddress = email.sender.emailAddress.address.toLowerCase();\n}\nvar vipDomains = ['enterprise.com', 'vip-corp.com', 'platinum-partner.com', 'key-account.com', 'strategic.com'];\nvar vipAddresses = ['ceo@', 'cto@', 'cfo@', 'president@', 'vp@', 'director@', 'executive@'];\nvar domainPart = fromAddress.indexOf('@') !== -1 ? fromAddress.split('@')[1] : '';\nvar isVipDomain = vipDomains.indexOf(domainPart) !== -1;\nvar isVipTitle = vipAddresses.some(function(prefix) { return fromAddress.indexOf(prefix) !== -1; });\nvar isVIP = isVipDomain || isVipTitle;\nreturn { isVIP: isVIP, senderAddress: fromAddress, matchedRule: isVipDomain ? 'domain' : isVipTitle ? 'title-prefix' : 'none' };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "VIP classification result",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "isHighTouch1",
      "type": "core.logic.decision",
      "typeVersion": "1.1",
      "display": {
        "label": "Urgent AND VIP?"
      },
      "inputs": {
        "expression": "$vars.classifyUrgency1.output.isUrgent && $vars.classifyVIP1.output.isVIP"
      }
    },
    {
      "id": "notifySlack1",
      "type": "uipath.connector.uipath-salesforce-slack.send-message-to-channel",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Notify Slack"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-salesforce-slack",
          "connectionId": "849e85d8-1aa9-4d52-8bbd-20041c8f05d8",
          "connectionResourceId": "849e85d8-1aa9-4d52-8bbd-20041c8f05d8",
          "connectionFolderKey": "5da18ec0-7de1-4e57-aaf1-ddc8a369c199",
          "method": "POST",
          "endpoint": "/send_message_to_channel_v2",
          "bodyParameters": {
            "channel": "#customer-escalation",
            "text": "=js:\"🚨 URGENT VIP ESCALATION | From: \" + $vars.outlookEmailReceived1.output.from.emailAddress.address + \" | Subject: \" + $vars.outlookEmailReceived1.output.subject"
          },
          "uiPathActivityTypeId": "37a305b2-89b1-315d-b73f-1778839a6c47",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"instanceParameters\":{\"connectorKey\":\"uipath-salesforce-slack\",\"objectName\":\"send_message_to_channel_v2\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"send_message_to_channel_v2\",\"operation\":\"create\",\"httpMethod\":\"POST\",\"path\":\"/send_message_to_channel_v2\",\"packageVersion\":\"1.0.0\",\"connectorVersion\":null,\"executionType\":null,\"customFieldsRequestDetails\":null,\"unifiedTypesCompatible\":true,\"savedJitInputFieldId\":\"in_send_message_to_channel_v2\"}}"
        }
      }
    },
    {
      "id": "replyVipAck1",
      "type": "uipath.connector.uipath-mock-outlook.reply-to-email",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Reply VIP Ack"
      },
      "inputs": {}
    },
    {
      "id": "endHighTouch1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End High-Touch"
      },
      "inputs": {}
    },
    {
      "id": "generateTicket1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Generate Support Ticket"
      },
      "inputs": {
        "script": "var email = $vars.outlookEmailReceived1.output;\nvar subject = (email && email.subject) ? email.subject : 'No Subject';\nvar fromAddress = '';\nif (email && email.from && email.from.emailAddress && email.from.emailAddress.address) {\n  fromAddress = email.from.emailAddress.address;\n}\nvar now = new Date().toISOString();\nvar ticketId = 'TKT-' + Math.floor(Math.random() * 900000 + 100000);\nvar ticketBody = 'Dear ' + (fromAddress || 'Customer') + ',\\n\\n' +\n  'Thank you for contacting our support team. Your request has been received and a ticket has been created for you.\\n\\n' +\n  'Ticket ID: ' + ticketId + '\\n' +\n  'Subject: ' + subject + '\\n' +\n  'Priority: Standard\\n' +\n  'Estimated Response Time: 1 Business Day\\n\\n' +\n  'You can reference this ticket ID in all future correspondence.\\n\\n' +\n  'Best regards,\\nCustomer Support Team';\nreturn { ticketId: ticketId, ticketBody: ticketBody, senderAddress: fromAddress, createdAt: now };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Generated ticket details",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "replyStandardTicket1",
      "type": "uipath.connector.uipath-mock-outlook.reply-to-email",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Reply Standard Ticket"
      },
      "inputs": {}
    },
    {
      "id": "endStandard1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End Standard"
      },
      "inputs": {}
    }
  ],
  "edges": [
    {
      "id": "e-trigger-urgency",
      "sourceNodeId": "outlookEmailReceived1",
      "sourcePort": "output",
      "targetNodeId": "classifyUrgency1",
      "targetPort": "input"
    },
    {
      "id": "e-urgency-vip",
