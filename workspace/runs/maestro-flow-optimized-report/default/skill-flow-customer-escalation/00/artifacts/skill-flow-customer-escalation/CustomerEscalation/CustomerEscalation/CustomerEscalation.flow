      "targetNodeId": "generateTicket1",
      "targetPort": "input"
    },
    {
      "id": "e-ticket-replyStd",
      "sourceNodeId": "generateTicket1",
      "sourcePort": "success",
      "targetNodeId": "replyStandardTicket1",
      "targetPort": "input"
    },
