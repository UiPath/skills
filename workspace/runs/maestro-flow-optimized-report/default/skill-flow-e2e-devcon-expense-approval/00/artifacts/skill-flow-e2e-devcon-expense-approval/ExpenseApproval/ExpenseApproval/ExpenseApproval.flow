{
  "id": "1298cac0-bec4-46ad-bd42-daf37a60578d",
  "version": "1.8",
  "name": "ExpenseApproval",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "9f5b1049-5c8b-427a-a62f-f88cc20a5b9e",
        "isDefaultEntryPoint": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the trigger.",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "mockExpense1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Mock Expense Data"
      },
      "inputs": {
        "script": "return {\n  expenseId: \"EXP-2024-0042\",\n  amount: 1250.00,\n  submitterName: \"Alice Johnson\",\n  category: \"Travel\"\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "managerReview1",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "Manager Review"
      },
      "inputs": {
        "title": "Expense Approval Review",
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group",
            "groups": [
              "expense-approvers"
            ]
          }
        },
        "priority": "Medium",
        "schema": {
          "schemaId": "a7f3c1d2-9b5e-4f8a-b3c6-7d9e2f4a8b1c",
          "fields": [
            {
              "id": "expenseid",
              "label": "Expense ID",
              "type": "string",
              "direction": "input",
              "binding": "vars.mockExpense1.output.expenseId"
            },
            {
              "id": "submittername",
              "label": "Submitter Name",
              "type": "string",
              "direction": "input",
              "binding": "vars.mockExpense1.output.submitterName"
            },
            {
              "id": "amount",
              "label": "Amount",
              "type": "number",
              "direction": "input",
              "binding": "vars.mockExpense1.output.amount"
            },
            {
              "id": "category",
              "label": "Category",
              "type": "string",
              "direction": "input",
              "binding": "vars.mockExpense1.output.category"
            },
            {
              "id": "approved",
              "label": "Approved",
              "type": "boolean",
              "direction": "output",
              "variable": "vars.approved",
              "required": true
            },
            {
              "id": "rejectionreason",
              "label": "Rejection Reason",
              "type": "string",
              "direction": "output",
              "variable": "vars.rejectionReason",
              "required": false
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "End"
            }
          ]
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "approved": {
              "type": "boolean"
            },
            "rejectionreason": {
              "type": "string"
            },
            "Action": {
              "type": "string",
              "enum": [
                "Approve",
                "Reject"
              ],
              "default": "Approve"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": [
            "Approve",
            "Reject"
          ],
          "default": "Approve"
        }
      }
    },
    {
      "id": "logOutcome1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log Outcome"
      },
      "inputs": {
        "script": "const approved = $vars.managerReview1.output.approved;\nconst rejectionReason = $vars.managerReview1.output.rejectionreason;\nconst outcome = $vars.managerReview1.status;\n\nif (approved) {\n  return {\n    logged: true,\n    decision: \"Approved\",\n    message: \"Expense approved by manager\",\n    outcome: outcome\n  };\n} else {\n  return {\n    logged: true,\n    decision: \"Rejected\",\n    message: \"Expense rejected by manager\",\n    rejectionReason: rejectionReason || \"No reason provided\",\n    outcome: outcome\n  };\n}"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {}
    }
  ],
  "edges": [
    {
      "id": "edge-start-mockExpense1",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "mockExpense1",
      "targetPort": "input"
    },
    {
      "id": "edge-mockExpense1-managerReview1",
      "sourceNodeId": "mockExpense1",
      "sourcePort": "success",
      "targetNodeId": "managerReview1",
      "targetPort": "input"
    },
