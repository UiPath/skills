      "id": "getChannelInfo1",
      "type": "uipath.connector.uipath-salesforce-slack.get-channel-info",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Get Channel Info"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-salesforce-slack",
          "connectionId": "e03f734e-0f80-4e8a-a7c1-0ece309b0ca4",
          "connectionResourceId": "e03f734e-0f80-4e8a-a7c1-0ece309b0ca4",
          "connectionFolderKey": "def71452-bad1-40fa-be08-da175e89bd1a",
          "method": "GET",
          "endpoint": "/ConversationsInfo/{conversationsInfoId}",
          "queryParameters": {
            "include_num_members": true
          },
          "pathParameters": {
            "conversationsInfoId": "C0B50H7DE2F"
          },
          "uiPathActivityTypeId": "f9995f55-16e3-3c65-b860-af01aa2a1e47",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"instanceParameters\":{\"connectorKey\":\"uipath-salesforce-slack\",\"objectName\":\"ConversationsInfo_GET\",\"httpMethod\":\"GETBYID\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"method\"},\"objectName\":\"ConversationsInfo_GET\",\"operation\":\"retrieve\",\"httpMethod\":\"GET\",\"path\":\"/ConversationsInfo/{conversationsInfoId}\",\"packageVersion\":\"1.0.0\",\"connectorVersion\":null,\"executionType\":null,\"customFieldsRequestDetails\":null,\"unifiedTypesCompatible\":true}}"
        }
      }
    },
    {
      "id": "formatResult1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Format Channel Info"
      },
      "inputs": {
        "script": "const ch = $vars.getChannelInfo1.output;\nconst name = ch && ch.name ? '#' + ch.name : '(unknown)';\nconst purpose = ch && ch.purpose && ch.purpose.value ? ch.purpose.value : '(none)';\nconst topic = ch && ch.topic && ch.topic.value ? ch.topic.value : '(none)';\nconst members = ch && ch.num_members !== undefined ? ch.num_members : '(not requested)';\nconst isPrivate = ch && ch.is_private ? 'Private' : 'Public';\nconst isArchived = ch && ch.is_archived ? 'Yes' : 'No';\nconst created = ch && ch.created ? new Date(ch.created * 1000).toISOString().slice(0,10) : '(unknown)';\nreturn {\n  summary: 'Channel: ' + name + '\\nType: ' + isPrivate + '\\nDescription/Purpose: ' + purpose + '\\nTopic: ' + topic + '\\nMembers: ' + members + '\\nArchived: ' + isArchived + '\\nCreated: ' + created\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Formatted channel info summary",
          "source": "=result",
          "var": "output",
          "properties": {
            "summary": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "id": "showResult1",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "Show Channel Info"
      },
      "inputs": {
        "schema": {
          "schemaId": "a3c7e2f1-9b4d-4e8a-b6f0-2d1c5e9a3f7b",
          "fields": [
            {
              "id": "channelSummary",
              "label": "Channel Details",
              "type": "text",
              "direction": "input",
              "binding": "vars.formatResult1.output.summary"
            }
          ],
          "outcomes": [
            {
              "id": "done",
              "name": "Done",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            }
          ]
        },
        "recipient": {
          "channels": [
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group"
          }
        },
        "priority": "Low"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "Action": {
              "type": "string",
              "enum": [
                "Done"
              ],
