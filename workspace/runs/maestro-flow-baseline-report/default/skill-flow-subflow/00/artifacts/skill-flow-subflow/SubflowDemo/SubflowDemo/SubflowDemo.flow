  "subflows": {
    "reverseSubflow": {
      "nodes": [
        {
          "id": "sfStart",
          "type": "core.trigger.manual",
          "typeVersion": "1.0",
          "display": {
            "label": "Start"
          },
          "inputs": {
            "entryPointId": "6a7b8c9d-0e1f-2a3b-4c5d-6e7f8a9b0c1d",
            "isDefaultEntryPoint": true
          },
          "outputs": {
            "output": {
              "type": "object",
              "description": "Data passed when manually triggering the workflow.",
              "source": "null",
              "var": "output"
            }
          }
        },
        {
          "id": "reverseScript",
          "type": "core.action.script",
          "typeVersion": "1.0",
          "display": {
            "label": "Reverse String"
          },
          "inputs": {
            "script": "return { result: $vars.sfStart.output.text.split('').reverse().join('') };"
          },
          "outputs": {
            "output": {
              "type": "object",
              "description": "The return value of the script",
              "source": "=result.response",
              "var": "output"
            },
            "error": {
              "type": "object",
              "description": "Error information if the script fails",
              "source": "=result.Error",
              "var": "error"
            }
          }
        },
        {
          "id": "sfEnd",
          "type": "core.control.end",
          "typeVersion": "1.0",
          "display": {
            "label": "End"
          },
          "inputs": {},
          "outputs": {
            "reversedText": {
              "source": "=js:$vars.reverseScript.output.result"
            }
          }
        }
      ],
      "edges": [
        {
          "id": "sf-e1",
          "sourceNodeId": "sfStart",
          "sourcePort": "output",
          "targetNodeId": "reverseScript",
          "targetPort": "input"
        },
        {
          "id": "sf-e2",
          "sourceNodeId": "reverseScript",
          "sourcePort": "success",
          "targetNodeId": "sfEnd",
          "targetPort": "input"
        }
      ],
      "variables": {
        "globals": [
          {
            "id": "text",
            "direction": "in",
            "type": "string",
            "defaultValue": "",
            "triggerNodeId": "sfStart"
          },
          {
            "id": "reversedText",
            "direction": "out",
            "type": "string",
            "defaultValue": ""
          }
        ],
        "nodes": [
          {
            "id": "sfStart.output",
            "type": "object",
            "description": "Data passed when manually triggering the workflow.",
            "binding": {
              "nodeId": "sfStart",
              "outputId": "output"
            }
          },
          {
            "id": "reverseScript.output",
            "type": "object",
            "description": "The return value of the script",
            "binding": {
              "nodeId": "reverseScript",
              "outputId": "output"
            }
          },
          {
