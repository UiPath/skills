        "source": "e23903d3-1235-4022-9b1a-b86ee1beec17"
      }
    },
    {
      "id": "end1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {},
      "outputs": {
        "determination": {
          "type": "string",
          "source": "=js:$vars.autonomousAgent1.output.determination"
        },
        "rationale": {
          "type": "string",
          "source": "=js:$vars.autonomousAgent1.output.rationale"
        }
      }
    }
