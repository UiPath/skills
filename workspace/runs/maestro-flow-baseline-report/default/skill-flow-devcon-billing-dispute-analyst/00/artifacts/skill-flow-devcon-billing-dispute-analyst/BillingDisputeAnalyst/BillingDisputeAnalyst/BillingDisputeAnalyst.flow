{
  "id": "4de10dcd-60cd-4f97-9ec2-db298494a5b5",
  "version": "1.8",
  "name": "BillingDisputeAnalyst",
  "variables": {
    "globals": [
      {
        "id": "disputeDescription",
        "direction": "in",
        "type": "string",
        "triggerNodeId": "start"
      },
      {
        "id": "invoiceNumber",
        "direction": "in",
        "type": "string",
        "triggerNodeId": "start"
      },
      {
        "id": "determination",
        "direction": "out",
        "type": "string"
      },
      {
        "id": "rationale",
        "direction": "out",
        "type": "string"
      }
    ],
    "nodes": [
      {
        "id": "start.output",
        "type": "object",
        "description": "Data passed when manually triggering the workflow.",
        "binding": {
          "nodeId": "start",
          "outputId": "output"
        }
      },
      {
        "id": "autonomousAgent1.output",
        "type": "object",
        "description": "Agent response",
        "binding": {
          "nodeId": "autonomousAgent1",
          "outputId": "output"
        }
      },
      {
        "id": "autonomousAgent1.error",
        "type": "object",
        "description": "Error information if the node fails",
        "binding": {
          "nodeId": "autonomousAgent1",
          "outputId": "error"
        }
      },
      {
        "id": "end1.determination",
        "type": "string",
        "binding": {
          "nodeId": "end1",
          "outputId": "determination"
        }
      },
      {
        "id": "end1.rationale",
        "type": "string",
        "binding": {
          "nodeId": "end1",
          "outputId": "rationale"
        }
      }
    ]
  },
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "3b8c2279-53f2-489e-9d3d-85e215ced368",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "autonomousAgent1",
      "type": "uipath.agent.autonomous",
      "typeVersion": "1.2",
      "display": {
        "label": "Billing Dispute Analyst"
      },
      "inputs": {
        "systemPrompt": "You are a billing dispute analyst grounded on SOP guidelines.",
        "userPrompt": "Analyze the billing dispute and return determination and rationale.",
        "model": "gpt-5.4",
        "source": "19d91f3b-6c40-4390-90a4-4515aea3a642",
        "temperature": 0,
        "maxIterations": 10,
        "agentInputVariables": [
          {
            "id": "start__output__disputeDescription",
            "type": "string",
            "binding": "=$vars.start.output.disputeDescription",
            "description": "Bound from $vars.start.output.disputeDescription"
          },
          {
            "id": "start__output__invoiceNumber",
            "type": "string",
            "binding": "=$vars.start.output.invoiceNumber",
            "description": "Bound from $vars.start.output.invoiceNumber"
          }
        ],
        "agentOutputVariables": [
          {
            "id": "determination",
            "type": "string"
          },
          {
            "id": "rationale",
            "type": "string"
          }
        ]
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Agent response",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "contextNode1",
      "type": "uipath.agent.resource.context.index.billing-dispute-sop-index.cc45b9b4-dbf6-47b3-40ac-08debc0cec5b",
