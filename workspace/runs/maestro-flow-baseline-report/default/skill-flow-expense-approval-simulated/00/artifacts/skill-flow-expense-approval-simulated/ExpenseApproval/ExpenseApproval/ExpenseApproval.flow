{
  "id": "5cb7b28f-9ee8-4008-9dc1-055a1c759373",
  "version": "1.8",
  "name": "ExpenseApproval",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "ea4d1feb-046d-4990-b609-d5ba72a4388e",
        "isDefaultEntryPoint": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the workflow.",
          "source": "null",
          "var": "output"
        }
      }
    },
    {
      "id": "fetchExpense",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Fetch Expense"
      },
      "inputs": {
        "script": "const id = ($vars.expenseId || \"\").trim();\nif (!id) { throw new Error(\"Expense ID is required\"); }\n// TODO: replace this mock with a real API or database lookup\nreturn {\n  expenseId: id,\n  employeeName: \"Jane Smith\",\n  amount: 325.00,\n  category: \"Travel\"\n};",
        "errorHandlingEnabled": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "hitlManagerReview",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "Manager Review"
      },
      "inputs": {
        "schema": {
          "schemaId": "f2e8a1b3-c4d5-6789-abcd-ef0123456789",
          "fields": [
            {
              "id": "expenseId",
              "label": "Expense ID",
              "type": "text",
              "direction": "input",
              "binding": "vars.fetchExpense.output.expenseId"
            },
            {
              "id": "employeeName",
              "label": "Submitted By",
              "type": "text",
              "direction": "input",
              "binding": "vars.fetchExpense.output.employeeName"
            },
            {
              "id": "category",
              "label": "Category",
              "type": "text",
              "direction": "input",
              "binding": "vars.fetchExpense.output.category"
            },
            {
              "id": "amount",
              "label": "Amount (USD)",
              "type": "number",
              "direction": "input",
              "binding": "vars.fetchExpense.output.amount"
            },
            {
              "id": "managerComments",
              "label": "Comments",
              "type": "text",
              "direction": "output",
              "variable": "vars.managerCommentsInput"
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "Continue"
            }
          ]
        },
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group",
            "name": "expense-approvers"
          }
        },
        "priority": "Low"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "managerComments": {
              "type": "string"
            },
            "Action": {
              "type": "string",
              "enum": [
                "Approve",
                "Reject"
              ],
              "default": "Approve"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": [
            "Approve",
            "Reject"
          ],
          "default": "Approve"
        }
      }
    },
    {
      "id": "checkManagerDecision",
      "type": "core.logic.decision",
      "typeVersion": "1.1",
      "display": {
        "label": "Manager Decision"
      },
      "inputs": {
        "expression": "$vars.hitlManagerReview.status === \"Approve\"",
        "trueLabel": "Approved",
        "falseLabel": "Rejected"
      }
    },
    {
      "id": "logApproved",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log Approved"
      },
      "inputs": {
        "script": "return {\n  approvalStatus: \"Approved\",\n  managerComments: ($vars.hitlManagerReview.output.managerComments || \"\")\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "logRejected",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log Rejected"
      },
      "inputs": {
        "script": "return {\n  approvalStatus: \"Rejected\",\n  managerComments: ($vars.hitlManagerReview.output.managerComments || \"\")\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "logError",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log Error"
      },
      "inputs": {
        "script": "return { approvalStatus: \"Error\", managerComments: \"\" };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "doneApproved",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Done - Approved"
      },
      "inputs": {},
      "outputs": {
        "approvalStatus": {
          "source": "=js:$vars.logApproved.output.approvalStatus"
        },
        "managerComments": {
          "source": "=js:$vars.logApproved.output.managerComments"
        }
      }
    },
    {
      "id": "doneRejected",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Done - Rejected"
      },
      "inputs": {},
      "outputs": {
        "approvalStatus": {
          "source": "=js:$vars.logRejected.output.approvalStatus"
        },
        "managerComments": {
          "source": "=js:$vars.logRejected.output.managerComments"
        }
      }
    },
    {
      "id": "doneError",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Done - Error"
      },
      "inputs": {},
      "outputs": {
        "approvalStatus": {
          "source": "=js:$vars.logError.output.approvalStatus"
        },
        "managerComments": {
          "source": "=js:\"\""
        }
      }
    }
  ],
  "edges": [
    {
      "id": "e-start-fetch",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "fetchExpense",
      "targetPort": "input"
    },
    {
      "id": "e-fetch-hitl",
      "sourceNodeId": "fetchExpense",
      "sourcePort": "success",
      "targetNodeId": "hitlManagerReview",
      "targetPort": "input"
    },
    {
      "id": "e-fetch-error",
      "sourceNodeId": "fetchExpense",
      "sourcePort": "error",
      "targetNodeId": "logError",
      "targetPort": "input"
    },
    {
      "id": "e-hitl-decision",
      "sourceNodeId": "hitlManagerReview",
      "sourcePort": "completed",
      "targetNodeId": "checkManagerDecision",
      "targetPort": "input"
    },
    {
      "id": "e-decision-approved",
      "sourceNodeId": "checkManagerDecision",
      "sourcePort": "true",
      "targetNodeId": "logApproved",
      "targetPort": "input"
    },
    {
      "id": "e-decision-rejected",
      "sourceNodeId": "checkManagerDecision",
      "sourcePort": "false",
      "targetNodeId": "logRejected",
      "targetPort": "input"
    },
    {
      "id": "e-approved-done",
      "sourceNodeId": "logApproved",
      "sourcePort": "success",
      "targetNodeId": "doneApproved",
      "targetPort": "input"
    },
    {
      "id": "e-rejected-done",
      "sourceNodeId": "logRejected",
      "sourcePort": "success",
      "targetNodeId": "doneRejected",
      "targetPort": "input"
    },
    {
      "id": "e-error-done",
      "sourceNodeId": "logError",
      "sourcePort": "success",
      "targetNodeId": "doneError",
      "targetPort": "input"
    }
  ],
  "definitions": [
