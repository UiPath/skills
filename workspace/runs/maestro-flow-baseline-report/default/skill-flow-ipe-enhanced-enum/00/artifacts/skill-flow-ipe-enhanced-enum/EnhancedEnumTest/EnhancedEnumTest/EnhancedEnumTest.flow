    {
      "id": "mapOrder1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Map Sort Label to Code"
      },
      "inputs": {
        "script": "const label = $vars.sortLabel;\nconst orderCode = label === 'Newest First' ? 'desc' : 'asc';\nreturn { orderCode: orderCode };"
      }
    },
    {
      "id": "end1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "outputs": {
        "reviews": {
          "source": "=js:$vars.getProductReviews1.output"
        }
      }
    },
