  "nodes": [
    {
      "id": "alertTeamOnSlack1",
      "type": "uipath.connector.uipath-salesforce-slack.send-message-to-channel",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Alert Team on Slack"
      },
      "inputs": {
        "errorHandlingEnabled": true,
        "detail": {
          "connector": "uipath-salesforce-slack",
          "connectionId": "849e85d8-1aa9-4d52-8bbd-20041c8f05d8",
          "connectionResourceId": "849e85d8-1aa9-4d52-8bbd-20041c8f05d8",
          "connectionFolderKey": "5da18ec0-7de1-4e57-aaf1-ddc8a369c199",
          "method": "POST",
          "endpoint": "/send_message_to_channel_v2",
          "bodyParameters": {
            "channel": "C041274J3N2",
            "text": "=js:\"🚨 URGENT VIP EMAIL — \" + $vars.classifyEmail1.output.subject + \" | From: \" + $vars.classifyEmail1.output.senderEmail + \" | Immediate action required.\""
          },
          "uiPathActivityTypeId": "37a305b2-89b1-315d-b73f-1778839a6c47",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"instanceParameters\":{\"connectorKey\":\"uipath-salesforce-slack\",\"objectName\":\"send_message_to_channel_v2\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"send_message_to_channel_v2\",\"operation\":\"create\",\"httpMethod\":\"POST\",\"path\":\"/send_message_to_channel_v2\",\"packageVersion\":\"1.0.0\",\"connectorVersion\":null,\"executionType\":null,\"customFieldsRequestDetails\":null,\"unifiedTypesCompatible\":true,\"savedJitInputFieldId\":\"in_send_message_to_channel_v2\"}}"
        }
      }
    },
    {
      "id": "replyUrgentVip1",
      "type": "uipath.connector.uipath-microsoft-outlook365.reply-to-email",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Reply Urgent VIP"
      },
      "inputs": {
        "errorHandlingEnabled": true,
        "detail": {
          "connector": "uipath-microsoft-outlook365",
          "connectionId": "75dfafb4-3717-470c-a5f6-bdc144757a67",
          "connectionResourceId": "75dfafb4-3717-470c-a5f6-bdc144757a67",
          "connectionFolderKey": "5da18ec0-7de1-4e57-aaf1-ddc8a369c199",
          "method": "POST",
          "endpoint": "/ReplyToEmailV2",
          "bodyParameters": {
            "messageId": "=js:$vars.emailReceived1.output.id",
            "comment": "Thank you for reaching out. We have flagged your email as a top-priority escalation and our team is responding immediately. A dedicated support engineer has been assigned to your case. We appreciate your patience."
          },
          "uiPathActivityTypeId": "da9976dd-3d71-35b4-bb8c-509419cb46eb",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"instanceParameters\":{\"connectorKey\":\"uipath-microsoft-outlook365\",\"objectName\":\"ReplyToEmailV2\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"ReplyToEmailV2\",\"operation\":\"create\",\"httpMethod\":\"POST\",\"path\":\"/ReplyToEmailV2\",\"packageVersion\":\"1.0.0\",\"connectorVersion\":null,\"executionType\":null,\"customFieldsRequestDetails\":null,\"unifiedTypesCompatible\":true}}",
          "multipartParameters": [
            {
              "name": "file",
              "dataType": "file"
            },
            {
              "name": "body",
              "dataType": "string"
            }
          ],
          "inputMetadata": {
            "type": "multipart",
            "multipart": {
              "bodyFieldName": "body"
            }
          }
        }
      }
    },
    {
      "id": "replyStandard1",
      "type": "uipath.connector.uipath-microsoft-outlook365.reply-to-email",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Reply Standard"
      },
      "inputs": {
        "errorHandlingEnabled": true,
        "detail": {
          "connector": "uipath-microsoft-outlook365",
          "connectionId": "75dfafb4-3717-470c-a5f6-bdc144757a67",
          "connectionResourceId": "75dfafb4-3717-470c-a5f6-bdc144757a67",
          "connectionFolderKey": "5da18ec0-7de1-4e57-aaf1-ddc8a369c199",
          "method": "POST",
          "endpoint": "/ReplyToEmailV2",
          "bodyParameters": {
            "messageId": "=js:$vars.emailReceived1.output.id",
            "comment": "=js:\"Thank you for contacting support. A ticket has been created for your request (Ticket ID: \" + ($vars.createTicket1.output && $vars.createTicket1.output.ticketId ? $vars.createTicket1.output.ticketId : \"PENDING\") + \"). Our support team will be in touch shortly. Thank you for your patience.\""
          },
          "uiPathActivityTypeId": "da9976dd-3d71-35b4-bb8c-509419cb46eb",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"instanceParameters\":{\"connectorKey\":\"uipath-microsoft-outlook365\",\"objectName\":\"ReplyToEmailV2\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"ReplyToEmailV2\",\"operation\":\"create\",\"httpMethod\":\"POST\",\"path\":\"/ReplyToEmailV2\",\"packageVersion\":\"1.0.0\",\"connectorVersion\":null,\"executionType\":null,\"customFieldsRequestDetails\":null,\"unifiedTypesCompatible\":true}}",
          "multipartParameters": [
            {
              "name": "file",
              "dataType": "file"
            },
            {
              "name": "body",
              "dataType": "string"
            }
          ],
          "inputMetadata": {
            "type": "multipart",
            "multipart": {
              "bodyFieldName": "body"
            }
          }
        }
      }
    },
    {
      "id": "emailReceived1",
      "type": "uipath.connector.trigger.uipath-microsoft-outlook365.email-received",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Email Received"
      },
      "inputs": {
        "entryPointId": "ecd89649-5035-45ea-9e12-df0958db04d2",
        "isDefaultEntryPoint": true,
        "detail": {
          "connector": "uipath-microsoft-outlook365",
          "connectionId": "75dfafb4-3717-470c-a5f6-bdc144757a67",
          "connectionResourceId": "75dfafb4-3717-470c-a5f6-bdc144757a67",
          "connectionFolderKey": "5da18ec0-7de1-4e57-aaf1-ddc8a369c199",
          "eventParameters": {
            "parentFolderId": "AAMkAGNiNDVjZmJmLTczOTEtNDQ2MS04Njc2LTUwM2I3ZDgxOWQwMAAuAAAAAAAJJRkzOJfsTKZfQqhMUHzlAQAJDKUrZhoLQZ5wELpOfJPCAAAAAAEMAAA="
          },
          "objectName": "Message",
          "eventType": "EMAIL_RECEIVED",
          "eventMode": "polling",
          "filterExpression": "(parentFolderId == 'AAMkAGNiNDVjZmJmLTczOTEtNDQ2MS04Njc2LTUwM2I3ZDgxOWQwMAAuAAAAAAAJJRkzOJfsTKZfQqhMUHzlAQAJDKUrZhoLQZ5wELpOfJPCAAAAAAEMAAA=')",
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"instanceParameters\":{\"connectorKey\":\"uipath-microsoft-outlook365\",\"objectName\":\"Message\",\"activityType\":\"CuratedTrigger\",\"version\":\"1.0.0\",\"eventOperation\":\"EMAIL_RECEIVED\",\"eventMode\":\"polling\",\"supportsStreaming\":false},\"objectName\":\"Message\",\"packageVersion\":\"1.0.0\",\"connectorVersion\":null,\"executionType\":null,\"httpMethod\":null,\"path\":null,\"filter\":null}}",
          "uiPathActivityTypeId": "d76ca053-6e7e-3472-b98c-3094b802d83c",
          "errorState": {
            "issues": []
          }
        }
      }
    },
    {
      "id": "classifyEmail1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Classify Email"
      },
      "inputs": {
        "script": "const email = $vars.emailReceived1.output || {};\nconst urgencyKeywords = [\n  'urgent','critical','emergency','asap','sla breach',\n  'down','outage','production issue','high priority','immediately',\n  'system failure','data loss','security breach','breach','p1','blocker'\n];\nconst subject = (email.subject || '').toLowerCase();\nconst bodyContent = (email.body && email.body.content) ? email.body.content.toLowerCase() : '';\nconst isHighImportance = email.importance === 'high';\nconst isUrgent = isHighImportance ||\n  urgencyKeywords.some(function(kw){ return subject.indexOf(kw) !== -1 || bodyContent.indexOf(kw) !== -1; });\n\nconst vipDomains = [\n  'enterprise-corp.com','vip-corp.com','bigclient.io',\n  'premier.com','globetech.com','acmecorp.com','megacorp.com'\n];\nconst senderAddress = (email.from && email.from.emailAddress && email.from.emailAddress.address)\n  ? email.from.emailAddress.address.toLowerCase() : '';\nconst senderDomain = senderAddress.indexOf('@') !== -1 ? senderAddress.split('@')[1] : '';\nconst isVIP = vipDomains.indexOf(senderDomain) !== -1;\n\nreturn { isUrgent: isUrgent, isVIP: isVIP, senderEmail: senderAddress, subject: email.subject || '' };",
        "errorHandlingEnabled": true
      }
    },
    {
      "id": "decideEscalation1",
      "type": "core.logic.decision",
      "typeVersion": "1.1",
      "display": {
        "label": "Urgent AND VIP?"
      },
      "inputs": {
        "expression": "$vars.classifyEmail1.output.isUrgent === true && $vars.classifyEmail1.output.isVIP === true",
        "trueLabel": "Urgent + VIP",
        "falseLabel": "All Other"
      }
    },
    {
      "id": "createTicket1",
      "type": "core.logic.mock",
      "typeVersion": "1.0",
      "display": {
        "label": "Create Support Ticket"
      },
      "inputs": {}
    },
    {
      "id": "logError1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Log Error"
      },
      "inputs": {
        "script": "const errs = [];\nif ($vars.classifyEmail1 && $vars.classifyEmail1.error) errs.push($vars.classifyEmail1.error);\nif ($vars.alertTeamOnSlack1 && $vars.alertTeamOnSlack1.error) errs.push($vars.alertTeamOnSlack1.error);\nif ($vars.replyUrgentVip1 && $vars.replyUrgentVip1.error) errs.push($vars.replyUrgentVip1.error);\nif ($vars.replyStandard1 && $vars.replyStandard1.error) errs.push($vars.replyStandard1.error);\nconst errorDetail = errs.length > 0 ? errs[0] : { message: 'Unknown error in escalation flow' };\nreturn { logged: true, errorDetail: errorDetail };"
      }
    },
    {
      "id": "endEscalated1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End — Escalated"
      },
      "inputs": {}
    },
    {
      "id": "endStandard1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End — Standard"
      },
      "inputs": {}
    },
    {
      "id": "endError1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End — Error"
      },
      "inputs": {}
    }
  ],
