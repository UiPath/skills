    {
      "id": "parseContractFields",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Parse Contract Fields"
      },
      "inputs": {
        "script": "var fields = ($vars.extractContractFields.output && $vars.extractContractFields.output.ExtractionResult && $vars.extractContractFields.output.ExtractionResult.ResultsDocument && $vars.extractContractFields.output.ExtractionResult.ResultsDocument.Fields) ? $vars.extractContractFields.output.ExtractionResult.ResultsDocument.Fields : [];\nvar getVal = function(names) { for (var i = 0; i < names.length; i++) { var f = fields.find(function(x) { return x.FieldName === names[i]; }); if (f && f.Values && f.Values[0]) return f.Values[0]; } return ''; };\nreturn {\n  partyName1: getVal(['EmployerName', 'Party1', 'FirstParty', 'PartyOneName']),\n  partyName2: getVal(['EmployeeName', 'Party2', 'SecondParty', 'PartyTwoName']),\n  effectiveDate: getVal(['EffectiveDate', 'StartDate', 'ContractDate', 'AgreementDate']),\n  terminationClause: getVal(['TerminationClause', 'Termination', 'TerminationNotice', 'NoticePeriod'])\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "id": "contractApproval",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.0",
      "display": {
        "label": "Contract Approval"
      },
      "inputs": {
        "schema": {
          "schemaId": "d7e4f910-2b38-4c5a-91f6-bc7d8e2a3041",
          "fields": [
            {
              "id": "partyName1",
              "label": "Party Name 1",
              "type": "text",
              "direction": "input",
              "binding": "vars.parseContractFields.output.partyName1"
            },
            {
              "id": "partyName2",
              "label": "Party Name 2",
              "type": "text",
              "direction": "input",
              "binding": "vars.parseContractFields.output.partyName2"
            },
            {
              "id": "effectiveDate",
              "label": "Effective Date",
              "type": "text",
              "direction": "input",
              "binding": "vars.parseContractFields.output.effectiveDate"
            },
            {
              "id": "terminationClause",
              "label": "Termination Clause",
              "type": "text",
              "direction": "input",
              "binding": "vars.parseContractFields.output.terminationClause"
            },
            {
              "id": "approvalNotes",
              "label": "Approval Notes",
              "type": "text",
              "direction": "output",
              "variable": "vars.approvalNotes"
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "End"
            }
          ]
        },
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group"
          }
        },
        "title": "Contract Review Required",
        "priority": "Medium"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "approvalNotes": {
              "type": "string"
            },
            "Action": {
              "type": "string",
              "enum": [
                "Approve",
                "Reject"
              ],
              "default": "Approve"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": [
            "Approve",
            "Reject"
          ],
          "default": "Approve"
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      }
