    {
      "id": "extractReceiptFields",
      "type": "uipath.ixp.idp-benchmark-receipts-43af6412-ixp.9e77f71d-773c-80a0-9411-ec40d252d00d-c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Extract Receipt Fields"
      },
      "inputs": {
        "model": {
          "id": "9e77f71d-773c-80a0-9411-ec40d252d00d",
          "modelName": "idp-benchmark---receipts-43af6412-ixp",
          "modelDisplayName": "idp-benchmark---receipts-43af6412-ixp",
          "folderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "folderName": "Shared",
          "folderPath": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
          "description": ""
        },
        "modelName": "idp-benchmark---receipts-43af6412-ixp",
        "projectName": "idp-benchmark---receipts-43af6412-ixp",
        "folderKey": "c4359cde-55f0-4f0e-9322-c6cdce74ab4c",
        "folderName": "Shared",
        "versionTag": "",
        "pageRange": "",
        "fileRef": "=js:$vars.start.output.receiptFile"
      },
      "outputs": {
        "output": {
          "name": "output",
          "type": "object",
          "source": "=this.result",
          "var": "output",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "properties": {
              "ExtractionResult": {
                "type": "object",
                "properties": {
                  "DocumentId": { "type": "string" },
                  "ResultsVersion": { "type": "integer" },
                  "ResultsDocument": {
                    "type": "object",
                    "properties": {
                      "Fields": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "FieldId": { "type": "string" },
                            "FieldName": { "type": "string" },
                            "FieldType": { "type": "string" },
                            "IsMissing": { "type": "boolean" },
                            "Values": { "type": "array", "items": { "type": "string" } },
                            "Confidence": { "type": "integer" }
                          }
                        }
                      },
                      "Tables": { "type": "array", "items": { "type": "object" } }
                    }
                  }
                }
              },
              "ExtractorPayloads": { "type": "object" },
              "BusinessrulesResults": { "type": "array", "items": { "type": "object" } }
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": ["code", "message", "detail", "category", "status"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "detail": { "type": "string" },
              "category": { "type": "string" },
              "status": { "type": "integer" }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "id": "parseReceiptData",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Parse Merchant, Date & Total"
      },
      "inputs": {
        "script": "const fields = ($vars.extractReceiptFields.output.ExtractionResult && $vars.extractReceiptFields.output.ExtractionResult.ResultsDocument && $vars.extractReceiptFields.output.ExtractionResult.ResultsDocument.Fields) || [];\nconst findField = (name) => (fields.find(f => f.FieldName === name) || {}).Values && fields.find(f => f.FieldName === name).Values[0];\nconst merchant = findField('vendor_name') || findField('merchant_name') || findField('VendorName') || findField('MerchantName') || null;\nconst date = findField('purchase_date') || findField('receipt_date') || findField('PurchaseDate') || findField('Date') || null;\nconst total = findField('total_amount') || findField('total') || findField('TotalAmount') || findField('Total') || null;\nreturn { merchant, date, total };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": ["code", "message", "detail", "category", "status"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "detail": { "type": "string" },
              "category": { "type": "string" },
              "status": { "type": "integer" }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {},
      "outputs": {}
    }
  ],
