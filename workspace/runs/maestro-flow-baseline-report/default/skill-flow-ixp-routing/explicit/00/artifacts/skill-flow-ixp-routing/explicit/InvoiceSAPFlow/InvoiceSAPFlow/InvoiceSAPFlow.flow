    {
      "id": "buildSapPayload",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Build SAP Payload"
      },
      "inputs": {
        "script": "const fields = $vars.extractInvoiceFields.output.ExtractionResult.ResultsDocument.Fields || [];\nconst get = (name) => (fields.find(f => f.FieldName === name) || {}).Values?.[0] || null;\nreturn {\n  vendorId: get('VendorId') || get('vendor_id') || get('Vendor'),\n  invoiceNumber: get('InvoiceNumber') || get('invoice_number') || get('Invoice Number'),\n  invoiceDate: get('InvoiceDate') || get('invoice_date') || get('Invoice Date'),\n  totalAmount: get('TotalAmount') || get('total_amount') || get('Total Amount'),\n  currency: get('Currency') || get('currency'),\n  lineItems: ($vars.extractInvoiceFields.output.ExtractionResult.ResultsDocument.Tables || []).map(t => t)\n};"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        }
      }
    },
    {
      "id": "postToSap",
      "type": "core.logic.mock",
      "typeVersion": "1.0",
      "display": {
        "label": "Post Invoice to SAP (mock — SAP connector pending)"
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      }
    },
    {
