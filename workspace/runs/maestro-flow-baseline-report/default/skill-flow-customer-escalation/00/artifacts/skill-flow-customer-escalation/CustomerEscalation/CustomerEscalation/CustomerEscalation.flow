{
  "id": "e9a6f0d3-39fe-4b38-a3b4-7608cffe2760",
  "version": "1.8",
  "name": "CustomerEscalation",
  "nodes": [
    {
      "id": "classifyUrgency1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Classify Urgency"
      },
      "inputs": {
        "script": "const email = $vars.emailReceived1.output;\nconst subject = (email.subject || '').toLowerCase();\nconst body = (email.body || email.bodyPreview || '').toLowerCase();\nconst urgentKeywords = ['urgent', 'asap', 'critical', 'priority', 'emergency', 'outage', 'down', 'broken', 'failure', 'escalate', 'immediately', 'time-sensitive', 'sev1', 'severity'];\nconst isUrgent = urgentKeywords.some(k => subject.includes(k) || body.includes(k));\nreturn { isUrgent: isUrgent };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Urgency classification result",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "classifyVip1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Classify VIP"
      },
      "inputs": {
        "script": "const email = $vars.emailReceived1.output;\nconst fromAddress = (email.from || email.fromAddress || '').toLowerCase();\nconst subject = (email.subject || '').toLowerCase();\nconst vipDomains = ['vip.com', 'enterprise.com', 'gold-tier.com', 'premium.com', 'platinum.com', 'strategic-partner.com'];\nconst vipEmails = ['ceo@example.com', 'cto@example.com', 'vp@example.com', 'president@example.com'];\nconst isDomainVip = vipDomains.some(d => fromAddress.endsWith('@' + d) || fromAddress.includes('.' + d + '/') || fromAddress.endsWith('.' + d));\nconst isEmailVip = vipEmails.includes(fromAddress);\nconst hasVipTag = subject.includes('[vip]') || subject.includes('[vip customer]') || subject.includes('[premium]');\nreturn { isVip: isDomainVip || isEmailVip || hasVipTag };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "VIP classification result",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "routeDecision1",
      "type": "core.logic.decision",
      "typeVersion": "1.1",
      "display": {
        "label": "Urgent AND VIP?"
      },
      "inputs": {
        "expression": "$vars.classifyUrgency1.output.isUrgent === true && $vars.classifyVip1.output.isVip === true",
        "trueLabel": "High Touch",
        "falseLabel": "Standard"
      }
    },
    {
      "id": "generateTicket1",
      "type": "core.action.script",
      "typeVersion": "1.0",
      "display": {
        "label": "Generate Support Ticket"
      },
      "inputs": {
        "script": "const email = $vars.emailReceived1.output;\nconst ticketId = 'TKT-' + Math.floor(100000 + Math.random() * 900000);\nconst subject = email.subject || '(no subject)';\nconst fromAddress = email.from || email.fromAddress || '(unknown sender)';\nreturn { ticketId: ticketId, summary: 'Support ticket for: ' + subject, fromAddress: fromAddress, originalSubject: subject, replyBody: 'Thank you for contacting support. Your request has been logged as ticket ' + ticketId + '. We will respond within 24-48 business hours. Please use this ticket number for any follow-up. Reference subject: ' + subject };"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Generated ticket details",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "endHighTouch",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End High Touch"
      }
    },
    {
      "id": "endStandard",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End Standard"
      }
    },
    {
      "id": "emailReceived1",
      "type": "uipath.connector.trigger.uipath-microsoft-outlook365.email-received",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Email Received"
      },
      "inputs": {
        "entryPointId": "adcdac0e-a966-4c94-9d35-d6e6b84031d3",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "slackNotifyVip1",
      "type": "uipath.connector.uipath-salesforce-slack.send-message-to-channel",
