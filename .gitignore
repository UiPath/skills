.cache/*
.cache
site


# =============================================================================
# Keep team-shared configurations:
#   .claude/settings.json - Hooks, permissions (team settings)
#   .claude/commands/*.md - Slash commands
#   .claude/agents/*.md - Specialized agents
#   .claude/skills/**/*.md - Domain knowledge
#
# Ignore personal/generated artifacts:

# Testing framework artifacts (analysis/evaluation documents)
**/.claude/testing-framework/

# Local overrides (personal settings)
**/.claude/settings.local.json
**/.claude/*.local.json
**/.claude/**/*.local.md
**/.claude/**/*local*

# Claude Code cache and temporary files
**/.claude/cache/
**/.claude/tmp/
**/.claude/.cache/

# Session-specific outputs
**/.claude/outputs/
**/.claude/sessions/

# Personal notes and drafts
**/.claude/drafts/
**/.claude/notes/
**/.claude/**/*.draft.md

# Hook scripts that may contain personal paths
**/.claude/hooks/*.local.*

# Transient session lockfiles
**/.claude/*.lock

# coder_eval test run artifacts
tests/reports/
tests/runs/
tmp/
c/

# Canary .uipx is managed by canary.py — bootstrapped before each run,
# server-side solution deleted and local file removed on teardown.
tests/tasks/uipath-maestro-flow/canary/Canary/Canary.uipx

# macOS Finder metadata
**/.DS_Store

# Git worktrees
.worktrees/

# Local scratch projects and probe artifacts. Untracked by design: these hold
# real tenant identifiers (connection IDs, folder keys, account names).
.local/

# Node (package.json lives at the repo root for the @uipath/skills package)
node_modules/
package-lock.json

# Written at runtime by each e2e task's seed.py; never committed (carries live tenant ids)
tests/tasks/**/seed.json
# Run artifacts of the live BPMN escalation grader — never committed.
# Cleanup journal of created Jira/Slack ids, consumed by the post_run sweep:
.created-ids.jsonl
# Ephemeral solution .uipx (post_run globs it) plus debug logs:
customer-escalation-live/

# Private working material. This repository is public, and
# references/case-template.md § Publishing constraints requires every derived
# case to pass the provenance scrub before it lands.
#
# Ignoring these is necessary but not sufficient: npm's `files` allowlist
# overrides .gitignore, so a file kept out of git can still be published. They
# are therefore also kept out of every packaged path, stripped by the composer,
# and asserted on in tests/scripts/compose-skill-flavor.test.mjs.
#
# .local/       — working copies of the above, kept outside every packaged root
# assets/memos/ — source meeting memos the case library was derived from
# CASE-MEMO-MAP.md — maps case IDs to real accounts and ticket IDs. Unanchored
#   on purpose: the filename must stay ignored wherever it is recreated.
.local/
assets/memos/
CASE-MEMO-MAP.md
